// The runtime (core/RUNTIME.md "Stack overflow"): a thread that overflows its stack ends the
// program with a runtime error and exit code 101, not a bare segmentation fault. A deep but
// bounded recursion on a thread is fine.

fn deep(n: i64, stop: i64) -> i64 {
    if n == stop { return 0 }
    let mut pad: [i64; 32] = [0; 32]
    pad[(n % 32) as usize] = n
    deep(n + 1, stop) + pad[(n % 32) as usize] - n + 1
}

fn main() uses io, threads {
    let ok = spawn(|| -> i64 { deep(0, 10000) })
    print(ok.join())
    let bad = spawn(|| -> i64 { deep(0, -1) })
    print(bad.join())
}

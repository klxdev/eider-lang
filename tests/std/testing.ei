// std/testing and time.Clock: a small line-protocol service and a rate limiter tested
// deterministically with the doubles (scripted reads with short chunks, pauses that time
// out deadline reads, scripted errors, a sink with short writes that fails, an in-memory
// pipe, a fake clock), Suite, diff_lines, and failing checks, to pin what they print.

import "std/testing"
import "std/stream"
import "std/time"

// The service under test: reads lines (at most 64 bytes) and answers each with its upper
// case; a line that doesn't arrive in time is answered "timeout" and the service goes on
// (BufReader keeps the partial line, so nothing is lost); "quit" ends it.
fn serve[R: stream.Reader, W: stream.Writer](r: R, inout w: W) -> Result[i32, stream.Error] uses io, clock {
    var br = stream.buffered(r)
    var bw = stream.buffered_writer(w)
    var served = 0
    while true {
        let line = match br.read_line_by(64, time.after_ms(1000)) {
            Ok(Some(l)) => l
            Ok(None) => break
            Err(e) => {
                if e.kind != stream.TimedOut { return Err(e) }
                stream.write_str(inout bw, "timeout\n")?
                continue
            }
        }
        if line == "quit".bytes() { break }
        var up: List[u8] = List.new()
        for b in line {
            let c: u8 = if b >= 97 && b <= 122 { b - 32 } else { b }
            up.push(c)
        }
        up.push(10)
        stream.write_all(inout bw, up)?
        served += 1
    }
    bw.flush()?
    w = bw.inner()
    Ok(served)
}

// A limiter allowing `burst` events per `per` on any clock.
type Limiter = { burst: i32, per: time.Duration, window_start: i64, used: i32 }

fn allow[C: time.Clock](inout l: Limiter, c: C) -> bool uses clock {
    let now = c.mono_ns()
    if now - l.window_start >= l.per.as_ns() {
        l.window_start = now
        l.used = 0
    }
    if l.used >= l.burst { return false }
    l.used += 1
    true
}

fn steps() -> List[testing.Step] {
    var s: List[testing.Step] = List.new()
    s.push(testing.Data("hello\nwor".bytes()))
    s.push(testing.Pause)
    s.push(testing.Data("ld\nquit\nignored\n".bytes()))
    s
}

fn checks(inout t: testing.Suite) -> Result[(), stream.Error] uses io, clock {

    // the service over a script: 2-byte reads, a pause in the middle of a line
    var out = testing.sink(3)
    let n = testing.assert_ok(serve(testing.script(steps(), 2), inout out))
    t.eq("served", n, 2)
    t.eq("answers", out.text(), String.from("HELLO\ntimeout\nWORLD\n"))
    t.eq("flushed once", out.flush_count(), 1)

    // a scripted error reaches the caller with its kind
    var fs: List[testing.Step] = List.new()
    fs.push(testing.Data("a\n".bytes()))
    fs.push(testing.Fail(stream.ConnectionReset))
    var o2 = testing.sink(0)
    match serve(testing.script(fs, 0), inout o2) {
        Ok(_) => t.check("reset reported", false)
        Err(e) => t.eq("reset kind", e.kind, stream.ConnectionReset)
    }

    // a sink that fails after 4 bytes: write_all reports it, flush keeps the rest
    var bad = testing.failing_sink(0, 4, stream.BrokenPipe)
    var bw = stream.buffered_writer(bad)
    stream.write_str(inout bw, "abcdefgh")?
    match bw.flush() {
        Ok(()) => t.check("flush fails", false)
        Err(e) => t.eq("broken pipe", e.kind, stream.BrokenPipe)
    }
    t.eq("kept the rest", bw.pending(), 4)
    var healed = bw.inner()
    healed.heal()
    var bw2 = stream.buffered_writer(healed)
    stream.write_all(inout bw2, "rest".bytes())?
    bw2.flush()?
    t.eq("after healing", bw2.inner().text(), String.from("abcdrest"))
    // a deadline write on a failing sink times out
    var slow = testing.failing_sink(0, 0, stream.Other)
    match stream.write_all_by(inout slow, "x".bytes(), time.never()) {
        Ok(()) => t.check("times out", false)
        Err(e) => t.eq("timed out", e.to_string(), String.from("write: timed out after 0 of 1 bytes"))
    }

    // chunks: short reads add up
    var ch = testing.chunks("0123456789".bytes(), 3)
    var reads = 0
    var got: List[u8] = List.new()
    while true {
        let c = stream.read_all_by(inout ch, time.never())?
        if c.len() == 0 { break }
        for b in c { got.push(b) }
        reads += 1
    }
    t.eq("chunked data", got, "0123456789".bytes())
    t.check("script finished", ch.finished())

    // the in-memory pipe
    let p = testing.pipe()
    var pw = p.w
    var pr = p.r
    stream.write_str(inout pw, "ping\n")?
    var br = stream.buffered(pr)
    t.eq("pipe line", br.read_line(10)?, Some("ping".bytes()))
    match br.read_line_by(10, time.never()) {
        Ok(_) => t.check("empty pipe times out", false)
        Err(e) => t.eq("empty pipe", e.kind, stream.TimedOut)
    }
    match stream.read_exact(inout pr, 1) {
        Ok(_) => t.check("empty pipe would block", false)
        Err(e) => t.eq("would block", e.kind, stream.WouldBlock)
    }
    p.w.close()
    let none: Option[List[u8]] = None
    t.eq("closed pipe ends", br.read_line(10)?, none)
    let q = testing.pipe()
    q.r.close()
    var qw = q.w
    match stream.write_str(inout qw, "x") {
        Ok(()) => t.check("broken pipe", false)
        Err(e) => t.eq("reader gone", e.kind, stream.BrokenPipe)
    }

    // the fake clock: shared by copies, moved by advance and sleep
    let clk = testing.fake_clock(1000, 1700000000000000000)
    let c2 = clk
    var lim = Limiter(2, time.seconds(1), 0, 0)
    t.eq("first", allow(inout lim, clk), true)
    t.eq("second", allow(inout lim, clk), true)
    t.eq("third refused", allow(inout lim, clk), false)
    clk.advance(time.millis(999))
    t.eq("still refused", allow(inout lim, c2), false)
    c2.sleep(time.millis(1))
    t.eq("next window", allow(inout lim, clk), true)
    t.eq("shared time", c2.now_ns(), 1000 + 1000000000)
    let dl = time.deadline_on(clk, time.millis(5))
    t.eq("not expired", time.expired_on(clk, dl), false)
    clk.advance(time.millis(5))
    t.eq("expired", time.expired_on(clk, dl), true)
    t.eq("remaining", time.remaining_on(clk, time.deadline_on(clk, time.millis(7))).as_ms(), 7)
    clk.set_wall(5)
    t.eq("wall", clk.wall_ns(), 5)
    // the real clock through the same interface
    let sys = time.system()
    let a = sys.mono_ns()
    t.check("system clock moves forward", sys.mono_ns() >= a)

    Ok(())
}

fn main() uses io, clock {
    var t = testing.suite("std/testing")
    testing.assert_ok(checks(inout t))

    // diff_lines
    print(testing.diff_lines(String.from("a\nb\nc\n"), String.from("a\nx\nc\nd\n")))

    print(t.done())

    // a failing check, to pin the message assert_eq prints too (a trap's location in an
    // imported module names the wrong file, docs/std.md, so the trap itself isn't pinned)
    var demo = testing.suite("demo")
    let want = String.from("line one\nline two\n")
    let have = String.from("line one\nline 2\n")
    print(demo.eq("text", have, want))
    print(demo.check("cond", 1 > 2))
    print(demo.passed())
    print(demo.done())
    testing.assert_eq(want, want)
    testing.assert_ne(have, want)
}

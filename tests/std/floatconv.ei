// std/floatconv: exact decimal to IEEE bits (the compiler reads float literals with it and
// std/strings.parse_f64 wraps it), against known bit patterns.

import std.floatconv

fn t_6038() {
    let a = "1.5".bytes()
    assert floatconv.parse_decimal(a, 0, a.len(), false, false).bits == 4609434218613702656
    let b = "0.1".bytes()
    assert floatconv.parse_decimal(b, 0, b.len(), false, false).bits == 4591870180066957722
    assert floatconv.parse_decimal(b, 0, b.len(), true, false).bits == 1036831949
    let c = "1e-3".bytes()
    assert floatconv.parse_decimal(c, 0, c.len(), false, false).bits == 4562254508917369340
}

fn t_17568() {
    let big = "1.7976931348623157e308".bytes()
    assert floatconv.parse_decimal(big, 0, big.len(), false, false).bits == 9218868437227405311
    let over = "1.7976931348623159e308".bytes()
    assert floatconv.parse_decimal(over, 0, over.len(), false, false).bits == 9218868437227405312
    let denorm = "5e-324".bytes()
    assert floatconv.parse_decimal(denorm, 0, denorm.len(), false, false).bits == 1
    let tiny = "2e-324".bytes()
    assert floatconv.parse_decimal(tiny, 0, tiny.len(), false, false).bits == 0
    let f32max = "3.4028235e38".bytes()
    assert floatconv.parse_decimal(f32max, 0, f32max.len(), true, false).bits == 2139095039
    // 2^53 + 1 is a tie between 2^53 and 2^53 + 2: even wins
    let tie = "9007199254740993".bytes()
    assert floatconv.parse_decimal(tie, 0, tie.len(), false, false).bits == 4845873199050653696
}

fn t_41065() {
    assert floatconv.parse_text("-0".bytes(), false).bits == 9223372036854775808
    assert floatconv.parse_text("inf".bytes(), false).bits == 9218868437227405312
    assert floatconv.parse_text("-Infinity".bytes(), false).bits == 18442240474082181120
    assert floatconv.parse_text("NaN".bytes(), false).bits == 9221120237041090560
    assert !floatconv.parse_text("1e".bytes(), false).ok
    assert !floatconv.parse_text(".".bytes(), false).ok
    assert !floatconv.parse_text("".bytes(), false).ok
    assert !floatconv.parse_text(" 1".bytes(), false).ok
    assert floatconv.parse_text(".5".bytes(), false).ok
    assert floatconv.parse_text("5.".bytes(), false).ok
    let u = "1_000.5".bytes()
    assert floatconv.literal_bits(u, 0, u.len(), false) == 4652011706887700480
}

fn t_78387() {
    assert floatconv.f64_to_f32_bits(4609434218613702656) == 1069547520
    assert floatconv.f64_to_f32_bits(4591870180066957722) == 1036831949
    assert floatconv.f64_to_f32_bits(9218868437227405312) == 2139095040
    assert floatconv.f64_to_f32_bits(5190260616003865117) == 2139095040
}



// the decimal text against the exact binary64 and binary32 bits
fn check(text: str, want64: u64, want32: u64) uses io {
    let b = text.bytes()
    let r = floatconv.parse_decimal(b, 0, b.len(), false, false)
    let r32 = floatconv.parse_decimal(b, 0, b.len(), true, false)
    let good = r.ok && r.bits == want64 && r32.ok && r32.bits == want32
    if !good { print(text) }
    assert good
}


// Floats inside enums, records, tuples, Maps, Options, closures, arrays and a thread (docs/decisions.md C660)
type Shape = | Circle(f64) | Rect(f32, f32) | Unit

type Acc = { total: f64, count: i32, items: List[f32] }

fn area(s: Shape) -> f64 {
    match s {
        Circle(r) => 3.0 * r * r
        Rect(w, h) => (w * h) as f64
        Unit => 1.0
    }
}

fn pair() -> (f64, f32) { (1.5, 2.5) }

fn find(xs: List[f64], t: f64) -> Option[usize] {
    for i in 0..xs.len() {
        if xs[i] == t { return Some(i) }
    }
    None
}

fn main() uses io, threads {
    let mut m: Map[String, f64] = Map.new()
    m.insert(String.from("a"), 1.5)
    m.insert(String.from("b"), -0.25)
    print(m.get(String.from("a")))
    print(m.get(String.from("c")))
    print(area(Circle(2.0)))
    print(area(Rect(2.0, 3.5)))
    print(area(Unit))
    print(Circle(1.5))
    print(Rect(1.0, 2.0))
    let (a, b) = pair()
    print(a + (b as f64))
    let mut acc = Acc(0.0, 0, List.new())
    acc.total += 2.5
    acc.count += 1
    acc.items.push(1.5)
    print(acc)
    let mut l: List[f64] = List.new()
    l.push(1.0)
    l.push(3.0)
    print(find(l, 3.0))
    let o: Option[f64] = Some(1.5)
    print(o == Some(1.5))
    print(o == None)
    let t = spawn(|| -> f64 { 2.0 * 21.0 })
    print(t.join())
    let arr: [f32; 3] = [1.5, 2.5, 3.5]
    let mut s: f32 = 0.0
    for v in arr { s += v }
    print(s)
    let mut fs: List[f64] = List.new()
    fs.push(0.5)
    fs.push(0.25)
    print(fs.map(|x: f64| -> f64 { x * 2.0 }))
    print(fs.fold(0.0, |acc2: f64, x: f64| -> f64 { acc2 + x }))
    print(fs.filter(|x: f64| -> bool { x > 0.3 }))
    print(f32.default())
    let big: f64 = 1.0e308
    print(big * 10.0)
}

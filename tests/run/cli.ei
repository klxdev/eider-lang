// std/cli: flags and subcommands derived from a record and an enum (docs/compiler.md, "C8.59")
import std.cli
import std.io
import std.bytes

type Serve = {
    @cli(help = "address to listen on", default = ":8080") addr: String,
    @cli(short = "w", help = "worker tasks", default = "4") workers: i64,
    @cli(short = "v", help = "log every request") verbose: bool,
    @cli(name = "tag", help = "labels, repeatable") tags: List[String],
    limit: Option[u32],
    max_conns: u64,
}

type ServeFlags = {
    addr: String,
    @cli(short = "w", default = "2") workers: i64,
}

type MigrateFlags = { steps: Option[i64], dry_run: bool }

type Cmd =
    | @cli(help = "run the server") Serve(opts: ServeFlags)
    | @cli(help = "apply migrations") MigrateUp(opts: MigrateFlags)

fn words(line: str) -> List[List[u8]] {
    if line.len() == 0 { return List.new() }
    bytes.split(line.bytes(), 32)
}

fn show(line: str) uses io {
    let r: Result[cli.Parsed[Serve], cli.Error] = cli.parse("serve", "run the server", words(line))
    match r {
        Ok(p) => {
            let o = p.opts
            print(o.addr)
            print(o.workers)
            print(o.verbose)
            print(o.tags.len())
            print(o.limit)
            print(o.max_conns)
            print(p.rest.len())
        }
        Err(e) => {
            print(e.help)
            io.out(e.text.bytes())
        }
    }
}

fn cmd(line: str) -> Result[cli.Parsed[Cmd], cli.Error] {
    let r: Result[cli.Parsed[Cmd], cli.Error] = cli.command("tool", "a tool", words(line))
    r
}

fn main() uses io {
    print("-- defaults, required max-conns, equals form, short flags, repeated")
    show("--max-conns=9 -w 8 -v --tag a --tag=b,c --limit 5 extra -- --raw")
    print("-- negated bool and a rest word")
    show("--max-conns 1 --no-verbose file")
    print("-- problems: missing, bad value, unknown, needs a value")
    show("--workers x --nope --limit")
    print("-- help")
    show("--help")
    print("-- commands")
    match cmd("migrate-up --steps 3 --dry-run") {
        Ok(p) => {
            match p.opts {
                Serve(o) => print(o.addr)
                MigrateUp(m) => {
                    print(m.steps)
                    print(m.dry_run)
                }
            }
        }
        Err(e) => io.out(e.text.bytes())
    }
    match cmd("serve --addr :9 extra") {
        Ok(p) => {
            match p.opts {
                Serve(o) => {
                    print(o.addr)
                    print(o.workers)
                    print(p.rest.len())
                }
                MigrateUp(m) => print("?")
            }
        }
        Err(e) => io.out(e.text.bytes())
    }
    match cmd("--help") {
        Ok(p) => print("?")
        Err(e) => io.out(e.text.bytes())
    }
    match cmd("frob") {
        Ok(p) => print("?")
        Err(e) => print(e.help)
    }
}

import std.bytes
import std.serial

// a type with no Serialize or Deserialize of its own, written as text by its adapter

pub type Secret = { v: i64 }

pub fn serialize[S: serial.Serializer](x: Secret, inout s: S) -> Result[(), serial.Error] {
    let mut t = "secret:".bytes()
    bytes.append(inout t, bytes.from_i64(x.v))
    s.string(t)
}

pub fn deserialize[D: serial.Deserializer](d: D) -> Result[Secret, serial.Error] {
    let t = d.read_string()?
    if !bytes.starts_with(t, "secret:".bytes()) { return Err(serial.fail(d, "not a secret")) }
    match bytes.parse_u64(bytes.slice(t, 7, t.len())) {
        Some(n) => Ok(Secret(n as i64))
        None => Err(serial.fail(d, "not a secret number"))
    }
}

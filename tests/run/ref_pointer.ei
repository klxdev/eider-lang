// A `let` reference through heap memory is a pointer (docs/compiler.md, "C8.54"). A write to a
// place the reference doesn't overlap can still un-share (copy-on-write) a buffer on the way to
// it, which moves the data: the reference is set again after such a write. The writes that
// overlap a live reference are errors (E0308, "Scalars are copied"), so what moves buffers
// under a reference is a write to another field of a record with its own Drop (its fields live
// in a shared buffer) while the record is shared.
type Order = { qty: i32, name: String, tags: List[i32] }
type Shape = | Circle(r: i32) | Rect(w: i32, h: i32)
type Pack = { items: List[Order], shapes: List[Shape], hits: i32, label: String }

impl Drop for Pack {
    fn drop(inout self) {}
}

fn order(q: i32, n: str) -> Order {
    let mut tags: List[i32] = List.new()
    tags.push(q)
    tags.push(q + 1)
    Order(q, String.from(n), tags)
}

fn hit(inout n: i32) { n += 100 }

fn area(s: Shape) -> i32 {
    match s {
        Circle(r) => 3 * r * r
        Rect(w, h) => w * h
    }
}

fn pack() -> Pack {
    let mut p = Pack(List.new(), List.new(), 0, String.from("p"))
    p.items.push(order(1, "a"))
    p.items.push(order(2, "bb"))
    p.items.push(order(3, "ccc"))
    p.shapes.push(Circle(2))
    p.shapes.push(Rect(3, 4))
    p
}

fn main() uses io {
    let mut p = pack()
    // the record's buffer is shared with `spare`; each write below un-shares it, once
    let mut spare: List[Pack] = List.new()
    spare.push(p)
    let o = p.items[1]
    let sh = p.shapes[1]
    print(o.qty)
    p.hits = 5
    print(o.qty)
    print(area(sh))
    spare.push(p)
    p.label.push_str("!")
    print(o.name)
    spare.push(p)
    hit(inout p.hits)
    print(o.tags.len())
    print(p.hits)
    print(spare.len())

    // a reference per iteration, writes to another field of the shared record
    let mut sum = 0
    for i in 0..p.items.len() {
        let cur = p.items[i]
        spare.push(p)
        p.hits += 1
        sum += cur.qty * 2 + cur.name.len() as i32 + p.hits
    }
    print(sum)

    // a reference live across a branch that writes
    let last = p.items[2]
    if sum > 0 {
        spare.push(p)
        p.label.push_str("?")
        print(spare[spare.len() - 1].label.len())
    }
    print(last.qty)

    // payload references
    match p.shapes[1] {
        Rect(w, hh) => {
            spare.push(p)
            p.hits += 1
            print(w + hh)
        }
        Circle(r) => print(r)
    }
    print(p.hits)
    print(spare[0].hits)
}

// A `let` reference through heap memory is a pointer (docs/compiler.md, "C8.54"). Writes that
// un-share the buffers it points into (copy-on-write) leave it pointing at the variable's data.
type Order = { qty: i32, name: String, tags: List[i32] }
type Shape = | Circle(r: i32) | Rect(w: i32, h: i32)
type Holder = { shapes: List[Shape], total: i32 }

fn order(q: i32, n: str) -> Order {
    var tags: List[i32] = List.new()
    tags.push(q)
    tags.push(q + 1)
    Order(q, String.from(n), tags)
}

fn bump(inout o: Order) {
    o.qty += 100
    o.tags.push(7)
}

fn area(s: Shape) -> i32 {
    match s {
        Circle(r) => 3 * r * r
        Rect(w, h) => w * h
    }
}

fn main() uses io {
    var orders: List[Order] = List.new()
    orders.push(order(1, "a"))
    orders.push(order(2, "bb"))
    orders.push(order(3, "ccc"))

    // the buffer is shared with `keep`; the write to orders[0] un-shares it
    let keep = orders.copy()
    let o = orders[1]
    print(o.qty)
    orders[0].qty = 99
    print(o.qty)
    orders[1].qty = 7
    print(o.qty)
    print(keep[1].qty)
    print(keep[0].qty)

    // an `inout` call on another element, and a push into another element's list
    let t = orders[2]
    bump(inout orders[0])
    orders[0].tags.push(5)
    print(t.qty + t.tags.len() as i32)
    print(o.name.len())

    // a reference into a reference
    let first = orders[0]
    let tg = first.tags
    orders[2].qty = 31
    orders[2].tags.push(9)
    print(tg.len())
    print(first.qty)
    print(t.tags.len())

    // in a loop: a reference per iteration, writes to the other elements, a shared buffer
    var sum = 0
    for i in 0..orders.len() {
        let cur = orders[i]
        let j = (i + 1) % orders.len()
        let snap = orders.copy()
        orders[j].qty += 1
        sum += cur.qty * 2 + cur.name.len() as i32 + snap[j].qty
    }
    print(sum)

    // a reference live across a branch that writes
    let last = orders[2]
    if sum > 0 {
        let other = orders.copy()
        orders[0].qty = 5
        print(other[0].qty)
    }
    print(last.qty)

    // payload references into a record's List
    var h = Holder(List.new(), 0)
    h.shapes.push(Circle(2))
    h.shapes.push(Rect(3, 4))
    let sh = h.shapes[1]
    let shared = h.shapes.copy()
    h.total = 5
    h.shapes[0] = Rect(1, 1)
    print(area(sh))
    match h.shapes[1] {
        Rect(w, hh) => {
            h.total += 1
            print(w + hh)
        }
        Circle(r) => print(r)
    }
    print(shared.len())
    print(h.total)
}

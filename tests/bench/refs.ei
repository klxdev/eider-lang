// References through a List: many uses of one element (a pointer since C8.54) between writes
// to other elements.
type Order = { qty: i32, price: i32, weight: i32, name: String }

fn main() uses io {
    var orders: List[Order] = List.new()
    for i in 0..1000 {
        orders.push(Order(i, i * 3, i % 7, String.from("order")))
    }
    var total: i64 = 0
    for round in 0..40000 {
        for i in 0..orders.len() {
            let o = orders[i]
            let v = o.qty * o.price + o.weight * o.qty - o.price + o.weight * 2 + o.name.len() as i32
            total += v as i64
            if o.weight == 3 {
                orders[(i + 1) % 1000].qty += 1
            }
            total += o.price as i64
        }
    }
    print(total)
}

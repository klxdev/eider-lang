// How many tasks, how fast, how much memory (docs/runtime.md "Tasks: measured").
//   scripts/task-bench.sh [N]
// Starts N tasks that all block receiving from one channel, reports the time to start them and
// the resident memory they hold, then releases them with N sends and joins them. The numbers
// are measurements, not output to compare (the bench programs under tests/bench are timed whole).

import core.sys
import std.env
import std.bytes
import std.chan
import std.fs
import std.time

fn rss_kb() -> i64 uses fs {
    match fs.read(sys.lit("/proc/self/status")) {
        Ok(text) => {
            for l in bytes.lines(text) {
                if l.len() > 6 && l[0] == 86 && l[1] == 109 && l[2] == 82 && l[3] == 83 && l[4] == 83 {
                    var n: i64 = 0
                    for b in l {
                        if b >= 48 && b <= 57 { n = n * 10 + (b - 48) as i64 }
                    }
                    return n
                }
            }
            0
        }
        Err(e) => 0
    }
}

fn count() -> i64 uses io {
    match env.get(sys.lit("TASKS")) {
        Some(v) => {
            var n: i64 = 0
            for b in v { n = n * 10 + (b - 48) as i64 }
            n
        }
        None => 10000
    }
}

fn main() uses io, threads, clock, fs {
    let n = count()
    let base = rss_kb()
    let c: Chan[i64] = Chan.new()
    var ts: List[Task[i64]] = List.new()
    let t0 = time.mono_ns()
    for i in 0..n {
        let cc = c
        ts.push(spawn(|| -> i64 {
            match cc.recv() {
                Some(v) => v
                None => 0
            }
        }))
    }
    let t1 = time.mono_ns()
    // let every task run to its recv
    time.sleep_ms(300)
    let held = rss_kb()
    let spawn_ns = (t1 - t0) / n
    let per = (held - base) * 1024 / n
    let kib = held - base
    print("tasks: {n}")
    print("spawn: {spawn_ns} ns per task")
    print("memory: {kib} KiB above the start, {per} bytes per blocked task")
    let t2 = time.mono_ns()
    for i in 0..n { c.send(i) }
    var sum: i64 = 0
    for t in ts { sum += t.join() }
    let t3 = time.mono_ns()
    let rel = (t3 - t2) / n
    print("release and join: {rel} ns per task")
    print("sum ok: {sum == n * (n - 1) / 2}")
    // warm: stacks are reused, nothing blocks
    let t4 = time.mono_ns()
    var done: i64 = 0
    var batch: List[Task[i64]] = List.new()
    for i in 0..n {
        batch.push(spawn(|| -> i64 i))
        if batch.len() == 1000 {
            for t in batch { done += t.join() }
            batch = List.new()
        }
    }
    for t in batch { done += t.join() }
    let t5 = time.mono_ns()
    let warm = (t5 - t4) / n
    print("spawn and join, warm: {warm} ns per task ({done})")
}

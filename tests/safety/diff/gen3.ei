// The third generator of the differential check (#191 of the 0.8.0 plan, workstream C of #246): straight-line programs
// over closures and traits. A function builds a few values, makes closures that capture them (a snapshot: a later write
// to the captured variable must not show, copy-on-write must keep a captured List apart from the original), passes
// closures to a higher-order function, nests them, and calls a generic function bounded by a trait that two record
// types implement. Each function returns a checksum; main compares the compile-time interpreter's result
// (`const C = comptime f(..)`) with the compiled call.
//   gen3.ei SEED COUNT
import std.env
import std.bytes

type Rng = { s: u64 }

fn next(inout r: Rng) -> u64 {
    let mut x = r.s
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    r.s = x
    x
}

fn pick(inout r: Rng, n: u64) -> u64 { next(inout r) % n }

fn lit(inout r: Rng) -> String {
    let v = pick(inout r, 100)
    if pick(inout r, 4) == 0 { return "((0 as i64) -% ({v} as i64))" }
    "({v} as i64)"
}

fn atom(inout r: Rng) -> String {
    let k = pick(inout r, 4)
    if k == 0 { return String.from("x") }
    if k == 1 { return String.from("y") }
    if k == 2 { return String.from("(l.len() as i64)") }
    lit(inout r)
}

fn expr(inout r: Rng, d: u64) -> String {
    if d == 0 || pick(inout r, 4) == 0 { return atom(inout r) }
    let a = expr(inout r, d - 1)
    let b = expr(inout r, d - 1)
    let k = pick(inout r, 5)
    if k == 0 { return "({a} +% {b})" }
    if k == 1 { return "({a} -% {b})" }
    if k == 2 { return "({a} *% {b})" }
    if k == 3 { return "({a} & {b})" }
    "({a} ^ {b})"
}

fn putc(inout out: List[String], s: str) { out.push(String.from(s)) }

fn stmt(inout r: Rng, n: u64, inout out: List[String]) {
    let e = expr(inout r, 2)
    let k = pick(inout r, 13)
    if k == 0 {
        // a closure over a scalar, then a write to the scalar: the closure keeps the old value
        out.push("    let cs{n} = |a: i64| -> i64 {{ a +% x +% {e} }}")
        putc(inout out, "    x = x +% 1000")
        out.push("    y = y +% cs{n}(y)")
    }
    else if k == 1 {
        // a closure over a List, then a write to the List: copy-on-write keeps the snapshot
        out.push("    let cl{n} = |i: usize| -> i64 {{ l[i % l.len()] }}")
        out.push("    l.push({e})")
        out.push("    x = x +% cl{n}(1) +% (l.len() as i64)")
    }
    else if k == 2 {
        // a closure over a String
        out.push("    let ct{n} = || -> i64 {{ (s.len() as i64) +% {e} }}")
        putc(inout out, "    s.push_str(\"!\")")
        out.push("    y = y +% ct{n}() +% (s.len() as i64)")
    }
    else if k == 3 {
        // a closure over a record
        out.push("    let cp{n} = |d: i64| -> i64 {{ p.a *% d +% p.b }}")
        putc(inout out, "    p = P(p.b, p.a +% 1)")
        out.push("    x = x +% cp{n}({e}) +% p.a")
    }
    else if k == 4 {
        // a closure passed to a higher-order function
        out.push("    let k{n} = {e}")
        out.push("    x = x +% twice(|v: i64| -> i64 {{ v *% 3 +% k{n} }}, y)")
    }
    else if k == 5 {
        // a closure built inside a closure
        out.push("    let o{n} = |a: i64| -> i64 {{ let q = |b: i64| -> i64 {{ a +% b +% {e} }}\n        q(a) +% q(x) }}")
        out.push("    y = y +% o{n}(x)")
    }
    else if k == 6 {
        // a function value from a named function
        out.push("    let fv{n}: fn(i64) -> i64 = inc")
        out.push("    x = x +% twice(fv{n}, {e})")
    }
    else if k == 7 {
        // static dispatch through a trait bound, on both implementors
        out.push("    x = x +% total(Sq(({e}) & 255), y & 255) +% total(Rc(x & 255, ({e}) & 255), 1)")
    }
    else if k == 8 {
        // a trait method called directly, and a default method
        out.push("    let sq{n} = Sq(({e}) & 255)")
        out.push("    y = y +% sq{n}.area() +% sq{n}.double()")
    }
    else if k == 9 {
        // a closure called in a loop, with a captured value that the loop variable changes around
        out.push("    let k{n} = {e}")
        putc(inout out, "    for i in 0..4 {{")
        out.push("        let w = |a: i64| -> i64 {{ a +% k{n} +% (i as i64) }}")
        putc(inout out, "        x = x +% w(y)")
        putc(inout out, "    }}")
    }
    else if k == 10 {
        // a copy of a captured List written after the capture, the capture written through its own copy
        out.push("    let mut cc{n} = l.copy()")
        out.push("    let rd{n} = |i: usize| -> i64 {{ cc{n}[i % cc{n}.len()] }}")
        out.push("    cc{n}.push({e})")
        out.push("    x = x +% rd{n}(2) +% cc{n}[cc{n}.len() - 1]")
    }
    else if k == 11 {
        // a closure stored in a record-free list of function values, called by index
        out.push("    let mut fs{n}: List[fn(i64) -> i64] = List.new()")
        out.push("    fs{n}.push(|v: i64| -> i64 {{ v +% x }})")
        out.push("    fs{n}.push(|v: i64| -> i64 {{ v *% y }})")
        out.push("    let g0{n} = fs{n}[0]")
        out.push("    let g1{n} = fs{n}[1]")
        out.push("    x = x +% g0{n}(3) +% g1{n}({e})")
    }
    else {
        out.push("    let ad{n} = make_adder(x)")
        out.push("    y = y +% ad{n}({e})")
    }
}

fn main() uses io {
    let argv = env.args()
    let mut r = Rng(1)
    let mut count: u64 = 20
    if argv.len() > 1 {
        match bytes.parse_u64(argv[1]) {
            Some(n) => { r = Rng(n * 2654435761 + 88172645463325252) }
            None => {}
        }
    }
    if argv.len() > 2 {
        match bytes.parse_u64(argv[2]) {
            Some(n) => { count = n }
            None => {}
        }
    }
    print("type P = {{ a: i64, b: i64 }}")
    print("trait Shape {{")
    print("    fn area(self) -> i64")
    print("    fn double(self) -> i64 {{ self.area() +% self.area() }}")
    print("}}")
    print("type Sq = {{ s: i64 }}")
    print("type Rc = {{ w: i64, h: i64 }}")
    print("impl Shape for Sq {{ fn area(self) -> i64 {{ self.s *% self.s }} }}")
    print("impl Shape for Rc {{ fn area(self) -> i64 {{ self.w *% self.h }} fn double(self) -> i64 {{ 3 *% self.area() }} }}")
    print("fn total[T: Shape](a: T, k: i64) -> i64 {{ a.double() +% k }}")
    print("fn twice(f: fn(i64) -> i64, x: i64) -> i64 {{ f(f(x)) }}")
    print("fn inc(a: i64) -> i64 {{ a +% 1 }}")
    print("fn make_adder(n: i64) -> fn(i64) -> i64 {{ |v: i64| -> i64 {{ v +% n }} }}")
    let mut main_body: List[String] = List.new()
    for k in 0..count {
        let mut body: List[String] = List.new()
        let n = 3 + pick(inout r, 8)
        for j in 0..n { stmt(inout r, j, inout body) }
        print("fn f{k}(x0: i64, y0: i64) -> i64 {{")
        print("    let mut x = x0")
        print("    let mut y = y0")
        print("    let mut l: List[i64] = List.new()")
        print("    l.push(x0)")
        print("    l.push(y0)")
        print("    l.push(3)")
        print("    let mut s = String.from(\"hi\")")
        print("    let mut p = P(x0, y0)")
        for l in body { print(l) }
        print("    let mut acc: i64 = x +% y +% p.a +% (3 *% p.b) +% (s.len() as i64)")
        print("    for v in l {{ acc = acc +% v }}")
        print("    acc")
        print("}}")
        let a1 = lit(inout r)
        let a2 = lit(inout r)
        print("const C{k}: i64 = comptime f{k}({a1}, {a2})")
        main_body.push("    if C{k} != f{k}({a1}, {a2}) {{ print(\"MISMATCH f{k}\") }}")
    }
    print("fn main() uses io {{")
    for l in main_body { print(l) }
    print("    print(\"done\")")
    print("}}")
}

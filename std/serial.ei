//! std/serial: format-neutral serialization (#100, #156; docs/compiler.md "C8.61").
//!
//! A type says what it is made of, a format says how that is written. Between them is the data
//! model: `bool`, signed and unsigned integers, floats, strings, bytes, an option (absent or
//! one value), a list, a map with string keys, a record (named fields), a variant (a name and
//! named fields) and a time (a calendar date and time with an offset).
//!
//! - `Serialize` and `Deserialize` are implemented by types: this module has them for the
//!   built-in types, `@[derive(Serialize, Deserialize)]` makes them for your records and enums
//!   (either direction alone is fine), and you can write them by hand. A type with no
//!   implementation cannot be serialized: nothing is derived without the marker.
//! - `Serializer` and `Deserializer` are implemented by formats (eider-json, eider-toml, ...):
//!   they see only the data model, never a user type. A `Serializer` is written to, event by
//!   event, in order. A `Deserializer` is a cursor on one value of a document that is already
//!   parsed: it reads that value as a scalar, or goes to a list element or a map member, and
//!   every error it makes names the path to the value (`items[3].qty`).
//! - `Value` is the data model as a tree. `to_value` and `from_value` go between a type and a
//!   `Value`, which also makes a reference format for tests.
//!
//! Differences between formats are the format's business: a TOML writer leaves out an absent
//! option, a JSON writer writes `null`; a reader of either gives `None` for what is not there.
//! A hand-written implementation that needs to treat a format differently asks `s.format()`
//! (`"json"`, `"toml"`, `"value"`, ...).
//!
//! Enums: a variant without fields is its name, as a string. One with fields is a record of its
//! fields (named by the field, a positional field by its index) under the variant's name
//! (`{"Circle": {"r": 2}}`), or, when the enum has a tag key (`@[serial(tag = "kind")]`), a
//! record with the tag first (`{"kind": "Circle", "r": 2}`). A format that has no use for the
//! distinction writes it its own way.

import std.bytes
import std.time
import std.validate

/// Why serializing or deserializing failed, and where: `path` names the value (`items[3].qty`,
/// empty for the document itself). `more` holds the other failures found in the same pass
/// (check violations of other fields or list elements, `@[check]`), each with its own path.
pub type Error = { path: List[u8], msg: List[u8], more: List[Error] }

/// "<path>: <msg>", or the message alone at the top; one more line for each of `more`.
pub fn error_text(e: Error) -> List[u8] {
    let mut m = e.path.copy()
    if e.path.len() > 0 { bytes.append(inout m, ": ".bytes()) }
    bytes.append(inout m, e.msg)
    for x in e.more {
        m.push(10)
        bytes.append(inout m, error_text(x))
    }
    m
}

/// Every failure in `e`, itself first, as a flat list (each with an empty `more`).
pub fn errors(e: Error) -> List[Error] {
    let mut out: List[Error] = List.new()
    out.push(error_at(e.path.copy(), e.msg.copy()))
    for x in e.more {
        for y in errors(x) { out.push(y) }
    }
    out
}

/// Each failure in `e` as a line of text ("path: message"), in order.
pub fn messages(e: Error) -> List[List[u8]] {
    let mut out: List[List[u8]] = List.new()
    for x in errors(e) { out.push(error_text(x)) }
    out
}

/// One error for several: the first, with the rest in `more`. `xs` must not be empty.
pub fn combine(xs: List[Error]) -> Error {
    let mut flat: List[Error] = List.new()
    for x in xs {
        for y in errors(x) { flat.push(y) }
    }
    let mut first = flat[0].copy()
    for i in 1..flat.len() { first.more.push(flat[i].copy()) }
    first
}

/// An error with no path yet.
pub fn error(msg: str) -> Error { Error(List.new(), msg.bytes(), List.new()) }

/// An error with this message at `path`.
pub fn error_at(path: List[u8], msg: List[u8]) -> Error { Error(path, msg, List.new()) }

/// The kinds of the data model, as a `Deserializer` sees a value. `Int` is any number without
/// a fraction, `Float` any other.
pub type Kind =
    | KNull
    | KBool
    | KInt
    | KFloat
    | KStr
    | KBytes
    | KList
    | KMap
    | KTime

/// A path with a field appended: `a.b`, and `b` when the path is empty.
pub fn path_field(path: List[u8], name: List[u8]) -> List[u8] {
    let mut p = path.copy()
    if p.len() > 0 { p.push(46) }
    bytes.append(inout p, name)
    p
}

/// A path with an index appended: `a[3]`.
pub fn path_index(path: List[u8], i: usize) -> List[u8] {
    let mut p = path.copy()
    p.push(91)
    bytes.append(inout p, bytes.from_u64(i as u64))
    p.push(93)
    p
}

/// A format's writer. The calls come in document order; a `begin_*` is closed by its `end_*`,
/// and between them a list has its elements (each a complete value: a scalar or a
/// begin/end pair), a map or a record or a variant has `key` (or `field`) and then the value.
/// Every call may fail (a TOML list cannot hold an absent option); the caller stops
/// at the first error.
pub trait Serializer {
    /// The format's name: `"json"`, `"toml"`, `"value"`.
    fn format(self) -> str
    fn bool(inout self, v: bool) -> Result[(), Error]
    fn int(inout self, v: i64) -> Result[(), Error]
    fn uint(inout self, v: u64) -> Result[(), Error]
    fn float(inout self, v: f64) -> Result[(), Error]
    /// UTF-8 text.
    fn string(inout self, v: List[u8]) -> Result[(), Error]
    fn bytes(inout self, v: List[u8]) -> Result[(), Error]
    fn time(inout self, v: time.DateTime) -> Result[(), Error]
    /// An absent option. A present one is just its value.
    fn none(inout self) -> Result[(), Error]
    fn begin_list(inout self, len: usize) -> Result[(), Error]
    fn end_list(inout self) -> Result[(), Error]
    fn begin_map(inout self, len: usize) -> Result[(), Error]
    fn key(inout self, k: List[u8]) -> Result[(), Error]
    fn end_map(inout self) -> Result[(), Error]
    fn begin_record(inout self, len: usize) -> Result[(), Error]
    fn field(inout self, name: List[u8]) -> Result[(), Error]
    fn end_record(inout self) -> Result[(), Error]
    /// A variant with fields: `name` of the enum `type_name`, with `len` fields (written with
    /// `field`), tagged by the key `tag` unless that is empty (then by the variant's name as
    /// the one key of a record).
    fn begin_variant(inout self, name: List[u8], tag: List[u8], len: usize) -> Result[(), Error]
    fn end_variant(inout self) -> Result[(), Error]
    /// The next record written is merged into the record open now: its `begin_record` and
    /// `end_record` write nothing and its fields become the open record's (`json(flatten)`).
    fn merge_next(inout self) -> Result[(), Error]
}

/// A cursor on one value of a parsed document. It is a small value, copied freely; the
/// getters go to a child (`at`, `get`, `key_at`, `value_at`) and the readers take the value as
/// a type. A reader that does not find what it is asked for returns an `Error` that names the
/// path: use `serial.expected`.
pub trait Deserializer {
    fn format(self) -> str
    /// The path to this value: `items[3].qty`, empty for the document itself.
    fn path(self) -> List[u8]
    fn kind(self) -> Kind
    fn read_bool(self) -> Result[bool, Error]
    /// An integer in the range of an i64.
    fn read_i64(self) -> Result[i64, Error]
    /// An integer in the range of a u64.
    fn read_u64(self) -> Result[u64, Error]
    /// Any number.
    fn read_f64(self) -> Result[f64, Error]
    fn read_string(self) -> Result[List[u8], Error]
    fn read_bytes(self) -> Result[List[u8], Error]
    fn read_time(self) -> Result[time.DateTime, Error]
    /// The number of elements of a list, or of members of a map.
    fn len(self) -> usize
    /// Element `i` of a list.
    fn at(self, i: usize) -> Result[Self, Error]
    /// The member `key` of a map, None when it is not there.
    fn get(self, key: List[u8]) -> Option[Self]
    /// The key of member `i` of a map, in the document's order.
    fn key_at(self, i: usize) -> List[u8]
    /// The value of member `i` of a map.
    fn value_at(self, i: usize) -> Self
}

/// A value that can be written to any format. Implement it by hand, or derive it with
/// `@[derive(Serialize)]` (records and enums).
@[derive]
pub trait Serialize {
    fn serialize[S: Serializer](self, inout s: S) -> Result[(), Error] {
        comptime if is_enum_type[Self] { serialize_enum(self, inout s) } else { serialize_record(self, inout s) }
    }
}

/// A value that can be read from any format. `missing` is the value of a record field whose
/// member is absent: Some(None) for an Option, else None (the member is required).
@[derive]
pub trait Deserialize {
    fn deserialize[D: Deserializer](d: D) -> Result[Self, Error] {
        comptime if is_enum_type[Self] {
            deserialize_enum(d)
        } else {
            let mut known: List[List[u8]] = List.new()
            deserialize_record(d, false, inout known)
        }
    }
    /// Reads the type from a map that holds the members of other fields too, as a `flatten`ed
    /// field does (`json(flatten)`): it does not reject members it does not know, and adds the
    /// names of the members it takes (and its own flattened fields') to `known`, so the outer
    /// record can reject the rest. A type with its own `deserialize` that can be flattened
    /// defines this as well.
    fn deserialize_flat[D: Deserializer](d: D, inout known: List[List[u8]]) -> Result[Self, Error] {
        comptime if is_enum_type[Self] { deserialize_enum(d) } else { deserialize_record(d, true, inout known) }
    }
    fn missing() -> Option[Self] { None }
}

/// The error for a value of the wrong kind: "expected <what>, found <kind>" at the path.
pub fn expected[D: Deserializer](d: D, what: str) -> Error {
    let mut m = "expected ".bytes()
    bytes.append(inout m, what.bytes())
    bytes.append(inout m, ", found ".bytes())
    bytes.append(inout m, kind_name(d.kind()).bytes())
    error_at(d.path(), m)
}

/// An error with this message at the path of `d`.
pub fn fail[D: Deserializer](d: D, msg: str) -> Error { error_at(d.path(), msg.bytes()) }

/// The name of a kind: "null", "a boolean", ...
pub fn kind_name(k: Kind) -> str {
    match k {
        KNull => "null"
        KBool => "a boolean"
        KInt => "an integer"
        KFloat => "a number"
        KStr => "a string"
        KBytes => "bytes"
        KList => "a list"
        KMap => "a map"
        KTime => "a time"
    }
}

// ---- the built-in types

fn int_in_range[D: Deserializer](d: D, what: str, lo: i64, hi: i64) -> Result[i64, Error] {
    let v = d.read_i64()?
    if v < lo || v > hi {
        let mut m = "expected ".bytes()
        bytes.append(inout m, what.bytes())
        bytes.append(inout m, ", the number is out of range".bytes())
        return Err(error_at(d.path(), m))
    }
    Ok(v)
}

impl Serialize for bool {
    fn serialize[S: Serializer](self, inout s: S) -> Result[(), Error] { s.bool(self) }
}
impl Deserialize for bool {
    fn deserialize[D: Deserializer](d: D) -> Result[bool, Error] { d.read_bool() }
}

impl Serialize for i64 {
    fn serialize[S: Serializer](self, inout s: S) -> Result[(), Error] { s.int(self) }
}
impl Deserialize for i64 {
    fn deserialize[D: Deserializer](d: D) -> Result[i64, Error] { d.read_i64() }
}

impl Serialize for i16 {
    fn serialize[S: Serializer](self, inout s: S) -> Result[(), Error] { s.int(self as i64) }
}
impl Deserialize for i16 {
    fn deserialize[D: Deserializer](d: D) -> Result[i16, Error] {
        let v = int_in_range(d, "an i16", -32768, 32767)?
        Ok(v as i16)
    }
}

impl Serialize for i32 {
    fn serialize[S: Serializer](self, inout s: S) -> Result[(), Error] { s.int(self as i64) }
}
impl Deserialize for i32 {
    fn deserialize[D: Deserializer](d: D) -> Result[i32, Error] {
        let v = int_in_range(d, "an i32", -2147483648, 2147483647)?
        Ok(v as i32)
    }
}

impl Serialize for u8 {
    fn serialize[S: Serializer](self, inout s: S) -> Result[(), Error] { s.uint(self as u64) }
}
impl Deserialize for u8 {
    fn deserialize[D: Deserializer](d: D) -> Result[u8, Error] {
        let v = int_in_range(d, "a u8", 0, 255)?
        Ok(v as u8)
    }
}

impl Serialize for u16 {
    fn serialize[S: Serializer](self, inout s: S) -> Result[(), Error] { s.uint(self as u64) }
}
impl Deserialize for u16 {
    fn deserialize[D: Deserializer](d: D) -> Result[u16, Error] {
        let v = int_in_range(d, "a u16", 0, 65535)?
        Ok(v as u16)
    }
}

impl Serialize for u32 {
    fn serialize[S: Serializer](self, inout s: S) -> Result[(), Error] { s.uint(self as u64) }
}
impl Deserialize for u32 {
    fn deserialize[D: Deserializer](d: D) -> Result[u32, Error] {
        let v = int_in_range(d, "a u32", 0, 4294967295)?
        Ok(v as u32)
    }
}

impl Serialize for u64 {
    fn serialize[S: Serializer](self, inout s: S) -> Result[(), Error] { s.uint(self) }
}
impl Deserialize for u64 {
    fn deserialize[D: Deserializer](d: D) -> Result[u64, Error] { d.read_u64() }
}

impl Serialize for usize {
    fn serialize[S: Serializer](self, inout s: S) -> Result[(), Error] { s.uint(self as u64) }
}
impl Deserialize for usize {
    fn deserialize[D: Deserializer](d: D) -> Result[usize, Error] {
        let v = d.read_u64()?
        Ok(v as usize)
    }
}

impl Serialize for f64 {
    fn serialize[S: Serializer](self, inout s: S) -> Result[(), Error] { s.float(self) }
}
impl Deserialize for f64 {
    fn deserialize[D: Deserializer](d: D) -> Result[f64, Error] { d.read_f64() }
}

impl Serialize for String {
    fn serialize[S: Serializer](self, inout s: S) -> Result[(), Error] { s.string(self.bytes()) }
}
impl Deserialize for String {
    fn deserialize[D: Deserializer](d: D) -> Result[String, Error] {
        let b = d.read_string()?
        match String.from_bytes(b) {
            Ok(x) => Ok(x)
            Err(_) => Err(fail(d, "a string with a NUL character"))
        }
    }
}

impl Serialize for str {
    fn serialize[S: Serializer](self, inout s: S) -> Result[(), Error] { s.string(self.bytes()) }
}

/// Bytes, as opposed to a list of numbers: a format writes them its own way (base64 text in
/// JSON and TOML).
pub type Bytes = { data: List[u8] }

impl Serialize for Bytes {
    fn serialize[S: Serializer](self, inout s: S) -> Result[(), Error] { s.bytes(self.data) }
}
impl Deserialize for Bytes {
    fn deserialize[D: Deserializer](d: D) -> Result[Bytes, Error] {
        let b = d.read_bytes()?
        Ok(Bytes(b))
    }
}

impl Serialize for time.DateTime {
    fn serialize[S: Serializer](self, inout s: S) -> Result[(), Error] { s.time(self) }
}
impl Deserialize for time.DateTime {
    fn deserialize[D: Deserializer](d: D) -> Result[time.DateTime, Error] { d.read_time() }
}

impl[T: Serialize] Serialize for List[T] {
    fn serialize[S: Serializer](self, inout s: S) -> Result[(), Error] {
        s.begin_list(self.len())?
        for x in self { x.serialize(inout s)? }
        s.end_list()
    }
}
impl[T: Deserialize] Deserialize for List[T] {
    fn deserialize[D: Deserializer](d: D) -> Result[List[T], Error] {
        if d.kind() != KList { return Err(expected(d, "a list")) }
        let mut out: List[T] = List.new()
        let mut errs: List[Error] = List.new()
        for i in 0..d.len() {
            let c = d.at(i)?
            match T.deserialize(c) {
                Ok(x) => out.push(x)
                Err(e) => errs.push(e)
            }
        }
        if errs.len() > 0 { return Err(combine(errs)) }
        Ok(out)
    }
}

impl[T: Serialize] Serialize for Option[T] {
    fn serialize[S: Serializer](self, inout s: S) -> Result[(), Error] {
        match self {
            Some(x) => x.serialize(inout s)
            None => s.none()
        }
    }
}
impl[T: Deserialize] Deserialize for Option[T] {
    fn deserialize[D: Deserializer](d: D) -> Result[Option[T], Error] {
        if d.kind() == KNull { return Ok(None) }
        let v = T.deserialize(d)?
        Ok(Some(v))
    }
    fn missing() -> Option[Option[T]] { Some(None) }
}

impl[T: Serialize] Serialize for Map[String, T] {
    fn serialize[S: Serializer](self, inout s: S) -> Result[(), Error] {
        // in key order, so equal Maps give equal documents
        let mut ks = self.keys()
        sort_keys(inout ks)
        s.begin_map(ks.len())?
        for k in ks {
            s.key(k.bytes())?
            match self.get(k) {
                Some(v) => v.serialize(inout s)?
                None => s.none()?
            }
        }
        s.end_map()
    }
}
impl[T: Deserialize] Deserialize for Map[String, T] {
    fn deserialize[D: Deserializer](d: D) -> Result[Map[String, T], Error] {
        if d.kind() != KMap { return Err(expected(d, "a map")) }
        let mut out: Map[String, T] = Map.new()
        let mut errs: List[Error] = List.new()
        for i in 0..d.len() {
            let k = match String.from_bytes(d.key_at(i)) {
                Ok(x) => x
                Err(_) => { return Err(fail(d, "a key with a NUL character")) }
            }
            match T.deserialize(d.value_at(i)) {
                Ok(x) => out.insert(k, x)
                Err(e) => errs.push(e)
            }
        }
        if errs.len() > 0 { return Err(combine(errs)) }
        Ok(out)
    }
}

fn sort_keys(inout xs: List[String]) {
    // insertion sort: maps are small
    for i in 1..xs.len() {
        let mut j = i.copy()
        while j > 0 && xs[j - 1] > xs[j] {
            let a = xs[j - 1].replace(String.from(""))
            let b = xs[j].replace(a)
            xs[j - 1] = b
            j -= 1
        }
    }
}

// ---- Value: the data model as a tree

/// One member of a `VMap`.
pub type Entry = { key: List[u8], value: Value }

/// A value of the data model. A record, a map and a variant with fields are all a `VMap` (in
/// the order they were written); a variant without fields is a `VStr`; an absent option is
/// `VNull`, a present one its value.
pub type Value =
    | VNull
    | VBool(bool)
    | VInt(i64)
    | VUint(u64)
    | VFloat(f64)
    | VStr(List[u8])
    | VBytes(List[u8])
    | VList(List[Value])
    | VMap(List[Entry])
    | VTime(time.DateTime)

/// The member `key` of a `VMap`, None when `v` is not one or has no such member.
pub fn member(v: Value, key: str) -> Option[Value] {
    let k = key.bytes()
    match v {
        VMap(es) => {
            for e in es {
                if bytes.eq(e.key, k) { return Some(e.value) }
            }
            None
        }
        _ => None
    }
}

/// `x` as a `Value`.
pub fn to_value[T: Serialize](x: T) -> Result[Value, Error] {
    let mut s = ValueSerializer(List.new(), None, false)
    x.serialize(inout s)?
    match s.out {
        Some(v) => Ok(v)
        None => Err(error("nothing was written"))
    }
}

/// The value of type T in `v`.
pub fn from_value[T: Deserialize](v: Value) -> Result[T, Error] {
    T.deserialize(ValueDeserializer(v, List.new()))
}

/// What a `ValueSerializer` has open: a list, or a map, record or variant filled with entries
/// (`plain`: not a variant with the name as the one key).
pub type Frame = { is_list: bool, items: List[Value], entries: List[Entry], key: List[u8], variant: List[u8], plain: bool, merged: bool }

/// Writes a `Value` (`to_value`): the format named "value".
pub type ValueSerializer = { stack: List[Frame], out: Option[Value], merge: bool }

impl ValueSerializer {
    fn put(inout self, v: Value) -> Result[(), Error] {
        let n = self.stack.len()
        if n == 0 {
            if self.out.is_some() { return Err(error("a second value at the top")) }
            self.out = Some(v)
            return Ok(())
        }
        if self.stack[n - 1].is_list {
            self.stack[n - 1].items.push(v)
        } else {
            // a merged record's members go to the record it is merged into
            let k = self.stack[n - 1].key.copy()
            let mut i = n - 1
            while self.stack[i].merged && i > 0 { i -= 1 }
            self.stack[i].entries.push(Entry(k, v))
        }
        Ok(())
    }

    fn open(inout self, is_list: bool) {
        self.stack.push(Frame(is_list, List.new(), List.new(), List.new(), List.new(), true, false))
    }

    fn close(inout self) -> Frame {
        let n = self.stack.len()
        let f = self.stack[n - 1].copy()
        self.stack.pop()
        f
    }
}

impl Serializer for ValueSerializer {
    fn format(self) -> str { "value" }
    fn bool(inout self, v: bool) -> Result[(), Error] { self.put(VBool(v)) }
    fn int(inout self, v: i64) -> Result[(), Error] { self.put(VInt(v)) }
    fn uint(inout self, v: u64) -> Result[(), Error] { self.put(VUint(v)) }
    fn float(inout self, v: f64) -> Result[(), Error] { self.put(VFloat(v)) }
    fn string(inout self, v: List[u8]) -> Result[(), Error] { self.put(VStr(v)) }
    fn bytes(inout self, v: List[u8]) -> Result[(), Error] { self.put(VBytes(v)) }
    fn time(inout self, v: time.DateTime) -> Result[(), Error] { self.put(VTime(v)) }
    fn none(inout self) -> Result[(), Error] { self.put(VNull) }
    fn begin_list(inout self, len: usize) -> Result[(), Error] {
        self.open(true)
        Ok(())
    }
    fn end_list(inout self) -> Result[(), Error] {
        let f = self.close()
        self.put(VList(f.items))
    }
    fn begin_map(inout self, len: usize) -> Result[(), Error] {
        self.open(false)
        Ok(())
    }
    fn key(inout self, k: List[u8]) -> Result[(), Error] {
        let n = self.stack.len()
        self.stack[n - 1].key = k
        Ok(())
    }
    fn end_map(inout self) -> Result[(), Error] {
        let f = self.close()
        self.put(VMap(f.entries))
    }
    fn begin_record(inout self, len: usize) -> Result[(), Error] {
        self.open(false)
        if self.merge {
            self.merge = false
            let n = self.stack.len()
            self.stack[n - 1].merged = true
        }
        Ok(())
    }
    fn merge_next(inout self) -> Result[(), Error] {
        self.merge = true
        Ok(())
    }
    fn field(inout self, name: List[u8]) -> Result[(), Error] {
        let n = self.stack.len()
        self.stack[n - 1].key = name
        Ok(())
    }
    fn end_record(inout self) -> Result[(), Error] {
        let f = self.close()
        if f.merged { return Ok(()) }
        self.put(VMap(f.entries))
    }
    fn begin_variant(inout self, name: List[u8], tag: List[u8], len: usize) -> Result[(), Error] {
        self.open(false)
        let n = self.stack.len()
        if tag.len() > 0 {
            self.stack[n - 1].entries.push(Entry(tag, VStr(name)))
        } else {
            self.stack[n - 1].plain = false
            self.stack[n - 1].variant = name
        }
        Ok(())
    }
    fn end_variant(inout self) -> Result[(), Error] {
        let f = self.close()
        if f.plain { return self.put(VMap(f.entries)) }
        let mut one: List[Entry] = List.new()
        one.push(Entry(f.variant, VMap(f.entries)))
        self.put(VMap(one))
    }
}

/// Reads a `Value` (`from_value`): a cursor on `v`, `path` the path to it.
pub type ValueDeserializer = { v: Value, path: List[u8] }

/// A reader of `v`.
pub fn reader(v: Value) -> ValueDeserializer { ValueDeserializer(v, List.new()) }

impl Deserializer for ValueDeserializer {
    fn format(self) -> str { "value" }
    fn path(self) -> List[u8] { self.path.copy() }
    fn kind(self) -> Kind {
        match self.v {
            VNull => KNull
            VBool(_) => KBool
            VInt(_) => KInt
            VUint(_) => KInt
            VFloat(_) => KFloat
            VStr(_) => KStr
            VBytes(_) => KBytes
            VList(_) => KList
            VMap(_) => KMap
            VTime(_) => KTime
        }
    }
    fn read_bool(self) -> Result[bool, Error] {
        match self.v {
            VBool(b) => Ok(b)
            _ => Err(expected(self, "a boolean"))
        }
    }
    fn read_i64(self) -> Result[i64, Error] {
        match self.v {
            VInt(n) => Ok(n)
            VUint(u) => {
                if u > 9223372036854775807 { return Err(fail(self, "the number is out of range")) }
                Ok(u as i64)
            }
            _ => Err(expected(self, "an integer"))
        }
    }
    fn read_u64(self) -> Result[u64, Error] {
        match self.v {
            VInt(n) => {
                if n < 0 { return Err(fail(self, "the number is out of range")) }
                Ok(n as u64)
            }
            VUint(u) => Ok(u)
            _ => Err(expected(self, "an integer"))
        }
    }
    fn read_f64(self) -> Result[f64, Error] {
        match self.v {
            VFloat(f) => Ok(f)
            VInt(n) => Ok(n as f64)
            VUint(u) => Ok(u as f64)
            _ => Err(expected(self, "a number"))
        }
    }
    fn read_string(self) -> Result[List[u8], Error] {
        match self.v {
            VStr(s) => Ok(s)
            _ => Err(expected(self, "a string"))
        }
    }
    fn read_bytes(self) -> Result[List[u8], Error] {
        match self.v {
            VBytes(b) => Ok(b)
            _ => Err(expected(self, "bytes"))
        }
    }
    fn read_time(self) -> Result[time.DateTime, Error] {
        match self.v {
            VTime(t) => Ok(t)
            _ => Err(expected(self, "a time"))
        }
    }
    fn len(self) -> usize {
        match self.v {
            VList(xs) => xs.len()
            VMap(es) => es.len()
            _ => 0
        }
    }
    fn at(self, i: usize) -> Result[ValueDeserializer, Error] {
        match self.v {
            VList(xs) => {
                if i < xs.len() { return Ok(ValueDeserializer(xs[i].copy(), path_index(self.path, i))) }
                Err(fail(self, "no such element"))
            }
            _ => Err(expected(self, "a list"))
        }
    }
    fn get(self, key: List[u8]) -> Option[ValueDeserializer] {
        match self.v {
            VMap(es) => {
                for e in es {
                    if bytes.eq(e.key, key) { return Some(ValueDeserializer(e.value.copy(), path_field(self.path, key))) }
                }
                None
            }
            _ => None
        }
    }
    fn key_at(self, i: usize) -> List[u8] {
        match self.v {
            VMap(es) => es[i].key.copy()
            _ => List.new()
        }
    }
    fn value_at(self, i: usize) -> ValueDeserializer {
        match self.v {
            VMap(es) => ValueDeserializer(es[i].value.copy(), path_field(self.path, es[i].key))
            _ => ValueDeserializer(VNull, self.path.copy())
        }
    }
}

// ---- validation: `@[check(...)]` (docs/compiler.md, "C8.63")

/// Rules for the value of a field, enforced when a derived `Deserialize` reads the record, and
/// read by schema derivations (eider-openapi's `Schematic`) so documentation and checking
/// agree. Every key is optional; what is left at its default is not checked.
///
/// - `min`, `max`: the least and greatest value (inclusive) of a number field. An `Option`
///   field is checked when present; a `List` or `Map` field checks each element.
/// - `min_len`, `max_len`: the fewest and most characters of a `String`, items of a `List`,
///   entries of a `Map` (the container itself, not its elements).
/// - `format`: a name from `std/validate` (`email`, `uuid`, `uri`, `date`, `date-time`, `ipv4`,
///   `hostname`) for a `String`.
/// - `one_of`: the allowed values of a `String`, comma separated (`"low,medium,high"`).
/// - `by`: a module of yours with `pub fn validate(v: T) -> Result[(), String]` for the field's
///   type; the `Err` text is the violation. Schemas do not describe it.
///
/// Every violation of a record is reported at once, each at the path of its field
/// (`lines[2].qty: must be at least 1`). A key that does not fit the field's type (`min` on a
/// `String`) is itself a violation, so it shows the first time the type is read.
pub attr check {
    min: i64 = -9223372036854775807 - 1,
    max: i64 = 9223372036854775807,
    min_len: i64 = 0,
    max_len: i64 = -1,
    format: str = "",
    one_of: str = "",
    @[names_module] by: str = "",
}

/// The value of `check.min` and `check.max` when they are not set.
pub const NO_MIN: i64 = -9223372036854775807 - 1
pub const NO_MAX: i64 = 9223372036854775807

fn violation(path: List[u8], msg: List[u8], inout errs: List[Error]) { errs.push(error_at(path.copy(), msg)) }

fn misapplied(path: List[u8], key: str, inout errs: List[Error]) {
    let mut m = "@[check(".bytes()
    bytes.append(inout m, key.bytes())
    bytes.append(inout m, ")] does not apply to this type".bytes())
    violation(path, m, inout errs)
}

fn range_violation(v: i64, r: check, path: List[u8], inout errs: List[Error]) {
    if r.min != NO_MIN && v < r.min {
        let mut m = "must be at least ".bytes()
        bytes.append(inout m, bytes.from_i64(r.min))
        violation(path, m, inout errs)
    }
    if r.max != NO_MAX && v > r.max {
        let mut m = "must be at most ".bytes()
        bytes.append(inout m, bytes.from_i64(r.max))
        violation(path, m, inout errs)
    }
}

fn not_text_rules(r: check, path: List[u8], inout errs: List[Error]) {
    if r.format.len() > 0 { misapplied(path.copy(), "format", inout errs) }
    if r.one_of.len() > 0 { misapplied(path.copy(), "one_of", inout errs) }
}

/// A value the rules of `@[check]` can judge.
pub trait Checkable {
    /// Appends a violation for each of `r`'s rules that `self` breaks; `path` names the value.
    fn check_value(self, r: check, path: List[u8], inout errs: List[Error])
}

/// A value with a size `@[check(min_len, max_len)]` can judge.
pub trait Counted {
    /// The size, None when the value is absent (an `Option`).
    fn count(self) -> Option[usize]
    /// What `count` counts, in the singular: "character", "item", "entry".
    fn noun(self) -> str
}

/// Checks the size of `v` against `min_len` and `max_len`.
pub fn check_size[F: Counted](v: F, r: check, path: List[u8], inout errs: List[Error]) {
    match v.count() {
        Some(n) => {
            if (n as i64) < r.min_len {
                let mut m = "must have at least ".bytes()
                // the same words eider-openapi's schema validation uses
                if r.min_len == 1 && bytes.eq(v.noun().bytes(), "character".bytes()) {
                    m = "must not be empty".bytes()
                } else {
                    bytes.append(inout m, bytes.from_i64(r.min_len))
                    m.push(32)
                    bytes.append(inout m, plural(v.noun(), r.min_len))
                }
                violation(path.copy(), m, inout errs)
            }
            if r.max_len >= 0 && (n as i64) > r.max_len {
                let mut m = "must have at most ".bytes()
                bytes.append(inout m, bytes.from_i64(r.max_len))
                m.push(32)
                bytes.append(inout m, plural(v.noun(), r.max_len))
                violation(path.copy(), m, inout errs)
            }
        }
        None => {}
    }
}

/// `noun` in the plural unless `n` is 1: "item" -> "items", "entry" -> "entries".
fn plural(noun: str, n: i64) -> List[u8] {
    let mut w = noun.bytes()
    if n == 1 { return w }
    if w[w.len() - 1] == 121 {
        w.pop()
        bytes.append(inout w, "ies".bytes())
    } else {
        w.push(115)
    }
    w
}

impl Counted for String {
    fn count(self) -> Option[usize] {
        // characters: the bytes that start a UTF-8 sequence
        let mut n: usize = 0
        for b in self.bytes() {
            if b < 128 || b >= 192 { n += 1 }
        }
        Some(n)
    }
    fn noun(self) -> str { "character" }
}

impl[T] Counted for List[T] {
    fn count(self) -> Option[usize] { Some(self.len()) }
    fn noun(self) -> str { "item" }
}

impl[T] Counted for Map[String, T] {
    fn count(self) -> Option[usize] { Some(self.len()) }
    fn noun(self) -> str { "entry" }
}

impl[T: Counted] Counted for Option[T] {
    fn count(self) -> Option[usize] {
        match self {
            Some(x) => x.count()
            None => None
        }
    }
    fn noun(self) -> str {
        match self {
            Some(x) => x.noun()
            None => ""
        }
    }
}

impl Checkable for String {
    fn check_value(self, r: check, path: List[u8], inout errs: List[Error]) {
        if r.min != NO_MIN { misapplied(path.copy(), "min", inout errs) }
        if r.max != NO_MAX { misapplied(path.copy(), "max", inout errs) }
        let b = self.bytes()
        if r.format.len() > 0 {
            if !validate.known(r.format) {
                let mut m = "unknown format `".bytes()
                bytes.append(inout m, r.format.bytes())
                bytes.append(inout m, "` (the formats: ".bytes())
                bytes.append(inout m, validate.names().bytes())
                m.push(41)
                violation(path.copy(), m, inout errs)
            } else if !validate.valid(r.format, b) {
                let mut m = "must be ".bytes()
                bytes.append(inout m, validate.describe(r.format).bytes())
                violation(path.copy(), m, inout errs)
            }
        }
        if r.one_of.len() > 0 {
            let allowed = bytes.split(r.one_of.bytes(), 44)
            if !allowed.contains(b) {
                let mut quoted: List[List[u8]] = List.new()
                for a in allowed {
                    let mut q = "\"".bytes()
                    bytes.append(inout q, a)
                    q.push(34)
                    quoted.push(q)
                }
                let mut m = "must be one of ".bytes()
                bytes.append(inout m, bytes.join(quoted, ", ".bytes()))
                violation(path.copy(), m, inout errs)
            }
        }
    }
}

impl Checkable for i64 {
    fn check_value(self, r: check, path: List[u8], inout errs: List[Error]) {
        not_text_rules(r, path.copy(), inout errs)
        range_violation(self, r, path, inout errs)
    }
}

impl Checkable for i16 {
    fn check_value(self, r: check, path: List[u8], inout errs: List[Error]) {
        not_text_rules(r, path.copy(), inout errs)
        range_violation(self as i64, r, path, inout errs)
    }
}

impl Checkable for i32 {
    fn check_value(self, r: check, path: List[u8], inout errs: List[Error]) {
        not_text_rules(r, path.copy(), inout errs)
        range_violation(self as i64, r, path, inout errs)
    }
}

impl Checkable for u8 {
    fn check_value(self, r: check, path: List[u8], inout errs: List[Error]) {
        not_text_rules(r, path.copy(), inout errs)
        range_violation(self as i64, r, path, inout errs)
    }
}

impl Checkable for u16 {
    fn check_value(self, r: check, path: List[u8], inout errs: List[Error]) {
        not_text_rules(r, path.copy(), inout errs)
        range_violation(self as i64, r, path, inout errs)
    }
}

impl Checkable for u32 {
    fn check_value(self, r: check, path: List[u8], inout errs: List[Error]) {
        not_text_rules(r, path.copy(), inout errs)
        range_violation(self as i64, r, path, inout errs)
    }
}

impl Checkable for u64 {
    fn check_value(self, r: check, path: List[u8], inout errs: List[Error]) {
        not_text_rules(r, path.copy(), inout errs)
        // above the range of an i64 it is above any `max`
        if self > 9223372036854775807 {
            if r.max != NO_MAX {
                let mut m = "must be at most ".bytes()
                bytes.append(inout m, bytes.from_i64(r.max))
                violation(path, m, inout errs)
            }
            return
        }
        range_violation(self as i64, r, path, inout errs)
    }
}

impl Checkable for usize {
    fn check_value(self, r: check, path: List[u8], inout errs: List[Error]) {
        let v = self as u64
        v.check_value(r, path, inout errs)
    }
}

impl Checkable for f64 {
    fn check_value(self, r: check, path: List[u8], inout errs: List[Error]) {
        not_text_rules(r, path.copy(), inout errs)
        if r.min != NO_MIN && self < (r.min as f64) {
            let mut m = "must be at least ".bytes()
            bytes.append(inout m, bytes.from_i64(r.min))
            violation(path.copy(), m, inout errs)
        }
        if r.max != NO_MAX && self > (r.max as f64) {
            let mut m = "must be at most ".bytes()
            bytes.append(inout m, bytes.from_i64(r.max))
            violation(path.copy(), m, inout errs)
        }
    }
}

impl[T: Checkable] Checkable for Option[T] {
    fn check_value(self, r: check, path: List[u8], inout errs: List[Error]) {
        match self {
            Some(x) => x.check_value(r, path, inout errs)
            None => {}
        }
    }
}

impl[T: Checkable] Checkable for List[T] {
    fn check_value(self, r: check, path: List[u8], inout errs: List[Error]) {
        for i in 0..self.len() { self[i].check_value(r, path_index(path, i), inout errs) }
    }
}

impl[T: Checkable] Checkable for Map[String, T] {
    fn check_value(self, r: check, path: List[u8], inout errs: List[Error]) {
        let mut ks = self.keys()
        sort_keys(inout ks)
        for k in ks {
            match self.get(k) {
                Some(v) => v.check_value(r, path_field(path, k.bytes()), inout errs)
                None => {}
            }
        }
    }
}

// ---- attributes and derivation (docs/compiler.md, "C8.61")

/// How a type, field or variant maps to the data model, for every format. On a field: `name`
/// (the key it is written under; default the field's name), `skip` (never written; read as
/// its Default), `default` (when absent on reading: its Default instead of an error). On a
/// variant: `name`. On a type: `rename_all` (`snake_case`, `camelCase`, `kebab-case` or
/// `SCREAMING_SNAKE_CASE`, for the names of its fields or variants), `tag` (an enum's tag key;
/// without one a variant with fields is written under its name).
pub attr serial { name: str = "", skip: bool = false, default: bool = false, rename_all: str = "", tag: str = "", unknown: str = "", @[names_module] with: str = "" }

/// `serial` for JSON only: what is set here wins over `serial`. Also `flatten` (a record
/// field whose members are the outer object's; a record that has one accepts unknown members)
/// and `unknown` (`deny`, the default, or `ignore`: what reading does with a member no field
/// takes).
pub attr json { name: str = "", skip: bool = false, default: bool = false, rename_all: str = "", tag: str = "", flatten: bool = false, unknown: str = "", @[names_module] with: str = "" }

/// `serial` for TOML only: what is set here wins over `serial`; `unknown` as in `json`.
pub attr toml { name: str = "", skip: bool = false, default: bool = false, rename_all: str = "", tag: str = "", unknown: str = "", @[names_module] with: str = "" }

fn is_format(fmt: str, name: str) -> bool { bytes.eq(fmt.bytes(), name.bytes()) }

/// The text for the format `fmt`: the one set for it, else the neutral one.
pub fn pick(fmt: str, neutral: str, json: str, toml: str) -> str {
    if is_format(fmt, "json") && json.len() > 0 { return json }
    if is_format(fmt, "toml") && toml.len() > 0 { return toml }
    neutral
}

/// Which adapter module a field uses for the format `fmt`: 1 the `json` one, 2 the `toml` one,
/// 3 the `serial` one, 0 none (the type's own `Serialize`/`Deserialize`). Each argument says
/// whether that attribute names a module (`with`).
pub fn which(fmt: str, json: bool, toml: bool, neutral: bool) -> u32 {
    if json && is_format(fmt, "json") { return 1 }
    if toml && is_format(fmt, "toml") { return 2 }
    if neutral { return 3 }
    0
}

/// A value of type F from the cursor `d` (F from the context).
fn read_one[F: Deserialize, D: Deserializer](d: D) -> Result[F, Error] { F.deserialize(d) }

/// The flag for the format `fmt`: set neutrally or for it.
pub fn flag(fmt: str, neutral: bool, json: bool, toml: bool) -> bool {
    neutral || (is_format(fmt, "json") && json) || (is_format(fmt, "toml") && toml)
}

/// The key of a field or variant named `name`: `rename` if given, else `name` in the case
/// `rule` names.
pub fn member_name(name: str, rename: str, rule: str) -> List[u8] {
    if rename.len() > 0 { return rename.bytes() }
    let src = name.bytes()
    let r = rule.bytes()
    if r.len() == 0 { return src }
    // the words: split at `_` and before an upper-case letter after a lower-case one
    let mut words: List[List[u8]] = List.new()
    let mut cur: List[u8] = List.new()
    for i in 0..src.len() {
        let c = src[i]
        let is_up = c >= 65 && c <= 90
        let prev_lower = i > 0 && src[i - 1] >= 97 && src[i - 1] <= 122
        if c == 95 || (is_up && prev_lower) {
            if cur.len() > 0 { words.push(cur.replace(List.new())) }
            if c == 95 { continue }
        }
        cur.push(lower(c))
    }
    if cur.len() > 0 { words.push(cur) }
    let mut out: List[u8] = List.new()
    let camel = bytes.eq(r, "camelCase".bytes())
    let kebab = bytes.eq(r, "kebab-case".bytes())
    let scream = bytes.eq(r, "SCREAMING_SNAKE_CASE".bytes())
    for i in 0..words.len() {
        let wd = words[i].copy()
        if i > 0 && !camel { if kebab { out.push(45) } else { out.push(95) } }
        for j in 0..wd.len() {
            let c = wd[j]
            if (camel && i > 0 && j == 0) || scream { out.push(upper(c)) } else { out.push(c) }
        }
    }
    out
}

fn lower(c: u8) -> u8 {
    if c >= 65 && c <= 90 { return c + 32 }
    c
}

fn upper(c: u8) -> u8 {
    if c >= 97 && c <= 122 { return c - 32 }
    c
}

/// A record as a record of the data model: one field per field of the type (`serial`, `json`
/// and `toml`: renamed, skipped, flattened).
pub fn serialize_record[T, S: Serializer](x: T, inout s: S) -> Result[(), Error] {
    let fmt = s.format()
    let rule = pick(fmt, attr[serial](T).rename_all, attr[json](T).rename_all, attr[toml](T).rename_all)
    let mut n: usize = 0
    comptime for f in fields(T) {
        if !flag(fmt, attr[serial](f).skip, attr[json](f).skip, attr[toml](f).skip) {
            if !(attr[json](f).flatten && is_format(fmt, "json")) { n += 1 }
        }
    }
    s.begin_record(n)?
    comptime for f in fields(T) {
        if !flag(fmt, attr[serial](f).skip, attr[json](f).skip, attr[toml](f).skip) {
            if attr[json](f).flatten && is_format(fmt, "json") {
                s.merge_next()?
            } else {
                s.field(member_name(f.name, pick(fmt, attr[serial](f).name, attr[json](f).name, attr[toml](f).name), rule))?
            }
            let w = which(fmt, attr[json](f).with != "", attr[toml](f).with != "", attr[serial](f).with != "")
            if w == 1 {
                comptime if attr[json](f).with != "" { attr[json](f).with.serialize(x.[f], inout s)? } else { panic("serial: no adapter") }
            } else if w == 2 {
                comptime if attr[toml](f).with != "" { attr[toml](f).with.serialize(x.[f], inout s)? } else { panic("serial: no adapter") }
            } else if w == 3 {
                comptime if attr[serial](f).with != "" { attr[serial](f).with.serialize(x.[f], inout s)? } else { panic("serial: no adapter") }
            } else {
                comptime if attr[serial](f).with == "" { x.[f].serialize(inout s)? } else { panic("serial: no adapter") }
            }
        }
    }
    s.end_record()
}

/// The member names of record type T for the format `fmt` ("json", "toml"), in field order,
/// skipped fields left out. `proto` only names the type (pass `none`).
pub fn member_names[T](proto: Option[T], fmt: str) -> List[List[u8]] {
    let rule = pick(fmt, attr[serial](T).rename_all, attr[json](T).rename_all, attr[toml](T).rename_all)
    let mut out: List[List[u8]] = List.new()
    comptime for f in fields(T) {
        if !flag(fmt, attr[serial](f).skip, attr[json](f).skip, attr[toml](f).skip) {
            out.push(member_name(f.name, pick(fmt, attr[serial](f).name, attr[json](f).name, attr[toml](f).name), rule))
        }
    }
    out
}

/// An enum: a variant without fields as its name (a string), one with fields as a record of
/// its fields under its name, or, with a tag key (`serial(tag = "kind")`), as one with the tag
/// first.
pub fn serialize_enum[T, S: Serializer](x: T, inout s: S) -> Result[(), Error] {
    let fmt = s.format()
    let rule = pick(fmt, attr[serial](T).rename_all, attr[json](T).rename_all, attr[toml](T).rename_all)
    let tag = pick(fmt, attr[serial](T).tag, attr[json](T).tag, attr[toml](T).tag)
    comptime for v in variants(T) {
        if v.matches(x) {
            let name = member_name(v.name, pick(fmt, attr[serial](v).name, attr[json](v).name, attr[toml](v).name), rule)
            let mut n: usize = 0
            comptime for f in fields(v) { n += 1 }
            if n == 0 { return s.string(name) }
            s.begin_variant(name, tag.bytes(), n)?
            comptime for f in fields(v) {
                s.field(member_name(f.name, "", rule))?
                x.[f].serialize(inout s)?
            }
            return s.end_variant()
        }
    }
    Err(error("a value of no variant"))
}

fn default_value[F: Default]() -> F { F.default() }

/// The error for a member `key` that the map `d` is at does not have.
fn missing_field[D: Deserializer](d: D, key: List[u8]) -> Error {
    let mut m = "missing field `".bytes()
    bytes.append(inout m, key)
    m.push(96)
    error_at(d.path(), m)
}

/// Member `key` of the map `d` is at, read; absent: F.missing(), else an error.
fn member_value[F: Deserialize, D: Deserializer](d: D, key: List[u8]) -> Result[F, Error] {
    match d.get(key.copy()) {
        Some(c) => F.deserialize(c)
        None => {
            match F.missing() {
                Some(v) => Ok(v)
                None => {
                    let mut m = "missing field `".bytes()
                    bytes.append(inout m, key)
                    m.push(96)
                    Err(error_at(d.path(), m))
                }
            }
        }
    }
}

fn member_or_default[F: Deserialize + Default, D: Deserializer](d: D, key: List[u8]) -> Result[F, Error] {
    if d.get(key.copy()).is_none() { return Ok(F.default()) }
    member_value(d, key)
}

/// A flattened field: its type reads the same map.
fn flat_value[F: Deserialize, D: Deserializer](d: D, inout known: List[List[u8]]) -> Result[F, Error] { F.deserialize_flat(d, inout known) }

/// An error for the first member of the map `d` is at that is not in `known`.
fn reject_unknown[D: Deserializer](d: D, known: List[List[u8]]) -> Result[(), Error] {
    for i in 0..d.len() {
        let k = d.key_at(i)
        if !known.contains(k) {
            let mut m = "unknown field `".bytes()
            bytes.append(inout m, k)
            m.push(96)
            return Err(error_at(d.path(), m))
        }
    }
    Ok(())
}

/// A record from a map: each field from its member. `part`: the map is shared with other
/// fields (a flattened record), so members the record does not know are not its to judge: it
/// adds the names it takes to `outer` and the record that holds it rejects the rest.
pub fn deserialize_record[T, D: Deserializer](d: D, part: bool, inout outer: List[List[u8]]) -> Result[T, Error] {
    if d.kind() != KMap { return Err(expected(d, "a map")) }
    let fmt = d.format()
    let rule = pick(fmt, attr[serial](T).rename_all, attr[json](T).rename_all, attr[toml](T).rename_all)
    // the names of the members this record takes; a flattened field's come as it is read
    let mut known: List[List[u8]] = List.new()
    comptime for f in fields(T) {
        if !(attr[json](f).flatten && is_format(fmt, "json")) {
            known.push(member_name(f.name, pick(fmt, attr[serial](f).name, attr[json](f).name, attr[toml](f).name), rule))
        }
    }
    let out = T(comptime for f in fields(T) {
            comptime if attr[serial](f).skip || attr[json](f).skip || attr[toml](f).skip {
                default_value()
            } else {
                comptime if attr[serial](f).with != "" || attr[json](f).with != "" || attr[toml](f).with != "" {
                    match d.get(member_name(f.name, pick(fmt, attr[serial](f).name, attr[json](f).name, attr[toml](f).name), rule)) {
                        Some(c) => {
                            let w = which(fmt, attr[json](f).with != "", attr[toml](f).with != "", attr[serial](f).with != "")
                            if w == 1 {
                                comptime if attr[json](f).with != "" { attr[json](f).with.deserialize(c)? } else { panic("serial: no adapter") }
                            } else if w == 2 {
                                comptime if attr[toml](f).with != "" { attr[toml](f).with.deserialize(c)? } else { panic("serial: no adapter") }
                            } else if w == 3 {
                                comptime if attr[serial](f).with != "" { attr[serial](f).with.deserialize(c)? } else { panic("serial: no adapter") }
                            } else {
                                comptime if attr[serial](f).with == "" { read_one(c)? } else { panic("serial: no adapter") }
                            }
                        }
                        None => {
                            comptime if attr[serial](f).default || attr[json](f).default || attr[toml](f).default {
                                default_value()
                            } else {
                                return Err(missing_field(d, member_name(f.name, pick(fmt, attr[serial](f).name, attr[json](f).name, attr[toml](f).name), rule)))
                            }
                        }
                    }
                } else {
                    comptime if attr[json](f).flatten {
                        if is_format(fmt, "json") {
                            flat_value(d, inout known)?
                        } else {
                            member_value(d, member_name(f.name, pick(fmt, attr[serial](f).name, attr[json](f).name, attr[toml](f).name), rule))?
                        }
                    } else {
                        comptime if attr[serial](f).default || attr[json](f).default || attr[toml](f).default {
                            member_or_default(d, member_name(f.name, pick(fmt, attr[serial](f).name, attr[json](f).name, attr[toml](f).name), rule))?
                        } else {
                            member_value(d, member_name(f.name, pick(fmt, attr[serial](f).name, attr[json](f).name, attr[toml](f).name), rule))?
                        }
                    }
                }
            }
        })
    // `@[check(...)]`: every violation of this record's fields at once
    let mut bad: List[Error] = List.new()
    comptime for f in fields(T) {
        comptime if has_attr[check](f) && !attr[serial](f).skip && !attr[json](f).skip && !attr[toml](f).skip {
            let cpath = path_field(d.path(), member_name(f.name, pick(fmt, attr[serial](f).name, attr[json](f).name, attr[toml](f).name), rule))
            comptime if attr[check](f).min != NO_MIN || attr[check](f).max != NO_MAX || attr[check](f).format != "" || attr[check](f).one_of != "" {
                out.[f].check_value(attr[check](f), cpath.copy(), inout bad)
            }
            comptime if attr[check](f).min_len != 0 || attr[check](f).max_len != -1 {
                check_size(out.[f], attr[check](f), cpath.copy(), inout bad)
            }
            comptime if attr[check](f).by != "" {
                match attr[check](f).by.validate(out.[f]) {
                    Ok(_) => {}
                    Err(msg) => bad.push(error_at(cpath.copy(), msg.bytes()))
                }
            }
        }
    }
    if bad.len() > 0 { return Err(combine(bad)) }
    if part {
        for k in known { outer.push(k) }
        return Ok(out)
    }
    // unknown members are errors unless the type allows them
    let policy = pick(fmt, attr[serial](T).unknown, attr[json](T).unknown, attr[toml](T).unknown)
    if !bytes.eq(policy.bytes(), "ignore".bytes()) { reject_unknown(d, known)? }
    Ok(out)
}

/// An enum from a string (a variant without fields) or a map: the tag key names the variant,
/// else the one key of the map does.
pub fn deserialize_enum[T, D: Deserializer](d: D) -> Result[T, Error] {
    let fmt = d.format()
    let rule = pick(fmt, attr[serial](T).rename_all, attr[json](T).rename_all, attr[toml](T).rename_all)
    let tag = pick(fmt, attr[serial](T).tag, attr[json](T).tag, attr[toml](T).tag)
    let k = d.kind()
    let mut name: List[u8] = List.new()
    let mut external = false
    if k == KStr {
        name = d.read_string()?
    } else if k == KMap {
        if tag.len() > 0 {
            match d.get(tag.bytes()) {
                Some(c) => { name = c.read_string()? }
                None => {
                    let mut m = "missing the tag `".bytes()
                    bytes.append(inout m, tag.bytes())
                    m.push(96)
                    return Err(error_at(d.path(), m))
                }
            }
        } else {
            if d.len() != 1 { return Err(fail(d, "expected a map with the variant's name as its one key")) }
            name = d.key_at(0)
            external = true
        }
    } else {
        return Err(expected(d, "a string or a map"))
    }
    let body = enum_body(d, external)
    comptime for v in variants(T) {
        if bytes.eq(name, member_name(v.name, pick(fmt, attr[serial](v).name, attr[json](v).name, attr[toml](v).name), rule)) {
            let policy = pick(fmt, attr[serial](T).unknown, attr[json](T).unknown, attr[toml](T).unknown)
            if !bytes.eq(policy.bytes(), "ignore".bytes()) && body.kind() == KMap {
                let mut known: List[List[u8]] = List.new()
                if tag.len() > 0 { known.push(tag.bytes()) }
                comptime for f in fields(v) { known.push(member_name(f.name, "", rule)) }
                reject_unknown(body, known)?
            }
            return Ok(v(comptime for f in fields(v) { member_value(body, member_name(f.name, "", rule))? }))
        }
    }
    let mut m = "unknown variant `".bytes()
    bytes.append(inout m, name)
    m.push(96)
    Err(error_at(d.path(), m))
}

/// The cursor on a variant's fields: the one member of the map, or the map itself.
fn enum_body[D: Deserializer](d: D, external: bool) -> D {
    if external { return d.value_at(0) }
    d
}

// std/bytes: text as List[u8]. Pure Eider, no capabilities.

pub fn eq(a: List[u8], b: List[u8]) -> bool {
    if a.len() != b.len() { return false }
    for i in 0..a.len() {
        if a[i] != b[i] { return false }
    }
    true
}

/// -1, 0 or 1, comparing bytewise (shorter prefix sorts first).
pub fn compare(a: List[u8], b: List[u8]) -> i32 {
    let n = if a.len() < b.len() { a.len() } else { b.len() }
    for i in 0..n {
        if a[i] < b[i] { return -1 }
        if a[i] > b[i] { return 1 }
    }
    if a.len() < b.len() { return -1 }
    if a.len() > b.len() { return 1 }
    0
}

pub fn starts_with(s: List[u8], prefix: List[u8]) -> bool {
    if prefix.len() > s.len() { return false }
    for i in 0..prefix.len() {
        if s[i] != prefix[i] { return false }
    }
    true
}

pub fn ends_with(s: List[u8], suffix: List[u8]) -> bool {
    if suffix.len() > s.len() { return false }
    let off = s.len() - suffix.len()
    for i in 0..suffix.len() {
        if s[off + i] != suffix[i] { return false }
    }
    true
}

/// Index of the first `needle` at or after `from`.
pub fn find(s: List[u8], needle: List[u8], from: usize) -> Option[usize] {
    if needle.len() > s.len() { return None }
    var i = from
    while i + needle.len() <= s.len() {
        var hit = true
        for j in 0..needle.len() {
            if s[i + j] != needle[j] {
                hit = false
                break
            }
        }
        if hit { return Some(i) }
        i += 1
    }
    None
}

pub fn find_byte(s: List[u8], b: u8, from: usize) -> Option[usize] {
    var i = from
    while i < s.len() {
        if s[i] == b { return Some(i) }
        i += 1
    }
    None
}

/// Index of the last `b`.
pub fn rfind_byte(s: List[u8], b: u8) -> Option[usize] {
    var i = s.len()
    while i > 0 {
        i -= 1
        if s[i] == b { return Some(i) }
    }
    None
}

/// s[start..end], clamped to the end of `s`.
pub fn slice(s: List[u8], start: usize, end: usize) -> List[u8] {
    var out: List[u8] = List.new()
    let stop = if end < s.len() { end } else { s.len() }
    var i = start
    while i < stop {
        out.push(s[i])
        i += 1
    }
    out
}

pub fn append(inout dst: List[u8], src: List[u8]) {
    for b in src { dst.push(b) }
}

pub fn concat(a: List[u8], b: List[u8]) -> List[u8] {
    var out = a
    append(inout out, b)
    out
}

/// Split at every `sep`; always returns at least one part.
pub fn split(s: List[u8], sep: u8) -> List[List[u8]] {
    var parts: List[List[u8]] = List.new()
    var cur: List[u8] = List.new()
    for b in s {
        if b == sep {
            parts.push(cur)
            cur = List.new()
        } else {
            cur.push(b)
        }
    }
    parts.push(cur)
    parts
}

/// Lines without their `\n` (and a trailing `\r`); a final newline doesn't add an empty line.
pub fn lines(s: List[u8]) -> List[List[u8]] {
    var out: List[List[u8]] = List.new()
    var cur: List[u8] = List.new()
    for b in s {
        if b == 10 {
            out.push(strip_cr(cur))
            cur = List.new()
        } else {
            cur.push(b)
        }
    }
    if cur.len() > 0 { out.push(strip_cr(cur)) }
    out
}

fn strip_cr(s: List[u8]) -> List[u8] {
    if s.len() > 0 && s[s.len() - 1] == 13 { return slice(s, 0, s.len() - 1) }
    s
}

pub fn join(parts: List[List[u8]], sep: List[u8]) -> List[u8] {
    var out: List[u8] = List.new()
    for i in 0..parts.len() {
        if i > 0 { append(inout out, sep) }
        append(inout out, parts[i])
    }
    out
}

pub fn is_space(b: u8) -> bool { b == 32 || b == 9 || b == 10 || b == 13 }
pub fn is_digit(b: u8) -> bool { b >= 48 && b <= 57 }
pub fn is_alpha(b: u8) -> bool { (b >= 65 && b <= 90) || (b >= 97 && b <= 122) }
pub fn is_ident(b: u8) -> bool { is_alpha(b) || is_digit(b) || b == 95 }

pub fn trim(s: List[u8]) -> List[u8] {
    var a: usize = 0
    var z = s.len()
    while a < z && is_space(s[a]) { a += 1 }
    while z > a && is_space(s[z - 1]) { z -= 1 }
    slice(s, a, z)
}

/// Decimal digits only; None when empty, non-digit or out of range.
pub fn parse_u64(s: List[u8]) -> Option[u64] {
    if s.len() == 0 { return None }
    var v: u64 = 0
    for b in s {
        if !is_digit(b) { return None }
        let d = (b - 48) as u64
        if v > (18446744073709551615 - d) / 10 { return None }
        v = v * 10 + d
    }
    Some(v)
}

pub fn from_u64(n: u64) -> List[u8] {
    if n == 0 {
        var z: List[u8] = List.new()
        z.push(48)
        return z
    }
    var rev: List[u8] = List.new()
    var v = n
    while v > 0 {
        rev.push((v % 10) as u8 + 48)
        v = v / 10
    }
    var out: List[u8] = List.new()
    var i = rev.len()
    while i > 0 {
        i -= 1
        out.push(rev[i])
    }
    out
}

pub fn from_i64(n: i64) -> List[u8] {
    if n >= 0 { return from_u64(n as u64) }
    var out: List[u8] = List.new()
    out.push(45)
    // -(n+1)+1 avoids overflowing on i64's minimum
    append(inout out, from_u64(((0 - (n + 1)) as u64) + 1))
    out
}

/// Lowercase hex, two digits per byte.
pub fn hex(s: List[u8]) -> List[u8] {
    var out: List[u8] = List.new()
    for b in s {
        out.push(hex_digit(b / 16))
        out.push(hex_digit(b % 16))
    }
    out
}

fn hex_digit(n: u8) -> u8 {
    if n < 10 { return 48 + n }
    87 + n
}

//! std/task: structured concurrency on OS threads (decision C4; docs/runtime.md "Tasks").
//!
//! - `Token`: a cancellation token with an optional deadline. Tokens form a tree: cancelling a
//!   token cancels every token made from it, and a child's deadline is never later than its
//!   parent's. A token past its deadline counts as cancelled. Cancellation is cooperative:
//!   code checks `is_cancelled`/`check`, or waits with the token's deadline or a `cancel_case`
//!   in a select; nothing is interrupted from outside.
//! - `Group[T]`: a parent that starts children (each gets the group's token) and waits for
//!   all of them. The first child that fails cancels the others; `wait` always waits for
//!   every child (no child outlives its group), then gives every result in start order or
//!   the first error.
//! - `Pool`: a fixed set of worker threads taking jobs from a bounded queue (back-pressure:
//!   submitting waits while the queue is full, until a deadline).
//! - Containing a trap (decision C803, core/RUNTIME.md "Containing a trap"): `catch(f)` runs
//!   `f` and gives `Ok(result)`, or `Err(text)` if a trap (overflow, bounds, `panic`, out of
//!   memory) ended it; `spawn_caught(f)` is that on a thread of its own, so `join` gives the
//!   outcome. A pool worker catches each job's trap and goes on (`Pool.traps`), `Pool.run`'s
//!   future then holds the error (`Future.result`), and a group's child that traps fails the
//!   group. What a trapped job built is not dropped (it leaks), and a `sync.Lock` it held in
//!   `modify` stays empty: see "What is safe afterwards" in docs/runtime.md.
//!
//! These run on OS threads; when the compiler makes stackless tasks from functions that use a
//! blocking capability (C4), the same API runs them on the pool's workers instead.

import std.sync
import std.chan
import std.time

const NEVER: i64 = 9223372036854775807

type TokSt = {
    cancelled: bool,
    deadline_ns: i64,
    kids: List[Token],
    next_id: i64,
    waiters: List[sync.Parker],
}

/// A cancellation token; copies share it (see the module comment).
pub type Token = { st: sync.Lock[TokSt], id: i64 }

/// A token that is cancelled only by `cancel` (the root of a tree).
pub fn root() -> Token { Token(sync.lock(TokSt(false, NEVER, List.new(), 1, List.new())), 0) }

/// A root token that also expires at `dl`.
pub fn root_until(dl: time.Deadline) -> Token {
    Token(sync.lock(TokSt(false, dl.mono_ns(), List.new(), 1, List.new())), 0)
}

impl Token {
    /// A token cancelled when this one is (and by its own `cancel`, which doesn't reach
    /// this one). Already cancelled if this one is.
    fn child(self) -> Token { self.child_until(time.never()) }

    /// A child (as `child`) that also expires at `dl`: its deadline is the earlier of `dl`
    /// and this token's.
    fn child_until(self, dl: time.Deadline) -> Token {
        let parent = self
        let made = self.st.modify(|inout t: TokSt| -> Token {
            let mut at = dl.mono_ns()
            if t.deadline_ns < at { at = t.deadline_ns }
            let kid = Token(sync.lock(TokSt(t.cancelled, at, List.new(), 1, List.new())), t.next_id)
            t.next_id += 1
            if !t.cancelled { t.kids.push(kid) }
            kid
        })
        made
    }

    /// Cancels this token and every token made from it, and wakes whoever waits on them.
    /// Cancelling twice is harmless.
    fn cancel(self) uses io {
        let kids = self.st.modify(|inout t: TokSt| -> List[Token] {
            if t.cancelled { return List.new() }
            t.cancelled = true
            sync.wake_all(t.waiters)
            t.waiters = List.new()
            t.kids.take()
        })
        for k in kids { k.cancel() }
    }

    /// Whether the token is cancelled or past its deadline.
    fn is_cancelled(self) -> bool uses clock {
        let (c, at) = self.st.modify(|inout s: TokSt| -> (bool, i64) (s.cancelled, s.deadline_ns))
        c || time.at_mono_ns(at).expired()
    }

    /// Why the token is cancelled, or None: "cancelled" or "deadline exceeded".
    fn reason(self) -> Option[String] uses clock {
        let (c, at) = self.st.modify(|inout s: TokSt| -> (bool, i64) (s.cancelled, s.deadline_ns))
        if c { return Some(String.from("cancelled")) }
        if time.at_mono_ns(at).expired() { return Some(String.from("deadline exceeded")) }
        None
    }

    /// Ok while the token is live, else Err(reason): `tok.check()?` in a loop.
    fn check(self) -> Result[bool, String] uses clock {
        match self.reason() {
            Some(r) => Err(r)
            None => Ok(true)
        }
    }

    /// The token's deadline (`never()` if it has none): pass it to blocking calls.
    fn deadline(self) -> time.Deadline {
        time.at_mono_ns(self.st.modify(|inout s: TokSt| -> i64 s.deadline_ns))
    }

    /// The earlier of `dl` and the token's deadline.
    fn bound(self, dl: time.Deadline) -> time.Deadline { dl.earlier(self.deadline()) }

    /// Waits until the token is cancelled or expires (true), or `dl` passes first (false).
    fn wait(self, dl: time.Deadline) -> bool uses io, clock {
        let c = self.cancel_case(true)
        let mut cases: List[chan.Case[bool]] = List.new()
        cases.push(c)
        chan.select(cases, dl).is_some()
    }

    /// A select case that is ready, producing `u`, once the token is cancelled or expires.
    fn cancel_case[U](self, u: U) -> chan.Case[U] uses io, clock {
        let st = self.st
        let at = self.deadline().mono_ns()
        chan.Case(|me: sync.Parker, reg: bool| -> Option[U] {
            // ready cases leave no registration behind (select only leaves the others)
            if time.at_mono_ns(at).expired() { return Some(u) }
            let c = st.modify(|inout t: TokSt| -> bool {
                t.waiters = sync.without(t.waiters, me)
                if !t.cancelled && reg { t.waiters.push(me) }
                t.cancelled
            })
            if c { return Some(u) }
            None
        }, |me: sync.Parker| {
            st.modify(|inout t: TokSt| -> () { t.waiters = sync.without(t.waiters, me) })
        }, at)
    }

    /// Forgets `kid`, a finished child: it is no longer cancelled with this token (a Group
    /// does this in `wait`, so a long-lived parent doesn't collect dead children).
    fn detach(self, kid: Token) {
        let id = kid.id
        self.st.modify(|inout t: TokSt| -> () {
            let mut keep: List[Token] = List.new()
            for k in t.kids {
                if k.id != id { keep.push(k) }
            }
            t.kids = keep
        })
    }
}

// ---- groups

/// A task group (see the module comment). Start children with `spawn` (a thread each) or
/// `spawn_on` (a pool's workers), then `wait`.
pub type Group[T] = {
    parent: Token,
    tok: Token,
    results: List[chan.Channel[Result[T, String]]],
    threads: List[Task[i32]],
    errs: sync.Lock[List[String]],
}

/// A group whose token is a child of `parent`.
pub fn group[T](parent: Token) -> Group[T] { group_until(parent, time.never()) }

/// A group whose token also expires at `dl`: children see it as cancelled from then on.
pub fn group_until[T](parent: Token, dl: time.Deadline) -> Group[T] {
    Group(parent, parent.child_until(dl), List.new(), List.new(), sync.lock(List.new()))
}

/// Runs `f` and gives `Ok(its result)`, or `Err(the text of the trap that ended it)`: an
/// overflow, an index out of bounds, a division by zero, `panic`, out of memory (the text
/// names the file and line, as the report of an uncontained trap does). The thread goes on.
/// What `f` was building is gone without its drops (its memory leaks, a `Drop` does not run),
/// and the built-in `Mutex` locks it held are released, with the value as `f` left it. A
/// stack overflow, `env.exit` and the end of the process are not contained. Traps of the
/// main thread outside `catch` end the process as before.
pub fn catch[T](f: fn() -> T) -> Result[T, String] { Task.catch(f) }

/// `spawn` of a thread that runs `f` under `catch`: `join` gives the outcome and the process
/// goes on if `f` traps.
pub fn spawn_caught[T](f: fn() -> T) -> Task[Result[T, String]] uses threads {
    spawn(|| -> Result[T, String] { Task.catch(f) })
}

/// What a child runs: `f` with the token (unless it is cancelled already), recording an
/// error and cancelling the siblings when it fails. A child that traps fails (its text is
/// the error).
fn run_child[T](f: fn(Token) -> Result[T, String], tok: Token, errs: sync.Lock[List[String]], out: chan.Channel[Result[T, String]]) uses io, clock {
    let r: Result[T, String] = match tok.reason() {
        Some(why) => Err(why)
        None => {
            match Task.catch(|| -> Result[T, String] { f(tok) }) {
                Ok(x) => x
                Err(why) => Err(trapped(why))
            }
        }
    }
    match r {
        Ok(v) => {}
        Err(e) => {
            errs.modify(|inout l: List[String]| -> () { l.push(e) })
            tok.cancel()
        }
    }
    let z = out.try_send(r)
}

impl[T] Group[T] {
    /// The group's token (what every child gets).
    fn token(self) -> Token { self.tok }

    /// Starts `f(token)` on a thread of its own.
    fn spawn(inout self, f: fn(Token) -> Result[T, String]) uses threads, io, clock {
        let out: chan.Channel[Result[T, String]] = chan.bounded(1)
        let tok = self.tok
        let errs = self.errs
        let o = out
        self.results.push(out)
        self.threads.push(spawn(|| -> i32 {
            run_child(f, tok, errs, o)
            0
        }))
    }

    /// Starts `f(token)` as a job on `p`, waiting while its queue is full until the group's
    /// deadline. A child that can't be queued by then (or because the pool is shut down)
    /// fails with "deadline exceeded" / "pool is shut down" and cancels the group.
    fn spawn_on(inout self, p: Pool, f: fn(Token) -> Result[T, String]) uses io, clock {
        let out: chan.Channel[Result[T, String]] = chan.bounded(1)
        let tok = self.tok
        let errs = self.errs
        let o = out
        self.results.push(out)
        match p.submit(|| run_child(f, tok, errs, o), tok.deadline()) {
            Ok(b) => {}
            Err(e) => {
                errs.modify(|inout l: List[String]| -> () { l.push(e) })
                tok.cancel()
                let z = out.try_send(Err(e))
            }
        }
    }

    /// Cancels every child (they see it through the token).
    fn cancel(self) uses io { self.tok.cancel() }

    /// Waits for every child, then: Ok(their results, in start order), or Err(the first
    /// error). Never returns before all children have finished, whatever the deadline: a
    /// child that ignores its token keeps the group waiting (cancellation is cooperative).
    /// Then the group's token is detached from its parent.
    fn wait(self) -> Result[List[T], String] uses io, clock {
        let mut vals: List[T] = List.new()
        for c in self.results {
            match c.recv(time.never()) {
                chan.Value(r) => {
                    match r {
                        Ok(v) => vals.push(v)
                        Err(e) => {}
                    }
                }
                chan.Empty => {}
                chan.Closed => {}
            }
        }
        for t in self.threads { let z = t.join() }
        self.parent.detach(self.tok)
        let errs = self.errs.get()
        if errs.len() > 0 { return Err(errs[0]) }
        Ok(vals)
    }
}

fn trapped(why: String) -> String {
    let mut m = String.from("trapped: ")
    m.append(why)
    m
}

// ---- the pool

/// Worker threads taking jobs from a bounded queue. Copies share the pool. A job that traps
/// is contained (`catch`): the worker goes on with the next job, and the trap's text is kept
/// (`traps`).
pub type Pool = { jobs: chan.Channel[fn()], workers: List[Task[i32]], lost: sync.Lock[List[String]] }

/// A pool of `n` workers (at least 1) and a queue of `queue` jobs (at least 1).
pub fn pool(n: usize, queue: usize) -> Pool uses threads, io, clock {
    if n == 0 { panic("task.pool: needs at least one worker") }
    let jobs: chan.Channel[fn()] = chan.bounded(queue)
    let lost: sync.Lock[List[String]] = sync.lock(List.new())
    let mut ws: List[Task[i32]] = List.new()
    for i in 0..n {
        let js = jobs
        let lo = lost
        ws.push(spawn(|| -> i32 {
            let mut going = true
            while going {
                match js.recv(time.never()) {
                    chan.Value(job) => {
                        match Task.catch(job) {
                            Ok(u) => {}
                            Err(why) => {
                                lo.modify(|inout l: List[String]| -> () {
                                    if l.len() < MAX_TRAPS { l.push(why) }
                                })
                            }
                        }
                    }
                    chan.Empty => {}
                    chan.Closed => { going = false }
                }
            }
            0
        }))
    }
    Pool(jobs, ws, lost)
}

/// How many trap texts a pool keeps.
const MAX_TRAPS: usize = 64

/// A job's result, filled in when it has run: the value, or the text of the trap that ended
/// the job.
pub type Future[T] = { ch: chan.Channel[Result[T, String]] }

impl[T] Future[T] {
    /// The result, waiting for it until `dl` (None: not done by then; ask again; also None if
    /// the job trapped: ask `result` to tell them apart).
    /// Cancel-safe: giving up leaves the result for a later `get`.
    fn get(self, dl: time.Deadline) -> Option[T] uses io, clock {
        match self.ch.recv(dl) {
            chan.Value(r) => {
                match r {
                    Ok(v) => Some(v)
                    Err(why) => None
                }
            }
            chan.Empty => None
            chan.Closed => None
        }
    }

    /// The outcome, waiting for it until `dl` (None: not done by then; ask again): Ok(the
    /// value) or Err(the text of the trap that ended the job).
    fn result(self, dl: time.Deadline) -> Option[Result[T, String]] uses io, clock {
        match self.ch.recv(dl) {
            chan.Value(r) => Some(r)
            chan.Empty => None
            chan.Closed => None
        }
    }
}

impl Pool {
    /// Queues `job`, waiting while the queue is full until `dl`. Err("deadline exceeded")
    /// or Err("pool is shut down") when it wasn't queued (then it never runs).
    fn submit(self, job: fn(), dl: time.Deadline) -> Result[bool, String] uses io, clock {
        match self.jobs.send(job, dl) {
            chan.Sent => Ok(true)
            chan.Full(j) => Err(String.from("deadline exceeded"))
            chan.Rejected(j) => Err(String.from("pool is shut down"))
        }
    }

    /// Runs `f` on a worker; its result arrives in the Future. Err as for `submit`.
    fn run[T](self, f: fn() -> T, dl: time.Deadline) -> Result[Future[T], String] uses io, clock {
        let out: chan.Channel[Result[T, String]] = chan.bounded(1)
        let o = out
        self.submit(|| {
            let z = o.try_send(Task.catch(f))
        }, dl)?
        Ok(Future(out))
    }

    /// The texts of the traps that ended jobs on this pool (the first 64), oldest first.
    fn traps(self) -> List[String] {
        self.lost.modify(|inout l: List[String]| -> List[String] l.copy())
    }

    /// Workers in the pool.
    fn size(self) -> usize { self.workers.len() }

    /// Jobs waiting in the queue.
    fn queued(self) -> usize { self.jobs.len() }

    /// Stops taking jobs, lets the workers finish what is queued, and waits for them. Safe to
    /// call from several copies; must not be called from a job (it would wait for itself).
    fn shutdown(self) uses io {
        self.jobs.close()
        for w in self.workers { let z = w.join() }
    }
}

//! std/cli: a program's command line, derived from a record type (clap/cobra-style, with
//! comptime reflection; docs/compiler.md "C8.59"). Each field is a flag: `--name value`,
//! `--name=value`, `-n value` (with a `short`), a bool is `--verbose` (or `--no-verbose`), an
//! `Option[T]` may be left out, a `List[T]` is repeated or comma-separated, and anything else
//! without a default is required. `--help` prints the generated usage.
//!
//!     import std.cli
//!
//!     type Serve = {
//!         @cli(help = "address to listen on", default = ":8080") addr: String,
//!         @cli(short = "w", help = "worker tasks", default = "4") workers: i64,
//!         @cli(short = "v", help = "log every request") verbose: bool,
//!         tags: List[String],
//!     }
//!
//!     fn main() uses io {
//!         let r: Result[cli.Parsed[Serve], cli.Error] = cli.parse("serve", "run the server", cli.arguments())
//!         match r {
//!             Ok(p) => run(p.opts, p.rest)
//!             Err(e) => env.exit(cli.report(e))
//!         }
//!     }
//!
//! Subcommands are an enum whose variants each carry one record of flags:
//! `type Cmd = | Serve(opts: ServeFlags) | MigrateUp(opts: MigrateFlags)`; `cli.command` takes the
//! first word as the variant (its name in kebab case, `MigrateUp` is `migrate-up`) and parses
//! the rest against that record.
//! A field type is any `cli.Value`: the integer types, `f64`, `bool`, `String`, and `Option`
//! and `List` of those; implement `Value` for your own (an enum, a duration) to add more.
//! The attribute is `@cli(name, short, help, default)`; `name` renames the flag (the field
//! name with `_` as `-` is the default), `default` is the flag's text when it is left out.
//!
//! Every problem is collected, not just the first: an unknown flag, a missing value, a value
//! that does not parse, a missing required flag; `Error.text` lists them with the usage.

import std.io
import std.env
import std.error
import std.strings

/// `@cli(...)` on a field (or a variant, for its `help`).
pub attr cli { name: str = "", short: str = "", help: str = "", default: str = "" }

/// A type a flag can have.
pub trait Value {
    /// The type from the flag's text.
    fn parse(text: String) -> Result[Self, String]
    /// The type's name in the usage (`<integer>`).
    fn kind() -> str
    /// A flag that takes no value (`--verbose`).
    fn flag() -> bool
    /// May be left out with no default (an Option, a List, a bool).
    fn optional() -> bool
    /// Several occurrences are joined with `,` before parsing (a List).
    fn repeated() -> bool
    /// What an error leaves in the field (never seen by a program that checks the result).
    fn fallback() -> Self
}

impl Value for String {
    fn parse(text: String) -> Result[String, String] { Ok(text) }
    fn kind() -> str { "text" }
    fn flag() -> bool { false }
    fn optional() -> bool { false }
    fn repeated() -> bool { false }
    fn fallback() -> String { String.from("") }
}

impl Value for bool {
    fn parse(text: String) -> Result[bool, String] {
        match strings.parse_bool(text) {
            Some(b) => Ok(b)
            None => Err(String.from("not true or false"))
        }
    }
    fn kind() -> str { "bool" }
    fn flag() -> bool { true }
    fn optional() -> bool { true }
    fn repeated() -> bool { false }
    fn fallback() -> bool { false }
}

fn why(e: strings.ParseError) -> String { e.to_string() }

impl Value for i64 {
    fn parse(text: String) -> Result[i64, String] {
        match strings.parse_i64(text) {
            Ok(n) => Ok(n)
            Err(e) => Err(why(e))
        }
    }
    fn kind() -> str { "integer" }
    fn flag() -> bool { false }
    fn optional() -> bool { false }
    fn repeated() -> bool { false }
    fn fallback() -> i64 { 0 }
}

impl Value for i32 {
    fn parse(text: String) -> Result[i32, String] {
        match strings.parse_i32(text) {
            Ok(n) => Ok(n)
            Err(e) => Err(why(e))
        }
    }
    fn kind() -> str { "integer" }
    fn flag() -> bool { false }
    fn optional() -> bool { false }
    fn repeated() -> bool { false }
    fn fallback() -> i32 { 0 }
}

impl Value for u32 {
    fn parse(text: String) -> Result[u32, String] {
        match strings.parse_u32(text) {
            Ok(n) => Ok(n)
            Err(e) => Err(why(e))
        }
    }
    fn kind() -> str { "unsigned integer" }
    fn flag() -> bool { false }
    fn optional() -> bool { false }
    fn repeated() -> bool { false }
    fn fallback() -> u32 { 0 }
}

impl Value for u64 {
    fn parse(text: String) -> Result[u64, String] {
        match strings.parse_u64(text) {
            Ok(n) => Ok(n)
            Err(e) => Err(why(e))
        }
    }
    fn kind() -> str { "unsigned integer" }
    fn flag() -> bool { false }
    fn optional() -> bool { false }
    fn repeated() -> bool { false }
    fn fallback() -> u64 { 0 }
}

impl Value for usize {
    fn parse(text: String) -> Result[usize, String] {
        match strings.parse_usize(text) {
            Ok(n) => Ok(n)
            Err(e) => Err(why(e))
        }
    }
    fn kind() -> str { "unsigned integer" }
    fn flag() -> bool { false }
    fn optional() -> bool { false }
    fn repeated() -> bool { false }
    fn fallback() -> usize { 0 }
}

impl Value for f64 {
    fn parse(text: String) -> Result[f64, String] {
        match strings.parse_f64(text) {
            Ok(n) => Ok(n)
            Err(e) => Err(why(e))
        }
    }
    fn kind() -> str { "number" }
    fn flag() -> bool { false }
    fn optional() -> bool { false }
    fn repeated() -> bool { false }
    fn fallback() -> f64 { 0.0 }
}

impl[T: Value] Value for Option[T] {
    fn parse(text: String) -> Result[Option[T], String] {
        match T.parse(text) {
            Ok(v) => Ok(Some(v))
            Err(e) => Err(e)
        }
    }
    fn kind() -> str { T.kind() }
    fn flag() -> bool { T.flag() }
    fn optional() -> bool { true }
    fn repeated() -> bool { false }
    fn fallback() -> Option[T] { None }
}

impl[T: Value] Value for List[T] {
    fn parse(text: String) -> Result[List[T], String] {
        let mut out: List[T] = List.new()
        if text.len() == 0 { return Ok(out) }
        for part in strings.split(text, ",") {
            match T.parse(part) {
                Ok(v) => out.push(v)
                Err(e) => { return Err(e) }
            }
        }
        Ok(out)
    }
    fn kind() -> str { T.kind() }
    fn flag() -> bool { false }
    fn optional() -> bool { true }
    fn repeated() -> bool { true }
    fn fallback() -> List[T] { List.new() }
}

/// What the program gets: the options, and the words that were not flags (after `--`, or not
/// starting with `-`), in order.
pub type Parsed[T] = { opts: T, rest: List[String] }

/// A command line that did not parse, or `--help`. `text` is what to print (the usage for
/// help; the problems and the usage hint otherwise).
pub type Error = { help: bool, text: String }

impl error.Error for Error {
    fn message(self) -> String { self.text.copy() }
    fn source(self) -> Option[error.Failure] { None }
}

/// The flags seen so far while the record is being built.
type Spec = { name: String, short: String, help: String, kind: String, default: String, required: bool, flag: bool }

type State = { args: List[String], used: List[bool], specs: List[Spec], problems: List[String], help: bool, stop: usize }

fn state(args: List[List[u8]]) -> State {
    let mut a: List[String] = List.new()
    let mut used: List[bool] = List.new()
    let mut stop = args.len()
    let mut i: usize = 0
    for raw in args {
        let s = match String.from_bytes(raw) {
            Ok(x) => x
            Err(_) => String.from("")
        }
        if i < stop && strings.trim(s) == String.from("--") { stop = i }
        a.push(s)
        used.push(false)
        i += 1
    }
    let mut st = State(a, used, List.new(), List.new(), false, stop)
    for j in 0..st.stop {
        let w = st.args[j].copy()
        if w == String.from("--help") || w == String.from("-h") {
            st.help = true
            st.used[j] = true
        }
    }
    st
}

/// A field name as a flag: `max_conns` is `max-conns`.
fn kebab(name: str) -> String {
    let mut out = String.from("")
    for b in name.bytes() {
        if b == 95 { out.push_byte(45) } else if b >= 65 && b <= 90 {
            if out.len() > 0 { out.push_byte(45) }
            out.push_byte(b + 32)
        } else { out.push_byte(b) }
    }
    out
}

fn problem(inout st: State, msg: String) { st.problems.push(msg) }

/// The value of the flag for one field, from `st.args`; what the field's type, the attribute
/// and the command line say. It never fails: a problem is recorded in `st` and the type's
/// fallback returned, so the whole record is built and every problem found.
fn value_of[F: Value](inout st: State, field: str, a_name: str, a_short: str, a_help: str, a_default: str) -> F {
    let long = if a_name.len() > 0 { String.from(a_name) } else { kebab(field) }
    let mut longf = String.from("--")
    longf.append(long.copy())
    let mut shortf = String.from("")
    if a_short.len() > 0 {
        shortf.push_str("-")
        shortf.push_str(a_short)
    }
    let takes = !F.flag()
    let req = !F.optional() && a_default.len() == 0
    st.specs.push(Spec(long.copy(), String.from(a_short), String.from(a_help), String.from(F.kind()), String.from(a_default), req, F.flag()))
    let mut texts: List[String] = List.new()
    let mut i: usize = 0
    while i < st.stop {
        let w = st.args[i].copy()
        let mut name_ok = w == longf
        if shortf.len() > 0 && w == shortf { name_ok = true }
        let mut eq = String.from("")
        eq.append(longf.copy())
        eq.push_str("=")
        if strings.starts_with(w, eq.copy()) {
            texts.push(w.slice(eq.len(), w.len()))
            st.used[i] = true
        } else if name_ok {
            st.used[i] = true
            if takes {
                if i + 1 < st.stop && !st.used[i + 1] {
                    texts.push(st.args[i + 1].copy())
                    st.used[i + 1] = true
                    i += 1
                } else {
                    problem(inout st, bytes_msg("--", long.copy(), " needs a value"))
                }
            } else {
                texts.push(String.from("true"))
            }
        } else if !takes {
            let mut no = String.from("--no-")
            no.append(long.copy())
            if w == no {
                texts.push(String.from("false"))
                st.used[i] = true
            }
        }
        i += 1
    }
    if texts.len() == 0 {
        if a_default.len() > 0 {
            texts.push(String.from(a_default))
        } else if F.optional() {
            return F.fallback()
        } else {
            problem(inout st, bytes_msg("missing the required flag --", long.copy(), ""))
            return F.fallback()
        }
    }
    let joined = if F.repeated() { strings.join(texts, ",") } else { texts[texts.len() - 1].copy() }
    match F.parse(joined) {
        Ok(v) => v
        Err(e) => {
            let mut m = String.from("--")
            m.append(long)
            m.push_str(": ")
            m.append(e)
            problem(inout st, m)
            F.fallback()
        }
    }
}

fn bytes_msg(a: str, b: String, c: str) -> String {
    let mut m = String.from(a)
    m.append(b)
    m.push_str(c)
    m
}

/// The usage text for `program` (`about` is its one-line description), from the specs.
fn usage(program: String, about: str, specs: List[Spec], subs: List[String]) -> String {
    let mut out = String.from("Usage: ")
    out.append(program)
    if subs.len() > 0 { out.push_str(" <command>") }
    if specs.len() > 0 { out.push_str(" [flags]") }
    out.push_str(" [--] [args...]\n")
    if about.len() > 0 {
        out.push_str(about)
        out.push_str("\n")
    }
    if subs.len() > 0 {
        out.push_str("\nCommands:\n")
        for s in subs {
            out.push_str("  ")
            out.append(s.copy())
            out.push_str("\n")
        }
    }
    out.push_str("\nFlags:\n")
    for s in specs {
        let mut left = String.from("  ")
        if s.short.len() > 0 {
            left.push_str("-")
            left.append(s.short.copy())
            left.push_str(", ")
        } else {
            left.push_str("    ")
        }
        left.push_str("--")
        left.append(s.name.copy())
        if !s.flag {
            left.push_str(" <")
            left.append(s.kind.copy())
            left.push_str(">")
        }
        let mut right = s.help.copy()
        if s.default.len() > 0 || s.required {
            if right.len() > 0 { right.push_str(" ") }
            if s.default.len() > 0 {
                right.push_str("(default ")
                right.append(s.default.copy())
                right.push_str(")")
            } else {
                right.push_str("(required)")
            }
        }
        out.append(left.copy())
        if right.len() > 0 {
            if left.len() >= 30 { out.push_str("  ") }
            while left.len() < 30 {
                out.push_str(" ")
                left.push_str(" ")
            }
            out.append(right)
        }
        out.push_str("\n")
    }
    out.push_str("  -h, --help                  print this help\n")
    out
}

/// Whether anything was wrong, and the words that were not flags.
fn finish[T](program: String, about: str, subs: List[String], st: State, opts: T) -> Result[Parsed[T], Error] {
    if st.help { return Err(Error(true, usage(program, about, st.specs, subs))) }
    let mut rest: List[String] = List.new()
    let mut probs = st.problems.copy()
    let mut i: usize = 0
    while i < st.args.len() {
        let w = st.args[i].copy()
        if i == st.stop {
            // the `--` itself
        } else if i < st.stop && !st.used[i] && w.len() > 1 && strings.starts_with(w.copy(), "-") {
            probs.push(bytes_msg("unknown flag ", w, ""))
        } else if !st.used[i] || i > st.stop {
            rest.push(w)
        }
        i += 1
    }
    if probs.len() > 0 {
        let mut m = String.from("")
        for p in probs {
            m.append(program.copy())
            m.push_str(": ")
            m.append(p)
            m.push_str("\n")
        }
        m.push_str("try `")
        m.append(program.copy())
        m.push_str(" --help`\n")
        return Err(Error(false, m))
    }
    Ok(Parsed(opts, rest))
}

/// The record `R` read from `st`: one flag per field.
fn record_of[R](inout st: State) -> R {
    R(comptime for f in fields(R) {
        value_of(inout st, f.name, attr[cli](f).name, attr[cli](f).short, attr[cli](f).help, attr[cli](f).default)
    })
}

/// Parse `args` (without the program name: see `cli.arguments`) into the record `T`; the type
/// comes from where the result goes: `let p: Result[cli.Parsed[Serve], cli.Error] = cli.parse(...)`.
pub fn parse[T](program: str, about: str, args: List[List[u8]]) -> Result[Parsed[T], Error] {
    let mut st = state(args)
    let opts: T = record_of(inout st)
    finish(String.from(program), about, List.new(), st, opts)
}

/// The command line of this program without its name (`env.args()` starts with it).
pub fn arguments() -> List[List[u8]] uses io {
    let all = env.args()
    let mut out: List[List[u8]] = List.new()
    for i in 1..all.len() { out.push(all[i].copy()) }
    out
}

/// Parse `args` as a subcommand and its flags: the first word is a variant of the enum `C` in
/// kebab case, whose one payload field is the record of its flags (`Serve(opts: ServeOpts)`);
/// the rest are parsed against that record. The `@cli(help = "...")` of a variant is its line
/// in the command list.
pub fn command[C](program: str, about: str, args: List[List[u8]]) -> Result[Parsed[C], Error] {
    let mut names: List[String] = List.new()
    comptime for v in variants(C) {
        let mut line = kebab(v.name)
        if attr[cli](v).help != "" {
            while line.len() < 18 { line.push_str(" ") }
            line.push_str(attr[cli](v).help)
        }
        names.push(line)
    }
    let none: List[Spec] = List.new()
    let first = if args.len() > 0 { sys_text(args[0].copy()) } else { String.from("") }
    if first.len() == 0 || first == String.from("-h") || first == String.from("--help") {
        return Err(Error(true, usage(String.from(program), about, none, names)))
    }
    let mut rest: List[List[u8]] = List.new()
    for i in 1..args.len() { rest.push(args[i].copy()) }
    comptime for v in variants(C) {
        if first == kebab(v.name) {
            let mut st = state(rest)
            let x = v(comptime for f in fields(v) { record_of(inout st) })
            let mut sub = String.from(program)
            sub.push_str(" ")
            sub.append(first.copy())
            return finish(sub, about, List.new(), st, x)
        }
    }
    let mut m = String.from(program)
    m.push_str(": unknown command ")
    m.append(first)
    m.push_str("\n")
    m.append(usage(String.from(program), about, none, names))
    Err(Error(false, m))
}

fn sys_text(b: List[u8]) -> String {
    match String.from_bytes(b) {
        Ok(s) => s
        Err(_) => String.from("")
    }
}

/// Print an `Error` the way a command line tool does and give the exit code: help goes to
/// stdout (exit 0), problems to stderr (exit 2).
pub fn report(e: Error) -> i32 uses io {
    if e.help {
        io.out(e.text.bytes())
        return 0
    }
    io.err(e.text.bytes())
    2
}

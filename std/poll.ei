// std/poll: readiness events (epoll on Linux, kqueue on macOS and the BSDs) and a cross-thread
// waker. Thin wrappers over the core (core/ABI.md "Readiness"); the event loop and task
// scheduler built on them are layer/runtime's.

import "core/sys"
import "core/os"
import "fd.ei"

/// Interest: wake for reading, for writing; edge-triggered; one-shot (re-arm with `modify`).
pub const READ: i32 = 1
pub const WRITE: i32 = 2
pub const EDGE: i32 = 4
pub const ONESHOT: i32 = 8

/// One readiness event for the registration with `token`. kqueue reports reading and writing
/// separately (two events, same token); epoll in one.
pub type Event = { token: i64, readable: bool, writable: bool, error: bool, hangup: bool, peer_closed: bool }

/// A waker: `wake` (from any thread) makes `r` readable; register `r`, then `drain` it.
/// On Linux `r` and `w` are the same descriptor.
pub type Waker = { r: i32, w: i32 }

/// A new poller (a descriptor: close it with fd.close).
pub fn create() -> Result[i32, String] uses io {
    let n = os.poll_new()
    if n < 0 { return Err(fd.error("poller", n)) }
    Ok(n as i32)
}

fn ctl(p: i32, op: i32, f: i32, interest: i32, token: i64) -> Result[bool, String] uses io {
    let n = os.poll_ctl(p, op, f, interest, token)
    if n < 0 { return Err(fd.error("poll register", n)) }
    Ok(true)
}

/// Watch `f` for `interest` (READ | WRITE | ...); its events carry `token`.
pub fn add(p: i32, f: i32, interest: i32, token: i64) -> Result[bool, String] uses io { ctl(p, 0, f, interest, token) }
pub fn modify(p: i32, f: i32, interest: i32, token: i64) -> Result[bool, String] uses io { ctl(p, 1, f, interest, token) }
/// Stop watching `f` (do it before closing `f`).
pub fn remove(p: i32, f: i32) -> Result[bool, String] uses io { ctl(p, 2, f, 0, 0) }

/// Up to `max` events, waiting at most `timeout_ms` (< 0: forever, 0: not at all). Empty on
/// a timeout; a signal ends the wait early (with the signal pipe's event if it is watched,
/// possibly with none: loop).
pub fn wait(p: i32, max: i32, timeout_ms: i64) -> Result[List[Event], String] uses io {
    let n = os.poll_wait(p, max, timeout_ms)
    if n < 0 { return Err(fd.error("poll wait", n)) }
    var out: List[Event] = List.new()
    let r = sys.take()
    var i: usize = 0
    while i < (n as usize) {
        // the token's bits as i64 (a negative token comes back as a u64 above i64's range)
        let u = os.le_u64(r, i * 16)
        var token: i64 = 0
        if u > 9223372036854775807 {
            token = (u - 9223372036854775808) as i64 - 9223372036854775807 - 1
        } else {
            token = u as i64
        }
        let f = os.le_u32(r, i * 16 + 8)
        out.push(Event(token, (f & 1) != 0, (f & 2) != 0, (f & 4) != 0, (f & 8) != 0, (f & 16) != 0))
        i += 1
    }
    Ok(out)
}

pub fn waker() -> Result[Waker, String] uses io {
    let n = os.waker_new()
    if n < 0 { return Err(fd.error("waker", n)) }
    let p = fd.take_pair()
    Ok(Waker(p.r, p.w))
}

/// Make the waker readable (several wakes before a drain are one).
pub fn wake(w: Waker) -> Result[bool, String] uses io {
    let n = os.waker_wake(w.w)
    if n < 0 { return Err(fd.error("wake", n)) }
    Ok(true)
}

/// Clear a woken waker.
pub fn drain(w: Waker) uses io {
    while sys.read_fd(w.r, 4096) > 0 {}
}

/// Close both ends.
pub fn close_waker(w: Waker) uses io {
    os.fd_close(w.r)
    if w.w != w.r { os.fd_close(w.w) }
}

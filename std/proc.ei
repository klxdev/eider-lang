//! std/proc: run other programs. A child process can do anything, so callers need every
//! capability it might use (io, fs, net). (`ffi` stays inside core: docs/compiler.md, "C8.5".)

import "core/sys"
import "bytes.ei"

/// What a finished program produced. `out`/`err` are empty for streams that weren't
/// captured. `timed_out`: the deadline passed and the child was killed; `code` is then -1.
/// Otherwise `code` is the exit code, or 128+signal if a signal killed it.
pub type Output = { code: i32, out: List[u8], err: List[u8], timed_out: bool }

/// How `run_with` runs a program: which of stdout/stderr to capture (the others are
/// inherited from this process) and a wall-clock limit in milliseconds (0: none). At the
/// limit the child's process group gets SIGTERM, then SIGKILL 200 ms later.
pub type Options = { capture_out: bool, capture_err: bool, timeout_ms: i64 }

/// Capture stdout and stderr, no time limit.
pub fn captured() -> Options { Options(true, true, 0) }

/// Capture stdout and stderr, and kill the child after `ms` milliseconds.
pub fn limited(ms: i64) -> Options { Options(true, true, ms) }

/// The core's out buffer: 8-byte little-endian stdout length, stdout, stderr.
fn split(raw: List[u8], code: i32, timed_out: bool) -> Output {
    let mut n: u64 = 0
    let mut i: usize = 8
    while i > 0 {
        i -= 1
        n = n * 256 + (raw[i] as u64)
    }
    let mid = 8 + (n as usize)
    Output(code, bytes.slice(raw, 8, mid), bytes.slice(raw, mid, raw.len()), timed_out)
}

/// Run `argv` (searched on PATH) as `opts` says. Err only if it could not be started.
pub fn run_with(argv: List[List[u8]], opts: Options) -> Result[Output, String] uses io, fs, net {
    if argv.len() == 0 { return Err(String.from("proc: empty command")) }
    sys.send_all(argv)
    let n = sys.run(opts.capture_out, opts.capture_err, opts.timeout_ms)
    if n < 0 {
        let mut m = String.from("cannot run ")
        m.append(sys.to_string(argv[0]))
        m.push_str(": ")
        m.append(sys.error_text(n))
        return Err(m)
    }
    let timed_out = n == 256
    let code: i32 = if timed_out { -1 } else { n as i32 }
    Ok(split(sys.take(), code, timed_out))
}

/// Run with inherited stdin/stdout/stderr; returns the exit code.
pub fn run(argv: List[List[u8]]) -> Result[i32, String] uses io, fs, net {
    let o = run_with(argv, Options(false, false, 0))?
    Ok(o.code)
}

/// Run and capture stdout (stderr still goes to the terminal).
pub fn output(argv: List[List[u8]]) -> Result[Output, String] uses io, fs, net {
    run_with(argv, Options(true, false, 0))
}

/// Run, capture stdout, and fail unless the exit code is 0.
pub fn check(argv: List[List[u8]]) -> Result[List[u8], String] uses io, fs, net {
    let o = output(argv)?
    if o.code != 0 {
        let mut m = String.from("command failed (exit ")
        m.append(String.from_int(o.code as i64))
        m.push_str("): ")
        m.append(sys.to_string(bytes.join(argv, sys.lit(" "))))
        return Err(m)
    }
    Ok(o.out)
}

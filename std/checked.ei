impl u8 {
    /// `self + other`, or None if the sum doesn't fit.
    fn checked_add(self, other: u8) -> Option[u8] {
        let r = self +% other
        if r < self { return None }
        Some(r)
    }
    /// `self - other`, or None if `other` is larger than `self`.
    fn checked_sub(self, other: u8) -> Option[u8] {
        if other > self { return None }
        Some(self - other)
    }
    /// `self * other`, or None if the product doesn't fit.
    fn checked_mul(self, other: u8) -> Option[u8] {
        if self == 0 || other == 0 { return Some(0) }
        let r = self *% other
        if r / other != self { return None }
        Some(r)
    }
    /// `self / other`, or None if `other` is 0.
    fn checked_div(self, other: u8) -> Option[u8] {
        if other == 0 { return None }
        Some(self / other)
    }
    /// `self % other`, or None if `other` is 0.
    fn checked_rem(self, other: u8) -> Option[u8] {
        if other == 0 { return None }
        Some(self % other)
    }
    /// `self + other` wrapped around: the sum modulo 2^bits (the `+%` operator).
    fn wrapping_add(self, other: u8) -> u8 { self +% other }
    /// `self - other` wrapped around: the difference modulo 2^bits (the `-%` operator).
    fn wrapping_sub(self, other: u8) -> u8 { self -% other }
    /// `self * other` wrapped around: the product modulo 2^bits (the `*%` operator), as a
    /// linear congruential generator or a hash needs.
    fn wrapping_mul(self, other: u8) -> u8 { self *% other }
    /// `0 - self` wrapped around (`MIN` stays `MIN`; for an unsigned type, 2^bits - self).
    fn wrapping_neg(self) -> u8 { 0 -% self }
}


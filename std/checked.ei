        if r / other != self { return None }
        Some(r)
    }
    /// `self / other`, or None if `other` is 0.
    fn checked_div(self, other: usize) -> Option[usize] {
        if other == 0 { return None }
        Some(self / other)
    }
    /// `self % other`, or None if `other` is 0.
    fn checked_rem(self, other: usize) -> Option[usize] {
        if other == 0 { return None }
        Some(self % other)
    }
}

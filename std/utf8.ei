//! std/utf8: UTF-8 over bytes (RFC 3629): validation, decoding one scalar value at a time,
//! iteration, encoding, and lossy conversion to a String. Pure, no capabilities.
//!
//! Valid means what String.from_bytes accepts, minus its NUL rule: no overlong forms, no
//! surrogates (U+D800..U+DFFF), nothing above U+10FFFF, no truncated sequence. Invalid input
//! decodes as U+FFFD, one replacement per *maximal subpart* (the longest prefix of a valid
//! sequence, or one byte), which is what the Unicode standard and WHATWG recommend, so every
//! decoder that follows them agrees on the count.

/// U+FFFD, what invalid input decodes to.
pub const REPLACEMENT: u32 = 65533

/// One decoded scalar value: `cp`, the `len` bytes it took, and whether they were valid
/// (`cp` is REPLACEMENT when not). `len` is 0 only at the end of the input.
pub type Decoded = { cp: u32, len: usize, ok: bool }

fn cont(b: u8) -> bool { b >= 128 && b <= 191 }

/// The scalar value starting at byte `at`.
pub fn decode(s: List[u8], at: usize) -> Decoded {
    if at >= s.len() { return Decoded(0, 0, false) }
    let b0 = s[at]
    if b0 < 128 { return Decoded(b0 as u32, 1, true) }
    // the sequence length and the allowed range of the second byte (Unicode table 3-7)
    let mut need: usize = 0
    let mut lo: u8 = 128
    let mut hi: u8 = 191
    if b0 >= 194 && b0 <= 223 {
        need = 1
    } else if b0 == 224 {
        need = 2
        lo = 160
    } else if (b0 >= 225 && b0 <= 236) || b0 == 238 || b0 == 239 {
        need = 2
    } else if b0 == 237 {
        need = 2
        hi = 159
    } else if b0 == 240 {
        need = 3
        lo = 144
    } else if b0 >= 241 && b0 <= 243 {
        need = 3
    } else if b0 == 244 {
        need = 3
        hi = 143
    } else {
        return Decoded(REPLACEMENT, 1, false)
    }
    let mut cp: u32 = 0
    if need == 1 { cp = (b0 as u32) & 31 }
    if need == 2 { cp = (b0 as u32) & 15 }
    if need == 3 { cp = (b0 as u32) & 7 }
    let mut k: usize = 1
    while k <= need {
        if at + k >= s.len() { return Decoded(REPLACEMENT, k, false) }
        let b = s[at + k]
        let good = if k == 1 { b >= lo && b <= hi } else { cont(b) }
        if !good { return Decoded(REPLACEMENT, k, false) }
        cp = (cp << 6) | ((b as u32) & 63)
        k += 1
    }
    Decoded(cp, need + 1, true)
}

/// The offset of the first byte that isn't part of valid UTF-8, or None when all of `s` is.
pub fn first_invalid(s: List[u8]) -> Option[usize] {
    let mut i: usize = 0
    while i < s.len() {
        if s[i] < 128 {
            i += 1
        } else {
            let d = decode(s, i)
            if !d.ok { return Some(i) }
            i += d.len
        }
    }
    None
}

pub fn valid(s: List[u8]) -> bool {
    match first_invalid(s) {
        Some(_) => false
        None => true
    }
}

/// The number of scalar values (each invalid subpart counts as one, as it decodes).
pub fn count(s: List[u8]) -> usize {
    let mut n: usize = 0
    let mut i: usize = 0
    while i < s.len() {
        let d = decode(s, i)
        i += d.len
        n += 1
    }
    n
}

/// Whether a scalar value can start at byte `i` (it isn't a continuation byte); true at
/// the end.
pub fn is_boundary(s: List[u8], i: usize) -> bool {
    if i >= s.len() { return i == s.len() }
    !cont(s[i])
}

/// Whether `cp` is a Unicode scalar value (not a surrogate, at most U+10FFFF).
pub fn is_scalar(cp: u32) -> bool { cp < 55296 || (cp > 57343 && cp <= 1114111) }

/// Appends `cp`'s encoding (REPLACEMENT's for a value that isn't a scalar value).
pub fn push(inout out: List[u8], cp: u32) {
    let c = if is_scalar(cp) { cp } else { REPLACEMENT }
    if c < 128 {
        out.push(c as u8)
    } else if c < 2048 {
        out.push((192 | (c >> 6)) as u8)
        out.push((128 | (c & 63)) as u8)
    } else if c < 65536 {
        out.push((224 | (c >> 12)) as u8)
        out.push((128 | ((c >> 6) & 63)) as u8)
        out.push((128 | (c & 63)) as u8)
    } else {
        out.push((240 | (c >> 18)) as u8)
        out.push((128 | ((c >> 12) & 63)) as u8)
        out.push((128 | ((c >> 6) & 63)) as u8)
        out.push((128 | (c & 63)) as u8)
    }
}

/// `cp`'s encoding.
pub fn encode(cp: u32) -> List[u8] {
    let mut out: List[u8] = List.new()
    push(inout out, cp)
    out
}

/// The scalar values, in order (invalid input as REPLACEMENT).
pub fn decode_all(s: List[u8]) -> List[u32] {
    let mut out: List[u32] = List.new()
    let mut i: usize = 0
    while i < s.len() {
        let d = decode(s, i)
        out.push(d.cp)
        i += d.len
    }
    out
}

/// An iterator over the scalar values of bytes: `for cp in utf8.chars(b)`.
pub type Chars = { s: List[u8], at: usize }

pub fn chars(s: List[u8]) -> Chars { Chars(s, 0) }

impl Iter for Chars {
    fn next(inout self) -> Option[u32] {
        if self.at >= self.s.len() { return None }
        let a = self.at
        let d = decode(self.s, a)
        self.at += d.len
        Some(d.cp)
    }
}

/// A String from any bytes: invalid subparts become U+FFFD, and so do NUL bytes, which a
/// String can't hold.
pub fn lossy(s: List[u8]) -> String {
    let mut out: List[u8] = List.new()
    let mut i: usize = 0
    while i < s.len() {
        let b = s[i]
        if b > 0 && b < 128 {
            out.push(b)
            i += 1
        } else {
            let d = decode(s, i)
            if d.ok && d.cp != 0 {
                let mut k: usize = 0
                while k < d.len {
                    out.push(s[i + k])
                    k += 1
                }
            } else {
                push(inout out, REPLACEMENT)
            }
            i += d.len
        }
    }
    match String.from_bytes(out) {
        Ok(t) => t
        Err(_) => String.from("")
    }
}

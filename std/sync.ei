//! std/sync: the two primitives the rest of the runtime layer is built from (docs/runtime.md).
//!
//! - `Lock[T]`: a value that one thread at a time holds, changed in place by a closure that
//!   also returns a result: an atomic read-modify-write of any state. (A trap contained while a
//!   closure holds the value poisons the Lock: later uses trap with a message, `reset(v)`
//!   recovers; decision C903.) It is a channel holding
//!   exactly one value: taking the lock receives the value, releasing it sends it back, with
//!   no other holder, so crossing threads copies nothing of it ("No copies" below). (The
//!   built-in Mutex can't do this: `update` returns nothing, and `get` then `set` is not
//!   atomic.)
//! - `Parker`: a thread or task waits on its own Parker with a deadline; any other unparks it.
//!   It is a small object of the core (core/ABI.md "Parkers": a handle to a permit, no
//!   descriptor), so a hundred thousand tasks can wait on one each; a task that parks gives
//!   its worker to another task (decision C836).
//!
//! Blocking structures (std/chan, std/task) combine them the same way: a waiter puts its
//! Parker in a list inside the Lock's state and parks; whoever changes the state wakes the
//! Parkers in the list, under the lock. Two rules make that safe:
//!   1. Waking happens with the lock held, and a waiter takes its Parker out of every list
//!      (under each lock) before it closes it. (A handle that is closed is refused, not
//!      reused, so a stray unpark would be harmless; the rule keeps the lists clean.)
//!   2. A waiter checks the state and registers in the same critical section, and every change
//!      that could let it proceed wakes the list after it, so no wake-up is lost.
//!
//! No copies (decision C320, issue #90). A value given to a channel is first made unique
//! (every buffer it reaches its own: values cross threads only that way, docs/compiler.md
//! "C8.1"), so whatever the sender still shares is copied. Arguments are borrows, and a
//! variable given to `send` is shared, not moved: `send(s)` with `s` alive copies all of
//! `s`, and so did the old `with`, whose closure's `(s, r)` shared all of `s`. So the channel
//! holds a `Slot[T]` (`Full(value)`, or `Poisoned` after a trap): `modify` lets the closure change
//! the payload in place, and sends `grab(o)`, which moves the Slot out of its variable, so what is sent has exactly one
//! holder and making it unique visits each of its buffers once and copies none. `with` and
//! `update` drop the value they lent their closure before sending what it returned, for the
//! same reason. What is still copied is only what really is shared: a part of the value that
//! the result also holds (a String returned from it), a captured value put into it, and what
//! a closure changes after sharing it (`let mut t = s.copy()` in `with`), which is why
//! changes go through `modify`.

import core.os
import std.time

/// What a Lock's channel holds. `Poisoned` is declared first and has no payload: the runtime
/// puts a zero-filled element (tag 0) into the channel when a trap that was contained ends a
/// holder (core/RUNTIME.md "Lock-like channels"), and all-zero bytes are `Poisoned`.
pub type Slot[T] = | Poisoned | Full(T)

/// A value one thread at a time holds (see the module comment). Copies of a Lock share it.
/// The channel holds `Full(value)` while nobody holds the lock, and `Poisoned` after a trap
/// ended a `modify`, `with` or `update` closure that held the value (below).
pub type Lock[T] = { ch: Chan[Slot[T]] }

pub fn lock[T](v: T) -> Lock[T] {
    let c: Chan[Slot[T]] = Chan.new()
    c.send(Full(v))
    Lock(c)
}

const POISONED: str = "sync.Lock is poisoned: a trap ended a closure that held its value (Lock.reset(v) makes it usable again)"

/// What the channel holds, with no other holder (the Option the receive made is dropped on
/// return), and the runtime told that this thread has the value out until `release`, so a
/// contained trap poisons the lock instead of leaving it empty. A poisoned lock is put back
/// as it was (for the next user and `reset`) and traps.
fn take[T](ch: Chan[Slot[T]]) -> Slot[T] {
    let s = ch.recv().unwrap()
    os.guard_enter()
    match s {
        Poisoned => {
            os.guard_leave()
            ch.send(Poisoned)
            panic(POISONED)
        }
        Full(_) => s
    }
}

/// The value is back in `o` (or the closure returned): the runtime need not poison.
fn release() { os.guard_leave() }

/// `with`'s step: `f` on a borrow of `v`, whose new value replaces `v` (once this returns,
/// nothing else holds it), and `f`'s result.
fn apply[T, R](inout v: T, f: fn(T) -> (T, R)) -> R {
    let (s2, r) = f(v)
    v = s2
    r
}

/// The slot moved out of `o`, which is left `Poisoned`: what is sent has one holder. (`let r = o`
/// would alias `o`, the match makes the new slot.)
fn grab[T](inout o: Slot[T]) -> Slot[T] {
    let r = match o {
        Full(v) => Full(v)
        Poisoned => Poisoned
    }
    o = Poisoned
    r
}

impl[T] Lock[T] {
    /// Runs `f` on the value itself with the lock held and returns `f`'s result: `f` changes
    /// the value in place, and nothing of it is copied ("No copies" above). Other threads
    /// using the Lock wait meanwhile, so `f` should be short and must not use the same Lock
    /// (that waits for itself forever). Not cancellable (it never waits for anything but the
    /// lock).
    ///
    /// A trap in `f` that is contained (`Task.catch`, a pool job, `spawn_caught`; decision
    /// C803) poisons the Lock: the value is gone (`f` may have changed it half way, and it
    /// cannot be restored soundly: it was changed in place), and every later `modify`, `with`,
    /// `update` and `get` traps with a message, at once and also in threads that were already
    /// waiting, instead of waiting forever. `reset(v)` makes it usable again.
    fn modify[R](self, f: fn(inout T) -> R) -> R {
        let mut o = take(self.ch)
        // an Option, since R may be () (which can't be bound)
        let r: Option[R] = match o {
            Full(mut v) => Some(f(inout v))
            Poisoned => None
        }
        release()
        self.ch.send(grab(inout o))
        r.unwrap()
    }

    /// Runs `f` on the value with the lock held; `f` returns the new value and a result.
    /// Returning the value unchanged copies nothing, but `f` gets a borrow, so a change it
    /// makes copies what it changes: use `modify` for changes. The rules of `modify` apply.
    fn with[R](self, f: fn(T) -> (T, R)) -> R {
        let mut o = take(self.ch)
        let r: Option[R] = match o {
            Full(mut v) => Some(apply(inout v, f))
            Poisoned => None
        }
        release()
        self.ch.send(grab(inout o))
        r.unwrap()
    }

    /// Replaces the value with `f(value)` (prefer `modify` for changes, as for `with`).
    fn update(self, f: fn(T) -> T) {
        let mut o = take(self.ch)
        let mut n: Slot[T] = match o {
            Full(v) => Full(f(v))
            Poisoned => Poisoned
        }
        o = Poisoned
        release()
        self.ch.send(grab(inout n))
    }

    /// A copy of the value.
    fn get(self) -> T {
        self.modify(|inout s: T| -> T s)
    }

    /// Whether a trap poisoned the Lock (and `reset` has not made it usable again). Waits for
    /// a holder like any use.
    fn poisoned(self) -> bool {
        let mut o = self.ch.recv().unwrap()
        let p = match o {
            Poisoned => true
            Full(_) => false
        }
        self.ch.send(grab(inout o))
        p
    }

    /// Makes the Lock hold `v` again, whether it was poisoned or not (the old value is dropped).
    /// Waits for a holder like any use. This is how a program goes on after a contained trap
    /// in a closure that held the Lock: put back a value known to be sound.
    fn reset(self, v: T) {
        let mut o = self.ch.recv().unwrap()
        o = Poisoned
        self.ch.send(Full(v))
    }
}

/// A wake-up handle of a thread or task (a handle to a core Parker). Make one with `parker()`,
/// close it with `close` once it is in no waiter list (rule 1 above).
pub type Parker = { h: i64 }

pub fn parker() -> Parker uses io {
    let h = os.parker_new()
    if h < 0 { panic("sync.parker: cannot make a parker") }
    Parker(h)
}

impl Parker {
    /// Waits until unparked or `dl` passes: true when unparked. An unpark that came before
    /// the wait counts (it is not lost); several unparks before a wait are one.
    fn park(self, dl: time.Deadline) -> bool uses io, clock {
        while true {
            let r = os.parker_park(self.h, dl.timeout_ms())
            if r > 0 { return true }
            if r < 0 { panic("sync.park: wait on a closed parker") }
            if dl.expired() { return false }
        }
        false
    }

    /// Wakes the thread or task parked on it (or makes its next park return at once).
    fn unpark(self) uses io {
        os.parker_unpark(self.h)
    }

    /// Clears a pending unpark without waiting.
    fn clear(self) uses io { os.parker_clear(self.h) }

    fn close(self) uses io { os.parker_close(self.h) }

    /// Identifies the Parker while it is open.
    fn id(self) -> i64 { self.h }
}

/// A stand-in for "no Parker" (an operation that doesn't register).
pub fn no_parker() -> Parker { Parker(0) }

/// Unparks every Parker in `ws` (call it with the lock that guards `ws` held).
pub fn wake_all(ws: List[Parker]) uses io {
    for p in ws { p.unpark() }
}

/// Unparks the first Parker of `ws` and takes it out of the list (call it with the lock that
/// guards `ws` held). Nothing when `ws` is empty.
pub fn wake_one(inout ws: List[Parker]) uses io {
    if ws.len() == 0 { return }
    ws[0].unpark()
    let mut rest: List[Parker] = List.new()
    for i in 1..ws.len() { rest.push(ws[i]) }
    ws = rest
}

/// `ws` without `p`.
pub fn without(ws: List[Parker], p: Parker) -> List[Parker] {
    let mut out: List[Parker] = List.new()
    for q in ws {
        if q.h != p.h { out.push(q) }
    }
    out
}

//! std/sync: the two primitives the rest of the runtime layer is built from (docs/runtime.md).
//!
//! - `Lock[T]`: a value that one thread at a time holds, changed in place by a closure that
//!   also returns a result: an atomic read-modify-write of any state. It is a channel holding
//!   exactly one value: taking the lock receives the value, releasing it sends it back, with
//!   no other holder, so crossing threads copies nothing of it ("No copies" below). (The
//!   built-in Mutex can't do this: `update` returns nothing, and `get` then `set` is not
//!   atomic.)
//! - `Parker`: a thread waits on its own Parker with a deadline; any other thread unparks it.
//!   It is an OS waker (core/ABI.md "Readiness"), waited on with `fd_wait`, so a wait ends on
//!   time without a timer thread.
//!
//! Blocking structures (std/chan, std/task) combine them the same way: a waiter puts its
//! Parker in a list inside the Lock's state and parks; whoever changes the state wakes the
//! Parkers in the list, under the lock. Two rules make that safe:
//!   1. Waking happens with the lock held, and a waiter takes its Parker out of every list
//!      (under each lock) before it closes it. So no thread ever wakes a closed Parker (its
//!      descriptor number could have been reused by then).
//!   2. A waiter checks the state and registers in the same critical section, and every change
//!      that could let it proceed wakes the list after it, so no wake-up is lost.
//!
//! No copies (decision C320, issue #90). A value given to a channel is first made unique
//! (every buffer it reaches its own: values cross threads only that way, docs/compiler.md
//! "C8.1"), so whatever the sender still shares is copied. Arguments are borrows, and a
//! variable given to `send` is shared, not moved: `send(s)` with `s` alive copies all of
//! `s`, and so did the old `with`, whose closure's `(s, r)` shared all of `s`. So the channel
//! holds an `Option[T]`: `modify` lets the closure change the payload in place, and sends
//! `o.take()`, which moves the Option out of its variable, so what is sent has exactly one
//! holder and making it unique visits each of its buffers once and copies none. `with` and
//! `update` drop the value they lent their closure before sending what it returned, for the
//! same reason. What is still copied is only what really is shared: a part of the value that
//! the result also holds (a String returned from it), a captured value put into it, and what
//! a closure changes after sharing it (`let mut t = s.copy()` in `with`), which is why
//! changes go through `modify`.

import "core/os"
import "poll.ei"
import "time.ei"

/// A value one thread at a time holds (see the module comment). Copies of a Lock share it.
/// The channel holds `Some(value)` while nobody holds the lock.
pub type Lock[T] = { ch: Chan[Option[T]] }

pub fn lock[T](v: T) -> Lock[T] {
    let c: Chan[Option[T]] = Chan.new()
    c.send(Some(v))
    Lock(c)
}

/// What the channel holds, with no other holder (the Option the receive made is dropped on
/// return).
fn take[T](ch: Chan[Option[T]]) -> Option[T] { ch.recv().unwrap() }

/// `with`'s step: `f` on a borrow of `v`, whose new value replaces `v` (once this returns,
/// nothing else holds it), and `f`'s result.
fn apply[T, R](inout v: T, f: fn(T) -> (T, R)) -> R {
    let (s2, r) = f(v)
    v = s2
    r
}

impl[T] Lock[T] {
    /// Runs `f` on the value itself with the lock held and returns `f`'s result: `f` changes
    /// the value in place, and nothing of it is copied ("No copies" above). Other threads
    /// using the Lock wait meanwhile, so `f` should be short and must not use the same Lock
    /// (that waits for itself forever). Not cancellable (it never waits for anything but the
    /// lock).
    fn modify[R](self, f: fn(inout T) -> R) -> R {
        let mut o = take(self.ch)
        // an Option, since R may be () (which can't be bound)
        let r: Option[R] = match o {
            Some(mut v) => Some(f(inout v))
            None => None
        }
        self.ch.send(o.take())
        r.unwrap()
    }

    /// Runs `f` on the value with the lock held; `f` returns the new value and a result.
    /// Returning the value unchanged copies nothing, but `f` gets a borrow, so a change it
    /// makes copies what it changes: use `modify` for changes. The rules of `modify` apply.
    fn with[R](self, f: fn(T) -> (T, R)) -> R {
        let mut o = take(self.ch)
        let r: Option[R] = match o {
            Some(mut v) => Some(apply(inout v, f))
            None => None
        }
        self.ch.send(o.take())
        r.unwrap()
    }

    /// Replaces the value with `f(value)` (prefer `modify` for changes, as for `with`).
    fn update(self, f: fn(T) -> T) {
        let mut o = take(self.ch)
        let mut n: Option[T] = match o {
            Some(v) => Some(f(v))
            None => None
        }
        o = None
        self.ch.send(n.take())
    }

    /// A copy of the value.
    fn get(self) -> T {
        self.modify(|inout s: T| -> T s)
    }
}

/// A thread's wake-up handle (an OS waker). Make one with `parker()`, close it with `close`
/// once it is in no waiter list (rule 1 above).
pub type Parker = { w: poll.Waker }

pub fn parker() -> Parker uses io {
    match poll.waker() {
        Ok(w) => Parker(w)
        Err(e) => panic("sync.parker: cannot make a waker")
    }
}

impl Parker {
    /// Waits until unparked or `dl` passes: true when unparked. An unpark that came before
    /// the wait counts (it is not lost); several unparks before a wait are one.
    fn park(self, dl: time.Deadline) -> bool uses io, clock {
        while true {
            let r = os.fd_wait(self.w.r, 1, dl.timeout_ms())
            if r > 0 {
                poll.drain(self.w)
                return true
            }
            if r < 0 { panic("sync.park: wait on a closed parker") }
            if dl.expired() { return false }
        }
        false
    }

    /// Wakes the thread parked on it (or makes its next park return at once).
    fn unpark(self) uses io {
        os.waker_wake(self.w.w)
    }

    /// Clears a pending unpark without waiting.
    fn clear(self) uses io { poll.drain(self.w) }

    fn close(self) uses io { poll.close_waker(self.w) }

    /// Identifies the Parker while it is open (its descriptor).
    fn id(self) -> i32 { self.w.r }
}

/// A stand-in for "no Parker" (an operation that doesn't register).
pub fn no_parker() -> Parker { Parker(poll.Waker(-1, -1)) }

/// Unparks every Parker in `ws` (call it with the lock that guards `ws` held).
pub fn wake_all(ws: List[Parker]) uses io {
    for p in ws { p.unpark() }
}

/// Unparks the first Parker of `ws` and takes it out of the list (call it with the lock that
/// guards `ws` held). Nothing when `ws` is empty.
pub fn wake_one(inout ws: List[Parker]) uses io {
    if ws.len() == 0 { return }
    ws[0].unpark()
    let mut rest: List[Parker] = List.new()
    for i in 1..ws.len() { rest.push(ws[i]) }
    ws = rest
}

/// `ws` without `p`.
pub fn without(ws: List[Parker], p: Parker) -> List[Parker] {
    let mut out: List[Parker] = List.new()
    for q in ws {
        if q.w.r != p.w.r { out.push(q) }
    }
    out
}

//! std/fd: file descriptors: open files, pipes, positioned I/O, sync, locks, non-blocking mode.
//! Thin wrappers over the core (core/ABI.md "File descriptors"); buffered streams come later
//! (layer/std). A descriptor is an i32; close it with `close`.

import core.sys
import core.os
import std.time

/// Open flags: one access mode, plus any of the others.
pub const READ: i32 = 0
pub const WRITE: i32 = 1
pub const READ_WRITE: i32 = 2
pub const CREATE: i32 = 4
pub const EXCLUSIVE: i32 = 8
pub const TRUNCATE: i32 = 16
pub const APPEND: i32 = 32
pub const NONBLOCK: i32 = 64
pub const DIRECTORY: i32 = 128
pub const NOFOLLOW: i32 = 256

/// `seek` origins.
pub const FROM_START: i32 = 0
pub const FROM_CURRENT: i32 = 1
pub const FROM_END: i32 = 2

/// File kinds in a Stat.
pub const FILE: i32 = 1
pub const DIR: i32 = 2
pub const OTHER: i32 = 3
pub const SYMLINK: i32 = 4
pub const FIFO: i32 = 5
pub const SOCKET: i32 = 6

/// What `stat` reports: size in bytes, kind (FILE, DIR, ...), permission bits, and the
/// modification time in nanoseconds since the Unix epoch.
pub type Stat = { size: i64, kind: i32, mode: i32, mtime_ns: i64 }

/// The two ends of a pipe (or of a socket pair: both ends then read and write).
pub type Pair = { r: i32, w: i32 }

/// "<what>: <the system's message for status>"
pub fn error(what: str, status: i64) -> String {
    let mut m = String.from(what)
    m.push_str(": ")
    m.append(sys.error_text(status))
    m
}

/// True when a status means "not now" (a non-blocking descriptor with nothing to do).
pub fn would_block(status: i64) -> bool { os.err_kind(status) == 1 }

fn path_arg(path: List[u8]) {
    let mut p: List[List[u8]] = List.new()
    p.push(path)
    sys.send_all(p)
}

/// Open `path` with `flags` (READ | CREATE | ...); `mode` is the permission bits of a created
/// file (before the umask). Always close-on-exec.
pub fn open(path: List[u8], flags: i32, mode: i32) -> Result[i32, String] uses fs {
    path_arg(path)
    let n = os.fd_open(flags, mode)
    if n < 0 {
        let mut m = String.from("cannot open ")
        m.append(sys.to_string(path))
        m.push_str(": ")
        m.append(sys.error_text(n))
        return Err(m)
    }
    Ok(n as i32)
}

pub fn close(fd: i32) -> Result[bool, String] uses io {
    let n = os.fd_close(fd)
    if n < 0 { return Err(error("close", n)) }
    Ok(true)
}

/// Up to `max` bytes (one read, at most 1 MiB); empty at end of file.
pub fn read(fd: i32, max: i64) -> Result[List[u8], String] uses io {
    let n = sys.read_fd(fd, max)
    if n < 0 { return Err(error("read", n)) }
    Ok(sys.take())
}

/// `read` on a non-blocking descriptor: None when nothing is available yet.
pub fn try_read(fd: i32, max: i64) -> Result[Option[List[u8]], String] uses io {
    let n = sys.read_fd(fd, max)
    if n < 0 {
        if would_block(n) { return Ok(None) }
        return Err(error("read", n))
    }
    Ok(Some(sys.take()))
}

/// Readiness to wait for: `READY_READ`, `READY_WRITE`, or both (the same numbers as poll.READ
/// and poll.WRITE).
pub const READY_READ: i32 = 1
pub const READY_WRITE: i32 = 2

/// Waits until `fd` is ready for `interest` or `dl` passes: Ok(true) when ready (also when
/// the next read or write would report an error or end of file), Ok(false) at the deadline.
/// The descriptor's own mode doesn't matter. Cancel-safe: it only waits.
pub fn wait_ready(fd: i32, interest: i32, dl: time.Deadline) -> Result[bool, String] uses io, clock {
    while true {
        let n = os.fd_wait(fd, interest, dl.timeout_ms())
        if n < 0 { return Err(error("wait", n)) }
        if n > 0 { return Ok(true) }
        if dl.expired() { return Ok(false) }
    }
    Ok(false)
}

/// `read` with a deadline: Ok(None) when nothing arrived before `dl`, else as `read` (empty
/// at end of file). Waits first, so it works on blocking descriptors too, provided nobody
/// else reads `fd` between the wait and the read. Cancel-safe: nothing is consumed on time-out.
pub fn read_by(fd: i32, max: i64, dl: time.Deadline) -> Result[Option[List[u8]], String] uses io, clock {
    if !wait_ready(fd, READY_READ, dl)? { return Ok(None) }
    let n = sys.read_fd(fd, max)
    if n < 0 {
        if would_block(n) { return Ok(None) }
        return Err(error("read", n))
    }
    Ok(Some(sys.take()))
}

/// One write: the number of bytes written (may be fewer than given).
pub fn write(fd: i32, data: List[u8]) -> Result[i64, String] uses io {
    sys.send(data)
    let n = os.fd_write(fd)
    if n < 0 { return Err(error("write", n)) }
    Ok(n)
}

/// Write all of `data` (blocking descriptors).
pub fn write_all(fd: i32, data: List[u8]) -> Result[bool, String] uses io {
    let mut rest = data.copy()
    while rest.len() > 0 {
        let n = write(fd, rest)?
        let mut next: List[u8] = List.new()
        let mut i = n as usize
        while i < rest.len() {
            next.push(rest[i])
            i += 1
        }
        rest = next
    }
    Ok(true)
}

/// Up to `max` bytes at offset `off` (the file offset doesn't move).
pub fn read_at(fd: i32, max: i64, off: i64) -> Result[List[u8], String] uses io {
    let n = os.fd_pread(fd, max, off)
    if n < 0 { return Err(error("read", n)) }
    Ok(sys.take())
}

/// `data` at offset `off` (the file offset doesn't move): the number of bytes written.
pub fn write_at(fd: i32, data: List[u8], off: i64) -> Result[i64, String] uses io {
    sys.send(data)
    let n = os.fd_pwrite(fd, off)
    if n < 0 { return Err(error("write", n)) }
    Ok(n)
}

/// Move the file offset; the new offset.
pub fn seek(fd: i32, off: i64, origin: i32) -> Result[i64, String] uses io {
    let n = os.fd_seek(fd, off, origin)
    if n < 0 { return Err(error("seek", n)) }
    Ok(n)
}

/// Data and metadata to stable storage.
pub fn sync(fd: i32) -> Result[bool, String] uses fs {
    let n = os.fd_sync(fd, false)
    if n < 0 { return Err(error("sync", n)) }
    Ok(true)
}

/// The data (and only the metadata needed to read it back) to stable storage.
pub fn sync_data(fd: i32) -> Result[bool, String] uses fs {
    let n = os.fd_sync(fd, true)
    if n < 0 { return Err(error("sync", n)) }
    Ok(true)
}

pub fn truncate(fd: i32, len: i64) -> Result[bool, String] uses fs {
    let n = os.fd_truncate(fd, len)
    if n < 0 { return Err(error("truncate", n)) }
    Ok(true)
}

fn take_stat() -> Stat {
    let r = sys.take()
    Stat(os.le_u64(r, 0) as i64, os.le_u64(r, 8) as i32, os.le_u64(r, 16) as i32, os.le_u64(r, 24) as i64)
}

pub fn stat(fd: i32) -> Result[Stat, String] uses fs {
    let n = os.fd_stat(fd)
    if n < 0 { return Err(error("stat", n)) }
    Ok(take_stat())
}

/// What is at `path`; `follow`: describe a final symlink's target rather than the link.
pub fn stat_path(path: List[u8], follow: bool) -> Result[Stat, String] uses fs {
    path_arg(path)
    let n = os.stat(follow)
    if n < 0 {
        let mut m = String.from("cannot stat ")
        m.append(sys.to_string(path))
        m.push_str(": ")
        m.append(sys.error_text(n))
        return Err(m)
    }
    Ok(take_stat())
}

pub fn chmod(fd: i32, mode: i32) -> Result[bool, String] uses fs {
    let n = os.fd_chmod(fd, mode)
    if n < 0 { return Err(error("chmod", n)) }
    Ok(true)
}

/// An advisory lock on the whole file (flock): exclusive or shared. With `wait` false,
/// Ok(false) when another open file holds a conflicting lock.
pub fn lock(fd: i32, exclusive: bool, wait: bool) -> Result[bool, String] uses fs {
    let mut op: i32 = 1
    if exclusive { op = 2 }
    if !wait { op = op | 4 }
    let n = os.fd_lock(fd, op)
    if n < 0 {
        if !wait && would_block(n) { return Ok(false) }
        return Err(error("lock", n))
    }
    Ok(true)
}

pub fn unlock(fd: i32) -> Result[bool, String] uses fs {
    let n = os.fd_lock(fd, 0)
    if n < 0 { return Err(error("unlock", n)) }
    Ok(true)
}

pub fn set_nonblocking(fd: i32, on: bool) -> Result[bool, String] uses io {
    let n = os.fd_nonblock(fd, on)
    if n < 0 { return Err(error("set non-blocking", n)) }
    Ok(true)
}

/// Another descriptor for the same open file (shared offset and locks).
pub fn dup(fd: i32) -> Result[i32, String] uses io {
    let n = os.fd_dup(fd)
    if n < 0 { return Err(error("dup", n)) }
    Ok(n as i32)
}

/// The two descriptors in `out` (a pipe, a socket pair, a waker).
pub fn take_pair() -> Pair {
    let r = sys.take()
    Pair(os.le_fd(r, 0), os.le_fd(r, 4))
}

/// A pipe: bytes written to `w` are read from `r`.
pub fn pipe() -> Result[Pair, String] uses io {
    let n = os.pipe()
    if n < 0 { return Err(error("pipe", n)) }
    Ok(take_pair())
}

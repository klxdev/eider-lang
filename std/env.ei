// std/env: command-line arguments, environment variables, exit.

import "core/sys"

/// argv, including the program name.
pub fn args() -> List[List[u8]] uses io {
    if sys.args() < 0 { return List.new() }
    sys.take_all()
}

pub fn get(name: List[u8]) -> Option[List[u8]] uses io {
    sys.send(name)
    if sys.getenv() { return Some(sys.take()) }
    None
}

/// End the process now with `code` (buffered `print` output is flushed).
pub fn exit(code: i32) uses io { sys.exit_now(code) }

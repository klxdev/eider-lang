// std/env: command-line arguments, environment variables, exit.

import "sys.ei"
import "fs.ei"

/// argv, including the program name (Linux: read from /proc/self/cmdline).
pub fn args() -> List[List[u8]] uses io, fs, ffi {
    match fs.read(sys.lit("/proc/self/cmdline")) {
        Ok(raw) => {
            var parts: List[List[u8]] = List.new()
            var cur: List[u8] = List.new()
            for b in raw {
                if b == 0 {
                    parts.push(cur)
                    cur = List.new()
                } else {
                    cur.push(b)
                }
            }
            if cur.len() > 0 { parts.push(cur) }
            parts
        }
        Err(_) => List.new()
    }
}

pub fn get(name: List[u8]) -> Option[List[u8]] uses io, ffi {
    sys.send(name)
    if sys.getenv() { return Some(sys.take()) }
    None
}

/// End the process now with `code` (buffered `print` output is flushed).
pub fn exit(code: i32) uses io, ffi { sys.exit_now(code) }

#!/bin/sh
# Run the eider compiler: target/eiderc, built from the seed (seed/eiderc.c) with only $CC
# whenever it is missing or older than the seed or anything in core/. eiderc links the C core
# into every program itself.
# Usage: scripts/ei run prog.ei [--] [args...]   (any eiderc command; `scripts/ei --help`)
root="$(cd "$(dirname "$0")/.." && pwd)"
bin="$root/target/eiderc"
if [ ! -x "$bin" ] || [ -n "$(find "$root/seed/eiderc.c" "$root/core" -newer "$bin" 2>/dev/null | head -1)" ]; then
  mkdir -p "$root/target"
  # built next to the target and renamed into place, so concurrent callers never run half a file
  tmp="$bin.$$"
  ${CC:-cc} -std=c11 -O2 -pthread -I "$root/core" -o "$tmp" "$root/seed/eiderc.c" "$root/core/eider_rt.c" "$root/core/eider_core.c" &&
    mv -f "$tmp" "$bin" || { rm -f "$tmp"; echo "ei: could not build target/eiderc from seed/eiderc.c" >&2; exit 3; }
fi
exec "$bin" "$@"

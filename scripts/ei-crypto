#!/bin/sh
# scripts/ei with a crypto backend chosen: a program that imports "core/crypto" (or
# packages/crypto) gets its backend linked by the driver itself since 0.5 (compiler/driver.ei,
# core/crypto/README.md "Choosing a backend"), built when missing, so this wrapper only picks
# the backend (`--crypto`, which `scripts/ei` takes as well) and the sanitizer build.
# Usage: scripts/ei-crypto [--crypto <backend>] [--san] <eiderc args>
#   e.g. scripts/ei-crypto run prog.ei;  EIDER_CRYPTO=openssl scripts/ei-crypto build prog.ei
# --san links the backend built with ASan+UBSan (target/crypto/<backend>-san).
root="$(cd "$(dirname "$0")/.." && pwd)"
backend=
while :; do
  case ${1:-} in
    --crypto) backend=$2; shift 2 ;;
    --san) EIDER_CRYPTO_SAN=1; export EIDER_CRYPTO_SAN; shift ;;
    *) break ;;
  esac
done
if [ -n "$backend" ]; then exec "$root/scripts/ei" "$@" --crypto "$backend"; fi
exec "$root/scripts/ei" "$@"

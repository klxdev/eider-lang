//! core/os: the Layer 0 OS primitives (core/ABI.md, from "OS primitives: common rules" on):
//! descriptors, sockets, name resolution, readiness, time, signals, randomness, processes,
//! and the atomic cells (ABI "Atomic cells") std/atomic holds by handle.
//! Like core/sys (whose buffer functions it uses for arguments and results), it binds only
//! ec_* core symbols. It is a module of its own so that programs that don't use these
//! primitives, the compiler among them, don't carry their bindings (seed/eiderc.c stays as
//! it is). std/fd, net, poll, time, random, signal and child are built on it.
//!
//! Each function is one core call. Data arguments go through the input buffer first
//! (sys.send / sys.send_all); multi-value results come back in `out` as little-endian fields:
//! take them with sys.take and read them with le_u32 / le_u64 / le_fd.
//!
//! Each wrapper declares the real capability of what it does next to `ffi`, as core/sys.ei's
//! do (`ffi` doesn't leave its package, docs/compiler.md "C8.5"): `fs` for what touches files
//! as such (open, stat, chmod, truncate, flock, sync), `io` for descriptor I/O, pipes,
//! pollers, wakers, signals, randomness and getpid, `net` for sockets and the resolver,
//! `clock` for the clocks and sleep, and `io, fs, net` for spawn, wait and kill (a child can
//! do anything, as with sys.run). err_kind only `ffi`; the le_* readers nothing.

extern "c" fn ec_err_kind(e: i64) -> i32
extern "c" fn ec_fd_open(flags: i32, mode: i32) -> i64
extern "c" fn ec_fd_close(fd: i32) -> i64
extern "c" fn ec_fd_write(fd: i32) -> i64
extern "c" fn ec_fd_pread(fd: i32, max: i64, off: i64) -> i64
extern "c" fn ec_fd_pwrite(fd: i32, off: i64) -> i64
extern "c" fn ec_fd_seek(fd: i32, off: i64, whence: i32) -> i64
extern "c" fn ec_fd_sync(fd: i32, data_only: i32) -> i64
extern "c" fn ec_fd_truncate(fd: i32, len: i64) -> i64
extern "c" fn ec_fd_stat(fd: i32) -> i64
extern "c" fn ec_stat(follow: i32) -> i64
extern "c" fn ec_touch() -> i64
extern "c" fn ec_fd_chmod(fd: i32, mode: i32) -> i64
extern "c" fn ec_fd_lock(fd: i32, op: i32) -> i64
extern "c" fn ec_fd_nonblock(fd: i32, on: i32) -> i64
extern "c" fn ec_fd_dup(fd: i32) -> i64
extern "c" fn ec_pipe() -> i64
extern "c" fn ec_sock_open(family: i32, kind: i32, nonblock: i32) -> i64
extern "c" fn ec_sock_pair(kind: i32) -> i64
extern "c" fn ec_sock_bind(fd: i32) -> i64
extern "c" fn ec_sock_listen(fd: i32, backlog: i32) -> i64
extern "c" fn ec_sock_accept(fd: i32, nonblock: i32) -> i64
extern "c" fn ec_sock_connect(fd: i32) -> i64
extern "c" fn ec_sock_error(fd: i32) -> i64
extern "c" fn ec_sock_shutdown(fd: i32, how: i32) -> i64
extern "c" fn ec_sock_send(fd: i32) -> i64
extern "c" fn ec_sock_recv(fd: i32, max: i64, peek: i32) -> i64
extern "c" fn ec_sock_sendto(fd: i32, addr_len: i32) -> i64
extern "c" fn ec_sock_recvfrom(fd: i32, max: i64) -> i64
extern "c" fn ec_sock_name(fd: i32, peer: i32) -> i64
extern "c" fn ec_sock_setopt(fd: i32, opt: i32, value: i64) -> i64
extern "c" fn ec_sock_getopt(fd: i32, opt: i32) -> i64
extern "c" fn ec_dns_lookup(family: i32, kind: i32, flags: i32) -> i64
extern "c" fn ec_dns_reverse(flags: i32) -> i64
extern "c" fn ec_poll_new() -> i64
extern "c" fn ec_poll_ctl(pfd: i32, op: i32, fd: i32, interest: i32, token: i64) -> i64
extern "c" fn ec_poll_wait(pfd: i32, max: i32, timeout_ms: i64) -> i64
extern "c" fn ec_waker_new() -> i64
extern "c" fn ec_waker_wake(wfd: i32) -> i64
extern "c" fn ec_time_mono_ns() -> i64
extern "c" fn ec_time_wall_ns() -> i64
extern "c" fn ec_sleep_ns(ns: i64) -> i64
extern "c" fn ec_signal_fd() -> i64
extern "c" fn ec_signal_set(sig: i32, how: i32) -> i64
extern "c" fn ec_signal_mask(sig: i32, block: i32) -> i64
extern "c" fn ec_random(n: i64, nonblock: i32) -> i64
extern "c" fn ec_spawn(in_mode: i32, out_mode: i32, err_mode: i32) -> i64
extern "c" fn ec_wait(pid: i32, nohang: i32) -> i64
extern "c" fn ec_kill(pid: i32, sig: i32) -> i64
extern "c" fn ec_getpid() -> i64

fn flag(b: bool) -> i32 {
    if b { return 1 }
    0
}

/// Little-endian unsigned 32-bit field of `b` (a result taken with sys.take) at byte `at`.
pub fn le_u32(b: List[u8], at: usize) -> u32 {
    let mut v: u32 = 0
    let mut i: usize = 4
    while i > 0 {
        i -= 1
        v = v * 256 + (b[at + i] as u32)
    }
    v
}

/// A descriptor field (u32; -1 stays -1).
pub fn le_fd(b: List[u8], at: usize) -> i32 {
    let v = le_u32(b, at)
    if v == 4294967295 { return -1 }
    v as i32
}

/// Little-endian unsigned 64-bit field of `b` at byte `at`.
pub fn le_u64(b: List[u8], at: usize) -> u64 {
    let mut v: u64 = 0
    let mut i: usize = 8
    while i > 0 {
        i -= 1
        v = v * 256 + (b[at + i] as u64)
    }
    v
}

/// The portable kind of a status (core/ABI.md "Error kinds"): 1 would block, 2 in progress, ...
pub fn err_kind(status: i64) -> i32 uses ffi { unsafe { ec_err_kind(status) } }

// descriptors
pub fn fd_open(flags: i32, mode: i32) -> i64 uses fs, ffi { unsafe { ec_fd_open(flags, mode) } }
pub fn fd_close(fd: i32) -> i64 uses io, ffi { unsafe { ec_fd_close(fd) } }
pub fn fd_write(fd: i32) -> i64 uses io, ffi { unsafe { ec_fd_write(fd) } }
pub fn fd_pread(fd: i32, max: i64, off: i64) -> i64 uses io, ffi { unsafe { ec_fd_pread(fd, max, off) } }
pub fn fd_pwrite(fd: i32, off: i64) -> i64 uses io, ffi { unsafe { ec_fd_pwrite(fd, off) } }
pub fn fd_seek(fd: i32, off: i64, whence: i32) -> i64 uses io, ffi { unsafe { ec_fd_seek(fd, off, whence) } }
pub fn fd_sync(fd: i32, data_only: bool) -> i64 uses fs, ffi {
    let d = flag(data_only)
    unsafe { ec_fd_sync(fd, d) }
}
pub fn fd_truncate(fd: i32, len: i64) -> i64 uses fs, ffi { unsafe { ec_fd_truncate(fd, len) } }
pub fn fd_stat(fd: i32) -> i64 uses fs, ffi { unsafe { ec_fd_stat(fd) } }
pub fn stat(follow: bool) -> i64 uses fs, ffi {
    let f = flag(follow)
    unsafe { ec_stat(f) }
}
pub fn touch() -> i64 uses fs, ffi { unsafe { ec_touch() } }
pub fn fd_chmod(fd: i32, mode: i32) -> i64 uses fs, ffi { unsafe { ec_fd_chmod(fd, mode) } }
pub fn fd_lock(fd: i32, op: i32) -> i64 uses fs, ffi { unsafe { ec_fd_lock(fd, op) } }
pub fn fd_nonblock(fd: i32, on: bool) -> i64 uses io, ffi {
    let o = flag(on)
    unsafe { ec_fd_nonblock(fd, o) }
}
pub fn fd_dup(fd: i32) -> i64 uses io, ffi { unsafe { ec_fd_dup(fd) } }
pub fn pipe() -> i64 uses io, ffi { unsafe { ec_pipe() } }

// sockets
pub fn sock_open(family: i32, kind: i32, nonblock: bool) -> i64 uses net, ffi {
    let n = flag(nonblock)
    unsafe { ec_sock_open(family, kind, n) }
}
pub fn sock_pair(kind: i32) -> i64 uses net, ffi { unsafe { ec_sock_pair(kind) } }
pub fn sock_bind(fd: i32) -> i64 uses net, ffi { unsafe { ec_sock_bind(fd) } }
pub fn sock_listen(fd: i32, backlog: i32) -> i64 uses net, ffi { unsafe { ec_sock_listen(fd, backlog) } }
pub fn sock_accept(fd: i32, nonblock: bool) -> i64 uses net, ffi {
    let n = flag(nonblock)
    unsafe { ec_sock_accept(fd, n) }
}
pub fn sock_connect(fd: i32) -> i64 uses net, ffi { unsafe { ec_sock_connect(fd) } }
pub fn sock_error(fd: i32) -> i64 uses net, ffi { unsafe { ec_sock_error(fd) } }
pub fn sock_shutdown(fd: i32, how: i32) -> i64 uses net, ffi { unsafe { ec_sock_shutdown(fd, how) } }
pub fn sock_send(fd: i32) -> i64 uses net, ffi { unsafe { ec_sock_send(fd) } }
pub fn sock_recv(fd: i32, max: i64, peek: bool) -> i64 uses net, ffi {
    let p = flag(peek)
    unsafe { ec_sock_recv(fd, max, p) }
}
pub fn sock_sendto(fd: i32, addr_len: i32) -> i64 uses net, ffi { unsafe { ec_sock_sendto(fd, addr_len) } }
pub fn sock_recvfrom(fd: i32, max: i64) -> i64 uses net, ffi { unsafe { ec_sock_recvfrom(fd, max) } }
pub fn sock_name(fd: i32, peer: bool) -> i64 uses net, ffi {
    let p = flag(peer)
    unsafe { ec_sock_name(fd, p) }
}
pub fn sock_setopt(fd: i32, opt: i32, value: i64) -> i64 uses net, ffi { unsafe { ec_sock_setopt(fd, opt, value) } }
pub fn sock_getopt(fd: i32, opt: i32) -> i64 uses net, ffi { unsafe { ec_sock_getopt(fd, opt) } }
pub fn dns_lookup(family: i32, kind: i32, flags: i32) -> i64 uses net, ffi { unsafe { ec_dns_lookup(family, kind, flags) } }
pub fn dns_reverse(flags: i32) -> i64 uses net, ffi { unsafe { ec_dns_reverse(flags) } }

// readiness
pub fn poll_new() -> i64 uses io, ffi { unsafe { ec_poll_new() } }
pub fn poll_ctl(pfd: i32, op: i32, fd: i32, interest: i32, token: i64) -> i64 uses io, ffi {
    unsafe { ec_poll_ctl(pfd, op, fd, interest, token) }
}
pub fn poll_wait(pfd: i32, max: i32, timeout_ms: i64) -> i64 uses io, ffi { unsafe { ec_poll_wait(pfd, max, timeout_ms) } }
pub fn waker_new() -> i64 uses io, ffi { unsafe { ec_waker_new() } }
pub fn waker_wake(wfd: i32) -> i64 uses io, ffi { unsafe { ec_waker_wake(wfd) } }

// time
pub fn time_mono_ns() -> i64 uses clock, ffi { unsafe { ec_time_mono_ns() } }
pub fn time_wall_ns() -> i64 uses clock, ffi { unsafe { ec_time_wall_ns() } }
pub fn sleep_ns(ns: i64) -> i64 uses clock, ffi { unsafe { ec_sleep_ns(ns) } }

// signals
pub fn signal_fd() -> i64 uses io, ffi { unsafe { ec_signal_fd() } }
pub fn signal_set(sig: i32, how: i32) -> i64 uses io, ffi { unsafe { ec_signal_set(sig, how) } }
pub fn signal_mask(sig: i32, block: bool) -> i64 uses io, ffi {
    let b = flag(block)
    unsafe { ec_signal_mask(sig, b) }
}

// randomness
pub fn random(n: i64, nonblock: bool) -> i64 uses io, ffi {
    let b = flag(nonblock)
    unsafe { ec_random(n, b) }
}

// processes
pub fn spawn(in_mode: i32, out_mode: i32, err_mode: i32) -> i64 uses io, fs, net, ffi { unsafe { ec_spawn(in_mode, out_mode, err_mode) } }
pub fn wait(pid: i32, nohang: bool) -> i64 uses io, fs, net, ffi {
    let n = flag(nohang)
    unsafe { ec_wait(pid, n) }
}
pub fn kill(pid: i32, sig: i32) -> i64 uses io, fs, net, ffi { unsafe { ec_kill(pid, sig) } }
pub fn getpid() -> i64 uses io, ffi { unsafe { ec_getpid() } }

// one descriptor's readiness (core/ABI.md "Readiness")
extern "c" fn ec_fd_wait(fd: i32, interest: i32, timeout_ms: i64) -> i64
pub fn fd_wait(fd: i32, interest: i32, timeout_ms: i64) -> i64 uses io, ffi { unsafe { ec_fd_wait(fd, interest, timeout_ms) } }

// atomic cells (core/ABI.md "Atomic cells"). No real capability: like a Mutex, a cell is
// memory shared between threads, not the OS, so these take only `ffi` (which stays in core).
extern "c" fn ec_atomic_new(v: i64) -> i64
extern "c" fn ec_atomic_free(h: i64) -> i64
extern "c" fn ec_atomic_load(h: i64, order: i32) -> i64
extern "c" fn ec_atomic_store(h: i64, v: i64, order: i32) -> i64
extern "c" fn ec_atomic_swap(h: i64, v: i64, order: i32) -> i64
extern "c" fn ec_atomic_add(h: i64, n: i64, order: i32) -> i64
extern "c" fn ec_atomic_cas(h: i64, expected: i64, desired: i64, order: i32) -> i64
pub fn atomic_new(v: i64) -> i64 uses ffi { unsafe { ec_atomic_new(v) } }
pub fn atomic_free(h: i64) -> i64 uses ffi { unsafe { ec_atomic_free(h) } }
pub fn atomic_load(h: i64, order: i32) -> i64 uses ffi { unsafe { ec_atomic_load(h, order) } }
pub fn atomic_store(h: i64, v: i64, order: i32) -> i64 uses ffi { unsafe { ec_atomic_store(h, v, order) } }
pub fn atomic_swap(h: i64, v: i64, order: i32) -> i64 uses ffi { unsafe { ec_atomic_swap(h, v, order) } }
pub fn atomic_add(h: i64, n: i64, order: i32) -> i64 uses ffi { unsafe { ec_atomic_add(h, n, order) } }
pub fn atomic_cas(h: i64, expected: i64, desired: i64, order: i32) -> i64 uses ffi { unsafe { ec_atomic_cas(h, expected, desired, order) } }

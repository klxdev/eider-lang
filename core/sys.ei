// core/sys: the Eider half of the core, and the only module that talks to C (eider_core.c).
// std/ and every package are plain Eider built on these functions. No pointers cross the
// boundary: data moves a byte at a time through the core's `in` and `out` buffers.
// Only core symbols (ec_*) are bound here, never libc names, so platform symbol rules stay
// inside the C file (see core/ABI.md).
// Each wrapper declares the real capability of what it does (fs, io, net) next to `ffi`, and
// the buffer and text helpers only `ffi`: `ffi` doesn't leave its package, so a caller in std
// or any other package needs only the real one (docs/compiler.md, "C8.5: capabilities per
// package").

extern "c" fn ec_in_clear()
extern "c" fn ec_in_push(b: i32)
extern "c" fn ec_out_len() -> i64
extern "c" fn ec_out_byte(i: i64) -> i32
extern "c" fn ec_in_cstr() -> str
extern "c" fn ec_str_byte(s: str, i: i64) -> i32
extern "c" fn ec_read_file() -> i64
extern "c" fn ec_write_file(append: i32) -> i64
extern "c" fn ec_list_dir() -> i64
extern "c" fn ec_kind(follow: i32) -> i32
extern "c" fn ec_mkdir() -> i64
extern "c" fn ec_remove() -> i64
extern "c" fn ec_rename() -> i64
extern "c" fn ec_symlink() -> i64
extern "c" fn ec_cwd() -> i64
extern "c" fn ec_realpath() -> i64
extern "c" fn ec_getenv() -> i32
extern "c" fn ec_write_fd(fd: i32) -> i64
extern "c" fn ec_read_fd(fd: i32, max: i64) -> i64
extern "c" fn ec_run(out_mode: i32, err_mode: i32, timeout_ms: i64) -> i64
extern "c" fn ec_args() -> i64
extern "c" fn ec_str_len(s: str) -> i64
extern "c" fn ec_errstr(e: i64)
extern "c" fn ec_exit(code: i32)

/// The bytes of a string literal.
pub fn lit(s: str) -> List[u8] uses ffi {
    let mut out: List[u8] = List.new()
    let n = unsafe { ec_str_len(s) }
    let mut i: i64 = 0
    while i < n {
        let b = unsafe { ec_str_byte(s, i) }
        out.push(b as u8)
        i += 1
    }
    out
}

/// Bytes -> String (for `print`). Stops at a NUL byte, like every C string.
/// (The core keeps the input buffer NUL-terminated.)
pub fn to_string(b: List[u8]) -> String uses ffi {
    send(b)
    let s = unsafe { ec_in_cstr() }
    String.from(s)
}

// ---- argument passing

/// Replace the core's input buffer with `b`.
pub fn send(b: List[u8]) uses ffi {
    unsafe { ec_in_clear() }
    for x in b {
        unsafe { ec_in_push(x as i32) }
    }
}

/// Replace the input buffer with `parts`, NUL-separated.
pub fn send_all(parts: List[List[u8]]) uses ffi {
    unsafe { ec_in_clear() }
    for i in 0..parts.len() {
        if i > 0 {
            unsafe { ec_in_push(0) }
        }
        for x in parts[i] {
            unsafe { ec_in_push(x as i32) }
        }
    }
}

/// The core's output buffer.
pub fn take() -> List[u8] uses ffi {
    let mut out: List[u8] = List.new()
    let n = unsafe { ec_out_len() }
    let mut i: i64 = 0
    while i < n {
        let b = unsafe { ec_out_byte(i) }
        out.push(b as u8)
        i += 1
    }
    out
}

/// The output buffer split at NUL bytes (a trailing NUL doesn't add an empty part).
pub fn take_all() -> List[List[u8]] uses ffi {
    let raw = take()
    let mut parts: List[List[u8]] = List.new()
    let mut cur: List[u8] = List.new()
    for b in raw {
        if b == 0 {
            parts.push(cur)
            cur = List.new()
        } else {
            cur.push(b)
        }
    }
    if cur.len() > 0 {
        parts.push(cur)
    }
    parts
}

/// The text for a negative status returned by the core (-errno).
pub fn error_text(status: i64) -> String uses ffi {
    unsafe { ec_errstr(status) }
    to_string(take())
}

// ---- operations (arguments must already be in the input buffer)

pub fn read_file() -> i64 uses fs, ffi { unsafe { ec_read_file() } }
pub fn write_file(append: bool) -> i64 uses fs, ffi {
    let a = if append { 1 } else { 0 }
    unsafe { ec_write_file(a) }
}
pub fn list_dir() -> i64 uses fs, ffi { unsafe { ec_list_dir() } }
pub fn kind(follow: bool) -> i32 uses fs, ffi {
    let f = if follow { 1 } else { 0 }
    unsafe { ec_kind(f) }
}
pub fn mkdir() -> i64 uses fs, ffi { unsafe { ec_mkdir() } }
pub fn remove() -> i64 uses fs, ffi { unsafe { ec_remove() } }
pub fn rename() -> i64 uses fs, ffi { unsafe { ec_rename() } }
pub fn symlink() -> i64 uses fs, ffi { unsafe { ec_symlink() } }
pub fn cwd() -> i64 uses fs, ffi { unsafe { ec_cwd() } }
pub fn realpath() -> i64 uses fs, ffi { unsafe { ec_realpath() } }
pub fn getenv() -> bool uses io, ffi {
    let r = unsafe { ec_getenv() }
    r == 1
}
pub fn write_fd(fd: i32) -> i64 uses io, ffi { unsafe { ec_write_fd(fd) } }
/// Read up to `max` bytes from `fd` into `out`: the count, 0 at end of file, or -errno.
pub fn read_fd(fd: i32, max: i64) -> i64 uses io, ffi { unsafe { ec_read_fd(fd, max) } }
/// Run argv (in the input buffer). Captured output is in `out` as an 8-byte little-endian
/// stdout length, stdout, then stderr; a result of 256 means the timeout killed the child
/// (core/ABI.md "Running a program"). timeout_ms <= 0: no limit.
pub fn run(capture_out: bool, capture_err: bool, timeout_ms: i64) -> i64 uses io, fs, net, ffi {
    let o = if capture_out { 1 } else { 0 }
    let e = if capture_err { 1 } else { 0 }
    unsafe { ec_run(o, e, timeout_ms) }
}
pub fn args() -> i64 uses io, ffi { unsafe { ec_args() } }

pub fn exit_now(code: i32) uses io, ffi { unsafe { ec_exit(code) } }

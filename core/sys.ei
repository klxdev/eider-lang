// core/sys: the Eider half of the core, and the only module that talks to C (eider_core.c).
// std/ and every package are plain Eider built on these functions. No pointers cross the
// boundary: data moves a byte at a time through the core's `in` and `out` buffers.
// Only core symbols (ec_*) are bound here, never libc names, so platform symbol rules stay
// inside the C file (see core/ABI.md).

extern "c" fn ec_in_clear()
extern "c" fn ec_in_push(b: i32)
extern "c" fn ec_out_len() -> i64
extern "c" fn ec_out_byte(i: i64) -> i32
extern "c" fn ec_in_cstr() -> str
extern "c" fn ec_str_byte(s: str, i: i64) -> i32
extern "c" fn ec_read_file() -> i64
extern "c" fn ec_write_file(append: i32) -> i64
extern "c" fn ec_list_dir() -> i64
extern "c" fn ec_kind(follow: i32) -> i32
extern "c" fn ec_mkdir() -> i64
extern "c" fn ec_remove() -> i64
extern "c" fn ec_rename() -> i64
extern "c" fn ec_symlink() -> i64
extern "c" fn ec_cwd() -> i64
extern "c" fn ec_realpath() -> i64
extern "c" fn ec_getenv() -> i32
extern "c" fn ec_write_fd(fd: i32) -> i64
extern "c" fn ec_read_fd(fd: i32, max: i64) -> i64
extern "c" fn ec_run(out_mode: i32, err_mode: i32, timeout_ms: i64) -> i64
extern "c" fn ec_args() -> i64
extern "c" fn ec_str_len(s: str) -> i64
extern "c" fn ec_errstr(e: i64)
extern "c" fn ec_exit(code: i32)

/// The bytes of a string literal.
pub fn lit(s: str) -> List[u8] uses ffi {
    var out: List[u8] = List.new()
    let n = unsafe { ec_str_len(s) }
    var i: i64 = 0
    while i < n {
        let b = unsafe { ec_str_byte(s, i) }
        out.push(b as u8)
        i += 1
    }
    out
}

/// Bytes -> String (for `print`). Stops at a NUL byte, like every C string.
/// (The core keeps the input buffer NUL-terminated.)
pub fn to_string(b: List[u8]) -> String uses ffi {
    send(b)
    let s = unsafe { ec_in_cstr() }
    String.from(s)
}

// ---- argument passing

/// Replace the core's input buffer with `b`.
pub fn send(b: List[u8]) uses ffi {
    unsafe { ec_in_clear() }
    for x in b {
        unsafe { ec_in_push(x as i32) }
    }
}

/// Replace the input buffer with `parts`, NUL-separated.
pub fn send_all(parts: List[List[u8]]) uses ffi {
    unsafe { ec_in_clear() }
    for i in 0..parts.len() {
        if i > 0 {
            unsafe { ec_in_push(0) }
        }
        for x in parts[i] {
            unsafe { ec_in_push(x as i32) }
        }
    }
}

/// The core's output buffer.
pub fn take() -> List[u8] uses ffi {
    var out: List[u8] = List.new()
    let n = unsafe { ec_out_len() }
    var i: i64 = 0
    while i < n {
        let b = unsafe { ec_out_byte(i) }
        out.push(b as u8)
        i += 1
    }
    out
}

/// The output buffer split at NUL bytes (a trailing NUL doesn't add an empty part).
pub fn take_all() -> List[List[u8]] uses ffi {
    let raw = take()
    var parts: List[List[u8]] = List.new()
    var cur: List[u8] = List.new()
    for b in raw {
        if b == 0 {
            parts.push(cur)
            cur = List.new()
        } else {
            cur.push(b)
        }
    }
    if cur.len() > 0 {
        parts.push(cur)
    }
    parts
}

/// The text for a negative status returned by the core (-errno).
pub fn error_text(status: i64) -> String uses ffi {
    unsafe { ec_errstr(status) }
    to_string(take())
}

// ---- operations (arguments must already be in the input buffer)

pub fn read_file() -> i64 uses ffi { unsafe { ec_read_file() } }
pub fn write_file(append: bool) -> i64 uses ffi {
    let a = if append { 1 } else { 0 }
    unsafe { ec_write_file(a) }
}
pub fn list_dir() -> i64 uses ffi { unsafe { ec_list_dir() } }
pub fn kind(follow: bool) -> i32 uses ffi {
    let f = if follow { 1 } else { 0 }
    unsafe { ec_kind(f) }
}
pub fn mkdir() -> i64 uses ffi { unsafe { ec_mkdir() } }
pub fn remove() -> i64 uses ffi { unsafe { ec_remove() } }
pub fn rename() -> i64 uses ffi { unsafe { ec_rename() } }
pub fn symlink() -> i64 uses ffi { unsafe { ec_symlink() } }
pub fn cwd() -> i64 uses ffi { unsafe { ec_cwd() } }
pub fn realpath() -> i64 uses ffi { unsafe { ec_realpath() } }
pub fn getenv() -> bool uses ffi {
    let r = unsafe { ec_getenv() }
    r == 1
}
pub fn write_fd(fd: i32) -> i64 uses ffi { unsafe { ec_write_fd(fd) } }
/// Read up to `max` bytes from `fd` into `out`: the count, 0 at end of file, or -errno.
pub fn read_fd(fd: i32, max: i64) -> i64 uses ffi { unsafe { ec_read_fd(fd, max) } }
/// Run argv (in the input buffer). Captured output is in `out` as an 8-byte little-endian
/// stdout length, stdout, then stderr; a result of 256 means the timeout killed the child
/// (core/ABI.md "Running a program"). timeout_ms <= 0: no limit.
pub fn run(capture_out: bool, capture_err: bool, timeout_ms: i64) -> i64 uses ffi {
    let o = if capture_out { 1 } else { 0 }
    let e = if capture_err { 1 } else { 0 }
    unsafe { ec_run(o, e, timeout_ms) }
}
pub fn args() -> i64 uses ffi { unsafe { ec_args() } }

pub fn exit_now(code: i32) uses ffi { unsafe { ec_exit(code) } }

// ---- OS primitives (core/ABI.md from "OS primitives: common rules" on). Each is one core
// call; arguments that are data go through the input buffer first, multi-value results come
// back in `out` as little-endian fields (read them with out_u32 / out_u64).

extern "c" fn ec_err_kind(e: i64) -> i32
extern "c" fn ec_fd_open(flags: i32, mode: i32) -> i64
extern "c" fn ec_fd_close(fd: i32) -> i64
extern "c" fn ec_fd_write(fd: i32) -> i64
extern "c" fn ec_fd_pread(fd: i32, max: i64, off: i64) -> i64
extern "c" fn ec_fd_pwrite(fd: i32, off: i64) -> i64
extern "c" fn ec_fd_seek(fd: i32, off: i64, whence: i32) -> i64
extern "c" fn ec_fd_sync(fd: i32, data_only: i32) -> i64
extern "c" fn ec_fd_truncate(fd: i32, len: i64) -> i64
extern "c" fn ec_fd_stat(fd: i32) -> i64
extern "c" fn ec_stat(follow: i32) -> i64
extern "c" fn ec_fd_chmod(fd: i32, mode: i32) -> i64
extern "c" fn ec_fd_lock(fd: i32, op: i32) -> i64
extern "c" fn ec_fd_nonblock(fd: i32, on: i32) -> i64
extern "c" fn ec_fd_dup(fd: i32) -> i64
extern "c" fn ec_pipe() -> i64
extern "c" fn ec_sock_open(family: i32, kind: i32, nonblock: i32) -> i64
extern "c" fn ec_sock_pair(kind: i32) -> i64
extern "c" fn ec_sock_bind(fd: i32) -> i64
extern "c" fn ec_sock_listen(fd: i32, backlog: i32) -> i64
extern "c" fn ec_sock_accept(fd: i32, nonblock: i32) -> i64
extern "c" fn ec_sock_connect(fd: i32) -> i64
extern "c" fn ec_sock_error(fd: i32) -> i64
extern "c" fn ec_sock_shutdown(fd: i32, how: i32) -> i64
extern "c" fn ec_sock_send(fd: i32) -> i64
extern "c" fn ec_sock_recv(fd: i32, max: i64, peek: i32) -> i64
extern "c" fn ec_sock_sendto(fd: i32, addr_len: i32) -> i64
extern "c" fn ec_sock_recvfrom(fd: i32, max: i64) -> i64
extern "c" fn ec_sock_name(fd: i32, peer: i32) -> i64
extern "c" fn ec_sock_setopt(fd: i32, opt: i32, value: i64) -> i64
extern "c" fn ec_sock_getopt(fd: i32, opt: i32) -> i64
extern "c" fn ec_dns_lookup(family: i32, kind: i32, flags: i32) -> i64
extern "c" fn ec_dns_reverse(flags: i32) -> i64
extern "c" fn ec_poll_new() -> i64
extern "c" fn ec_poll_ctl(pfd: i32, op: i32, fd: i32, interest: i32, token: i64) -> i64
extern "c" fn ec_poll_wait(pfd: i32, max: i32, timeout_ms: i64) -> i64
extern "c" fn ec_waker_new() -> i64
extern "c" fn ec_waker_wake(wfd: i32) -> i64
extern "c" fn ec_time_mono_ns() -> i64
extern "c" fn ec_time_wall_ns() -> i64
extern "c" fn ec_sleep_ns(ns: i64) -> i64
extern "c" fn ec_signal_fd() -> i64
extern "c" fn ec_signal_set(sig: i32, how: i32) -> i64
extern "c" fn ec_signal_mask(sig: i32, block: i32) -> i64
extern "c" fn ec_random(n: i64, nonblock: i32) -> i64
extern "c" fn ec_spawn(in_mode: i32, out_mode: i32, err_mode: i32) -> i64
extern "c" fn ec_wait(pid: i32, nohang: i32) -> i64
extern "c" fn ec_kill(pid: i32, sig: i32) -> i64
extern "c" fn ec_getpid() -> i64

fn flag(b: bool) -> i32 {
    if b { return 1 }
    0
}

/// Little-endian unsigned 32-bit field of `out` at byte `at`.
pub fn out_u32(at: i64) -> u32 uses ffi {
    var v: u32 = 0
    var i: i64 = 4
    while i > 0 {
        i -= 1
        let b = unsafe { ec_out_byte(at + i) }
        v = v * 256 + (b as u32)
    }
    v
}

/// A descriptor (a u32 field of `out`; -1 stays -1).
pub fn out_fd(at: i64) -> i32 uses ffi {
    let v = out_u32(at)
    if v == 4294967295 { return -1 }
    v as i32
}

/// Little-endian unsigned 64-bit field of `out` at byte `at`.
pub fn out_u64(at: i64) -> u64 uses ffi {
    var v: u64 = 0
    var i: i64 = 8
    while i > 0 {
        i -= 1
        let b = unsafe { ec_out_byte(at + i) }
        v = v * 256 + (b as u64)
    }
    v
}

/// Byte `at` of `out` (-1 past the end).
pub fn out_byte(at: i64) -> i32 uses ffi { unsafe { ec_out_byte(at) } }
pub fn out_len() -> i64 uses ffi { unsafe { ec_out_len() } }

/// The portable kind of a status (core/ABI.md "Error kinds"): 1 would block, 2 in progress, ...
pub fn err_kind(status: i64) -> i32 uses ffi { unsafe { ec_err_kind(status) } }

// descriptors
pub fn fd_open(flags: i32, mode: i32) -> i64 uses ffi { unsafe { ec_fd_open(flags, mode) } }
pub fn fd_close(fd: i32) -> i64 uses ffi { unsafe { ec_fd_close(fd) } }
pub fn fd_write(fd: i32) -> i64 uses ffi { unsafe { ec_fd_write(fd) } }
pub fn fd_pread(fd: i32, max: i64, off: i64) -> i64 uses ffi { unsafe { ec_fd_pread(fd, max, off) } }
pub fn fd_pwrite(fd: i32, off: i64) -> i64 uses ffi { unsafe { ec_fd_pwrite(fd, off) } }
pub fn fd_seek(fd: i32, off: i64, whence: i32) -> i64 uses ffi { unsafe { ec_fd_seek(fd, off, whence) } }
pub fn fd_sync(fd: i32, data_only: bool) -> i64 uses ffi {
    let d = flag(data_only)
    unsafe { ec_fd_sync(fd, d) }
}
pub fn fd_truncate(fd: i32, len: i64) -> i64 uses ffi { unsafe { ec_fd_truncate(fd, len) } }
pub fn fd_stat(fd: i32) -> i64 uses ffi { unsafe { ec_fd_stat(fd) } }
pub fn stat(follow: bool) -> i64 uses ffi {
    let f = flag(follow)
    unsafe { ec_stat(f) }
}
pub fn fd_chmod(fd: i32, mode: i32) -> i64 uses ffi { unsafe { ec_fd_chmod(fd, mode) } }
pub fn fd_lock(fd: i32, op: i32) -> i64 uses ffi { unsafe { ec_fd_lock(fd, op) } }
pub fn fd_nonblock(fd: i32, on: bool) -> i64 uses ffi {
    let o = flag(on)
    unsafe { ec_fd_nonblock(fd, o) }
}
pub fn fd_dup(fd: i32) -> i64 uses ffi { unsafe { ec_fd_dup(fd) } }
pub fn pipe() -> i64 uses ffi { unsafe { ec_pipe() } }

// sockets
pub fn sock_open(family: i32, kind: i32, nonblock: bool) -> i64 uses ffi {
    let n = flag(nonblock)
    unsafe { ec_sock_open(family, kind, n) }
}
pub fn sock_pair(kind: i32) -> i64 uses ffi { unsafe { ec_sock_pair(kind) } }
pub fn sock_bind(fd: i32) -> i64 uses ffi { unsafe { ec_sock_bind(fd) } }
pub fn sock_listen(fd: i32, backlog: i32) -> i64 uses ffi { unsafe { ec_sock_listen(fd, backlog) } }
pub fn sock_accept(fd: i32, nonblock: bool) -> i64 uses ffi {
    let n = flag(nonblock)
    unsafe { ec_sock_accept(fd, n) }
}
pub fn sock_connect(fd: i32) -> i64 uses ffi { unsafe { ec_sock_connect(fd) } }
pub fn sock_error(fd: i32) -> i64 uses ffi { unsafe { ec_sock_error(fd) } }
pub fn sock_shutdown(fd: i32, how: i32) -> i64 uses ffi { unsafe { ec_sock_shutdown(fd, how) } }
pub fn sock_send(fd: i32) -> i64 uses ffi { unsafe { ec_sock_send(fd) } }
pub fn sock_recv(fd: i32, max: i64, peek: bool) -> i64 uses ffi {
    let p = flag(peek)
    unsafe { ec_sock_recv(fd, max, p) }
}
pub fn sock_sendto(fd: i32, addr_len: i32) -> i64 uses ffi { unsafe { ec_sock_sendto(fd, addr_len) } }
pub fn sock_recvfrom(fd: i32, max: i64) -> i64 uses ffi { unsafe { ec_sock_recvfrom(fd, max) } }
pub fn sock_name(fd: i32, peer: bool) -> i64 uses ffi {
    let p = flag(peer)
    unsafe { ec_sock_name(fd, p) }
}
pub fn sock_setopt(fd: i32, opt: i32, value: i64) -> i64 uses ffi { unsafe { ec_sock_setopt(fd, opt, value) } }
pub fn sock_getopt(fd: i32, opt: i32) -> i64 uses ffi { unsafe { ec_sock_getopt(fd, opt) } }
pub fn dns_lookup(family: i32, kind: i32, flags: i32) -> i64 uses ffi { unsafe { ec_dns_lookup(family, kind, flags) } }
pub fn dns_reverse(flags: i32) -> i64 uses ffi { unsafe { ec_dns_reverse(flags) } }

// readiness
pub fn poll_new() -> i64 uses ffi { unsafe { ec_poll_new() } }
pub fn poll_ctl(pfd: i32, op: i32, fd: i32, interest: i32, token: i64) -> i64 uses ffi {
    unsafe { ec_poll_ctl(pfd, op, fd, interest, token) }
}
pub fn poll_wait(pfd: i32, max: i32, timeout_ms: i64) -> i64 uses ffi { unsafe { ec_poll_wait(pfd, max, timeout_ms) } }
pub fn waker_new() -> i64 uses ffi { unsafe { ec_waker_new() } }
pub fn waker_wake(wfd: i32) -> i64 uses ffi { unsafe { ec_waker_wake(wfd) } }

// time
pub fn time_mono_ns() -> i64 uses ffi { unsafe { ec_time_mono_ns() } }
pub fn time_wall_ns() -> i64 uses ffi { unsafe { ec_time_wall_ns() } }
pub fn sleep_ns(ns: i64) -> i64 uses ffi { unsafe { ec_sleep_ns(ns) } }

// signals
pub fn signal_fd() -> i64 uses ffi { unsafe { ec_signal_fd() } }
pub fn signal_set(sig: i32, how: i32) -> i64 uses ffi { unsafe { ec_signal_set(sig, how) } }
pub fn signal_mask(sig: i32, block: bool) -> i64 uses ffi {
    let b = flag(block)
    unsafe { ec_signal_mask(sig, b) }
}

// randomness
pub fn random(n: i64, nonblock: bool) -> i64 uses ffi {
    let b = flag(nonblock)
    unsafe { ec_random(n, b) }
}

// processes
pub fn spawn(in_mode: i32, out_mode: i32, err_mode: i32) -> i64 uses ffi { unsafe { ec_spawn(in_mode, out_mode, err_mode) } }
pub fn wait(pid: i32, nohang: bool) -> i64 uses ffi {
    let n = flag(nohang)
    unsafe { ec_wait(pid, n) }
}
pub fn kill(pid: i32, sig: i32) -> i64 uses ffi { unsafe { ec_kill(pid, sig) } }
pub fn getpid() -> i64 uses ffi { unsafe { ec_getpid() } }

type Option[T] = | Some(value: T) | None
type Result[T, E] = | Ok(value: T) | Err(error: E)

impl[T] Option[T] {
    fn is_some(self) -> bool {
        match self {
            Some(_) => true
            None => false
        }
    }
    fn is_none(self) -> bool {
        match self {
            Some(_) => false
            None => true
        }
    }
    fn unwrap_or(self, default: T) -> T {
        match self {
            Some(v) => v
            None => default
        }
    }
    fn unwrap(self) -> T {
        match self {
            Some(v) => v
            None => panic("called `unwrap` on a None value")
        }
    }
    fn map[U](self, f: fn(T) -> U) -> Option[U] {
        match self {
            Some(v) => Some(f(v))
            None => None
        }
    }
    fn and_then[U](self, f: fn(T) -> Option[U]) -> Option[U] {
        match self {
            Some(v) => f(v)
            None => None
        }
    }
    fn ok_or[E](self, err: E) -> Result[T, E] {
        match self {
            Some(v) => Ok(v)
            None => Err(err)
        }
    }
}

impl[T, E] Result[T, E] {
    fn is_ok(self) -> bool {
        match self {
            Ok(_) => true
            Err(_) => false
        }
    }
    fn is_err(self) -> bool {
        match self {
            Ok(_) => false
            Err(_) => true
        }
    }
    fn unwrap_or(self, default: T) -> T {
        match self {
            Ok(v) => v
            Err(_) => default
        }
    }
    fn unwrap(self) -> T {
        match self {
            Ok(v) => v
            Err(_) => panic("called `unwrap` on an Err value")
        }
    }
    fn map[U](self, f: fn(T) -> U) -> Result[U, E] {
        match self {
            Ok(v) => Ok(f(v))
            Err(e) => Err(e)
        }
    }
    fn map_err[F](self, f: fn(E) -> F) -> Result[T, F] {
        match self {
            Ok(v) => Ok(v)
            Err(e) => Err(f(e))
        }
    }
    fn and_then[U](self, f: fn(T) -> Result[U, E]) -> Result[U, E] {
        match self {
            Ok(v) => f(v)
            Err(e) => Err(e)
        }
    }
    fn ok(self) -> Option[T] {
        match self {
            Ok(v) => Some(v)
            Err(_) => None
        }
    }
}

// The operation traits (docs/compiler.md, "C8.4: operation traits"). The language performs
// `.copy()`, `==`, ordering, hashing, printing, `for` and cleanup through them. A record,
// enum or tuple has a trait when all its parts do (derived, no annotation); the package
// that defines a type may implement one for it instead. `Iter`'s `next` returns
// `Option[Item]` for the item type the impl chooses.
type Ordering = | Less | Equal | Greater

trait Copy { fn copy(self) -> Self }
trait Eq { fn eq(self, other: Self) -> bool }
trait Ord { fn compare(self, other: Self) -> Ordering }
trait Hash { fn hash(self) -> u64 }
trait Show { fn show(self, inout out: String) }
trait Iter { fn next(inout self) -> Option[Item] }
trait Drop { fn drop(inout self) }

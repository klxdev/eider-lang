//! resolve: from a root manifest to the full package graph (minimal version selection).
//!
//! Every requirement reachable from the root is visited, including the requirements of
//! versions that end up not selected (as in Go's MVS). Then, per package name, the highest
//! required version wins, and only packages reachable through the selected versions are
//! kept. A dependency's capability grant is the intersection of what every depender grants.

import core.sys
import std.bytes
import std.fs
import pkg.semver
import pkg.manifest
import pkg.lockfile
import pkg.store
import pkg.caps
import pkg.override
import pkg.grants

/// `toolchain` is the running toolchain's root (EIDER_ROOT): where the packages it ships
/// (`toolchain = true` dependencies) are.
pub type Opts = { home: List[u8], offline: bool, use_lock: bool, locked: List[lockfile.Pkg], vendor: List[u8], overrides: List[override.Override], toolchain: List[u8] }

type Req = { name: List[u8], git: bool, tool: bool, loc: List[u8], want: List[u8], is_rev: bool, grants: List[List[u8]], by: List[u8] }

pub type Edge = { from: List[u8], to: List[u8], grants: List[List[u8]] }

/// Identity of one visited (package, version) node; the root is "".
fn key(name: List[u8], want: List[u8]) -> List[u8] {
    let mut k = name.copy()
    k.push(64)
    bytes.append(inout k, want)
    k
}

fn pkg_key(p: lockfile.Pkg) -> List[u8] { key(p.name, p.want) }

fn text(b: List[u8]) -> String { sys.to_string(b) }

fn req_of(d: manifest.Dep, base: List[u8], by: List[u8], by_git: bool) -> Result[Req, String] {
    let none: List[u8] = List.new()
    match d.source {
        manifest.Path(p) => {
            if by_git {
                let mut m = String.from("`")
                m.append(text(by))
                m.push_str("` comes from git but has a path dependency on `")
                m.append(text(d.name))
                m.push_str("`; published packages can only depend on git packages")
                if manifest.shipped(d.name) {
                    m.push_str(" (`")
                    m.append(text(d.name))
                    m.push_str("` comes with the toolchain: write `[deps.")
                    m.append(text(d.name))
                    m.push_str("] toolchain = true`)")
                }
                return Err(m)
            }
            let loc = if p.len() > 0 && p[0] == 47 { fs.normalize(p) } else { fs.normalize(fs.join(base, p)) }
            Ok(Req(d.name, false, false, loc, none, false, d.grants, by))
        }
        manifest.Git(url, v, r) => {
            if r.len() > 0 { return Ok(Req(d.name, true, false, url, r, true, d.grants, by)) }
            Ok(Req(d.name, true, false, url, v, false, d.grants, by))
        }
        manifest.Toolchain => {
            Ok(Req(d.name, false, true, bytes.concat(sys.lit("packages/"), d.name), none, false, d.grants, by))
        }
    }
}

fn locked_commit(o: Opts, r: Req) -> Option[lockfile.Pkg] {
    if !o.use_lock { return None }
    for p in o.locked {
        if p.git && bytes.eq(p.name, r.name) && bytes.eq(p.loc, r.loc) && bytes.eq(p.want, r.want) && p.is_rev == r.is_rev {
            return Some(p)
        }
    }
    None
}

/// Offline, a version requirement that eider.lock doesn't pin is met by the locked version
/// of the same package when that one is higher: with an up-to-date lock MVS selects at least
/// that version anyway, and the lower version's manifest may only exist in a mirror we can't
/// reach. This is what lets `fetch --offline` work from .vendor/, which holds only the
/// selected versions.
fn settle(o: Opts, r: Req) -> Req {
    if !(o.use_lock && o.offline && r.git && !r.is_rev) { return r }
    // an overridden package is whatever its checkout holds
    if override.find(o.overrides, r.name).is_some() { return r }
    if locked_commit(o, r).is_some() { return r }
    for p in o.locked {
        if p.git && !p.is_rev && bytes.eq(p.name, r.name) && bytes.eq(p.loc, r.loc) {
            match (semver.parse(p.want), semver.parse(r.want)) {
                (Some(a), Some(b)) => {
                    if semver.compare(a, b) > 0 {
                        let mut s = r.copy()
                        s.want = p.want
                        return s
                    }
                }
                _ => {}
            }
        }
    }
    r
}

fn mismatch(what: str, name: List[u8], a: List[u8], b: List[u8]) -> String {
    let mut m = String.from(what)
    m.push_str(" `")
    m.append(text(name))
    m.push_str("`: ")
    m.append(text(a))
    m.push_str(" vs ")
    m.append(text(b))
    m
}

/// Fetch (if needed) and read one requirement's package.
fn visit(o: Opts, r: Req) -> Result[lockfile.Pkg, String] uses io, fs, net {
    let none: List[u8] = List.new()
    let mut dir = if r.tool { fs.join(o.toolchain, r.loc) } else { r.loc.copy() }
    let mut commit = none.copy()
    let mut hash = none.copy()
    let mut overridden = false
    if r.git && override.find(o.overrides, r.name).is_some() {
        // a local checkout stands in for the repository (override.ei)
        let src = override.find(o.overrides, r.name).unwrap()
        let ex = override.copy_in(o.home, r.name, src)?
        dir = ex.dir
        hash = ex.hash
        commit = override.head(src)
        for p in o.locked {
            if p.git && bytes.eq(p.name, r.name) && bytes.eq(p.loc, r.loc) && bytes.eq(p.hash, hash) { commit = p.commit }
        }
        if commit.len() == 0 { commit = sys.lit("override") }
        overridden = true
    } else if r.git {
        let pinned = locked_commit(o, r)
        commit = match pinned {
            Some(p) => p.commit
            None => store.resolve_commit(o.home, r.loc, r.want, r.is_rev, o.offline, !o.use_lock)?
        }
        let expect = match pinned {
            Some(p) => p.hash
            None => none
        }
        let vend = fs.join(o.vendor, r.name)
        if expect.len() > 0 && o.vendor.len() > 0 && fs.is_dir(vend) {
            let h = store.tree_hash(vend)?
            if !bytes.eq(h, expect) {
                return Err(mismatch(".vendor/ doesn't match eider.lock for", r.name, h, expect))
            }
            dir = vend
            hash = h
        } else {
            let ex = store.checkout(o.home, r.loc, commit, r.name, r.want, o.offline)?
            if expect.len() > 0 && !bytes.eq(ex.hash, expect) {
                return Err(mismatch("content hash differs from eider.lock for", r.name, ex.hash, expect))
            }
            dir = ex.dir
            hash = ex.hash
        }
    } else if r.tool && !fs.is_dir(dir) {
        let mut m = String.from("`")
        m.append(text(r.name))
        m.push_str("` is a package of the toolchain, but this one (")
        m.append(text(o.toolchain))
        m.push_str(") has no ")
        m.append(text(r.loc))
        m.push_str(": install a release (`eider toolchain install`) or use an eider-lang checkout")
        return Err(m)
    } else if !fs.is_dir(dir) {
        let mut m = String.from("path dependency `")
        m.append(text(r.name))
        m.push_str("` not found at ")
        m.append(text(dir))
        return Err(m)
    }
    let m = manifest.load(dir)?
    if !bytes.eq(m.name, r.name) {
        let mut e = String.from("dependency `")
        e.append(text(r.name))
        e.push_str("` points at the package `")
        e.append(text(m.name))
        e.push_str("` (the [deps.<name>] key must be the package's own name)")
        return Err(e)
    }
    if overridden && !r.is_rev {
        let older = match (semver.parse(m.version), semver.parse(r.want)) {
            (Some(a), Some(b)) => semver.compare(a, b) < 0
            _ => true
        }
        if older {
            let mut e = String.from("EIDER_PKG_OVERRIDE: the checkout of `")
            e.append(text(r.name))
            e.push_str("` has version ")
            e.append(text(m.version))
            e.push_str(", but ")
            e.append(text(r.want))
            e.push_str(" or later is required")
            return Err(e)
        }
    } else if r.git && !r.is_rev && !bytes.eq(m.version, r.want) {
        return Err(mismatch("the tag's eider.toml has a different version for", r.name, r.want, m.version))
    }
    let mut deps: List[List[u8]] = List.new()
    for d in m.deps { deps.push(d.name) }
    let grants: List[List[u8]] = List.new()
    Ok(lockfile.Pkg(r.name, m.version, r.git, r.tool, r.loc, r.want, r.is_rev, commit, hash, dir, deps, grants))
}

fn contains(xs: List[List[u8]], x: List[u8]) -> bool {
    for y in xs {
        if bytes.eq(x, y) { return true }
    }
    false
}

fn intersect(a: List[List[u8]], b: List[List[u8]]) -> List[List[u8]] {
    let mut out: List[List[u8]] = List.new()
    for x in a {
        if contains(b, x) { out.push(x) }
    }
    out
}

/// Pick, for `name`, the node to use: the highest version (or the one rev) among visited nodes.
fn select(nodes: List[lockfile.Pkg], name: List[u8]) -> Result[lockfile.Pkg, String] {
    let mut best: Option[lockfile.Pkg] = None
    for n in nodes {
        if bytes.eq(n.name, name) {
            best = match best {
                None => Some(n)
                Some(b) => {
                    if b.git != n.git || b.tool != n.tool || !bytes.eq(b.loc, n.loc) {
                        return Err(mismatch("two different packages are named", name, b.loc, n.loc))
                    }
                    if b.is_rev || n.is_rev {
                        if !(b.is_rev && n.is_rev && bytes.eq(b.want, n.want)) {
                            return Err(mismatch("conflicting requirements (pin one `rev` or use versions) for", name, b.want, n.want))
                        }
                        Some(b)
                    } else {
                        let bv = semver.parse(b.want)
                        let nv = semver.parse(n.want)
                        match (bv, nv) {
                            (Some(x), Some(y)) => {
                                if semver.compare(y, x) > 0 { Some(n) } else { Some(b) }
                            }
                            _ => Some(b)
                        }
                    }
                }
            }
        }
    }
    match best {
        Some(b) => Ok(b)
        None => Err(mismatch("internal: nothing selected for", name, name, name))
    }
}

/// The resolved graph: the packages to install (root itself excluded), with their grants, and
/// the requirement edges the grants come from (the root's have `from` "").
pub type Graph = { pkgs: List[lockfile.Pkg], edges: List[Edge] }

/// Resolve `root` into its graph.
pub fn resolve(root: manifest.Manifest, o: Opts) -> Result[Graph, String] uses io, fs, net {
    let none: List[u8] = List.new()
    let mut queue: List[Req] = List.new()
    for d in root.deps { queue.push(req_of(d, root.dir, none, false)?) }
    let mut nodes: List[lockfile.Pkg] = List.new()
    let mut edges: List[Edge] = List.new()
    let mut qi: usize = 0
    // edges hang off the requiring node, so pruned versions' requirements drop out later
    let mut from_keys: List[List[u8]] = List.new()
    for d in root.deps { from_keys.push(none) }
    while qi < queue.len() {
        let r = settle(o, queue[qi])
        let from = from_keys[qi]
        qi += 1
        edges.push(Edge(from, r.name, r.grants))
        let k = key(r.name, r.want)
        let mut seen = false
        for n in nodes {
            if bytes.eq(pkg_key(n), k) && bytes.eq(n.loc, r.loc) { seen = true }
        }
        if !seen {
            let p = visit(o, r)?
            let m = manifest.load(p.dir)?
            for d in m.deps {
                queue.push(req_of(d, p.dir, p.name, p.git)?)
                from_keys.push(k)
            }
            nodes.push(p)
        }
    }
    // walk the selected graph from the root
    let mut picked: List[lockfile.Pkg] = List.new()
    let mut frontier: List[List[u8]] = List.new()
    frontier.push(none)
    let mut fi: usize = 0
    while fi < frontier.len() {
        let from = frontier[fi].copy()
        fi += 1
        for e in edges {
            if bytes.eq(e.from, from) {
                let mut have = false
                for p in picked {
                    if bytes.eq(p.name, e.to) { have = true }
                }
                if !have {
                    let s = select(nodes, e.to)?
                    frontier.push(pkg_key(s))
                    picked.push(s)
                }
            }
        }
    }
    Ok(Graph(with_grants(picked, edges), edges))
}

/// Each picked package's grant: the intersection over the edges to it that come from the
/// root or a picked node.
fn with_grants(picked: List[lockfile.Pkg], edges: List[Edge]) -> List[lockfile.Pkg] {
    let mut out: List[lockfile.Pkg] = List.new()
    for p in picked {
        let mut g: Option[List[List[u8]]] = None
        for e in edges {
            if bytes.eq(e.to, p.name) {
                let mut live = e.from.len() == 0
                for q in picked {
                    if bytes.eq(pkg_key(q), e.from) { live = true }
                }
                if live {
                    g = match g {
                        None => Some(e.grants)
                        Some(cur) => Some(intersect(cur, e.grants))
                    }
                }
            }
        }
        let mut q = p.copy()
        q.grants = match g {
            Some(x) => x
            None => List.new()
        }
        out.push(q)
    }
    out
}

/// The graph with the root's grant to `name` replaced by `grants` (eider-pkg rewrote it).
pub fn regrant(g: Graph, name: List[u8], grants: List[List[u8]]) -> Graph {
    let mut edges: List[Edge] = List.new()
    for e in g.edges {
        let mut x = e.copy()
        if e.from.len() == 0 && bytes.eq(e.to, name) { x.grants = grants }
        edges.push(x)
    }
    Graph(with_grants(g.pkgs, edges), edges)
}

/// One package's capability use (caps.ei), every use with its first place: `reach`, what its
/// entry module reaches (what a depending library's program loads, held to the intersection
/// of the grants), and `every`, over all of its modules (what the root can import, and what
/// eider-pkg grants a direct dependency; `reach` for the others).
pub type PkgCaps = { name: List[u8], reach: List[caps.Use], every: List[caps.Use] }

/// What every package of the graph uses, as the compiler `eiderc` reports (caps.ei); the
/// root's dependencies (`direct`) get `every` too; `tmp` holds the probe programs.
pub fn all_caps(pkgs: List[lockfile.Pkg], direct: List[List[u8]], eiderc: List[u8], tmp: List[u8]) -> Result[List[PkgCaps], String] uses io, fs, net {
    let mut out: List[PkgCaps] = List.new()
    for p in pkgs {
        let mf = manifest.load(p.dir)?
        let entry = caps.modules(p.dir, mf.entry, mf.main, false)
        let reach = caps.of_package(eiderc, p.dir, entry, p.name, tmp)?
        let mut every = reach.copy()
        if grants.contains(direct, p.name) {
            let mods = caps.modules(p.dir, mf.entry, mf.main, true)
            if mods.len() > entry.len() { every = caps.of_package(eiderc, p.dir, mods, p.name, tmp)? }
        }
        out.push(PkgCaps(p.name, reach, every))
    }
    Ok(out)
}

/// Everything package `name` could use (`every`).
pub fn uses_of(cs: List[PkgCaps], name: List[u8]) -> List[caps.Use] {
    for c in cs {
        if bytes.eq(c.name, name) { return c.every }
    }
    List.new()
}

fn reach_of(cs: List[PkgCaps], name: List[u8]) -> List[caps.Use] {
    for c in cs {
        if bytes.eq(c.name, name) { return c.reach }
    }
    List.new()
}

/// The capability names in `uses`, distinct and sorted.
pub fn names(used: List[caps.Use]) -> List[List[u8]] {
    let mut out: List[List[u8]] = List.new()
    for u in used { out.push(u.cap) }
    grants.sorted(out)
}

/// `fs (fsdep.ei:5), ffi (ffidep.ei:1, extern: unmanaged code)`: where the package first
/// uses each of `wanted`.
pub fn places(used: List[caps.Use], wanted: List[List[u8]]) -> String {
    let mut parts: List[String] = List.new()
    for w in wanted {
        for u in used {
            if bytes.eq(u.cap, w) {
                let mut s = text(u.cap)
                s.push_str(" (")
                s.append(text(u.file))
                s.push_str(":")
                s.append(String.from_int(u.line as i64))
                if bytes.eq(u.kind, sys.lit("extern")) { s.push_str(", `extern` functions: unmanaged code") }
                if bytes.eq(u.kind, sys.lit("unsafe")) { s.push_str(", `unsafe` code: unmanaged code") }
                s.push_str(")")
                parts.push(s)
                break
            }
        }
    }
    let mut out = String.from("")
    for i in 0..parts.len() {
        if i > 0 { out.push_str(", ") }
        out.append(parts[i])
    }
    out
}

/// Every package must stay within its grants: what its entry module reaches (`cs`, from
/// all_caps; a direct dependency's whole use is held to the root's grant by the sync). The
/// error lists every capability missing from each package that needs more.
pub fn check_grants(pkgs: List[lockfile.Pkg], cs: List[PkgCaps]) -> Result[bool, String] {
    let mut m = String.from("")
    for p in pkgs {
        let used = reach_of(cs, p.name)
        let missing = grants.minus(names(used), p.grants)
        if missing.len() == 0 { continue }
        if m.len() > 0 { m.push_str("; ") }
        m.push_str("package `")
        m.append(text(p.name))
        m.push_str("` uses ")
        m.append(places(used, missing))
        m.push_str(" but is only granted [")
        m.append(text(bytes.join(p.grants, sys.lit(", "))))
        m.push_str("]; its dependers must grant it `uses = [")
        m.append(text(grants.quoted_list(grants.union(p.grants, missing))))
        m.push_str("]` in their [deps.")
        m.append(text(p.name))
        m.push_str("] table")
    }
    if m.len() > 0 { return Err(m) }
    Ok(true)
}

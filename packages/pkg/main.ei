//! eider-pkg: the Eider package manager.
//!
//!   eider-pkg [-C dir] init [name]
//!   eider-pkg [-C dir] add <name> (--path P | --git URL (--version V | --rev R)) [--uses a,b]
//!   eider-pkg [-C dir] remove <name>
//!   eider-pkg [-C dir] fetch [--offline]      resolve (keeping eider.lock pins), write eider.lock
//!   eider-pkg [-C dir] update [--offline]     re-resolve ignoring eider.lock
//!   eider-pkg [-C dir] vendor                 copy git packages into vendor/ (offline builds)
//!   eider-pkg [-C dir] tree                   print the locked graph
//!   eider-pkg hash <dir>                      content hash of a directory
//!   eider-pkg --version                       `eider-pkg <version>` (the toolchain's, VERSION)
//!
//! Only fetch/update/add/remove/vendor may touch the network: fetch and friends only when a
//! commit isn't already in the local mirror, update always refreshes the mirrors (tags can
//! move). Paths in arguments are relative to -C. Needs EIDER_ROOT (the toolchain checkout
//! with core/ and std/), and asks the compiler (EIDERC, default $EIDER_ROOT/target/eiderc)
//! what each package uses, to hold it to its grant (caps.ei).
//!
//! The compiler finds dependencies itself: `import "json"` goes through eider.lock to the
//! package's directory (a path package's own, vendor/<name>, or the store's
//! pkg/<name>-<hash16>; docs/compiler.md, "C8.3: packages and modules"). So fetch writes
//! eider.lock and fills the store, and links nothing: the deps/ link farm of earlier versions
//! is gone (a deps/ an earlier eider-pkg made, recognisable by its deps/.all, is removed).

import "core/sys"
import "core/version"
import "std/bytes"
import "std/fs"
import "std/io"
import "std/env"
import "manifest.ei"
import "lockfile.ei"
import "store.ei"
import "resolve.ei"
import "caps.ei"

type Cli = { dir: List[u8], cmd: List[u8], args: List[List[u8]], offline: bool }

fn is(a: List[u8], s: str) -> bool { bytes.eq(a, sys.lit(s)) }

fn say(s: str) uses io { io.outln(sys.lit(s)) }

fn usage() -> String {
    String.from("usage: eider-pkg [-C dir] (init [name] | add <name> --path P | add <name> --git URL --version V|--rev R [--uses a,b] | remove <name> | fetch [--offline] | update [--offline] | vendor | tree | hash <dir> | --version)")
}

fn parse_cli() -> Result[Cli, String] uses io, fs {
    let argv = env.args()
    let mut dir = fs.cwd()?
    let mut cmd: List[u8] = List.new()
    let mut rest: List[List[u8]] = List.new()
    let mut offline = false
    let mut i: usize = 1
    while i < argv.len() {
        let a = argv[i]
        if is(a, "-C") && i + 1 < argv.len() {
            dir = fs.absolute(argv[i + 1])?
            i += 2
            continue
        }
        // before a command only: `add --version V` is the dependency's version
        if is(a, "--version") && cmd.len() == 0 {
            let mut l = sys.lit("eider-pkg ")
            bytes.append(inout l, sys.lit(version.VERSION))
            io.outln(l)
            env.exit(0)
        }
        if is(a, "--offline") {
            offline = true
        } else if cmd.len() == 0 {
            cmd = a
        } else {
            rest.push(a)
        }
        i += 1
    }
    if cmd.len() == 0 { return Err(usage()) }
    Ok(Cli(dir, cmd, rest, offline))
}

fn toolchain() -> Result[List[u8], String] uses io, fs {
    match env.get(sys.lit("EIDER_ROOT")) {
        Some(r) => fs.absolute(r)
        None => Err(String.from("EIDER_ROOT is not set (it should point at the Eider checkout with core/ and std/; scripts/eider-pkg sets it)"))
    }
}

// ---- fetch / update / vendor

fn sync(c: Cli, use_lock: bool, offline: bool) -> Result[List[lockfile.Pkg], String] uses io, fs, net {
    sync_from(c, use_lock, offline, fs.join(c.dir, sys.lit("vendor")))
}

/// Resolve and write eider.lock. Pinned git packages come from `vendor` when it holds them
/// (an empty `vendor` means the store only).
fn sync_from(c: Cli, use_lock: bool, offline: bool, vendor: List[u8]) -> Result[List[lockfile.Pkg], String] uses io, fs, net {
    let root = manifest.load(c.dir)?
    toolchain()?
    let locked = lockfile.load(c.dir)?
    let o = resolve.Opts(store.home()?, offline, use_lock, locked, vendor)
    let pkgs = resolve.resolve(root, o)?
    resolve.check_grants(pkgs, caps.compiler(toolchain()?))?
    fs.write(lockfile.file_in(c.dir), lockfile.render(pkgs, c.dir))?
    // compatibility: the link farm an earlier eider-pkg made
    let deps = fs.join(c.dir, sys.lit("deps"))
    if fs.is_dir(fs.join(deps, sys.lit(".all"))) { fs.remove_all(deps)? }
    Ok(pkgs)
}

fn report(pkgs: List[lockfile.Pkg]) uses io {
    let mut l = sys.lit("locked ")
    bytes.append(inout l, bytes.from_u64(pkgs.len() as u64))
    bytes.append(inout l, sys.lit(" package(s)"))
    io.outln(l)
}

fn vendor(c: Cli) -> Result[bool, String] uses io, fs, net {
    // from the store, so a stale vendor/ is replaced rather than reported
    let none: List[u8] = List.new()
    let pkgs = sync_from(c, true, c.offline, none)?
    let vdir = fs.join(c.dir, sys.lit("vendor"))
    // drop what the graph no longer has
    if fs.is_dir(vdir) {
        for old in fs.list(vdir)? {
            let mut keep = false
            for p in pkgs {
                if p.git && bytes.eq(p.name, old) { keep = true }
            }
            if !keep { fs.remove_all(fs.join(vdir, old))? }
        }
    }
    for p in pkgs {
        if p.git {
            let dst = fs.join(vdir, p.name)
            if !bytes.eq(fs.normalize(p.dir), fs.normalize(dst)) {
                fs.remove_all(dst)?
                fs.copy_all(p.dir, dst, store.skipped())?
            }
        }
    }
    // resolve again from vendor/ alone: it must match eider.lock (the compiler reads it there)
    sync(c, true, true)?
    say("vendored git packages into vendor/")
    Ok(true)
}

// ---- manifest editing

fn add(c: Cli) -> Result[bool, String] uses io, fs, net {
    if c.args.len() < 1 { return Err(usage()) }
    let name = c.args[0]
    let file = manifest.file_in(c.dir)
    let before = fs.read(file)?
    let m = manifest.parse(before, file, c.dir)?
    for d in m.deps {
        if bytes.eq(d.name, name) {
            let mut e = String.from("`")
            e.append(sys.to_string(name))
            e.push_str("` is already a dependency")
            return Err(e)
        }
    }
    let mut table = sys.lit("\n[deps.")
    bytes.append(inout table, name)
    bytes.append(inout table, sys.lit("]\n"))
    let mut i: usize = 1
    while i < c.args.len() {
        let flag = c.args[i]
        if i + 1 >= c.args.len() { return Err(usage()) }
        let v = c.args[i + 1]
        let k = if is(flag, "--path") {
            sys.lit("path")
        } else if is(flag, "--git") {
            sys.lit("git")
        } else if is(flag, "--version") {
            sys.lit("version")
        } else if is(flag, "--rev") {
            sys.lit("rev")
        } else if is(flag, "--uses") {
            sys.lit("uses")
        } else {
            return Err(usage())
        }
        bytes.append(inout table, k)
        bytes.append(inout table, sys.lit(" = "))
        if is(flag, "--uses") {
            let mut quoted: List[List[u8]] = List.new()
            for cap in bytes.split(v, 44) {
                let t = bytes.trim(cap)
                if t.len() > 0 { quoted.push(manifest_quote(t)) }
            }
            table.push(91)
            bytes.append(inout table, bytes.join(quoted, sys.lit(", ")))
            table.push(93)
        } else {
            bytes.append(inout table, manifest_quote(v))
        }
        table.push(10)
        i += 2
    }
    let mut after = before.copy()
    if after.len() > 0 && after[after.len() - 1] != 10 { after.push(10) }
    bytes.append(inout after, table)
    manifest.parse(after, file, c.dir)?
    fs.write(file, after)?
    match sync(c, true, c.offline) {
        Ok(p) => {
            report(p)
            Ok(true)
        }
        Err(e) => {
            fs.write(file, before)?
            Err(e)
        }
    }
}

fn manifest_quote(s: List[u8]) -> List[u8] {
    let mut out: List[u8] = List.new()
    out.push(34)
    for c in s {
        if c == 34 || c == 92 { out.push(92) }
        out.push(c)
    }
    out.push(34)
    out
}

/// Drop the `[deps.<name>]` table: its header through the line before the next header.
fn remove(c: Cli) -> Result[bool, String] uses io, fs, net {
    if c.args.len() != 1 { return Err(usage()) }
    let name = c.args[0]
    let file = manifest.file_in(c.dir)
    let before = fs.read(file)?
    let mut header = sys.lit("[deps.")
    bytes.append(inout header, name)
    header.push(93)
    let mut kept: List[List[u8]] = List.new()
    let mut skipping = false
    let mut found = false
    for line in bytes.lines(before) {
        let t = bytes.trim(line)
        if t.len() > 0 && t[0] == 91 { skipping = bytes.eq(t, header) }
        if skipping {
            found = true
        } else {
            kept.push(line)
        }
    }
    if !found {
        let mut e = String.from("no [deps.")
        e.append(sys.to_string(name))
        e.push_str("] table in eider.toml (inline `name = { ... }` entries must be removed by hand)")
        return Err(e)
    }
    while kept.len() > 0 && kept[kept.len() - 1].len() == 0 { kept.pop() }
    let mut after = bytes.join(kept, sys.lit("\n"))
    after.push(10)
    manifest.parse(after, file, c.dir)?
    fs.write(file, after)?
    let pkgs = sync(c, true, c.offline)?
    report(pkgs)
    Ok(true)
}

fn init(c: Cli) -> Result[bool, String] uses io, fs {
    let file = manifest.file_in(c.dir)
    if fs.exists(file) { return Err(String.from("eider.toml already exists")) }
    let mut name = if c.args.len() > 0 { c.args[0] } else {
        match bytes.rfind_byte(c.dir, 47) {
            Some(i) => bytes.slice(c.dir, i + 1, c.dir.len())
            None => c.dir
        }
    }
    let mut clean: List[u8] = List.new()
    for ch in name {
        if ch >= 65 && ch <= 90 {
            clean.push(ch + 32)
        } else if bytes.is_ident(ch) {
            clean.push(ch)
        } else {
            clean.push(95)
        }
    }
    if !manifest.valid_name(clean) {
        return Err(String.from("can't derive a package name from the directory; pass one: eider-pkg init <name>"))
    }
    let mut t = sys.lit("[package]\nname = \"")
    bytes.append(inout t, clean)
    bytes.append(inout t, sys.lit("\"\nversion = \"0.1.0\"\nmain = \"main.ei\"\neider = \""))
    bytes.append(inout t, sys.lit(version.SERIES))
    bytes.append(inout t, sys.lit("\"\n"))
    fs.mkdir_all(c.dir)?
    fs.write(file, t)?
    let main_file = fs.join(c.dir, sys.lit("main.ei"))
    if !fs.exists(main_file) {
        fs.write(main_file, sys.lit("import \"core/sys\"\nimport \"std/io\"\n\nfn main() uses io {\n    io.outln(sys.lit(\"hello from eider\"))\n}\n"))?
    }
    let mut l = sys.lit("created package `")
    bytes.append(inout l, clean)
    l.push(96)
    io.outln(l)
    Ok(true)
}

fn tree(c: Cli) -> Result[bool, String] uses io, fs {
    let root = manifest.load(c.dir)?
    let pkgs = lockfile.load(c.dir)?
    let mut l = root.name.copy()
    l.push(32)
    bytes.append(inout l, root.version)
    io.outln(l)
    let mut seen: List[List[u8]] = List.new()
    for d in root.deps { tree_line(pkgs, d.name, 1, inout seen) }
    Ok(true)
}

fn tree_line(pkgs: List[lockfile.Pkg], name: List[u8], depth: usize, inout seen: List[List[u8]]) uses io {
    let mut l: List[u8] = List.new()
    for i in 0..depth {
        bytes.append(inout l, sys.lit("  "))
    }
    bytes.append(inout l, name)
    match lockfile.find(pkgs, name) {
        Some(p) => {
            l.push(32)
            bytes.append(inout l, p.version)
            if p.grants.len() > 0 {
                bytes.append(inout l, sys.lit(" uses "))
                bytes.append(inout l, bytes.join(p.grants, sys.lit(",")))
            }
            let mut dup = false
            for s in seen {
                if bytes.eq(s, name) { dup = true }
            }
            if dup {
                bytes.append(inout l, sys.lit(" (*)"))
                io.outln(l)
                return
            }
            seen.push(name)
            io.outln(l)
            for d in p.deps { tree_line(pkgs, d, depth + 1, inout seen) }
        }
        None => {
            bytes.append(inout l, sys.lit(" (not locked: run eider-pkg fetch)"))
            io.outln(l)
        }
    }
}

fn run(c: Cli) -> Result[bool, String] uses io, fs, net {
    if is(c.cmd, "init") { return init(c) }
    if is(c.cmd, "add") { return add(c) }
    if is(c.cmd, "remove") { return remove(c) }
    if is(c.cmd, "fetch") || is(c.cmd, "update") {
        let pkgs = sync(c, is(c.cmd, "fetch"), c.offline)?
        report(pkgs)
        return Ok(true)
    }
    if is(c.cmd, "vendor") { return vendor(c) }
    if is(c.cmd, "tree") { return tree(c) }
    if is(c.cmd, "hash") {
        if c.args.len() != 1 { return Err(usage()) }
        // relative to -C, like every other path the tool takes
        let a = c.args[0]
        let d = if a.len() > 0 && a[0] == 47 { fs.normalize(a) } else { fs.normalize(fs.join(c.dir, a)) }
        io.outln(store.tree_hash(d)?)
        return Ok(true)
    }
    Err(usage())
}

fn main() uses io, fs, net {
    let r: Result[bool, String] = match parse_cli() {
        Ok(c) => run(c)
        Err(e) => Err(e)
    }
    match r {
        Ok(_) => {}
        Err(e) => {
            // TODO(compiler): Strings can't reach stderr until they have byte access, so the
            // message goes to stdout. Exit status 1 still marks the failure.
            let mut m = String.from("eider-pkg: ")
            m.append(e)
            print(m)
            env.exit(1)
        }
    }
}

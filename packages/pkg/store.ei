//! store: the shared package store.
//!
//!   $EIDER_HOME (default ~/.eider)
//!     git/<url-as-name>/       bare mirror of each git source (the only network use)
//!     pkg/<name>-<hash16>/     an exported commit; immutable once written (re-hashed on each
//!                              use: a modified copy is an error, never silently reused)
//!     index/<commit>           the full content hash of that commit's export
//!     tmp/                     staging for exports
//!
//! The compiler reads this layout too (compiler/lock.ei `store_leaf`): a git package of a
//! project is vendor/<name> when that exists, else pkg/<name>-<hash16> here, the hash being
//! the one eider.lock records.

import "core/sys"
import "std/bytes"
import "std/fs"
import "std/env"
import "std/proc"
import "sha256.ei"

pub type Export = { dir: List[u8], hash: List[u8] }

pub fn home() -> Result[List[u8], String] uses io, fs {
    match env.get(sys.lit("EIDER_HOME")) {
        Some(h) => { return fs.absolute(h) }
        None => {}
    }
    match env.get(sys.lit("HOME")) {
        Some(h) => Ok(fs.join(h, sys.lit(".eider")))
        None => Err(String.from("set EIDER_HOME or HOME"))
    }
}

/// Names that never belong to a package's content.
pub fn skipped() -> List[List[u8]] {
    let mut s: List[List[u8]] = List.new()
    s.push(sys.lit(".git"))
    s.push(sys.lit("deps"))
    s.push(sys.lit("vendor"))
    s
}

/// sha256 over every file: `path NUL hex(sha256(content)) LF`, in sorted path order.
pub fn tree_hash(dir: List[u8]) -> Result[List[u8], String] uses fs {
    let s = sha256.new()
    let mut manifest: List[u8] = List.new()
    for rel in fs.walk(dir, skipped())? {
        let data = fs.read(fs.join(dir, rel))?
        bytes.append(inout manifest, rel)
        manifest.push(0)
        bytes.append(inout manifest, bytes.hex(sha256.digest(s, data)))
        manifest.push(10)
    }
    let mut out = sys.lit("sha256-")
    bytes.append(inout out, bytes.hex(sha256.digest(s, manifest)))
    Ok(out)
}

fn mirror_dir(home: List[u8], url: List[u8]) -> List[u8] {
    let mut name: List[u8] = List.new()
    for c in url {
        if bytes.is_ident(c) || c == 45 || c == 46 { name.push(c) } else { name.push(95) }
    }
    fs.join(fs.join(home, sys.lit("git")), name)
}

fn git(args: List[List[u8]]) -> Result[List[u8], String] uses io, fs, net {
    let mut argv: List[List[u8]] = List.new()
    argv.push(sys.lit("git"))
    for a in args { argv.push(a) }
    proc.check(argv)
}

fn a2(a: List[u8], b: List[u8]) -> List[List[u8]] {
    let mut l: List[List[u8]] = List.new()
    l.push(a)
    l.push(b)
    l
}

/// The commit `ref` names in the mirror, if any.
fn rev_parse(m: List[u8], r: List[u8]) -> Option[List[u8]] uses io, fs, net {
    if !fs.exists(m) { return None }
    let mut args = a2(sys.lit("-C"), m)
    args.push(sys.lit("rev-parse"))
    args.push(sys.lit("--verify"))
    args.push(sys.lit("--quiet"))
    let mut spec = r.copy()
    bytes.append(inout spec, sys.lit("^{commit}"))
    args.push(spec)
    let mut argv: List[List[u8]] = List.new()
    argv.push(sys.lit("git"))
    for a in args { argv.push(a) }
    match proc.output(argv) {
        Ok(o) => {
            if o.code != 0 { return None }
            Some(bytes.trim(o.out))
        }
        Err(_) => None
    }
}

fn candidates(want: List[u8], is_rev: bool) -> List[List[u8]] {
    let mut c: List[List[u8]] = List.new()
    if is_rev {
        c.push(want)
        return c
    }
    let mut v = sys.lit("refs/tags/v")
    bytes.append(inout v, want)
    c.push(v)
    let mut plain = sys.lit("refs/tags/")
    bytes.append(inout plain, want)
    c.push(plain)
    c
}

fn find_commit(m: List[u8], want: List[u8], is_rev: bool) -> Option[List[u8]] uses io, fs, net {
    for r in candidates(want, is_rev) {
        match rev_parse(m, r) {
            Some(c) => { return Some(c) }
            None => {}
        }
    }
    None
}

fn offline_error(url: List[u8], want: List[u8]) -> String {
    let mut e = String.from("offline: ")
    e.append(sys.to_string(url))
    e.push_str(" has no local copy of ")
    e.append(sys.to_string(want))
    e
}

/// Clone the mirror of `url`, or bring an existing one up to date (tags may have moved).
fn sync_mirror(home: List[u8], url: List[u8]) -> Result[bool, String] uses io, fs, net {
    let m = mirror_dir(home, url)
    if fs.exists(m) {
        let mut args = a2(sys.lit("-C"), m)
        args.push(sys.lit("fetch"))
        args.push(sys.lit("--quiet"))
        args.push(sys.lit("--prune"))
        args.push(sys.lit("--force"))
        args.push(sys.lit("origin"))
        git(args)?
    } else {
        fs.mkdir_all(fs.dirname(m))?
        let mut args = a2(sys.lit("clone"), sys.lit("--mirror"))
        args.push(sys.lit("--quiet"))
        args.push(url)
        args.push(m)
        git(args)?
    }
    Ok(true)
}

/// Find the commit for a version (tag `v<version>` or `<version>`) or rev. Clones or updates
/// the mirror only when the commit isn't already known locally (or when `refresh`, for
/// `update`, since tags can move), and never when `offline`.
pub fn resolve_commit(home: List[u8], url: List[u8], want: List[u8], is_rev: bool, offline: bool, refresh: bool) -> Result[List[u8], String] uses io, fs, net {
    let m = mirror_dir(home, url)
    if !refresh || offline {
        match find_commit(m, want, is_rev) {
            Some(c) => { return Ok(c) }
            None => {}
        }
        if offline { return Err(offline_error(url, want)) }
    }
    sync_mirror(home, url)?
    match find_commit(m, want, is_rev) {
        Some(c) => { return Ok(c) }
        None => {}
    }
    let mut e = String.from("")
    e.append(sys.to_string(url))
    if is_rev {
        e.push_str(" has no rev `")
    } else {
        e.push_str(" has no tag `v")
    }
    e.append(sys.to_string(want))
    e.push_str("`")
    Err(e)
}

/// The store directory for `commit` of `url`, exporting it on first use. A store directory
/// that no longer matches the hash recorded when it was exported is an error, never reused.
/// `want` (the version or rev asked for) is only for messages.
pub fn checkout(home: List[u8], url: List[u8], commit: List[u8], name: List[u8], want: List[u8], offline: bool) -> Result[Export, String] uses io, fs, net {
    let index = fs.join(fs.join(home, sys.lit("index")), commit)
    if fs.exists(index) {
        let h = bytes.trim(fs.read(index)?)
        let dir = store_dir(home, name, h)
        if fs.is_dir(dir) {
            let now = tree_hash(dir)?
            if !bytes.eq(now, h) {
                let mut e = String.from("the store copy of `")
                e.append(sys.to_string(name))
                e.push_str("` at ")
                e.append(sys.to_string(dir))
                e.push_str(" was modified (content hash ")
                e.append(sys.to_string(now))
                e.push_str(", exported as ")
                e.append(sys.to_string(h))
                e.push_str("); delete that directory and fetch again")
                return Err(e)
            }
            return Ok(Export(dir, h))
        }
    }
    // the commit may be pinned by eider.lock but missing from a new or deleted mirror
    let m = mirror_dir(home, url)
    if rev_parse(m, commit).is_none() {
        if offline { return Err(offline_error(url, want)) }
        sync_mirror(home, url)?
        if rev_parse(m, commit).is_none() {
            let mut e = String.from("")
            e.append(sys.to_string(url))
            e.push_str(" no longer has commit ")
            e.append(sys.to_string(commit))
            e.push_str(" (locked for `")
            e.append(sys.to_string(name))
            e.push_str("`); run `eider-pkg update`")
            return Err(e)
        }
    }
    let tmp = fs.join(fs.join(home, sys.lit("tmp")), commit)
    fs.remove_all(tmp)?
    fs.mkdir_all(tmp)?
    let mut tar = tmp.copy()
    bytes.append(inout tar, sys.lit(".tar"))
    let mut args = a2(sys.lit("-C"), mirror_dir(home, url))
    args.push(sys.lit("archive"))
    args.push(sys.lit("--format=tar"))
    args.push(sys.lit("-o"))
    args.push(tar)
    args.push(commit)
    git(args)?
    let mut untar: List[List[u8]] = List.new()
    untar.push(sys.lit("tar"))
    untar.push(sys.lit("-xf"))
    untar.push(tar)
    untar.push(sys.lit("-C"))
    untar.push(tmp)
    proc.check(untar)?
    fs.remove_all(tar)?
    let h = tree_hash(tmp)?
    let dir = store_dir(home, name, h)
    if fs.exists(dir) {
        fs.remove_all(tmp)?
    } else {
        fs.mkdir_all(fs.dirname(dir))?
        fs.rename(tmp, dir)?
    }
    fs.mkdir_all(fs.dirname(index))?
    fs.write(index, h)?
    Ok(Export(dir, h))
}

pub fn store_dir(home: List[u8], name: List[u8], hash: List[u8]) -> List[u8] {
    let mut leaf = name.copy()
    leaf.push(45)
    // "sha256-" is 7 bytes; keep 16 hex digits
    bytes.append(inout leaf, bytes.slice(hash, 7, 23))
    fs.join(fs.join(home, sys.lit("pkg")), leaf)
}

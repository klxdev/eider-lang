//! caps: which capabilities a package uses, as the compiler reports them, so a dependency
//! can be held to the `uses = [...]` it was granted in the depender's eider.toml.
//!
//! `eiderc caps <file>` loads the program at <file> and prints, per package it loads, every
//! capability the package uses with its first use, one JSON line each (docs/compiler.md,
//! "C8.5: capabilities per package"): the `uses` clauses of its functions, plus `ffi` when it
//! has unmanaged code (an `extern` function, an `unsafe fn` or block). A function's `uses`
//! clause is a sound over-approximation of what it can do, since the compiler rejects calls
//! needing a capability the caller didn't declare; and `ffi` doesn't propagate across
//! packages, so `uses ffi` written only to call std counts for nothing.
//!
//! `of_package` asks about a probe program that imports a package's modules by path. For a
//! direct dependency that is every module the depender could import (`import http.server` as
//! well as `import http`; `modules`: the package's `.ei` files, but not its `main` program,
//! test programs, examples, scripts, nested packages or hidden and build directories; not
//! comments either): that set is what eider-pkg grants. A dependency's dependency is held to
//! what its depender's program can reach from its entry module, since which of its modules
//! that library loads is the library's business. The compiler checks every import against its
//! grant again when it builds (E0204), for what the program really loads.

import core.sys
import std.bytes
import std.env
import std.fs
import std.proc

/// A capability the package uses, at its first use: the file (relative to the package's
/// directory) and line, and `kind`: `uses`, `extern` or `unsafe`.
pub type Use = { cap: List[u8], file: List[u8], line: u32, kind: List[u8] }

/// The compiler to ask: $EIDERC, else the toolchain's `target/eiderc`.
pub fn compiler(toolchain: List[u8]) -> List[u8] uses io {
    match env.get(sys.lit("EIDERC")) {
        Some(c) => { if c.len() > 0 { return c } }
        None => {}
    }
    fs.join(toolchain, sys.lit("target/eiderc"))
}

/// The string or number after `"key":` in a JSON line of `eiderc caps` (strings unescaped;
/// "" when the key is missing).
fn field(line: List[u8], key: str) -> List[u8] {
    let mut pat = sys.lit("\"")
    bytes.append(inout pat, sys.lit(key))
    bytes.append(inout pat, sys.lit("\":"))
    let mut out: List[u8] = List.new()
    let at = match bytes.find(line, pat, 0) {
        Some(i) => i + pat.len()
        None => { return out }
    }
    let mut i = at.copy()
    if i < line.len() && line[i] == 34 {
        i += 1
        while i < line.len() && line[i] != 34 {
            if line[i] == 92 && i + 1 < line.len() {
                i += 1
                let c = line[i]
                if c == 110 { out.push(10) } else if c == 116 { out.push(9) } else { out.push(c) }
            } else {
                out.push(line[i])
            }
            i += 1
        }
    } else {
        while i < line.len() && bytes.is_digit(line[i]) {
            out.push(line[i])
            i += 1
        }
    }
    out
}

/// Directories that hold no importable modules of the package.
fn skipped_dir(n: List[u8]) -> bool {
    if n.len() > 0 && n[0] == 46 { return true }
    let skip = ["target", "deps", "tests", "test", "examples", "bench", "benches", "scripts", "docs"]
    for i in 0..9 {
        if bytes.eq(n, sys.lit(skip[i as usize])) { return true }
    }
    false
}

fn walk(dir: List[u8], rel: List[u8], inout out: List[List[u8]]) uses fs {
    let names = match fs.list(dir) {
        Ok(l) => fs.sort(l)
        Err(_) => { return }
    }
    for n in names {
        let p = fs.join(dir, n)
        let r = if rel.len() == 0 { n.copy() } else { fs.join(rel, n) }
        if fs.is_dir(p) {
            // a directory with its own eider.toml is another package
            if !skipped_dir(n) && !fs.exists(fs.join(p, sys.lit("eider.toml"))) { walk(p, r, inout out) }
        } else if bytes.ends_with(n, sys.lit(".ei")) {
            out.push(r)
        }
    }
}

/// The package's modules, relative to `dir`: `entry` first (when it exists), then, when
/// `every`, every other `.ei` file a depender could import, but not the `main` program (which
/// counts only for a package that is nothing but a program).
pub fn modules(dir: List[u8], entry: List[u8], main: List[u8], every: bool) -> List[List[u8]] uses fs {
    let mut all: List[List[u8]] = List.new()
    if every { walk(dir, List.new(), inout all) }
    let mut out: List[List[u8]] = List.new()
    if fs.exists(fs.join(dir, entry)) { out.push(entry) }
    for m in all {
        if bytes.eq(m, entry) || bytes.eq(m, main) { continue }
        out.push(m)
    }
    if out.len() == 0 && main.len() > 0 && fs.exists(fs.join(dir, main)) { out.push(main) }
    out
}

fn path_literal(p: List[u8]) -> List[u8] {
    let mut out: List[u8] = List.new()
    out.push(34)
    for c in p {
        if c == 34 || c == 92 { out.push(92) }
        out.push(c)
    }
    out.push(34)
    out
}

/// The capabilities package `name` (in `dir`, with the modules `mods` from `modules`) uses,
/// as `eiderc` (the compiler at `eiderc`) reports for a probe program in `tmp` that imports
/// every module; none when it has no modules.
pub fn of_package(eiderc: List[u8], dir: List[u8], mods: List[List[u8]], name: List[u8], tmp: List[u8]) -> Result[List[Use], String] uses io, fs, net {
    let mut out: List[Use] = List.new()
    if mods.len() == 0 { return Ok(out) }
    let mut src: List[u8] = List.new()
    for m in mods {
        bytes.append(inout src, sys.lit("import "))
        bytes.append(inout src, path_literal(fs.join(dir, m)))
        src.push(10)
    }
    fs.mkdir_all(tmp)?
    let mut fname = sys.lit("caps-")
    bytes.append(inout fname, name)
    bytes.append(inout fname, sys.lit(".ei"))
    let file = fs.join(tmp, fname)
    fs.write(file, src)?
    let mut argv: List[List[u8]] = List.new()
    argv.push(eiderc)
    argv.push(sys.lit("caps"))
    argv.push(file)
    let r = proc.run_with(argv, proc.captured())?
    fs.remove_all(file)?
    if r.code != 0 {
        let mut m = String.from("cannot list the capabilities of package `")
        m.append(sys.to_string(name))
        m.push_str("`: `")
        m.append(sys.to_string(eiderc))
        m.push_str(" caps` failed (exit ")
        m.append(String.from_int(r.code as i64))
        m.push_str("; set EIDERC to an eiderc that has the `caps` command): ")
        m.append(sys.to_string(bytes.trim(r.err)))
        return Err(m)
    }
    for l in bytes.lines(r.out) {
        if !bytes.eq(field(l, "package"), name) { continue }
        let n: u32 = match bytes.parse_u64(field(l, "line")) {
            Some(x) => x as u32
            None => 0
        }
        out.push(Use(field(l, "cap"), field(l, "file"), n, field(l, "kind")))
    }
    Ok(out)
}

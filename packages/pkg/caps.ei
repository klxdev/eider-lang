// caps: which capabilities a package's code declares, so a dependency can be held to the
// `uses = [...]` it was granted in the depender's eider.toml.
//
// A function's `uses` clause is a sound over-approximation of what it can do: the compiler
// rejects calls that need a capability the caller didn't declare. So scanning every `uses`
// clause in a package bounds its reach.
//
// `ffi` is special until the compiler can hide std's internals: every caller of std has to
// write `uses ffi`, so it only counts when the package declares `extern` functions itself,
// i.e. when it brings its own unmanaged code.

import "../../core/sys.ei"
import "../../std/bytes.ei"
import "../../std/fs.ei"

pub type Use = { cap: List[u8], file: List[u8], line: u32 }

type Tok = { word: List[u8], line: u32 }

/// Identifier-like words and single punctuation bytes, skipping comments and strings.
fn words(src: List[u8]) -> List[Tok] {
    var out: List[Tok] = List.new()
    var i: usize = 0
    var line: u32 = 1
    let n = src.len()
    while i < n {
        let c = src[i]
        if c == 10 {
            line += 1
            i += 1
        } else if c == 47 && i + 1 < n && src[i + 1] == 47 {
            while i < n && src[i] != 10 { i += 1 }
        } else if c == 47 && i + 1 < n && src[i + 1] == 42 {
            i += 2
            while i + 1 < n && !(src[i] == 42 && src[i + 1] == 47) {
                if src[i] == 10 { line += 1 }
                i += 1
            }
            i += 2
        } else if c == 34 {
            i += 1
            while i < n && src[i] != 34 {
                if src[i] == 92 { i += 1 }
                i += 1
            }
            i += 1
        } else if bytes.is_ident(c) {
            var w: List[u8] = List.new()
            while i < n && bytes.is_ident(src[i]) {
                w.push(src[i])
                i += 1
            }
            out.push(Tok(w, line))
        } else {
            if !bytes.is_space(c) {
                var w: List[u8] = List.new()
                w.push(c)
                out.push(Tok(w, line))
            }
            i += 1
        }
    }
    out
}

/// The capabilities the compiler knows (check.ei's list); anything else in a `uses` clause
/// is a compile error.
fn language_cap(w: List[u8]) -> bool uses ffi {
    for c in ["io", "clock", "fs", "net", "threads", "ffi", "python", "js", "wasm"] {
        if bytes.eq(w, sys.lit(c)) { return true }
    }
    false
}

/// Every capability named in a `uses` clause, plus `ffi` when the code declares `extern`.
pub fn scan(src: List[u8], file: List[u8]) -> List[Use] uses ffi {
    let ws = words(src)
    var out: List[Use] = List.new()
    let k_uses = sys.lit("uses")
    let k_extern = sys.lit("extern")
    var i: usize = 0
    while i < ws.len() {
        if bytes.eq(ws[i].word, k_extern) {
            out.push(Use(sys.lit("ffi"), file, ws[i].line))
        } else if bytes.eq(ws[i].word, k_uses) {
            // the clause is the rest of the line, continued onto the next one only after a
            // comma: `uses clock` followed by `fn main()` on the next line names only clock
            var j = i + 1
            var line = ws[i].line
            var after_comma = false
            while j < ws.len() {
                let w = ws[j].word
                if ws[j].line != line && !after_comma { break }
                line = ws[j].line
                if w.len() == 1 && w[0] == 44 {
                    after_comma = true
                    j += 1
                } else if w.len() > 0 && bytes.is_alpha(w[0]) {
                    // a word that isn't a capability of the language can't grant anything
                    // (the compiler rejects it, E0203), e.g. in a compile-fail test
                    if !bytes.eq(w, sys.lit("ffi")) && language_cap(w) { out.push(Use(w, file, ws[j].line)) }
                    after_comma = false
                    j += 1
                } else {
                    break
                }
            }
            i = j - 1
        }
        i += 1
    }
    out
}

/// All capability uses in the package at `dir` (every .ei file, skipping deps/ and vendor/).
pub fn scan_dir(dir: List[u8], skip: List[List[u8]]) -> Result[List[Use], String] uses fs, ffi {
    var out: List[Use] = List.new()
    for rel in fs.walk(dir, skip)? {
        if bytes.ends_with(rel, sys.lit(".ei")) {
            let src = fs.read(fs.join(dir, rel))?
            for u in scan(src, rel) { out.push(u) }
        }
    }
    Ok(out)
}

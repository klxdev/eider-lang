//! manifest: read and validate eider.toml.
//!
//!   [package]
//!   name = "warehouse"          # [a-z][a-z0-9_]*, not `core` or `std`; what importers write
//!   version = "0.1.0"           # MAJOR.MINOR.PATCH
//!   entry = "warehouse.ei"      # what `import "warehouse"` loads (default <name>.ei);
//!                               # `import "warehouse/a/b"` loads a/b.ei
//!   main = "main.ei"            # program entry for run/build (optional)
//!   eider = "0.1"               # the toolchain MAJOR.MINOR it needs (optional; the
//!                               # compiler refuses another one, E0811)
//!
//!   [deps.json]                 # one table per dependency; the key must equal its package name
//!   git = "https://..."         #   either git + (version | rev) ...
//!   version = "1.2.0"           #   minimum version; tag v1.2.0 (or 1.2.0)
//!   path = "../geom"            #   ... or a local directory
//!   uses = ["io", "fs"]         #   capabilities granted to the dependency (default: none);
//!                               #   eider-pkg writes it (grants.ei)
//!
//!   [policy]                    # optional: what this package may grant its dependencies
//!   deny = ["ffi"]              #   never granted to any dependency
//!   [policy.allow]
//!   net = ["http", "rpc"]       #   only these dependencies may be granted `net`

import core.sys
import std.bytes
import std.fs
import toml
import pkg.semver

pub type Source = | Path(dir: List[u8]) | Git(url: List[u8], version: List[u8], rev: List[u8]) | Toolchain

pub type Dep = { name: List[u8], source: Source, grants: List[List[u8]], line: u32 }

/// `[policy.allow] <cap> = [pkgs]`: only `pkgs` may be granted `cap`.
pub type Allow = { cap: List[u8], pkgs: List[List[u8]], line: u32 }

/// `[policy]`: capabilities never granted (`deny`), and ones granted only to some packages.
pub type Policy = { deny: List[List[u8]], deny_line: u32, allow: List[Allow] }

pub type Manifest = { name: List[u8], version: List[u8], entry: List[u8], main: List[u8], deps: List[Dep], dir: List[u8], policy: Policy }

pub fn file_in(dir: List[u8]) -> List[u8] { fs.join(dir, sys.lit("eider.toml")) }

pub fn at(file: List[u8], line: u32, col: u32, m: String) -> String {
    let mut s = sys.to_string(file)
    s.push_str(":")
    s.append(String.from_int(line as i64))
    s.push_str(":")
    s.append(String.from_int(col as i64))
    s.push_str(": ")
    s.append(m)
    s
}

fn bad(file: List[u8], line: u32, m: str) -> String { at(file, line, 1, String.from(m)) }

/// `core` and `std`: the toolchain's packages, which every file imports by name
/// (`import "std/fs"`) and no manifest declares (their eider.toml files are the compiler's,
/// never loaded here).
pub fn toolchain_name(n: List[u8]) -> bool { bytes.eq(n, sys.lit("core")) || bytes.eq(n, sys.lit("std")) }

/// The packages a toolchain ships besides `core` and `std`, under its `packages/`, which a
/// manifest names with `[deps.<name>] toolchain = true` (resolve.ei): their code and the
/// library they link (crypto's backend) are the toolchain's, versioned with it.
pub fn shipped_names() -> List[List[u8]] {
    let mut out: List[List[u8]] = List.new()
    out.push(sys.lit("crypto"))
    out
}

pub fn shipped(n: List[u8]) -> bool {
    for x in shipped_names() {
        if bytes.eq(n, x) { return true }
    }
    false
}

pub fn valid_name(n: List[u8]) -> bool {
    if n.len() == 0 { return false }
    if !(n[0] >= 97 && n[0] <= 122) { return false }
    for c in n {
        if !((c >= 97 && c <= 122) || bytes.is_digit(c) || c == 95) { return false }
    }
    true
}

/// MAJOR.MINOR (`eider = "0.1"`): two runs of digits joined by one `.`.
pub fn valid_series(v: List[u8]) -> bool {
    let mut dots = 0
    let mut run = 0
    for c in v {
        if c == 46 {
            if run == 0 { return false }
            dots += 1
            run = 0
        } else if bytes.is_digit(c) {
            run += 1
        } else {
            return false
        }
    }
    dots == 1 && run > 0
}

pub fn known_cap(c: List[u8]) -> bool {
    let caps = ["io", "clock", "fs", "net", "threads", "ffi"]
    for i in 0..6 {
        if bytes.eq(c, sys.lit(caps[i as usize])) { return true }
    }
    false
}

fn str_at(doc: List[toml.Entry], file: List[u8], k: List[u8]) -> Result[Option[List[u8]], String] {
    match toml.get(doc, k) {
        Some(e) => {
            match e.val {
                toml.Str(s) => Ok(Some(s))
                _ => {
                    let mut m = String.from("`")
                    m.append(sys.to_string(k))
                    m.push_str("` must be a string")
                    Err(at(file, e.line, 1, m))
                }
            }
        }
        None => Ok(None)
    }
}

/// The line of key `k`, or `dflt` when it's absent.
fn line_of(doc: List[toml.Entry], k: List[u8], dflt: u32) -> u32 {
    match toml.get(doc, k) {
        Some(e) => e.line
        None => dflt
    }
}

fn key(a: str, b: List[u8], c: str) -> List[u8] {
    let mut k = sys.lit(a)
    bytes.append(inout k, b)
    bytes.append(inout k, sys.lit(c))
    k
}

/// Parse eider.toml text. `file` is used in messages, `dir` is the manifest's directory.
pub fn parse(src: List[u8], file: List[u8], dir: List[u8]) -> Result[Manifest, String] {
    let doc = match toml.parse(src) {
        Ok(d) => d
        Err(e) => { return Err(at(file, e.line, e.col, e.msg)) }
    }
    // every key must be one we know: catches typos like `verison`
    // crypto.provider: the backend scripts/crypto-build.sh links (packages/crypto, core/crypto/README.md)
    let top_ok = ["package.name", "package.version", "package.entry", "package.main", "package.description", "package.eider", "crypto.provider"]
    let dep_ok = ["path", "git", "version", "rev", "uses", "toolchain"]
    for e in doc {
        let mut ok = false
        for i in 0..7 {
            if bytes.eq(e.key, sys.lit(top_ok[i as usize])) { ok = true }
        }
        if bytes.eq(e.key, sys.lit("policy.deny")) { ok = true }
        if bytes.starts_with(e.key, sys.lit("policy.allow.")) { ok = true }
        // [lints]: `name = "allow" | "warn" | "deny"` (eiderc lint; compiler/lint.ei, which judges the names)
        if bytes.starts_with(e.key, sys.lit("lints.")) {
            match e.val {
                toml.Str(_) => { ok = true }
                _ => {
                    let mut m = String.from("`")
                    m.append(sys.to_string(e.key))
                    m.push_str("` must be a string: \"allow\", \"warn\" or \"deny\"")
                    return Err(at(file, e.line, 1, m))
                }
            }
        }
        if !ok && bytes.starts_with(e.key, sys.lit("deps.")) {
            let rest = bytes.slice(e.key, 5, e.key.len())
            match bytes.find_byte(rest, 46, 0) {
                Some(dot) => {
                    let field = bytes.slice(rest, dot + 1, rest.len())
                    for i in 0..6 {
                        if bytes.eq(field, sys.lit(dep_ok[i as usize])) { ok = true }
                    }
                }
                None => {}
            }
        }
        if !ok {
            let mut m = String.from("unknown key `")
            m.append(sys.to_string(e.key))
            m.push_str("`")
            return Err(at(file, e.line, 1, m))
        }
    }
    let name = match str_at(doc, file, sys.lit("package.name"))? {
        Some(n) => n
        None => { return Err(bad(file, 1, "missing `name` in [package]")) }
    }
    if !valid_name(name) {
        let line = match toml.get(doc, sys.lit("package.name")) {
            Some(e) => e.line
            None => 1 as u32
        }
        return Err(bad(file, line, "package names are lowercase letters, digits and `_`, starting with a letter"))
    }
    if toolchain_name(name) {
        return Err(bad(file, line_of(doc, sys.lit("package.name"), 1), "`core` and `std` are the toolchain's packages; pick another name"))
    }
    let version = match str_at(doc, file, sys.lit("package.version"))? {
        Some(v) => v
        None => { return Err(bad(file, 1, "missing `version` in [package]")) }
    }
    if semver.parse(version).is_none() {
        return Err(bad(file, line_of(doc, sys.lit("package.version"), 1), "`version` must be MAJOR.MINOR.PATCH, e.g. \"0.1.0\""))
    }
    match str_at(doc, file, sys.lit("package.eider"))? {
        Some(v) => {
            if !valid_series(v) {
                return Err(bad(file, line_of(doc, sys.lit("package.eider"), 1), "`eider` is the toolchain MAJOR.MINOR the package needs, e.g. \"0.1\""))
            }
        }
        None => {}
    }
    let entry = match str_at(doc, file, sys.lit("package.entry"))? {
        Some(e) => e
        None => bytes.concat(name, sys.lit(".ei"))
    }
    let none: List[u8] = List.new()
    let main = match str_at(doc, file, sys.lit("package.main"))? {
        Some(m) => m
        None => none
    }
    let mut deps: List[Dep] = List.new()
    for dn in toml.children(doc, sys.lit("deps")) {
        let line = match toml.get(doc, key("deps.", dn, ".path")) {
            Some(e) => e.line
            None => match toml.get(doc, key("deps.", dn, ".git")) {
                Some(e) => e.line
                None => 1 as u32
            }
        }
        if !valid_name(dn) { return Err(bad(file, line, "dependency names are lowercase letters, digits and `_`")) }
        if toolchain_name(dn) {
            let mut m = String.from("`")
            m.append(sys.to_string(dn))
            m.push_str("` is part of the toolchain: import its modules (`import ")
            m.append(sys.to_string(dn))
            m.push_str(".<module>`) without declaring it")
            return Err(at(file, line, 1, m))
        }
        if bytes.eq(dn, name) { return Err(bad(file, line, "a package can't depend on itself")) }
        let path = str_at(doc, file, key("deps.", dn, ".path"))?
        let git = str_at(doc, file, key("deps.", dn, ".git"))?
        let ver = str_at(doc, file, key("deps.", dn, ".version"))?
        let rev = str_at(doc, file, key("deps.", dn, ".rev"))?
        let mut grants: List[List[u8]] = List.new()
        match toml.get(doc, key("deps.", dn, ".uses")) {
            Some(e) => {
                match e.val {
                    toml.Strs(items) => {
                        for c in items {
                            if !known_cap(c) {
                                let mut m = String.from("unknown capability `")
                                m.append(sys.to_string(c))
                                m.push_str("` (known: io, clock, fs, net, threads, ffi)")
                                return Err(at(file, e.line, 1, m))
                            }
                            grants.push(c)
                        }
                    }
                    _ => { return Err(bad(file, e.line, "`uses` must be an array of capability names")) }
                }
            }
            None => {}
        }
        let mut tool = false
        match toml.get(doc, key("deps.", dn, ".toolchain")) {
            Some(e) => {
                match e.val {
                    toml.Bool(b) => { tool = b }
                    _ => { return Err(bad(file, e.line, "`toolchain` must be true (or left out)")) }
                }
            }
            None => {}
        }
        if tool {
            if path.is_some() || git.is_some() || ver.is_some() || rev.is_some() {
                return Err(bad(file, line, "a toolchain dependency takes no `path`, `git`, `version` or `rev`: the package comes with the toolchain"))
            }
            if !shipped(dn) {
                let mut m = String.from("`")
                m.append(sys.to_string(dn))
                m.push_str("` is not a package this toolchain ships (")
                m.append(sys.to_string(bytes.join(shipped_names(), sys.lit(", "))))
                m.push_str(")")
                return Err(at(file, line, 1, m))
            }
        }
        let source = if tool { Toolchain } else { match (path, git) {
            (Some(p), None) => {
                if ver.is_some() || rev.is_some() { return Err(bad(file, line, "a path dependency takes no `version` or `rev`")) }
                Path(p)
            }
            (None, Some(g)) => {
                match (ver, rev) {
                    (Some(v), None) => {
                        if semver.parse(v).is_none() { return Err(bad(file, line_of(doc, key("deps.", dn, ".version"), line), "`version` must be MAJOR.MINOR.PATCH")) }
                        Git(g, v, none)
                    }
                    (None, Some(r)) => Git(g, none, r)
                    (None, None) => { return Err(bad(file, line, "a git dependency needs `version` (a minimum) or `rev`")) }
                    _ => { return Err(bad(file, line, "give either `version` or `rev`, not both")) }
                }
            }
            (None, None) => { return Err(bad(file, line, "a dependency needs `path`, `git` or `toolchain = true`")) }
            _ => { return Err(bad(file, line, "give either `path` or `git`, not both")) }
        } }
        deps.push(Dep(dn, source, grants, line))
    }
    Ok(Manifest(name, version, entry, main, deps, dir, policy_of(doc, file)?))
}

fn caps_list(e: toml.Entry, file: List[u8], what: str) -> Result[List[List[u8]], String] {
    match e.val {
        toml.Strs(items) => {
            for c in items {
                if !known_cap(c) {
                    let mut m = String.from("unknown capability `")
                    m.append(sys.to_string(c))
                    m.push_str("` (known: io, clock, fs, net, threads, ffi)")
                    return Err(at(file, e.line, 1, m))
                }
            }
            Ok(items)
        }
        _ => Err(bad(file, e.line, what))
    }
}

/// `[policy]`: `deny = [caps]` and `[policy.allow] <cap> = [packages]`.
fn policy_of(doc: List[toml.Entry], file: List[u8]) -> Result[Policy, String] {
    let mut p = Policy(List.new(), 0, List.new())
    match toml.get(doc, sys.lit("policy.deny")) {
        Some(e) => {
            p.deny = caps_list(e, file, "`deny` in [policy] must be an array of capability names")?
            p.deny_line = e.line
        }
        None => {}
    }
    for e in doc {
        if !bytes.starts_with(e.key, sys.lit("policy.allow.")) { continue }
        let cap = bytes.slice(e.key, 13, e.key.len())
        if !known_cap(cap) {
            let mut m = String.from("unknown capability `")
            m.append(sys.to_string(cap))
            m.push_str("` in [policy.allow] (known: io, clock, fs, net, threads, ffi)")
            return Err(at(file, e.line, 1, m))
        }
        match e.val {
            toml.Strs(items) => {
                for n in items {
                    if !valid_name(n) {
                        let mut m = String.from("[policy.allow] lists package names; `")
                        m.append(sys.to_string(n))
                        m.push_str("` isn't one")
                        return Err(at(file, e.line, 1, m))
                    }
                }
                p.allow.push(Allow(cap, items, e.line))
            }
            _ => { return Err(bad(file, e.line, "[policy.allow] entries are `<capability> = [\"package\", ...]`")) }
        }
    }
    Ok(p)
}

pub fn load(dir: List[u8]) -> Result[Manifest, String] uses fs {
    let file = file_in(dir)
    let src = fs.read(file)?
    parse(src, file, dir)
}

//! The site's one stylesheet and its scripts, written by eider-doc next to the pages. No
//! fonts, frameworks or CDNs: system fonts, CSS variables for the light and dark themes
//! (`prefers-color-scheme`, overridden by the toggle through `data-theme` on `<html>`), and a
//! search that filters the index in `search-index.js`.

import "std/bytes"

/// style.css.
pub fn css() -> List[u8] {
    let mut out: List[u8] = List.new()
    for l in [
        ":root {",
        "  --bg: #ffffff; --fg: #1d2129; --muted: #5c6370; --line: #e3e6ea; --side: #f6f7f9;",
        "  --link: #1a5fb4; --code-bg: #f3f4f6; --accent: #0b7285; --kw: #8839ef; --ty: #b35900;",
        "  --st: #2a7e19; --nu: #b4235a; --co: #6b7280; --note: #1a5fb4; --warn: #b35900; --tip: #2a7e19;",
        "  --mark: #fff3bf;",
        "  color-scheme: light;",
        "}",
        "@media (prefers-color-scheme: dark) {",
        "  :root:not([data-theme='light']) {",
        "    --bg: #16181d; --fg: #dde1e6; --muted: #9aa3ae; --line: #2c3038; --side: #1c1f25;",
        "    --link: #7ab0ff; --code-bg: #20242b; --accent: #4fc1d0; --kw: #c49bff; --ty: #f0a95c;",
        "    --st: #8fd17a; --nu: #ff8fb3; --co: #8b94a1; --note: #7ab0ff; --warn: #f0a95c; --tip: #8fd17a;",
        "    --mark: #4a3f00;",
        "    color-scheme: dark;",
        "  }",
        "}",
        ":root[data-theme='dark'] {",
        "  --bg: #16181d; --fg: #dde1e6; --muted: #9aa3ae; --line: #2c3038; --side: #1c1f25;",
        "  --link: #7ab0ff; --code-bg: #20242b; --accent: #4fc1d0; --kw: #c49bff; --ty: #f0a95c;",
        "  --st: #8fd17a; --nu: #ff8fb3; --co: #8b94a1; --note: #7ab0ff; --warn: #f0a95c; --tip: #8fd17a;",
        "  --mark: #4a3f00;",
        "  color-scheme: dark;",
        "}",
        "* { box-sizing: border-box; }",
        "html { -webkit-text-size-adjust: 100%; }",
        "body { margin: 0; background: var(--bg); color: var(--fg);",
        "  font: 16px/1.6 system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; }",
        "a { color: var(--link); text-decoration: none; }",
        "a:hover { text-decoration: underline; }",
        "code, pre, kbd, .sig { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace; font-size: 0.9em; }",
        "header.top { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: 12px;",
        "  height: 52px; padding: 0 16px; background: var(--bg); border-bottom: 1px solid var(--line); }",
        "header.top .brand { font-weight: 700; font-size: 1.1em; color: var(--fg); white-space: nowrap; }",
        "header.top button { background: none; border: 1px solid var(--line); border-radius: 6px; color: var(--fg);",
        "  font-size: 1em; padding: 4px 10px; cursor: pointer; }",
        "header.top .menu { display: none; }",
        ".search { position: relative; flex: 1; max-width: 480px; margin-left: auto; }",
        ".search input { width: 100%; padding: 6px 10px; border: 1px solid var(--line); border-radius: 6px;",
        "  background: var(--side); color: var(--fg); font: inherit; }",
        ".search ol { display: none; position: absolute; left: 0; right: 0; top: 40px; margin: 0; padding: 4px 0;",
        "  list-style: none; background: var(--bg); border: 1px solid var(--line); border-radius: 6px;",
        "  max-height: 70vh; overflow-y: auto; box-shadow: 0 6px 24px rgba(0,0,0,0.15); }",
        ".search ol.open { display: block; }",
        ".search li a { display: block; padding: 4px 12px; color: var(--fg); }",
        ".search li a:hover, .search li.sel a { background: var(--side); text-decoration: none; }",
        ".search li .k { color: var(--muted); font-size: 0.8em; margin-right: 6px; }",
        ".search li .s { display: block; color: var(--muted); font-size: 0.85em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }",
        ".layout { display: flex; align-items: flex-start; max-width: 1440px; margin: 0 auto; }",
        "nav.side { position: sticky; top: 52px; width: 270px; flex: none; height: calc(100vh - 52px); overflow-y: auto;",
        "  padding: 16px 12px 40px 16px; background: var(--side); border-right: 1px solid var(--line); font-size: 0.92em; }",
        "nav.side h2 { font-size: 0.78em; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin: 18px 0 4px; }",
        "nav.side ul { list-style: none; margin: 0; padding-left: 0; }",
        "nav.side ul ul { padding-left: 14px; }",
        "nav.side a { display: block; padding: 2px 6px; border-radius: 4px; color: var(--fg); }",
        "nav.side a[aria-current='page'] { background: var(--bg); color: var(--accent); font-weight: 600; }",
        "main { flex: 1; min-width: 0; padding: 24px 40px 80px; max-width: 900px; }",
        "aside.toc { position: sticky; top: 52px; width: 230px; flex: none; max-height: calc(100vh - 52px); overflow-y: auto;",
        "  padding: 24px 16px; font-size: 0.85em; }",
        "aside.toc h2 { font-size: 0.78em; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin: 0 0 6px; }",
        "aside.toc ul { list-style: none; margin: 0; padding: 0; }",
        "aside.toc li.l3 { padding-left: 12px; }",
        "aside.toc a { color: var(--muted); }",
        "h1 { font-size: 2em; line-height: 1.25; margin: 0.2em 0 0.6em; }",
        "h2 { font-size: 1.45em; margin: 1.8em 0 0.6em; padding-bottom: 0.2em; border-bottom: 1px solid var(--line); }",
        "h3 { font-size: 1.15em; margin: 1.5em 0 0.5em; }",
        "h4 { font-size: 1em; margin: 1.2em 0 0.4em; }",
        "h1, h2, h3, h4 { scroll-margin-top: 64px; }",
        "p, ul, ol, table, pre, blockquote { margin: 0 0 1em; }",
        "li > p { margin: 0 0 0.4em; }",
        ":not(pre) > code { background: var(--code-bg); padding: 0.1em 0.35em; border-radius: 4px; }",
        "pre { background: var(--code-bg); padding: 12px 14px; border-radius: 6px; overflow-x: auto; line-height: 1.45; }",
        "pre code { font-size: 1em; }",
        "blockquote { margin-left: 0; padding: 4px 16px; border-left: 4px solid var(--line); color: var(--muted); }",
        "blockquote.callout { color: var(--fg); background: var(--side); border-radius: 0 6px 6px 0; }",
        "blockquote.note { border-left-color: var(--note); }",
        "blockquote.warning { border-left-color: var(--warn); }",
        "blockquote.tip { border-left-color: var(--tip); }",
        "table { border-collapse: collapse; display: block; overflow-x: auto; }",
        "th, td { border: 1px solid var(--line); padding: 6px 10px; vertical-align: top; }",
        "th { background: var(--side); }",
        "hr { border: none; border-top: 1px solid var(--line); margin: 2em 0; }",
        "img { max-width: 100%; }",
        ".kw { color: var(--kw); } .ty { color: var(--ty); } .st { color: var(--st); } .nu { color: var(--nu); } .co { color: var(--co); font-style: italic; }",
        ".crumbs { color: var(--muted); font-size: 0.9em; }",
        ".summary { color: var(--muted); }",
        ".item { margin: 0 0 2em; }",
        ".item > h3, .member > h4 { display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }",
        ".sig { display: block; flex: 1; background: var(--code-bg); padding: 8px 12px; border-radius: 6px; overflow-x: auto;",
        "  white-space: pre; font-weight: 400; line-height: 1.45; }",
        ".src { font-size: 0.8em; font-weight: 400; }",
        ".member { margin: 0 0 1em 20px; }",
        ".member .sig { font-size: 0.85em; }",
        ".doc { margin: 8px 0 0 4px; }",
        ".member .doc { margin-left: 4px; }",
        ".caps { color: var(--muted); font-size: 0.85em; }",
        "details.impl > summary { cursor: pointer; font-family: ui-monospace, monospace; font-size: 0.9em; padding: 4px 0; }",
        "dl.index { display: grid; grid-template-columns: minmax(140px, max-content) 1fr; gap: 4px 16px; }",
        "dl.index dt { font-family: ui-monospace, monospace; font-size: 0.9em; }",
        "dl.index dd { margin: 0; color: var(--muted); }",
        ".cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }",
        ".card { border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; }",
        ".card h3 { margin: 0 0 6px; font-size: 1em; }",
        ".card ul { margin: 0; padding-left: 18px; font-size: 0.92em; }",
        "pre.source { padding: 0; counter-reset: none; }",
        "pre.source .line:target .ln { color: var(--accent); }",
        "pre.source .line:target { background: var(--mark); }",
        "pre.source .ln { display: inline-block; width: 4.5em; padding-right: 1em; text-align: right; color: var(--muted); user-select: none; }",
        "footer { color: var(--muted); font-size: 0.85em; text-align: center; padding: 24px; border-top: 1px solid var(--line); }",
        "@media (max-width: 1100px) { aside.toc { display: none; } }",
        "@media (max-width: 800px) {",
        "  header.top .menu { display: inline-block; }",
        "  nav.side { display: none; position: fixed; top: 52px; left: 0; bottom: 0; z-index: 9; width: 85vw; max-width: 320px; height: auto; }",
        "  body.nav-open nav.side { display: block; }",
        "  main { padding: 16px 16px 60px; }",
        "  dl.index { grid-template-columns: 1fr; }",
        "  dl.index dd { margin-bottom: 8px; }",
        "}",
    ] {
        bytes.append(inout out, l.bytes())
        out.push(10)
    }
    out
}

/// The script in every page's `<head>`: the stored theme, before the page is drawn.
pub fn theme_js() -> List[u8] {
    "(function(){try{var t=localStorage.getItem('eider-theme');if(t)document.documentElement.setAttribute('data-theme',t)}catch(e){}})();".bytes()
}

/// The script at the end of every page: the theme toggle, the menu, and the search over
/// `window.EIDER_INDEX` (search-index.js): entries `[name, kind, path, summary, url]`.
pub fn page_js() -> List[u8] {
    let mut out: List[u8] = List.new()
    for l in [
        "(function(){",
        "var root=document.body.getAttribute('data-root')||'';",
        "var de=document.documentElement;",
        "var tb=document.querySelector('.theme');",
        "if(tb)tb.addEventListener('click',function(){",
        "  var cur=de.getAttribute('data-theme');",
        "  if(!cur)cur=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';",
        "  var next=cur==='dark'?'light':'dark';",
        "  de.setAttribute('data-theme',next);",
        "  try{localStorage.setItem('eider-theme',next)}catch(e){}",
        "});",
        "var mb=document.querySelector('.menu');",
        "if(mb)mb.addEventListener('click',function(){document.body.classList.toggle('nav-open')});",
        "var q=document.getElementById('q'),ol=document.getElementById('results'),sel=0,hits=[];",
        "if(!q)return;",
        "function esc(s){return s.replace(/[&<>\"']/g,function(c){return '&#'+c.charCodeAt(0)+';'})}",
        "function show(){",
        "  var idx=window.EIDER_INDEX||[],t=q.value.trim().toLowerCase();",
        "  hits=[];",
        "  if(!t){ol.className='';ol.innerHTML='';return}",
        "  for(var i=0;i<idx.length;i++){",
        "    var e=idx[i],n=e[0].toLowerCase(),full=(e[2]+'.'+e[0]).toLowerCase(),r=-1;",
        "    if(n===t)r=0;else if(n.indexOf(t)===0)r=1;else if(full.indexOf(t)>=0)r=2;",
        "    else if(e[3].toLowerCase().indexOf(t)>=0)r=3;",
        "    if(r>=0)hits.push([r,n.length,i]);",
        "  }",
        "  hits.sort(function(a,b){return a[0]-b[0]||a[1]-b[1]||a[2]-b[2]});",
        "  hits=hits.slice(0,30);",
        "  sel=0;",
        "  var h='';",
        "  for(var j=0;j<hits.length;j++){",
        "    var e=idx[hits[j][2]];",
        "    h+='<li'+(j===sel?' class=\"sel\"':'')+'><a href=\"'+esc(root+e[4])+'\"><span class=\"k\">'+esc(e[1])+'</span>'+esc(e[2]?e[2]+'.'+e[0]:e[0])+'<span class=\"s\">'+esc(e[3])+'</span></a></li>';",
        "  }",
        "  if(!hits.length)h='<li><a>No results</a></li>';",
        "  ol.innerHTML=h;ol.className='open';",
        "}",
        "function mark(){var li=ol.querySelectorAll('li');for(var i=0;i<li.length;i++)li[i].className=i===sel?'sel':''}",
        "q.addEventListener('input',show);",
        "q.addEventListener('keydown',function(ev){",
        "  if(ev.key==='ArrowDown'){sel=Math.min(sel+1,hits.length-1);mark();ev.preventDefault()}",
        "  else if(ev.key==='ArrowUp'){sel=Math.max(sel-1,0);mark();ev.preventDefault()}",
        "  else if(ev.key==='Enter'&&hits.length){location.href=root+(window.EIDER_INDEX[hits[sel][2]][4])}",
        "  else if(ev.key==='Escape'){q.value='';show();q.blur()}",
        "});",
        "document.addEventListener('keydown',function(ev){",
        "  if(ev.key==='/'&&document.activeElement!==q){ev.preventDefault();q.focus()}",
        "});",
        "document.addEventListener('click',function(ev){if(!ol.contains(ev.target)&&ev.target!==q){ol.className=''}});",
        "})();",
    ] {
        bytes.append(inout out, l.bytes())
        out.push(10)
    }
    out
}

// sha256: SHA-256 (FIPS 180-4) in plain Eider.
//
// Eider has no bitwise operators yet, so: shifts are multiply/divide by powers of two,
// rotations add two disjoint shifted halves, and AND goes through a 256x256 byte table
// (XOR is a + b - 2*(a AND b)). Build a `Sha` once with `new()` and reuse it.

pub type Sha = { and_t: List[u8], pow: List[u64], k: List[u32] }

pub fn new() -> Sha {
    let mut t: List[u8] = List.new()
    for a in 0..256 {
        for b in 0..256 {
            let mut r: u32 = 0
            let mut x = a as u32
            let mut y = b as u32
            let mut bit: u32 = 1
            for i in 0..8 {
                if x % 2 == 1 && y % 2 == 1 { r += bit }
                x = x / 2
                y = y / 2
                if i < 7 { bit = bit * 2 }
            }
            t.push(r as u8)
        }
    }
    let mut pow: List[u64] = List.new()
    let mut p: u64 = 1
    for i in 0..33 {
        pow.push(p)
        if i < 32 { p = p * 2 }
    }
    let k: [u32; 64] = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ]
    let mut kl: List[u32] = List.new()
    for i in 0..64 { kl.push(k[i as usize]) }
    Sha(t, pow, kl)
}

fn and32(s: Sha, a: u32, b: u32) -> u32 {
    let mut r: u32 = 0
    let mut x = a.copy()
    let mut y = b.copy()
    let mut place: u32 = 1
    for i in 0..4 {
        let v = s.and_t[((x % 256) * 256 + y % 256) as usize] as u32
        r += v * place
        x = x / 256
        y = y / 256
        if i < 3 { place = place * 256 }
    }
    r
}

fn xor32(s: Sha, a: u32, b: u32) -> u32 {
    ((a as u64 + b as u64 - 2 * (and32(s, a, b) as u64))) as u32
}

fn shr(s: Sha, x: u32, n: usize) -> u32 { ((x as u64) / s.pow[n]) as u32 }

fn rotr(s: Sha, x: u32, n: usize) -> u32 {
    let lo = (x as u64) / s.pow[n]
    let hi = ((x as u64) % s.pow[n]) * s.pow[32 - n]
    (lo + hi) as u32
}

fn not32(x: u32) -> u32 { 4294967295 - x }

/// The 32-byte digest of `data`.
pub fn digest(s: Sha, data: List[u8]) -> List[u8] {
    let mut msg = data.copy()
    let bits = (data.len() as u64) * 8
    msg.push(128)
    while msg.len() % 64 != 56 { msg.push(0) }
    // message length in bits, big-endian
    let mut len_le: [u8; 8] = [0; 8]
    let mut v = bits.copy()
    for j in 0..8 {
        len_le[j as usize] = (v % 256) as u8
        v = v / 256
    }
    for j in 0..8 { msg.push(len_le[(7 - j) as usize]) }
    let mut h: [u32; 8] = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    let mut w: [u32; 64] = [0; 64]
    let mut off: usize = 0
    while off < msg.len() {
        for t16 in 0..16 {
            let t = t16 as usize
            let j = off + t * 4
            w[t] = ((msg[j] as u32) *% 16777216) +% ((msg[j + 1] as u32) * 65536) +% ((msg[j + 2] as u32) * 256) +% (msg[j + 3] as u32)
        }
        for t64 in 16..64 {
            let t = t64 as usize
            let x = w[t - 15]
            let y = w[t - 2]
            let s0 = xor32(s, xor32(s, rotr(s, x, 7), rotr(s, x, 18)), shr(s, x, 3))
            let s1 = xor32(s, xor32(s, rotr(s, y, 17), rotr(s, y, 19)), shr(s, y, 10))
            w[t] = w[t - 16] +% s0 +% w[t - 7] +% s1
        }
        let mut a = h[0].copy()
        let mut b = h[1].copy()
        let mut c = h[2].copy()
        let mut d = h[3].copy()
        let mut e = h[4].copy()
        let mut f = h[5].copy()
        let mut g = h[6].copy()
        let mut hh = h[7].copy()
        for t64 in 0..64 {
            let t = t64 as usize
            let S1 = xor32(s, xor32(s, rotr(s, e, 6), rotr(s, e, 11)), rotr(s, e, 25))
            let ch = xor32(s, and32(s, e, f), and32(s, not32(e), g))
            let t1 = hh +% S1 +% ch +% s.k[t] +% w[t]
            let S0 = xor32(s, xor32(s, rotr(s, a, 2), rotr(s, a, 13)), rotr(s, a, 22))
            let maj = xor32(s, xor32(s, and32(s, a, b), and32(s, a, c)), and32(s, b, c))
            let t2 = S0 +% maj
            hh = g
            g = f
            f = e
            e = d +% t1
            d = c
            c = b
            b = a
            a = t1 +% t2
        }
        h[0] = h[0] +% a
        h[1] = h[1] +% b
        h[2] = h[2] +% c
        h[3] = h[3] +% d
        h[4] = h[4] +% e
        h[5] = h[5] +% f
        h[6] = h[6] +% g
        h[7] = h[7] +% hh
        off += 64
    }
    let mut out: List[u8] = List.new()
    for j8 in 0..8 {
        let j = j8 as usize
        out.push((h[j] / 16777216) as u8)
        out.push((h[j] / 65536 % 256) as u8)
        out.push((h[j] / 256 % 256) as u8)
        out.push((h[j] % 256) as u8)
    }
    out
}

import "core/sys"
import "std/bytes"
import "std/io"
import "../crypto.ei"

fn rep(b: u8, n: usize) -> List[u8] {
    var out: List[u8] = List.new()
    for i in 0..n { out.push(b) }
    out
}

fn main() uses io, ffi {
    io.outln(bytes.hex(crypto.sha256("abc".bytes())))
    let k = crypto.aead_key(crypto.ChaCha20Poly1305, rep(7, 32)).unwrap()
    let n = crypto.nonce(rep(1, 12)).unwrap()
    let ct = crypto.seal(k, n, "ad".bytes(), "hello".bytes()).unwrap()
    io.outln(bytes.hex(crypto.open(k, n, "ad".bytes(), ct).unwrap()))
    match crypto.open(k, n, "AD".bytes(), ct) {
        Ok(_) => io.outln("BAD".bytes())
        Err(e) => io.outln(crypto.error_text(e).bytes())
    }
}

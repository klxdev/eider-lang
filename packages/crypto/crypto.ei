// crypto: hashing, MACs, key derivation, authenticated encryption, key agreement and
// signatures for Eider, over the core's crypto provider (core/crypto.ei, core/ABI.md
// "Crypto"). The primitives come from an OpenSSL-compatible libcrypto chosen when the
// program is linked (AWS-LC by default; core/crypto/README.md). This package adds types and
// checks, and behaves the same on every backend: tests/crypto runs the same vectors on each.
//
// Misuse resistance:
// - every key, nonce, signature and secret has its own type, built by a function that checks
//   its length (and, for private scalars, its range), so a nonce can't be passed as a key or
//   an X25519 public key as an Ed25519 one;
// - `open` returns Err(AuthFailed) and no plaintext when the tag doesn't match (the core
//   zeroes what it decrypted before returning);
// - MAC tags are compared in constant time (`hmac_verify`, `Tag.matches`, `ct_equal`);
// - signature checks return a plain bool that is true only for a valid signature: a key the
//   backend can't use or a malformed signature is just "not valid";
// - algorithms a backend lacks are Err(Unsupported), never a silent fallback; `supports`
//   asks first.
// What it can't do yet: secret bytes held in Eider lists are ordinary values (copied, never
// zeroed on drop) until the language can mark them; the core's own buffers are zeroed.
//
// Programs using it need `uses ffi` (like every std caller today) and a linked backend:
// scripts/ei-crypto run prog.ei.

import core.crypto as abi

/// Why an operation failed.
pub type Error = | Unsupported | BadLength | InvalidKey | AuthFailed | Failed

fn error_of(status: i64) -> Error {
    if status == abi.EUNSUPPORTED { return Unsupported }
    if status == abi.ELENGTH { return BadLength }
    if status == abi.EKEY { return InvalidKey }
    if status == abi.EAUTH { return AuthFailed }
    Failed
}

fn lift(r: Result[List[u8], i64]) -> Result[List[u8], Error] {
    match r {
        Ok(b) => Ok(b)
        Err(s) => Err(error_of(s))
    }
}

pub fn error_text(e: Error) -> String {
    match e {
        Unsupported => String.from("crypto: algorithm not provided by this backend")
        BadLength => String.from("crypto: wrong length")
        InvalidKey => String.from("crypto: invalid key")
        AuthFailed => String.from("crypto: authentication failed")
        Failed => String.from("crypto: the crypto library reported an error")
    }
}

// ------------------------------------------------------------------ the provider

/// The OpenSSL-compatible library family this program was linked with.
pub type Backend = | OpenSsl | AwsLc | BoringSsl | LibreSsl

pub fn backend() -> Backend {
    let b = abi.backend()
    if b == abi.AWSLC { return AwsLc }
    if b == abi.BORINGSSL { return BoringSsl }
    if b == abi.LIBRESSL { return LibreSsl }
    OpenSsl
}

/// The library's name and version, e.g. "aws-lc: AWS-LC 5.12.0".
pub fn provider() -> List[u8] { abi.provider() }

/// Every algorithm, for `supports`. HMAC and HKDF exist with SHA-256, SHA-384 and SHA-512.
pub type Alg = | Hashing(h: Hash) | Hmac(h: Hash) | Hkdf(h: Hash) | Sealing(a: Aead) | X25519Agreement | Ed25519Signing | P256Signing | P256Agreement | P256Sha384Signing | P384Signing | P384Agreement | RsaPkcs1Signing | RsaPssSigning | Randomness

// the HMAC / HKDF id for a SHA-2 hash, else -1
fn mac_id(h: Hash, base: i32) -> i32 {
    match h {
        Sha256 => base
        Sha384 => base + 1
        Sha512 => base + 2
        _ => -1
    }
}

fn alg_id(a: Alg) -> i32 {
    match a {
        Hashing(h) => hash_id(h)
        Hmac(h) => mac_id(h, abi.HMAC_SHA256)
        Hkdf(h) => mac_id(h, abi.HKDF_SHA256)
        Sealing(x) => aead_id(x)
        X25519Agreement => abi.X25519
        Ed25519Signing => abi.ED25519
        P256Signing => abi.ECDSA_P256_SHA256
        P256Agreement => abi.ECDH_P256
        P256Sha384Signing => abi.ECDSA_P256_SHA384
        P384Signing => abi.ECDSA_P384_SHA384
        P384Agreement => abi.ECDH_P384
        RsaPkcs1Signing => abi.RSA_PKCS1_SHA256
        RsaPssSigning => abi.RSA_PSS_SHA256
        Randomness => abi.RANDOM
    }
}

/// Whether the linked backend provides `a` (the core ran it once to find out).
pub fn supports(a: Alg) -> bool { abi.supports(alg_id(a)) }

// ------------------------------------------------------------------ randomness

/// `n` bytes from the backend's CSPRNG (seeded by the operating system), n <= 1 MiB.
pub fn random_bytes(n: usize) -> Result[List[u8], Error] uses io { lift(abi.random(n as i64)) }

// ------------------------------------------------------------------ hashing

pub type Hash = | Sha256 | Sha384 | Sha512 | Sha3_256 | Sha3_384 | Sha3_512 | Blake2b256 | Blake2b512

fn hash_id(h: Hash) -> i32 {
    match h {
        Sha256 => abi.SHA256
        Sha384 => abi.SHA384
        Sha512 => abi.SHA512
        Sha3_256 => abi.SHA3_256
        Sha3_384 => abi.SHA3_384
        Sha3_512 => abi.SHA3_512
        Blake2b256 => abi.BLAKE2B_256
        Blake2b512 => abi.BLAKE2B_512
    }
}

/// Output length in bytes.
pub fn hash_len(h: Hash) -> usize {
    match h {
        Sha256 => 32
        Sha384 => 48
        Sha512 => 64
        Sha3_256 => 32
        Sha3_384 => 48
        Sha3_512 => 64
        Blake2b256 => 32
        Blake2b512 => 64
    }
}

pub fn digest(h: Hash, msg: List[u8]) -> Result[List[u8], Error] { lift(abi.hash(hash_id(h), msg)) }

/// SHA-256, which every backend provides (a backend without it is broken: this panics).
pub fn sha256(msg: List[u8]) -> List[u8] {
    match digest(Sha256, msg) {
        Ok(d) => d
        Err(_) => panic("crypto: SHA-256 failed")
    }
}

// ------------------------------------------------------------------ HMAC and HKDF

// HMAC and HKDF are offered with SHA-256, SHA-384 and SHA-512; another `Hash` is
// Err(Unsupported) (from the core, on every backend).

/// An HMAC key, bound to its hash. Any length is allowed (RFC 2104); fewer bytes than the
/// hash's output is weak, which the caller decides.
pub type HmacKey = { hash: Hash, bytes: List[u8] }

pub fn hmac_key(h: Hash, key: List[u8]) -> HmacKey { HmacKey(h, key) }

/// A MAC tag. Compare it with `matches` (constant time), never with ==.
pub type Tag = { bytes: List[u8] }

impl Tag {
    /// Constant-time comparison with a received tag (a different length is no match).
    fn matches(self, other: List[u8]) -> bool { abi.ct_equal(self.bytes, other) }
}

pub fn hmac(k: HmacKey, msg: List[u8]) -> Result[Tag, Error] {
    let t = lift(abi.hmac(hash_id(k.hash), k.bytes, msg))?
    Ok(Tag(t))
}

/// Recompute the tag over `msg` and compare it with `tag` in constant time.
pub fn hmac_verify(k: HmacKey, msg: List[u8], tag: List[u8]) -> Result[bool, Error] {
    let t = hmac(k, msg)?
    Ok(t.matches(tag))
}

/// HKDF's pseudorandom key (RFC 5869 section 2.2), bound to its hash.
pub type Prk = { hash: Hash, bytes: List[u8] }

/// A PRK from bytes (at least the hash's length, as RFC 5869 requires of a PRK).
pub fn prk(h: Hash, b: List[u8]) -> Result[Prk, Error] {
    if b.len() < hash_len(h) { return Err(BadLength) }
    Ok(Prk(h, b))
}

pub fn hkdf_extract(h: Hash, salt: List[u8], ikm: List[u8]) -> Result[Prk, Error] {
    let b = lift(abi.hkdf_extract(hash_id(h), salt, ikm))?
    Ok(Prk(h, b))
}

/// `len` bytes of output keying material, 1 <= len <= 255 * hash length.
pub fn hkdf_expand(p: Prk, info: List[u8], len: usize) -> Result[List[u8], Error] {
    if len == 0 || len > 255 * hash_len(p.hash) { return Err(BadLength) }
    lift(abi.hkdf_expand(hash_id(p.hash), p.bytes, info, len as i64))
}

// ------------------------------------------------------------------ AEAD

pub type Aead = | Aes128Gcm | Aes256Gcm | ChaCha20Poly1305

fn aead_id(a: Aead) -> i32 {
    match a {
        Aes128Gcm => abi.AES_128_GCM
        Aes256Gcm => abi.AES_256_GCM
        ChaCha20Poly1305 => abi.CHACHA20_POLY1305
    }
}

pub fn aead_key_len(a: Aead) -> usize {
    match a {
        Aes128Gcm => 16
        Aes256Gcm => 32
        ChaCha20Poly1305 => 32
    }
}

pub const NONCE_LEN: usize = 12
pub const TAG_LEN: usize = 16

/// A key for one AEAD algorithm.
pub type AeadKey = { alg: Aead, bytes: List[u8] }

/// A 96-bit nonce. Never seal two messages under one key with the same nonce.
pub type Nonce = { bytes: List[u8] }

pub fn aead_key(a: Aead, b: List[u8]) -> Result[AeadKey, Error] {
    if b.len() != aead_key_len(a) { return Err(BadLength) }
    Ok(AeadKey(a, b))
}

pub fn aead_generate(a: Aead) -> Result[AeadKey, Error] uses io {
    let b = random_bytes(aead_key_len(a))?
    Ok(AeadKey(a, b))
}

pub fn nonce(b: List[u8]) -> Result[Nonce, Error] {
    if b.len() != NONCE_LEN { return Err(BadLength) }
    Ok(Nonce(b))
}

/// A random nonce (fine for up to about 2^32 messages per key).
pub fn random_nonce() -> Result[Nonce, Error] uses io {
    let b = random_bytes(NONCE_LEN)?
    Ok(Nonce(b))
}

/// The TLS 1.3 per-record nonce (RFC 8446 section 5.3): `iv` XOR the 64-bit big-endian
/// sequence number, left-padded to 12 bytes.
pub fn nonce_for_sequence(iv: Nonce, seq: u64) -> Nonce {
    let mut b = iv.bytes.copy()
    let mut s = seq.copy()
    let mut i: usize = NONCE_LEN
    while i > NONCE_LEN - 8 {
        i -= 1
        b[i] = b[i] ^ ((s % 256) as u8)
        s = s / 256
    }
    Nonce(b)
}

/// ciphertext || 16-byte tag.
pub fn seal(k: AeadKey, n: Nonce, aad: List[u8], plaintext: List[u8]) -> Result[List[u8], Error] {
    lift(abi.aead_seal(aead_id(k.alg), k.bytes, n.bytes, aad, plaintext))
}

/// The plaintext, or Err(AuthFailed) and nothing else when the ciphertext, the tag, the
/// nonce or the associated data was altered.
pub fn open(k: AeadKey, n: Nonce, aad: List[u8], sealed: List[u8]) -> Result[List[u8], Error] {
    if sealed.len() < TAG_LEN { return Err(AuthFailed) }
    lift(abi.aead_open(aead_id(k.alg), k.bytes, n.bytes, aad, sealed))
}

// ------------------------------------------------------------------ X25519 (RFC 7748)

pub type X25519Secret = { bytes: List[u8] }
pub type X25519Public = { bytes: List[u8] }
/// The output of a key agreement: feed it to HKDF, never use it as a key directly.
pub type SharedSecret = { bytes: List[u8] }

pub fn x25519_secret(b: List[u8]) -> Result[X25519Secret, Error] {
    if b.len() != 32 { return Err(BadLength) }
    Ok(X25519Secret(b))
}

pub fn x25519_generate() -> Result[X25519Secret, Error] uses io {
    let b = random_bytes(32)?
    Ok(X25519Secret(b))
}

pub fn x25519_public_key(b: List[u8]) -> Result[X25519Public, Error] {
    if b.len() != 32 { return Err(BadLength) }
    Ok(X25519Public(b))
}

pub fn x25519_public(sk: X25519Secret) -> Result[X25519Public, Error] {
    let b = lift(abi.x25519_public(sk.bytes))?
    Ok(X25519Public(b))
}

/// Err(InvalidKey) when the result is all zero (a small-order peer key, RFC 7748 6.1).
pub fn x25519_agree(sk: X25519Secret, peer: X25519Public) -> Result[SharedSecret, Error] {
    let b = lift(abi.x25519(sk.bytes, peer.bytes))?
    Ok(SharedSecret(b))
}

// ------------------------------------------------------------------ Ed25519 (RFC 8032)

pub type Ed25519Seed = { bytes: List[u8] }
pub type Ed25519Public = { bytes: List[u8] }
pub type Ed25519Signature = { bytes: List[u8] }

pub fn ed25519_seed(b: List[u8]) -> Result[Ed25519Seed, Error] {
    if b.len() != 32 { return Err(BadLength) }
    Ok(Ed25519Seed(b))
}

pub fn ed25519_generate() -> Result[Ed25519Seed, Error] uses io {
    let b = random_bytes(32)?
    Ok(Ed25519Seed(b))
}

pub fn ed25519_public_key(b: List[u8]) -> Result[Ed25519Public, Error] {
    if b.len() != 32 { return Err(BadLength) }
    Ok(Ed25519Public(b))
}

pub fn ed25519_signature(b: List[u8]) -> Result[Ed25519Signature, Error] {
    if b.len() != 64 { return Err(BadLength) }
    Ok(Ed25519Signature(b))
}

pub fn ed25519_public(s: Ed25519Seed) -> Result[Ed25519Public, Error] {
    let b = lift(abi.ed25519_public(s.bytes))?
    Ok(Ed25519Public(b))
}

pub fn ed25519_sign(s: Ed25519Seed, msg: List[u8]) -> Result[Ed25519Signature, Error] {
    let b = lift(abi.ed25519_sign(s.bytes, msg))?
    Ok(Ed25519Signature(b))
}

/// True only for a valid signature by `pk` over `msg`.
pub fn ed25519_verify(pk: Ed25519Public, msg: List[u8], sig: Ed25519Signature) -> bool {
    abi.ed25519_verify(pk.bytes, sig.bytes, msg).unwrap_or(false)
}

// ------------------------------------------------------------------ P-256

/// A private scalar d, 0 < d < n, 32 bytes big-endian.
pub type P256Secret = { bytes: List[u8] }
/// An uncompressed point, 04 || x || y (65 bytes).
pub type P256Public = { bytes: List[u8] }
/// An ECDSA signature, DER-encoded (as in TLS and X.509).
pub type P256Signature = { der: List[u8] }

/// Checks the length and the range (via the backend, which computes the public key).
pub fn p256_secret(b: List[u8]) -> Result[P256Secret, Error] {
    if b.len() != 32 { return Err(BadLength) }
    let _ = lift(abi.p256_public(b))?
    Ok(P256Secret(b))
}

/// A random scalar in range (a 32-byte draw is out of range with probability < 2^-32; then
/// it draws again).
pub fn p256_generate() -> Result[P256Secret, Error] uses io {
    let mut tries = 0
    while tries < 16 {
        let b = random_bytes(32)?
        match p256_secret(b) {
            Ok(s) => return Ok(s)
            Err(e) => {
                match e {
                    InvalidKey => {}
                    _ => return Err(e)
                }
            }
        }
        tries += 1
    }
    Err(Failed)
}

/// A public key from its encoding. Only the form is checked here (65 bytes, 04 first); that
/// the point is on the curve is checked whenever it is used (Err(InvalidKey) / not valid).
pub fn p256_public_key(b: List[u8]) -> Result[P256Public, Error] {
    if b.len() != 65 || b[0] != 4 { return Err(BadLength) }
    Ok(P256Public(b))
}

pub fn p256_public(s: P256Secret) -> Result[P256Public, Error] {
    let b = lift(abi.p256_public(s.bytes))?
    Ok(P256Public(b))
}

/// ECDSA over SHA-256(msg), with a fresh random nonce from the backend.
pub fn p256_sign(s: P256Secret, msg: List[u8]) -> Result[P256Signature, Error] uses io {
    let b = lift(abi.p256_sign(s.bytes, msg))?
    Ok(P256Signature(b))
}

/// True only for a valid signature by `pk` over SHA-256(msg).
pub fn p256_verify(pk: P256Public, msg: List[u8], sig: P256Signature) -> bool {
    abi.p256_verify(pk.bytes, sig.der, msg).unwrap_or(false)
}

/// ECDH: the x-coordinate of d * peer (32 bytes). Err(InvalidKey) if `peer` is not on the curve.
pub fn p256_agree(s: P256Secret, peer: P256Public) -> Result[SharedSecret, Error] {
    let b = lift(abi.p256_ecdh(s.bytes, peer.bytes))?
    Ok(SharedSecret(b))
}

/// A DER signature from its encoding (checked only when verified).
pub fn p256_signature_der(der: List[u8]) -> P256Signature { P256Signature(der) }

// DER INTEGER for a `size`-byte unsigned big-endian value: minimal, positive
fn der_int(v: List[u8], at: usize, size: usize) -> List[u8] {
    let mut i = at.copy()
    let end = at + size
    while i < end - 1 && v[i] == 0 { i += 1 }
    let mut out: List[u8] = List.new()
    out.push(2)
    let n = end - i
    if v[i] >= 128 {
        out.push((n + 1) as u8)
        out.push(0)
    } else {
        out.push(n as u8)
    }
    while i < end {
        out.push(v[i])
        i += 1
    }
    out
}

// SEQUENCE { INTEGER r, INTEGER s } from r || s, `size` bytes each (at most 48: one length byte)
fn der_pair(rs: List[u8], size: usize) -> List[u8] {
    let r = der_int(rs, 0, size)
    let s = der_int(rs, size, size)
    let mut der: List[u8] = List.new()
    der.push(48)
    der.push((r.len() + s.len()) as u8)
    for x in r { der.push(x) }
    for x in s { der.push(x) }
    der
}

/// A signature from the fixed-size form r || s (64 bytes, as NIST vectors and JOSE give it).
pub fn p256_signature_raw(rs: List[u8]) -> Result[P256Signature, Error] {
    if rs.len() != 64 { return Err(BadLength) }
    Ok(P256Signature(der_pair(rs, 32)))
}

// one strict DER INTEGER at `at`, appended to `out` as `size` big-endian bytes; the next offset
fn der_read_int(d: List[u8], at: usize, size: usize, inout out: List[u8]) -> Option[usize] {
    if at + 2 > d.len() || d[at] != 2 { return None }
    let n = d[at + 1] as usize
    let start = at + 2
    if n == 0 || n > size + 1 || start + n > d.len() { return None }
    // positive and minimal
    if d[start] >= 128 { return None }
    if n > 1 && d[start] == 0 && d[start + 1] < 128 { return None }
    let mut i = start.copy()
    if d[i] == 0 && n > 1 { i += 1 }
    let len = start + n - i
    if len > size { return None }
    let mut pad = size - len
    while pad > 0 {
        out.push(0)
        pad -= 1
    }
    while i < start + n {
        out.push(d[i])
        i += 1
    }
    Some(start + n)
}

// r || s of a strict DER ECDSA-Sig-Value with `size`-byte integers
fn der_to_raw(d: List[u8], size: usize) -> Result[List[u8], Error] {
    if d.len() < 8 || d[0] != 48 || (d[1] as usize) != d.len() - 2 { return Err(BadLength) }
    let mut out: List[u8] = List.new()
    let next = match der_read_int(d, 2, size, inout out) {
        Some(n) => n
        None => return Err(BadLength)
    }
    let end = match der_read_int(d, next, size, inout out) {
        Some(n) => n
        None => return Err(BadLength)
    }
    if end != d.len() { return Err(BadLength) }
    Ok(out)
}

impl P256Signature {
    /// r || s (64 bytes), or Err(BadLength) if this is not one strict DER ECDSA-Sig-Value.
    fn raw(self) -> Result[List[u8], Error] { der_to_raw(self.der, 32) }
}

// ------------------------------------------------------------------ ECDSA and ECDH on P-256 and P-384

// The p256_* functions above are ECDSA with SHA-256 on P-256. These take the curve and the
// hash: P-256 and P-384 with SHA-256, SHA-384 or SHA-512 (the pairs TLS 1.2/1.3 and X.509
// use are P-256/SHA-256, P-384/SHA-384, P-256/SHA-384 and P-256/SHA-512; any pairing works).
// Another `Hash` is Err(Unsupported) when signing and "not valid" when verifying.

pub type EcCurve = | P256 | P384

fn curve_id(c: EcCurve) -> i32 {
    match c {
        P256 => abi.CURVE_P256
        P384 => abi.CURVE_P384
    }
}

/// The private scalar size in bytes: 32 or 48.
pub fn ec_scalar_len(c: EcCurve) -> usize {
    match c {
        P256 => 32
        P384 => 48
    }
}

/// The uncompressed point size in bytes: 65 or 97.
pub fn ec_point_len(c: EcCurve) -> usize { 1 + 2 * ec_scalar_len(c) }

/// A private scalar d, 0 < d < n, big-endian, `ec_scalar_len` bytes.
pub type EcSecret = { curve: EcCurve, bytes: List[u8] }
/// An uncompressed point 04 || x || y.
pub type EcPublic = { curve: EcCurve, bytes: List[u8] }
/// An ECDSA signature, DER-encoded.
pub type EcSignature = { der: List[u8] }

pub fn ec_secret(c: EcCurve, b: List[u8]) -> Result[EcSecret, Error] {
    if b.len() != ec_scalar_len(c) { return Err(BadLength) }
    let _ = lift(abi.ec_public(curve_id(c), b.copy()))?
    Ok(EcSecret(c, b))
}

pub fn ec_generate(c: EcCurve) -> Result[EcSecret, Error] uses io {
    let mut tries = 0
    while tries < 16 {
        let b = random_bytes(ec_scalar_len(c))?
        match ec_secret(c, b) {
            Ok(s) => return Ok(s)
            Err(e) => {
                match e {
                    InvalidKey => {}
                    _ => return Err(e)
                }
            }
        }
        tries += 1
    }
    Err(Failed)
}

/// A public key from its encoding: the form is checked here (length, 04 first), that the
/// point is on the curve whenever it is used.
pub fn ec_public_key(c: EcCurve, b: List[u8]) -> Result[EcPublic, Error] {
    if b.len() != ec_point_len(c) || b[0] != 4 { return Err(BadLength) }
    Ok(EcPublic(c, b))
}

pub fn ec_public(s: EcSecret) -> Result[EcPublic, Error] {
    let b = lift(abi.ec_public(curve_id(s.curve), s.bytes))?
    Ok(EcPublic(s.curve, b))
}

/// ECDSA over hash(msg) with a fresh random nonce from the backend.
pub fn ec_sign(s: EcSecret, h: Hash, msg: List[u8]) -> Result[EcSignature, Error] uses io {
    let b = lift(abi.ec_sign(curve_id(s.curve), hash_id(h), s.bytes, msg))?
    Ok(EcSignature(b))
}

/// True only for a valid signature by `pk` over hash(msg).
pub fn ec_verify(pk: EcPublic, h: Hash, msg: List[u8], sig: EcSignature) -> bool {
    abi.ec_verify(curve_id(pk.curve), hash_id(h), pk.bytes, sig.der, msg).unwrap_or(false)
}

/// ECDH: the x-coordinate of d * peer. Err(InvalidKey) if the curves differ or `peer` is not on the curve.
pub fn ec_agree(s: EcSecret, peer: EcPublic) -> Result[SharedSecret, Error] {
    if curve_id(s.curve) != curve_id(peer.curve) { return Err(InvalidKey) }
    let b = lift(abi.ec_ecdh(curve_id(s.curve), s.bytes, peer.bytes))?
    Ok(SharedSecret(b))
}

/// A DER signature from its encoding (checked only when verified).
pub fn ec_signature_der(der: List[u8]) -> EcSignature { EcSignature(der) }

/// A signature from the fixed-size form r || s (twice the scalar size, as JOSE and NIST vectors give it).
pub fn ec_signature_raw(c: EcCurve, rs: List[u8]) -> Result[EcSignature, Error] {
    let size = ec_scalar_len(c)
    if rs.len() != 2 * size { return Err(BadLength) }
    Ok(EcSignature(der_pair(rs, size)))
}

/// r || s of a signature on `c`, or Err(BadLength) if it is not one strict DER ECDSA-Sig-Value.
pub fn ec_signature_to_raw(c: EcCurve, sig: EcSignature) -> Result[List[u8], Error] { der_to_raw(sig.der, ec_scalar_len(c)) }

// ------------------------------------------------------------------ RSA

// RSA signatures, PKCS#1 v1.5 (RFC 8017 8.2) and RSASSA-PSS (8.1; MGF1 with the signature's
// hash, trailer 0xbc), with SHA-256, SHA-384 or SHA-512. Messages are hashed inside; a
// signature is exactly as long as the modulus.
//
// Key policy, the same on every backend (the core checks it): modulus 2048 to 8192 bits and
// odd; public exponent odd, 3 <= e < 2^33 (3 and 65537 occur in certificates; the exponent
// is public, and e = 1, even exponents and larger ones are refused); a key outside it is
// Err(InvalidKey) to build and "not valid" to verify with. 1024-bit keys are refused on
// purpose. Key generation is not offered (keys come from files and certificates).
// Private-key operations use the backend's own: blinding is on (OpenSSL, LibreSSL and
// AWS-LC blind by default) and the result is checked before it is returned; the Eider code
// holds no secret-dependent branch.

/// An RSA public key (the core's blob: n_len (4 bytes big endian), n, e).
pub type RsaPublic = { blob: List[u8] }
/// An RSA private key: its DER (PKCS#8 or PKCS#1), and the public key.
pub type RsaPrivate = { der: List[u8], public: RsaPublic }
pub type RsaSignature = { bytes: List[u8] }

fn be32(v: usize) -> List[u8] {
    let mut o: List[u8] = List.new()
    o.push(((v / 16777216) % 256) as u8)
    o.push(((v / 65536) % 256) as u8)
    o.push(((v / 256) % 256) as u8)
    o.push((v % 256) as u8)
    o
}

fn strip_zeros(b: List[u8]) -> List[u8] {
    let mut i: usize = 0
    while i < b.len() && b[i] == 0 { i += 1 }
    let mut o: List[u8] = List.new()
    while i < b.len() {
        o.push(b[i])
        i += 1
    }
    o
}

fn blob_nlen(blob: List[u8]) -> usize {
    (blob[0] as usize) * 16777216 + (blob[1] as usize) * 65536 + (blob[2] as usize) * 256 + (blob[3] as usize)
}

// the n of a blob
fn blob_n(blob: List[u8]) -> List[u8] {
    let nl = blob_nlen(blob)
    let mut o: List[u8] = List.new()
    let mut i: usize = 4
    while i < 4 + nl && i < blob.len() {
        o.push(blob[i])
        i += 1
    }
    o
}

// the e of a blob
fn blob_e(blob: List[u8]) -> List[u8] {
    let mut o: List[u8] = List.new()
    let mut i = 4 + blob_nlen(blob)
    while i < blob.len() {
        o.push(blob[i])
        i += 1
    }
    o
}

// a blob the core accepts under the key policy: probed with an empty signature, which the core
// answers EKEY for a bad key and 0 (not valid) for a good key
fn rsa_blob_checked(blob: List[u8]) -> Result[RsaPublic, Error] {
    if blob.len() < 6 { return Err(BadLength) }
    match abi.rsa_verify(abi.RSA_PKCS1, abi.SHA256, 0, blob.copy(), List.new(), List.new()) {
        Ok(_) => Ok(RsaPublic(blob))
        Err(s) => Err(error_of(s))
    }
}

/// A public key from the modulus and exponent (unsigned big-endian; leading zeros are dropped).
pub fn rsa_public_from_ne(n: List[u8], e: List[u8]) -> Result[RsaPublic, Error] {
    let n1 = strip_zeros(n)
    let e1 = strip_zeros(e)
    if n1.len() == 0 || e1.len() == 0 || n1.len() > 1024 || e1.len() > 8 { return Err(InvalidKey) }
    let mut blob = be32(n1.len())
    for x in n1 { blob.push(x) }
    for x in e1 { blob.push(x) }
    rsa_blob_checked(blob)
}

/// The modulus of the key, unsigned big-endian.
pub fn rsa_modulus(pk: RsaPublic) -> List[u8] { blob_n(pk.blob) }

/// The public exponent, unsigned big-endian.
pub fn rsa_exponent(pk: RsaPublic) -> List[u8] { blob_e(pk.blob) }

/// The modulus length in bits.
pub fn rsa_bits(pk: RsaPublic) -> usize {
    let n = blob_n(pk.blob)
    let first = n[0] as usize
    let mut bits = n.len() * 8
    let mut bit: usize = 128
    while bit > first {
        bits -= 1
        bit = bit / 2
    }
    bits
}

fn tail(r: List[u8]) -> List[u8] {
    let mut o: List[u8] = List.new()
    let mut i: usize = 1
    while i < r.len() {
        o.push(r[i])
        i += 1
    }
    o
}

/// A private key from DER (PKCS#8 PrivateKeyInfo or PKCS#1 RSAPrivateKey; no trailing bytes).
pub fn rsa_private_from_der(der: List[u8]) -> Result[RsaPrivate, Error] {
    let r = lift(abi.priv_parse(der.copy()))?
    if r.len() < 2 || r[0] != abi.KEY_RSA { return Err(InvalidKey) }
    Ok(RsaPrivate(der, RsaPublic(tail(r))))
}

pub fn rsa_public_of(sk: RsaPrivate) -> RsaPublic { sk.public }

pub fn rsa_signature(b: List[u8]) -> RsaSignature { RsaSignature(b) }

fn sha2(h: Hash) -> bool {
    match h {
        Sha256 => true
        Sha384 => true
        Sha512 => true
        _ => false
    }
}

/// RSASSA-PKCS1-v1_5 over hash(msg); true only for a valid signature.
pub fn rsa_pkcs1_verify(pk: RsaPublic, h: Hash, msg: List[u8], sig: RsaSignature) -> bool {
    if !sha2(h) { return false }
    abi.rsa_verify(abi.RSA_PKCS1, hash_id(h), 0, pk.blob, sig.bytes, msg).unwrap_or(false)
}

/// RSASSA-PSS over hash(msg), MGF1 with `h`, the signature's salt exactly `salt_len` bytes.
pub fn rsa_pss_verify(pk: RsaPublic, h: Hash, salt_len: usize, msg: List[u8], sig: RsaSignature) -> bool {
    if !sha2(h) || salt_len > 1024 { return false }
    abi.rsa_verify(abi.RSA_PSS, hash_id(h), salt_len as i64, pk.blob, sig.bytes, msg).unwrap_or(false)
}

/// RSASSA-PSS as TLS 1.3 (RFC 8446 4.2.3) and RFC 4055 for sha256/384/512 use it: the salt is as long as the hash.
pub fn rsa_pss_verify_tls(pk: RsaPublic, h: Hash, msg: List[u8], sig: RsaSignature) -> bool {
    rsa_pss_verify(pk, h, hash_len(h), msg, sig)
}

/// RSASSA-PKCS1-v1_5 signature (deterministic; blinded by the backend).
pub fn rsa_pkcs1_sign(sk: RsaPrivate, h: Hash, msg: List[u8]) -> Result[RsaSignature, Error] uses io {
    if !sha2(h) { return Err(Unsupported) }
    let b = lift(abi.rsa_sign(abi.RSA_PKCS1, hash_id(h), 0, sk.der, msg))?
    Ok(RsaSignature(b))
}

/// RSASSA-PSS signature with a random salt of `salt_len` bytes.
pub fn rsa_pss_sign(sk: RsaPrivate, h: Hash, salt_len: usize, msg: List[u8]) -> Result[RsaSignature, Error] uses io {
    if !sha2(h) { return Err(Unsupported) }
    if salt_len > 1024 { return Err(BadLength) }
    let b = lift(abi.rsa_sign(abi.RSA_PSS, hash_id(h), salt_len as i64, sk.der, msg))?
    Ok(RsaSignature(b))
}

/// RSASSA-PSS with a salt as long as the hash (TLS 1.3, X.509 sha256/384/512 parameters).
pub fn rsa_pss_sign_tls(sk: RsaPrivate, h: Hash, msg: List[u8]) -> Result[RsaSignature, Error] uses io {
    rsa_pss_sign(sk, h, hash_len(h), msg)
}

// ------------------------------------------------------------------ keys from DER

/// A public key out of a SubjectPublicKeyInfo.
pub type PublicKey = | RsaKey(k: RsaPublic) | EcKey(k: EcPublic)

/// A private key out of PKCS#8 / PKCS#1 / SEC1 DER.
pub type PrivateKey = | RsaPrivateKey(k: RsaPrivate) | EcPrivateKey(k: EcSecret)

/// Parses a DER SubjectPublicKeyInfo (RSA by the key policy above, or EC on P-256 or P-384
/// with named-curve parameters). Anything else, and trailing bytes, is Err(InvalidKey).
pub fn public_key_from_spki(der: List[u8]) -> Result[PublicKey, Error] {
    let r = lift(abi.spki_parse(der))?
    if r.len() < 2 { return Err(Failed) }
    if r[0] == abi.KEY_RSA { return Ok(RsaKey(RsaPublic(tail(r)))) }
    if r[0] == abi.KEY_P256 { return Ok(EcKey(EcPublic(P256, tail(r)))) }
    if r[0] == abi.KEY_P384 { return Ok(EcKey(EcPublic(P384, tail(r)))) }
    Err(InvalidKey)
}

/// Parses a DER private key: PKCS#8 or PKCS#1 RSA, SEC1 or PKCS#8 EC on P-256 or P-384.
pub fn private_key_from_der(der: List[u8]) -> Result[PrivateKey, Error] {
    let r = lift(abi.priv_parse(der.copy()))?
    if r.len() < 2 { return Err(Failed) }
    if r[0] == abi.KEY_RSA { return Ok(RsaPrivateKey(RsaPrivate(der, RsaPublic(tail(r))))) }
    if r[0] == abi.KEY_P256 { return Ok(EcPrivateKey(EcSecret(P256, tail(r)))) }
    if r[0] == abi.KEY_P384 { return Ok(EcPrivateKey(EcSecret(P384, tail(r)))) }
    Err(InvalidKey)
}

// ------------------------------------------------------------------ constant time

/// Equality in time that depends only on the length (which is not treated as secret).
pub fn ct_equal(a: List[u8], b: List[u8]) -> bool { abi.ct_equal(a, b) }

// http: HTTP/1.1 messages (RFC 9110, RFC 9112): requests, responses and headers as values,
// the limits a parser enforces, writing messages to bytes, and the small text helpers both
// sides need (case-insensitive header names, percent-decoding, query strings, IMF-fixdate).
//
// Pure Eider, no capabilities (`sys.lit` turns literals into bytes). The incremental parser
// is `parse.ei`, the server `server.ei`, the client `client.ei`, routing `router.ei` and
// JSON-RPC 2.0 `jsonrpc.ei` (docs/services.md).
//
// Header names in parsed messages are lowercased (field names are case-insensitive); names
// a program sets are written as given. Framing headers (Content-Length, Transfer-Encoding,
// Connection) belong to this package: whatever a program puts there is replaced when the
// message is written, so a handler can't desynchronise the framing of a connection.

import "core/sys"
import "std/bytes"

pub type Header = { name: List[u8], value: List[u8] }

/// A request. `target` is the request-target as received; `path` (still percent-encoded)
/// and `query` (after `?`, empty when there is none) are split from it. `version` is 10 or
/// 11. `params` are the path parameters a router matched (name, decoded value). `keep_alive`
/// is what the client asked for (HTTP/1.1 unless `Connection: close`; HTTP/1.0 only with
/// `Connection: keep-alive`).
pub type Request = {
    method: List[u8],
    target: List[u8],
    path: List[u8],
    query: List[u8],
    version: i32,
    headers: List[Header],
    body: List[u8],
    params: List[Header],
    keep_alive: bool,
}

/// A response. `version` and `keep_alive` are filled in by the parser (what the server
/// said). A handler's `version` is ignored; its `keep_alive` false makes the server close
/// the connection after this response.
pub type Response = { status: i32, headers: List[Header], body: List[u8], version: i32, keep_alive: bool }

// A handler is a value of type `fn(Request) -> Response` (spelled out everywhere: the
// language has no type aliases yet, docs/services.md "Needs").

/// Parser limits. A message over a limit is refused (with 414 for a long request line, 431
/// for headers, 413 for a body): `max_line` bytes per line (request line, status line,
/// header, chunk-size line), `max_headers` header fields (trailers count too), `max_head`
/// bytes for the whole head, `max_body` bytes of body (after chunked decoding).
pub type Limits = { max_line: usize, max_headers: usize, max_head: usize, max_body: usize }

/// 8 KiB lines, 100 headers, a 64 KiB head, a 1 MiB body.
pub fn limits() -> Limits { Limits(8192, 100, 65536, 1048576) }

// ---- byte classes (RFC 9110 5.6.2)

pub fn is_tchar(c: u8) -> bool {
    if bytes.is_alpha(c) || bytes.is_digit(c) { return true }
    c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 || c == 42 || c == 43 || c == 45 || c == 46 || c == 94 || c == 95 || c == 96 || c == 124 || c == 126
}

pub fn is_token(s: List[u8]) -> bool {
    if s.len() == 0 { return false }
    for c in s {
        if !is_tchar(c) { return false }
    }
    true
}

/// A byte allowed in a field value: visible ASCII, obs-text (0x80-0xFF), SP and HTAB (no
/// CR, LF, NUL or other control characters).
pub fn is_value_byte(c: u8) -> bool { c == 9 || (c >= 32 && c != 127) }

pub fn valid_value(v: List[u8]) -> bool {
    for c in v {
        if !is_value_byte(c) { return false }
    }
    true
}

fn lower_byte(c: u8) -> u8 {
    if c >= 65 && c <= 90 { return c + 32 }
    c
}

pub fn lower(s: List[u8]) -> List[u8] {
    let mut out: List[u8] = List.new()
    for c in s { out.push(lower_byte(c)) }
    out
}

/// ASCII case-insensitive equality.
pub fn eq_ci(a: List[u8], b: List[u8]) -> bool {
    if a.len() != b.len() { return false }
    for i in 0..a.len() {
        if lower_byte(a[i]) != lower_byte(b[i]) { return false }
    }
    true
}

/// `s` without leading and trailing SP and HTAB (OWS).
pub fn trim_ows(s: List[u8]) -> List[u8] {
    let mut a: usize = 0
    let mut z = s.len()
    while a < z && (s[a] == 32 || s[a] == 9) { a += 1 }
    while z > a && (s[z - 1] == 32 || s[z - 1] == 9) { z -= 1 }
    bytes.slice(s, a, z)
}

/// The elements of a comma-separated list (`#element`), trimmed, empty ones dropped.
pub fn list_items(v: List[u8]) -> List[List[u8]] {
    let mut out: List[List[u8]] = List.new()
    for part in bytes.split(v, 44) {
        let t = trim_ows(part)
        if t.len() > 0 { out.push(t) }
    }
    out
}

// ---- headers

/// The value of the first header called `name` (case-insensitive).
pub fn find(hs: List[Header], name: List[u8]) -> Option[List[u8]] {
    for h in hs {
        if eq_ci(h.name, name) { return Some(h.value) }
    }
    None
}

/// How many headers are called `name`.
pub fn count(hs: List[Header], name: List[u8]) -> usize {
    let mut n: usize = 0
    for h in hs {
        if eq_ci(h.name, name) { n += 1 }
    }
    n
}

/// `hs` without the headers called `name`.
pub fn without(hs: List[Header], name: List[u8]) -> List[Header] {
    let mut out: List[Header] = List.new()
    for h in hs {
        if !eq_ci(h.name, name) { out.push(h) }
    }
    out
}

/// Whether the comma-separated header `name` has the element `token` (case-insensitive),
/// over every field with that name.
pub fn has_token(hs: List[Header], name: List[u8], token: List[u8]) -> bool {
    for h in hs {
        if eq_ci(h.name, name) {
            for t in list_items(h.value) {
                if eq_ci(t, token) { return true }
            }
        }
    }
    false
}

impl Request {
    /// The first header called `name`.
    fn header(self, name: str) -> Option[List[u8]] { find(self.headers, sys.lit(name)) }

    /// The path parameter `name` a router matched (decoded).
    fn param(self, name: str) -> Option[List[u8]] { find(self.params, sys.lit(name)) }

    /// The first query parameter called `name`, decoded (`+` is a space); None when absent
    /// or badly encoded.
    fn query_param(self, name: str) -> Option[List[u8]] {
        let want = sys.lit(name)
        for kv in bytes.split(self.query, 38) {
            if kv.len() == 0 { continue }
            let mut k = kv.copy()
            let mut v: List[u8] = List.new()
            match bytes.find_byte(kv, 61, 0) {
                Some(i) => {
                    k = bytes.slice(kv, 0, i)
                    v = bytes.slice(kv, i + 1, kv.len())
                }
                None => {}
            }
            match pct_decode(k, true) {
                Some(dk) => {
                    if bytes.eq(dk, want) { return pct_decode(v, true) }
                }
                None => {}
            }
        }
        None
    }

    /// Adds a header.
    fn set_header(inout self, name: str, value: List[u8]) { self.headers.push(Header(sys.lit(name), value)) }
}

impl Response {
    fn header(self, name: str) -> Option[List[u8]] { find(self.headers, sys.lit(name)) }

    /// Adds a header (written as given; see the module comment for framing headers).
    fn set_header(inout self, name: str, value: List[u8]) { self.headers.push(Header(sys.lit(name), value)) }
}

// ---- building messages

/// A request for the client: `target` is the origin-form path and query ("/rpc?x=1").
pub fn request(method: str, target: List[u8]) -> Request {
    let (p, q) = split_target(target)
    Request(sys.lit(method), target, p, q, 11, List.new(), List.new(), List.new(), true)
}

/// A response with no headers and no body.
pub fn response(status: i32) -> Response { Response(status, List.new(), List.new(), 11, true) }

/// A response with a body and its Content-Type.
pub fn respond(status: i32, content_type: str, body: List[u8]) -> Response {
    let mut hs: List[Header] = List.new()
    hs.push(Header(sys.lit("Content-Type"), sys.lit(content_type)))
    Response(status, hs, body, 11, true)
}

/// A `text/plain` response.
pub fn text(status: i32, body: str) -> Response { respond(status, "text/plain; charset=utf-8", sys.lit(body)) }

/// An `application/json` response (the body must be JSON text).
pub fn json_response(status: i32, body: List[u8]) -> Response { respond(status, "application/json", body) }

/// A plain-text error response: the status and its reason phrase as the body.
pub fn error_response(status: i32) -> Response {
    let mut b = bytes.from_u64(status as u64)
    b.push(32)
    bytes.append(inout b, reason(status))
    b.push(10)
    respond(status, "text/plain; charset=utf-8", b)
}

/// (path, query) of a request-target: origin-form "/a?b" is ("/a", "b"); absolute-form
/// "http://host/a?b" is ("/a", "b") too (RFC 9112 3.2.2); anything else ("*", an authority)
/// is (target, "").
pub fn split_target(t: List[u8]) -> (List[u8], List[u8]) {
    let mut s = t.copy()
    if s.len() > 0 && s[0] != 47 {
        // absolute-form: scheme "://" authority path-abempty [ "?" query ]
        match bytes.find(s, sys.lit("://"), 0) {
            Some(i) => {
                let rest = bytes.slice(s, i + 3, s.len())
                let mut cut = rest.len()
                for k in 0..rest.len() {
                    if rest[k] == 47 || rest[k] == 63 {
                        cut = k
                        break
                    }
                }
                let mut p = sys.lit("/")
                if cut < rest.len() && rest[cut] == 47 { p = List.new() }
                bytes.append(inout p, bytes.slice(rest, cut, rest.len()))
                s = p
            }
            None => { return (t, List.new()) }
        }
    }
    match bytes.find_byte(s, 63, 0) {
        Some(i) => (bytes.slice(s, 0, i), bytes.slice(s, i + 1, s.len()))
        None => (s, List.new())
    }
}

// ---- percent-encoding (RFC 3986 2.1)

fn hexval(c: u8) -> i32 {
    if c >= 48 && c <= 57 { return (c - 48) as i32 }
    if c >= 97 && c <= 102 { return (c - 87) as i32 }
    if c >= 65 && c <= 70 { return (c - 55) as i32 }
    -1
}

/// `s` with `%XX` decoded (and `+` as a space when `plus`); None for a malformed escape.
pub fn pct_decode(s: List[u8], plus: bool) -> Option[List[u8]] {
    let mut out: List[u8] = List.new()
    let mut i: usize = 0
    while i < s.len() {
        let c = s[i]
        if c == 37 {
            if i + 2 >= s.len() { return None }
            let h = hexval(s[i + 1])
            let l = hexval(s[i + 2])
            if h < 0 || l < 0 { return None }
            out.push((h * 16 + l) as u8)
            i += 3
        } else if c == 43 && plus {
            out.push(32)
            i += 1
        } else {
            out.push(c)
            i += 1
        }
    }
    Some(out)
}

fn hex_upper(n: u8) -> u8 {
    if n < 10 { return 48 + n }
    55 + n
}

/// `s` percent-encoded for a path segment or a query value: everything but the unreserved
/// characters (ALPHA DIGIT `-` `.` `_` `~`) becomes `%XX`.
pub fn pct_encode(s: List[u8]) -> List[u8] {
    let mut out: List[u8] = List.new()
    for c in s {
        if bytes.is_alpha(c) || bytes.is_digit(c) || c == 45 || c == 46 || c == 95 || c == 126 {
            out.push(c)
        } else {
            out.push(37)
            out.push(hex_upper(c / 16))
            out.push(hex_upper(c % 16))
        }
    }
    out
}

// ---- status codes

/// The reason phrase of a status code ("" for an unknown one).
pub fn reason(status: i32) -> List[u8] {
    let r = match status {
        100 => "Continue"
        101 => "Switching Protocols"
        200 => "OK"
        201 => "Created"
        202 => "Accepted"
        204 => "No Content"
        206 => "Partial Content"
        301 => "Moved Permanently"
        302 => "Found"
        303 => "See Other"
        304 => "Not Modified"
        307 => "Temporary Redirect"
        308 => "Permanent Redirect"
        400 => "Bad Request"
        401 => "Unauthorized"
        403 => "Forbidden"
        404 => "Not Found"
        405 => "Method Not Allowed"
        406 => "Not Acceptable"
        408 => "Request Timeout"
        409 => "Conflict"
        410 => "Gone"
        411 => "Length Required"
        412 => "Precondition Failed"
        413 => "Content Too Large"
        414 => "URI Too Long"
        415 => "Unsupported Media Type"
        417 => "Expectation Failed"
        422 => "Unprocessable Content"
        429 => "Too Many Requests"
        431 => "Request Header Fields Too Large"
        500 => "Internal Server Error"
        501 => "Not Implemented"
        502 => "Bad Gateway"
        503 => "Service Unavailable"
        504 => "Gateway Timeout"
        505 => "HTTP Version Not Supported"
        _ => ""
    }
    sys.lit(r)
}

/// Whether a response with this status never has a body (1xx, 204, 304).
pub fn bodyless(status: i32) -> bool { (status >= 100 && status < 200) || status == 204 || status == 304 }

// ---- writing

/// Err with the first header a program set that can't be written: a name that isn't a
/// token, or a value with CR, LF or another control character (header injection).
pub fn check_headers(hs: List[Header]) -> Result[bool, String] {
    for h in hs {
        if !is_token(h.name) {
            let mut m = String.from("invalid header name ")
            m.append(sys.to_string(json_ish(h.name)))
            return Err(m)
        }
        if !valid_value(h.value) {
            let mut m = String.from("invalid value for header ")
            m.append(sys.to_string(h.name))
            return Err(m)
        }
    }
    Ok(true)
}

// `s` with bytes outside printable ASCII as `\xNN`, quoted (for messages)
fn json_ish(s: List[u8]) -> List[u8] {
    let mut out = sys.lit("\"")
    for c in s {
        if c >= 32 && c < 127 && c != 34 && c != 92 {
            out.push(c)
        } else {
            bytes.append(inout out, sys.lit("\\x"))
            out.push(hex_upper(c / 16))
            out.push(hex_upper(c % 16))
        }
    }
    out.push(34)
    out
}

fn is_framing(name: List[u8]) -> bool {
    eq_ci(name, sys.lit("content-length")) || eq_ci(name, sys.lit("transfer-encoding")) || eq_ci(name, sys.lit("connection"))
}

fn put_header(inout out: List[u8], name: List[u8], value: List[u8]) {
    bytes.append(inout out, name)
    out.push(58)
    out.push(32)
    bytes.append(inout out, value)
    out.push(13)
    out.push(10)
}

/// A response as bytes: the status line, the program's headers (minus framing headers),
/// `Date` (when `date` is not empty and the program didn't set one), `Content-Length`
/// (none for 1xx and 204; for HEAD and 304 the length the body would have),
/// `Connection: close` when `keep_alive` is false, then the body unless `head_only` or the
/// status is bodyless. Err when a header can't be written (check_headers).
pub fn write_response(r: Response, head_only: bool, keep_alive: bool, date: List[u8]) -> Result[List[u8], String] {
    check_headers(r.headers)?
    if r.status < 100 || r.status > 999 { return Err(String.from("invalid status code")) }
    let mut out = sys.lit("HTTP/1.1 ")
    bytes.append(inout out, bytes.from_u64(r.status as u64))
    out.push(32)
    bytes.append(inout out, reason(r.status))
    out.push(13)
    out.push(10)
    for h in r.headers {
        if !is_framing(h.name) { put_header(inout out, h.name, h.value) }
    }
    if date.len() > 0 && count(r.headers, sys.lit("date")) == 0 { put_header(inout out, sys.lit("Date"), date) }
    if !((r.status >= 100 && r.status < 200) || r.status == 204) {
        put_header(inout out, sys.lit("Content-Length"), bytes.from_u64(r.body.len() as u64))
    }
    if !keep_alive { put_header(inout out, sys.lit("Connection"), sys.lit("close")) }
    out.push(13)
    out.push(10)
    if !head_only && !bodyless(r.status) { bytes.append(inout out, r.body) }
    Ok(out)
}

/// A request as bytes: the request line, `Host: <host>` (unless the program set one), the
/// program's headers (minus framing headers), `Content-Length` when there is a body or the
/// method usually has one, `Connection: close` when `keep_alive` is false, then the body.
pub fn write_request(r: Request, host: List[u8], keep_alive: bool) -> Result[List[u8], String] {
    check_headers(r.headers)?
    if !is_token(r.method) { return Err(String.from("invalid method")) }
    if r.target.len() == 0 { return Err(String.from("empty request target")) }
    for c in r.target {
        if c <= 32 || c >= 127 { return Err(String.from("invalid request target (encode it first)")) }
    }
    if !valid_value(host) { return Err(String.from("invalid host")) }
    let mut out = r.method.copy()
    out.push(32)
    bytes.append(inout out, r.target)
    bytes.append(inout out, sys.lit(" HTTP/1.1"))
    out.push(13)
    out.push(10)
    if count(r.headers, sys.lit("host")) == 0 { put_header(inout out, sys.lit("Host"), host) }
    for h in r.headers {
        if !is_framing(h.name) { put_header(inout out, h.name, h.value) }
    }
    let m = r.method
    if r.body.len() > 0 || bytes.eq(m, sys.lit("POST")) || bytes.eq(m, sys.lit("PUT")) || bytes.eq(m, sys.lit("PATCH")) {
        put_header(inout out, sys.lit("Content-Length"), bytes.from_u64(r.body.len() as u64))
    }
    if !keep_alive { put_header(inout out, sys.lit("Connection"), sys.lit("close")) }
    out.push(13)
    out.push(10)
    bytes.append(inout out, r.body)
    Ok(out)
}

fn hex_lower(n: usize) -> List[u8] {
    if n == 0 { return sys.lit("0") }
    let mut rev: List[u8] = List.new()
    let mut v = n.copy()
    while v > 0 {
        let d = (v % 16) as u8
        if d < 10 { rev.push(48 + d) } else { rev.push(87 + d) }
        v = v / 16
    }
    let mut out: List[u8] = List.new()
    let mut i = rev.len()
    while i > 0 {
        i -= 1
        out.push(rev[i])
    }
    out
}

/// `body` in the chunked transfer coding, `size` bytes per chunk (at least 1), with the
/// last chunk and no trailers.
pub fn chunked(body: List[u8], size: usize) -> List[u8] {
    let step: usize = if size == 0 { 1 } else { size }
    let mut out: List[u8] = List.new()
    let mut i: usize = 0
    while i < body.len() {
        let end = if i + step < body.len() { i + step } else { body.len() }
        bytes.append(inout out, hex_lower(end - i))
        out.push(13)
        out.push(10)
        bytes.append(inout out, bytes.slice(body, i, end))
        out.push(13)
        out.push(10)
        i = end
    }
    out.push(48)
    for k in 0..2 {
        out.push(13)
        out.push(10)
    }
    out
}

// ---- dates (RFC 9110 5.6.7, IMF-fixdate)

fn two(inout out: List[u8], n: i64) {
    out.push((48 + n / 10) as u8)
    out.push((48 + n % 10) as u8)
}

/// Seconds since the Unix epoch as an IMF-fixdate: "Sun, 06 Nov 1994 08:49:37 GMT".
pub fn imf_date(unix: i64) -> List[u8] {
    let secs: i64 = if unix < 0 { 0 } else { unix }
    let days = secs / 86400
    let rem = secs % 86400
    // civil_from_days (H. Hinnant), for days >= 0
    let z = days + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = if mp < 10 { mp + 3 } else { mp - 9 }
    let jan: i64 = if m <= 2 { 1 } else { 0 }
    let y = yoe + era * 400 + jan
    let wd = sys.lit("Thu~Fri~Sat~Sun~Mon~Tue~Wed")
    let mn = sys.lit("Jan~Feb~Mar~Apr~May~Jun~Jul~Aug~Sep~Oct~Nov~Dec")
    let mut out = bytes.split(wd, 126)[(days % 7) as usize]
    bytes.append(inout out, sys.lit(", "))
    two(inout out, d)
    out.push(32)
    bytes.append(inout out, bytes.split(mn, 126)[(m - 1) as usize])
    out.push(32)
    bytes.append(inout out, bytes.from_i64(y))
    out.push(32)
    two(inout out, rem / 3600)
    out.push(58)
    two(inout out, (rem / 60) % 60)
    out.push(58)
    two(inout out, rem % 60)
    bytes.append(inout out, sys.lit(" GMT"))
    out
}

// http/client: a minimal blocking HTTP/1.1 client with deadlines: for tests, tools and
// calling other services. A `Conn` is one connection at a time to one address, kept alive
// between requests while the server allows it; when the server (or `close`) ended it, the
// next request connects again. Every call takes a time.Deadline that bounds the whole
// exchange (connecting, sending, reading the response).
//
// Not here yet (docs/services.md "Next steps"): TLS (C3: use a proxy), connection pools,
// redirects, automatic retries (a request on a reused connection that the server had
// already closed fails with Err; send it again on a new Conn if it is idempotent), streaming
// bodies, and name resolution with deadlines (std/net.lookup blocks; pass an Addr).

import "core/sys"
import "std/bytes"
import "std/fd"
import "std/net"
import "std/time"
import "http.ei"
import "parse.ei"
import "sock.ei"

/// A connection to `addr`. `host` is what goes in the Host header ("127.0.0.1:8080");
/// `open` says whether a connection is up now.
pub type Conn = { fd: i32, addr: net.Addr, host: List[u8], lim: http.Limits, parser: parse.Parser, open: bool }

/// Connects to `a` before `dl` (non-blocking connect, then a wait for it).
pub fn connect(a: net.Addr, dl: time.Deadline) -> Result[Conn, String] uses net, io, clock {
    connect_with(a, http.limits(), dl)
}

/// `connect`, with limits on the responses it will read.
pub fn connect_with(a: net.Addr, lim: http.Limits, dl: time.Deadline) -> Result[Conn, String] uses net, io, clock {
    let s = dial(a, dl)?
    Ok(Conn(s, a, net.text(a), lim, parse.responses(lim), true))
}

fn dial(a: net.Addr, dl: time.Deadline) -> Result[i32, String] uses net, io, clock {
    let s = net.socket(a.family, net.STREAM, true)?
    match finish_connect(s, a, dl) {
        Ok(b) => {}
        Err(e) => {
            fd.close(s)
            return Err(e)
        }
    }
    let z = net.set_option(s, net.NODELAY, 1)
    Ok(s)
}

fn finish_connect(s: i32, a: net.Addr, dl: time.Deadline) -> Result[bool, String] uses net, io, clock {
    if net.connect(s, a)? { return Ok(true) }
    if !fd.wait_ready(s, fd.READY_WRITE, dl)? { return Err(String.from("connect: deadline exceeded")) }
    net.connect_result(s)
}

impl Conn {
    /// Sends `req` and reads its response (skipping 1xx interim responses), connecting
    /// first if no connection is up. The connection is closed afterwards when either side
    /// asked for it. On Err the connection is closed too (its state is unknown).
    fn request(inout self, req: http.Request, dl: time.Deadline) -> Result[http.Response, String] uses net, io, clock {
        if !self.open {
            self.fd = dial(self.addr, dl)?
            self.parser = parse.responses(self.lim)
            self.open = true
        }
        let wire = http.write_request(req, self.host, req.keep_alive)?
        if !sock.send_by(self.fd, wire, dl) {
            self.close()
            return Err(String.from("send: deadline exceeded or connection closed"))
        }
        let head = req.method.len() == 4 && bytes.eq(req.method, sys.lit("HEAD"))
        while true {
            if head { self.parser.expect_no_body() }
            match self.read_one(dl) {
                Ok(r) => {
                    if r.status >= 100 && r.status < 200 && r.status != 101 { continue }
                    if !r.keep_alive || !req.keep_alive { self.close() }
                    return Ok(r)
                }
                Err(e) => {
                    self.close()
                    return Err(e)
                }
            }
        }
        Err(String.from("unreachable"))
    }

    fn read_one(inout self, dl: time.Deadline) -> Result[http.Response, String] uses net, io, clock {
        while true {
            match self.parser.next() {
                parse.Done(m) => { return Ok(parse.to_response(m)) }
                parse.Bad(st, why) => { return Err(bad(why)) }
                parse.More => {}
            }
            if !fd.wait_ready(self.fd, fd.READY_READ, dl)? { return Err(String.from("response: deadline exceeded")) }
            match net.try_recv(self.fd, 65536)? {
                Some(b) => {
                    if b.len() == 0 {
                        match self.parser.eof() {
                            parse.Done(m) => { return Ok(parse.to_response(m)) }
                            parse.Bad(st, why) => { return Err(bad(why)) }
                            parse.More => { return Err(String.from("connection closed before a response")) }
                        }
                    }
                    self.parser.feed(b)
                }
                None => {}
            }
        }
        Err(String.from("unreachable"))
    }

    /// Closes the connection (idempotent).
    fn close(inout self) uses io {
        if self.open {
            fd.close(self.fd)
            self.open = false
        }
    }
}

fn bad(why: List[u8]) -> String {
    var m = String.from("invalid response: ")
    m.append(sys.to_string(why))
    m
}

/// One request on a new connection, closed afterwards.
pub fn fetch(a: net.Addr, req: http.Request, dl: time.Deadline) -> Result[http.Response, String] uses net, io, clock {
    var c = connect(a, dl)?
    var r = req
    r.keep_alive = false
    let resp = c.request(r, dl)
    c.close()
    resp
}

/// GET `target` (one-shot).
pub fn get(a: net.Addr, target: str, dl: time.Deadline) -> Result[http.Response, String] uses net, io, clock {
    fetch(a, http.request("GET", sys.lit(target)), dl)
}

/// POST `body` with `content_type` to `target` (one-shot).
pub fn post(a: net.Addr, target: str, content_type: str, body: List[u8], dl: time.Deadline) -> Result[http.Response, String] uses net, io, clock {
    var r = http.request("POST", sys.lit(target))
    r.set_header("Content-Type", sys.lit(content_type))
    r.body = body
    fetch(a, r, dl)
}

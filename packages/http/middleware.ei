//! http/middleware: handler wrappers. Each takes a handler (`fn(http.Request) ->
//! http.Response`) and returns one that does something before and after it, so they compose
//! by nesting, outermost first, and apply to a whole service (wrap the router's handler) or
//! to one route (wrap that route's handler):
//!
//!     let app = middleware.request_id(ids,
//!         middleware.access_log(log,
//!             m.wrap(
//!                 middleware.problems(
//!                     middleware.cors(cors, router.handler(r))))))
//!     r.post("/upload", middleware.body_limit(4096, upload))       // per route
//!
//! What is here:
//! - `request_id`: an id per request (the client's `X-Request-Id` when it is a short token,
//!   else `<prefix>-<n>`), in `req.get_ctx("request_id")` and the response's `X-Request-Id`.
//! - `access_log`: one JSON line per request to a `stream.Writer` held in a `sync.Lock`.
//! - `errors`: a handler that returns `Result[http.Response, problem.ApiError]` as an ordinary
//!   handler (an Err is its problem+json response): errors are values, never panics.
//! - `problems`: the package's plain-text error responses (`http.error_response`: the router's
//!   404 and 405, ...) as problem+json; other responses are untouched.
//! - `body_limit`: 413 for a body longer than a route accepts (the parser's `max_body` is the
//!   server-wide ceiling; this is per route, after the body has been read: bodies are not
//!   streams yet).
//! - `timeout`: the handler runs on a worker of a given `task.Pool` and must answer by the
//!   deadline, else 503; `req.deadline` tells it when that is.
//! - `cors`: CORS (preflights answered here, the allowed origin echoed on other responses).
//! - `bearer`, `basic`: authentication hooks: a check function says who a token or a user and
//!   password is; the principal goes in `req.get_ctx("principal")` for the handler and in the
//!   response's `ctx` for the layers outside (the access log), a failure is 401 with
//!   `WWW-Authenticate`.
//! Metrics (counters and latency histograms in the Prometheus text format) are http/metrics.
//!
//! None of this can contain a trap: a handler that panics or overflows still ends the
//! process (docs/services.md N5). `errors` is the way not to need one.

import "core/sys"
import "std/bytes"
import "std/atomic"
import "std/encoding"
import "std/random"
import "std/stream"
import "std/sync"
import "std/task"
import "std/time"
import "json"
import "http.ei"
import "problem.ei"

/// Applies `layers` to `h`, the first one outermost: `chain(h, [a, b])` is `a(b(h))`.
pub fn chain(h: http.Handler, layers: List[http.Middleware]) -> http.Handler {
    let mut out = h.copy()
    let mut i = layers.len()
    while i > 0 {
        i -= 1
        let l = layers[i]
        out = l(out)
    }
    out
}

// ---- request ids

/// Where request ids come from: `<prefix>-<n>` with a counter shared by copies.
pub type Ids = { prefix: List[u8], next: atomic.Atomic }

/// Ids `<prefix>-1`, `<prefix>-2`, ... (a fixed prefix: for tests, or one instance).
pub fn ids(prefix: str) -> Ids { Ids(sys.lit(prefix), atomic.new(0)) }

/// Ids with a random 8-byte hex prefix, so ids from different processes don't collide.
pub fn random_ids() -> Result[Ids, String] uses io {
    let b = random.bytes(8)?
    Ok(Ids(encoding.hex(b).bytes(), atomic.new(0)))
}

impl Ids {
    /// The next id.
    fn next(self) -> List[u8] {
        let n = self.next.add(1, atomic.Relaxed) + 1
        let mut out = self.prefix.copy()
        out.push(45)
        bytes.append(inout out, bytes.from_i64(n))
        out
    }
}

/// Whether a client's request id is acceptable: 1 to 128 bytes of letters, digits and
/// `-._:` (anything else could forge log lines or headers downstream).
pub fn valid_id(s: List[u8]) -> bool {
    if s.len() == 0 || s.len() > 128 { return false }
    for c in s {
        if !(bytes.is_alpha(c) || bytes.is_digit(c) || c == 45 || c == 46 || c == 95 || c == 58) { return false }
    }
    true
}

/// Gives every request an id (see the module comment).
pub fn request_id(ids: Ids, h: http.Handler) -> http.Handler {
    |req: http.Request| -> http.Response {
        let id = match req.header("x-request-id") {
            Some(v) => if valid_id(v) { v } else { ids.next() }
            None => ids.next()
        }
        let mut r = req.copy()
        r.set_ctx("request_id", id)
        let mut resp = h(r)
        if resp.header("x-request-id").is_none() { resp.set_header("X-Request-Id", id) }
        resp
    }
}

// ---- access log

/// Seconds since the epoch (with nanoseconds) as RFC 3339 UTC with milliseconds:
/// "2026-10-31T09:15:02.250Z".
pub fn rfc3339(unix_ns: i64) -> List[u8] {
    let ns: i64 = if unix_ns < 0 { 0 } else { unix_ns }
    let secs = ns / 1000000000
    let ms = (ns / 1000000) % 1000
    let days = secs / 86400
    let rem = secs % 86400
    // civil_from_days (H. Hinnant), for days >= 0
    let z = days + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = if mp < 10 { mp + 3 } else { mp - 9 }
    let jan: i64 = if m <= 2 { 1 } else { 0 }
    let y = yoe + era * 400 + jan
    let mut out: List[u8] = List.new()
    digits(inout out, y, 4)
    out.push(45)
    digits(inout out, m, 2)
    out.push(45)
    digits(inout out, d, 2)
    out.push(84)
    digits(inout out, rem / 3600, 2)
    out.push(58)
    digits(inout out, (rem / 60) % 60, 2)
    out.push(58)
    digits(inout out, rem % 60, 2)
    out.push(46)
    digits(inout out, ms, 3)
    out.push(90)
    out
}

fn digits(inout out: List[u8], n: i64, width: usize) {
    let s = bytes.from_i64(n)
    let mut k = s.len()
    while k < width {
        out.push(48)
        k += 1
    }
    bytes.append(inout out, s)
}

/// One access-log line (without the newline): time, request id, peer, method, path, query,
/// status, body bytes sent, duration in microseconds.
pub fn log_line(unix_ns: i64, req: http.Request, resp: http.Response, dur_ns: i64) -> List[u8] {
    let mut out = sys.lit("{\"time\":")
    json.quote_into(inout out, rfc3339(unix_ns))
    let id = match req.get_ctx("request_id") {
        Some(v) => v
        None => resp.header("x-request-id").unwrap_or(List.new())
    }
    bytes.append(inout out, sys.lit(",\"id\":"))
    json.quote_into(inout out, id)
    bytes.append(inout out, sys.lit(",\"peer\":"))
    json.quote_into(inout out, req.peer)
    bytes.append(inout out, sys.lit(",\"method\":"))
    json.quote_into(inout out, req.method)
    bytes.append(inout out, sys.lit(",\"path\":"))
    json.quote_into(inout out, req.path)
    if req.query.len() > 0 {
        bytes.append(inout out, sys.lit(",\"query\":"))
        json.quote_into(inout out, req.query)
    }
    bytes.append(inout out, sys.lit(",\"status\":"))
    bytes.append(inout out, bytes.from_i64(resp.status as i64))
    bytes.append(inout out, sys.lit(",\"bytes\":"))
    bytes.append(inout out, bytes.from_u64(resp.body.len() as u64))
    bytes.append(inout out, sys.lit(",\"duration_us\":"))
    bytes.append(inout out, bytes.from_i64(dur_ns / 1000))
    let who = match req.get_ctx("principal") {
        Some(p) => Some(p)
        None => resp.get_ctx("principal")
    }
    match who {
        Some(p) => {
            bytes.append(inout out, sys.lit(",\"principal\":"))
            json.quote_into(inout out, p)
        }
        None => {}
    }
    out.push(125)
    out
}

/// Writes one JSON line per request to the writer in `out` (see `log_line`), after the
/// response is made. The Lock makes lines from different workers whole; a write that fails
/// is dropped (a request doesn't fail because its log line couldn't be written). Put it
/// inside `request_id` to log the id.
pub fn access_log[W: stream.Writer + Copy](out: sync.Lock[W], h: http.Handler) -> http.Handler uses io, clock {
    |req: http.Request| -> http.Response {
        let t0 = time.mono_ns()
        let resp = h(req)
        let mut line = log_line(time.wall_ns(), req, resp, time.mono_ns() - t0)
        line.push(10)
        out.update(|w: W| -> W {
            let mut v = w.copy()
            match stream.write_all(inout v, line) {
                Ok(z) => {
                    let f = v.flush()
                }
                Err(e) => {}
            }
            v
        })
        resp
    }
}

// ---- errors as values

/// A handler that returns an ApiError instead of failing, as an ordinary handler: an Err is
/// answered with its problem+json response.
pub fn errors(h: fn(http.Request) -> Result[http.Response, problem.ApiError]) -> http.Handler {
    |req: http.Request| -> http.Response {
        match h(req) {
            Ok(r) => r
            Err(e) => e.response()
        }
    }
}

/// Whether `r` is exactly what `http.error_response(r.status)` makes.
fn is_plain_error(r: http.Response) -> bool {
    if r.status < 400 { return false }
    let ct = r.header("content-type").unwrap_or(List.new())
    bytes.eq(ct, sys.lit("text/plain; charset=utf-8")) && bytes.eq(r.body, http.error_response(r.status).body)
}

/// The package's plain-text error responses as problem+json (headers such as `Allow` and
/// `Retry-After` kept); every other response unchanged.
pub fn problems(h: http.Handler) -> http.Handler {
    |req: http.Request| -> http.Response {
        let r = h(req)
        if !is_plain_error(r) { return r }
        let mut p = problem.with_detail(r.status, List.new()).response()
        for x in r.headers {
            if !http.eq_ci(x.name, sys.lit("content-type")) { p.headers.push(x) }
        }
        p.keep_alive = r.keep_alive
        p.ctx = r.ctx
        p
    }
}

// ---- limits per route

/// 413 (problem+json) when the body is longer than `max` bytes.
pub fn body_limit(max: usize, h: http.Handler) -> http.Handler {
    |req: http.Request| -> http.Response {
        if req.body.len() <= max { return h(req) }
        let mut d = sys.lit("the body is ")
        bytes.append(inout d, bytes.from_u64(req.body.len() as u64))
        bytes.append(inout d, sys.lit(" bytes; this route takes at most "))
        bytes.append(inout d, bytes.from_u64(max as u64))
        problem.with_detail(413, d).response()
    }
}

/// Runs `h` on a worker of `pool` and waits for its answer until `d` from now (or the
/// request's own deadline, if earlier), which it also puts in `req.deadline`. If the answer
/// is late, or the pool's queue stays full until then, the response is 503 (problem+json,
/// `Connection: close`). A late handler can't be interrupted (nothing can be, before
/// stackless tasks: docs/services.md N5, N6): it runs to its end on its worker and its
/// answer is dropped, so a pool of its own per route bounds how many threads slow
/// handlers can hold; a handler that waits on something should wait until `req.deadline`.
pub fn timeout(d: time.Duration, pool: task.Pool, h: http.Handler) -> http.Handler uses io, clock {
    |req: http.Request| -> http.Response {
        let dl = time.after(d).earlier(req.deadline)
        let mut r = req.copy()
        r.deadline = dl
        let late = |why: str| -> http.Response {
            let mut msg = sys.lit(why)
            bytes.append(inout msg, bytes.from_i64(d.as_ms()))
            bytes.append(inout msg, sys.lit(" ms"))
            let mut resp = problem.with_detail(503, msg).response()
            resp.keep_alive = false
            resp
        }
        match pool.run(|| -> http.Response { h(r) }, dl) {
            Ok(fut) => {
                match fut.get(dl) {
                    Some(resp) => resp
                    None => late("the handler did not answer within ")
                }
            }
            Err(e) => late("no worker was free within ")
        }
    }
}

// ---- CORS

/// What cross-origin requests are allowed (Fetch standard, "CORS protocol").
/// `origins`: exact origins ("https://app.example.com"); `any`: every origin (`*`, or the
/// origin echoed when `credentials`). `methods` and `headers` answer preflights; `expose`
/// lists response headers a page may read; `max_age` is how long (s) a preflight is cached.
pub type Cors = {
    origins: List[List[u8]],
    any: bool,
    methods: List[List[u8]],
    headers: List[List[u8]],
    expose: List[List[u8]],
    credentials: bool,
    max_age: i64,
}

/// No origin allowed yet; methods GET, HEAD, POST, PUT, PATCH, DELETE; request headers
/// Content-Type, Authorization, X-Request-Id; `X-Request-Id` exposed; preflights cached 10
/// minutes; no credentials.
pub fn cors_config() -> Cors {
    let mut ms: List[List[u8]] = List.new()
    for m in ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"] { ms.push(sys.lit(m)) }
    let mut hs: List[List[u8]] = List.new()
    for x in ["content-type", "authorization", "x-request-id"] { hs.push(sys.lit(x)) }
    let mut ex: List[List[u8]] = List.new()
    ex.push(sys.lit("x-request-id"))
    Cors(List.new(), false, ms, hs, ex, false, 600)
}

impl Cors {
    fn allow_origin(self, origin: str) -> Cors {
        let mut c = self.copy()
        c.origins.push(sys.lit(origin))
        c
    }

    fn allow_any_origin(self) -> Cors {
        let mut c = self.copy()
        c.any = true
        c
    }

    fn allow_header(self, name: str) -> Cors {
        let mut c = self.copy()
        c.headers.push(http.lower(sys.lit(name)))
        c
    }

    fn expose_header(self, name: str) -> Cors {
        let mut c = self.copy()
        c.expose.push(sys.lit(name))
        c
    }

    fn with_credentials(self) -> Cors {
        let mut c = self.copy()
        c.credentials = true
        c
    }

    fn origin_ok(self, o: List[u8]) -> bool {
        if self.any { return true }
        for x in self.origins {
            if bytes.eq(x, o) { return true }
        }
        false
    }

    fn method_ok(self, m: List[u8]) -> bool {
        for x in self.methods {
            if bytes.eq(x, m) { return true }
        }
        false
    }

    fn header_ok(self, name: List[u8]) -> bool {
        for x in self.headers {
            if http.eq_ci(x, name) { return true }
        }
        false
    }

    /// The headers every CORS response to `origin` carries.
    fn base(self, inout r: http.Response, origin: List[u8]) {
        if self.any && !self.credentials {
            r.set_header("Access-Control-Allow-Origin", sys.lit("*"))
        } else {
            r.set_header("Access-Control-Allow-Origin", origin)
            add_vary(inout r, sys.lit("Origin"))
        }
        if self.credentials { r.set_header("Access-Control-Allow-Credentials", sys.lit("true")) }
    }
}

/// Adds `v` to the response's Vary header.
fn add_vary(inout r: http.Response, v: List[u8]) {
    match r.header("vary") {
        Some(old) => {
            for t in http.list_items(old) {
                if http.eq_ci(t, v) || bytes.eq(t, sys.lit("*")) { return }
            }
            let mut nv = old.copy()
            bytes.append(inout nv, sys.lit(", "))
            bytes.append(inout nv, v)
            r.headers = http.without(r.headers, sys.lit("vary"))
            r.headers.push(http.Header(sys.lit("Vary"), nv))
        }
        None => r.set_header("Vary", v)
    }
}

/// CORS (see Cors). A request without `Origin` passes through untouched. A preflight
/// (`OPTIONS` with `Origin` and `Access-Control-Request-Method`) is answered here: 204 with
/// the allowed methods, headers and max age when the origin, the method and every requested
/// header are allowed, else 403 (problem+json). Any other request from an allowed origin gets
/// `Access-Control-Allow-Origin` (and `-Expose-Headers`, `-Allow-Credentials`, `Vary: Origin`)
/// on its response; from another origin it gets none, so the browser hides the response.
pub fn cors(c: Cors, h: http.Handler) -> http.Handler {
    |req: http.Request| -> http.Response {
        let origin = match req.header("origin") {
            Some(o) => o
            None => { return h(req) }
        }
        let want = req.header("access-control-request-method")
        if bytes.eq(req.method, sys.lit("OPTIONS")) && want.is_some() {
            let m = want.unwrap()
            let mut ok = c.origin_ok(origin) && c.method_ok(m)
            let mut asked: List[List[u8]] = List.new()
            match req.header("access-control-request-headers") {
                Some(v) => {
                    for t in http.list_items(v) {
                        if !c.header_ok(t) { ok = false }
                        asked.push(http.lower(t))
                    }
                }
                None => {}
            }
            if !ok { return problem.forbidden("CORS preflight refused: origin, method or headers not allowed").response() }
            let mut r = http.response(204)
            c.base(inout r, origin)
            r.set_header("Access-Control-Allow-Methods", bytes.join(c.methods, sys.lit(", ")))
            if asked.len() > 0 { r.set_header("Access-Control-Allow-Headers", bytes.join(asked, sys.lit(", "))) }
            r.set_header("Access-Control-Max-Age", bytes.from_i64(c.max_age))
            return r
        }
        let mut r = h(req)
        if c.origin_ok(origin) {
            c.base(inout r, origin)
            if c.expose.len() > 0 { r.set_header("Access-Control-Expose-Headers", bytes.join(c.expose, sys.lit(", "))) }
        } else if !c.any {
            add_vary(inout r, sys.lit("Origin"))
        }
        r
    }
}

// ---- authentication hooks

fn challenge(scheme: str, realm: List[u8], extra: str, detail: str) -> http.Response {
    let mut r = problem.unauthorized(detail).response()
    let mut v = sys.lit(scheme)
    bytes.append(inout v, sys.lit(" realm=\""))
    bytes.append(inout v, realm)
    v.push(34)
    bytes.append(inout v, sys.lit(extra))
    r.set_header("WWW-Authenticate", v)
    r
}

/// The credentials of an `Authorization: <scheme> <credentials>` header (scheme compared
/// case-insensitively); None when absent or another scheme.
pub fn credentials(req: http.Request, scheme: str) -> Option[List[u8]] {
    let v = req.header("authorization")?
    let s = sys.lit(scheme)
    if v.len() <= s.len() + 1 || v[s.len()] != 32 { return None }
    if !http.eq_ci(bytes.slice(v, 0, s.len()), s) { return None }
    let c = http.trim_ows(bytes.slice(v, s.len() + 1, v.len()))
    if c.len() == 0 { return None }
    Some(c)
}

/// Bearer tokens (RFC 6750): `check(token)` is the principal (a user or client id) for a
/// valid token, None otherwise. No or another kind of credentials: 401 with
/// `WWW-Authenticate: Bearer realm="<realm>"`; a token `check` refuses: 401 with
/// `error="invalid_token"`. Otherwise the principal is `req.get_ctx("principal")`.
pub fn bearer(realm: str, check: fn(List[u8]) -> Option[List[u8]], h: http.Handler) -> http.Handler {
    bearer_in(sys.lit(realm), check, h)
}

/// `bearer` with the realm as bytes.
pub fn bearer_in(rl: List[u8], check: fn(List[u8]) -> Option[List[u8]], h: http.Handler) -> http.Handler {
    |req: http.Request| -> http.Response {
        let tok = match credentials(req, "Bearer") {
            Some(t) => t
            None => { return challenge("Bearer", rl, "", "this operation needs a bearer token") }
        }
        match check(tok) {
            Some(who) => {
                let mut r = req.copy()
                r.set_ctx("principal", who)
                let mut resp = h(r)
                resp.set_ctx("principal", who)
                resp
            }
            None => challenge("Bearer", rl, ", error=\"invalid_token\"", "the bearer token is not valid")
        }
    }
}

/// A token check from a fixed table of (token, principal), compared in constant time.
pub fn token_table(entries: List[(List[u8], List[u8])]) -> fn(List[u8]) -> Option[List[u8]] {
    |tok: List[u8]| -> Option[List[u8]] {
        let mut found: Option[List[u8]] = None
        for e in entries {
            let (t, who) = e
            // every entry is compared, so the time doesn't say which one matched
            if http.eq_ct(t, tok) && found.is_none() { found = Some(who) }
        }
        found
    }
}

/// Basic authentication (RFC 7617): `check(user, password)` says whether they are valid;
/// the user is then the principal. Otherwise 401 with `WWW-Authenticate: Basic
/// realm="<realm>", charset="UTF-8"`. Only over TLS (a proxy's, C51): the password travels in
/// the clear.
pub fn basic(realm: str, check: fn(List[u8], List[u8]) -> bool, h: http.Handler) -> http.Handler {
    let rl = sys.lit(realm)
    |req: http.Request| -> http.Response {
        let raw = match credentials(req, "Basic") {
            Some(c) => c
            None => { return challenge("Basic", rl, ", charset=\"UTF-8\"", "this operation needs a user and password") }
        }
        let pair = match encoding.unbase64(raw) {
            Ok(p) => p
            Err(e) => { return challenge("Basic", rl, ", charset=\"UTF-8\"", "malformed Basic credentials") }
        }
        let colon = match bytes.find_byte(pair, 58, 0) {
            Some(i) => i
            None => { return challenge("Basic", rl, ", charset=\"UTF-8\"", "malformed Basic credentials") }
        }
        let user = bytes.slice(pair, 0, colon)
        let pass = bytes.slice(pair, colon + 1, pair.len())
        if !check(user, pass) { return challenge("Basic", rl, ", charset=\"UTF-8\"", "wrong user or password") }
        let mut r = req.copy()
        r.set_ctx("principal", user)
        let mut resp = h(r)
        resp.set_ctx("principal", user)
        resp
    }
}

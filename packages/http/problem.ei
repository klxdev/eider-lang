//! http/problem: API errors as values, written as Problem Details (RFC 9457,
//! `application/problem+json`).
//!
//! An `ApiError` is what a handler returns instead of panicking: a status, a short `title` (by
//! default the status's reason phrase, as RFC 9457 asks when `type` is "about:blank"), a
//! `detail` for this occurrence, and `errors`, the extension member that says which parts of
//! the request were wrong (`{"in": "body", "pointer": "#/title", "detail": "..."}` for the
//! body, `{"in": "query", "name": "limit", "detail": "..."}` for a parameter). Typed handlers
//! (packages/openapi) return `Result[U, ApiError]`; `middleware.errors` turns a handler that
//! returns `Result[http.Response, ApiError]` into an ordinary one, and `middleware.problems`
//! rewrites the package's plain-text error responses (404, 405, 413, ...) the same way, so a
//! service answers every error in one format.

import "core/sys"
import "std/bytes"
import "json"
import "http.ei"

/// The media type of a problem.
pub const MEDIA: str = "application/problem+json"

/// One wrong part of a request: `location` is "body", "path", "query" or "header"; `name` is
/// a JSON pointer into the body ("#/items/0/title") or the parameter's name.
pub type FieldError = { location: List[u8], name: List[u8], detail: List[u8] }

/// An API error (see the module comment). `type_uri` empty means "about:blank".
pub type ApiError = { status: i32, type_uri: List[u8], title: List[u8], detail: List[u8], errors: List[FieldError] }

/// An error with the status's reason phrase as its title and `detail`.
pub fn new(status: i32, detail: str) -> ApiError { with_detail(status, sys.lit(detail)) }

/// `new` with a computed detail.
pub fn with_detail(status: i32, detail: List[u8]) -> ApiError {
    let mut title = http.reason(status)
    if title.len() == 0 { title = sys.lit("Error") }
    ApiError(status, List.new(), title, detail, List.new())
}

pub fn bad_request(detail: str) -> ApiError { new(400, detail) }
pub fn unauthorized(detail: str) -> ApiError { new(401, detail) }
pub fn forbidden(detail: str) -> ApiError { new(403, detail) }
pub fn not_found(detail: str) -> ApiError { new(404, detail) }
pub fn conflict(detail: str) -> ApiError { new(409, detail) }
pub fn unprocessable(detail: str) -> ApiError { new(422, detail) }
pub fn internal(detail: str) -> ApiError { new(500, detail) }

impl ApiError {
    /// With a `type` URI (a page that documents this kind of error) and its own title.
    fn typed(self, uri: str, title: str) -> ApiError {
        let mut e = self.copy()
        e.type_uri = sys.lit(uri)
        e.title = sys.lit(title)
        e
    }

    /// With one more wrong part (see FieldError).
    fn field(self, location: str, name: List[u8], detail: List[u8]) -> ApiError {
        let mut e = self.copy()
        e.errors.push(FieldError(sys.lit(location), name, detail))
        e
    }

    /// The problem as JSON text (members in a fixed order: type, title, status, detail,
    /// errors).
    fn body(self) -> List[u8] {
        let mut out = sys.lit("{\"type\":")
        if self.type_uri.len() == 0 {
            json.quote_into(inout out, sys.lit("about:blank"))
        } else {
            json.quote_into(inout out, self.type_uri)
        }
        bytes.append(inout out, sys.lit(",\"title\":"))
        json.quote_into(inout out, self.title)
        bytes.append(inout out, sys.lit(",\"status\":"))
        bytes.append(inout out, bytes.from_i64(self.status as i64))
        if self.detail.len() > 0 {
            bytes.append(inout out, sys.lit(",\"detail\":"))
            json.quote_into(inout out, self.detail)
        }
        if self.errors.len() > 0 {
            bytes.append(inout out, sys.lit(",\"errors\":["))
            for i in 0..self.errors.len() {
                let f = self.errors[i]
                if i > 0 { out.push(44) }
                bytes.append(inout out, sys.lit("{\"in\":"))
                json.quote_into(inout out, f.location)
                if bytes.eq(f.location, sys.lit("body")) {
                    bytes.append(inout out, sys.lit(",\"pointer\":"))
                } else {
                    bytes.append(inout out, sys.lit(",\"name\":"))
                }
                json.quote_into(inout out, f.name)
                bytes.append(inout out, sys.lit(",\"detail\":"))
                json.quote_into(inout out, f.detail)
                out.push(125)
            }
            out.push(93)
        }
        out.push(125)
        out
    }

    /// The problem as a response (`application/problem+json`).
    fn response(self) -> http.Response {
        let st = if self.status < 100 || self.status > 999 { 500 } else { self.status }
        http.respond(st, MEDIA, self.body())
    }
}

/// A JSON pointer (RFC 6901) as a URI fragment: "#" then each token after "/", with `~` as
/// `~0` and `/` as `~1`.
pub fn pointer(tokens: List[List[u8]]) -> List[u8] {
    let mut out = sys.lit("#")
    for t in tokens {
        out.push(47)
        for c in t {
            if c == 126 {
                bytes.append(inout out, sys.lit("~0"))
            } else if c == 47 {
                bytes.append(inout out, sys.lit("~1"))
            } else {
                out.push(c)
            }
        }
    }
    out
}

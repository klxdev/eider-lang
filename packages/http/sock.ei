// http/sock: what the server and the client do on a connected socket: send everything
// before a deadline, and close gracefully. A socket here is non-blocking and written by one
// thread at a time.

import "std/bytes"
import "std/fd"
import "std/net"
import "std/time"

/// Sends all of `data` before `dl`: false if the deadline passed or the peer is gone.
pub fn send_by(c: i32, data: List[u8], dl: time.Deadline) -> bool uses net, io, clock {
    var rest = data
    while rest.len() > 0 {
        // writable means the next send takes at least one byte (no other thread writes `c`)
        match fd.wait_ready(c, fd.READY_WRITE, dl) {
            Ok(true) => {}
            Ok(false) => { return false }
            Err(e) => { return false }
        }
        match net.send(c, rest) {
            Ok(n) => { rest = bytes.slice(rest, n as usize, rest.len()) }
            Err(e) => { return false }
        }
    }
    true
}

/// Half-close, read and drop what the peer still sends until it closes, 64 KiB or `dl`,
/// then close: the peer reads our last response instead of a reset.
pub fn linger_close(c: i32, dl: time.Deadline) uses net, io, clock {
    let z = net.shutdown(c, net.SHUT_WRITE)
    var drained: usize = 0
    var going = true
    while going && drained < 65536 {
        match fd.wait_ready(c, fd.READY_READ, dl) {
            Ok(true) => {
                match net.try_recv(c, 16384) {
                    Ok(Some(b)) => {
                        if b.len() == 0 { going = false }
                        drained += b.len()
                    }
                    Ok(None) => {}
                    Err(e) => { going = false }
                }
            }
            Ok(false) => { going = false }
            Err(e) => { going = false }
        }
    }
    fd.close(c)
}

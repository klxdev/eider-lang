// http/parse: valid requests and responses, framing (Content-Length, chunked, until close,
// bodyless statuses), pipelining, keep-alive, incremental input (every message fed one byte
// at a time and in two pieces at every split point gives what the whole input gives), and a
// corpus of malformed and smuggling inputs with the status each is refused with.

import "core/sys"
import "std/bytes"
import "std/io"
import "../http.ei"
import "../parse.ei"

/// Test text: `\n` is CRLF, `~` a bare LF, `^` a bare CR.
fn wire(s: str) -> List[u8] {
    var out: List[u8] = List.new()
    for c in sys.lit(s) {
        if c == 10 {
            out.push(13)
            out.push(10)
        } else if c == 126 {
            out.push(10)
        } else if c == 94 {
            out.push(13)
        } else {
            out.push(c)
        }
    }
    out
}

fn show_msg(m: parse.Msg) -> List[u8] {
    var l: List[u8] = List.new()
    if m.method.len() > 0 {
        bytes.append(inout l, m.method)
        l.push(32)
        bytes.append(inout l, m.target)
    } else {
        bytes.append(inout l, bytes.from_u64(m.status as u64))
    }
    bytes.append(inout l, sys.lit(" v"))
    bytes.append(inout l, bytes.from_u64(m.version as u64))
    if m.keep_alive { bytes.append(inout l, sys.lit(" keep")) } else { bytes.append(inout l, sys.lit(" close")) }
    for h in m.headers {
        bytes.append(inout l, sys.lit(" ["))
        bytes.append(inout l, h.name)
        l.push(61)
        bytes.append(inout l, h.value)
        l.push(93)
    }
    bytes.append(inout l, sys.lit(" body="))
    bytes.append(inout l, m.body)
    l
}

fn show_step(s: parse.Step) -> List[u8] {
    match s {
        parse.More => sys.lit("more")
        parse.Done(m) => {
            var l = sys.lit("done ")
            bytes.append(inout l, show_msg(m))
            l
        }
        parse.Bad(st, why) => {
            var l = sys.lit("bad ")
            bytes.append(inout l, bytes.from_u64(st as u64))
            l.push(32)
            bytes.append(inout l, why)
            l
        }
    }
}

fn is_more(s: parse.Step) -> bool {
    match s {
        parse.More => true
        parse.Done(m) => false
        parse.Bad(a, b) => false
    }
}

/// Every message in `input` (fed in pieces of `piece` bytes; 0: all at once), then `eof`
/// when `close`, as one line per step.
fn run(response: bool, input: List[u8], piece: usize, close: bool) -> List[List[u8]] {
    var p = if response { parse.responses(http.limits()) } else { parse.requests(http.limits()) }
    var out: List[List[u8]] = List.new()
    var i: usize = 0
    var stop = false
    let step: usize = if piece == 0 { input.len() + 1 } else { piece }
    while !stop {
        if i < input.len() {
            let end = if i + step < input.len() { i + step } else { input.len() }
            p.feed(bytes.slice(input, i, end))
            i = end
        }
        var drained = false
        while !drained {
            let s = p.next()
            if is_more(s) {
                drained = true
            } else {
                out.push(show_step(s))
                match s {
                    parse.Bad(a, b) => {
                        drained = true
                        stop = true
                    }
                    parse.Done(m) => {}
                    parse.More => {}
                }
            }
        }
        if i >= input.len() && !stop {
            if close {
                let s = p.eof()
                if !is_more(s) { out.push(show_step(s)) }
            } else if !p.idle() {
                out.push(sys.lit("more"))
            }
            stop = true
        }
    }
    out
}

fn same(a: List[List[u8]], b: List[List[u8]]) -> bool {
    if a.len() != b.len() { return false }
    for i in 0..a.len() {
        if !bytes.eq(a[i], b[i]) { return false }
    }
    true
}

/// Prints what the whole input gives, and checks that byte-at-a-time and every two-piece
/// split give the same.
fn check(response: bool, input: List[u8], close: bool) uses io {
    let whole = run(response, input, 0, close)
    for l in whole { io.outln(l) }
    if !same(whole, run(response, input, 1, close)) { print("  MISMATCH fed byte by byte") }
    for k in 2..8 {
        if !same(whole, run(response, input, k as usize, close)) { print("  MISMATCH fed in small pieces") }
    }
}

/// `s` on one line: a newline shown as `\\n`.
fn shown(s: List[u8]) -> List[u8] {
    var out: List[u8] = List.new()
    for c in s {
        if c == 10 {
            out.push(92)
            out.push(110)
        } else {
            out.push(c)
        }
    }
    out
}

fn req(s: str) uses io {
    io.outln(bytes.concat(sys.lit("> "), shown(sys.lit(s))))
    check(false, wire(s), false)
}

fn resp(s: str, close: bool) uses io {
    io.outln(bytes.concat(sys.lit("< "), shown(sys.lit(s))))
    check(true, wire(s), close)
}

fn main() uses io {
    print("-- requests")
    req("GET / HTTP/1.1\nHost: a\n\n")
    req("GET /x?y=1&z HTTP/1.0\n\n")
    req("GET / HTTP/1.0\nConnection: keep-alive\n\n")
    req("GET / HTTP/1.1\nHost: a\nConnection: Close\n\n")
    req("GET / HTTP/1.1\nHost: a\nConnection: foo, close\n\n")
    req("POST /p HTTP/1.1\nHost: a\nContent-Length: 5\n\nhello")
    req("POST /p HTTP/1.1\nHost: a\nContent-Length: 0\n\n")
    req("POST /p HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\n\n5\nhello\n6;ext=1\n world\n0\n\n")
    req("POST /p HTTP/1.1\nHost: a\nTransfer-Encoding: Chunked\n\nA\n0123456789\n0\nTrailer-Field: x\n\n")
    req("PUT /p HTTP/1.1\nHost:   spaced\t \nX-Empty:\n\n")
    req("OPTIONS * HTTP/1.1\nHost: a\n\n")
    req("GET http://example.com/abs/path?q HTTP/1.1\nHost: example.com\n\n")
    req("\n\nGET /after-empty-lines HTTP/1.1\nHost: a\n\n")
    print("-- pipelining")
    req("GET /1 HTTP/1.1\nHost: a\n\nPOST /2 HTTP/1.1\nHost: a\nContent-Length: 3\n\nabcGET /3 HTTP/1.1\nHost: a\n\n")
    req("POST /c HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\n\n3\nabc\n0\n\nGET /next HTTP/1.1\nHost: a\n\n")
    print("-- incomplete")
    req("GET / HTTP/1.1\nHost: a\n")
    req("POST / HTTP/1.1\nHost: a\nContent-Length: 10\n\nabc")
    req("POST / HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\n\n5\nab")

    print("-- responses")
    resp("HTTP/1.1 200 OK\nContent-Length: 2\n\nhi", false)
    resp("HTTP/1.1 204 No Content\n\n", false)
    resp("HTTP/1.1 304 Not Modified\nContent-Length: 99\n\n", false)
    resp("HTTP/1.1 100 Continue\n\nHTTP/1.1 200 OK\nContent-Length: 1\n\nx", false)
    resp("HTTP/1.1 200 OK\nTransfer-Encoding: chunked\n\n2\nab\n0\n\n", false)
    resp("HTTP/1.1 200 OK\n\nuntil the end", true)
    resp("HTTP/1.0 200\nConnection: keep-alive\nContent-Length: 0\n\n", false)
    resp("HTTP/1.1 404 \nContent-Length: 0\n\n", false)
    resp("HTTP/1.1 200 OK\nContent-Length: 5\n\nab", true)
    resp("HTTP/1.1 200 OK\nTransfer-Encoding: gzip\n\nraw", true)
    // a response to HEAD has no body whatever it says
    var hp = parse.responses(http.limits())
    hp.expect_no_body()
    hp.feed(wire("HTTP/1.1 200 OK\nContent-Length: 10\n\n"))
    io.outln(show_step(hp.next()))

    print("-- malformed and smuggling")
    for s in corpus() {
        let l = bytes.concat(sys.lit("> "), shown(s))
        io.outln(l)
        check(false, wire_bytes(s), false)
    }

    print("-- limits")
    var lim = http.limits()
    lim.max_line = 32
    lim.max_headers = 2
    lim.max_head = 80
    lim.max_body = 8
    limited(lim, "GET /a-long-path-that-goes-past-the-limit HTTP/1.1\n\n")
    limited(lim, "GET / HTTP/1.1\nX-Long: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n\n")
    limited(lim, "GET / HTTP/1.1\nHost: a\nA: 1\nB: 2\n\n")
    limited(lim, "GET / HTTP/1.1\nA: 123456789012345678901234567\nB: 123456789012345678901234567\n\n")
    limited(lim, "POST / HTTP/1.1\nHost: a\nContent-Length: 9\n\n123456789")
    limited(lim, "POST / HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\n\n5\n12345\n4\n1234\n0\n\n")
    limited(lim, "POST / HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\n\n8\n12345678\n0\n\n")
    limited(lim, "POST / HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\n\n0\nT: 1\nU: 2\n\n")
    // a limit is hit before the head is complete (no end of line needed)
    var p = parse.requests(lim)
    p.feed(wire("GET /aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
    io.outln(show_step(p.next()))
    io.outln(show_step(p.next()))

    print("-- expect 100-continue")
    var e = parse.requests(http.limits())
    e.feed(wire("POST / HTTP/1.1\nHost: a\nExpect: 100-continue\nContent-Length: 2\n\n"))
    io.outln(show_step(e.next()))
    print(e.wants_continue())
    e.continue_sent()
    print(e.wants_continue())
    e.feed(sys.lit("ok"))
    io.outln(show_step(e.next()))

    print("-- requests become Request values")
    var rp = parse.requests(http.limits())
    rp.feed(wire("GET /users/42?name=a%20b&x=y+z&bad=%zz HTTP/1.1\nHost: h\nX-Thing: v\n\n"))
    match rp.next() {
        parse.Done(m) => {
            let r = parse.to_request(m)
            io.outln(r.path)
            io.outln(r.query)
            io.outln(r.header("x-thing").unwrap())
            io.outln(r.header("X-THING").unwrap())
            io.outln(r.query_param("name").unwrap())
            io.outln(r.query_param("x").unwrap())
            print(r.query_param("bad").is_none())
            print(r.query_param("missing").is_none())
        }
        parse.More => print("more?")
        parse.Bad(a, b) => io.outln(b)
    }
}

fn limited(lim: http.Limits, s: str) uses io {
    var p = parse.requests(lim)
    p.feed(wire(s))
    io.outln(show_step(p.next()))
}

fn wire_bytes(s: List[u8]) -> List[u8] {
    var out: List[u8] = List.new()
    for c in s {
        if c == 10 {
            out.push(13)
            out.push(10)
        } else if c == 126 {
            out.push(10)
        } else if c == 94 {
            out.push(13)
        } else if c == 96 {
            out.push(1)
        } else if c == 64 {
            out.push(127)
        } else if c == 36 {
            out.push(128)
        } else {
            out.push(c)
        }
    }
    out
}

/// Malformed requests (`\n` CRLF, `~` bare LF, `^` bare CR, `` ` `` 0x01, `@` 0x7F, `$` 0x80).
/// Each must be refused.
pub fn corpus() -> List[List[u8]] {
    var all: List[List[u8]] = List.new()
    all.push(sys.lit("GET / HTTP/1.1~Host: a~~"))
    all.push(sys.lit("GET / HTTP/1.1\nHost: a~\n"))
    all.push(sys.lit("GET / HTTP/1.1^Host: a\n\n"))
    all.push(sys.lit("GET / HTTP/1.1\nHost: a^\n\n"))
    all.push(sys.lit("GET / HTTP/1.1\nHost: a\nX: 1\n folded\n\n"))
    all.push(sys.lit("GET / HTTP/1.1\nHost: a\n\tX: tab-folded\n\n"))
    all.push(sys.lit("GET / HTTP/1.1\n Host: a\n\n"))
    all.push(sys.lit("GET / HTTP/1.1\nHost : a\n\n"))
    all.push(sys.lit("GET / HTTP/1.1\nHo st: a\n\n"))
    all.push(sys.lit("GET / HTTP/1.1\n: novalue\n\n"))
    all.push(sys.lit("GET / HTTP/1.1\nHost a\n\n"))
    all.push(sys.lit("GET / HTTP/1.1\nHost: a\nX: a`b\n\n"))
    all.push(sys.lit("GET / HTTP/1.1\nHost: a\nX: a@\n\n"))
    all.push(sys.lit("GET / HTTP/1.1\n\n"))
    all.push(sys.lit("GET / HTTP/1.1\nHost: a\nHost: b\n\n"))
    all.push(sys.lit("GET / HTTP/1.0\nHost: a\nHost: b\n\n"))
    all.push(sys.lit("GET  / HTTP/1.1\nHost: a\n\n"))
    all.push(sys.lit("GET / HTTP/1.1 \nHost: a\n\n"))
    all.push(sys.lit("GET /a b HTTP/1.1\nHost: a\n\n"))
    all.push(sys.lit("GET /#frag HTTP/1.1\nHost: a\n\n"))
    all.push(sys.lit("GET /$ HTTP/1.1\nHost: a\n\n"))
    all.push(sys.lit("G(T / HTTP/1.1\nHost: a\n\n"))
    all.push(sys.lit("GET / HTTP/1.2\nHost: a\n\n"))
    all.push(sys.lit("GET / HTTP/2.0\nHost: a\n\n"))
    all.push(sys.lit("GET / http/1.1\nHost: a\n\n"))
    all.push(sys.lit("GET / HTTP/1.10\nHost: a\n\n"))
    all.push(sys.lit("GET /\n\n"))
    all.push(sys.lit("GET\n\n"))
    all.push(sys.lit("\n\n\n\n\n\nGET / HTTP/1.1\nHost: a\n\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nContent-Length: 3\nContent-Length: 3\n\nabc"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nContent-Length: 3, 3\n\nabc"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nContent-Length: +3\n\nabc"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nContent-Length: -1\n\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nContent-Length: 0x3\n\nabc"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nContent-Length: 99999999999999999999999\n\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nContent-Length:\n\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nContent-Length: 3\nTransfer-Encoding: chunked\n\n0\n\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\nContent-Length: 3\n\n0\n\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\nTransfer-Encoding: chunked\n\n0\n\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nTransfer-Encoding: gzip\n\nabc"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nTransfer-Encoding: chunked, gzip\n\n0\n\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nTransfer-Encoding: gzip, chunked\n\n0\n\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nTransfer-Encoding: xchunked\n\n0\n\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nTransfer-Encoding:\n\n0\n\n"))
    all.push(sys.lit("POST / HTTP/1.0\nTransfer-Encoding: chunked\n\n0\n\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\n\nzz\n\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\n\n-1\n\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\n\n 5\nhello\n0\n\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\n\n5 x\nhello\n0\n\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\n\n5~hello\n0\n\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\n\n5\nhelloX\n0\n\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\n\n5\nhello~0\n\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\n\n1000000000000000\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\n\n5;e=`\nhello\n0\n\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\n\n0\nbad trailer\n\n"))
    all.push(sys.lit("POST / HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\n\n0\n folded: trailer\n\n"))
    all
}

-- requests
> GET / HTTP/1.1\nHost: a\n\n
done GET / v11 keep [host=a] body=
> GET /x?y=1&z HTTP/1.0\n\n
done GET /x?y=1&z v10 close body=
> GET / HTTP/1.0\nConnection: keep-alive\n\n
done GET / v10 keep [connection=keep-alive] body=
> GET / HTTP/1.1\nHost: a\nConnection: Close\n\n
done GET / v11 close [host=a] [connection=Close] body=
> GET / HTTP/1.1\nHost: a\nConnection: foo, close\n\n
done GET / v11 close [host=a] [connection=foo, close] body=
> POST /p HTTP/1.1\nHost: a\nContent-Length: 5\n\nhello
done POST /p v11 keep [host=a] [content-length=5] body=hello
> POST /p HTTP/1.1\nHost: a\nContent-Length: 0\n\n
done POST /p v11 keep [host=a] [content-length=0] body=
> POST /p HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\n\n5\nhello\n6;ext=1\n world\n0\n\n
done POST /p v11 keep [host=a] [transfer-encoding=chunked] body=hello world
> POST /p HTTP/1.1\nHost: a\nTransfer-Encoding: Chunked\n\nA\n0123456789\n0\nTrailer-Field: x\n\n
done POST /p v11 keep [host=a] [transfer-encoding=Chunked] body=0123456789
> PUT /p HTTP/1.1\nHost:   spaced	 \nX-Empty:\n\n
done PUT /p v11 keep [host=spaced] [x-empty=] body=
> OPTIONS * HTTP/1.1\nHost: a\n\n
done OPTIONS * v11 keep [host=a] body=
> GET http://example.com/abs/path?q HTTP/1.1\nHost: example.com\n\n
done GET http://example.com/abs/path?q v11 keep [host=example.com] body=
> \n\nGET /after-empty-lines HTTP/1.1\nHost: a\n\n
done GET /after-empty-lines v11 keep [host=a] body=
-- pipelining
> GET /1 HTTP/1.1\nHost: a\n\nPOST /2 HTTP/1.1\nHost: a\nContent-Length: 3\n\nabcGET /3 HTTP/1.1\nHost: a\n\n
done GET /1 v11 keep [host=a] body=
done POST /2 v11 keep [host=a] [content-length=3] body=abc
done GET /3 v11 keep [host=a] body=
> POST /c HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\n\n3\nabc\n0\n\nGET /next HTTP/1.1\nHost: a\n\n
done POST /c v11 keep [host=a] [transfer-encoding=chunked] body=abc
done GET /next v11 keep [host=a] body=
-- incomplete
> GET / HTTP/1.1\nHost: a\n
more
> POST / HTTP/1.1\nHost: a\nContent-Length: 10\n\nabc
more
> POST / HTTP/1.1\nHost: a\nTransfer-Encoding: chunked\n\n5\nab
more
-- responses
< HTTP/1.1 200 OK\nContent-Length: 2\n\nhi
done 200 v11 keep [content-length=2] body=hi
< HTTP/1.1 204 No Content\n\n
done 204 v11 keep body=
< HTTP/1.1 304 Not Modified\nContent-Length: 99\n\n
done 304 v11 keep [content-length=99] body=
< HTTP/1.1 100 Continue\n\nHTTP/1.1 200 OK\nContent-Length: 1\n\nx
done 100 v11 keep body=
done 200 v11 keep [content-length=1] body=x
< HTTP/1.1 200 OK\nTransfer-Encoding: chunked\n\n2\nab\n0\n\n
done 200 v11 keep [transfer-encoding=chunked] body=ab
< HTTP/1.1 200 OK\n\nuntil the end
done 200 v11 close body=until the end
< HTTP/1.0 200\nConnection: keep-alive\nContent-Length: 0\n\n
done 200 v10 keep [connection=keep-alive] [content-length=0] body=
< HTTP/1.1 404 \nContent-Length: 0\n\n
done 404 v11 keep [content-length=0] body=
< HTTP/1.1 200 OK\nContent-Length: 5\n\nab
bad 400 connection closed in the middle of a message
< HTTP/1.1 200 OK\nTransfer-Encoding: gzip\n\nraw
done 200 v11 close [transfer-encoding=gzip] body=raw
done 200 v11 keep [content-length=10] body=

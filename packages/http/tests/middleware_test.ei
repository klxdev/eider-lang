// http/middleware, http/problem and http/metrics, called directly (no sockets): request ids,
// the access log, errors as values, problem+json for the package's error responses, body
// limits, timeouts (a handler blocked on a channel the test releases after the 503: nothing
// sleeps), CORS preflights and responses, bearer and basic authentication, and the
// Prometheus exposition text.

import "core/sys"
import "std/bytes"
import "std/encoding"
import "std/io"
import "std/stream"
import "std/sync"
import "std/task"
import "std/time"
import "json"
import "../http.ei"
import "../router.ei"
import "../problem.ei"
import "../middleware.ei"
import "../metrics.ei"

fn lit(s: str) -> List[u8] { sys.lit(s) }

fn toks1(a: str) -> List[List[u8]] {
    let mut out: List[List[u8]] = List.new()
    out.push(lit(a))
    out
}

fn toks3(a: str, b: str, c: str) -> List[List[u8]] {
    let mut out = toks1(a)
    out.push(lit(b))
    out.push(lit(c))
    out
}

fn get(target: str) -> http.Request { http.request("GET", lit(target)) }

fn with_header(r: http.Request, name: str, v: str) -> http.Request {
    let mut q = r.copy()
    q.headers.push(http.Header(http.lower(lit(name)), lit(v)))
    q
}

fn show(r: http.Response) uses io {
    let mut l = bytes.from_u64(r.status as u64)
    l.push(32)
    for h in r.headers {
        bytes.append(inout l, h.name)
        l.push(61)
        bytes.append(inout l, h.value)
        l.push(32)
    }
    bytes.append(inout l, lit("| "))
    bytes.append(inout l, r.body)
    io.outln(l)
}

fn hello() -> fn(http.Request) -> http.Response {
    |q: http.Request| -> http.Response {
        let mut b = lit("hello")
        match q.get_ctx("request_id") {
            Some(id) => {
                bytes.append(inout b, lit(" id="))
                bytes.append(inout b, id)
            }
            None => {}
        }
        match q.get_ctx("principal") {
            Some(p) => {
                bytes.append(inout b, lit(" principal="))
                bytes.append(inout b, p)
            }
            None => {}
        }
        http.respond(200, "text/plain", b)
    }
}

fn main() uses io, clock, threads {
    print("-- problems")
    let p = problem.bad_request("two fields are wrong").field("body", problem.pointer(toks1("title")), lit("is required")).field("query", lit("limit"), lit("must be an integer"))
    show(p.response())
    io.outln(problem.not_found("no todo 7").typed("https://example.com/probs/missing", "Missing").body())
    io.outln(problem.pointer(toks3("a/b", "m~n", "0")))
    io.outln(problem.with_detail(599, List.new()).title)

    print("-- request ids")
    let ids = middleware.ids("t")
    let h = middleware.request_id(ids, hello())
    show(h(get("/")))
    show(h(get("/")))
    show(h(with_header(get("/"), "X-Request-Id", "client-abc.1")))
    show(h(with_header(get("/"), "X-Request-Id", "bad id\"")))
    print(middleware.valid_id(lit("")))
    io.outln(ids.next())

    print("-- access log")
    let log = sync.lock(stream.buffer())
    let mut q = get("/todos?done=true")
    q.peer = lit("127.0.0.1:4000")
    let logged = middleware.request_id(ids, middleware.access_log(log, hello()))
    show(logged(q))
    let line = log.get().bytes()
    let d = json.parse(bytes.slice(line, 0, line.len() - 1)).unwrap()
    for k in ["id", "peer", "method", "path", "query", "status", "bytes"] {
        let mut o = lit(k)
        o.push(61)
        bytes.append(inout o, json.write(d, json.field(d, d.root, k).unwrap()))
        io.outln(o)
    }
    print(line[line.len() - 1] == 10)
    print(json.as_int(d, json.field(d, d.root, "duration_us").unwrap()).unwrap() >= 0)
    io.outln(middleware.rfc3339(0))
    io.outln(middleware.rfc3339(1793434502250000000))
    io.outln(middleware.rfc3339(951782400999999999))

    print("-- errors and problems")
    let e = middleware.errors(|q: http.Request| -> Result[http.Response, problem.ApiError] {
        let n = q.query_param("n").ok_or(problem.bad_request("n is missing"))?
        if n.len() > 3 { return Err(problem.unprocessable("n is too long")) }
        Ok(http.respond(200, "text/plain", n))
    })
    show(e(get("/?n=12")))
    show(e(get("/")))
    show(e(get("/?n=12345")))
    let mut r = router.new()
    r.get("/a", hello())
    r.post("/a", hello())
    let pr = middleware.problems(router.handler(r))
    show(pr(get("/nope")))
    show(pr(http.request("DELETE", lit("/a"))))
    show(pr(get("/a")))
    let own = middleware.problems(|q: http.Request| -> http.Response { http.text(404, "my own words") })
    show(own(get("/")))

    print("-- body limits")
    let echo = |q: http.Request| -> http.Response { http.respond(200, "text/plain", q.body) }
    let lim = middleware.body_limit(5, echo)
    let mut small = http.request("POST", lit("/"))
    small.body = lit("12345")
    show(lim(small))
    let mut big = small.copy()
    big.body = lit("123456")
    show(lim(big))

    print("-- timeouts")
    let pool = task.pool(2, 4)
    let gate: Chan[i32] = Chan.new()
    let g = gate
    let slow = |q: http.Request| -> http.Response {
        let z = g.recv()
        http.text(200, "late")
    }
    let fast = |q: http.Request| -> http.Response {
        let mut b = lit("fast, deadline set: ")
        let set = if q.deadline.is_never() { lit("no") } else { lit("yes") }
        bytes.append(inout b, set)
        http.respond(200, "text/plain", b)
    }
    let t_fast = middleware.timeout(time.seconds(10), pool, fast)
    show(t_fast(get("/")))
    let t_slow = middleware.timeout(time.millis(50), pool, slow)
    let t0 = time.mono_ns()
    let resp = t_slow(get("/"))
    show(resp)
    print(resp.keep_alive)
    print(time.mono_ns() - t0 >= 50000000)
    gate.send(1)
    // the late handler ends now; the pool serves the next one
    show(t_fast(get("/")))
    pool.shutdown()

    print("-- cors")
    let cfg = middleware.cors_config().allow_origin("https://app.example")
    let c = middleware.cors(cfg, hello())
    show(c(get("/")))
    show(c(with_header(get("/"), "Origin", "https://app.example")))
    show(c(with_header(get("/"), "Origin", "https://evil.example")))
    let mut pre = with_header(with_header(http.request("OPTIONS", lit("/todos")), "Origin", "https://app.example"), "Access-Control-Request-Method", "POST")
    show(c(pre))
    show(c(with_header(pre, "Access-Control-Request-Headers", "Content-Type, Authorization")))
    show(c(with_header(pre, "Access-Control-Request-Headers", "X-Secret")))
    show(c(with_header(with_header(http.request("OPTIONS", lit("/")), "Origin", "https://app.example"), "Access-Control-Request-Method", "TRACE")))
    let any = middleware.cors(middleware.cors_config().allow_any_origin(), hello())
    show(any(with_header(get("/"), "Origin", "https://x.example")))
    let cred = middleware.cors(middleware.cors_config().allow_any_origin().with_credentials(), |q: http.Request| -> http.Response {
        let mut r = http.text(200, "v")
        r.set_header("Vary", lit("Accept"))
        r
    })
    show(cred(with_header(get("/"), "Origin", "https://x.example")))

    print("-- bearer")
    let mut table: List[(List[u8], List[u8])] = List.new()
    table.push((lit("s3cret"), lit("alice")))
    table.push((lit("other"), lit("bob")))
    let b = middleware.bearer("todo", middleware.token_table(table), hello())
    show(b(get("/")))
    show(b(with_header(get("/"), "Authorization", "Bearer s3cret")))
    show(b(with_header(get("/"), "Authorization", "bearer other")))
    show(b(with_header(get("/"), "Authorization", "Bearer nope")))
    show(b(with_header(get("/"), "Authorization", "Basic s3cret")))
    show(b(with_header(get("/"), "Authorization", "Bearer ")))

    print("-- basic")
    let ba = middleware.basic("admin", |u: List[u8], pw: List[u8]| -> bool { bytes.eq(u, lit("root")) && http.eq_ct(pw, lit("pa:ss")) }, hello())
    let mut good = lit("Basic ")
    bytes.append(inout good, encoding.base64(lit("root:pa:ss")).bytes())
    let mut wrong = lit("Basic ")
    bytes.append(inout wrong, encoding.base64(lit("root:x")).bytes())
    let mut gq = get("/")
    gq.headers.push(http.Header(lit("authorization"), good))
    show(ba(gq))
    let mut wq = get("/")
    wq.headers.push(http.Header(lit("authorization"), wrong))
    show(ba(wq))
    show(ba(with_header(get("/"), "Authorization", "Basic !!!")))
    show(ba(get("/")))
    print(http.eq_ct(lit("abc"), lit("abc")))
    print(http.eq_ct(lit("abc"), lit("abd")))
    print(http.eq_ct(lit("abc"), lit("ab")))

    print("-- chain")
    let mut layers: List[fn(fn(http.Request) -> http.Response) -> fn(http.Request) -> http.Response] = List.new()
    layers.push(|x: fn(http.Request) -> http.Response| -> fn(http.Request) -> http.Response { middleware.request_id(middleware.ids("c"), x) })
    layers.push(|x: fn(http.Request) -> http.Response| -> fn(http.Request) -> http.Response { middleware.body_limit(3, x) })
    let ch = middleware.chain(hello(), layers)
    show(ch(get("/")))
    show(ch(big))

    print("-- metrics")
    let mut bounds: List[i64] = List.new()
    bounds.push(1000)
    bounds.push(250000)
    bounds.push(2500000)
    let m = metrics.with_buckets(bounds)
    m.observe(lit("GET"), 200, 500000)
    m.observe(lit("GET"), 200, 2000000)
    m.observe(lit("POST"), 201, 300000000)
    m.observe(lit("BREW"), 418, 1)
    m.observe(lit("GET"), 404, 1000000)
    m.observe(lit("DELETE"), 204, 3000000000)
    io.out(m.render())
    print(m.total(200))
    io.outln(metrics.seconds_text(5000))
    io.outln(metrics.seconds_text(2500000))
    io.outln(metrics.seconds_text(10000000))
    io.outln(metrics.seconds_text(1))
    let m2 = metrics.new()
    let w = m2.wrap(hello())
    show(w(get("/")))
    show(w(http.request("PUT", lit("/"))))
    let served = m2.handler()
    let text = served(get("/metrics")).body
    for l in bytes.lines(text) {
        if bytes.starts_with(l, lit("http_requests_total")) || bytes.starts_with(l, lit("http_requests_in_flight ")) || bytes.starts_with(l, lit("http_request_duration_seconds_count")) || bytes.find(l, lit("+Inf"), 0).is_some() {
            io.outln(l)
        }
    }
    io.outln(served(get("/metrics")).header("content-type").unwrap())
}

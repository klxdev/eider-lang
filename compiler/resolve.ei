// resolve: the module graph and name keys.
//
// Loading (held to tests/oracle): imports are read depth first in source order; a module
// already loaded (by canonical path) is merged once; two different files with one module
// identity clash (E0808). Items come out in a fixed order: the prelude first, then each
// module's imports before its own items, so the entry file is last (`Program.order`).
//
// Imports (docs/compiler.md, "C8.3: packages and modules"). A *path import* (the string
// has a `.` or starts with `/`: `"util.ei"`, `"../lib/geo.ei"`) names a file relative to the
// importing file. A *package import* (no `.`, no leading `/`: `"json"`, `"json/util"`,
// `"std/fs"`) starts with a package name: `std` and `core` are the toolchain's (beside the
// prelude), any other must be the importing package's own name or one of its direct
// dependencies (`[deps.<name>]` in its eider.toml; E0809 otherwise), found through
// eider.lock (lock.ei; E0810 when it can't be). `"json"` loads the package's entry module,
// `"json/a/b"` its file `a/b.ei`. The default alias is the last segment.
//
// Module identity. A file's package is the nearest eider.toml above its canonical path
// (`[package] name`); its identity is (package, its path inside the package without the
// extension). A file in no package is identified by its canonical path, as before
// packages. The prelude (Option, Result and their methods) is Eider source that belongs to
// the language core: `core/prelude.ei` under the toolchain root (toolchain.ei, the driver's
// lookup: $EIDER_ROOT, or else the nearest directory above the eiderc executable holding
// core/eider_rt.h, or else that search from the current directory; `.` when none). It is loaded like a
// module whose names have no prefix (parsed before user items).
//
// Names. The language gives every top-level name of an imported module the module's prefix
// (`geo__Point`) and rewrites references inside that module to match, unless a local of
// the same function shadows them. The checker then sees one flat table. We keep that table
// but key it by integers: a name key is (prefix, symbol) packed in a u64, prefix 0 for the
// entry file, the prelude, `extern` fns and `main`, and the module name's symbol + 1 for an
// imported module. A module name is its file stem outside packages (so two such files with
// one stem clash) and `<stem>__0<package>[_s<path>]` inside one (`module_name`: unique per
// identity, and only identifier bytes, so C names derived from it are too); messages and
// what a program prints show only the stem (`diag.demangle`, `shown`). `alias.Name` (kept
// structurally by the parser) becomes the key of the alias's module. The `*_key` functions
// below reproduce that renaming's rules, so lookups hit exactly what the mangled
// `stem__Name` strings would hit.

import core.sys
import core.version
import std.bytes
import std.fs
import std.env
import eiderc.intern
import eiderc.lex
import eiderc.ast
import eiderc.parse
import eiderc.diag
import eiderc.front
import eiderc.lock
import eiderc.toolchain

/// "no module": the prelude, or an error that belongs to no file.
pub const NOMOD: u32 = 4294967295

/// An import of a module: `alias` refers to the module with prefix `pre` from (line, col) on.
pub type Alias = { sym: u32, pre: u32, line: u32, col: u32 }

/// "no package": a file with no eider.toml above it.
pub const NOPKG: u32 = 4294967295

/// One source file. `path` is the name diagnostics use for it (the importer's directory joined
/// with the import path, or a package's directory joined with the module's path in it);
/// `pre` is 0 for the entry file, else the module name's symbol + 1; `pkg` indexes
/// `Program.pkgs` (NOPKG: in no package).
pub type Module = {
    path: List[u8],
    pre: u32,
    pkg: u32,
    src: List[u8],
    ast: ast.Ast,
    toks: List[lex.Tok],
    strs: List[List[u8]],
    aliases: List[Alias],
    own: Map[u32, bool],
}

/// A package: `dir` (canonical) holds its eider.toml, which names it and its direct
/// dependencies with the capabilities each is granted (`grants`, parallel to `deps`); `err`
/// says why that file can't be used (then the package has no name and its files are
/// identified as files in no package). `eider` is the toolchain MAJOR.MINOR it needs (""
/// when it doesn't say), `vchecked` whether that was checked yet (E0811, `series_diag`).
pub type Pkg = { dir: List[u8], name: List[u8], entry: List[u8], deps: List[List[u8]], err: List[u8], grants: List[List[List[u8]]], eider: List[u8], vchecked: bool, lints: List[List[u8]], lint_levels: List[List[u8]] }

/// eider.lock in `dir` (`missing`: there is none; `err`: it doesn't parse).
pub type Lock = { dir: List[u8], missing: bool, err: List[u8], pkgs: List[lock.Locked] }

pub type Program = {
    mods: List[Module],
    /// module indices in item order (imports before importers; the entry file, 0, last)
    order: List[u32],
    names: intern.Interner,
    /// canonical paths of loaded files, and (prefix symbol, canonical path) of every import seen
    seen: List[List[u8]],
    pre_syms: List[u32],
    pre_paths: List[List[u8]],
    /// the prelude's module index
    prelude: u32,
    /// the prefixes (module name symbol + 1) of imports that failed to load (a missing or
    /// unparsable file, a clash, a package that can't be found): names qualified by them are
    /// not reported as unknown
    broken: List[u32],
    /// where syntax errors are: module index * 2^32 + line (note_syntax); the checker
    /// judges nothing a skipped part could have changed there
    syntax: List[u64],
    /// the packages seen, the directories probed for an eider.toml (each with its package,
    /// or NOPKG) and the lock files read
    pkgs: List[Pkg],
    pdirs: List[List[u8]],
    pdir_pkg: List[u32],
    locks: List[Lock],
    /// each module's file as a trap names it (shown_path)
    shown: List[List[u8]],
}

/// Note the syntax errors `ds` of module m (its lex and parse diagnostics).
pub fn note_syntax(inout p: Program, m: u32, ds: List[diag.Diag]) {
    for d in ds { p.syntax.push((m as u64) * 4294967296 + d.line as u64) }
}

/// Whether module m has a syntax error on a line in [from, to].
pub fn syntax_in(p: Program, m: u32, from: u32, to: u32) -> bool {
    for k in p.syntax {
        if (k / 4294967296) as u32 == m {
            let l = (k % 4294967296) as u32
            if l >= from && l <= to { return true }
        }
    }
    false
}

// ---- keys

pub fn key(pre: u32, sym: u32) -> u64 { (pre as u64) * 4294967296 + sym as u64 }
pub fn key_sym(k: u64) -> u32 { (k % 4294967296) as u32 }
pub fn key_pre(k: u64) -> u32 { (k / 4294967296) as u32 }

/// The spelling of a key: `stem__Name` for module items (diag demangles it).
pub fn key_text(names: intern.Interner, k: u64) -> List[u8] {
    let pre = key_pre(k)
    let mut out: List[u8] = List.new()
    if pre > 0 {
        bytes.append(inout out, intern.name(names, pre - 1))
        bytes.append(inout out, sys.lit("__"))
    }
    bytes.append(inout out, intern.name(names, key_sym(k)))
    out
}

pub fn node(p: Program, m: u32, id: u32) -> ast.Node { p.mods[m as usize].ast.nodes[id as usize] }
pub fn at(p: Program, m: u32, start: u32, i: u32) -> u32 { p.mods[m as usize].ast.extra[(start + i) as usize] }

fn owns(p: Program, m: u32, sym: u32) -> bool {
    match p.mods[m as usize].own.get(sym) {
        Some(_) => true
        None => false
    }
}

/// The prefix that alias `sym` stands for at (line, col) in module m (the last import of
/// that alias before the position, as if the parser mapped them while it reads).
pub fn alias_pre(p: Program, m: u32, sym: u32, line: u32, col: u32) -> u32 {
    let mut pre: u32 = 0
    for a in p.mods[m as usize].aliases {
        if a.sym == sym && (a.line < line || (a.line == line && a.col < col)) { pre = a.pre }
    }
    pre
}

/// The key of an item declared in module m (types, variants, consts and fns other than
/// `extern` fns and `main` are prefixed).
pub fn item_key(p: Program, m: u32, sym: u32) -> u64 { key(p.mods[m as usize].pre, sym) }

/// A name used in an expression (EIdent, ECall): prefixed if it is one of the module's own
/// items and not a local of the enclosing function (`locals`).
pub fn expr_key(p: Program, m: u32, sym: u32, qual: u32, line: u32, col: u32, locals: Map[u32, bool]) -> u64 {
    if qual > 0 { return key(alias_pre(p, m, qual - 1, line, col), sym) }
    let pre = p.mods[m as usize].pre
    if pre == 0 { return key(0, sym) }
    let local = match locals.get(sym) {
        Some(_) => true
        None => false
    }
    if owns(p, m, sym) && !local { return key(pre, sym) }
    key(0, sym)
}

/// A name in a type or a pattern: prefixed if it is one of the module's own items.
pub fn name_key(p: Program, m: u32, sym: u32, qual: u32, line: u32, col: u32) -> u64 {
    if qual > 0 { return key(alias_pre(p, m, qual - 1, line, col), sym) }
    let pre = p.mods[m as usize].pre
    if pre > 0 && owns(p, m, sym) { return key(pre, sym) }
    key(0, sym)
}

// ---- loading

/// A lexer failure as a diagnostic.
pub fn lex_diag(r: lex.Lex) -> Option[diag.Diag] {
    match r {
        lex.Done(_) => None
        lex.Failed(e) => Some(diag.new("E0001", e.line, e.col, sys.lit(e.msg)))
        lex.BadChar(line, col, ch) => {
            let mut m = sys.lit("unexpected character `")
            bytes.append(inout m, ch)
            m.push(96)
            Some(diag.new("E0001", line, col, m))
        }
    }
}

fn in_file(d: diag.Diag, path: List[u8]) -> diag.Diag {
    let mut d2 = d.copy()
    if d2.file.len() == 0 { d2.file = path }
    d2
}

/// The parent directory of a path: everything before the last `/` ("" for none).
fn dir_of(path: List[u8]) -> List[u8] {
    match bytes.rfind_byte(path, 47) {
        Some(0) => bytes.slice(path, 0, 1)
        Some(i) => bytes.slice(path, 0, i)
        None => List.new()
    }
}

/// `dir` joined with `rel`: an absolute `rel` replaces `dir`.
fn join(dir: List[u8], rel: List[u8]) -> List[u8] {
    if dir.len() == 0 || (rel.len() > 0 && rel[0] == 47) { return rel }
    let mut out = dir.copy()
    if out[out.len() - 1] != 47 { out.push(47) }
    bytes.append(inout out, rel)
    out
}

/// Whether the last path component has an extension (a `.` after its first byte).
fn has_ext(path: List[u8]) -> bool {
    let start: usize = match bytes.rfind_byte(path, 47) {
        Some(i) => i + 1
        None => 0
    }
    let mut i = start + 1
    while i < path.len() {
        if path[i] == 46 { return true }
        i += 1
    }
    false
}

/// The module prefix of an import path: its file stem with non-identifier bytes as `_`.
fn stem(path: List[u8]) -> List[u8] {
    let base = match bytes.rfind_byte(path, 47) {
        Some(i) => bytes.slice(path, i + 1, path.len())
        None => path
    }
    let s = match bytes.rfind_byte(base, 46) {
        Some(0) => base
        Some(i) => bytes.slice(base, 0, i)
        None => base
    }
    let mut out: List[u8] = List.new()
    for c in s {
        if bytes.is_ident(c) { out.push(c) } else { out.push(95) }
    }
    out
}

/// The canonical path (symlinks resolved, so every path to one file agrees: module identity,
/// the deps/ farm of old), or the path itself when it can't be resolved.
fn canonical(path: List[u8]) -> List[u8] uses fs {
    match fs.canonical(path) {
        Ok(a) => a
        Err(_) => path
    }
}

fn contains(xs: List[List[u8]], x: List[u8]) -> bool {
    for y in xs {
        if bytes.eq(y, x) { return true }
    }
    false
}

/// The OS error text for a file that can't be read (the common cases, as tests/oracle records).
pub fn read_error(path: List[u8]) -> List[u8] uses fs {
    match fs.kind(path) {
        fs.Missing => sys.lit("No such file or directory (os error 2)")
        fs.Dir => sys.lit("Is a directory (os error 21)")
        _ => sys.lit("Permission denied (os error 13)")
    }
}

/// Where loading reads source files: the file system, except for overlay files (an
/// editor's unsaved buffers, ide.ei), each of which replaces the file with the same
/// canonical path. `disk()` has no overlay, and then reading is exactly fs.read.
pub type Files = { canon: List[List[u8]], texts: List[List[u8]] }

pub fn disk() -> Files { Files(List.new(), List.new()) }

/// Files with `texts[i]` in place of the file at `paths[i]`.
pub fn overlay(paths: List[List[u8]], texts: List[List[u8]]) -> Files uses fs {
    let mut f = disk()
    for i in 0..paths.len() {
        if i < texts.len() {
            f.canon.push(canonical(paths[i]))
            f.texts.push(texts[i])
        }
    }
    f
}

/// The contents of `path` (whose canonical path is `canon`), or None if it can't be read.
pub fn read_file(fp: Files, path: List[u8], canon: List[u8]) -> Option[List[u8]] uses fs {
    for i in 0..fp.canon.len() {
        if bytes.eq(fp.canon[i], canon) { return Some(fp.texts[i]) }
    }
    match fs.read(path) {
        Ok(t) => Some(t)
        Err(_) => None
    }
}

/// read_file for a path whose canonical form isn't known yet.
pub fn read_source(fp: Files, path: List[u8]) -> Option[List[u8]] uses fs {
    if fp.canon.len() == 0 { return read_file(fp, path, path) }
    read_file(fp, path, canonical(path))
}

fn add_module(inout p: Program, path: List[u8], pre: u32, pkg: u32, src: List[u8], q: parse.P) -> u32 {
    let mut own: Map[u32, bool] = Map.new()
    let m = Module(path, pre, pkg, src, q.ast, q.toks, q.strs, List.new(), own)
    p.mods.push(m)
    (p.mods.len() - 1) as u32
}

/// Lex and parse `src` as module `path`; errors name the file.
fn parse_file(inout p: Program, path: List[u8], src: List[u8]) -> Result[parse.P, diag.Diag] {
    let r = lex.lex(src, inout p.names)
    match lex_diag(r) {
        Some(d) => { return Err(in_file(d, path)) }
        None => {}
    }
    let lx = match r {
        lex.Done(l) => l
        _ => { return Err(diag.new("E0001", 1, 1, sys.lit("internal: lexer state"))) }
    }
    match parse.parse(lx, p.names) {
        Ok(q) => {
            p.names = q.names
            Ok(q)
        }
        Err(d) => Err(in_file(d, path))
    }
}

/// Lex and parse `src` as module `path` recovering from errors (front.ei): the tree, with
/// error nodes where parts failed; every lex and parse error goes into `diags`, naming the
/// file.
fn parse_module(inout p: Program, path: List[u8], src: List[u8], inout diags: List[diag.Diag]) -> parse.P {
    let lx = lex.lex_all(src, inout p.names)
    let r = parse.parse_all(lx.lexed, p.names)
    let ds = front.merge(lx.diags, r.diags)
    for d in ds { diags.push(in_file(d, path)) }
    // the module about to be added
    let m = p.mods.len() as u32
    note_syntax(inout p, m, ds)
    p.names = r.p.names
    r.p
}

/// Build the program from the parsed entry file `q` (path `file`), loading its imports; the
/// first diagnostic, if there is one.
pub fn load(file: List[u8], src: List[u8], q: parse.P) -> Result[Program, diag.Diag] uses io, fs {
    let l = load_from(file, src, q, disk())
    if l.diags.len() > 0 { return Err(l.diags[0]) }
    Ok(l.p)
}

/// A loaded program and the diagnostics of loading it, in the order found. An import that
/// can't be loaded (unreadable, unparsable, clashing) is reported and left out, its prefix
/// in `p.broken`, and loading goes on; `fatal`: the prelude is missing, and the program
/// can't be checked.
pub type Loaded = { p: Program, diags: List[diag.Diag], fatal: bool }

/// `load`, reading sources through `fp`.
pub fn load_from(file: List[u8], src: List[u8], q: parse.P, fp: Files) -> Loaded uses io, fs {
    let mut p = Program(List.new(), List.new(), q.names, List.new(), List.new(), List.new(), NOMOD, List.new(), List.new(),
        List.new(), List.new(), List.new(), List.new(), List.new())
    let canon = canonical(file)
    p.seen.push(canon)
    let pk = package_of(inout p, canon)
    add_module(inout p, file, 0, pk, src, q)
    let mut diags: List[diag.Diag] = List.new()
    check_series(inout p, pk, 1, 1, file, inout diags)
    load_imports(inout p, 0, fp, inout diags)
    let mut fatal = false
    match load_prelude(inout p, fp) {
        Ok(_) => {}
        Err(d) => {
            diags.push(d)
            fatal = true
        }
    }
    for i in 0..p.mods.len() { compute_own(inout p, i as u32) }
    for i in 0..p.mods.len() { p.shown.push(shown_path(p, i as u32)) }
    for d in grant_diags(p) { diags.push(d) }
    Loaded(p, diags, fatal)
}

/// Module m's file as a runtime trap names it (docs/compiler.md, "C8.16"): a file of a
/// package found under the package's directory as `<package>/<path in the package>`, a
/// toolchain file relative to the toolchain root (`std/testing.ei`, `core/prelude.ei`),
/// any other file by the path it was loaded from
/// (relative to the entry file's directory, as diagnostics name it). So the generated C
/// holds no path that depends on where the toolchain or the store is.
fn shown_path(p: Program, m: u32) -> List[u8] uses io, fs {
    let path = p.mods[m as usize].path
    let pk = p.mods[m as usize].pkg
    if pk != NOPKG {
        let k = p.pkgs[pk as usize]
        let mut dir = k.dir.copy()
        dir.push(47)
        if k.name.len() > 0 && bytes.starts_with(path, dir) {
            let mut out = k.name.copy()
            out.push(47)
            bytes.append(inout out, bytes.slice(path, dir.len(), path.len()))
            return out
        }
    }
    let mut root = toolchain_root()
    root.push(47)
    if bytes.starts_with(path, root) { return bytes.slice(path, root.len(), path.len()) }
    path
}

/// The toolchain root (see the top of this file): the driver's (toolchain.find), else `.`.
pub fn toolchain_root() -> List[u8] uses io, fs {
    let r = toolchain.find()
    if r.len() == 0 { return sys.lit(".") }
    r
}

fn load_prelude(inout p: Program, fp: Files) -> Result[bool, diag.Diag] uses io, fs {
    let path = join(toolchain_root(), sys.lit("core/prelude.ei"))
    let text = match read_source(fp, path) {
        Some(t) => t
        None => {
            let mut msg = sys.lit("cannot read the prelude `")
            bytes.append(inout msg, path)
            bytes.append(inout msg, sys.lit("`: "))
            bytes.append(inout msg, read_error(path))
            let mut d = diag.new("E0804", 1, 1, msg)
            d.help = sys.lit("set EIDER_ROOT to the Eider toolchain (the directory that holds core/)")
            return Err(d)
        }
    }
    let q = parse_file(inout p, path, text)?
    let m = add_module(inout p, path, 0, NOPKG, text, q)
    p.prelude = m
    let mut order: List[u32] = List.new()
    order.push(m)
    for x in p.order { order.push(x) }
    p.order = order
    Ok(true)
}

/// Load module m's imports (and theirs, depth first), recording what fails in `diags`.
fn load_imports(inout p: Program, m: u32, fp: Files, inout diags: List[diag.Diag]) uses io, fs {
    let a = p.mods[m as usize].ast.copy()
    let dir = dir_of(p.mods[m as usize].path)
    let file = p.mods[m as usize].path.copy()
    let mut binds = Binds(List.new(), List.new(), List.new(), List.new())
    for k in 0..a.items_len {
        let n = a.nodes[ast.at(a, a.items_start, k) as usize].copy()
        if n.kind != ast.IImport { continue }
        let rel = p.mods[m as usize].strs[n.a as usize].copy()
        let form = n.c
        // the default alias: the file stem, or a module path's last segment
        let st = stem(rel)
        let st_sym = intern.intern(inout p.names, st, 0, st.len())
        let alias = if n.b > 0 { n.b - 1 } else { st_sym }
        // an implied import (a namespace use) is in effect from the namespace's import on
        let al_line = if form == parse.IMPORT_IMPLIED { n.d } else { n.line }
        let al_col = if form == parse.IMPORT_IMPLIED { n.e } else { n.col }
        if form == parse.IMPORT_NAMESPACE {
            // no module: `std.bytes.eq` implies the import of std.bytes where it is used
            p.mods[m as usize].aliases.push(Alias(alias, 0, n.line, n.col))
            let mut key = sys.lit("namespace ")
            bytes.append(inout key, rel)
            bind_alias(inout p, inout binds, alias, key, n, dots(rel), file, inout diags)
            continue
        }
        let mut path: List[u8] = List.new()
        let dotted = form != parse.IMPORT_QUOTED
        if dotted || is_package_import(rel) {
            let found = if dotted { locate_dotted(inout p, m, rel, n) } else { locate(inout p, m, rel, n) }
            match found {
                Ok(x) => { path = x }
                Err(d) => {
                    // a prefix no module has, so what it qualifies is not reported as unknown
                    let mut bad = st.copy()
                    bytes.append(inout bad, sys.lit("__0"))
                    let bad_sym = intern.intern(inout p.names, bad, 0, bad.len())
                    p.mods[m as usize].aliases.push(Alias(alias, bad_sym + 1, al_line, al_col))
                    diags.push(in_file(d, file))
                    p.broken.push(bad_sym + 1)
                    continue
                }
            }
        } else {
            path = join(dir, rel)
            if !has_ext(path) { bytes.append(inout path, sys.lit(".ei")) }
        }
        let canon = canonical(path)
        let pk = package_of(inout p, canon)
        check_series(inout p, pk, n.line, n.col, file, inout diags)
        let mname = module_name(p, canon, pk, st)
        let pre_sym = intern.intern(inout p.names, mname, 0, mname.len())
        p.mods[m as usize].aliases.push(Alias(alias, pre_sym + 1, al_line, al_col))
        let mut clash = false
        let mut known = false
        for j in 0..p.pre_syms.len() {
            if p.pre_syms[j] == pre_sym {
                known = true
                if !bytes.eq(p.pre_paths[j], canon) {
                    diags.push(in_file(clash_diag(p, n, pk, st, p.pre_paths[j], canon), file))
                    clash = true
                }
            }
        }
        if clash {
            p.broken.push(pre_sym + 1)
            continue
        }
        // (after E0808: one alias for two files with one identity is that error, not E0813)
        if form != parse.IMPORT_IMPLIED {
            let written = if dotted { dots(rel) } else { quoted("\"", rel, "\"") }
            bind_alias(inout p, inout binds, alias, canon, n, written, file, inout diags)
        }
        if !known {
            p.pre_syms.push(pre_sym)
            p.pre_paths.push(canon)
        }
        if contains(p.seen, canon) { continue }
        p.seen.push(canon)
        let found = read_file(fp, path, canon)
        let mut text: List[u8] = List.new()
        match found {
            Some(t) => { text = t }
            None => {
                let mut msg = sys.lit("cannot read module `")
                bytes.append(inout msg, path)
                bytes.append(inout msg, sys.lit("`: "))
                bytes.append(inout msg, read_error(path))
                let mut d = diag.new("E0804", n.line, n.col, msg)
                if dotted {
                    d.msg = quoted("unknown module `", dots(rel), "`")
                    d.help = quoted("there is no file ", path, "")
                    let head = bytes.split(rel, 47)[0]
                    let toolchain = bytes.eq(head, sys.lit("std")) || bytes.eq(head, sys.lit("core"))
                    // (the toolchain's directory depends on how eiderc was run: not named)
                    if toolchain {
                        d.help = quoted("`", head, "` has no module `")
                        bytes.append(inout d.help, bytes.slice(rel, head.len() + 1, rel.len()))
                        d.help.push(96)
                    }
                    if p.mods[m as usize].pkg == NOPKG && !toolchain {
                        d.help = quoted("outside a package, `import ", dots(rel), "` names the file ")
                        bytes.append(inout d.help, rel)
                        bytes.append(inout d.help, sys.lit(".ei beside the importing file, and there is no "))
                        bytes.append(inout d.help, path)
                    }
                    if form == parse.IMPORT_IMPLIED {
                        bytes.append(inout d.help, sys.lit(" (the namespace names one module, then an item of it: `"))
                        bytes.append(inout d.help, dots(rel))
                        bytes.append(inout d.help, sys.lit(".Name`)"))
                    }
                } else if bytes.starts_with(rel, sys.lit("deps/")) || bytes.find(rel, sys.lit("/deps/"), 0).is_some() {
                    d.help = sys.lit("eider-pkg no longer links dependencies into deps/: import a package by name (`import json`, `import json.util`, `import std.fs`)")
                }
                diags.push(in_file(d, file))
                p.broken.push(pre_sym + 1)
                continue
            }
        }
        // a module with syntax errors is loaded with what parsed (its error nodes are skipped)
        let q = parse_module(inout p, path, text, inout diags)
        let mi = add_module(inout p, path, pre_sym + 1, pk, text, q)
        load_imports(inout p, mi, fp, inout diags)
    }
    p.order.push(m)
}

// ---- dotted imports (docs/compiler.md, "C8.26: dotted imports")
//
// `import a.b.c` names a module by its path (parse.ei IMPORT_*; slot a holds `a/b/c`):
//   - `std.x`, `core.x`: the toolchain's module (as `"std/x"`); `import std` alone is the
//     package namespace: no module is loaded, and the first use `std.x.Name` implies the
//     import of `std.x` at that use (IMPORT_IMPLIED), so only the modules used are loaded;
//   - in a package: `a` is the package itself or one of its direct dependencies, `a.b.c`
//     its file `b/c.ei` and `a` alone its entry module (as `"a/b/c"`, `"a"`); `a` both the
//     package's name and a dependency's is E0812; anything else is E0809;
//   - in no package: the file `a/b/c.ei` beside the importing file (a sibling module by its
//     name: `import util` is util.ei next to it).
// A module that isn't there is E0804 ("unknown module `std.nope`"). Two imports of one
// module give it two aliases; a dotted import whose alias already names another module (or
// a namespace) is E0813 (a quoted import keeps its old meaning: the later one wins).

/// The aliases bound so far in one module: the alias, what it names (a canonical path, or
/// `namespace <package>`) and the line of its import.
type Binds = { syms: List[u32], keys: List[List[u8]], lines: List[u32], cols: List[u32] }

/// E0813 if `alias` already names something other than `key` in this module; else bind it.
fn bind_alias(inout p: Program, inout b: Binds, alias: u32, key: List[u8], n: ast.Node, written: List[u8], file: List[u8], inout diags: List[diag.Diag]) {
    for i in 0..b.syms.len() {
        if b.syms[i] == alias {
            // the quoted form keeps its meaning: the later import wins
            if bytes.eq(b.keys[i], key) || n.c == parse.IMPORT_QUOTED { return }
            let name = intern.name(p.names, alias)
            let mut msg = quoted("the alias `", name, "` already names another module (imported on line ")
            bytes.append(inout msg, bytes.from_u64(b.lines[i] as u64))
            msg.push(41)
            let mut h = sys.lit("give one of them another name with `as`: `import ")
            bytes.append(inout h, written)
            bytes.append(inout h, sys.lit(" as <name>`"))
            diags.push(in_file(pkg_diag("E0813", n, msg, h), file))
            return
        }
    }
    b.syms.push(alias)
    b.keys.push(key)
    b.lines.push(n.line)
    b.cols.push(n.col)
}

/// A module path as written: `std/bytes` -> `std.bytes`.
fn dots(path: List[u8]) -> List[u8] {
    let mut out: List[u8] = List.new()
    for c in path {
        if c == 47 { out.push(46) } else { out.push(c) }
    }
    out
}

/// The file the dotted import `spec` (`a/b/c`) of module m names, or why it can't be found.
fn locate_dotted(inout p: Program, m: u32, spec: List[u8], n: ast.Node) -> Result[List[u8], diag.Diag] uses io, fs {
    let parts = bytes.split(spec, 47)
    let head = parts[0]
    if bytes.eq(head, sys.lit("std")) || bytes.eq(head, sys.lit("core")) { return locate(inout p, m, spec, n) }
    let pk = p.mods[m as usize].pkg
    let here = dir_of(p.mods[m as usize].path)
    if pk == NOPKG || p.pkgs[pk as usize].err.len() > 0 {
        if pk != NOPKG { return locate(inout p, m, spec, n) }
        // a file in no package: the module beside it
        let mut f = spec.copy()
        bytes.append(inout f, sys.lit(".ei"))
        return Ok(join(here, f))
    }
    let own = p.pkgs[pk as usize].copy()
    if bytes.eq(head, own.name) && parts.len() > 1 && !contains(own.deps, head) {
        // a module of the importer's own package: named from the importer's directory, as the
        // relative path import of it was, so diagnostics and traps name the file as before
        let mut f = join(own.dir, bytes.slice(spec, head.len() + 1, spec.len()))
        bytes.append(inout f, sys.lit(".ei"))
        let base = if here.len() == 0 { canonical(sys.lit(".")) } else { canonical(here) }
        return Ok(join(here, relative(base, f)))
    }
    if bytes.eq(head, own.name) || contains(own.deps, head) { return locate(inout p, m, spec, n) }
    let mut msg = quoted("unknown module `", dots(spec), "`: `")
    bytes.append(inout msg, head)
    bytes.append(inout msg, sys.lit("` is neither this package (`"))
    bytes.append(inout msg, own.name)
    bytes.append(inout msg, sys.lit("`) nor one of its dependencies ("))
    bytes.append(inout msg, join(own.dir, sys.lit("eider.toml")))
    bytes.append(inout msg, sys.lit(")"))
    // a module of this package, beside the file or at the package's top?
    let mut f = spec.copy()
    bytes.append(inout f, sys.lit(".ei"))
    let mut h: List[u8] = List.new()
    let mut cands: List[List[u8]] = List.new()
    cands.push(join(here, f))
    cands.push(join(own.dir, f))
    for cand in cands {
        if h.len() == 0 && fs.exists(cand) {
            let c = canonical(cand)
            if c.len() > own.dir.len() + 1 && bytes.starts_with(c, own.dir) {
                h = sys.lit("this package's own modules are imported by its name: `import ")
                bytes.append(inout h, own.name)
                h.push(46)
                bytes.append(inout h, dots(strip_ext(bytes.slice(c, own.dir.len() + 1, c.len()))))
                h.push(96)
            }
        }
    }
    if h.len() == 0 {
        h = sys.lit("add it with `eider-pkg add ")
        bytes.append(inout h, head)
        bytes.append(inout h, sys.lit(" --path <dir>` or `eider-pkg add "))
        bytes.append(inout h, head)
        bytes.append(inout h, sys.lit(" --git <url> --version <v>`: a package imports only its own dependencies"))
    }
    Err(pkg_diag("E0809", n, msg, h))
}

/// The path of `to` from directory `from` (both absolute and normalized): `../../lock.ei`.
fn relative(from: List[u8], to: List[u8]) -> List[u8] {
    let a = bytes.split(from, 47)
    let b = bytes.split(to, 47)
    let mut i: usize = 0
    while i < a.len() && i + 1 < b.len() && bytes.eq(a[i], b[i]) { i += 1 }
    let mut out: List[u8] = List.new()
    for j in i..a.len() {
        if a[j].len() > 0 { bytes.append(inout out, sys.lit("../")) }
    }
    for j in i..b.len() {
        if j > i { out.push(47) }
        bytes.append(inout out, b[j])
    }
    out
}

/// Whether `s` is an identifier that isn't a keyword (a segment of a module path).
fn ident_segment(inout p: Program, s: List[u8]) -> bool {
    if s.len() == 0 || bytes.is_digit(s[0]) { return false }
    for c in s {
        if !bytes.is_ident(c) { return false }
    }
    intern.intern(inout p.names, s, 0, s.len()) > intern.LAST_KEYWORD
}

/// The file a quoted import (node n of module m) loads, canonical, or "" if it can't be found.
fn quoted_target(inout p: Program, m: u32, n: ast.Node) -> List[u8] uses io, fs {
    let rel = p.mods[m as usize].strs[n.a as usize].copy()
    let mut path: List[u8] = List.new()
    if is_package_import(rel) {
        match locate(inout p, m, rel, n) {
            Ok(x) => { path = x }
            Err(_) => { return List.new() }
        }
    } else {
        path = join(dir_of(p.mods[m as usize].path), rel)
        if !has_ext(path) { bytes.append(inout path, sys.lit(".ei")) }
    }
    if !fs.exists(path) { return List.new() }
    canonical(path)
}

/// The dotted spelling (`a/b/c`) of the module at canonical path `want`, as module m would
/// import it, or "" when it has none (a file outside the importer's package and its
/// dependencies, a path segment that isn't an identifier, a file in no package that isn't
/// below the importer).
fn dotted_of(inout p: Program, m: u32, want: List[u8]) -> List[u8] uses fs {
    let none: List[u8] = List.new()
    let tp = package_of(inout p, want)
    let ip = p.mods[m as usize].pkg
    let mut spec: List[u8] = List.new()
    let named = tp != NOPKG && p.pkgs[tp as usize].err.len() == 0 && p.pkgs[tp as usize].name.len() > 0
    let mut toolchain = false
    if named { toolchain = bytes.eq(p.pkgs[tp as usize].name, sys.lit("std")) || bytes.eq(p.pkgs[tp as usize].name, sys.lit("core")) }
    if named && (toolchain || ip != NOPKG) {
        let k = p.pkgs[tp as usize].copy()
        let inner = strip_ext(bytes.slice(want, k.dir.len() + 1, want.len()))
        if !toolchain {
            if p.pkgs[ip as usize].err.len() > 0 { return none }
            let own = p.pkgs[ip as usize].copy()
            if tp != ip && !contains(own.deps, k.name) { return none }
        }
        spec = k.name.copy()
        let entry = strip_ext(k.entry)
        if toolchain || !bytes.eq(inner, entry) {
            spec.push(47)
            bytes.append(inout spec, inner)
        }
    } else {
        // in no package: a file below the importer's directory, by its path from there
        // (also one that is in a package: `lib.grants.grantee.grantee`)
        if ip != NOPKG { return none }
        let mut here = canonical(dir_of(p.mods[m as usize].path))
        here.push(47)
        if !bytes.starts_with(want, here) { return none }
        spec = strip_ext(bytes.slice(want, here.len(), want.len()))
        let head = bytes.split(spec, 47)[0]
        if bytes.eq(head, sys.lit("std")) || bytes.eq(head, sys.lit("core")) { return none }
    }
    for seg in bytes.split(spec, 47) {
        if !ident_segment(inout p, seg) { return none }
    }
    spec
}

/// The machine-applicable fixes that rewrite module m's quoted imports in the dotted form
/// (`import "std/fs"` -> `import std.fs`, `import "lex.ei"` -> `import eiderc.lex` in
/// package eiderc), keeping each alias (`as <old alias>` where the default would change).
/// An import is rewritten only when the dotted form loads the same file; others (a file
/// outside the importer's package and its dependencies, a path that isn't made of
/// identifiers) are left as they are. The quoted form is deprecated silently: nothing
/// reports it; `eiderc migrate-imports` applies these.
pub fn import_fixes(inout p: Program, m: u32) -> List[diag.Fix] uses io, fs {
    let mut out: List[diag.Fix] = List.new()
    let a = p.mods[m as usize].ast.copy()
    for k in 0..a.items_len {
        let n = a.nodes[ast.at(a, a.items_start, k) as usize].copy()
        if n.kind != ast.IImport || n.c != parse.IMPORT_QUOTED { continue }
        let want = quoted_target(inout p, m, n)
        if want.len() == 0 { continue }
        let spec = dotted_of(inout p, m, want)
        if spec.len() == 0 { continue }
        // the dotted form must load the same file
        let back: List[u8] = match locate_dotted(inout p, m, spec, n) {
            Ok(x) => canonical(x)
            Err(_) => List.new()
        }
        if !bytes.eq(back, want) { continue }
        // the quoted string's token
        let mut del: u64 = 0
        for t in p.mods[m as usize].toks {
            if t.line == n.d && t.col == n.e && t.kind == lex.Str { del = (t.end - t.start) as u64 }
        }
        if del == 0 { continue }
        let mut ins = dots(spec)
        let rel = p.mods[m as usize].strs[n.a as usize].copy()
        if n.b == 0 && !bytes.eq(stem(rel), stem(spec)) {
            bytes.append(inout ins, sys.lit(" as "))
            bytes.append(inout ins, stem(rel))
        }
        out.push(diag.Fix(n.d, n.e, del, ins))
    }
    out
}

/// `eiderc migrate-imports <file>`: the file with its quoted imports in the dotted form
/// (import_fixes), or with `json`, one JSON line per fix:
/// `{"deprecated":"quoted-import","span":{...},"message":...,"fix":{...}}`.
pub fn migrate_imports(file: List[u8], src: List[u8], json: bool) -> List[u8] uses io, fs {
    let mut names = intern.new()
    let lx = lex.lex_all(src, inout names)
    let pr = parse.parse_all(lx.lexed, names)
    let mut ld = load_from(file, src, pr.p, disk())
    let fixes = import_fixes(inout ld.p, 0)
    if !json {
        let mut out = src.copy()
        for f in fixes { out = diag.apply_fix(out, f) }
        return out
    }
    let mut out: List[u8] = List.new()
    for f in fixes {
        let mut d = diag.new("E0000", f.line, f.col, quoted("the quoted import is deprecated: `import ", f.insert, "`"))
        d.fix = Some(f)
        let j = diag.json(d, file)
        // {"error":"E0000", ... -> {"deprecated":"quoted-import", ...
        bytes.append(inout out, sys.lit("\x7b\"deprecated\":\"quoted-import\""))
        bytes.append(inout out, bytes.slice(j, 16, j.len()))
        out.push(10)
    }
    out
}

// ---- the toolchain series (docs/site/tooling/releases.md)
//
// A package's eider.toml may say which toolchain MAJOR.MINOR it needs: `eider = "0.1"`
// under [package]. Before 1.0 a MINOR bump may break compatibility, so any other value
// than this compiler's (core/version.ei's SERIES, which scripts/version.sh holds equal to
// VERSION) is E0811: at 1:1 of the entry file for the entry file's own package, else at
// the first import that loads a module of the package. Each package is checked once.

/// Check package pk's `eider` (once) and report E0811 at (line, col) of `file` when it isn't
/// this toolchain's MAJOR.MINOR.
fn check_series(inout p: Program, pk: u32, line: u32, col: u32, file: List[u8], inout diags: List[diag.Diag]) {
    if pk == NOPKG { return }
    if p.pkgs[pk as usize].vchecked { return }
    p.pkgs[pk as usize].vchecked = true
    let k = p.pkgs[pk as usize].copy()
    if k.eider.len() == 0 { return }
    let want = sys.lit(version.SERIES)
    if bytes.eq(k.eider, want) { return }
    let mf = join(k.dir, sys.lit("eider.toml"))
    let mut d = diag.new("E0811", line, col, series_msg(k, mf))
    let mut h = sys.lit("")
    if valid_series(k.eider) {
        h = quoted("build it with an Eider ", k.eider, ".x toolchain, or port it to ")
        bytes.append(inout h, want)
        bytes.append(inout h, sys.lit(" and set `eider = \""))
        bytes.append(inout h, want)
        bytes.append(inout h, sys.lit("\"` in "))
        bytes.append(inout h, mf)
    } else {
        h = quoted("write the toolchain MAJOR.MINOR the package needs, like `eider = \"", want, "\"`")
    }
    d.help = h
    diags.push(in_file(d, file))
}

fn series_msg(k: Pkg, mf: List[u8]) -> List[u8] {
    let mut m = sys.lit("package `")
    bytes.append(inout m, k.name)
    if !valid_series(k.eider) {
        bytes.append(inout m, sys.lit("` has `eider = \""))
        bytes.append(inout m, k.eider)
        bytes.append(inout m, sys.lit("\"` ("))
        bytes.append(inout m, mf)
        bytes.append(inout m, sys.lit("), which is not a toolchain MAJOR.MINOR"))
        return m
    }
    bytes.append(inout m, sys.lit("` needs Eider "))
    bytes.append(inout m, k.eider)
    bytes.append(inout m, sys.lit(" (`eider = \""))
    bytes.append(inout m, k.eider)
    bytes.append(inout m, sys.lit("\"` in "))
    bytes.append(inout m, mf)
    bytes.append(inout m, sys.lit("), but this toolchain is "))
    bytes.append(inout m, sys.lit(version.SERIES))
    m
}

/// MAJOR.MINOR: two runs of digits joined by one `.`.
fn valid_series(v: List[u8]) -> bool {
    let mut dots = 0
    let mut run = 0
    for c in v {
        if c == 46 {
            if run == 0 { return false }
            dots += 1
            run = 0
        } else if bytes.is_digit(c) {
            run += 1
        } else {
            return false
        }
    }
    dots == 1 && run > 0
}

/// E0808: two different files `a` and `b` (canonical) have one module identity.
fn clash_diag(p: Program, n: ast.Node, pk: u32, st: List[u8], a: List[u8], b: List[u8]) -> diag.Diag {
    let mut msg: List[u8] = List.new()
    let in_pkg = pk != NOPKG && p.pkgs[pk as usize].name.len() > 0
    if !in_pkg {
        msg = sys.lit("two different modules are both named `")
        bytes.append(inout msg, st)
    } else {
        msg = sys.lit("two different copies of package `")
        bytes.append(inout msg, p.pkgs[pk as usize].name)
        bytes.append(inout msg, sys.lit("` have module `"))
        bytes.append(inout msg, st)
    }
    bytes.append(inout msg, sys.lit("` ("))
    bytes.append(inout msg, a)
    bytes.append(inout msg, sys.lit(" and "))
    bytes.append(inout msg, b)
    bytes.append(inout msg, sys.lit(")"))
    let mut d = diag.new("E0808", n.line, n.col, msg)
    if !in_pkg {
        d.help = sys.lit("rename one of the files, or put them in packages (an eider.toml above each): outside a package a module is named by its file name")
    } else {
        d.help = sys.lit("a program loads each package from one directory: import the package by name (`eider-pkg fetch` locks one copy for the whole graph)")
    }
    d
}

// ---- packages (docs/compiler.md, "C8.3: packages and modules")

/// A package import: no `.` anywhere and no leading `/` (`json`, `json/util`, `std/fs`).
pub fn is_package_import(spec: List[u8]) -> bool {
    if spec.len() == 0 || spec[0] == 47 { return false }
    for c in spec {
        if c == 46 { return false }
    }
    true
}

/// "not yet probed" (package_of's cache).
const UNSEEN: u32 = 4294967294

fn dir_lookup(p: Program, dir: List[u8]) -> u32 {
    for i in 0..p.pdirs.len() {
        if bytes.eq(p.pdirs[i], dir) { return p.pdir_pkg[i] }
    }
    UNSEEN
}

/// Read the eider.toml `mf` of the package in `dir`.
fn add_pkg(inout p: Program, dir: List[u8], mf: List[u8]) -> u32 uses fs {
    let none: List[u8] = List.new()
    let mut pk = Pkg(dir, none, none, List.new(), none, List.new(), none, false, List.new(), List.new())
    match fs.read(mf) {
        Ok(t) => {
            match lock.manifest(t) {
                Ok(x) => {
                    pk.name = x.name
                    pk.entry = x.entry
                    pk.deps = x.deps
                    pk.grants = x.grants
                    pk.eider = x.eider
                    pk.lints = x.lints
                    pk.lint_levels = x.lint_levels
                }
                Err(e) => { pk.err = cannot(mf, e) }
            }
        }
        Err(_) => { pk.err = cannot(mf, read_error(mf)) }
    }
    p.pkgs.push(pk)
    (p.pkgs.len() - 1) as u32
}

fn cannot(file: List[u8], why: List[u8]) -> List[u8] {
    let mut m = sys.lit("cannot use `")
    bytes.append(inout m, file)
    bytes.append(inout m, sys.lit("`: "))
    bytes.append(inout m, why)
    m
}

/// The package of the file at canonical path `canon`: the nearest directory above it with
/// an eider.toml, or NOPKG.
pub fn package_of(inout p: Program, canon: List[u8]) -> u32 uses fs {
    let mut dir = dir_of(canon)
    let mut walked: List[List[u8]] = List.new()
    let mut found = NOPKG
    while dir.len() > 0 {
        let c = dir_lookup(p, dir)
        if c != UNSEEN {
            found = c
            break
        }
        walked.push(dir)
        let mf = join(dir, sys.lit("eider.toml"))
        if fs.exists(mf) {
            found = add_pkg(inout p, dir, mf)
            break
        }
        if dir.len() == 1 && dir[0] == 47 { break }
        dir = dir_of(dir)
    }
    for d in walked {
        p.pdirs.push(d)
        p.pdir_pkg.push(found)
    }
    found
}

/// The package whose eider.toml is in `dir` (NOPKG if there is none).
fn package_in(inout p: Program, dir: List[u8]) -> u32 uses fs {
    let canon = canonical(dir)
    let c = dir_lookup(p, canon)
    if c != UNSEEN {
        if c != NOPKG && bytes.eq(p.pkgs[c as usize].dir, canon) { return c }
    }
    let mf = join(canon, sys.lit("eider.toml"))
    if !fs.exists(mf) { return NOPKG }
    let pk = add_pkg(inout p, canon, mf)
    p.pdirs.push(canon)
    p.pdir_pkg.push(pk)
    pk
}

/// `b` with each byte that isn't a letter or digit escaped (`_` `_u`, `/` `_s`, `-` `_d`,
/// `.` `_p`, others `_x` and two hex digits), so the result has no `__` and decodes back.
fn escape(inout out: List[u8], b: List[u8]) {
    for c in b {
        if bytes.is_alpha(c) || bytes.is_digit(c) {
            out.push(c)
        } else if c == 95 {
            bytes.append(inout out, sys.lit("_u"))
        } else if c == 47 {
            bytes.append(inout out, sys.lit("_s"))
        } else if c == 45 {
            bytes.append(inout out, sys.lit("_d"))
        } else if c == 46 {
            bytes.append(inout out, sys.lit("_p"))
        } else {
            bytes.append(inout out, sys.lit("_x"))
            let hex = sys.lit("0123456789abcdef")
            out.push(hex[(c / 16) as usize])
            out.push(hex[(c % 16) as usize])
        }
    }
}

/// `path` without the extension of its last component.
fn strip_ext(path: List[u8]) -> List[u8] {
    let start: usize = match bytes.rfind_byte(path, 47) {
        Some(i) => i + 1
        None => 0
    }
    let base = bytes.slice(path, start, path.len())
    match bytes.rfind_byte(base, 46) {
        Some(0) => path
        Some(i) => bytes.slice(path, 0, start + i)
        None => path
    }
}

/// The module name of the file at canonical path `canon` in package `pk`, imported with
/// stem `st`: the stem outside packages; `<stem>__0<package>` for a file at the package's
/// top whose name is an identifier, else `<stem>__0<package>_s<path>` (escaped; see the top).
pub fn module_name(p: Program, canon: List[u8], pk: u32, st: List[u8]) -> List[u8] {
    if pk == NOPKG { return st }
    let pkg = p.pkgs[pk as usize]
    if pkg.name.len() == 0 || canon.len() <= pkg.dir.len() + 1 { return st }
    let rel = bytes.slice(canon, pkg.dir.len() + 1, canon.len())
    let inner = strip_ext(rel)
    let mut out = stem(rel)
    let simple = bytes.eq(inner, out)
    bytes.append(inout out, sys.lit("__0"))
    escape(inout out, pkg.name)
    if !simple {
        bytes.append(inout out, sys.lit("_s"))
        escape(inout out, inner)
    }
    out
}

/// A module name (or key text) as messages and programs show it: each `__0...` part (the
/// package and path of a package module) dropped, so `util__0json__Point` is `util__Point`.
pub fn shown(s: List[u8]) -> List[u8] {
    let mut out: List[u8] = List.new()
    let mut i: usize = 0
    while i < s.len() {
        if s[i] == 95 && i + 2 < s.len() && i > 0 && s[i + 1] == 95 && s[i + 2] == 48 {
            i += 3
            while i < s.len() && !(s[i] == 95 && i + 1 < s.len() && s[i + 1] == 95) { i += 1 }
        } else {
            out.push(s[i])
            i += 1
        }
    }
    out
}

/// key_text as programs and C interfaces show it (`shown`).
pub fn key_shown(names: intern.Interner, k: u64) -> List[u8] { shown(key_text(names, k)) }

fn eider_home() -> List[u8] uses io, fs {
    match env.get(sys.lit("EIDER_HOME")) {
        Some(h) => {
            if h.len() > 0 {
                let a = match fs.absolute(h) {
                    Ok(x) => x
                    Err(_) => h
                }
                return a
            }
        }
        None => {}
    }
    match env.get(sys.lit("HOME")) {
        Some(h) => join(h, sys.lit(".eider"))
        None => sys.lit(".eider")
    }
}

/// The lock file in `dir`, read once.
fn lock_at(inout p: Program, dir: List[u8]) -> u32 uses fs {
    for i in 0..p.locks.len() {
        if bytes.eq(p.locks[i].dir, dir) { return i as u32 }
    }
    let file = join(dir, sys.lit("eider.lock"))
    let mut l = Lock(dir, false, List.new(), List.new())
    if !fs.exists(file) {
        l.missing = true
    } else {
        match fs.read(file) {
            Ok(t) => {
                match lock.lockfile(t) {
                    Ok(ps) => { l.pkgs = ps }
                    Err(e) => { l.err = cannot(file, e) }
                }
            }
            Err(_) => { l.err = cannot(file, read_error(file)) }
        }
    }
    p.locks.push(l)
    (p.locks.len() - 1) as u32
}

fn pkg_diag(code: str, n: ast.Node, msg: List[u8], help: List[u8]) -> diag.Diag {
    let mut d = diag.new(code, n.line, n.col, msg)
    d.help = help
    d
}

fn quoted(a: str, x: List[u8], b: str) -> List[u8] {
    let mut m = sys.lit(a)
    bytes.append(inout m, x)
    bytes.append(inout m, sys.lit(b))
    m
}

/// The file that package import `spec` in module m names, or why it can't be found:
/// E0809 for a package the module may not import, E0810 for one that can't be located.
fn locate(inout p: Program, m: u32, spec: List[u8], n: ast.Node) -> Result[List[u8], diag.Diag] uses io, fs {
    let parts = bytes.split(spec, 47)
    let mut ok = lock.valid_name(parts[0])
    for x in parts {
        if x.len() == 0 { ok = false }
    }
    if !ok {
        return Err(pkg_diag("E0809", n, quoted("`", spec, "` is not a valid import"),
            sys.lit("a package import is `<package>` or `<package>/<module path>` (lowercase package name, no `.`); a path import names a file with its extension, like `\"util.ei\"`")))
    }
    let head = parts[0]
    let mut rest: List[u8] = List.new()
    for i in 1..parts.len() {
        if i > 1 { rest.push(47) }
        bytes.append(inout rest, parts[i])
    }
    if bytes.eq(head, sys.lit("std")) || bytes.eq(head, sys.lit("core")) {
        if rest.len() == 0 {
            let mut h = sys.lit("import one of its modules, like `\"")
            bytes.append(inout h, head)
            if bytes.eq(head, sys.lit("std")) { bytes.append(inout h, sys.lit("/fs\"`")) } else { bytes.append(inout h, sys.lit("/sys\"`")) }
            return Err(pkg_diag("E0809", n, quoted("`", head, "` is part of the toolchain and has no entry module"), h))
        }
        let mut f = head.copy()
        f.push(47)
        bytes.append(inout f, rest)
        bytes.append(inout f, sys.lit(".ei"))
        return Ok(join(toolchain_root(), f))
    }
    let pk = p.mods[m as usize].pkg
    if pk == NOPKG {
        let mut h = sys.lit("packages are imported from inside a package: create eider.toml with `eider-pkg init`, then `eider-pkg add ")
        bytes.append(inout h, head)
        bytes.append(inout h, sys.lit(" ...`; a path import names a file with its extension, like `\""))
        bytes.append(inout h, spec)
        bytes.append(inout h, sys.lit(".ei\"`"))
        return Err(pkg_diag("E0809", n, quoted("unknown package `", head, "`: this file is in no package (no eider.toml above it)"), h))
    }
    let own = p.pkgs[pk as usize].copy()
    if own.err.len() > 0 { return Err(pkg_diag("E0810", n, own.err, sys.lit("fix eider.toml (`eider-pkg fetch` checks it)"))) }
    let mut dir = own.dir.copy()
    if bytes.eq(head, own.name) && contains(own.deps, head) {
        let mut msg = quoted("`", head, "` is both this package and one of its dependencies (")
        bytes.append(inout msg, join(own.dir, sys.lit("eider.toml")))
        bytes.append(inout msg, sys.lit(")"))
        return Err(pkg_diag("E0812", n, msg, sys.lit("an import's first segment names one package, and a package can't depend on one with its own name: rename this package (`[package] name`) or drop the dependency")))
    }
    if !bytes.eq(head, own.name) {
        if !contains(own.deps, head) {
            let mut msg = quoted("package `", head, "` is not a dependency of `")
            bytes.append(inout msg, own.name)
            bytes.append(inout msg, sys.lit("` ("))
            bytes.append(inout msg, join(own.dir, sys.lit("eider.toml")))
            bytes.append(inout msg, sys.lit(")"))
            let mut h = sys.lit("add it with `eider-pkg add ")
            bytes.append(inout h, head)
            bytes.append(inout h, sys.lit(" --path <dir>` or `eider-pkg add "))
            bytes.append(inout h, head)
            bytes.append(inout h, sys.lit(" --git <url> --version <v>`: a package imports only its own dependencies"))
            return Err(pkg_diag("E0809", n, msg, h))
        }
        // the lock of the program's root package (the entry file's), else the importer's own
        let root = p.mods[0].pkg
        let ld = if root != NOPKG && p.pkgs[root as usize].err.len() == 0 { p.pkgs[root as usize].dir } else { own.dir }
        let li = lock_at(inout p, ld)
        let lk = p.locks[li as usize]
        let fetch = quoted("run `eider-pkg fetch` in ", ld, "")
        if lk.err.len() > 0 { return Err(pkg_diag("E0810", n, lk.err, fetch)) }
        if lk.missing {
            let mut msg = quoted("can't locate package `", head, "`: there is no eider.lock in ")
            bytes.append(inout msg, ld)
            return Err(pkg_diag("E0810", n, msg, fetch))
        }
        let mut found = false
        for e in lk.pkgs {
            if bytes.eq(e.name, head) {
                found = true
                if e.git {
                    // `eider-pkg vendor`'s copy (.vendor/<name>), else the store's
                    let vendored = join(join(ld, sys.lit(".vendor")), head)
                    if fs.is_dir(vendored) {
                        dir = vendored
                    } else {
                        dir = join(join(eider_home(), sys.lit("pkg")), lock.store_leaf(head, e.hash))
                    }
                } else if e.tool {
                    // a package the toolchain ships (packages/crypto): under its root
                    dir = fs.normalize(join(toolchain_root(), e.path))
                } else {
                    dir = fs.normalize(join(ld, e.path))
                }
            }
        }
        if !found {
            let mut msg = quoted("package `", head, "` is not in ")
            bytes.append(inout msg, join(ld, sys.lit("eider.lock")))
            return Err(pkg_diag("E0810", n, msg, fetch))
        }
        if !fs.is_dir(dir) {
            let mut msg = quoted("package `", head, "` is locked, but its files are missing (")
            bytes.append(inout msg, dir)
            bytes.append(inout msg, sys.lit(")"))
            return Err(pkg_diag("E0810", n, msg, fetch))
        }
    }
    if rest.len() > 0 {
        bytes.append(inout rest, sys.lit(".ei"))
        return Ok(join(dir, rest))
    }
    // the package's entry module
    if bytes.eq(head, own.name) { return Ok(join(dir, own.entry)) }
    let dp = package_in(inout p, dir)
    if dp == NOPKG { return Ok(join(dir, bytes.concat(head, sys.lit(".ei")))) }
    let dk = p.pkgs[dp as usize]
    if dk.err.len() > 0 { return Err(pkg_diag("E0810", n, dk.err, sys.lit("fix eider.toml (`eider-pkg fetch` checks it)"))) }
    Ok(join(dir, dk.entry))
}

/// The module's own top-level names: types, variants, consts, traits and fns
/// other than `extern` fns and `main`.
fn compute_own(inout p: Program, m: u32) {
    let a = p.mods[m as usize].ast
    let mut own: Map[u32, bool] = Map.new()
    for k in 0..a.items_len {
        let n = a.nodes[ast.at(a, a.items_start, k) as usize]
        match n.kind {
            ast.IType => {
                own.insert(n.a, true)
                for v in 0..n.f {
                    let vn = a.nodes[ast.at(a, n.e, v) as usize]
                    if vn.kind == ast.Variant { own.insert(vn.a, true) }
                }
            }
            ast.IFn => {
                if !ast.has(n.b, ast.FN_EXTERN) && !is_main(p, n.a) { own.insert(n.a, true) }
            }
            ast.IConst => { own.insert(n.a, true) }
            ast.ITrait => { own.insert(n.a, true) }
            _ => {}
        }
    }
    p.mods[m as usize].own = own
}

fn is_main(p: Program, sym: u32) -> bool {
    bytes.eq(intern.name(p.names, sym), sys.lit("main"))
}

// ---- function locals: every name a body binds, unscoped

/// The names fn node `f` of module m binds: its parameters and every binder in its body
/// (pattern names that are module items excluded).
pub fn fn_locals(p: Program, m: u32, f: ast.Node) -> Map[u32, bool] {
    let mut out: Map[u32, bool] = Map.new()
    for i in 0..f.f { out.insert(node(p, m, at(p, m, f.e, i)).a, true) }
    if f.h > 0 { collect_block(p, m, f.h - 1, inout out) }
    out
}

fn collect_block(p: Program, m: u32, b: u32, inout out: Map[u32, bool]) {
    let n = node(p, m, b)
    for i in 0..n.d { collect_stmt(p, m, at(p, m, n.c, i), inout out) }
}

fn collect_stmt(p: Program, m: u32, s: u32, inout out: Map[u32, bool]) {
    let n = node(p, m, s)
    match n.kind {
        ast.SLet => {
            out.insert(n.a, true)
            collect_expr(p, m, n.c, inout out)
        }
        ast.SLetPat => {
            collect_pat(p, m, n.a, inout out)
            collect_expr(p, m, n.c, inout out)
        }
        ast.SAssign => {
            collect_expr(p, m, n.a, inout out)
            collect_expr(p, m, n.c, inout out)
        }
        ast.SExpr => collect_expr(p, m, n.a, inout out)
        ast.SAssert => collect_expr(p, m, n.a, inout out)
        ast.SDefer => collect_stmt(p, m, n.a, inout out)
        ast.SWhile => {
            collect_expr(p, m, n.a, inout out)
            collect_block(p, m, n.b, inout out)
        }
        ast.SFor => {
            out.insert(n.a, true)
            collect_expr(p, m, n.b, inout out)
            collect_expr(p, m, n.c, inout out)
            collect_block(p, m, n.d, inout out)
        }
        ast.SForEach => {
            if n.e > 0 { collect_pat(p, m, n.e - 1, inout out) } else { out.insert(n.a, true) }
            collect_expr(p, m, n.b, inout out)
            collect_block(p, m, n.d, inout out)
        }
        ast.SReturn => { if n.a > 0 { collect_expr(p, m, n.a - 1, inout out) } }
        _ => {}
    }
}

fn collect_list(p: Program, m: u32, start: u32, len: u32, inout out: Map[u32, bool]) {
    for i in 0..len { collect_expr(p, m, at(p, m, start, i), inout out) }
}

fn collect_args(p: Program, m: u32, start: u32, len: u32, inout out: Map[u32, bool]) {
    for i in 0..len {
        let a = node(p, m, at(p, m, start, i))
        // (a `comptime for` argument is a statement)
        if a.c == 1 { collect_stmt(p, m, a.a, inout out) } else { collect_expr(p, m, a.a, inout out) }
    }
}

fn collect_expr(p: Program, m: u32, e: u32, inout out: Map[u32, bool]) {
    let n = node(p, m, e)
    match n.kind {
        ast.EUnary => collect_expr(p, m, n.b, inout out)
        ast.ETry => collect_expr(p, m, n.a, inout out)
        ast.EField => collect_expr(p, m, n.a, inout out)
        ast.EFieldAt => collect_expr(p, m, n.a, inout out)
        ast.ECast => collect_expr(p, m, n.a, inout out)
        ast.ERepeat => collect_expr(p, m, n.a, inout out)
        ast.EHole => collect_expr(p, m, n.a, inout out)
        ast.EFmt => collect_list(p, m, n.c, n.d, inout out)
        ast.EBinary => {
            collect_expr(p, m, n.b, inout out)
            collect_expr(p, m, n.c, inout out)
        }
        ast.EIndex => {
            collect_expr(p, m, n.a, inout out)
            collect_expr(p, m, n.b, inout out)
        }
        ast.ECall => collect_args(p, m, n.c, n.d, inout out)
        ast.EMethod => {
            collect_expr(p, m, n.a, inout out)
            collect_args(p, m, n.c, n.d, inout out)
        }
        ast.EArray => collect_list(p, m, n.c, n.d, inout out)
        ast.ETuple => collect_list(p, m, n.c, n.d, inout out)
        ast.EUnsafe => collect_block(p, m, n.a, inout out)
        ast.EBlock => collect_block(p, m, n.a, inout out)
        ast.ELambda => {
            for i in 0..n.d { out.insert(node(p, m, at(p, m, n.c, i)).a, true) }
            collect_expr(p, m, n.a, inout out)
        }
        ast.EIf => {
            collect_expr(p, m, n.a, inout out)
            collect_block(p, m, n.b, inout out)
            if n.c > 0 { collect_expr(p, m, n.c - 1, inout out) }
        }
        ast.EMatch => {
            collect_expr(p, m, n.a, inout out)
            for i in 0..n.d {
                let arm = node(p, m, at(p, m, n.c, i))
                for j in 0..arm.d { collect_pat(p, m, at(p, m, arm.c, j), inout out) }
                if arm.e > 0 { collect_expr(p, m, arm.e - 1, inout out) }
                if arm.b == 1 { collect_stmt(p, m, arm.a, inout out) } else { collect_expr(p, m, arm.a, inout out) }
            }
        }
        _ => {}
    }
}

fn collect_pat(p: Program, m: u32, pat: u32, inout out: Map[u32, bool]) {
    let n = node(p, m, pat)
    match n.kind {
        ast.PName => { if n.b == 0 && !owns(p, m, n.a) { out.insert(n.a, true) } }
        ast.PVariant => { for i in 0..n.d { collect_pat(p, m, at(p, m, n.c, i), inout out) } }
        ast.PTuple => { for i in 0..n.d { collect_pat(p, m, at(p, m, n.c, i), inout out) } }
        ast.PRecord => { for i in 0..n.d { collect_pat(p, m, at(p, m, n.c, i), inout out) } }
        ast.PField => {
            if n.b > 0 { collect_pat(p, m, n.b - 1, inout out) } else { out.insert(n.a, true) }
        }
        _ => {}
    }
}

// ---- capabilities per package (docs/compiler.md, "C8.5: capabilities per package")
//
// A package's capability use is what its loaded modules' functions declare (other than
// `ffi`), plus `ffi` when it has unmanaged code (an `extern` function, an `unsafe fn` or an
// `unsafe` block). Every package a package D imports must be granted what it uses in D's
// eider.toml (`uses = [...]` under `[deps.<name>]`): E0204 otherwise. The entry file's
// package is granted everything, core and std are the toolchain's.

/// A capability package `pkg` uses, at its first use: `kind` USE_CLAUSE (in a function's
/// `uses`), USE_EXTERN (an `extern` function, so `ffi`) or USE_UNSAFE (an `unsafe fn` or
/// block, so `ffi`); the function is `fname` (NOSYM: none), a method of `owner` (the impl's
/// type or the trait; NOSYM: a free function); (m, line, col) is where.
pub type CapUse = { pkg: u32, cap: List[u8], kind: u32, owner: u32, fname: u32, m: u32, line: u32, col: u32 }

pub const USE_CLAUSE: u32 = 0
pub const USE_EXTERN: u32 = 1
pub const USE_UNSAFE: u32 = 2
pub const NOSYM: u32 = 4294967295

/// The capabilities a `uses` clause can name, other than `ffi` (check.ei's list).
fn real_cap(w: List[u8]) -> bool {
    for c in ["io", "clock", "fs", "net", "threads", "python", "js", "wasm"] {
        if bytes.eq(w, sys.lit(c)) { return true }
    }
    false
}

/// An item, or a method of an impl or trait (`owner`: its type or trait, else NOSYM).
type Holder = { id: u32, owner: u32 }

/// Module m's items with the methods of its impls and traits before them, in node order:
/// the parser adds a node after its children, so the nodes of holder i are those after
/// holder i - 1's, up to its own.
fn holders(p: Program, m: u32) -> List[Holder] {
    let a = p.mods[m as usize].ast
    let mut out: List[Holder] = List.new()
    for k in 0..a.items_len {
        let id = ast.at(a, a.items_start, k)
        let n = a.nodes[id as usize]
        if n.kind == ast.IImpl {
            let t = a.nodes[n.b as usize]
            let owner = if t.kind == ast.TName || t.kind == ast.TGeneric { t.a } else { NOSYM }
            for j in 0..n.f { out.push(Holder(ast.at(a, n.e, j), owner)) }
        } else if n.kind == ast.ITrait {
            for j in 0..n.d { out.push(Holder(ast.at(a, n.c, j), n.a)) }
        }
        out.push(Holder(id, NOSYM))
    }
    out
}

fn add_use(inout out: List[CapUse], u: CapUse) {
    for x in out {
        if x.pkg == u.pkg && bytes.eq(x.cap, u.cap) { return }
    }
    out.push(u)
}

/// Every capability each package of the program uses, at its first use: in module load
/// order, then item order; for an `extern` fn, `ffi` before its own `uses`. The prelude uses
/// none; the files in no package are package NOPKG.
pub fn package_caps(p: Program) -> List[CapUse] {
    let mut out: List[CapUse] = List.new()
    for mi in 0..p.mods.len() {
        let m = mi as u32
        if m == p.prelude { continue }
        let pk = p.mods[mi].pkg
        let a = p.mods[mi].ast
        let mut lo: u32 = 0
        for h in holders(p, m) {
            let n = a.nodes[h.id as usize]
            let mut fname = NOSYM
            if n.kind == ast.IFn || n.kind == ast.IConst { fname = n.a }
            if n.kind == ast.IFn {
                if ast.has(n.b, ast.FN_EXTERN) {
                    add_use(inout out, CapUse(pk, sys.lit("ffi"), USE_EXTERN, h.owner, n.a, m, n.line, n.col))
                } else if ast.has(n.b, ast.FN_UNSAFE) {
                    add_use(inout out, CapUse(pk, sys.lit("ffi"), USE_UNSAFE, h.owner, n.a, m, n.line, n.col))
                }
                for i in 0..n.j {
                    let cn = a.nodes[ast.at(a, n.i, i) as usize]
                    let w = intern.name(p.names, cn.a)
                    if real_cap(w) { add_use(inout out, CapUse(pk, w, USE_CLAUSE, h.owner, n.a, m, cn.line, cn.col)) }
                }
            }
            // `unsafe` blocks in the item (test blocks, checked with every capability, count for none)
            if n.kind != ast.ITest {
                let mut i = lo.copy()
                while i < h.id {
                    let u = a.nodes[i as usize]
                    if u.kind == ast.EUnsafe { add_use(inout out, CapUse(pk, sys.lit("ffi"), USE_UNSAFE, h.owner, fname, m, u.line, u.col)) }
                    i += 1
                }
            }
            lo = h.id + 1
        }
    }
    out
}

/// How messages name the function of a use: `name`, or `Type.name` for a method.
pub fn use_name(p: Program, u: CapUse) -> List[u8] {
    let mut out: List[u8] = List.new()
    if u.owner != NOSYM {
        bytes.append(inout out, intern.name(p.names, u.owner))
        out.push(46)
    }
    if u.fname != NOSYM { bytes.append(inout out, intern.name(p.names, u.fname)) }
    out
}

/// The file of a use, relative to its package's directory (a file in no package: its path).
pub fn use_file(p: Program, u: CapUse) -> List[u8] uses fs {
    let path = p.mods[u.m as usize].path
    if u.pkg == NOPKG { return path }
    let canon = canonical(path)
    let mut pre = p.pkgs[u.pkg as usize].dir.copy()
    pre.push(47)
    if bytes.starts_with(canon, pre) { return bytes.slice(canon, pre.len(), canon.len()) }
    canon
}

fn module_with_pre(p: Program, pre: u32) -> u32 {
    for i in 0..p.mods.len() {
        if p.mods[i].pre == pre { return i as u32 }
    }
    NOMOD
}

fn toolchain_pkg(p: Program, pk: u32) -> bool {
    let n = p.pkgs[pk as usize].name
    bytes.eq(n, sys.lit("core")) || bytes.eq(n, sys.lit("std"))
}

/// What package `pk` grants its dependency `name` (`[deps.<name>] uses`; none if absent).
fn grant_of(pk: Pkg, name: List[u8]) -> List[List[u8]] {
    for i in 0..pk.deps.len() {
        if bytes.eq(pk.deps[i], name) && i < pk.grants.len() { return pk.grants[i] }
    }
    List.new()
}

/// E0204 at (line, col) of package d's import: dependency use u is outside `grant`.
fn grant_diag(p: Program, u: CapUse, d: u32, grant: List[List[u8]], line: u32, col: u32) -> diag.Diag uses fs {
    let name = p.pkgs[u.pkg as usize].name
    let mut msg = quoted("package `", name, "` uses capability `")
    bytes.append(inout msg, u.cap)
    bytes.append(inout msg, sys.lit("` in `"))
    bytes.append(inout msg, use_name(p, u))
    bytes.append(inout msg, sys.lit("` ("))
    bytes.append(inout msg, use_file(p, u))
    msg.push(58)
    bytes.append(inout msg, bytes.from_u64(u.line as u64))
    bytes.append(inout msg, sys.lit(") but is only granted ["))
    bytes.append(inout msg, bytes.join(grant, sys.lit(", ")))
    msg.push(93)
    // the command that writes the grant (eider-pkg's `grant`), and the edit it makes
    let mut h = quoted("to allow it, run `eider grant ", name, " ")
    bytes.append(inout h, u.cap)
    bytes.append(inout h, sys.lit("` in "))
    bytes.append(inout h, p.pkgs[d as usize].dir)
    bytes.append(inout h, quoted(" (it adds \"", u.cap, "\" to `uses` in [deps."))
    bytes.append(inout h, name)
    bytes.append(inout h, sys.lit("] of its eider.toml"))
    if u.kind == USE_EXTERN { bytes.append(inout h, sys.lit("; it declares `extern` functions: unmanaged code")) }
    if u.kind == USE_UNSAFE { bytes.append(inout h, sys.lit("; it has `unsafe` code: unmanaged code")) }
    h.push(41)
    let mut dg = diag.new("E0204", line, col, msg)
    dg.help = h
    dg
}

/// E0204 for every capability a package uses beyond what an importing package grants it:
/// for each (importer D, imported package P), at D's first import of P, one per capability.
/// Imports from files in no package, within a package, of the entry file's package and of
/// core and std are not held to grants.
pub fn grant_diags(p: Program) -> List[diag.Diag] uses fs {
    let mut out: List[diag.Diag] = List.new()
    let cu = package_caps(p)
    let entry = p.mods[0].pkg
    let mut edges: List[u64] = List.new()
    for mi in 0..p.mods.len() {
        let d = p.mods[mi].pkg
        if mi as u32 == p.prelude || d == NOPKG { continue }
        if p.pkgs[d as usize].err.len() > 0 { continue }
        for al in p.mods[mi].aliases {
            let t = module_with_pre(p, al.pre)
            if t == NOMOD { continue }
            let pk = p.mods[t as usize].pkg
            if pk == NOPKG || pk == d || pk == entry { continue }
            if toolchain_pkg(p, pk) { continue }
            let e = (d as u64) * 4294967296 + pk as u64
            if edges.contains(e) { continue }
            edges.push(e)
            let grant = grant_of(p.pkgs[d as usize], p.pkgs[pk as usize].name)
            for u in cu {
                if u.pkg == pk && !contains(grant, u.cap) {
                    out.push(in_file(grant_diag(p, u, d, grant, al.line, al.col), p.mods[mi].path))
                }
            }
        }
    }
    out
}

/// `eiderc caps`: one JSON line per (package, capability) of package_caps.
pub fn caps_json(p: Program) -> List[u8] uses fs {
    let mut out: List[u8] = List.new()
    for u in package_caps(p) {
        let none: List[u8] = List.new()
        let name = if u.pkg == NOPKG { none } else { p.pkgs[u.pkg as usize].name }
        let dir = if u.pkg == NOPKG { none } else { p.pkgs[u.pkg as usize].dir }
        bytes.append(inout out, sys.lit("\x7b\"package\":"))
        diag.jstr(inout out, name)
        bytes.append(inout out, sys.lit(",\"dir\":"))
        diag.jstr(inout out, dir)
        bytes.append(inout out, sys.lit(",\"cap\":"))
        diag.jstr(inout out, u.cap)
        bytes.append(inout out, sys.lit(",\"kind\":"))
        diag.jstr(inout out, kind_text(u.kind))
        bytes.append(inout out, sys.lit(",\"fn\":"))
        diag.jstr(inout out, use_name(p, u))
        bytes.append(inout out, sys.lit(",\"file\":"))
        diag.jstr(inout out, use_file(p, u))
        bytes.append(inout out, sys.lit(",\"line\":"))
        bytes.append(inout out, bytes.from_u64(u.line as u64))
        bytes.append(inout out, sys.lit(",\"col\":"))
        bytes.append(inout out, bytes.from_u64(u.col as u64))
        out.push(125)
        out.push(10)
    }
    out
}

fn kind_text(k: u32) -> List[u8] {
    if k == USE_EXTERN { return sys.lit("extern") }
    if k == USE_UNSAFE { return sys.lit("unsafe") }
    sys.lit("uses")
}

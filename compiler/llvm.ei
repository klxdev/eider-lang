/// dst = a copy of src (`.copy()` of part ty, lower.ei's copy_part), when ty owns anything
/// (else the memcpy of the whole already copied it).
fn copy_part(inout e: E, p: lower.P, ty: u32, src: List[u8], dst: List[u8]) {
    if !owns(inout e, p, ty) {
        return
    }
    copy_to(inout e, p, ty, src, dst)

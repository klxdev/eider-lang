// llvm: the typed IR (ir.ei) to textual LLVM IR: Eider's only backend (U23, #128). See
// docs/compiler.md, "Backends", and docs/site/tooling/llvm.md. It builds `eiderc build|run|
// test`, `build --lib`, `--wasm`, `--wasm-core` and comptime evaluators; emit-llvm prints it.
//
// Every function with a body becomes a `define` (a construct this file can't lower is an
// internal error naming the function). Calls from Eider to Eider use an internal convention
// (`@<name>.i`, internal linkage; `isig`: records the C ABI passes in memory go by reference);
// the C ABI (llvm_abi.ei: System V x86-64, or wasm32's) is used where C is on the other side:
// the C core and runtime, `extern "c"` functions, exports (`eider_<name>`), fn values and
// closure bodies. The per-type operations (drop, clone, copy, ==, Ord, Hash, Show, the List
// and Map operations, copy-on-write `uniq_`, `own_` before a value crosses threads, closure
// environments, thunks, the thread handles, Default) are glue functions in this module
// (`glue_all`, asked for by `gneed` where they are used), and so are `main` (handing
// `ei_main_body` to the runtime), the test driver (the runtime's ei_test per block), the trap
// file table and the profiler's tables.
//
// Semantics are the language's, statement for statement, with nothing undefined: checked
// arithmetic is `llvm.*.with.overflow` and an explicit trap branch (the runtime's ei_trap with
// the message and the encoded line, so traps print and exit as the oracle records), bounds
// checks are an `icmp uge` and a trap branch, division checks zero and MIN / -1 first, shifts
// check the count. Flags only restate what a check or a language rule proved: `nsw`/`nuw` on
// checked arithmetic past its trap branch, `inbounds` GEPs, `noalias`/`noundef`/
// `dereferenceable` on the internal convention's parameters (param_attrs); never `exact`.
// Wrapping operators are plain `add`/`sub`/`mul`. The hot helpers (ei_idx, checked
// arithmetic, conversions, shifts, ei_hash_u64, the shared-buffer counts) are inline IR.
//
// Values: a local is an `alloca` (`%l<i>`), zeroed at entry only when the IR may read it
// before assigning it, or, for a scalar assigned once and read only after that, an SSA value
// with no alloca (`scan`). Scalars are SSA registers between statements (bool is `i1` there and
// `i8` in memory), aggregates are moved with `llvm.memcpy`. Types are C layouts (llvm_abi.ei,
// so `export fn` records match lower.header's C structs): `%t<id>` per struct type
// (`%t<id>.v<i>` an enum variant's payload struct, `%t<id>.d` a shared record's buffer),
// `%ei.String` for String. Control flow is the IR's structure: S_IF and S_LOOP become
// labelled blocks (`L<n>`), break/continue/return branches, code after them a dead block.
//
// Debug info (`-g`): a DICompileUnit, a DIFile per module, a DISubprogram per function and a
// DILocation per statement (the statement's source line), so a debugger breaks on Eider lines.

import core.sys
import std.bytes
import eiderc.types
import eiderc.intern
import eiderc.ast
import eiderc.ir
import eiderc.lower
import eiderc.resolve
import eiderc.llvm_abi as abi

const NONE: u32 = 4294967295
const PTR: u32 = 2147483648

/// The module: its head (comment, triple, type definitions) and its parts, joined by `whole`;
/// `owner[i]` is the IR function whose text `ll[i]` is, or GLUE for the glue and the entry
/// points (the parts after the last owned one are the trailer: constants and declarations),
/// which llvm_units.split uses to cut the module into units ("C8.27: incremental builds").
pub type Out = { head: List[u8], ll: List[List[u8]], owner: List[u32] }

/// The owner of the glue's and the entry points' parts (one unit of their own).
pub const GLUE: u32 = 4294967295

/// The whole module.
pub fn whole(o: Out) -> List[u8] {
    let mut m = o.head.copy()
    for x in o.ll { bytes.append(inout m, x) }
    m
}

type E = {
    /// the function being emitted: its entry allocas, its body, and the module so far
    ent: List[u8],
    o: List[u8],
    fns: List[List[u8]],
    tdefs: List[u8],
    tdone: List[bool],
    gl: List[u8],
    lay: abi.Lay,
    own: List[u8],
    tn: List[List[u8]],
    fnn: List[List[u8]],
    ncap: List[u32],
    clo: List[bool],
    /// declarations: name -> declare text (emitted for names this module doesn't define)
    dnames: List[List[u8]],
    dtext: List[List[u8]],
    didx: Map[u64, u32],
    sused: List[bool],
    msgs: Map[u64, u32],
    nmsg: u32,
    nreg: u32,
    nlbl: u32,
    term: bool,
    cur: List[u8],
    lbase: u32,
    nc: u32,
    file: u32,
    loops: List[u32],
    brks: List[u32],
    sret: bool,
    rsig: abi.Arg,
    fail: List[u8],
    /// debug info
    dbg: bool,
    /// the statement being emitted addresses places whose indices it doesn't check (gep_kw)
    unchecked: bool,
    /// per local of the function being emitted: whether it is an SSA value (scan), and its
    /// value once assigned
    ssa: List[bool],
    vals: List[List[u8]],
    md: List[u8],
    nmd: u32,
    sp: u32,
    dloc: u32,
    dlines: Map[u64, u32],
    fmd: Map[u64, u32],
    paths: List[List[u8]],
    dir: List[u8],
    /// per function: its internal and C conventions (memoized), and whether `@<name>.i` is
    /// called
    isigs: List[abi.Sig],
    isok: List[bool],
    csigs: List[abi.Sig],
    csok: List[bool],
    iused: List[bool],
    /// the glue the module needs (lower.GK_* * 2^32 + id; `nseen` dedupes; glue_all emits it)
    /// and the modules whose trap lines it encodes (files_table)
    needs: List[u64],
    nseen: Map[u64, bool],
    tfiles: List[u32],
    /// C conventions by signature (csig_of)
    sigs: List[abi.Sig],
    sigmemo: Map[u64, u32],
    /// debug info: the metadata node of each type's DWARF description (0: not yet)
    dty: List[u32],
    /// the functions this module defines (by h64 of the name): no declaration for them
    gdef: Map[u64, bool],
    /// --profile (docs/runtime.md "Profiler"): what it records (lower.prof_what; 0: no
    /// profiler), the toolchain's version, and in the function being emitted whether it has a
    /// shadow frame (lower.framed), the frame's register and the line last stored in it
    prof: u32,
    pver: List[u8],
    pframe: bool,
    pf: List[u8],
    pline: u32,
}

// ---- text

/// The bytes of a literal (one copy, where sys.lit reads them one by one).
fn lit(s: str) -> List[u8] { s.bytes() }

fn w(inout e: E, s: str) { bytes.append(inout e.o, lit(s)) }
fn wb(inout e: E, s: List[u8]) { bytes.append(inout e.o, s) }
fn wn(inout e: E, n: u64) { wd(inout e.o, n) }

/// Append n in decimal to o, in place (no list of its own).
fn wd(inout o: List[u8], n: u64) {
    if n == 0 {
        o.push(48)
        return
    }
    let start = o.len()
    let mut v = n.copy()
    while v > 0 {
        o.push((v % 10) as u8 + 48)
        v = v / 10
    }
    let mut i = start.copy()
    let mut j = o.len() - 1
    while i < j {
        let t = o[i].copy()
        o[i] = o[j].copy()
        o[j] = t
        i += 1
        j -= 1
    }
}

fn cat(a: List[u8], s: str) -> List[u8] {
    let mut o = a.copy()
    bytes.append(inout o, lit(s))
    o
}

fn catb(a: List[u8], b: List[u8]) -> List[u8] {
    let mut o = a.copy()
    bytes.append(inout o, b)
    o
}

fn num(s: str, n: u64) -> List[u8] {
    let mut o = lit(s)
    wd(inout o, n)
    o
}

fn pick(c: bool, a: str, b: str) -> str {
    if c { return a }
    b
}

fn h64(s: List[u8]) -> u64 {
    let mut h: u64 = 14695981039346656037
    for b in s { h = (h ^ (b as u64)) *% 1099511628211 }
    h
}

/// Begin an instruction line (in a fresh block when the last one was terminated).
fn ins(inout e: E) {
    if e.term {
        let n = e.nlbl.copy()
        e.nlbl += 1
        w(inout e, "L")
        wn(inout e, n as u64)
        w(inout e, ":\n")
        e.cur = num("%L", n as u64)
        e.term = false
    }
    e.o.push(32)
    e.o.push(32)
}

/// End an instruction line (with its source location).
fn fin(inout e: E) {
    if e.dloc > 0 {
        w(inout e, ", !dbg !")
        let d = e.dloc.copy()
        wn(inout e, d as u64)
    }
    e.o.push(10)
}

fn reg(inout e: E) -> List[u8] {
    e.nreg += 1
    let mut r: List[u8] = List.new()
    r.push(37)
    r.push(114)
    wd(inout r, e.nreg as u64)
    r
}

/// Make sure there is an open block (so e.cur names the block the next instruction is in).
fn live(inout e: E) {
    if e.term {
        let n = new_label(inout e)
        label(inout e, n)
    }
}

fn new_label(inout e: E) -> u32 {
    let n = e.nlbl
    e.nlbl += 1
    n
}

/// Start block L<n> (falling through to it from an unterminated block).
fn label(inout e: E, n: u32) {
    if !e.term {
        w(inout e, "  br label %L")
        wn(inout e, n as u64)
        fin(inout e)
    }
    w(inout e, "L")
    wn(inout e, n as u64)
    w(inout e, ":\n")
    e.cur = num("%L", n as u64)
    e.term = false
}

fn br(inout e: E, n: u32) {
    ins(inout e)
    w(inout e, "br label %L")
    wn(inout e, n as u64)
    fin(inout e)
    e.term = true
}

fn condbr(inout e: E, c: List[u8], t: u32, f: u32) {
    ins(inout e)
    w(inout e, "br i1 ")
    wb(inout e, c)
    w(inout e, ", label %L")
    wn(inout e, t as u64)
    w(inout e, ", label %L")
    wn(inout e, f as u64)
    fin(inout e)
    e.term = true
}

/// Begin an instruction `  %r<n> = ` (its text follows, then `fin`); returns the register.
fn begin(inout e: E) -> List[u8] {
    let r = reg(inout e)
    ins(inout e)
    wb(inout e, r)
    w(inout e, " = ")
    r
}

/// `<dst> = <text>` as one instruction; returns dst.
fn val(inout e: E, text: List[u8]) -> List[u8] {
    let r = reg(inout e)
    ins(inout e)
    wb(inout e, r)
    w(inout e, " = ")
    wb(inout e, text)
    fin(inout e)
    r
}

fn stmt_text(inout e: E, text: List[u8]) {
    ins(inout e)
    wb(inout e, text)
    fin(inout e)
}

fn unsupported(inout e: E, what: str) {
    if e.fail.len() == 0 { e.fail = lit(what) }
}

// ---- types

fn kind(p: lower.P, ty: u32) -> u32 { types.kind(p.t, ty) }

fn is_void(ty: u32) -> bool { ty == types.UNIT || ty == types.NEVER }

fn int_ty(k: u32) -> str {
    match k {
        0 => "i32"
        1 => "i64"
        2 => "i8"
        3 => "i32"
        _ => "i64"
    }
}

fn int_bits(k: u32) -> u32 {
    match k {
        0 => 32
        1 => 64
        2 => 8
        3 => 32
        _ => 64
    }
}

/// The LLVM type of a value of type ty in memory.
fn mty(inout e: E, p: lower.P, ty: u32) -> List[u8] {
    if ty >= PTR { return lit("ptr") }
    let t = types.get(p.t, ty)
    let k = t.kind
    if k == types.T_INT { return lit(int_ty(t.a)) }
    if k == types.T_BOOL || k == types.T_UNIT || k == types.T_NEVER { return lit("i8") }
    if k == types.T_STR { return lit("ptr") }
    if k == types.T_STRING { return lit("%ei.String") }
    def_ty(inout e, p, ty)
    num("%t", ty as u64)
}

/// The LLVM type of a scalar value in a register (bool: i1).
fn vty(inout e: E, p: lower.P, ty: u32) -> List[u8] {
    if ty < PTR && kind(p, ty) == types.T_BOOL { return lit("i1") }
    mty(inout e, p, ty)
}

fn is_scalar(p: lower.P, ty: u32) -> bool { abi.scalar(p, ty) }

fn members(inout e: E, p: lower.P, ms: List[u32]) -> List[u8] {
    let mut o = lit(r"{ ")
    if ms.len() == 0 { bytes.append(inout o, lit("i8")) }
    for i in 0..ms.len() {
        if i > 0 { bytes.append(inout o, lit(", ")) }
        bytes.append(inout o, mty(inout e, p, ms[i]))
    }
    bytes.append(inout o, lit(r" }"))
    o
}

fn tdef(inout e: E, name: List[u8], body: List[u8]) {
    bytes.append(inout e.tdefs, name)
    bytes.append(inout e.tdefs, lit(" = type "))
    bytes.append(inout e.tdefs, body)
    e.tdefs.push(10)
}

/// Define %t<ty> (and its variant or buffer structs) once.
fn def_ty(inout e: E, p: lower.P, ty: u32) {
    if e.tdone[ty as usize] { return }
    e.tdone[ty as usize] = true
    let t = types.get(p.t, ty)
    let k = t.kind
    let name = num("%t", ty as u64)
    if k == types.T_ARRAY {
        let n: u64 = if t.b == 0 { 1 } else { t.b as u64 }
        let mut b = num(r"{ [", n)
        bytes.append(inout b, lit(" x "))
        bytes.append(inout b, mty(inout e, p, t.a))
        bytes.append(inout b, lit(r"] }"))
        tdef(inout e, name, b)
    } else if k == types.T_TUPLE || (k == types.T_RECORD && !lower.shared_rec(p, ty)) {
        let b = members(inout e, p, abi.parts(p, ty, NONE))
        tdef(inout e, name, b)
    } else if k == types.T_RECORD {
        let b = members(inout e, p, abi.parts(p, ty, NONE))
        tdef(inout e, cat(name, ".d"), b)
        tdef(inout e, name, lit(r"{ ptr }"))
    } else if k == types.T_LIST {
        tdef(inout e, name, lit(r"{ ptr, i64, i64 }"))
    } else if k == types.T_MAP {
        tdef(inout e, name, lit(r"{ ptr, ptr, ptr, i64, i64, i64 }"))
    } else if k == types.T_FN {
        tdef(inout e, name, lit(r"{ ptr, ptr, ptr, ptr, ptr }"))
    } else if k == types.T_ENUM {
        let d = types.def_of(p.t, ty)
        if !lower.any_payload(p, d) {
            tdef(inout e, name, lit(r"{ i32 }"))
            return
        }
        let u = abi.union_of(inout e.lay, p, ty)
        let el = if u[1] == 1 { "i8" } else if u[1] == 2 { "i16" } else if u[1] == 4 { "i32" } else { "i64" }
        let mut b = num(r"{ i32, [", u[0] / u[1])
        bytes.append(inout b, lit(" x "))
        bytes.append(inout b, lit(el))
        bytes.append(inout b, lit(r"] }"))
        tdef(inout e, name, b)
        for i in 0..d.len {
            if types.variant(p.t, d, i).flen == 0 { continue }
            let vb = members(inout e, p, abi.parts(p, ty, i))
            let mut vn = cat(name, ".v")
            bytes.append(inout vn, bytes.from_u64(i as u64))
            tdef(inout e, vn, vb)
        }
    } else {
        // Box, Task, Mutex, Chan, Ref: one pointer
        tdef(inout e, name, lit(r"{ ptr }"))
    }
}

fn size(inout e: E, p: lower.P, ty: u32) -> u64 { abi.size(inout e.lay, p, ty) }
fn align(inout e: E, p: lower.P, ty: u32) -> u64 { abi.align(inout e.lay, p, ty) }

/// Whether values of ty own heap data (lower.ei's `owns`), memoized.
fn owns(inout e: E, p: lower.P, ty: u32) -> bool {
    let m = e.own[ty as usize]
    if m > 0 { return m == 2 }
    let t = types.get(p.t, ty)
    let k = t.kind
    let mut r = false
    if k == types.T_STRING || k == types.T_LIST || k == types.T_MAP || k == types.T_BOX || k == types.T_FN || types.is_handle(k) || k == types.T_REF {
        r = true
    } else if k == types.T_ARRAY {
        r = owns(inout e, p, t.a)
    } else if k == types.T_TUPLE {
        for x in types.elems(p.t, ty) {
            if owns(inout e, p, x) { r = true }
        }
    } else if k == types.T_RECORD {
        let d = types.def_of(p.t, ty)
        for j in 0..d.len {
            if owns(inout e, p, types.field(p.t, d.start, j).ty) { r = true }
        }
        if lower.shared_rec(p, ty) { r = true }
    } else if k == types.T_ENUM {
        let d = types.def_of(p.t, ty)
        for i in 0..d.len {
            let v = types.variant(p.t, d, i)
            for j in 0..v.flen {
                if owns(inout e, p, types.field(p.t, v.fstart, j).ty) { r = true }
            }
        }
    }
    let v: u8 = if r { 2 } else { 1 }
    e.own[ty as usize] = v
    r
}

/// The glue name `<op><C type name>` (lower.ei's gname).
fn gname(e: E, op: str, ty: u32) -> List[u8] { catb(lit(op), e.tn[ty as usize]) }

/// Ask for glue item (kind, id) (glue_all emits it).
fn gneed(inout e: E, kind: u32, id: u32) {
    let key = (kind as u64) * 4294967296 + id as u64
    if e.nseen.contains(key) { return }
    e.nseen.insert(key, true)
    e.needs.push(key)
}

// ---- constants

/// An integer constant of kind k as LLVM text (signed kinds as signed decimals).
fn int_text(k: u32, v: u64) -> List[u8] {
    if types.signed(k) && v >= 9223372036854775808 {
        let mut o = lit("-")
        bytes.append(inout o, bytes.from_u64(0 -% v))
        return o
    }
    if k == types.IK_I32 || k == types.IK_U32 { return bytes.from_u64(v % 4294967296) }
    if k == types.IK_U8 { return bytes.from_u64(v % 256) }
    bytes.from_u64(v)
}

fn c_string(inout out: List[u8], s: List[u8]) {
    out.push(99)
    out.push(34)
    for b in s {
        if b >= 32 && b < 127 && b != 34 && b != 92 {
            out.push(b)
        } else {
            out.push(92)
            let hx = lit("0123456789ABCDEF")
            out.push(hx[(b / 16) as usize])
            out.push(hx[(b % 16) as usize])
        }
    }
    bytes.append(inout out, lit("\\00\""))
}

/// A private constant for a runtime message (the same text the C runtime prints).
fn msg(inout e: E, text: str) -> List[u8] {
    let s = lit(text)
    let k = h64(s)
    match e.msgs.get(k) {
        Some(i) => { return num("@.m", i as u64) }
        None => {}
    }
    let i = e.nmsg
    e.nmsg += 1
    e.msgs.insert(k, i)
    let name = num("@.m", i as u64)
    bytes.append(inout e.gl, name)
    bytes.append(inout e.gl, lit(" = private unnamed_addr constant ["))
    bytes.append(inout e.gl, bytes.from_u64((s.len() + 1) as u64))
    bytes.append(inout e.gl, lit(" x i8] "))
    c_string(inout e.gl, s)
    e.gl.push(10)
    name
}

/// The source line for the runtime (lower.ei's put_line).
fn line_of(inout e: E, line: u32) -> List[u8] {
    if e.file == 0 || line >= 1048576 { return bytes.from_u64(line as u64) }
    if !e.tfiles.contains(e.file) { e.tfiles.push(e.file) }
    bytes.from_u64((e.file as u64) * 1048576 + line as u64)
}

// ---- declarations and calls

fn declare(inout e: E, name: List[u8], text: List[u8]) {
    let k = h64(name)
    if e.didx.contains(k) { return }
    e.didx.insert(k, e.dnames.len() as u32)
    e.dnames.push(name)
    e.dtext.push(text)
}

/// The extension attribute of a direct argument or result (none on AArch64).
fn ext_of(p: lower.P, a: abi.Arg) -> str {
    if a.c1 == abi.NOEXT { return "" }
    let ty = a.ty
    if ty >= PTR { return "" }
    let t = types.get(p.t, ty)
    if t.kind == types.T_BOOL || t.kind == types.T_UNIT || t.kind == types.T_NEVER || (t.kind == types.T_INT && t.a == types.IK_U8) { return " zeroext" }
    ""
}

fn coerce_ty(a: abi.Arg) -> List[u8] {
    if a.n == 1 { return num("i", a.b0 as u64) }
    if a.c0 == abi.C_PAIR { return lit("[2 x i64]") }
    let mut o = num(r"{ i", a.b0 as u64)
    bytes.append(inout o, lit(", i"))
    bytes.append(inout o, bytes.from_u64(a.b1 as u64))
    bytes.append(inout o, lit(r" }"))
    o
}

fn ret_text(inout e: E, p: lower.P, s: abi.Sig) -> List[u8] {
    let r = s.ret
    if r.kind == abi.A_VOID || r.kind == abi.A_SRET { return lit("void") }
    if r.kind == abi.A_DIRECT {
        let mut o = lit(ext_of(p, r))
        if o.len() > 0 { o = lit("zeroext ") }
        bytes.append(inout o, vty(inout e, p, r.ty))
        return o
    }
    coerce_ty(r)
}

/// The parameter types of a signature (for a declare or define; `names` names them).
/// `internal`: the internal convention's define, with the attributes the language
/// guarantees (see `param_attrs`).
fn params_text(inout e: E, p: lower.P, s: abi.Sig, names: List[List[u8]], internal: bool) -> List[u8] {
    let mut o: List[u8] = List.new()
    let mut first = true
    let mut ni: usize = 0
    if s.ret.kind == abi.A_SRET {
        if internal { bytes.append(inout o, lit("ptr noalias sret(")) } else { bytes.append(inout o, lit("ptr sret(")) }
        bytes.append(inout o, mty(inout e, p, s.ret.ty))
        bytes.append(inout o, lit(") align "))
        bytes.append(inout o, bytes.from_u64(align(inout e, p, s.ret.ty)))
        if names.len() > 0 {
            bytes.append(inout o, lit(" "))
            bytes.append(inout o, names[ni])
            ni += 1
        }
        first = false
    }
    for a in s.args {
        if a.kind == abi.A_DIRECT {
            if !first { bytes.append(inout o, lit(", ")) }
            first = false
            bytes.append(inout o, vty(inout e, p, a.ty))
            bytes.append(inout o, lit(ext_of(p, a)))
            if internal { param_attrs(inout e, p, inout o, a) }
            if names.len() > 0 {
                bytes.append(inout o, lit(" "))
                bytes.append(inout o, names[ni])
                ni += 1
            }
        } else if a.kind == A_REF {
            if !first { bytes.append(inout o, lit(", ")) }
            first = false
            bytes.append(inout o, lit("ptr"))
            param_attrs(inout e, p, inout o, a)
            if names.len() > 0 {
                bytes.append(inout o, lit(" "))
                bytes.append(inout o, names[ni])
                ni += 1
            }
        } else if a.kind == abi.A_COERCE && a.c0 == abi.C_PAIR {
            // AArch64: two pieces as one array, never split (unpacked at entry: unpack_pairs)
            if !first { bytes.append(inout o, lit(", ")) }
            first = false
            bytes.append(inout o, lit("[2 x i64]"))
            if names.len() > 0 {
                bytes.append(inout o, lit(" "))
                bytes.append(inout o, names[ni])
                ni += 1
            }
        } else if a.kind == abi.A_COERCE {
            for i in 0..a.n {
                if !first { bytes.append(inout o, lit(", ")) }
                first = false
                let bits = if i == 0 { a.b0 } else { a.b1 }
                bytes.append(inout o, num("i", bits as u64))
                if names.len() > 0 {
                    bytes.append(inout o, lit(" "))
                    bytes.append(inout o, names[ni])
                    ni += 1
                }
            }
        } else if a.c0 == abi.C_PTR {
            // AArch64: a pointer to the caller's copy
            if !first { bytes.append(inout o, lit(", ")) }
            first = false
            bytes.append(inout o, lit("ptr"))
            if names.len() > 0 {
                bytes.append(inout o, lit(" "))
                bytes.append(inout o, names[ni])
                ni += 1
            }
        } else {
            if !first { bytes.append(inout o, lit(", ")) }
            first = false
            bytes.append(inout o, lit("ptr byval("))
            bytes.append(inout o, mty(inout e, p, a.ty))
            bytes.append(inout o, lit(") align "))
            bytes.append(inout o, bytes.from_u64(byval_align(inout e, p, a.ty)))
            if names.len() > 0 {
                bytes.append(inout o, lit(" "))
                bytes.append(inout o, names[ni])
                ni += 1
            }
        }
    }
    o
}

/// The alignment of a byval copy: 8 on x86-64 (the psABI's stack slots), the type's own on
/// wasm32 (as clang passes it).
fn byval_align(inout e: E, p: lower.P, ty: u32) -> u64 {
    if e.lay.wasm { return align(inout e, p, ty) }
    8
}

/// The attributes of an internal-convention parameter, each a language guarantee:
/// - every scalar is `noundef`: locals are written before they are read (zeroed otherwise),
///   so no value is ever undefined;
/// - an `inout` pointer is `noalias` (C8.6: an inout argument is exclusive, E0301, and the
///   caller makes its path unique before the call), `noundef`, and points to a whole value
///   of its type: `align`, `dereferenceable`;
/// - an A_REF pointer is the caller's value, not written by the callee and not reachable from
///   the call's other arguments (call_internal): `noalias nocapture readonly`, aligned and
///   dereferenceable.
fn param_attrs(inout e: E, p: lower.P, inout o: List[u8], a: abi.Arg) {
    if a.kind == A_REF || a.ty >= PTR {
        let t = if a.ty >= PTR { a.ty - PTR } else { a.ty }
        if a.kind == A_REF { bytes.append(inout o, lit(" noalias nocapture readonly noundef align ")) } else { bytes.append(inout o, lit(" noalias noundef align ")) }
        bytes.append(inout o, bytes.from_u64(align(inout e, p, t)))
        bytes.append(inout o, lit(" dereferenceable("))
        bytes.append(inout o, bytes.from_u64(size(inout e, p, t)))
        bytes.append(inout o, lit(")"))
        return
    }
    bytes.append(inout o, lit(" noundef"))
}

fn declare_sig(inout e: E, p: lower.P, name: List[u8], s: abi.Sig, noreturn: bool) {
    if e.didx.contains(h64(name)) { return }
    let mut d = lit("declare ")
    bytes.append(inout d, ret_text(inout e, p, s))
    bytes.append(inout d, lit(" @"))
    bytes.append(inout d, name)
    bytes.append(inout d, lit("("))
    let none: List[List[u8]] = List.new()
    bytes.append(inout d, params_text(inout e, p, s, none, false))
    bytes.append(inout d, lit(")"))
    if noreturn { bytes.append(inout d, lit(" noreturn")) }
    declare(inout e, name, d)
}

/// Load `bits` bits at byte offset `off` of address a.
fn load_piece(inout e: E, a: List[u8], off: u64, bits: u32) -> List[u8] {
    let mut at = a.copy()
    if off > 0 {
        let mut g = lit("getelementptr inbounds i8, ptr ")
        bytes.append(inout g, a)
        bytes.append(inout g, lit(", i64 "))
        bytes.append(inout g, bytes.from_u64(off))
        at = val(inout e, g)
    }
    let mut t = num("load i", bits as u64)
    bytes.append(inout t, lit(", ptr "))
    bytes.append(inout t, at)
    val(inout e, t)
}

fn store_piece(inout e: E, v: List[u8], a: List[u8], off: u64, bits: u32) {
    let mut at = a.copy()
    if off > 0 {
        let mut g = lit("getelementptr inbounds i8, ptr ")
        bytes.append(inout g, a)
        bytes.append(inout g, lit(", i64 "))
        bytes.append(inout g, bytes.from_u64(off))
        at = val(inout e, g)
    }
    let mut t = num("store i", bits as u64)
    bytes.append(inout t, lit(" "))
    bytes.append(inout t, v)
    bytes.append(inout t, lit(", ptr "))
    bytes.append(inout t, at)
    stmt_text(inout e, t)
}

/// Call `name` (signature ptys -> ret, the C ABI) with args: a scalar's value (bool as i1),
/// or an aggregate's address. An aggregate result is written to `dst` (an address; a fresh
/// temporary when empty); a scalar result is returned.
fn call(inout e: E, p: lower.P, name: List[u8], ptys: List[u32], args: List[List[u8]], ret: u32, dst: List[u8]) -> List[u8] {
    let s = csig_of(inout e, p, ptys, ret)
    declare_sig(inout e, p, name, s, false)
    call_sig(inout e, p, catb(lit("@"), name), s, args, dst)
}

/// The C convention of (ptys) -> ret, memoized (glue and runtime calls repeat a few
/// hundred signatures many thousand times).
fn csig_of(inout e: E, p: lower.P, ptys: List[u32], ret: u32) -> abi.Sig {
    let mut h: u64 = 14695981039346656037
    for t in ptys { h = (h ^ (t as u64)) *% 1099511628211 }
    h = (h ^ (ret as u64 + 4294967296)) *% 1099511628211
    let mut hit = NONE
    match e.sigmemo.get(h) {
        Some(i) => { hit = i }
        None => {}
    }
    if hit != NONE {
        // the same types (a hash collision computes it afresh)
        let c = e.sigs[hit as usize].copy()
        let mut same = c.ret.ty == ret && c.args.len() == ptys.len()
        if same {
            for i in 0..ptys.len() {
                if c.args[i].ty != ptys[i] { same = false }
            }
        }
        if same { return c }
        return abi.sig(inout e.lay, p, ptys, ret)
    }
    let s = abi.sig(inout e.lay, p, ptys, ret)
    e.sigmemo.insert(h, e.sigs.len() as u32)
    e.sigs.push(s.copy())
    s
}

fn call_sig(inout e: E, p: lower.P, callee: List[u8], s: abi.Sig, args: List[List[u8]], dst: List[u8]) -> List[u8] {
    let mut d = dst.copy()
    if (s.ret.kind == abi.A_SRET || s.ret.kind == abi.A_COERCE) && d.len() == 0 { d = temp(inout e, p, s.ret.ty) }
    // the pieces of coerced arguments, loaded before the call
    let mut pieces: List[List[u8]] = List.new()
    // AArch64's large arguments: a copy for the callee, made here
    let mut copies: List[List[u8]] = List.new()
    for i in 0..s.args.len() {
        let a = s.args[i]
        if a.kind == abi.A_COERCE && a.c0 == abi.C_PAIR {
            let p0 = load_piece(inout e, args[i], 0, a.b0)
            let mut p1 = load_piece(inout e, args[i], 8, a.b1)
            if a.b1 < 64 { p1 = val(inout e, catb(num("zext i", a.b1 as u64), catb(lit(" "), cat(p1, " to i64")))) }
            let x = val(inout e, catb(lit("insertvalue [2 x i64] poison, i64 "), cat(p0, ", 0")))
            pieces.push(val(inout e, catb(lit("insertvalue [2 x i64] "), catb(x, catb(lit(", i64 "), cat(p1, ", 1"))))))
        } else if a.kind == abi.A_COERCE {
            pieces.push(load_piece(inout e, args[i], 0, a.b0))
            if a.n > 1 { pieces.push(load_piece(inout e, args[i], 8, a.b1)) }
        }
        if a.kind == abi.A_BYVAL && a.c0 == abi.C_PTR {
            let t = temp(inout e, p, a.ty)
            memcpy(inout e, p, a.ty, t, args[i])
            copies.push(t)
        } else {
            copies.push(List.new())
        }
    }
    let rt = ret_text(inout e, p, s)
    let mut r: List[u8] = List.new()
    if s.ret.kind == abi.A_DIRECT || s.ret.kind == abi.A_COERCE { r = begin(inout e) } else { ins(inout e) }
    w(inout e, "call ")
    wb(inout e, rt)
    w(inout e, " ")
    wb(inout e, callee)
    w(inout e, "(")
    let mut first = true
    if s.ret.kind == abi.A_SRET {
        let mt = mty(inout e, p, s.ret.ty)
        let al = align(inout e, p, s.ret.ty)
        w(inout e, "ptr sret(")
        wb(inout e, mt)
        w(inout e, ") align ")
        wn(inout e, al)
        w(inout e, " ")
        wb(inout e, d)
        first = false
    }
    let mut pi: usize = 0
    for i in 0..s.args.len() {
        let a = s.args[i]
        if !first { w(inout e, ", ") }
        first = false
        if a.kind == abi.A_DIRECT {
            let vt = vty(inout e, p, a.ty)
            wb(inout e, vt)
            let ea = ext_of(p, a)
            w(inout e, ea)
            w(inout e, " ")
            wb(inout e, args[i])
        } else if a.kind == abi.A_COERCE && a.c0 == abi.C_PAIR {
            w(inout e, "[2 x i64] ")
            wb(inout e, pieces[pi])
            pi += 1
        } else if a.kind == abi.A_COERCE {
            w(inout e, "i")
            wn(inout e, a.b0 as u64)
            w(inout e, " ")
            wb(inout e, pieces[pi])
            pi += 1
            if a.n > 1 {
                w(inout e, ", i")
                wn(inout e, a.b1 as u64)
                w(inout e, " ")
                wb(inout e, pieces[pi])
                pi += 1
            }
        } else if a.kind == A_REF {
            w(inout e, "ptr ")
            wb(inout e, args[i])
        } else if a.c0 == abi.C_PTR {
            w(inout e, "ptr ")
            wb(inout e, copies[i])
        } else {
            let mt = mty(inout e, p, a.ty)
            w(inout e, "ptr byval(")
            wb(inout e, mt)
            let ba = byval_align(inout e, p, a.ty)
            w(inout e, ") align ")
            wn(inout e, ba)
            w(inout e, " ")
            wb(inout e, args[i])
        }
    }
    w(inout e, ")")
    fin(inout e)
    if s.ret.kind == abi.A_DIRECT { return r }
    if s.ret.kind == abi.A_COERCE {
        if s.ret.n == 1 {
            store_piece(inout e, r, d, 0, s.ret.b0)
        } else {
            let mut x0 = lit("extractvalue ")
            bytes.append(inout x0, coerce_ty(s.ret))
            bytes.append(inout x0, lit(" "))
            bytes.append(inout x0, r)
            let v0 = val(inout e, cat(x0, ", 0"))
            let mut v1 = val(inout e, cat(x0, ", 1"))
            if s.ret.c0 == abi.C_PAIR && s.ret.b1 < 64 { v1 = val(inout e, catb(lit("trunc i64 "), catb(v1, num(" to i", s.ret.b1 as u64)))) }
            store_piece(inout e, v0, d, 0, s.ret.b0)
            store_piece(inout e, v1, d, 8, s.ret.b1)
        }
    }
    List.new()
}

/// A fresh temporary of type ty in the entry block; returns its address.
fn temp(inout e: E, p: lower.P, ty: u32) -> List[u8] {
    let r = reg(inout e)
    bytes.append(inout e.ent, lit("  "))
    bytes.append(inout e.ent, r)
    bytes.append(inout e.ent, lit(" = alloca "))
    let mt = mty(inout e, p, ty)
    let al = align(inout e, p, ty)
    bytes.append(inout e.ent, mt)
    bytes.append(inout e.ent, lit(", align "))
    bytes.append(inout e.ent, bytes.from_u64(al))
    e.ent.push(10)
    r
}

fn rt_call(inout e: E, p: lower.P, name: str, ptys: List[u32], args: List[List[u8]], ret: u32) -> List[u8] {
    let none: List[u8] = List.new()
    call(inout e, p, lit(name), ptys, args, ret, none)
}

fn tys1(a: u32) -> List[u32] {
    let mut o: List[u32] = List.new()
    o.push(a)
    o
}

fn tys2(a: u32, b: u32) -> List[u32] {
    let mut o = tys1(a)
    o.push(b)
    o
}

fn tys3(a: u32, b: u32, c: u32) -> List[u32] {
    let mut o = tys2(a, b)
    o.push(c)
    o
}

fn args1(a: List[u8]) -> List[List[u8]] {
    let mut o: List[List[u8]] = List.new()
    o.push(a)
    o
}

fn args2(a: List[u8], b: List[u8]) -> List[List[u8]] {
    let mut o = args1(a)
    o.push(b)
    o
}

fn tys4(a: u32, b: u32, c: u32, d: u32) -> List[u32] {
    let mut o = tys3(a, b, c)
    o.push(d)
    o
}

fn args4(a: List[u8], b: List[u8], c: List[u8], d: List[u8]) -> List[List[u8]] {
    let mut o = args3(a, b, c)
    o.push(d)
    o
}

fn args3(a: List[u8], b: List[u8], c: List[u8]) -> List[List[u8]] {
    let mut o = args2(a, b)
    o.push(c)
    o
}

/// Trap with a runtime message when i1 `c` holds: `br c, trap, ok`.
fn trap_if(inout e: E, c: List[u8], text: str, line: u32) {
    let t = new_label(inout e)
    let ok = new_label(inout e)
    condbr(inout e, c, t, ok)
    label(inout e, t)
    let m = msg(inout e, text)
    trap_with(inout e, m, line)
    label(inout e, ok)
}

/// `call ei_trap(m, line); unreachable` (m: a pointer value).
fn trap_with(inout e: E, m: List[u8], line: u32) {
    declare(inout e, lit("ei_trap"), lit("declare void @ei_trap(ptr, i32) noreturn"))
    let mut t = lit("call void @ei_trap(ptr ")
    bytes.append(inout t, m)
    bytes.append(inout t, lit(", i32 "))
    bytes.append(inout t, line_of(inout e, line))
    bytes.append(inout t, lit(")"))
    stmt_text(inout e, t)
    stmt_text(inout e, lit("unreachable"))
    e.term = true
}

// ---- memory

/// The local whose address text is a (`%l<n>`), when it is an SSA value; else NONE.
fn ssa_slot(e: E, a: List[u8]) -> u32 {
    if a.len() < 3 || a[0] != 37 || a[1] != 108 { return NONE }
    let mut n: u32 = 0
    for i in 2..a.len() {
        let c = a[i]
        if c < 48 || c > 57 { return NONE }
        n = n * 10 + (c - 48) as u32
    }
    if (n as usize) < e.ssa.len() && e.ssa[n as usize] { return n }
    NONE
}

fn load(inout e: E, p: lower.P, ty: u32, a: List[u8]) -> List[u8] {
    let sl = ssa_slot(e, a)
    if sl != NONE {
        if e.vals[sl as usize].len() == 0 {
            // scan proved every read follows the one assignment; this one doesn't
            unsupported(inout e, "an SSA value read before it is assigned")
            return lit("poison")
        }
        return e.vals[sl as usize].copy()
    }
    let mt = mty(inout e, p, ty)
    let r = begin(inout e)
    w(inout e, "load ")
    wb(inout e, mt)
    w(inout e, ", ptr ")
    wb(inout e, a)
    fin(inout e)
    if ty < PTR && kind(p, ty) == types.T_BOOL {
        return val(inout e, catb(lit("trunc i8 "), cat(r, " to i1")))
    }
    r
}

fn store(inout e: E, p: lower.P, ty: u32, v: List[u8], a: List[u8]) {
    let sl = ssa_slot(e, a)
    if sl != NONE {
        e.vals[sl as usize] = v.copy()
        return
    }
    let mut x = v.copy()
    if ty < PTR && kind(p, ty) == types.T_BOOL {
        x = val(inout e, catb(lit("zext i1 "), cat(v, " to i8")))
    }
    let mt = mty(inout e, p, ty)
    ins(inout e)
    w(inout e, "store ")
    wb(inout e, mt)
    w(inout e, " ")
    wb(inout e, x)
    w(inout e, ", ptr ")
    wb(inout e, a)
    fin(inout e)
}

fn memcpy(inout e: E, p: lower.P, ty: u32, dst: List[u8], src: List[u8]) {
    declare(inout e, lit("llvm.memcpy.p0.p0.i64"), lit("declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)"))
    let n = size(inout e, p, ty)
    ins(inout e)
    w(inout e, "call void @llvm.memcpy.p0.p0.i64(ptr ")
    wb(inout e, dst)
    w(inout e, ", ptr ")
    wb(inout e, src)
    w(inout e, ", i64 ")
    wn(inout e, n)
    w(inout e, ", i1 false)")
    fin(inout e)
}

fn zero(inout e: E, p: lower.P, ty: u32, a: List[u8]) {
    if is_scalar(p, ty) {
        let z = if ty < PTR && kind(p, ty) == types.T_STR { "null" } else if ty < PTR && kind(p, ty) == types.T_BOOL { "false" } else { "0" }
        store(inout e, p, ty, lit(z), a)
        return
    }
    declare(inout e, lit("llvm.memset.p0.i64"), lit("declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)"))
    let mut t = lit("call void @llvm.memset.p0.i64(ptr ")
    bytes.append(inout t, a)
    bytes.append(inout t, lit(", i8 0, i64 "))
    bytes.append(inout t, bytes.from_u64(size(inout e, p, ty)))
    bytes.append(inout t, lit(", i1 false)"))
    stmt_text(inout e, t)
}

/// Copy a value of type ty from address src to address dst.
fn copy_mem(inout e: E, p: lower.P, ty: u32, dst: List[u8], src: List[u8]) {
    if is_scalar(p, ty) {
        let v = load(inout e, p, ty, src)
        store(inout e, p, ty, v, dst)
    } else {
        memcpy(inout e, p, ty, dst, src)
    }
}

/// The address of member i of the struct %t<ty> (or a variant/buffer struct named by sfx).
fn gep(inout e: E, p: lower.P, sty: List[u8], a: List[u8], i: u32) -> List[u8] {
    // a struct's first member is at its own address
    if i == 0 { return a.copy() }
    let r = begin(inout e)
    w(inout e, "getelementptr inbounds ")
    wb(inout e, sty)
    w(inout e, ", ptr ")
    wb(inout e, a)
    w(inout e, ", i32 0, i32 ")
    wn(inout e, i as u64)
    fin(inout e)
    r
}

fn field_addr(inout e: E, p: lower.P, ty: u32, a: List[u8], i: u32) -> List[u8] {
    let st = mty(inout e, p, ty)
    gep(inout e, p, st, a, i)
}

/// A pointer member i of the aggregate at a, loaded.
fn load_ptr_field(inout e: E, p: lower.P, ty: u32, a: List[u8], i: u32) -> List[u8] {
    let f = field_addr(inout e, p, ty, a, i)
    val(inout e, catb(lit("load ptr, ptr "), f))
}

fn load_i64_field(inout e: E, p: lower.P, ty: u32, a: List[u8], i: u32) -> List[u8] {
    let f = field_addr(inout e, p, ty, a, i)
    val(inout e, catb(lit("load i64, ptr "), f))
}

/// The address of variant v's field f of the enum at a.
fn payload_addr(inout e: E, p: lower.P, ty: u32, a: List[u8], v: u32, f: u32) -> List[u8] {
    let u = field_addr(inout e, p, ty, a, 1)
    let mut vn = num("%t", ty as u64)
    bytes.append(inout vn, lit(".v"))
    bytes.append(inout vn, bytes.from_u64(v as u64))
    gep(inout e, p, vn, u, f)
}

// ---- locals, operands, places

fn loc(p: lower.P, e: E, l: u32) -> ir.Local { p.ir.locals[(e.lbase + l) as usize] }

fn laddr(l: u32) -> List[u8] { num("%l", l as u64) }

/// A scalar operand's value (bool: i1; () : 0).
fn opv(inout e: E, p: lower.P, id: u32) -> List[u8] {
    let x = p.ir.ops[id as usize]
    if x.kind == ir.O_INT { return int_text(types.ik(p.t, x.ty), x.v) }
    if x.kind == ir.O_BOOL {
        if x.v == 1 { return lit("true") }
        return lit("false")
    }
    if x.kind == ir.O_STR {
        e.sused[x.a as usize] = true
        return num("@.s", x.a as u64)
    }
    if x.kind == ir.O_UNIT { return lit("0") }
    let lt = loc(p, e, x.a).ty
    if is_void(lt) { return lit("0") }
    load(inout e, p, lt, laddr(x.a))
}

/// An aggregate operand's address (it is always a local).
fn opa(inout e: E, p: lower.P, id: u32) -> List[u8] {
    let x = p.ir.ops[id as usize]
    if x.kind != ir.O_LOCAL {
        unsupported(inout e, "an aggregate constant")
        return lit("null")
    }
    laddr(x.a)
}

/// An operand as a call argument of its own type: its value if scalar, else its address.
fn oparg(inout e: E, p: lower.P, id: u32) -> List[u8] {
    if is_scalar(p, ir.op_ty(p.ir, id)) { return opv(inout e, p, id) }
    opa(inout e, p, id)
}

/// Store operand id (of type ty) at address a.
fn put_op(inout e: E, p: lower.P, ty: u32, id: u32, a: List[u8]) {
    if is_scalar(p, ty) {
        let v = opv(inout e, p, id)
        store(inout e, p, ty, v, a)
    } else {
        let s = opa(inout e, p, id)
        memcpy(inout e, p, ty, a, s)
    }
}

/// An index operand widened to i64 (index operands are usize; others are converted as C's
/// `(uint64_t)` cast would).
fn idx64(inout e: E, p: lower.P, id: u32) -> List[u8] {
    let ty = ir.op_ty(p.ir, id)
    let v = opv(inout e, p, id)
    let k = types.ik(p.t, ty)
    if int_bits(k) == 64 { return v }
    let op = if types.signed(k) { "sext " } else { "zext " }
    let mut t = lit(op)
    bytes.append(inout t, lit(int_ty(k)))
    bytes.append(inout t, lit(" "))
    bytes.append(inout t, v)
    bytes.append(inout t, lit(" to i64"))
    val(inout e, t)
}

/// `getelementptr inbounds` for an element of a place: its index is in bounds, because
/// every statement that addresses a place first checks its indices (`checks`, outermost
/// first), except a closure call's `inout` arguments (S_CALLV, as in the C backend), whose
/// element addresses are therefore plain GEPs.
fn gep_kw(e: E) -> str {
    if e.unchecked { return "getelementptr " }
    "getelementptr inbounds "
}

/// The address of a place (its indices are checked already).
fn paddr(inout e: E, p: lower.P, id: u32) -> List[u8] {
    let x = p.ir.places[id as usize]
    if x.kind == ir.P_LOCAL { return laddr(x.a) }
    let bty = p.ir.places[x.a as usize].ty
    let b = paddr(inout e, p, x.a)
    if x.kind == ir.P_FIELD {
        if lower.shared_rec(p, bty) {
            let q = load_ptr_field(inout e, p, bty, b, 0)
            return gep(inout e, p, cat(num("%t", bty as u64), ".d"), q, x.b)
        }
        return field_addr(inout e, p, bty, b, x.b)
    }
    if x.kind == ir.P_INDEX {
        let i = idx64(inout e, p, x.b)
        let et = types.get(p.t, bty).a
        if kind(p, bty) == types.T_LIST {
            let d = load_ptr_field(inout e, p, bty, b, 0)
            let mut t = lit(gep_kw(e))
            bytes.append(inout t, mty(inout e, p, et))
            bytes.append(inout t, lit(", ptr "))
            bytes.append(inout t, d)
            bytes.append(inout t, lit(", i64 "))
            bytes.append(inout t, i)
            return val(inout e, t)
        }
        let mut t = lit(gep_kw(e))
        bytes.append(inout t, mty(inout e, p, bty))
        bytes.append(inout t, lit(", ptr "))
        bytes.append(inout t, b)
        bytes.append(inout t, lit(", i32 0, i32 0, i64 "))
        bytes.append(inout t, i)
        return val(inout e, t)
    }
    if x.kind == ir.P_PAYLOAD { return payload_addr(inout e, p, bty, b, x.b, x.c) }
    load_ptr_field(inout e, p, bty, b, 0)
}

/// Bounds checks of every index in place id, outermost first (lower.ei's `checks`).
fn checks(inout e: E, p: lower.P, id: u32) {
    let x = p.ir.places[id as usize]
    if x.kind == ir.P_LOCAL { return }
    checks(inout e, p, x.a)
    if x.kind != ir.P_INDEX { return }
    let i = idx64(inout e, p, x.b)
    let bty = p.ir.places[x.a as usize].ty
    let bt = types.get(p.t, bty)
    let mut n = bytes.from_u64(bt.b as u64)
    if bt.kind == types.T_LIST {
        let b = paddr(inout e, p, x.a)
        n = load_i64_field(inout e, p, bty, b, 1)
    }
    let mut c = lit("icmp uge i64 ")
    bytes.append(inout c, i)
    bytes.append(inout c, lit(", "))
    bytes.append(inout c, n)
    let r = val(inout e, c)
    trap_if(inout e, r, "index out of bounds", x.line)
}

/// `uniq_` (or ei_str_unique) of the value of type ty at address a (lower.ei's uniq_call).
fn uniq_call(inout e: E, p: lower.P, ty: u32, a: List[u8]) {
    let k = kind(p, ty)
    let none: List[u8] = List.new()
    if k == types.T_STRING {
        call(inout e, p, lit("ei_str_unique"), tys1(PTR + ty), args1(a), types.UNIT, none)
    } else if k == types.T_LIST || k == types.T_MAP || k == types.T_BOX || lower.shared_rec(p, ty) {
        gneed(inout e, lower.GK_UNIQ, ty)
        let gn_ = gname(e, "uniq_", ty)
        call(inout e, p, gn_, tys1(PTR + ty), args1(a), types.UNIT, none)
    }
}

/// Copy-on-write before a write into place id (lower.ei's `uniqs`).
fn uniqs(inout e: E, p: lower.P, id: u32) {
    let x = p.ir.places[id as usize]
    if x.kind == ir.P_LOCAL { return }
    uniqs(inout e, p, x.a)
    let bty = p.ir.places[x.a as usize].ty
    if x.kind == ir.P_DEREF || (x.kind == ir.P_INDEX && kind(p, bty) == types.T_LIST) || (x.kind == ir.P_FIELD && lower.shared_rec(p, bty)) {
        let b = paddr(inout e, p, x.a)
        uniq_call(inout e, p, bty, b)
    }
}

fn barg(p: lower.P, s: ir.Stmt, i: u32) -> u32 { p.ir.extra[(s.b + i) as usize] }

fn arg_ty(p: lower.P, a: u32) -> u32 {
    if a >= ir.ARG_PLACE { return p.ir.places[(a - ir.ARG_PLACE) as usize].ty }
    ir.op_ty(p.ir, a)
}

/// A builtin or call argument by value: a scalar's value, else an address (a place's or an
/// operand's).
fn argval(inout e: E, p: lower.P, a: u32) -> List[u8] {
    let ty = arg_ty(p, a)
    if a >= ir.ARG_PLACE {
        let ad = paddr(inout e, p, a - ir.ARG_PLACE)
        if is_scalar(p, ty) {
            if is_void(ty) { return lit("0") }
            return load(inout e, p, ty, ad)
        }
        return ad
    }
    oparg(inout e, p, a)
}

/// A builtin argument's address (`&arg`).
fn argptr(inout e: E, p: lower.P, a: u32) -> List[u8] {
    if a >= ir.ARG_PLACE { return paddr(inout e, p, a - ir.ARG_PLACE) }
    let x = p.ir.ops[a as usize]
    if x.kind == ir.O_LOCAL && !e.ssa[x.a as usize] { return laddr(x.a) }
    // a constant's (or an SSA value's) address: a temporary holding it
    let ty = ir.op_ty(p.ir, a)
    let t = temp(inout e, p, ty)
    put_op(inout e, p, ty, a, t)
    t
}

// ---- glue calls (lower.ei's drop_call, clone_expr, eq_expr, cmp_expr, hash_text, show_into)

fn drop_at(inout e: E, p: lower.P, ty: u32, a: List[u8]) {
    if !owns(inout e, p, ty) { return }
    let none: List[u8] = List.new()
    if kind(p, ty) == types.T_STRING {
        call(inout e, p, lit("ei_drop_String"), tys1(PTR + ty), args1(a), types.UNIT, none)
    } else {
        gneed(inout e, lower.GK_DROP, ty)
        let gn_ = gname(e, "drop_", ty)
        call(inout e, p, gn_, tys1(PTR + ty), args1(a), types.UNIT, none)
    }
}

/// A deep copy (clone) of the value at src written to dst.
fn clone_to(inout e: E, p: lower.P, ty: u32, src: List[u8], dst: List[u8]) {
    if !owns(inout e, p, ty) {
        copy_mem(inout e, p, ty, dst, src)
        return
    }
    if kind(p, ty) == types.T_STRING {
        call(inout e, p, lit("ei_share_String"), tys1(PTR + ty), args1(src), ty, dst)
    } else {
        gneed(inout e, lower.GK_CLONE, ty)
        let gn_ = gname(e, "clone_", ty)
        call(inout e, p, gn_, tys1(PTR + ty), args1(src), ty, dst)
    }
}

fn copy_to(inout e: E, p: lower.P, ty: u32, src: List[u8], dst: List[u8]) {
    let mut seen: Map[u32, bool] = Map.new()
    if !lower.deep(p, ty, inout seen) {
        clone_to(inout e, p, ty, src, dst)
        return
    }
    gneed(inout e, lower.GK_COPY, ty)
    let gn_ = gname(e, "copy_", ty)
    call(inout e, p, gn_, tys1(PTR + ty), args1(src), ty, dst)
}

fn str_ptr(inout e: E, p: lower.P, ty: u32, v: List[u8]) -> List[u8] {
    if kind(p, ty) == types.T_STRING { return load_ptr_field(inout e, p, ty, v, 0) }
    v
}

/// strlen(v) as an i64 (size_t is 32 bits on wasm32).
fn strlen64(inout e: E, p: lower.P, v: List[u8]) -> List[u8] {
    if !e.lay.wasm { return rt_call(inout e, p, "strlen", tys1(types.STR), args1(v), types.U64) }
    let r = rt_call(inout e, p, "strlen", tys1(types.STR), args1(v), types.U32)
    val(inout e, catb(lit("zext i32 "), cat(r, " to i64")))
}

fn strcmp(inout e: E, p: lower.P, ty: u32, a: List[u8], b: List[u8]) -> List[u8] {
    let x = str_ptr(inout e, p, ty, a)
    let y = str_ptr(inout e, p, ty, b)
    rt_call(inout e, p, "strcmp", tys2(types.STR, types.STR), args2(x, y), types.I32)
}

/// `a == b` as i1 for values (scalar values or aggregate addresses) of type ty.
fn eq_val(inout e: E, p: lower.P, ty: u32, a: List[u8], b: List[u8]) -> List[u8] {
    let k = kind(p, ty)
    if k == types.T_STR || k == types.T_STRING {
        let c = strcmp(inout e, p, ty, a, b)
        return val(inout e, catb(lit("icmp eq i32 "), cat(c, ", 0")))
    }
    if lower.is_struct_kind(k) {
        gneed(inout e, lower.GK_EQ, ty)
        let gn_ = gname(e, "eq_", ty)
        return rt_call_b(inout e, p, gn_, tys2(ty, ty), args2(a, b), types.BOOL)
    }
    if k == types.T_UNIT || k == types.T_NEVER { return lit("true") }
    let mut t = lit("icmp eq ")
    bytes.append(inout t, vty(inout e, p, ty))
    bytes.append(inout t, lit(" "))
    bytes.append(inout t, a)
    bytes.append(inout t, lit(", "))
    bytes.append(inout t, b)
    val(inout e, t)
}

fn rt_call_b(inout e: E, p: lower.P, name: List[u8], ptys: List[u32], args: List[List[u8]], ret: u32) -> List[u8] {
    let none: List[u8] = List.new()
    call(inout e, p, name, ptys, args, ret, none)
}

/// The order of a and b as an i32 whose sign is the order (lower.ei's cmp_expr).
fn cmp_val(inout e: E, p: lower.P, ty: u32, a: List[u8], b: List[u8]) -> List[u8] {
    let k = kind(p, ty)
    if k == types.T_STR || k == types.T_STRING { return strcmp(inout e, p, ty, a, b) }
    let gn_ = gname(e, "cmp_", ty)
    if lower.is_struct_kind(k) { gneed(inout e, lower.GK_CMP, ty) }
    if lower.is_struct_kind(k) { return rt_call_b(inout e, p, gn_, tys2(ty, ty), args2(a, b), types.I32) }
    if k == types.T_UNIT || k == types.T_NEVER { return lit("0") }
    let vt = vty(inout e, p, ty)
    let sg = k == types.T_INT && types.signed(types.ik(p.t, ty))
    let gt = icmp(inout e, pick(sg, "sgt", "ugt"), vt, a, b)
    let lt = icmp(inout e, pick(sg, "slt", "ult"), vt, a, b)
    let g32 = val(inout e, catb(lit("zext i1 "), cat(gt, " to i32")))
    let l32 = val(inout e, catb(lit("zext i1 "), cat(lt, " to i32")))
    val(inout e, catb(lit("sub i32 "), catb(g32, catb(lit(", "), l32))))
}

fn icmp(inout e: E, op: str, t: List[u8], a: List[u8], b: List[u8]) -> List[u8] {
    let r = begin(inout e)
    w(inout e, "icmp ")
    w(inout e, op)
    w(inout e, " ")
    wb(inout e, t)
    w(inout e, " ")
    wb(inout e, a)
    w(inout e, ", ")
    wb(inout e, b)
    fin(inout e)
    r
}

/// ei_hash_u64 inline (core/eider_rt.h).
fn mix64(inout e: E, x: List[u8]) -> List[u8] {
    let mut v = x.copy()
    for i in 0..3 {
        let s = val(inout e, catb(lit("lshr i64 "), cat(v, ", 33")))
        v = val(inout e, catb(lit("xor i64 "), catb(v, catb(lit(", "), s))))
        if i == 0 { v = val(inout e, catb(lit("mul i64 "), cat(v, ", -49064778989728563"))) }
        if i == 1 { v = val(inout e, catb(lit("mul i64 "), cat(v, ", -4265267296055464877"))) }
    }
    v
}

/// The hash of a value of type ty as i64 (lower.ei's hash_text).
fn hash_val(inout e: E, p: lower.P, ty: u32, v: List[u8]) -> List[u8] {
    let k = kind(p, ty)
    if k == types.T_STRING || k == types.T_STR {
        let s = str_ptr(inout e, p, ty, v)
        return rt_call(inout e, p, "ei_hash_str", tys1(types.STR), args1(s), types.U64)
    }
    let gn_ = gname(e, "hash_", ty)
    if lower.is_struct_kind(k) { gneed(inout e, lower.GK_HASH, ty) }
    if lower.is_struct_kind(k) { return rt_call_b(inout e, p, gn_, tys1(ty), args1(v), types.U64) }
    // (uint64_t)(v): integers widen by their signedness, bool and () are 0 or 1
    let mut x = v.copy()
    if k == types.T_UNIT || k == types.T_NEVER {
        x = lit("0")
    } else if k == types.T_BOOL {
        x = val(inout e, catb(lit("zext i1 "), cat(v, " to i64")))
    } else {
        let ik = types.ik(p.t, ty)
        if int_bits(ik) < 64 {
            let op = if types.signed(ik) { "sext " } else { "zext " }
            x = val(inout e, catb(lit(op), catb(lit(int_ty(ik)), catb(lit(" "), cat(v, " to i64")))))
        }
    }
    mix64(inout e, x)
}

/// Append the text of value v (of type ty) to the String at address o (lower.ei's show_into).
fn show_into(inout e: E, p: lower.P, ty: u32, o: List[u8], v: List[u8]) {
    let t = types.get(p.t, ty)
    let k = t.kind
    let none: List[u8] = List.new()
    let sp = PTR + types.STRING
    if k == types.T_UNIT {
        let m = msg(inout e, "()")
        call(inout e, p, lit("ei_str_push"), tys2(sp, types.STR), args2(o, m), types.UNIT, none)
    } else if k == types.T_INT {
        let x = if int_bits(t.a) == 64 { v.copy() } else if types.signed(t.a) { val(inout e, catb(lit("sext "), catb(lit(int_ty(t.a)), catb(lit(" "), cat(v, " to i64"))))) } else { val(inout e, catb(lit("zext "), catb(lit(int_ty(t.a)), catb(lit(" "), cat(v, " to i64"))))) }
        if types.signed(t.a) {
            call(inout e, p, lit("ei_str_push_i64"), tys2(sp, types.I64), args2(o, x), types.UNIT, none)
        } else {
            call(inout e, p, lit("ei_str_push_u64"), tys2(sp, types.U64), args2(o, x), types.UNIT, none)
        }
    } else if k == types.T_BOOL {
        let tr = msg(inout e, "true")
        let fa = msg(inout e, "false")
        let mut sel = lit("select i1 ")
        bytes.append(inout sel, v)
        bytes.append(inout sel, lit(", ptr "))
        bytes.append(inout sel, tr)
        bytes.append(inout sel, lit(", ptr "))
        bytes.append(inout sel, fa)
        let s = val(inout e, sel)
        call(inout e, p, lit("ei_str_push"), tys2(sp, types.STR), args2(o, s), types.UNIT, none)
    } else if k == types.T_STR {
        call(inout e, p, lit("ei_str_push"), tys2(sp, types.STR), args2(o, v), types.UNIT, none)
    } else if k == types.T_STRING {
        let q = load_ptr_field(inout e, p, ty, v, 0)
        let n = load_i64_field(inout e, p, ty, v, 1)
        call(inout e, p, lit("ei_str_cat"), tys3(sp, types.STR, types.U64), args3(o, q, n), types.UNIT, none)
    } else if lower.plain_show(p, ty) {
        gneed(inout e, lower.GK_NAME, ty)
        let tag = load_tag(inout e, p, ty, v)
        let gn_ = gname(e, "name_", ty)
        let nm = rt_call_b(inout e, p, gn_, tys1(types.U32), args1(tag), types.STR)
        call(inout e, p, lit("ei_str_push"), tys2(sp, types.STR), args2(o, nm), types.UNIT, none)
    } else {
        gneed(inout e, lower.GK_SHOW, ty)
        let gn_ = gname(e, "show_", ty)
        call(inout e, p, gn_, tys2(sp, ty), args2(o, v), types.UNIT, none)
    }
}

fn load_tag(inout e: E, p: lower.P, ty: u32, a: List[u8]) -> List[u8] {
    let f = field_addr(inout e, p, ty, a, 0)
    val(inout e, catb(lit("load i32, ptr "), f))
}

fn store_tag(inout e: E, p: lower.P, ty: u32, a: List[u8], tag: u32) {
    let f = field_addr(inout e, p, ty, a, 0)
    let mut t = num("store i32 ", tag as u64)
    bytes.append(inout t, lit(", ptr "))
    bytes.append(inout t, f)
    stmt_text(inout e, t)
}

// ---- statements

fn block(inout e: E, p: lower.P, b: u32) {
    let bl = p.ir.blocks[b as usize]
    for i in 0..bl.len {
        if e.fail.len() > 0 { return }
        stmt(inout e, p, p.ir.extra[(bl.start + i) as usize])
    }
}

fn set_line(inout e: E, line: u32) {
    if !e.dbg || line == 0 { return }
    let k = line as u64
    match e.dlines.get(k) {
        Some(m) => {
            e.dloc = m
            return
        }
        None => {}
    }
    let id = e.nmd.copy()
    e.nmd += 1
    bytes.append(inout e.md, num("!", id as u64))
    bytes.append(inout e.md, lit(" = !DILocation(line: "))
    bytes.append(inout e.md, bytes.from_u64(k))
    bytes.append(inout e.md, lit(", scope: !"))
    let sp = e.sp.copy()
    bytes.append(inout e.md, bytes.from_u64(sp as u64))
    bytes.append(inout e.md, lit(")\n"))
    e.dlines.insert(k, id)
    e.dloc = id
}

fn dst_addr(l: u32) -> List[u8] { laddr(l) }

fn stmt(inout e: E, p: lower.P, id: u32) {
    let s = p.ir.stmts[id as usize]
    let k = s.kind
    set_line(inout e, s.line)
    if e.prof > 0 && lower.prof_marks(p, s) { prof_line(inout e, s.line) }
    if k == ir.S_IF {
        let c = opv(inout e, p, s.a)
        let lt = new_label(inout e)
        let lf = new_label(inout e)
        let lj = new_label(inout e)
        condbr(inout e, c, lt, lf)
        label(inout e, lt)
        block(inout e, p, s.b)
        if !e.term { br(inout e, lj) }
        label(inout e, lf)
        block(inout e, p, s.c)
        label(inout e, lj)
        return
    }
    if k == ir.S_LOOP {
        let lh = new_label(inout e)
        let ls = new_label(inout e)
        let lx = new_label(inout e)
        label(inout e, lh)
        e.loops.push(ls)
        e.brks.push(lx)
        block(inout e, p, s.a)
        label(inout e, ls)
        block(inout e, p, s.b)
        if !e.term { br(inout e, lh) }
        e.loops.pop()
        e.brks.pop()
        e.term = true
        label(inout e, lx)
        return
    }
    let copies = k == ir.S_COPY || k == ir.S_READ || k == ir.S_MOVE || k == ir.S_CLONE
    if copies && is_void(loc(p, e, s.dst).ty) { return }
    if k == ir.S_DROP && !owns(inout e, p, s.ty) { return }
    if k == ir.S_READ || k == ir.S_STORE || k == ir.S_TAG || k == ir.S_MOVE || k == ir.S_DROP { checks(inout e, p, s.a) }
    if k == ir.S_CHECK {
        checks(inout e, p, s.a)
        return
    }
    if k == ir.S_CALL || k == ir.S_BUILTIN {
        for i in 0..s.c {
            let a = p.ir.extra[(s.b + i) as usize]
            if a >= ir.ARG_PLACE { checks(inout e, p, a - ir.ARG_PLACE) }
        }
    }
    if k == ir.S_STORE || k == ir.S_MOVE || k == ir.S_DROP { uniqs(inout e, p, s.a) }
    if k == ir.S_CALL || k == ir.S_CALLV {
        for i in 0..s.c {
            let a = p.ir.extra[(s.b + i) as usize]
            if a >= ir.ARG_PLACE { uniqs(inout e, p, a - ir.ARG_PLACE) }
        }
    }
    if k == ir.S_BUILTIN && mutates(s.a) && s.c > 0 {
        let a = p.ir.extra[s.b as usize]
        if a >= ir.ARG_PLACE { uniqs(inout e, p, a - ir.ARG_PLACE) }
    }
    if k == ir.S_COPY {
        let dt = loc(p, e, s.dst).ty
        put_op(inout e, p, dt, s.a, dst_addr(s.dst))
    } else if k == ir.S_READ || k == ir.S_MOVE {
        let a = paddr(inout e, p, s.a)
        let dt = loc(p, e, s.dst).ty
        copy_mem(inout e, p, dt, dst_addr(s.dst), a)
    } else if k == ir.S_STORE {
        let pl = p.ir.places[s.a as usize]
        if pl.kind == ir.P_LOCAL && is_void(loc(p, e, pl.a).ty) { return }
        let a = paddr(inout e, p, s.a)
        if is_void(pl.ty) {
            store(inout e, p, pl.ty, lit("0"), a)
        } else {
            put_op(inout e, p, pl.ty, s.b, a)
        }
    } else if k == ir.S_CLONE {
        let ty = ir.op_ty(p.ir, s.a)
        if owns(inout e, p, ty) {
            let src = opa(inout e, p, s.a)
            clone_to(inout e, p, ty, src, dst_addr(s.dst))
        } else {
            put_op(inout e, p, ty, s.a, dst_addr(s.dst))
        }
    } else if k == ir.S_DROP {
        let a = paddr(inout e, p, s.a)
        drop_at(inout e, p, s.ty, a)
    } else if k == ir.S_UNARY {
        unary(inout e, p, s)
    } else if k == ir.S_BINARY {
        binary(inout e, p, s)
    } else if k == ir.S_CAST {
        cast(inout e, p, s)
    } else if k == ir.S_CALL {
        call_fn(inout e, p, s)
    } else if k == ir.S_RECORD && lower.shared_rec(p, s.ty) {
        let mut ptys: List[u32] = List.new()
        let mut args: List[List[u8]] = List.new()
        for i in 0..s.c {
            let a = p.ir.extra[(s.b + i) as usize]
            ptys.push(ir.op_ty(p.ir, a))
            args.push(oparg(inout e, p, a))
        }
        gneed(inout e, lower.GK_RNEW, s.ty)
        let gn_ = gname(e, "rnew_", s.ty)
        call(inout e, p, gn_, ptys, args, s.ty, dst_addr(s.dst))
    } else if k == ir.S_RECORD || k == ir.S_TUPLE {
        let d = dst_addr(s.dst)
        zero(inout e, p, s.ty, d)
        let ms = abi.parts(p, s.ty, NONE)
        for i in 0..s.c {
            let f = field_addr(inout e, p, s.ty, d, i)
            put_op(inout e, p, ms[i as usize], p.ir.extra[(s.b + i) as usize], f)
        }
    } else if k == ir.S_VARIANT {
        let d = dst_addr(s.dst)
        zero(inout e, p, s.ty, d)
        store_tag(inout e, p, s.ty, d, s.a)
        if s.c > 0 {
            let ms = abi.parts(p, s.ty, s.a)
            for i in 0..s.c {
                let f = payload_addr(inout e, p, s.ty, d, s.a, i)
                put_op(inout e, p, ms[i as usize], p.ir.extra[(s.b + i) as usize], f)
            }
        }
    } else if k == ir.S_ARRAY {
        let d = dst_addr(s.dst)
        let et = types.get(p.t, s.ty).a
        for i in 0..s.c {
            let mut t = lit("getelementptr inbounds ")
            bytes.append(inout t, mty(inout e, p, s.ty))
            bytes.append(inout t, lit(", ptr "))
            bytes.append(inout t, d)
            bytes.append(inout t, lit(", i32 0, i32 0, i64 "))
            bytes.append(inout t, bytes.from_u64(i as u64))
            let f = val(inout e, t)
            put_op(inout e, p, et, p.ir.extra[(s.b + i) as usize], f)
        }
    } else if k == ir.S_REPEAT {
        if s.b > 0 { repeat(inout e, p, s) }
    } else if k == ir.S_TAG {
        let a = paddr(inout e, p, s.a)
        let tag = load_tag(inout e, p, p.ir.places[s.a as usize].ty, a)
        let r = val(inout e, catb(lit("icmp eq i32 "), catb(tag, num(", ", s.b as u64))))
        store(inout e, p, types.BOOL, r, dst_addr(s.dst))
    } else if k == ir.S_PRINT {
        print(inout e, p, s)
    } else if k == ir.S_NOWMS {
        let r = rt_call(inout e, p, "ei_now_ms", List.new(), List.new(), types.U64)
        store(inout e, p, types.U64, r, dst_addr(s.dst))
    } else if k == ir.S_PANIC {
        let m = opv(inout e, p, s.a)
        trap_with(inout e, m, s.line)
    } else if k == ir.S_ASSERT {
        let c = opv(inout e, p, s.a)
        let ok = new_label(inout e)
        let bad = new_label(inout e)
        condbr(inout e, c, ok, bad)
        label(inout e, bad)
        let mut m = msg(inout e, "assertion failed")
        if s.b > 0 {
            e.sused[(s.b - 1) as usize] = true
            m = num("@.s", (s.b - 1) as u64)
        }
        trap_with(inout e, m, s.line)
        label(inout e, ok)
    } else if k == ir.S_BUILTIN {
        builtin(inout e, p, s)
    } else if k == ir.S_CLOSURE {
        closure(inout e, p, s)
    } else if k == ir.S_FNREF {
        let d = dst_addr(s.dst)
        zero(inout e, p, s.ty, d)
        let f = field_addr(inout e, p, s.ty, d, 1)
        gneed(inout e, lower.GK_THUNK, s.a)
        let tk = catb(lit("k_"), e.fnn[s.a as usize])
        // the thunk is glue (g_thunk); its address is all that is needed
        declare_thunk(inout e, p, s.a, tk)
        let mut t = lit("store ptr @")
        bytes.append(inout t, tk)
        bytes.append(inout t, lit(", ptr "))
        bytes.append(inout t, f)
        stmt_text(inout e, t)
    } else if k == ir.S_CALLV {
        e.unchecked = true
        callv(inout e, p, s)
        e.unchecked = false
    } else if k == ir.S_BREAK {
        let t = e.brks[e.brks.len() - 1 - s.a as usize].copy()
        br(inout e, t)
    } else if k == ir.S_CONTINUE {
        let t = e.loops[e.loops.len() - 1 - s.a as usize].copy()
        br(inout e, t)
    } else if k == ir.S_RETURN {
        ret(inout e, p, s)
    } else {
        unsupported(inout e, "an IR statement kind")
    }
}

fn mutates(b: u32) -> bool {
    b == ir.B_SHOW || b == ir.B_STR_PAD || b == ir.B_FMT_INT || b == ir.B_STR_PUSH || b == ir.B_STR_APPEND || b == ir.B_STR_PUSH_BYTE || b == ir.B_LIST_PUSH || b == ir.B_LIST_POP || b == ir.B_LIST_CLEAR || b == ir.B_MAP_INSERT || b == ir.B_MAP_REMOVE
}

/// `[x; n]`: a loop storing x into every element.
fn repeat(inout e: E, p: lower.P, s: ir.Stmt) {
    let d = dst_addr(s.dst)
    let et = types.get(p.t, s.ty).a
    live(inout e)
    let pre = e.cur.copy()
    let lh = new_label(inout e)
    let lx = new_label(inout e)
    br(inout e, lh)
    label(inout e, lh)
    let i = reg(inout e)
    let nx = reg(inout e)
    let mut ph = lit("phi i64 [ 0, ")
    bytes.append(inout ph, pre)
    bytes.append(inout ph, lit(" ], [ "))
    bytes.append(inout ph, nx)
    bytes.append(inout ph, lit(", "))
    bytes.append(inout ph, num("%L", lh as u64))
    bytes.append(inout ph, lit(" ]"))
    ins(inout e)
    wb(inout e, i)
    w(inout e, " = ")
    wb(inout e, ph)
    fin(inout e)
    let mut t = lit("getelementptr inbounds ")
    bytes.append(inout t, mty(inout e, p, s.ty))
    bytes.append(inout t, lit(", ptr "))
    bytes.append(inout t, d)
    bytes.append(inout t, lit(", i32 0, i32 0, i64 "))
    bytes.append(inout t, i)
    let f = val(inout e, t)
    put_op(inout e, p, et, s.a, f)
    ins(inout e)
    wb(inout e, nx)
    w(inout e, " = add nuw nsw i64 ")
    wb(inout e, i)
    w(inout e, ", 1")
    fin(inout e)
    let c = val(inout e, catb(lit("icmp ult i64 "), catb(nx, num(", ", s.b as u64))))
    condbr(inout e, c, lh, lx)
    label(inout e, lx)
}

fn unary(inout e: E, p: lower.P, s: ir.Stmt) {
    let v = opv(inout e, p, s.b)
    let d = dst_addr(s.dst)
    if s.a == ir.U_NOT {
        let r = val(inout e, catb(lit("xor i1 "), cat(v, ", true")))
        store(inout e, p, types.BOOL, r, d)
        return
    }
    let ik = types.ik(p.t, s.ty)
    let it = lit(int_ty(ik))
    if s.a == ir.U_BNOT {
        let r = val(inout e, catb(lit("xor "), catb(it, catb(lit(" "), cat(v, ", -1")))))
        store(inout e, p, s.ty, r, d)
        return
    }
    let mn = int_text(ik, lower.kmin(ik))
    let c = icmp(inout e, "eq", it, v, mn)
    trap_if(inout e, c, "integer overflow in negation", s.line)
    // v is not the minimum (checked): `nsw`
    let r = val(inout e, catb(lit("sub nsw "), catb(it, catb(lit(" 0, "), v))))
    store(inout e, p, s.ty, r, d)
}

fn arith2(inout e: E, op: str, it: List[u8], a: List[u8], b: List[u8]) -> List[u8] {
    let r = begin(inout e)
    w(inout e, op)
    w(inout e, " ")
    wb(inout e, it)
    w(inout e, " ")
    wb(inout e, a)
    w(inout e, ", ")
    wb(inout e, b)
    fin(inout e)
    r
}

fn checked(inout e: E, intr: str, it: List[u8], a: List[u8], b: List[u8], text: str, line: u32) -> List[u8] {
    let mut name = lit("llvm.")
    bytes.append(inout name, lit(intr))
    bytes.append(inout name, lit(".with.overflow."))
    bytes.append(inout name, it)
    let mut d = lit(r"declare { ")
    bytes.append(inout d, it)
    bytes.append(inout d, lit(r", i1 } @"))
    bytes.append(inout d, name)
    bytes.append(inout d, lit("("))
    bytes.append(inout d, it)
    bytes.append(inout d, lit(", "))
    bytes.append(inout d, it)
    bytes.append(inout d, lit(")"))
    declare(inout e, name, d)
    let mut t = lit(r"call { ")
    bytes.append(inout t, it)
    bytes.append(inout t, lit(r", i1 } @"))
    bytes.append(inout t, name)
    bytes.append(inout t, lit("("))
    bytes.append(inout t, it)
    bytes.append(inout t, lit(" "))
    bytes.append(inout t, a)
    bytes.append(inout t, lit(", "))
    bytes.append(inout t, it)
    bytes.append(inout t, lit(" "))
    bytes.append(inout t, b)
    bytes.append(inout t, lit(")"))
    let r = val(inout e, t)
    let mut x = lit(r"extractvalue { ")
    bytes.append(inout x, it)
    bytes.append(inout x, lit(r", i1 } "))
    bytes.append(inout x, r)
    let ov = val(inout e, cat(x, ", 1"))
    trap_if(inout e, ov, text, line)
    // past the check the operation doesn't overflow: the same operation with its flag
    // (`nsw` signed, `nuw` unsigned), which tells the optimizer so (loops, ranges)
    let ip = lit(intr)
    let op = if ip[1] == 97 { "add" } else if ip[1] == 115 { "sub" } else { "mul" }
    let fl = if ip[0] == 115 { " nsw " } else { " nuw " }
    let mut t2 = lit(op)
    bytes.append(inout t2, lit(fl))
    bytes.append(inout t2, it)
    bytes.append(inout t2, lit(" "))
    bytes.append(inout t2, a)
    bytes.append(inout t2, lit(", "))
    bytes.append(inout t2, b)
    val(inout e, t2)
}

fn binary(inout e: E, p: lower.P, s: ir.Stmt) {
    let o = s.a
    let d = dst_addr(s.dst)
    let tk = kind(p, s.ty)
    if o == ast.OP_EQ || o == ast.OP_NE {
        let a = oparg(inout e, p, s.b)
        let b = oparg(inout e, p, s.c)
        let mut r = eq_val(inout e, p, s.ty, a, b)
        if o == ast.OP_NE { r = val(inout e, catb(lit("xor i1 "), cat(r, ", true"))) }
        store(inout e, p, types.BOOL, r, d)
        return
    }
    if o >= ast.OP_LT && o <= ast.OP_GE {
        let a = oparg(inout e, p, s.b)
        let b = oparg(inout e, p, s.c)
        let sg = tk == types.T_INT && types.signed(types.ik(p.t, s.ty))
        let mut r: List[u8] = List.new()
        if tk == types.T_INT || tk == types.T_BOOL {
            let cc = if o == ast.OP_LT { if sg { "slt" } else { "ult" } } else if o == ast.OP_LE { if sg { "sle" } else { "ule" } } else if o == ast.OP_GT { if sg { "sgt" } else { "ugt" } } else { if sg { "sge" } else { "uge" } }
            let vt = vty(inout e, p, s.ty)
            r = icmp(inout e, cc, vt, a, b)
        } else {
            let c = cmp_val(inout e, p, s.ty, a, b)
            let cc = if o == ast.OP_LT { "slt" } else if o == ast.OP_LE { "sle" } else if o == ast.OP_GT { "sgt" } else { "sge" }
            r = icmp(inout e, cc, lit("i32"), c, lit("0"))
        }
        store(inout e, p, types.BOOL, r, d)
        return
    }
    if tk != types.T_INT {
        unsupported(inout e, "an operator on a non-integer")
        return
    }
    let ik = types.ik(p.t, s.ty)
    let it = lit(int_ty(ik))
    let sg = types.signed(ik)
    let a = opv(inout e, p, s.b)
    let b = opv(inout e, p, s.c)
    let mut r: List[u8] = List.new()
    if o == ast.OP_ADD {
        r = checked(inout e, pick(sg, "sadd", "uadd"), it, a, b, "integer overflow in +", s.line)
    } else if o == ast.OP_SUB {
        r = checked(inout e, pick(sg, "ssub", "usub"), it, a, b, "integer overflow in -", s.line)
    } else if o == ast.OP_MUL {
        r = checked(inout e, pick(sg, "smul", "umul"), it, a, b, "integer overflow in *", s.line)
    } else if o == ast.OP_DIV || o == ast.OP_REM {
        let z = icmp(inout e, "eq", it, b, lit("0"))
        trap_if(inout e, z, pick(o == ast.OP_DIV, "division by zero", "remainder by zero"), s.line)
        if sg {
            let c1 = icmp(inout e, "eq", it, a, int_text(ik, lower.kmin(ik)))
            let c2 = icmp(inout e, "eq", it, b, lit("-1"))
            let c = val(inout e, catb(lit("and i1 "), catb(c1, catb(lit(", "), c2))))
            trap_if(inout e, c, pick(o == ast.OP_DIV, "integer overflow in /", "integer overflow in %"), s.line)
        }
        let op = if o == ast.OP_DIV { if sg { "sdiv" } else { "udiv" } } else { if sg { "srem" } else { "urem" } }
        r = arith2(inout e, op, it, a, b)
    } else if o == ast.OP_WADD {
        r = arith2(inout e, "add", it, a, b)
    } else if o == ast.OP_WSUB {
        r = arith2(inout e, "sub", it, a, b)
    } else if o == ast.OP_WMUL {
        r = arith2(inout e, "mul", it, a, b)
    } else if o == ast.OP_BAND {
        r = arith2(inout e, "and", it, a, b)
    } else if o == ast.OP_BOR {
        r = arith2(inout e, "or", it, a, b)
    } else if o == ast.OP_BXOR {
        r = arith2(inout e, "xor", it, a, b)
    } else if o == ast.OP_SHL || o == ast.OP_SHR {
        // a negative count is a huge unsigned one: one unsigned compare checks both ends
        let c = icmp(inout e, "uge", it, b, bytes.from_u64(int_bits(ik) as u64))
        trap_if(inout e, c, "shift count out of range", s.line)
        let op = if o == ast.OP_SHL { "shl" } else if sg { "ashr" } else { "lshr" }
        r = arith2(inout e, op, it, a, b)
    } else {
        unsupported(inout e, "an operator")
        return
    }
    store(inout e, p, s.ty, r, d)
}

/// `x as target` (lower.ei's cast through ei_s2s/s2u/u2s/u2u).
fn cast(inout e: E, p: lower.P, s: ir.Stmt) {
    let fty = ir.op_ty(p.ir, s.a)
    let from = types.ik(p.t, fty)
    let to = types.ik(p.t, s.ty)
    let v = opv(inout e, p, s.a)
    let mut w64 = v.copy()
    if int_bits(from) < 64 {
        let op = if types.signed(from) { "sext " } else { "zext " }
        w64 = val(inout e, catb(lit(op), catb(lit(int_ty(from)), catb(lit(" "), cat(v, " to i64")))))
    }
    let hi = bytes.from_u64(lower.kmax(to))
    let i64t = lit("i64")
    if types.signed(from) && types.signed(to) {
        let lo = int_text(types.IK_I64, lower.kmin(to))
        let c1 = icmp(inout e, "slt", i64t, w64, lo)
        let c2 = icmp(inout e, "sgt", i64t, w64, hi)
        let c = val(inout e, catb(lit("or i1 "), catb(c1, catb(lit(", "), c2))))
        trap_if(inout e, c, "integer conversion out of range", s.line)
    } else if types.signed(from) {
        let c1 = icmp(inout e, "slt", i64t, w64, lit("0"))
        let c2 = icmp(inout e, "ugt", i64t, w64, int_text(types.IK_U64, lower.kmax(to)))
        let c = val(inout e, catb(lit("or i1 "), catb(c1, catb(lit(", "), c2))))
        trap_if(inout e, c, "integer conversion out of range", s.line)
    } else {
        let lim = if types.signed(to) { hi.copy() } else { int_text(types.IK_U64, lower.kmax(to)) }
        let c = icmp(inout e, "ugt", i64t, w64, lim)
        trap_if(inout e, c, "integer conversion out of range", s.line)
    }
    let mut r = w64.copy()
    if int_bits(to) < 64 { r = val(inout e, catb(lit("trunc i64 "), catb(w64, catb(lit(" to "), lit(int_ty(to)))))) }
    store(inout e, p, s.ty, r, dst_addr(s.dst))
}

fn print(inout e: E, p: lower.P, s: ir.Stmt) {
    let t = types.get(p.t, s.ty)
    let none: List[u8] = List.new()
    if !lower.plain_show(p, s.ty) {
        let o = temp(inout e, p, types.STRING)
        let em = msg(inout e, "")
        call(inout e, p, lit("ei_str_from"), tys1(types.STR), args1(em), types.STRING, o)
        let v = oparg(inout e, p, s.a)
        show_into(inout e, p, s.ty, o, v)
        let q = load_ptr_field(inout e, p, types.STRING, o, 0)
        rt_call(inout e, p, "ei_print_s", tys1(types.STR), args1(q), types.UNIT)
        call(inout e, p, lit("ei_drop_String"), tys1(PTR + types.STRING), args1(o), types.UNIT, none)
        return
    }
    if t.kind == types.T_INT {
        let v = opv(inout e, p, s.a)
        let mut x = v.copy()
        if int_bits(t.a) < 64 {
            let op = if types.signed(t.a) { "sext " } else { "zext " }
            x = val(inout e, catb(lit(op), catb(lit(int_ty(t.a)), catb(lit(" "), cat(v, " to i64")))))
        }
        if types.signed(t.a) {
            rt_call(inout e, p, "ei_print_i", tys1(types.I64), args1(x), types.UNIT)
        } else {
            rt_call(inout e, p, "ei_print_u", tys1(types.U64), args1(x), types.UNIT)
        }
    } else if t.kind == types.T_BOOL {
        let v = opv(inout e, p, s.a)
        rt_call(inout e, p, "ei_print_b", tys1(types.BOOL), args1(v), types.UNIT)
    } else if t.kind == types.T_STR {
        let v = opv(inout e, p, s.a)
        rt_call(inout e, p, "ei_print_s", tys1(types.STR), args1(v), types.UNIT)
    } else if t.kind == types.T_STRING {
        let a = opa(inout e, p, s.a)
        let q = load_ptr_field(inout e, p, s.ty, a, 0)
        rt_call(inout e, p, "ei_print_s", tys1(types.STR), args1(q), types.UNIT)
    } else {
        let a = opa(inout e, p, s.a)
        gneed(inout e, lower.GK_NAME, s.ty)
        let tag = load_tag(inout e, p, s.ty, a)
        let gn_ = gname(e, "name_", s.ty)
        let nm = rt_call_b(inout e, p, gn_, tys1(types.U32), args1(tag), types.STR)
        rt_call(inout e, p, "ei_print_s", tys1(types.STR), args1(nm), types.UNIT)
    }
}

/// The parameter types of function f in its C convention (inout: a pointer; a
/// closure body: the environment pointer first).
fn fn_ptys(e: E, p: lower.P, f: u32) -> List[u32] {
    let fd = p.ir.fns[f as usize]
    let mut out: List[u32] = List.new()
    if e.clo[f as usize] { out.push(types.STR) }
    let nc = e.ncap[f as usize]
    for i in 0..fd.nparams {
        let l = p.ir.locals[(fd.lstart + nc + i) as usize]
        if l.kind == ir.L_INOUT { out.push(PTR + l.ty) } else { out.push(l.ty) }
    }
    out
}

/// An argument passed by reference between Eider functions (the internal convention): a
/// pointer to the caller's value, which the callee never writes (`noalias readonly`).
const A_REF: u32 = 5

/// The internal convention of function f (calls from Eider to Eider, `@<name>.i`): the C
/// convention's classification of each parameter, except that an aggregate the C ABI passes
/// in memory (byval: a copy on the stack) is passed by reference (A_REF), and registers are
/// not counted (an aggregate of up to 16 bytes is always two integers). The result is
/// returned as in C. Memoized per function.
fn isig(inout e: E, p: lower.P, f: u32) -> abi.Sig {
    if e.isok[f as usize] { return e.isigs[f as usize].copy() }
    let fd = p.ir.fns[f as usize]
    let ptys = fn_ptys(e, p, f)
    let r = abi.arg_of(inout e.lay, p, fd.ret, true)
    let mut args: List[abi.Arg] = List.new()
    for t in ptys {
        let a = abi.arg_of(inout e.lay, p, t, false)
        if a.kind == abi.A_BYVAL { args.push(abi.Arg(A_REF, t, 0, 0, 0, 0, 0)) } else { args.push(a) }
    }
    let s = abi.Sig(r, args)
    e.isigs[f as usize] = s.copy()
    e.isok[f as usize] = true
    s
}

/// The C convention of function f (its exported symbol `@<name>`), memoized.
fn csig(inout e: E, p: lower.P, f: u32) -> abi.Sig {
    if e.csok[f as usize] { return e.csigs[f as usize].copy() }
    let ptys = fn_ptys(e, p, f)
    let s = abi.sig(inout e.lay, p, ptys, p.ir.fns[f as usize].ret)
    e.csigs[f as usize] = s.copy()
    e.csok[f as usize] = true
    s
}

/// Whether function f is called through the internal convention: every function with a
/// body except closure bodies (only ever called through a fn value, with the C convention).
fn internal_fn(e: E, p: lower.P, f: u32) -> bool { p.ir.fns[f as usize].body > 0 && !e.clo[f as usize] }

fn iname(e: E, f: u32) -> List[u8] { cat(e.fnn[f as usize], ".i") }

/// Whether local l of the current function is the root of a place among s's arguments.
fn arg_root_is(p: lower.P, s: ir.Stmt, l: u32) -> bool {
    for i in 0..s.c {
        let a = p.ir.extra[(s.b + i) as usize]
        if a >= ir.ARG_PLACE && place_root(p, a - ir.ARG_PLACE) == l { return true }
    }
    false
}

fn place_root(p: lower.P, id: u32) -> u32 {
    let x = p.ir.places[id as usize]
    if x.kind == ir.P_LOCAL { return x.a }
    place_root(p, x.a)
}

/// A call of function f with the internal convention (s: an S_CALL, or None-like for a call
/// without arguments when `s.c` is 0); the result goes to `dst` (an address; a fresh
/// temporary when empty and the result is an aggregate), a scalar result is returned.
///
/// `noalias` holds by construction: an A_REF argument is the address of a local temporary
/// (operands are locals) that no other argument of the call can reach, except when that
/// local is also the root of an `inout` place among the arguments or is the destination, and
/// then it is first copied to a temporary of its own; the same goes for the destination (the
/// callee's `noalias sret`). `inout` places are exclusive (E0301, C8.6) and made unique
/// (copy-on-write) before the call.
fn call_internal(inout e: E, p: lower.P, f: u32, s: ir.Stmt, dst: List[u8], dstl: u32) -> List[u8] {
    let sg = isig(inout e, p, f)
    e.iused[f as usize] = true
    let mut args: List[List[u8]] = List.new()
    for i in 0..s.c {
        let a = p.ir.extra[(s.b + i) as usize]
        if a >= ir.ARG_PLACE {
            args.push(paddr(inout e, p, a - ir.ARG_PLACE))
            continue
        }
        let x = p.ir.ops[a as usize]
        let mut v = oparg(inout e, p, a)
        if sg.args[i as usize].kind == A_REF && x.kind == ir.O_LOCAL && (x.a == dstl || arg_root_is(p, s, x.a)) {
            let ty = ir.op_ty(p.ir, a)
            let t = temp(inout e, p, ty)
            memcpy(inout e, p, ty, t, v)
            v = t
        }
        args.push(v)
    }
    let mut d = dst.copy()
    let mut via: List[u8] = List.new()
    if sg.ret.kind == abi.A_SRET && dstl != NONE && arg_root_is(p, s, dstl) {
        via = d.copy()
        d = temp(inout e, p, sg.ret.ty)
    }
    let callee = catb(lit("@"), iname(e, f))
    let r = call_sig(inout e, p, callee, sg, args, d)
    if via.len() > 0 { memcpy(inout e, p, sg.ret.ty, via, d) }
    r
}

fn extern_of(p: lower.P, f: u32) -> u32 {
    for i in 0..p.ir.externs.len() {
        if p.ir.externs[i].f == f { return i as u32 }
    }
    NONE
}

fn call_fn(inout e: E, p: lower.P, s: ir.Stmt) {
    let fd = p.ir.fns[s.a as usize]
    if internal_fn(e, p, s.a) {
        let mut d: List[u8] = List.new()
        if s.dst != NONE { d = dst_addr(s.dst) }
        let r = call_internal(inout e, p, s.a, s, d, s.dst)
        if s.dst != NONE && is_scalar(p, fd.ret) && !is_void(fd.ret) { store(inout e, p, fd.ret, r, d) }
        return
    }
    let mut name = e.fnn[s.a as usize].copy()
    let mut ptys: List[u32] = List.new()
    let x = extern_of(p, s.a)
    if x != NONE {
        name = p.ir.externs[x as usize].symbol.copy()
        ptys = p.ir.externs[x as usize].params.copy()
    } else {
        ptys = fn_ptys(e, p, s.a)
    }
    let mut args: List[List[u8]] = List.new()
    for i in 0..s.c {
        let a = p.ir.extra[(s.b + i) as usize]
        if a >= ir.ARG_PLACE { args.push(paddr(inout e, p, a - ir.ARG_PLACE)) } else { args.push(oparg(inout e, p, a)) }
    }
    let mut d: List[u8] = List.new()
    if s.dst != NONE { d = dst_addr(s.dst) }
    let r = call(inout e, p, name, ptys, args, fd.ret, d)
    if s.dst != NONE && is_scalar(p, fd.ret) && !is_void(fd.ret) { store(inout e, p, fd.ret, r, d) }
}

/// The C ABI of a fn value's `call`: (void *env, params...) -> ret.
fn fnval_sig(inout e: E, p: lower.P, fty: u32) -> abi.Sig {
    let mut ptys: List[u32] = List.new()
    ptys.push(types.STR)
    for x in types.elems(p.t, fty) {
        if kind(p, x) == types.T_INOUT { ptys.push(PTR + types.get(p.t, x).a) } else { ptys.push(x) }
    }
    abi.sig(inout e.lay, p, ptys, types.get(p.t, fty).b)
}

fn callv(inout e: E, p: lower.P, s: ir.Stmt) {
    let fty = ir.op_ty(p.ir, s.a)
    let fv = opa(inout e, p, s.a)
    let sg = fnval_sig(inout e, p, fty)
    let env = load_ptr_field(inout e, p, fty, fv, 0)
    let fp = load_ptr_field(inout e, p, fty, fv, 1)
    let mut args: List[List[u8]] = List.new()
    args.push(env)
    for i in 0..s.c {
        let a = p.ir.extra[(s.b + i) as usize]
        if a >= ir.ARG_PLACE { args.push(paddr(inout e, p, a - ir.ARG_PLACE)) } else { args.push(oparg(inout e, p, a)) }
    }
    let rt = types.get(p.t, fty).b
    let mut d: List[u8] = List.new()
    if s.dst != NONE { d = dst_addr(s.dst) }
    let r = call_sig(inout e, p, fp, sg, args, d)
    if s.dst != NONE && is_scalar(p, rt) && !is_void(rt) { store(inout e, p, rt, r, d) }
}

fn declare_thunk(inout e: E, p: lower.P, f: u32, name: List[u8]) {
    let fd = p.ir.fns[f as usize]
    let mut ptys: List[u32] = List.new()
    ptys.push(types.STR)
    for i in 0..fd.nparams { ptys.push(p.ir.locals[(fd.lstart + i) as usize].ty) }
    let sg = abi.sig(inout e.lay, p, ptys, fd.ret)
    declare_sig(inout e, p, name, sg, false)
}

/// S_CLOSURE: a new environment holding the captures, and the fn value pointing at the body
/// and the environment's glue (lower.ei's `closure`).
fn closure(inout e: E, p: lower.P, s: ir.Stmt) {
    let d = dst_addr(s.dst)
    zero(inout e, p, s.ty, d)
    let fname = e.fnn[s.a as usize].copy()
    let fd = p.ir.fns[s.a as usize]
    // the body's own address (its prototype is declared with its signature)
    let bp = fn_ptys(e, p, s.a)
    let bs = abi.sig(inout e.lay, p, bp, fd.ret)
    declare_sig(inout e, p, fname, bs, false)
    let f1 = field_addr(inout e, p, s.ty, d, 1)
    stmt_text(inout e, catb(lit("store ptr @"), catb(fname, catb(lit(", ptr "), f1))))
    if s.c == 0 { return }
    gneed(inout e, lower.GK_ENV, s.a)
    let mut cts: List[u32] = List.new()
    for i in 0..s.c { cts.push(p.ir.locals[(fd.lstart + i) as usize].ty) }
    let sz = abi.struct_of(inout e.lay, p, cts)
    let envp = rt_call(inout e, p, "ei_alloc", tys1(types.U64), args1(bytes.from_u64(sz[0])), types.STR)
    let est = members(inout e, p, cts)
    for i in 0..s.c {
        let f = gep(inout e, p, est, envp, i)
        put_op(inout e, p, cts[i as usize], p.ir.extra[(s.b + i) as usize], f)
    }
    let f0 = field_addr(inout e, p, s.ty, d, 0)
    stmt_text(inout e, catb(lit("store ptr "), catb(envp, catb(lit(", ptr "), f0))))
    let glue = ["edrop_", "eclone_", "eown_"]
    for j in 0..3 {
        let gn = catb(lit(glue[j as usize]), fname)
        let rty = if j == 1 { types.STR } else { types.UNIT }
        let gs = abi.sig(inout e.lay, p, tys1(types.STR), rty)
        declare_sig(inout e, p, gn, gs, false)
        let fj = field_addr(inout e, p, s.ty, d, (j + 2) as u32)
        stmt_text(inout e, catb(lit("store ptr @"), catb(gn, catb(lit(", ptr "), fj))))
    }
}

fn ret(inout e: E, p: lower.P, s: ir.Stmt) {
    let r = e.rsig.copy()
    prof_leave(inout e)
    if s.a == 0 || r.kind == abi.A_VOID {
        stmt_text(inout e, lit("ret void"))
        e.term = true
        return
    }
    let o = s.a - 1
    if r.kind == abi.A_DIRECT {
        let v = opv(inout e, p, o)
        let mut t = lit("ret ")
        bytes.append(inout t, vty(inout e, p, r.ty))
        bytes.append(inout t, lit(" "))
        bytes.append(inout t, v)
        stmt_text(inout e, t)
    } else if r.kind == abi.A_SRET {
        let a = opa(inout e, p, o)
        memcpy(inout e, p, r.ty, lit("%sret"), a)
        stmt_text(inout e, lit("ret void"))
    } else {
        let a = opa(inout e, p, o)
        ret_pieces(inout e, r, a)
    }
    e.term = true
}

/// Return the aggregate at address a in the registers of its coerced result r.
fn ret_pieces(inout e: E, r: abi.Arg, a: List[u8]) {
    let v0 = load_piece(inout e, a, 0, r.b0)
    if r.n == 1 {
        stmt_text(inout e, catb(num("ret i", r.b0 as u64), catb(lit(" "), v0)))
    } else {
        let mut v1 = load_piece(inout e, a, 8, r.b1)
        let ct = coerce_ty(r)
        if r.c0 == abi.C_PAIR && r.b1 < 64 { v1 = val(inout e, catb(num("zext i", r.b1 as u64), catb(lit(" "), cat(v1, " to i64")))) }
        let x = val(inout e, catb(lit("insertvalue "), catb(ct, catb(lit(" poison, i"), catb(bytes.from_u64(r.b0 as u64), catb(lit(" "), cat(v0, ", 0")))))))
        let w1: u32 = if r.c0 == abi.C_PAIR { 64 } else { r.b1 }
        let y = val(inout e, catb(lit("insertvalue "), catb(ct, catb(lit(" "), catb(x, catb(lit(", i"), catb(bytes.from_u64(w1 as u64), catb(lit(" "), cat(v1, ", 1")))))))))
        stmt_text(inout e, catb(lit("ret "), catb(ct, catb(lit(" "), y))))
    }
    e.term = true
}

// ---- builtins

/// An Option value at d: None, or Some with the value at address v (of type vt).
fn option_none(inout e: E, p: lower.P, oty: u32, d: List[u8]) {
    zero(inout e, p, oty, d)
    store_tag(inout e, p, oty, d, lower.none_idx(p, oty))
}

fn option_some_from(inout e: E, p: lower.P, oty: u32, d: List[u8], src: List[u8]) {
    zero(inout e, p, oty, d)
    let si = lower.some_idx(p, oty)
    store_tag(inout e, p, oty, d, si)
    let vt = abi.parts(p, oty, si)[0]
    let f = payload_addr(inout e, p, oty, d, si, 0)
    copy_mem(inout e, p, vt, f, src)
}

/// Store a builtin's scalar result r (when the statement has a destination).
fn bset(inout e: E, p: lower.P, s: ir.Stmt, r: List[u8]) {
    if s.dst != NONE && !is_void(s.ty) { store(inout e, p, s.ty, r, dst_addr(s.dst)) }
}

/// The destination address for an aggregate builtin result (a temporary when discarded).
fn bdst(inout e: E, p: lower.P, s: ir.Stmt) -> List[u8] {
    if s.dst != NONE { return dst_addr(s.dst) }
    temp(inout e, p, s.ty)
}

fn len_field(p: lower.P, ty: u32) -> u32 {
    if kind(p, ty) == types.T_MAP { return 3 }
    1
}

fn builtin(inout e: E, p: lower.P, s: ir.Stmt) {
    let b = s.a
    let none: List[u8] = List.new()
    if b == ir.B_STR_FROM || b == ir.B_STR_FROM_INT {
        let v = argval(inout e, p, barg(p, s, 0))
        let d = bdst(inout e, p, s)
        if b == ir.B_STR_FROM {
            call(inout e, p, lit("ei_str_from"), tys1(types.STR), args1(v), types.STRING, d)
        } else {
            call(inout e, p, lit("ei_str_from_i64"), tys1(types.I64), args1(v), types.STRING, d)
        }
        return
    }
    if (b == ir.B_LEN || b == ir.B_IS_EMPTY) && kind(p, arg_ty(p, barg(p, s, 0))) == types.T_STR {
        let v = argval(inout e, p, barg(p, s, 0))
        if b == ir.B_LEN {
            let r = strlen64(inout e, p, v)
            bset(inout e, p, s, r)
        } else {
            let c = val(inout e, catb(lit("load i8, ptr "), v))
            let r = val(inout e, catb(lit("icmp eq i8 "), cat(c, ", 0")))
            bset(inout e, p, s, r)
        }
        return
    }
    if b == ir.B_LEN || b == ir.B_IS_EMPTY {
        let a = barg(p, s, 0)
        let ty = arg_ty(p, a)
        let ad = argptr(inout e, p, a)
        let n = load_i64_field(inout e, p, ty, ad, len_field(p, ty))
        if b == ir.B_LEN {
            bset(inout e, p, s, n)
        } else {
            let r = val(inout e, catb(lit("icmp eq i64 "), cat(n, ", 0")))
            bset(inout e, p, s, r)
        }
        return
    }
    if b == ir.B_DEFAULT {
        let bd_ = bdst(inout e, p, s)
        default_to(inout e, p, s.ty, bd_)
        return
    }
    if b == ir.B_STR_PUSH {
        let o = argptr(inout e, p, barg(p, s, 0))
        let v = argval(inout e, p, barg(p, s, 1))
        call(inout e, p, lit("ei_str_push"), tys2(PTR + types.STRING, types.STR), args2(o, v), types.UNIT, none)
        return
    }
    if b == ir.B_STR_APPEND {
        let o = argptr(inout e, p, barg(p, s, 0))
        let v = argptr(inout e, p, barg(p, s, 1))
        call(inout e, p, lit("ei_str_append"), tys2(PTR + types.STRING, PTR + types.STRING), args2(o, v), types.UNIT, none)
        return
    }
    if b == ir.B_LIST_NEW || b == ir.B_MAP_NEW {
        let bd_ = bdst(inout e, p, s)
        zero(inout e, p, s.ty, bd_)
        return
    }
    if b == ir.B_BOX_NEW {
        let a = barg(p, s, 0)
        let v = argval(inout e, p, a)
        gneed(inout e, lower.GK_NEW, s.ty)
        let gn_ = gname(e, "new_", s.ty)
        let bd_ = bdst(inout e, p, s)
        call(inout e, p, gn_, tys1(arg_ty(p, a)), args1(v), s.ty, bd_)
        return
    }
    if b == ir.B_LIST_PUSH || b == ir.B_LIST_CONTAINS {
        let l = barg(p, s, 0)
        let lt = arg_ty(p, l)
        let lp = argptr(inout e, p, l)
        let x = barg(p, s, 1)
        let xv = argval(inout e, p, x)
        let et = types.get(p.t, lt).a
        if b == ir.B_LIST_PUSH {
            gneed(inout e, lower.GK_PUSH, lt)
            let gn_ = gname(e, "push_", lt)
            call(inout e, p, gn_, tys2(PTR + lt, et), args2(lp, xv), types.UNIT, none)
        } else {
            gneed(inout e, lower.GK_HAS, lt)
            let gn_ = gname(e, "has_", lt)
            let r = rt_call_b(inout e, p, gn_, tys2(PTR + lt, et), args2(lp, xv), types.BOOL)
            bset(inout e, p, s, r)
        }
        return
    }
    if b == ir.B_LIST_POP {
        let l = barg(p, s, 0)
        let lt = arg_ty(p, l)
        let lp = argptr(inout e, p, l)
        uniq_call(inout e, p, lt, lp)
        let d = bdst(inout e, p, s)
        let n = load_i64_field(inout e, p, lt, lp, 1)
        let z = val(inout e, catb(lit("icmp eq i64 "), cat(n, ", 0")))
        let ln = new_label(inout e)
        let ls = new_label(inout e)
        let lj = new_label(inout e)
        condbr(inout e, z, ln, ls)
        label(inout e, ln)
        option_none(inout e, p, s.ty, d)
        br(inout e, lj)
        label(inout e, ls)
        let m = val(inout e, catb(lit("sub i64 "), cat(n, ", 1")))
        let lf = field_addr(inout e, p, lt, lp, 1)
        stmt_text(inout e, catb(lit("store i64 "), catb(m, catb(lit(", ptr "), lf))))
        let dp = load_ptr_field(inout e, p, lt, lp, 0)
        let et = types.get(p.t, lt).a
        let mut g = lit("getelementptr inbounds ")
        bytes.append(inout g, mty(inout e, p, et))
        bytes.append(inout g, lit(", ptr "))
        bytes.append(inout g, dp)
        bytes.append(inout g, lit(", i64 "))
        bytes.append(inout g, m)
        let ep = val(inout e, g)
        option_some_from(inout e, p, s.ty, d, ep)
        label(inout e, lj)
        return
    }
    if b == ir.B_LIST_CLEAR {
        let l = barg(p, s, 0)
        let lt0 = arg_ty(p, l)
        let lp = argptr(inout e, p, l)
        gneed(inout e, lower.GK_DROP, lt0)
        let gn_ = gname(e, "drop_", lt0)
        call(inout e, p, gn_, tys1(PTR + lt0), args1(lp), types.UNIT, none)
        return
    }
    if b == ir.B_LIST_SUM {
        list_sum(inout e, p, s)
        return
    }
    if b == ir.B_MAP_GET {
        let m = barg(p, s, 0)
        let mt = arg_ty(p, m)
        let mp = argptr(inout e, p, m)
        let kv = argval(inout e, p, barg(p, s, 1))
        let kt = types.get(p.t, mt).a
        gneed(inout e, lower.GK_GET, mt)
        let gn_ = gname(e, "get_", mt)
        let q = rt_call_b(inout e, p, gn_, tys2(PTR + mt, kt), args2(mp, kv), types.STR)
        let d = bdst(inout e, p, s)
        let nul = val(inout e, catb(lit("icmp eq ptr "), cat(q, ", null")))
        let ln = new_label(inout e)
        let ls = new_label(inout e)
        let lj = new_label(inout e)
        condbr(inout e, nul, ln, ls)
        label(inout e, ln)
        option_none(inout e, p, s.ty, d)
        br(inout e, lj)
        label(inout e, ls)
        option_some_from(inout e, p, s.ty, d, q)
        label(inout e, lj)
        return
    }
    if b == ir.B_MAP_INSERT || b == ir.B_MAP_REMOVE || b == ir.B_MAP_CONTAINS {
        let m = barg(p, s, 0)
        let mt = arg_ty(p, m)
        let mp = argptr(inout e, p, m)
        let kt = types.get(p.t, mt).a
        let vt = types.get(p.t, mt).b
        let kv = argval(inout e, p, barg(p, s, 1))
        if b == ir.B_MAP_INSERT {
            let vv = argval(inout e, p, barg(p, s, 2))
            gneed(inout e, lower.GK_INS, mt)
            let gn_ = gname(e, "ins_", mt)
            call(inout e, p, gn_, tys3(PTR + mt, kt, vt), args3(mp, kv, vv), types.UNIT, none)
        } else if b == ir.B_MAP_REMOVE {
            gneed(inout e, lower.GK_REM, mt)
            let gn_ = gname(e, "rem_", mt)
            let r = rt_call_b(inout e, p, gn_, tys2(PTR + mt, kt), args2(mp, kv), types.BOOL)
            bset(inout e, p, s, r)
        } else {
            gneed(inout e, lower.GK_FIND, mt)
            let gn_ = gname(e, "find_", mt)
            let f = rt_call_b(inout e, p, gn_, tys2(PTR + mt, kt), args2(mp, kv), types.I64)
            let r = val(inout e, catb(lit("icmp sge i64 "), cat(f, ", 0")))
            bset(inout e, p, s, r)
        }
        return
    }
    if b == ir.B_STR_PUSH_BYTE {
        let o = argptr(inout e, p, barg(p, s, 0))
        let v = argval(inout e, p, barg(p, s, 1))
        rt_call3_line(inout e, p, o, v, s.line)
        return
    }
    if b == ir.B_STR_FROM_BYTES {
        let a = barg(p, s, 0)
        let lt = arg_ty(p, a)
        let lp = argptr(inout e, p, a)
        let dp = load_ptr_field(inout e, p, lt, lp, 0)
        let n = load_i64_field(inout e, p, lt, lp, 1)
        gneed(inout e, lower.GK_UTF8, s.ty)
        let gn_ = gname(e, "utf8_", s.ty)
        let bd_ = bdst(inout e, p, s)
        call(inout e, p, gn_, tys2(types.STR, types.U64), args2(dp, n), s.ty, bd_)
        return
    }
    if b == ir.B_STR_BYTES || b == ir.B_STR_BYTE || b == ir.B_STR_SLICE {
        let a = barg(p, s, 0)
        let ty = arg_ty(p, a)
        let mut sp: List[u8] = List.new()
        let mut n: List[u8] = List.new()
        if kind(p, ty) == types.T_STRING {
            let ad = argptr(inout e, p, a)
            sp = load_ptr_field(inout e, p, ty, ad, 0)
            n = load_i64_field(inout e, p, ty, ad, 1)
        } else {
            sp = argval(inout e, p, a)
            n = strlen64(inout e, p, sp)
        }
        if b == ir.B_STR_BYTES {
            gneed(inout e, lower.GK_BYTES, s.ty)
            let gn_ = gname(e, "bytes_", s.ty)
            let bd_ = bdst(inout e, p, s)
            call(inout e, p, gn_, tys2(types.STR, types.U64), args2(sp, n), s.ty, bd_)
            return
        }
        let i = argval(inout e, p, barg(p, s, 1))
        let ln = line_of(inout e, s.line)
        if b == ir.B_STR_BYTE {
            let mut ps = tys3(types.STR, types.U64, types.U64)
            ps.push(types.I32)
            let mut xs = args3(sp, n, i)
            xs.push(ln)
            let r = rt_call(inout e, p, "ei_str_byte", ps, xs, types.U8)
            bset(inout e, p, s, r)
            return
        }
        let j = argval(inout e, p, barg(p, s, 2))
        let mut ps = tys3(types.STR, types.U64, types.U64)
        ps.push(types.U64)
        ps.push(types.I32)
        let mut xs = args3(sp, n, i)
        xs.push(j)
        xs.push(ln)
        let bd_ = bdst(inout e, p, s)
        call(inout e, p, lit("ei_str_slice"), ps, xs, types.STRING, bd_)
        return
    }
    if b >= ir.B_COPY && b <= ir.B_TO_STRING {
        trait_builtin(inout e, p, s)
        return
    }
    if b == ir.B_STR_PAD || b == ir.B_FMT_INT {
        fmt_builtin(inout e, p, s)
        return
    }
    if b == ir.B_STR_IS {
        let sv = argval(inout e, p, barg(p, s, 0))
        let x = str_ptr(inout e, p, types.STRING, sv)
        let y = argval(inout e, p, barg(p, s, 1))
        let c = rt_call(inout e, p, "strcmp", tys2(types.STR, types.STR), args2(x, y), types.I32)
        let r = val(inout e, catb(lit("icmp eq i32 "), cat(c, ", 0")))
        bset(inout e, p, s, r)
        return
    }
    if b == ir.B_SPAWN || b == ir.B_MUTEX_NEW || b == ir.B_CHAN_NEW || b == ir.B_TASK_JOIN || b == ir.B_MUTEX_GET || b == ir.B_MUTEX_SET || b == ir.B_MUTEX_UPDATE || b == ir.B_CHAN_SEND {
        thread_builtin(inout e, p, s)
        return
    }
    if b >= ir.B_REF_NEW && b <= ir.B_REF_UPDATE {
        ref_builtin(inout e, p, s)
        return
    }
    if b >= ir.B_MAP_KEYS && b <= ir.B_MAP_ENTRIES {
        map_lists(inout e, p, s)
        return
    }
    if b == ir.B_CHAN_CLOSE {
        let c = argptr(inout e, p, barg(p, s, 0))
        let ct = arg_ty(p, barg(p, s, 0))
        let q = load_ptr_field(inout e, p, ct, c, 0)
        // the runtime's handle object (ei_h_*) holds the channel
        let ch = rt_call(inout e, p, "ei_h_chan", tys1(types.STR), args1(q), types.STR)
        rt_call(inout e, p, "ei_chan_close", tys1(types.STR), args1(ch), types.UNIT)
        return
    }
    if b == ir.B_CHAN_RECV {
        let a = barg(p, s, 0)
        let ct = arg_ty(p, a)
        let el = types.get(p.t, ct).a
        let cv = argval(inout e, p, a)
        let v = temp(inout e, p, el)
        gneed(inout e, lower.GK_CHRECV, ct)
        let gn_ = gname(e, "recv_", ct)
        let r = rt_call_b(inout e, p, gn_, tys2(ct, PTR + el), args2(cv, v), types.BOOL)
        let d = bdst(inout e, p, s)
        let ls = new_label(inout e)
        let ln = new_label(inout e)
        let lj = new_label(inout e)
        condbr(inout e, r, ls, ln)
        label(inout e, ls)
        option_some_from(inout e, p, s.ty, d, v)
        br(inout e, lj)
        label(inout e, ln)
        option_none(inout e, p, s.ty, d)
        label(inout e, lj)
        return
    }
    unsupported(inout e, "a builtin")
}

/// B_MAP_KEYS, B_MAP_VALUES, B_MAP_ENTRIES: a new List of copies, in slot order (lower.ei's
/// map_lists).
fn map_lists(inout e: E, p: lower.P, s: ir.Stmt) {
    let b = s.a
    let x = barg(p, s, 0)
    let mt = arg_ty(p, x)
    let kt = types.get(p.t, mt).a
    let vt = types.get(p.t, mt).b
    let el = types.get(p.t, s.ty).a
    let mp = argptr(inout e, p, x)
    let l = temp(inout e, p, s.ty)
    zero(inout e, p, s.ty, l)
    let item = temp(inout e, p, el)
    live(inout e)
    let pre = e.cur.copy()
    let lh = new_label(inout e)
    let lb = new_label(inout e)
    let lu = new_label(inout e)
    let lnx = new_label(inout e)
    let lx = new_label(inout e)
    br(inout e, lh)
    label(inout e, lh)
    let i = reg(inout e)
    let nx = reg(inout e)
    ins(inout e)
    wb(inout e, i)
    w(inout e, " = phi i64 [ 0, ")
    wb(inout e, pre)
    w(inout e, " ], [ ")
    wb(inout e, nx)
    w(inout e, ", %L")
    wn(inout e, lnx as u64)
    w(inout e, " ]")
    fin(inout e)
    let cap = load_i64_field(inout e, p, mt, mp, 4)
    let c = val(inout e, catb(lit("icmp ult i64 "), catb(i, catb(lit(", "), cap))))
    condbr(inout e, c, lb, lx)
    label(inout e, lb)
    let sp = load_ptr_field(inout e, p, mt, mp, 2)
    let sa = val(inout e, catb(lit("getelementptr inbounds i8, ptr "), catb(sp, catb(lit(", i64 "), i))))
    let sv = val(inout e, catb(lit("load i8, ptr "), sa))
    let used = val(inout e, catb(lit("icmp eq i8 "), cat(sv, ", 1")))
    condbr(inout e, used, lu, lnx)
    label(inout e, lu)
    let ka = elem_addr(inout e, p, mt, mp, 0, kt, i)
    let va = elem_addr(inout e, p, mt, mp, 1, vt, i)
    if b == ir.B_MAP_KEYS {
        clone_to(inout e, p, kt, ka, item)
    } else if b == ir.B_MAP_VALUES {
        clone_to(inout e, p, vt, va, item)
    } else {
        zero(inout e, p, el, item)
        let f0 = field_addr(inout e, p, el, item, 0)
        clone_to(inout e, p, kt, ka, f0)
        let f1 = field_addr(inout e, p, el, item, 1)
        clone_to(inout e, p, vt, va, f1)
    }
    let mut iv = item.copy()
    if is_scalar(p, el) { iv = load(inout e, p, el, item) }
    gneed(inout e, lower.GK_PUSH, s.ty)
    let gn_ = gname(e, "push_", s.ty)
    let none: List[u8] = List.new()
    call(inout e, p, gn_, tys2(PTR + s.ty, el), args2(l, iv), types.UNIT, none)
    br(inout e, lnx)
    label(inout e, lnx)
    ins(inout e)
    wb(inout e, nx)
    w(inout e, " = add nuw nsw i64 ")
    wb(inout e, i)
    w(inout e, ", 1")
    fin(inout e)
    br(inout e, lh)
    label(inout e, lx)
    if s.dst != NONE {
        memcpy(inout e, p, s.ty, dst_addr(s.dst), l)
    } else {
        drop_at(inout e, p, s.ty, l)
    }
}

/// &m.k[i] (field 0) or &m.v[i] (field 1) of the Map at mp.
fn elem_addr(inout e: E, p: lower.P, mt: u32, mp: List[u8], fi: u32, et: u32, i: List[u8]) -> List[u8] {
    let base = load_ptr_field(inout e, p, mt, mp, fi)
    let mut g = lit("getelementptr inbounds ")
    bytes.append(inout g, mty(inout e, p, et))
    bytes.append(inout g, lit(", ptr "))
    bytes.append(inout g, base)
    bytes.append(inout g, lit(", i64 "))
    bytes.append(inout g, i)
    val(inout e, g)
}

/// Ref[T] (lower.ei's ref_builtin): the access state `st` and the value `v` of the shared
/// buffer `{ int64_t st; T v; }`, with the runtime's access checks inline.
fn ref_builtin(inout e: E, p: lower.P, s: ir.Stmt) {
    let b = s.a
    if b == ir.B_REF_NEW {
        let a = barg(p, s, 0)
        let v = argval(inout e, p, a)
        gneed(inout e, lower.GK_REFNEW, s.ty)
        let gn_ = gname(e, "new_", s.ty)
        let bd_ = bdst(inout e, p, s)
        call(inout e, p, gn_, tys1(arg_ty(p, a)), args1(v), s.ty, bd_)
        return
    }
    let ra = barg(p, s, 0)
    let rt = arg_ty(p, ra)
    let el = types.get(p.t, rt).a
    let upd = b == ir.B_REF_UPDATE || b == ir.B_REF_SET
    let rp = argptr(inout e, p, ra)
    let q = load_ptr_field(inout e, p, rt, rp, 0)
    let mut ms: List[u32] = List.new()
    ms.push(types.I64)
    ms.push(el)
    let voff = abi.offset_of(inout e.lay, p, ms, 1)
    let va = val(inout e, catb(lit("getelementptr inbounds i8, ptr "), catb(q, num(", i64 ", voff))))
    let st = val(inout e, catb(lit("load i64, ptr "), q))
    if e.prof > 0 {
        let cw = if upd { icmp(inout e, "ne", lit("i64"), st, lit("0")) } else { icmp(inout e, "slt", lit("i64"), st, lit("0")) }
        let jw = if_then(inout e, cw)
        prof_ev(inout e, p, PEV_REF, lit("0"))
        if_end(inout e, jw)
    }
    if upd {
        let c1 = icmp(inout e, "slt", lit("i64"), st, lit("0"))
        trap_if(inout e, c1, "Ref updated while it is already being updated", s.line)
        let c2 = icmp(inout e, "sgt", lit("i64"), st, lit("0"))
        trap_if(inout e, c2, "Ref updated while it is being read", s.line)
        stmt_text(inout e, catb(lit("store i64 -1, ptr "), q))
    } else {
        let c = icmp(inout e, "slt", lit("i64"), st, lit("0"))
        trap_if(inout e, c, "Ref read while it is being updated", s.line)
        let n = val(inout e, catb(lit("add i64 "), cat(st, ", 1")))
        stmt_text(inout e, catb(lit("store i64 "), catb(n, catb(lit(", ptr "), q))))
    }
    let mut old: List[u8] = List.new()
    if b == ir.B_REF_GET {
        let d = bdst(inout e, p, s)
        clone_to(inout e, p, el, va, d)
    } else if b == ir.B_REF_SET {
        if owns(inout e, p, el) {
            old = temp(inout e, p, el)
            copy_mem(inout e, p, el, old, va)
        }
        let a = barg(p, s, 1)
        if a >= ir.ARG_PLACE {
            let src = paddr(inout e, p, a - ir.ARG_PLACE)
            copy_mem(inout e, p, el, va, src)
        } else if is_void(el) {
            store(inout e, p, el, lit("0"), va)
        } else {
            put_op(inout e, p, el, a, va)
        }
    } else {
        let fo = barg(p, s, 1)
        let fty = arg_ty(p, fo)
        let fv = argptr(inout e, p, fo)
        let sg = fnval_sig(inout e, p, fty)
        let env = load_ptr_field(inout e, p, fty, fv, 0)
        let fp = load_ptr_field(inout e, p, fty, fv, 1)
        let mut args: List[List[u8]] = List.new()
        args.push(env)
        if upd || !is_scalar(p, el) {
            args.push(va)
        } else if is_void(el) {
            args.push(lit("0"))
        } else {
            args.push(load(inout e, p, el, va))
        }
        let r_ty = types.get(p.t, fty).b
        let mut d: List[u8] = List.new()
        if !is_scalar(p, r_ty) { d = bdst(inout e, p, s) }
        let r = call_sig(inout e, p, fp, sg, args, d)
        if is_scalar(p, r_ty) && !is_void(r_ty) { bset(inout e, p, s, r) }
    }
    if upd {
        stmt_text(inout e, catb(lit("store i64 0, ptr "), q))
    } else {
        let st2 = val(inout e, catb(lit("load i64, ptr "), q))
        let n2 = val(inout e, catb(lit("sub i64 "), cat(st2, ", 1")))
        stmt_text(inout e, catb(lit("store i64 "), catb(n2, catb(lit(", ptr "), q))))
    }
    if old.len() > 0 { drop_at(inout e, p, el, old) }
}

fn rt_call3_line(inout e: E, p: lower.P, o: List[u8], v: List[u8], line: u32) {
    let ln = line_of(inout e, line)
    rt_call(inout e, p, "ei_str_push_byte", tys3(PTR + types.STRING, types.U8, types.I32), args3(o, v, ln), types.UNIT)
}

fn list_sum(inout e: E, p: lower.P, s: ir.Stmt) {
    let l = barg(p, s, 0)
    let lt = arg_ty(p, l)
    let lp = argptr(inout e, p, l)
    let ik = types.ik(p.t, s.ty)
    let it = lit(int_ty(ik))
    let d = dst_addr(s.dst)
    store(inout e, p, s.ty, lit("0"), d)
    live(inout e)
    let pre = e.cur.copy()
    let lh = new_label(inout e)
    let lb = new_label(inout e)
    let lx = new_label(inout e)
    br(inout e, lh)
    label(inout e, lh)
    let i = reg(inout e)
    let nx = reg(inout e)
    ins(inout e)
    wb(inout e, i)
    w(inout e, " = ")
    // the back edge comes from the block after the add's trap check (named below)
    let back = new_label(inout e)
    let mut ph2 = lit("phi i64 [ 0, ")
    bytes.append(inout ph2, pre)
    bytes.append(inout ph2, lit(" ], [ "))
    bytes.append(inout ph2, nx)
    bytes.append(inout ph2, num(", %L", back as u64))
    bytes.append(inout ph2, lit(" ]"))
    wb(inout e, ph2)
    fin(inout e)
    let n = load_i64_field(inout e, p, lt, lp, 1)
    let c = val(inout e, catb(lit("icmp ult i64 "), catb(i, catb(lit(", "), n))))
    condbr(inout e, c, lb, lx)
    label(inout e, lb)
    let dp = load_ptr_field(inout e, p, lt, lp, 0)
    let mut g = lit("getelementptr inbounds ")
    bytes.append(inout g, it)
    bytes.append(inout g, lit(", ptr "))
    bytes.append(inout g, dp)
    bytes.append(inout g, lit(", i64 "))
    bytes.append(inout g, i)
    let ep = val(inout e, g)
    let x = load(inout e, p, s.ty, ep)
    let acc = load(inout e, p, s.ty, d)
    let sg = types.signed(ik)
    let r = checked(inout e, pick(sg, "sadd", "uadd"), it, acc, x, "integer overflow in +", s.line)
    store(inout e, p, s.ty, r, d)
    br(inout e, back)
    label(inout e, back)
    ins(inout e)
    wb(inout e, nx)
    w(inout e, " = add nuw nsw i64 ")
    wb(inout e, i)
    w(inout e, ", 1")
    fin(inout e)
    br(inout e, lh)
    label(inout e, lx)
}

fn default_to(inout e: E, p: lower.P, ty: u32, d: List[u8]) {
    let k = kind(p, ty)
    let f = lower.custom_fn(p, 7, ty)
    if f != NONE {
        if is_scalar(p, ty) {
            unsupported(inout e, "a scalar custom Default")
            return
        }
        // no arguments: the statement only gives call_internal an empty argument list
        let s0 = ir.Stmt(ir.S_CALL, NONE, f, 0, 0, ty, 0)
        call_internal(inout e, p, f, s0, d, NONE)
    } else if k == types.T_INT || k == types.T_UNIT || k == types.T_BOOL || k == types.T_LIST || k == types.T_MAP {
        zero(inout e, p, ty, d)
    } else if k == types.T_STR {
        let m = msg(inout e, "")
        store(inout e, p, ty, m, d)
    } else if k == types.T_STRING {
        let m = msg(inout e, "")
        call(inout e, p, lit("ei_str_from"), tys1(types.STR), args1(m), types.STRING, d)
    } else if k == types.T_ENUM {
        option_none(inout e, p, ty, d)
    } else {
        gneed(inout e, lower.GK_DEFAULT, ty)
        let gn_ = gname(e, "default_", ty)
        call(inout e, p, gn_, List.new(), List.new(), ty, d)
    }
}

/// Interpolation's B_STR_PAD and B_FMT_INT: the runtime's ei_str_pad and ei_str_fmt_i64/u64.
fn fmt_builtin(inout e: E, p: lower.P, s: ir.Stmt) {
    let none: List[u8] = List.new()
    let sp = PTR + types.STRING
    let o = argptr(inout e, p, barg(p, s, 0))
    let x = barg(p, s, 1)
    let v = argval(inout e, p, x)
    let spec = argval(inout e, p, barg(p, s, 2))
    if s.a == ir.B_STR_PAD {
        call(inout e, p, lit("ei_str_pad"), tys3(sp, types.U64, types.U64), args3(o, v, spec), types.UNIT, none)
        return
    }
    let t = types.get(p.t, arg_ty(p, x))
    let w = if int_bits(t.a) == 64 { v.copy() } else if types.signed(t.a) { val(inout e, catb(lit("sext "), catb(lit(int_ty(t.a)), catb(lit(" "), cat(v, " to i64"))))) } else { val(inout e, catb(lit("zext "), catb(lit(int_ty(t.a)), catb(lit(" "), cat(v, " to i64"))))) }
    if types.signed(t.a) {
        call(inout e, p, lit("ei_str_fmt_i64"), tys3(sp, types.I64, types.U64), args3(o, w, spec), types.UNIT, none)
    } else {
        call(inout e, p, lit("ei_str_fmt_u64"), tys3(sp, types.U64, types.U64), args3(o, w, spec), types.UNIT, none)
    }
}

fn trait_builtin(inout e: E, p: lower.P, s: ir.Stmt) {
    let b = s.a
    if b == ir.B_SHOW {
        let o = argptr(inout e, p, barg(p, s, 0))
        let x = barg(p, s, 1)
        let v = argval(inout e, p, x)
        show_into(inout e, p, arg_ty(p, x), o, v)
        return
    }
    let x = barg(p, s, 0)
    let ty = arg_ty(p, x)
    if b == ir.B_TO_STRING {
        let v = argval(inout e, p, x)
        let d = bdst(inout e, p, s)
        let em = msg(inout e, "")
        call(inout e, p, lit("ei_str_from"), tys1(types.STR), args1(em), types.STRING, d)
        show_into(inout e, p, ty, d, v)
        if s.dst == NONE { drop_at(inout e, p, types.STRING, d) }
        return
    }
    if b == ir.B_COPY {
        let src = argptr(inout e, p, x)
        let csz = size(inout e, p, ty)
        prof_ev(inout e, p, PEV_COPY, bytes.from_u64(csz))
        let bd_ = bdst(inout e, p, s)
        copy_to(inout e, p, ty, src, bd_)
        return
    }
    if b == ir.B_HASH {
        let v = argval(inout e, p, x)
        let r = hash_val(inout e, p, ty, v)
        bset(inout e, p, s, r)
        return
    }
    // compare: Ordering's Less, Equal, Greater are tags 0, 1, 2
    let v = argval(inout e, p, x)
    let w2 = argval(inout e, p, barg(p, s, 1))
    let c = cmp_val(inout e, p, ty, v, w2)
    let k = kind(p, ty)
    let mut t = c.copy()
    if k == types.T_STR || k == types.T_STRING {
        let g = icmp(inout e, "sgt", lit("i32"), c, lit("0"))
        let l = icmp(inout e, "slt", lit("i32"), c, lit("0"))
        let g32 = val(inout e, catb(lit("zext i1 "), cat(g, " to i32")))
        let l32 = val(inout e, catb(lit("zext i1 "), cat(l, " to i32")))
        t = val(inout e, catb(lit("sub i32 "), catb(g32, catb(lit(", "), l32))))
    }
    let tag = val(inout e, catb(lit("add i32 "), cat(t, ", 1")))
    let d = bdst(inout e, p, s)
    let f = field_addr(inout e, p, s.ty, d, 0)
    stmt_text(inout e, catb(lit("store i32 "), catb(tag, catb(lit(", ptr "), f))))
}

/// Task, Mutex and Chan operations: glue (g_thread), called with every argument by value.
fn thread_builtin(inout e: E, p: lower.P, s: ir.Stmt) {
    let b = s.a
    let mut op = "new_"
    let mut gty = s.ty.copy()
    if b == ir.B_SPAWN { op = "spawn_" }
    if b == ir.B_TASK_JOIN || b == ir.B_MUTEX_GET || b == ir.B_MUTEX_SET || b == ir.B_MUTEX_UPDATE || b == ir.B_CHAN_SEND { gty = arg_ty(p, barg(p, s, 0)) }
    if b == ir.B_TASK_JOIN { op = "join_" }
    if b == ir.B_MUTEX_GET { op = "get_" }
    if b == ir.B_MUTEX_SET { op = "set_" }
    if b == ir.B_MUTEX_UPDATE { op = "upd_" }
    if b == ir.B_CHAN_SEND { op = "send_" }
    let mut ptys: List[u32] = List.new()
    let mut args: List[List[u8]] = List.new()
    for i in 0..s.c {
        let a = barg(p, s, i)
        ptys.push(arg_ty(p, a))
        args.push(argval(inout e, p, a))
    }
    let mut d: List[u8] = List.new()
    if !is_scalar(p, s.ty) { d = bdst(inout e, p, s) }
    let gk = if b == ir.B_SPAWN { lower.GK_SPAWN } else if b == ir.B_MUTEX_NEW { lower.GK_MXNEW } else if b == ir.B_CHAN_NEW { lower.GK_CHNEW } else if b == ir.B_TASK_JOIN { lower.GK_JOIN } else if b == ir.B_MUTEX_GET { lower.GK_MXGET } else if b == ir.B_MUTEX_SET { lower.GK_MXSET } else if b == ir.B_MUTEX_UPDATE { lower.GK_MXUPD } else { lower.GK_CHSEND }
    gneed(inout e, gk, gty)
    let gn_ = gname(e, op, gty)
    let r = call(inout e, p, gn_, ptys, args, s.ty, d)
    if is_scalar(p, s.ty) { bset(inout e, p, s, r) }
}

// ---- what a function does to its locals (before it is emitted)
//
// Two facts per local, from one walk over the body in evaluation order:
//
// `nz` (needs zero): some statement may read the local before every path to it has
// assigned the whole local. Only those are zeroed at entry (C's `= {0}`); any other local
// is written before it is read on every path, so its alloca starts uninitialized and is
// never read so. Definite assignment over the structured IR: a statement's operands and
// places are uses (any place rooted at the local, including a field store or a drop, which
// read or keep the rest of it); a statement with a destination, and a store to the local
// itself, assign the whole local (every such statement writes all of its bytes). After an
// `if`, what both branches assigned (a branch that left through return, break, continue or
// a panic assigns everything); a loop's blocks start from what was assigned before the loop
// and nothing they assign counts after it (both may run zero times as far as this walk
// knows). Code after a return, break, continue or panic is unreachable and reads nothing.
//
// `wr` (written): some statement may write the local or anything rooted at it (a
// destination, a store, move or drop, an `inout` or mutating builtin argument, which also
// makes the place unique first). A parameter passed by reference (A_REF) that is never
// written is used where the caller's value lies; one that is written gets its own copy.

//
// `ndef`, `placed`, `deaduse`: how many statements assign the local, whether a place is
// rooted at it, and whether unreachable code reads it. A scalar local assigned by exactly
// one statement, never a place, never read before it is assigned (not `nz`, so that one
// assignment dominates every read) and not read by unreachable code, is an SSA value: it
// has no alloca, its assignment records the value and its reads use it (`ssa_slot`).

type Scan = { da: List[bool], nz: List[bool], wr: List[bool], log: List[u32], tmp: List[bool], dead: bool, ndef: List[u32], placed: List[bool], deaduse: List[bool] }

fn sc_use(inout sc: Scan, l: u32) {
    if sc.dead { sc.deaduse[l as usize] = true }
    if !sc.dead && !sc.da[l as usize] { sc.nz[l as usize] = true }
}

fn sc_def(inout sc: Scan, l: u32) {
    sc.wr[l as usize] = true
    sc.ndef[l as usize] += 1
    if sc.dead || sc.da[l as usize] { return }
    sc.da[l as usize] = true
    sc.log.push(l)
}

/// Forget the assignments logged since `mark`; returns them.
fn sc_undo(inout sc: Scan, mark: usize) -> List[u32] {
    let mut out: List[u32] = List.new()
    while sc.log.len() > mark {
        let l = sc.log.pop().unwrap()
        sc.da[l as usize] = false
        out.push(l)
    }
    out
}

fn sc_redef(inout sc: Scan, ls: List[u32]) {
    for l in ls {
        if !sc.da[l as usize] {
            sc.da[l as usize] = true
            sc.log.push(l)
        }
    }
}

fn sc_op(p: lower.P, inout sc: Scan, o: u32) {
    let x = p.ir.ops[o as usize]
    if x.kind == ir.O_LOCAL { sc_use(inout sc, x.a) }
}

/// The local a place is rooted at (its index operands are uses).
fn sc_place(p: lower.P, inout sc: Scan, id: u32) -> u32 {
    let x = p.ir.places[id as usize]
    if x.kind == ir.P_LOCAL {
        sc_use(inout sc, x.a)
        sc.placed[x.a as usize] = true
        return x.a
    }
    if x.kind == ir.P_INDEX { sc_op(p, inout sc, x.b) }
    sc_place(p, inout sc, x.a)
}

/// The arguments [b/c] of s: operands, or places (+ARG_PLACE; written when `writes`).
fn sc_args(p: lower.P, inout sc: Scan, s: ir.Stmt, writes: bool) {
    for i in 0..s.c {
        let a = p.ir.extra[(s.b + i) as usize]
        if a >= ir.ARG_PLACE {
            let r = sc_place(p, inout sc, a - ir.ARG_PLACE)
            if writes { sc.wr[r as usize] = true }
        } else {
            sc_op(p, inout sc, a)
        }
    }
}

fn sc_block(p: lower.P, inout sc: Scan, b: u32) {
    let bl = p.ir.blocks[b as usize]
    for i in 0..bl.len { sc_stmt(p, inout sc, p.ir.extra[(bl.start + i) as usize]) }
}

fn sc_stmt(p: lower.P, inout sc: Scan, id: u32) {
    let s = p.ir.stmts[id as usize]
    let k = s.kind
    if k == ir.S_IF {
        sc_op(p, inout sc, s.a)
        let mark = sc.log.len()
        let dead0 = sc.dead.copy()
        sc_block(p, inout sc, s.b)
        let tdead = sc.dead.copy()
        let tl = sc_undo(inout sc, mark)
        sc.dead = dead0
        sc_block(p, inout sc, s.c)
        let edead = sc.dead.copy()
        let el = sc_undo(inout sc, mark)
        sc.dead = dead0
        if dead0 { return }
        if tdead && edead {
            sc.dead = true
        } else if tdead {
            sc_redef(inout sc, el)
        } else if edead {
            sc_redef(inout sc, tl)
        } else {
            for l in tl { sc.tmp[l as usize] = true }
            let mut both: List[u32] = List.new()
            for l in el {
                if sc.tmp[l as usize] { both.push(l) }
            }
            for l in tl { sc.tmp[l as usize] = false }
            sc_redef(inout sc, both)
        }
        return
    }
    if k == ir.S_LOOP {
        let mark = sc.log.len()
        let dead0 = sc.dead.copy()
        sc_block(p, inout sc, s.a)
        sc_undo(inout sc, mark)
        sc.dead = dead0
        sc_block(p, inout sc, s.b)
        sc_undo(inout sc, mark)
        sc.dead = dead0
        return
    }
    if k == ir.S_BREAK || k == ir.S_CONTINUE {
        sc.dead = true
        return
    }
    if k == ir.S_RETURN {
        if s.a > 0 { sc_op(p, inout sc, s.a - 1) }
        sc.dead = true
        return
    }
    if k == ir.S_PANIC {
        sc_op(p, inout sc, s.a)
        sc.dead = true
        return
    }
    // uses
    if k == ir.S_COPY || k == ir.S_CAST || k == ir.S_REPEAT || k == ir.S_PRINT || k == ir.S_ASSERT || k == ir.S_CLONE {
        sc_op(p, inout sc, s.a)
    } else if k == ir.S_UNARY {
        sc_op(p, inout sc, s.b)
    } else if k == ir.S_BINARY {
        sc_op(p, inout sc, s.b)
        sc_op(p, inout sc, s.c)
    } else if k == ir.S_READ || k == ir.S_TAG || k == ir.S_CHECK {
        sc_place(p, inout sc, s.a)
    } else if k == ir.S_MOVE || k == ir.S_DROP {
        let r = sc_place(p, inout sc, s.a)
        sc.wr[r as usize] = true
    } else if k == ir.S_STORE {
        sc_op(p, inout sc, s.b)
        let pl = p.ir.places[s.a as usize]
        if pl.kind == ir.P_LOCAL {
            sc_def(inout sc, pl.a)
            sc.placed[pl.a as usize] = true
        } else {
            let r = sc_place(p, inout sc, s.a)
            sc.wr[r as usize] = true
        }
    } else if k == ir.S_CALL || k == ir.S_RECORD || k == ir.S_VARIANT || k == ir.S_ARRAY || k == ir.S_TUPLE || k == ir.S_CLOSURE {
        sc_args(p, inout sc, s, k == ir.S_CALL)
    } else if k == ir.S_CALLV {
        sc_op(p, inout sc, s.a)
        sc_args(p, inout sc, s, true)
    } else if k == ir.S_BUILTIN {
        sc_args(p, inout sc, s, true)
        if mutates(s.a) && s.c > 0 {
            let a = p.ir.extra[s.b as usize]
            if a < ir.ARG_PLACE && p.ir.ops[a as usize].kind == ir.O_LOCAL { sc.wr[p.ir.ops[a as usize].a as usize] = true }
        }
    } else if k == ir.S_NOWMS || k == ir.S_FNREF || k == ir.S_NOTE {
    } else {
        // a statement this walk doesn't know: everything it might touch needs zeroing
        for i in 0..sc.nz.len() {
            sc.nz[i] = true
            sc.wr[i] = true
        }
    }
    // the destination, assigned whole
    let has_dst = k == ir.S_COPY || k == ir.S_READ || k == ir.S_UNARY || k == ir.S_BINARY || k == ir.S_CAST || k == ir.S_CALL || k == ir.S_RECORD || k == ir.S_VARIANT || k == ir.S_ARRAY || k == ir.S_REPEAT || k == ir.S_TAG || k == ir.S_NOWMS || k == ir.S_TUPLE || k == ir.S_CLONE || k == ir.S_MOVE || k == ir.S_BUILTIN || k == ir.S_CLOSURE || k == ir.S_FNREF || k == ir.S_CALLV
    if has_dst && s.dst != NONE {
        if k != ir.S_REPEAT || s.b > 0 { sc_def(inout sc, s.dst) } else { sc.wr[s.dst as usize] = true }
        // List.sum accumulates in its destination: never an SSA value
        if k == ir.S_BUILTIN && s.a == ir.B_LIST_SUM { sc.placed[s.dst as usize] = true }
    }
}

/// The walk over function f: parameters and captures start assigned.
fn scan(p: lower.P, f: u32) -> Scan {
    let fd = p.ir.fns[f as usize]
    let n = fd.lcount as usize
    let mut sc = Scan(List.new(), List.new(), List.new(), List.new(), List.new(), false, List.new(), List.new(), List.new())
    for i in 0..n {
        sc.da.push(false)
        sc.nz.push(false)
        sc.wr.push(false)
        sc.tmp.push(false)
        sc.ndef.push(0)
        sc.placed.push(false)
        sc.deaduse.push(false)
    }
    let mut np: u32 = 0
    while np < fd.lcount && p.ir.locals[(fd.lstart + np) as usize].kind == ir.L_CAPTURE { np += 1 }
    for i in 0..(np + fd.nparams) { sc.da[i as usize] = true }
    sc_block(p, inout sc, fd.body - 1)
    sc
}

// ---- functions

fn sig_names(sg: abi.Sig) -> List[List[u8]] {
    // parameter names: %sret, then per argument %a<i> (direct, byval, ref) or %a<i>.0/.1
    let mut names: List[List[u8]] = List.new()
    if sg.ret.kind == abi.A_SRET { names.push(lit("%sret")) }
    for i in 0..sg.args.len() {
        let a = sg.args[i]
        if a.kind == abi.A_COERCE && a.c0 != abi.C_PAIR {
            names.push(cat(num("%a", i as u64), ".0"))
            if a.n > 1 { names.push(cat(num("%a", i as u64), ".1")) }
        } else {
            names.push(num("%a", i as u64))
        }
    }
    names
}

/// At a function's entry: an AArch64 pair `[2 x i64] %a<i>` as the pieces %a<i>.0 and
/// %a<i>.1 (of the piece's own width), as the other conventions name them.
fn unpack_pairs(inout e: E, sg: abi.Sig) {
    for i in 0..sg.args.len() {
        let a = sg.args[i].copy()
        if a.kind != abi.A_COERCE || a.c0 != abi.C_PAIR { continue }
        let an = num("%a", i as u64)
        stmt_text(inout e, catb(cat(an, ".0 = extractvalue [2 x i64] "), cat(an, ", 0")))
        if a.b1 < 64 {
            stmt_text(inout e, catb(cat(an, ".1w = extractvalue [2 x i64] "), cat(an, ", 1")))
            stmt_text(inout e, catb(cat(an, ".1 = trunc i64 "), catb(cat(an, ".1w to i"), bytes.from_u64(a.b1 as u64))))
        } else {
            stmt_text(inout e, catb(cat(an, ".1 = extractvalue [2 x i64] "), cat(an, ", 1")))
        }
    }
}

fn signature_params(inout e: E, p: lower.P, sg: abi.Sig, internal: bool) -> List[u8] {
    let names = sig_names(sg)
    params_text(inout e, p, sg, names, internal)
}

/// One function as LLVM IR into e.fns, or nothing (and e.fail set) when it needs something
/// this backend doesn't lower yet. A function called from Eider is `internal` with the
/// internal convention (`@<name>.i`); its C-convention symbol, when one is needed, is
/// a wrapper emitted at the end (c_wrapper). A closure body keeps the C convention.
fn function(inout e: E, p: lower.P, f: u32) -> bool {
    let fd = p.ir.fns[f as usize]
    e.ent = List.new()
    e.o = List.new()
    e.fail = List.new()
    e.nreg = 0
    e.nlbl = 0
    e.term = false
    e.cur = lit("%entry")
    e.lbase = fd.lstart
    e.nc = e.ncap[f as usize]
    e.file = fd.file
    e.loops = List.new()
    e.brks = List.new()
    e.dloc = 0
    e.dlines = Map.new()
    let md_mark = e.md.len()
    let nmd_mark = e.nmd.copy()
    let internal = internal_fn(e, p, f)
    let sg = if internal { isig(inout e, p, f) } else { csig(inout e, p, f) }
    e.rsig = sg.ret
    let sc = scan(p, f)
    e.ssa = List.new()
    e.vals = List.new()
    for i in 0..fd.lcount {
        let l = loc(p, e, i)
        let ok = i >= e.nc + fd.nparams && !is_void(l.ty) && is_scalar(p, l.ty) && sc.ndef[i as usize] == 1 && !sc.nz[i as usize] && !sc.placed[i as usize] && !sc.deaduse[i as usize]
        e.ssa.push(ok)
        e.vals.push(List.new())
    }
    let first_line = first_line_of(p, fd)
    if e.dbg { subprogram(inout e, p, f, first_line) }
    set_line(inout e, first_line)
    let clo = e.clo[f as usize].copy()
    if e.nc > 0 { gneed(inout e, lower.GK_ENV, f) }
    unpack_pairs(inout e, sg)
    // parameters into their locals
    let mut ai: usize = 0
    if clo { ai = 1 }
    for i in 0..fd.nparams {
        let li = e.nc + i
        let l = loc(p, e, li)
        let a = sg.args[ai]
        let an = num("%a", ai as u64)
        ai += 1
        if l.kind == ir.L_INOUT {
            stmt_text(inout e, catb(laddr(li), catb(lit(" = getelementptr inbounds i8, ptr "), cat(an, ", i64 0"))))
            continue
        }
        if is_void(l.ty) { continue }
        if a.kind == abi.A_BYVAL || (a.kind == A_REF && !sc.wr[li as usize]) {
            stmt_text(inout e, catb(laddr(li), catb(lit(" = getelementptr inbounds i8, ptr "), cat(an, ", i64 0"))))
            continue
        }
        alloca(inout e, p, li, l.ty)
        if a.kind == A_REF {
            // written: a copy of its own (the caller's value is read-only)
            memcpy(inout e, p, l.ty, laddr(li), an)
        } else if a.kind == abi.A_DIRECT {
            store(inout e, p, l.ty, an, laddr(li))
        } else {
            store_piece(inout e, cat(an, ".0"), laddr(li), 0, a.b0)
            if a.n > 1 { store_piece(inout e, cat(an, ".1"), laddr(li), 8, a.b1) }
        }
    }
    // captures: copies (borrows) of the environment's values; every other local is
    // zeroed only when it may be read before it is assigned (scan)
    if e.nc > 0 {
        let mut cts: List[u32] = List.new()
        for i in 0..e.nc { cts.push(loc(p, e, i).ty) }
        let est = members(inout e, p, cts)
        for i in 0..e.nc {
            let ct = loc(p, e, i).ty
            if is_void(ct) { continue }
            alloca(inout e, p, i, ct)
            let fa = gep(inout e, p, est, lit("%a0"), i)
            copy_mem(inout e, p, ct, laddr(i), fa)
        }
    }
    for i in 0..fd.lcount {
        if i < e.nc + fd.nparams { continue }
        let l = loc(p, e, i)
        if is_void(l.ty) || e.ssa[i as usize] { continue }
        alloca(inout e, p, i, l.ty)
        if sc.nz[i as usize] { zero(inout e, p, l.ty, laddr(i)) }
    }
    if e.dbg { declare_locals(inout e, p, f) }
    e.pframe = e.prof > 0 && lower.framed(p, fd.body - 1)
    e.pline = 0
    if e.pframe { e.pf = prof_enter(inout e, (f + 1) as u64) }
    block(inout e, p, fd.body - 1)
    if !e.term {
        if sg.ret.kind == abi.A_VOID || sg.ret.kind == abi.A_SRET {
            prof_leave(inout e)
            stmt_text(inout e, lit("ret void"))
        } else {
            stmt_text(inout e, lit("unreachable"))
        }
    }
    e.pframe = false
    if e.fail.len() > 0 {
        // roll back this function's metadata
        while e.md.len() > md_mark { e.md.pop() }
        e.nmd = nmd_mark
        return false
    }
    let mut h = lit("define ")
    if internal {
        bytes.append(inout h, lit("internal "))
        if sg.ret.kind == abi.A_DIRECT { bytes.append(inout h, lit("noundef ")) }
    }
    bytes.append(inout h, ret_text(inout e, p, sg))
    bytes.append(inout h, lit(" @"))
    if internal { bytes.append(inout h, iname(e, f)) } else { bytes.append(inout h, e.fnn[f as usize]) }
    bytes.append(inout h, lit("("))
    bytes.append(inout h, signature_params(inout e, p, sg, internal))
    if internal { bytes.append(inout h, lit(") unnamed_addr nounwind")) } else { bytes.append(inout h, lit(") nounwind")) }
    if e.dbg { bytes.append(inout h, num(" !dbg !", e.sp as u64)) }
    bytes.append(inout h, lit(" \x7b\nentry:\n"))
    flush_fn(inout e, h)
    true
}

/// The function in e.ent and e.o, with header h, onto the module.
fn flush_fn(inout e: E, h: List[u8]) {
    let ent = e.ent.copy()
    let body = e.o.copy()
    let mut h2 = h.copy()
    // the entry block's allocas, then the body (shared, not copied: e.ent and e.o start
    // afresh with the next function)
    bytes.append(inout h2, ent)
    e.fns.push(h2)
    e.fns.push(body)
    e.fns.push(lit("\x7d\n\n"))
}

fn alloca(inout e: E, p: lower.P, l: u32, ty: u32) {
    let mt = mty(inout e, p, ty)
    bytes.append(inout e.ent, lit("  %l"))
    wd(inout e.ent, l as u64)
    bytes.append(inout e.ent, lit(" = alloca "))
    bytes.append(inout e.ent, mt)
    e.ent.push(10)
}

/// The first source line of a function: its first local's or statement's.
fn first_line_of(p: lower.P, fd: ir.Fn) -> u32 {
    for i in 0..fd.lcount {
        let l = p.ir.locals[(fd.lstart + i) as usize]
        if l.line > 0 { return l.line }
    }
    let bl = p.ir.blocks[(fd.body - 1) as usize]
    for i in 0..bl.len {
        let s = p.ir.stmts[p.ir.extra[(bl.start + i) as usize] as usize]
        if s.line > 0 { return s.line }
    }
    1
}

// ---- debug info

fn file_md(inout e: E, m: u32) -> u32 {
    let k = m as u64
    match e.fmd.get(k) {
        Some(id) => { return id }
        None => {}
    }
    let mut path = lit("?")
    if (m as usize) < e.paths.len() { path = e.paths[m as usize].copy() }
    let id = e.nmd.copy()
    e.nmd += 1
    e.fmd.insert(k, id)
    bytes.append(inout e.md, num("!", id as u64))
    bytes.append(inout e.md, lit(" = !DIFile(filename: "))
    md_string(inout e.md, path)
    bytes.append(inout e.md, lit(", directory: "))
    let dir = e.dir.copy()
    md_string(inout e.md, dir)
    bytes.append(inout e.md, lit(")\n"))
    id
}

fn md_string(inout out: List[u8], s: List[u8]) {
    out.push(34)
    for b in s {
        if b >= 32 && b < 127 && b != 34 && b != 92 {
            out.push(b)
        } else {
            out.push(92)
            let hx = lit("0123456789ABCDEF")
            out.push(hx[(b / 16) as usize])
            out.push(hx[(b % 16) as usize])
        }
    }
    out.push(34)
}

fn subprogram(inout e: E, p: lower.P, f: u32, line: u32) {
    let fd = p.ir.fns[f as usize]
    let fm = file_md(inout e, fd.file)
    let id = e.nmd.copy()
    e.nmd += 1
    e.sp = id
    bytes.append(inout e.md, num("!", id as u64))
    bytes.append(inout e.md, lit(" = distinct !DISubprogram(name: "))
    md_string(inout e.md, fd.name)
    // (no linkageName: a debugger then shows `area`, not the symbol `f_area`)
    bytes.append(inout e.md, num(", scope: !", fm as u64))
    bytes.append(inout e.md, num(", file: !", fm as u64))
    bytes.append(inout e.md, num(", line: ", line as u64))
    bytes.append(inout e.md, lit(", type: !3"))
    bytes.append(inout e.md, num(", scopeLine: ", line as u64))
    bytes.append(inout e.md, lit(", spFlags: DISPFlagDefinition, unit: !0)\n"))
}

/// DWARF variables (`-g`): a DILocalVariable for every parameter and named local that has an
/// address (SSA values are unnamed temporaries), declared at that address; an `inout`
/// parameter's address is the caller's value.
fn declare_locals(inout e: E, p: lower.P, f: u32) {
    let fd = p.ir.fns[f as usize]
    let fm = file_md(inout e, fd.file)
    declare(inout e, lit("llvm.dbg.declare"), lit("declare void @llvm.dbg.declare(metadata, metadata, metadata)"))
    for i in 0..fd.lcount {
        let l = loc(p, e, i)
        if i < e.nc || is_void(l.ty) || e.ssa[i as usize] || l.name == 0 { continue }
        let isparam = i < e.nc + fd.nparams
        if !isparam && l.kind == ir.L_TEMP { continue }
        let tyid = di_type(inout e, p, l.ty)
        let v = e.nmd.copy()
        e.nmd += 1
        bytes.append(inout e.md, num("!", v as u64))
        bytes.append(inout e.md, lit(" = !DILocalVariable(name: "))
        md_string(inout e.md, intern.name(p.names, l.name))
        let argn = num(", arg: ", (i - e.nc + 1) as u64)
        let scope = num(", scope: !", e.sp as u64)
        if isparam { bytes.append(inout e.md, argn) }
        bytes.append(inout e.md, scope)
        bytes.append(inout e.md, num(", file: !", fm as u64))
        let ln: u32 = if l.line > 0 { l.line } else { 1 }
        bytes.append(inout e.md, num(", line: ", ln as u64))
        bytes.append(inout e.md, num(", type: !", tyid as u64))
        bytes.append(inout e.md, lit(")\n"))
        ins(inout e)
        w(inout e, "call void @llvm.dbg.declare(metadata ptr %l")
        wn(inout e, i as u64)
        w(inout e, ", metadata !")
        wn(inout e, v as u64)
        w(inout e, ", metadata !DIExpression())")
        fin(inout e)
    }
}

/// The DWARF description of type ty (memoized; a node's number is taken before its members
/// are described, so recursive types refer to themselves).
fn di_type(inout e: E, p: lower.P, ty: u32) -> u32 {
    if e.dty[ty as usize] > 0 { return e.dty[ty as usize] }
    let id = e.nmd.copy()
    e.nmd += 1
    e.dty[ty as usize] = id
    let t = types.get(p.t, ty)
    let k = t.kind
    let mut o = num("!", id as u64)
    let bits = size(inout e, p, ty) * 8
    if k == types.T_INT || k == types.T_BOOL || k == types.T_UNIT || k == types.T_NEVER {
        let enc = if k == types.T_BOOL { "DW_ATE_boolean" } else if k == types.T_INT && t.a == types.IK_U8 { "DW_ATE_unsigned_char" } else if k == types.T_INT && types.signed(t.a) { "DW_ATE_signed" } else { "DW_ATE_unsigned" }
        bytes.append(inout o, lit(" = !DIBasicType(name: "))
        md_string(inout o, types.show(p.t, p.names, ty))
        bytes.append(inout o, num(", size: ", bits))
        bytes.append(inout o, lit(", encoding: "))
        bytes.append(inout o, lit(enc))
        bytes.append(inout o, lit(")\n"))
        bytes.append(inout e.md, o)
        return id
    }
    if k == types.T_STR {
        let c = di_char(inout e)
        bytes.append(inout o, num(" = !DIDerivedType(tag: DW_TAG_pointer_type, name: \"str\", baseType: !", c as u64))
        bytes.append(inout o, lit(", size: 64)\n"))
        bytes.append(inout e.md, o)
        return id
    }
    if k == types.T_ARRAY {
        let n: u64 = if t.b == 0 { 1 } else { t.b as u64 }
        let el = di_type(inout e, p, t.a)
        bytes.append(inout o, num(" = !DICompositeType(tag: DW_TAG_array_type, baseType: !", el as u64))
        bytes.append(inout o, num(", size: ", bits))
        bytes.append(inout o, num(r", elements: !{!DISubrange(count: ", n))
        bytes.append(inout o, lit(")\x7d)\n"))
        bytes.append(inout e.md, o)
        return id
    }
    // a structure: its members by name, type and offset
    let mut ms: List[u32] = List.new()
    if k == types.T_TUPLE || (k == types.T_RECORD && !lower.shared_rec(p, ty)) {
        let parts = abi.parts(p, ty, NONE)
        let d = types.def_of(p.t, ty)
        for j in 0..parts.len() {
            let nm = if k == types.T_RECORD { intern.name(p.names, types.field(p.t, d.start, j as u32).name) } else { bytes.from_u64(j as u64) }
            let off = abi.offset_of(inout e.lay, p, parts, j as u32) * 8
            ms.push(di_member(inout e, p, nm, parts[j], off))
        }
    } else if k == types.T_STRING || k == types.T_LIST {
        let mut ptys: List[u32] = List.new()
        ptys.push(types.STR)
        ptys.push(types.U64)
        ptys.push(types.U64)
        let first = if k == types.T_STRING { lit("p") } else { lit("d") }
        if k == types.T_STRING {
            ms.push(di_member(inout e, p, first, types.STR, 0))
        } else {
            let el = di_type(inout e, p, t.a)
            let pt = e.nmd.copy()
            e.nmd += 1
            bytes.append(inout e.md, num("!", pt as u64))
            bytes.append(inout e.md, num(" = !DIDerivedType(tag: DW_TAG_pointer_type, baseType: !", el as u64))
            bytes.append(inout e.md, lit(", size: 64)\n"))
            ms.push(di_member_node(inout e, first, pt, 64, 0))
        }
        ms.push(di_member(inout e, p, lit("len"), types.U64, 64))
        ms.push(di_member(inout e, p, lit("cap"), types.U64, 128))
    } else if k == types.T_MAP {
        // { K *k; V *v; uint8_t *s; uint64_t len, cap, used; } (slot i holds an entry when
        // s[i] == 1): what the debugger printers (debug/) read
        let kt = di_type(inout e, p, t.a)
        let vt = di_type(inout e, p, t.b)
        let st = di_type(inout e, p, types.U8)
        let mut ptrs: List[u32] = List.new()
        for b in [kt, vt, st] {
            let pt = e.nmd.copy()
            e.nmd += 1
            bytes.append(inout e.md, num("!", pt as u64))
            bytes.append(inout e.md, num(" = !DIDerivedType(tag: DW_TAG_pointer_type, baseType: !", b as u64))
            bytes.append(inout e.md, lit(", size: 64)\n"))
            ptrs.push(pt)
        }
        ms.push(di_member_node(inout e, lit("k"), ptrs[0], 64, 0))
        ms.push(di_member_node(inout e, lit("v"), ptrs[1], 64, 64))
        ms.push(di_member_node(inout e, lit("s"), ptrs[2], 64, 128))
        ms.push(di_member(inout e, p, lit("len"), types.U64, 192))
        ms.push(di_member(inout e, p, lit("cap"), types.U64, 256))
        ms.push(di_member(inout e, p, lit("used"), types.U64, 320))
    } else if k == types.T_ENUM {
        // `tag` is an enumeration of the variants, so a debugger shows `Circle`, not 1
        let d = types.def_of(p.t, ty)
        let u32t = di_type(inout e, p, types.U32)
        let mut ens: List[u32] = List.new()
        for i in 0..d.len {
            let vr0 = types.variant(p.t, d, i)
            let eid = e.nmd.copy()
            e.nmd += 1
            bytes.append(inout e.md, num("!", eid as u64))
            bytes.append(inout e.md, lit(" = !DIEnumerator(name: "))
            md_string(inout e.md, intern.name(p.names, (vr0.key % 4294967296) as u32))
            bytes.append(inout e.md, num(", value: ", i as u64))
            bytes.append(inout e.md, lit(", isUnsigned: true)\n"))
            ens.push(eid)
        }
        let tid = e.nmd.copy()
        e.nmd += 1
        bytes.append(inout e.md, num("!", tid as u64))
        bytes.append(inout e.md, lit(" = !DICompositeType(tag: DW_TAG_enumeration_type, name: "))
        let mut tn = types.show(p.t, p.names, ty)
        bytes.append(inout tn, lit(".tag"))
        md_string(inout e.md, tn)
        bytes.append(inout e.md, num(", baseType: !", u32t as u64))
        bytes.append(inout e.md, lit(", size: 32, elements: !\x7b"))
        for j in 0..ens.len() {
            if j > 0 { bytes.append(inout e.md, lit(", ")) }
            bytes.append(inout e.md, num("!", ens[j] as u64))
        }
        bytes.append(inout e.md, lit("\x7d)\n"))
        ms.push(di_member_node(inout e, lit("tag"), tid, 32, 0))
        if lower.any_payload(p, d) {
            let u = abi.union_of(inout e.lay, p, ty)
            let uoff = (4 + u[1] - 1) / u[1] * u[1]
            for i in 0..d.len {
                let vr = types.variant(p.t, d, i)
                if vr.flen == 0 { continue }
                let parts = abi.parts(p, ty, i)
                let vs = abi.struct_of(inout e.lay, p, parts)
                let mut vms: List[u32] = List.new()
                for j in 0..parts.len() {
                    let off = abi.offset_of(inout e.lay, p, parts, j as u32) * 8
                    let fname = intern.name(p.names, types.field(p.t, vr.fstart, j as u32).name)
                    vms.push(di_member(inout e, p, fname, parts[j], off))
                }
                let vn = intern.name(p.names, (vr.key % 4294967296) as u32)
                let vt = di_struct(inout e, vn, vs[0] * 8, vms)
                ms.push(di_member_node(inout e, vn, vt, vs[0] * 8, uoff * 8))
            }
        }
    }
    bytes.append(inout o, lit(" = !DICompositeType(tag: DW_TAG_structure_type, name: "))
    md_string(inout o, types.show(p.t, p.names, ty))
    bytes.append(inout o, num(", size: ", bits))
    bytes.append(inout o, lit(r", elements: !{"))
    for j in 0..ms.len() {
        if j > 0 { bytes.append(inout o, lit(", ")) }
        bytes.append(inout o, num("!", ms[j] as u64))
    }
    bytes.append(inout o, lit("\x7d)\n"))
    bytes.append(inout e.md, o)
    id
}

fn di_char(inout e: E) -> u32 {
    let id = e.nmd.copy()
    e.nmd += 1
    bytes.append(inout e.md, num("!", id as u64))
    bytes.append(inout e.md, lit(" = !DIBasicType(name: \"char\", size: 8, encoding: DW_ATE_signed_char)\n"))
    id
}

fn di_member(inout e: E, p: lower.P, name: List[u8], ty: u32, off: u64) -> u32 {
    let t = di_type(inout e, p, ty)
    let bits = size(inout e, p, ty) * 8
    di_member_node(inout e, name, t, bits, off)
}

fn di_member_node(inout e: E, name: List[u8], t: u32, bits: u64, off: u64) -> u32 {
    let id = e.nmd.copy()
    e.nmd += 1
    bytes.append(inout e.md, num("!", id as u64))
    bytes.append(inout e.md, lit(" = !DIDerivedType(tag: DW_TAG_member, name: "))
    md_string(inout e.md, name)
    bytes.append(inout e.md, num(", baseType: !", t as u64))
    bytes.append(inout e.md, num(", size: ", bits))
    bytes.append(inout e.md, num(", offset: ", off))
    bytes.append(inout e.md, lit(")\n"))
    id
}

fn di_struct(inout e: E, name: List[u8], bits: u64, ms: List[u32]) -> u32 {
    let id = e.nmd.copy()
    e.nmd += 1
    bytes.append(inout e.md, num("!", id as u64))
    bytes.append(inout e.md, lit(" = !DICompositeType(tag: DW_TAG_structure_type, name: "))
    md_string(inout e.md, name)
    bytes.append(inout e.md, num(", size: ", bits))
    bytes.append(inout e.md, lit(r", elements: !{"))
    for j in 0..ms.len() {
        if j > 0 { bytes.append(inout e.md, lit(", ")) }
        bytes.append(inout e.md, num("!", ms[j] as u64))
    }
    bytes.append(inout e.md, lit("\x7d)\n"))
    id
}

// ---- --profile: the shadow stack (core/eider_rt.h ei_prof_*, the runtime's thread-locals)

fn tls(inout e: E, name: str, ty: str) -> List[u8] {
    let mut d = lit("@")
    bytes.append(inout d, lit(name))
    bytes.append(inout d, lit(" = external thread_local global "))
    bytes.append(inout d, lit(ty))
    declare(inout e, lit(name), d)
    declare(inout e, lit("llvm.threadlocal.address.p0"), lit("declare ptr @llvm.threadlocal.address.p0(ptr)"))
    val(inout e, catb(lit("call ptr @llvm.threadlocal.address.p0(ptr @"), cat(lit(name), ")")))
}

/// ei_prof_enter(id): the next frame (or the spill frame past EI_PROF_DEPTH) gets the function
/// and line 0; returns its address.
fn prof_enter(inout e: E, id: u64) -> List[u8] {
    let dp = tls(inout e, "ei_prof_depth", "i16")
    let st = tls(inout e, "ei_prof_stack", r"[512 x { float, float }]")
    let sp = tls(inout e, "ei_prof_spill", r"{ float, float }")
    let d = val(inout e, catb(lit("load volatile i16, ptr "), dp))
    let dw = val(inout e, catb(lit("zext i16 "), cat(d, " to i64")))
    let inb = val(inout e, catb(lit("icmp ult i64 "), cat(dw, ", 512")))
    let fa = val(inout e, catb(lit(r"getelementptr inbounds [512 x { float, float }], ptr "), catb(st, catb(lit(", i64 0, i64 "), dw))))
    let f = val(inout e, catb(lit("select i1 "), catb(inb, catb(lit(", ptr "), catb(fa, catb(lit(", ptr "), sp))))))
    stmt_text(inout e, catb(lit("store volatile float "), catb(num("", id), catb(lit(".0, ptr "), f))))
    let la = val(inout e, catb(lit(r"getelementptr inbounds { float, float }, ptr "), cat(f, ", i32 0, i32 1")))
    stmt_text(inout e, catb(lit("store volatile float 0.0, ptr "), la))
    let d1 = val(inout e, catb(lit("add i16 "), cat(d, ", 1")))
    stmt_text(inout e, catb(lit("store volatile i16 "), catb(d1, catb(lit(", ptr "), dp))))
    la
}

/// ei_prof_leave() before a return of a framed function.
fn prof_leave(inout e: E) {
    if !e.pframe { return }
    let dp = tls(inout e, "ei_prof_depth", "i16")
    let d = val(inout e, catb(lit("load volatile i16, ptr "), dp))
    let d1 = val(inout e, catb(lit("sub i16 "), cat(d, ", 1")))
    stmt_text(inout e, catb(lit("store volatile i16 "), catb(d1, catb(lit(", ptr "), dp))))
}

/// The frame's line before a statement that calls, allocates or drops (unless it is set).
fn prof_line(inout e: E, line: u32) {
    if !e.pframe || line == 0 || line == e.pline { return }
    let a = e.pf.copy()
    stmt_text(inout e, catb(lit("store volatile float "), catb(num("", line as u64), catb(lit(".0, ptr "), a))))
    e.pline = line
}

/// ei_prof_ev(kind, n) (n: an i64 value) in a profiled program.
fn prof_ev(inout e: E, p: lower.P, kind: u32, n: List[u8]) {
    if e.prof == 0 { return }
    let none: List[u8] = List.new()
    call(inout e, p, lit("ei_prof_ev"), tys2(types.I32, types.U64), args2(bytes.from_u64(kind as u64), n), types.UNIT, none)
}

// the runtime's event kinds (core/eider_rt.h EI_PEV_*)
const PEV_COW: u32 = 1
const PEV_COPY: u32 = 2
const PEV_DROP: u32 = 3
const PEV_GROW: u32 = 4
const PEV_REHASH: u32 = 5
const PEV_REF: u32 = 6

/// `ei_prof_init(&ei_prof_tab)`: the name table (every function, its file), the files, what
/// to record, the program and the toolchain's version.
fn prof_init(inout e: E, p: lower.P, file: List[u8]) {
    if e.prof == 0 { return }
    let n = p.ir.fns.len() + 1
    let mut t = lit("@ei_prof_names = private unnamed_addr constant [")
    wd(inout t, n as u64)
    bytes.append(inout t, lit(" x ptr] [ptr "))
    bytes.append(inout t, msgb(inout e, List.new()))
    for f in 0..p.ir.fns.len() {
        bytes.append(inout t, lit(", ptr "))
        bytes.append(inout t, msgb(inout e, p.ir.fns[f].name))
    }
    bytes.append(inout t, lit("]\n@ei_prof_file_of = private unnamed_addr constant ["))
    wd(inout t, n as u64)
    bytes.append(inout t, lit(" x i32] [i32 0"))
    for f in 0..p.ir.fns.len() {
        bytes.append(inout t, lit(", i32 "))
        wd(inout t, p.ir.fns[f].file as u64)
    }
    let mut nf = p.ir.files.len()
    if nf == 0 { nf = 1 }
    bytes.append(inout t, lit("]\n@ei_prof_files = private unnamed_addr constant ["))
    wd(inout t, nf as u64)
    bytes.append(inout t, lit(" x ptr] [ptr "))
    bytes.append(inout t, msgb(inout e, file))
    for i in 1..p.ir.files.len() {
        bytes.append(inout t, lit(", ptr "))
        bytes.append(inout t, msgb(inout e, p.ir.files[i]))
    }
    bytes.append(inout t, lit("]\n@ei_prof_tab = private unnamed_addr constant \x7b ptr, ptr, i32, ptr, i32, i32, ptr, ptr \x7d \x7b ptr @ei_prof_names, ptr @ei_prof_file_of, i32 "))
    wd(inout t, n as u64)
    bytes.append(inout t, lit(", ptr @ei_prof_files, i32 "))
    wd(inout t, nf as u64)
    bytes.append(inout t, lit(", i32 "))
    wd(inout t, e.prof as u64)
    bytes.append(inout t, lit(", ptr "))
    bytes.append(inout t, msgb(inout e, file))
    bytes.append(inout t, lit(", ptr "))
    let ver = e.pver.copy()
    bytes.append(inout t, msgb(inout e, ver))
    bytes.append(inout t, lit(" \x7d\n"))
    bytes.append(inout e.gl, t)
    let none: List[u8] = List.new()
    call(inout e, p, lit("ei_prof_init"), tys1(types.STR), args1(lit("@ei_prof_tab")), types.UNIT, none)
}

// ---- glue (#128): the per-type operations, in IR
//
// What lower.ei once wrote as C (its `glue`): drop, clone, copy, uniq (copy-on-write), own
// (before a value crosses to another thread), ==, cmp, hash, Show, variant names, the List and
// Map operations, Box/Ref/record buffers, closure environments and thunks, the thread handles,
// Default. Each is a function `@<op><C name of the type>` (lower.c_names) with the C convention
// of the call sites that ask for it (gneed: csig_of of their parameter types), internal to the
// module, built after the program's functions until no new glue is needed (glue_all).

/// A glue function being built: its name, signature and, per parameter, its value (a scalar,
/// or a pointer parameter's pointer) or, for an aggregate, its address.
type GF = { name: List[u8], sig: abi.Sig, args: List[List[u8]] }

fn gfn_begin(inout e: E, p: lower.P, name: List[u8], ptys: List[u32], ret: u32) -> GF {
    let sg = csig_of(inout e, p, ptys, ret)
    e.o = List.new()
    e.ent = List.new()
    e.nreg = 0
    e.nlbl = 0
    e.term = false
    e.cur = lit("%entry")
    e.dloc = 0
    e.file = 0
    e.unchecked = false
    e.loops = List.new()
    e.brks = List.new()
    e.ssa = List.new()
    e.vals = List.new()
    e.rsig = sg.ret.copy()
    e.pframe = false
    unpack_pairs(inout e, sg)
    let mut args: List[List[u8]] = List.new()
    for i in 0..sg.args.len() {
        let a = sg.args[i].copy()
        let an = num("%a", i as u64)
        if a.kind == abi.A_COERCE {
            let t = temp(inout e, p, a.ty)
            store_piece(inout e, cat(an, ".0"), t, 0, a.b0)
            if a.n > 1 {
                store_piece(inout e, cat(an, ".1"), t, 8, a.b1)
            }
            args.push(t)
        } else {
            args.push(an)
        }
    }
    GF(name, sg, args)
}

/// The function onto the module (a block left open returns: void, or unreachable).
fn gfn_end(inout e: E, p: lower.P, gf: GF) {
    if !e.term {
        if gf.sig.ret.kind == abi.A_VOID || gf.sig.ret.kind == abi.A_SRET {
            stmt_text(inout e, lit("ret void"))
        } else {
            stmt_text(inout e, lit("unreachable"))
        }
    }
    let mut h = lit("define internal ")
    bytes.append(inout h, ret_text(inout e, p, gf.sig))
    bytes.append(inout h, lit(" @"))
    bytes.append(inout h, gf.name)
    bytes.append(inout h, lit("("))
    bytes.append(inout h, signature_params(inout e, p, gf.sig, false))
    bytes.append(inout h, lit(") unnamed_addr nounwind \x7b\nentry:\n"))
    flush_fn(inout e, h)
    e.gdef.insert(h64(gf.name), true)
}

/// Return the scalar value v (bool: i1).
fn gret_v(inout e: E, p: lower.P, v: List[u8]) {
    let r = e.rsig.copy()
    let _h1 = catb(lit("ret "), catb(vty(inout e, p, r.ty), catb(lit(" "), v)))
    stmt_text(inout e, _h1)
    e.term = true
}

/// Return the aggregate at address a.
fn gret_a(inout e: E, p: lower.P, a: List[u8]) {
    let r = e.rsig.copy()
    if r.kind == abi.A_SRET {
        memcpy(inout e, p, r.ty, lit("%sret"), a)
        stmt_text(inout e, lit("ret void"))
        e.term = true
    } else if r.kind == abi.A_COERCE {
        ret_pieces(inout e, r, a)
    } else {
        // a scalar result kept at an address
        let v = load(inout e, p, r.ty, a)
        gret_v(inout e, p, v)
    }
}

fn gret_void(inout e: E) {
    stmt_text(inout e, lit("ret void"))
    e.term = true
}

/// `for i in 0..n` (n: an i64 value): the loop's counter, index value and labels. The body
/// follows; loop_next closes it.
type Loop = { ctr: List[u8], iv: List[u8], head: u32, done: u32 }

fn loop_n(inout e: E, p: lower.P, n: List[u8]) -> Loop {
    let ctr = temp(inout e, p, types.U64)
    stmt_text(inout e, catb(lit("store i64 0, ptr "), ctr))
    let head = new_label(inout e)
    let body = new_label(inout e)
    let done = new_label(inout e)
    label(inout e, head)
    let iv = val(inout e, catb(lit("load i64, ptr "), ctr))
    let c = val(inout e, catb(lit("icmp ult i64 "), catb(iv, catb(lit(", "), n))))
    condbr(inout e, c, body, done)
    label(inout e, body)
    Loop(ctr, iv, head, done)
}

fn loop_next(inout e: E, lp: Loop) {
    if !e.term {
        let nx = val(inout e, catb(lit("add nuw i64 "), cat(lp.iv, ", 1")))
        stmt_text(inout e, catb(lit("store i64 "), catb(nx, catb(lit(", ptr "), lp.ctr))))
        br(inout e, lp.head)
    }
    label(inout e, lp.done)
}

/// `if c {` (c: i1): returns the label after the block (if_end).
fn if_then(inout e: E, c: List[u8]) -> u32 {
    let t = new_label(inout e)
    let j = new_label(inout e)
    condbr(inout e, c, t, j)
    label(inout e, t)
    j
}

fn if_end(inout e: E, j: u32) { label(inout e, j) }

/// The address of element i (an i64 value) of an array of el at pointer d.
fn elem(inout e: E, p: lower.P, el: u32, d: List[u8], i: List[u8]) -> List[u8] {
    let mut g = lit("getelementptr inbounds ")
    bytes.append(inout g, mty(inout e, p, el))
    bytes.append(inout g, lit(", ptr "))
    bytes.append(inout g, d)
    bytes.append(inout g, lit(", i64 "))
    bytes.append(inout g, i)
    val(inout e, g)
}

fn store_ptr(inout e: E, v: List[u8], a: List[u8]) { stmt_text(inout e, catb(lit("store ptr "), catb(v, catb(lit(", ptr "), a)))) }
fn store_i64(inout e: E, v: List[u8], a: List[u8]) { stmt_text(inout e, catb(lit("store i64 "), catb(v, catb(lit(", ptr "), a)))) }
fn load_i64(inout e: E, a: List[u8]) -> List[u8] { val(inout e, catb(lit("load i64, ptr "), a)) }
fn load_p(inout e: E, a: List[u8]) -> List[u8] { val(inout e, catb(lit("load ptr, ptr "), a)) }
fn store_field_ptr(inout e: E, p: lower.P, ty: u32, a: List[u8], i: u32, v: List[u8]) {
    let f = field_addr(inout e, p, ty, a, i)
    store_ptr(inout e, v, f)
}
fn store_field_i64(inout e: E, p: lower.P, ty: u32, a: List[u8], i: u32, v: List[u8]) {
    let f = field_addr(inout e, p, ty, a, i)
    store_i64(inout e, v, f)
}
fn not_null(inout e: E, v: List[u8]) -> List[u8] { val(inout e, catb(lit("icmp ne ptr "), cat(v, ", null"))) }

// ---- shared buffers: the count in the 16-byte header before the data (core/eider_rt.h,
// ei_buf_*; not atomic)

fn buf_hdr(inout e: E, d: List[u8]) -> List[u8] { val(inout e, catb(lit("getelementptr inbounds i8, ptr "), cat(d, ", i64 -16"))) }

/// ei_buf_inc(d)
fn buf_inc(inout e: E, d: List[u8]) {
    let _h2 = not_null(inout e, d)
    let j = if_then(inout e, _h2)
    let h = buf_hdr(inout e, d)
    let n = load_i64(inout e, h)
    let m = val(inout e, catb(lit("add i64 "), cat(n, ", 1")))
    store_i64(inout e, m, h)
    if_end(inout e, j)
}

/// ei_buf_dec(d): one holder fewer; an i1, true when that was the last (false for null).
fn buf_dec(inout e: E, p: lower.P, d: List[u8]) -> List[u8] {
    let r = temp(inout e, p, types.BOOL)
    stmt_text(inout e, catb(lit("store i8 0, ptr "), r))
    let _h3 = not_null(inout e, d)
    let j = if_then(inout e, _h3)
    let h = buf_hdr(inout e, d)
    let n = load_i64(inout e, h)
    let m = val(inout e, catb(lit("sub i64 "), cat(n, ", 1")))
    store_i64(inout e, m, h)
    let z = val(inout e, catb(lit("icmp eq i64 "), cat(m, ", 0")))
    store(inout e, p, types.BOOL, z, r)
    if_end(inout e, j)
    load(inout e, p, types.BOOL, r)
}

/// ei_buf_shared(d): more than one holder (false for null).
fn buf_shared(inout e: E, p: lower.P, d: List[u8]) -> List[u8] {
    let r = temp(inout e, p, types.BOOL)
    stmt_text(inout e, catb(lit("store i8 0, ptr "), r))
    let _h4 = not_null(inout e, d)
    let j = if_then(inout e, _h4)
    let h = buf_hdr(inout e, d)
    let n = load_i64(inout e, h)
    let s = val(inout e, catb(lit("icmp ugt i64 "), cat(n, ", 1")))
    store(inout e, p, types.BOOL, s, r)
    if_end(inout e, j)
    load(inout e, p, types.BOOL, r)
}

/// ei_buf_count(d) == 1 (d not null)
fn buf_single(inout e: E, d: List[u8]) -> List[u8] {
    let h = buf_hdr(inout e, d)
    let n = load_i64(inout e, h)
    val(inout e, catb(lit("icmp eq i64 "), cat(n, ", 1")))
}

fn buf_free(inout e: E, p: lower.P, d: List[u8]) {
    let none: List[u8] = List.new()
    call(inout e, p, lit("ei_buf_free"), tys1(types.STR), args1(d), types.UNIT, none)
}

fn buf_alloc(inout e: E, p: lower.P, n: List[u8], size: u64) -> List[u8] {
    rt_call(inout e, p, "ei_buf_alloc", tys2(types.U64, types.U64), args2(n, bytes.from_u64(size)), types.STR)
}

fn rt_free(inout e: E, p: lower.P, d: List[u8]) {
    let none: List[u8] = List.new()
    call(inout e, p, lit("ei_free"), tys1(types.STR), args1(d), types.UNIT, none)
}

/// Append text t to the String at o (ei_str_push with a constant).
fn show_text(inout e: E, p: lower.P, o: List[u8], t: List[u8]) {
    let none: List[u8] = List.new()
    let m = msgb(inout e, t)
    call(inout e, p, lit("ei_str_push"), tys2(PTR + types.STRING, types.STR), args2(o, m), types.UNIT, none)
}

/// msg for any bytes (glue's names and labels).
fn msgb(inout e: E, s: List[u8]) -> List[u8] {
    let k = h64(s)
    match e.msgs.get(k) {
        Some(i) => { return num("@.m", i as u64) }
        None => {}
    }
    let i = e.nmsg
    e.nmsg += 1
    e.msgs.insert(k, i)
    let name = num("@.m", i as u64)
    bytes.append(inout e.gl, name)
    bytes.append(inout e.gl, lit(" = private unnamed_addr constant ["))
    bytes.append(inout e.gl, bytes.from_u64((s.len() + 1) as u64))
    bytes.append(inout e.gl, lit(" x i8] "))
    c_string(inout e.gl, s)
    e.gl.push(10)
    name
}

/// The value of type ty at address a, for a call argument: a scalar's value, an aggregate's
/// address.
fn argof(inout e: E, p: lower.P, ty: u32, a: List[u8]) -> List[u8] {
    if is_scalar(p, ty) && !is_void(ty) {
        return load(inout e, p, ty, a)
    }
    a
}

/// The address of a value of type ty given as a glue parameter (a scalar's value is stored).
fn addrof(inout e: E, p: lower.P, ty: u32, v: List[u8]) -> List[u8] {
    if is_scalar(p, ty) && !is_void(ty) {
        let t = temp(inout e, p, ty)
        store(inout e, p, ty, v, t)
        return t
    }
    v
}

/// The fields of a struct-like type (record, tuple; a variant with v) with their addresses in
/// the value at a: for a shared record, in its buffer.
fn part_addr(inout e: E, p: lower.P, ty: u32, a: List[u8], i: u32) -> List[u8] {
    if kind(p, ty) == types.T_RECORD && lower.shared_rec(p, ty) {
        let q = load_ptr_field(inout e, p, ty, a, 0)
        return gep(inout e, p, cat(num("%t", ty as u64), ".d"), q, i)
    }
    field_addr(inout e, p, ty, a, i)
}

/// Call user function f (a trait impl) with the internal convention: args are values for
/// scalars, addresses for aggregates; an aggregate result goes to dst.
fn call_user(inout e: E, p: lower.P, f: u32, args: List[List[u8]], dst: List[u8]) -> List[u8] {
    let sg = isig(inout e, p, f)
    let mut d = dst.copy()
    if (sg.ret.kind == abi.A_SRET || sg.ret.kind == abi.A_COERCE) && d.len() == 0 {
        d = temp(inout e, p, sg.ret.ty)
    }
    // A_REF arguments must not alias each other's writes: the callee doesn't write them
    let callee = catb(lit("@"), iname(e, f))
    call_sig(inout e, p, callee, sg, args, d)
}

/// The tag of the enum at a (i32).
fn tag_of(inout e: E, p: lower.P, ty: u32, a: List[u8]) -> List[u8] { load_tag(inout e, p, ty, a) }

/// Whether an i32 tag value t is variant i (i1).
fn tag_is(inout e: E, t: List[u8], i: u32) -> List[u8] { val(inout e, catb(lit("icmp eq i32 "), catb(t, num(", ", i as u64)))) }

fn variant_owns(inout e: E, p: lower.P, ty: u32, i: u32) -> bool {
    let d = types.def_of(p.t, ty)
    let v = types.variant(p.t, d, i)
    for j in 0..v.flen {
        if owns(inout e, p, types.field(p.t, v.fstart, j).ty) {
            return true
        }
    }
    false
}

/// An early `return false` unless i1 c.
fn ret_false_unless(inout e: E, p: lower.P, c: List[u8]) {
    let nc = val(inout e, catb(lit("xor i1 "), cat(c, ", true")))
    let j = if_then(inout e, nc)
    gret_v(inout e, p, lit("false"))
    if_end(inout e, j)
}

/// The address of element i (i64 value) of the array value at a (`{ [n x T] }`).
fn arr_elem(inout e: E, p: lower.P, ty: u32, a: List[u8], i: List[u8]) -> List[u8] {
    let mut g = lit("getelementptr inbounds ")
    bytes.append(inout g, mty(inout e, p, ty))
    bytes.append(inout g, lit(", ptr "))
    bytes.append(inout g, a)
    bytes.append(inout g, lit(", i32 0, i32 0, i64 "))
    bytes.append(inout g, i)
    val(inout e, g)
}

/// own(a): the value of type ty at a about to be seen by another thread gets buffers of
/// its own (lower.ei's own_call).
fn own_at(inout e: E, p: lower.P, ty: u32, a: List[u8]) {
    if !owns(inout e, p, ty) || types.is_handle(kind(p, ty)) {
        return
    }
    let none: List[u8] = List.new()
    if kind(p, ty) == types.T_STRING {
        call(inout e, p, lit("ei_str_unique"), tys1(PTR + ty), args1(a), types.UNIT, none)
        return
    }
    gneed(inout e, lower.GK_OWN, ty)
    let gn_ = gname(e, "own_", ty)
    call(inout e, p, gn_, tys1(PTR + ty), args1(a), types.UNIT, none)
}

/// Call the function pointer at field i of the fn value at fv with (env) when it is set:
/// its drop (2) or own (4).
fn fnval_hook(inout e: E, p: lower.P, fty: u32, fv: List[u8], i: u32) {
    let h = load_ptr_field(inout e, p, fty, fv, i)
    let _h5 = not_null(inout e, h)
    let j = if_then(inout e, _h5)
    let env = load_ptr_field(inout e, p, fty, fv, 0)
    stmt_text(inout e, catb(lit("call void "), catb(h, catb(lit("(ptr "), cat(env, ")")))))
    if_end(inout e, j)
}

/// The struct of a Ref's buffer, `{ i64 st, T v }`: the offset of v.
fn ref_voff(inout e: E, p: lower.P, el: u32) -> u64 {
    let mut ms: List[u32] = List.new()
    ms.push(types.I64)
    ms.push(el)
    abi.offset_of(inout e.lay, p, ms, 1)
}

fn ref_size(inout e: E, p: lower.P, el: u32) -> u64 {
    let mut ms: List[u32] = List.new()
    ms.push(types.I64)
    ms.push(el)
    abi.struct_of(inout e.lay, p, ms)[0]
}

fn off_ptr(inout e: E, q: List[u8], off: u64) -> List[u8] {
    if off == 0 {
        return q.copy()
    }
    val(inout e, catb(lit("getelementptr inbounds i8, ptr "), catb(q, num(", i64 ", off))))
}

/// The size of a shared record's buffer struct.
fn rec_dsize(inout e: E, p: lower.P, ty: u32) -> u64 {
    let d = types.def_of(p.t, ty)
    if d.len == 0 {
        return 1
    }
    abi.struct_of(inout e.lay, p, abi.parts(p, ty, NONE))[0]
}

fn dyn_memcpy(inout e: E, dst: List[u8], src: List[u8], n: List[u8]) {
    declare(inout e, lit("llvm.memcpy.p0.p0.i64"), lit("declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)"))
    stmt_text(inout e, catb(lit("call void @llvm.memcpy.p0.p0.i64(ptr "), catb(dst, catb(lit(", ptr "), catb(src, catb(lit(", i64 "), cat(n, ", i1 false)")))))))
}

fn dyn_memset0(inout e: E, dst: List[u8], n: List[u8]) {
    declare(inout e, lit("llvm.memset.p0.i64"), lit("declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)"))
    stmt_text(inout e, catb(lit("call void @llvm.memset.p0.i64(ptr "), catb(dst, catb(lit(", i8 0, i64 "), cat(n, ", i1 false)")))))
}

fn mul_const(inout e: E, n: List[u8], k: u64) -> List[u8] {
    if k == 1 {
        return n.copy()
    }
    val(inout e, catb(lit("mul i64 "), catb(n, num(", ", k))))
}

// ---- drop, clone, copy, uniq, own

fn g_drop(inout e: E, p: lower.P, ty: u32) {
    let _h6 = gname(e, "drop_", ty)
    let gf = gfn_begin(inout e, p, _h6, tys1(PTR + ty), types.UNIT)
    let x = gf.args[0].copy()
    let t = types.get(p.t, ty)
    let k = t.kind
    if k == types.T_RECORD && lower.shared_rec(p, ty) {
        // its own drop runs once, when the last holder goes, before the fields are dropped
        let d = types.def_of(p.t, ty)
        let q = load_ptr_field(inout e, p, ty, x, 0)
        let _h7 = not_null(inout e, q)
        let j0 = if_then(inout e, _h7)
        let _h8 = buf_single(inout e, q)
        let j1 = if_then(inout e, _h8)
        let none: List[u8] = List.new()
        let ds0 = rec_dsize(inout e, p, ty)
        prof_ev(inout e, p, PEV_DROP, bytes.from_u64(ds0))
        call_user(inout e, p, lower.custom_fn(p, lower.TR_DROP, ty), args1(x), none)
        if_end(inout e, j1)
        let q2 = load_ptr_field(inout e, p, ty, x, 0)
        let _h9 = buf_dec(inout e, p, q2)
        let j2 = if_then(inout e, _h9)
        for i in 0..d.len {
            let ft = types.field(p.t, d.start, i).ty
            if !owns(inout e, p, ft) {
                continue
            }
            let _h10 = gep(inout e, p, cat(num("%t", ty as u64), ".d"), q2, i)
            drop_at(inout e, p, ft, _h10)
        }
        buf_free(inout e, p, q2)
        if_end(inout e, j2)
        if_end(inout e, j0)
        store_field_ptr(inout e, p, ty, x, 0, lit("null"))
    } else if k == types.T_RECORD || k == types.T_TUPLE {
        let ms = abi.parts(p, ty, NONE)
        for i in 0..ms.len() {
            if owns(inout e, p, ms[i]) {
                let _h11 = field_addr(inout e, p, ty, x, i as u32)
                drop_at(inout e, p, ms[i], _h11)
            }
        }
    } else if k == types.T_ENUM {
        let d = types.def_of(p.t, ty)
        let tg = tag_of(inout e, p, ty, x)
        for i in 0..d.len {
            if !variant_owns(inout e, p, ty, i) {
                continue
            }
            let _h12 = tag_is(inout e, tg, i)
            let j = if_then(inout e, _h12)
            let v = types.variant(p.t, d, i)
            for f in 0..v.flen {
                let ft = types.field(p.t, v.fstart, f).ty
                if owns(inout e, p, ft) {
                    let _h13 = payload_addr(inout e, p, ty, x, i, f)
                    drop_at(inout e, p, ft, _h13)
                }
            }
            if_end(inout e, j)
        }
    } else if k == types.T_ARRAY {
        if t.b > 0 && owns(inout e, p, t.a) {
            let lp = loop_n(inout e, p, bytes.from_u64(t.b as u64))
            let _h14 = arr_elem(inout e, p, ty, x, lp.iv)
            drop_at(inout e, p, t.a, _h14)
            loop_next(inout e, lp)
        }
    } else if k == types.T_LIST {
        // the last holder of the shared buffer drops the elements, once
        let d = load_ptr_field(inout e, p, ty, x, 0)
        let _h15 = buf_dec(inout e, p, d)
        let j = if_then(inout e, _h15)
        if owns(inout e, p, t.a) {
            let n = load_i64_field(inout e, p, ty, x, 1)
            let lp = loop_n(inout e, p, n)
            let _h16 = elem(inout e, p, t.a, d, lp.iv)
            drop_at(inout e, p, t.a, _h16)
            loop_next(inout e, lp)
        }
        buf_free(inout e, p, d)
        if_end(inout e, j)
        store_field_ptr(inout e, p, ty, x, 0, lit("null"))
        store_field_i64(inout e, p, ty, x, 1, lit("0"))
        store_field_i64(inout e, p, ty, x, 2, lit("0"))
    } else if k == types.T_MAP {
        // the count is on the slot states `s`; k and v go with it
        let s = load_ptr_field(inout e, p, ty, x, 2)
        let _h17 = buf_dec(inout e, p, s)
        let j = if_then(inout e, _h17)
        let kp = load_ptr_field(inout e, p, ty, x, 0)
        let vp = load_ptr_field(inout e, p, ty, x, 1)
        if owns(inout e, p, t.a) || owns(inout e, p, t.b) {
            let cap = load_i64_field(inout e, p, ty, x, 4)
            let lp = loop_n(inout e, p, cap)
            let _h18 = catb(lit("load i8, ptr "), elem(inout e, p, types.U8, s, lp.iv))
            let sv = val(inout e, _h18)
            let _h19 = val(inout e, catb(lit("icmp eq i8 "), cat(sv, ", 1")))
            let j2 = if_then(inout e, _h19)
            let _h20 = elem(inout e, p, t.a, kp, lp.iv)
            drop_at(inout e, p, t.a, _h20)
            let _h21 = elem(inout e, p, t.b, vp, lp.iv)
            drop_at(inout e, p, t.b, _h21)
            if_end(inout e, j2)
            loop_next(inout e, lp)
        }
        rt_free(inout e, p, kp)
        rt_free(inout e, p, vp)
        buf_free(inout e, p, s)
        if_end(inout e, j)
        for i in 0..3 {
            store_field_ptr(inout e, p, ty, x, i as u32, lit("null"))
        }
        for i in 3..6 {
            store_field_i64(inout e, p, ty, x, i as u32, lit("0"))
        }
    } else if k == types.T_BOX || k == types.T_REF {
        let q = load_ptr_field(inout e, p, ty, x, 0)
        let _h22 = buf_dec(inout e, p, q)
        let j = if_then(inout e, _h22)
        if k == types.T_BOX {
            drop_at(inout e, p, t.a, q)
        } else {
            let _h240 = ref_voff(inout e, p, t.a)
            let _h23 = off_ptr(inout e, q, _h240)
            drop_at(inout e, p, t.a, _h23)
        }
        buf_free(inout e, p, q)
        if_end(inout e, j)
        store_field_ptr(inout e, p, ty, x, 0, lit("null"))
    } else if k == types.T_FN {

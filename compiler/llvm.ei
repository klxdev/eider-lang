        buf_dec(inout e, p, b0)
        memcpy(inout e, p, ty, x, n)
        gfn_end(inout e, p, gf)
        return
    }
    gneed(inout e, lower.GK_DROP, ty)
    let old = temp(inout e, p, ty)
    memcpy(inout e, p, ty, old, x)
    if k == types.T_LIST {
        let cap = load_i64_field(inout e, p, ty, x, 2)
        let es = size(inout e, p, t.a)
        let nd = buf_alloc(inout e, p, cap, es)
        store_field_ptr(inout e, p, ty, x, 0, nd)
        let n = load_i64_field(inout e, p, ty, x, 1)
        if owns(inout e, p, t.a) {
            let lp = loop_n(inout e, p, n)
            let _h62 = elem(inout e, p, t.a, b0, lp.iv)
            let _h254 = elem(inout e, p, t.a, nd, lp.iv)
            clone_to(inout e, p, t.a, _h62, _h254)
            loop_next(inout e, lp)
        } else {
            let _h63 = val(inout e, catb(lit("icmp ne i64 "), cat(n, ", 0")))
            let jn = if_then(inout e, _h63)
            let _h64 = mul_const(inout e, n, es)
            dyn_memcpy(inout e, nd, b0, _h64)
            if_end(inout e, jn)
        }
    } else if k == types.T_MAP {
        let cap = load_i64_field(inout e, p, ty, x, 4)
        let _h65 = args2(cap, bytes.from_u64(size(inout e, p, t.a)))
        let nk = rt_call(inout e, p, "ei_alloc_n", tys2(types.U64, types.U64), _h65, types.STR)
        let _h66 = args2(cap, bytes.from_u64(size(inout e, p, t.b)))

// llvm: the typed IR (ir.ei) to textual LLVM IR, beside the C backend (lower.ei). See
// docs/compiler.md, "Backends", and docs/site/tooling/llvm.md. Experimental: `eiderc build|run|
// test --backend=llvm`.
//
// Function by function: a function whose statements this file can lower is emitted as LLVM IR
// (`native`); any other falls back to the C backend. lower.program_split writes the C half (the
// fallback functions, all the per-type glue, `main` and the test driver) with prototypes for
// the native functions and external linkage everywhere, so the halves call each other through
// the C ABI (llvm_abi.ei: System V x86-64). Every Eider-to-Eider call uses that convention too,
// whichever half the callee is in, so a function can move between the halves freely.
//
// Semantics are the C backend's, statement for statement, with nothing undefined: checked
// arithmetic is `llvm.*.with.overflow` and an explicit trap branch (the runtime's ei_trap with
// the same message and the same encoded line, so traps print and exit exactly as in C), bounds
// checks are an `icmp uge` and a trap branch, division checks zero and MIN / -1 first, shifts
// check the count, and no instruction carries `nsw`, `nuw`, `exact` or `inbounds` (nothing
// is proven yet). Wrapping operators are plain `add`/`sub`/`mul`. Per-type operations (drop,
// clone, ==, Ord, Show, List and Map operations, copy-on-write `uniq_`) call the C half's glue,
// exactly where lower.ei calls it, so the glue the C half emits is the glue this half needs;
// the hot helpers (ei_idx, checked arithmetic, conversions, shifts, ei_hash_u64) are inline IR.
//
// Values: every local is an `alloca` (`%l<i>`, zeroed at entry as C's `= {0}`), scalars are
// SSA registers between statements (bool is `i1` there and `i8` in memory), aggregates are
// moved with `llvm.memcpy`. Types are the C layouts (llvm_abi.ei): `%t<id>` per struct type
// (`%t<id>.v<i>` an enum variant's payload struct, `%t<id>.d` a shared record's buffer),
// `%ei.String` for String. Control flow is the IR's structure: S_IF and S_LOOP become
// labelled blocks (`L<n>`), break/continue/return branches, code after them a dead block.
//
// Debug info (`-g`): a DICompileUnit, a DIFile per module, a DISubprogram per native
// function and a DILocation per statement (the statement's source line), so a debugger
// breaks on Eider lines in native functions; the C half carries its own (`#line`-less) C info.

import "core/sys"
import "std/bytes"
import "types.ei"
import "ast.ei"
import "ir.ei"
import "lower.ei"
import "llvm_abi.ei" as abi

const NONE: u32 = 4294967295
const PTR: u32 = 2147483648

/// The two halves: `ll` the LLVM module, `c` the C (lower.program_split), and per function
/// whether it is native (functions without a body are never native). `report` names each
/// fallback with the first construct it needed (one line each).
pub type Out = { ll: List[u8], c: List[u8], native: List[bool], nfns: u32, nnative: u32, report: List[u8] }

type E = {
    /// the function being emitted: its entry allocas, its body, and the module so far
    ent: List[u8],
    o: List[u8],
    fns: List[u8],
    tdefs: List[u8],
    tdone: List[bool],
    gl: List[u8],
    lay: abi.Lay,
    own: List[u8],
    tn: List[List[u8]],
    fnn: List[List[u8]],
    ncap: List[u32],
    clo: List[bool],
    /// declarations: name -> declare text (emitted for names this module doesn't define)
    dnames: List[List[u8]],
    dtext: List[List[u8]],
    didx: Map[u64, u32],
    sused: List[bool],
    msgs: Map[u64, u32],
    nmsg: u32,
    nreg: u32,
    nlbl: u32,
    term: bool,
    cur: List[u8],
    lbase: u32,
    nc: u32,
    file: u32,
    loops: List[u32],
    brks: List[u32],
    sret: bool,
    rsig: abi.Arg,
    fail: List[u8],
    /// debug info
    dbg: bool,
    md: List[u8],
    nmd: u32,
    sp: u32,
    dloc: u32,
    dlines: Map[u64, u32],
    fmd: Map[u64, u32],
    paths: List[List[u8]],
    dir: List[u8],
}

// ---- text

fn w(inout e: E, s: str) { bytes.append(inout e.o, sys.lit(s)) }
fn wb(inout e: E, s: List[u8]) { bytes.append(inout e.o, s) }
fn wn(inout e: E, n: u64) { bytes.append(inout e.o, bytes.from_u64(n)) }

fn cat(a: List[u8], s: str) -> List[u8] {
    let mut o = a.copy()
    bytes.append(inout o, sys.lit(s))
    o
}

fn catb(a: List[u8], b: List[u8]) -> List[u8] {
    let mut o = a.copy()
    bytes.append(inout o, b)
    o
}

fn num(s: str, n: u64) -> List[u8] {
    let mut o = sys.lit(s)
    bytes.append(inout o, bytes.from_u64(n))
    o
}

fn pick(c: bool, a: str, b: str) -> str {
    if c { return a }
    b
}

fn h64(s: List[u8]) -> u64 {
    let mut h: u64 = 14695981039346656037
    for b in s { h = (h ^ (b as u64)) *% 1099511628211 }
    h
}

/// Begin an instruction line (in a fresh block when the last one was terminated).
fn ins(inout e: E) {
    if e.term {
        let n = e.nlbl.copy()
        e.nlbl += 1
        w(inout e, "L")
        wn(inout e, n as u64)
        w(inout e, ":\n")
        e.cur = num("%L", n as u64)
        e.term = false
    }
    w(inout e, "  ")
}

/// End an instruction line (with its source location).
fn fin(inout e: E) {
    if e.dloc > 0 {
        w(inout e, ", !dbg !")
        let d = e.dloc.copy()
        wn(inout e, d as u64)
    }
    w(inout e, "\n")
}

fn reg(inout e: E) -> List[u8] {
    let n = e.nreg
    e.nreg += 1
    num("%r", n as u64)
}

/// Make sure there is an open block (so e.cur names the block the next instruction is in).
fn live(inout e: E) {
    if e.term {
        let n = new_label(inout e)
        label(inout e, n)
    }
}

fn new_label(inout e: E) -> u32 {
    let n = e.nlbl
    e.nlbl += 1
    n
}

/// Start block L<n> (falling through to it from an unterminated block).
fn label(inout e: E, n: u32) {
    if !e.term {
        w(inout e, "  br label %L")
        wn(inout e, n as u64)
        fin(inout e)
    }
    w(inout e, "L")
    wn(inout e, n as u64)
    w(inout e, ":\n")
    e.cur = num("%L", n as u64)
    e.term = false
}

fn br(inout e: E, n: u32) {
    ins(inout e)
    w(inout e, "br label %L")
    wn(inout e, n as u64)
    fin(inout e)
    e.term = true
}

fn condbr(inout e: E, c: List[u8], t: u32, f: u32) {
    ins(inout e)
    w(inout e, "br i1 ")
    wb(inout e, c)
    w(inout e, ", label %L")
    wn(inout e, t as u64)
    w(inout e, ", label %L")
    wn(inout e, f as u64)
    fin(inout e)
    e.term = true
}

/// `<dst> = <text>` as one instruction; returns dst.
fn val(inout e: E, text: List[u8]) -> List[u8] {
    let r = reg(inout e)
    ins(inout e)
    wb(inout e, r)
    w(inout e, " = ")
    wb(inout e, text)
    fin(inout e)
    r
}

fn stmt_text(inout e: E, text: List[u8]) {
    ins(inout e)
    wb(inout e, text)
    fin(inout e)
}

fn unsupported(inout e: E, what: str) {
    if e.fail.len() == 0 { e.fail = sys.lit(what) }
}

// ---- types

fn kind(p: lower.P, ty: u32) -> u32 { types.kind(p.t, ty) }

fn is_void(ty: u32) -> bool { ty == types.UNIT || ty == types.NEVER }

fn int_ty(k: u32) -> str {
    match k {
        0 => "i32"
        1 => "i64"
        2 => "i8"
        3 => "i32"
        _ => "i64"
    }
}

fn int_bits(k: u32) -> u32 {
    match k {
        0 => 32
        1 => 64
        2 => 8
        3 => 32
        _ => 64
    }
}

/// The LLVM type of a value of type ty in memory.
fn mty(inout e: E, p: lower.P, ty: u32) -> List[u8] {
    if ty >= PTR { return sys.lit("ptr") }
    let t = types.get(p.t, ty)
    let k = t.kind
    if k == types.T_INT { return sys.lit(int_ty(t.a)) }
    if k == types.T_BOOL || k == types.T_UNIT || k == types.T_NEVER { return sys.lit("i8") }
    if k == types.T_STR { return sys.lit("ptr") }
    if k == types.T_STRING { return sys.lit("%ei.String") }
    def_ty(inout e, p, ty)
    num("%t", ty as u64)
}

/// The LLVM type of a scalar value in a register (bool: i1).
fn vty(inout e: E, p: lower.P, ty: u32) -> List[u8] {
    if ty < PTR && kind(p, ty) == types.T_BOOL { return sys.lit("i1") }
    mty(inout e, p, ty)
}

fn is_scalar(p: lower.P, ty: u32) -> bool { abi.scalar(p, ty) }

fn members(inout e: E, p: lower.P, ms: List[u32]) -> List[u8] {
    let mut o = sys.lit("{ ")
    if ms.len() == 0 { bytes.append(inout o, sys.lit("i8")) }
    for i in 0..ms.len() {
        if i > 0 { bytes.append(inout o, sys.lit(", ")) }
        bytes.append(inout o, mty(inout e, p, ms[i]))
    }
    bytes.append(inout o, sys.lit(" }"))
    o
}

fn tdef(inout e: E, name: List[u8], body: List[u8]) {
    bytes.append(inout e.tdefs, name)
    bytes.append(inout e.tdefs, sys.lit(" = type "))
    bytes.append(inout e.tdefs, body)
    e.tdefs.push(10)
}

/// Define %t<ty> (and its variant or buffer structs) once.
fn def_ty(inout e: E, p: lower.P, ty: u32) {
    if e.tdone[ty as usize] { return }
    e.tdone[ty as usize] = true
    let t = types.get(p.t, ty)
    let k = t.kind
    let name = num("%t", ty as u64)
    if k == types.T_ARRAY {
        let n: u64 = if t.b == 0 { 1 } else { t.b as u64 }
        let mut b = num("{ [", n)
        bytes.append(inout b, sys.lit(" x "))
        bytes.append(inout b, mty(inout e, p, t.a))
        bytes.append(inout b, sys.lit("] }"))
        tdef(inout e, name, b)
    } else if k == types.T_TUPLE || (k == types.T_RECORD && !lower.shared_rec(p, ty)) {
        let b = members(inout e, p, abi.parts(p, ty, NONE))
        tdef(inout e, name, b)
    } else if k == types.T_RECORD {
        let b = members(inout e, p, abi.parts(p, ty, NONE))
        tdef(inout e, cat(name, ".d"), b)
        tdef(inout e, name, sys.lit("{ ptr }"))
    } else if k == types.T_LIST {
        tdef(inout e, name, sys.lit("{ ptr, i64, i64 }"))
    } else if k == types.T_MAP {
        tdef(inout e, name, sys.lit("{ ptr, ptr, ptr, i64, i64, i64 }"))
    } else if k == types.T_FN {
        tdef(inout e, name, sys.lit("{ ptr, ptr, ptr, ptr, ptr }"))
    } else if k == types.T_ENUM {
        let d = types.def_of(p.t, ty)
        if !lower.any_payload(p, d) {
            tdef(inout e, name, sys.lit("{ i32 }"))
            return
        }
        let u = abi.union_of(inout e.lay, p, ty)
        let el = if u[1] == 1 { "i8" } else if u[1] == 2 { "i16" } else if u[1] == 4 { "i32" } else { "i64" }
        let mut b = num("{ i32, [", u[0] / u[1])
        bytes.append(inout b, sys.lit(" x "))
        bytes.append(inout b, sys.lit(el))
        bytes.append(inout b, sys.lit("] }"))
        tdef(inout e, name, b)
        for i in 0..d.len {
            if types.variant(p.t, d, i).flen == 0 { continue }
            let vb = members(inout e, p, abi.parts(p, ty, i))
            let mut vn = cat(name, ".v")
            bytes.append(inout vn, bytes.from_u64(i as u64))
            tdef(inout e, vn, vb)
        }
    } else {
        // Box, Task, Mutex, Chan, Ref: one pointer
        tdef(inout e, name, sys.lit("{ ptr }"))
    }
}

fn size(inout e: E, p: lower.P, ty: u32) -> u64 { abi.size(inout e.lay, p, ty) }
fn align(inout e: E, p: lower.P, ty: u32) -> u64 { abi.align(inout e.lay, p, ty) }

/// Whether values of ty own heap data (lower.ei's `owns`), memoized.
fn owns(inout e: E, p: lower.P, ty: u32) -> bool {
    let m = e.own[ty as usize]
    if m > 0 { return m == 2 }
    let t = types.get(p.t, ty)
    let k = t.kind
    let mut r = false
    if k == types.T_STRING || k == types.T_LIST || k == types.T_MAP || k == types.T_BOX || k == types.T_FN || types.is_handle(k) || k == types.T_REF {
        r = true
    } else if k == types.T_ARRAY {
        r = owns(inout e, p, t.a)
    } else if k == types.T_TUPLE {
        for x in types.elems(p.t, ty) {
            if owns(inout e, p, x) { r = true }
        }
    } else if k == types.T_RECORD {
        let d = types.def_of(p.t, ty)
        for j in 0..d.len {
            if owns(inout e, p, types.field(p.t, d.start, j).ty) { r = true }
        }
        if lower.shared_rec(p, ty) { r = true }
    } else if k == types.T_ENUM {
        let d = types.def_of(p.t, ty)
        for i in 0..d.len {
            let v = types.variant(p.t, d, i)
            for j in 0..v.flen {
                if owns(inout e, p, types.field(p.t, v.fstart, j).ty) { r = true }
            }
        }
    }
    let v: u8 = if r { 2 } else { 1 }
    e.own[ty as usize] = v
    r
}

/// The glue name `<op><C type name>` (lower.ei's gname).
fn gname(e: E, op: str, ty: u32) -> List[u8] { catb(sys.lit(op), e.tn[ty as usize]) }

// ---- constants

/// An integer constant of kind k as LLVM text (signed kinds as signed decimals).
fn int_text(k: u32, v: u64) -> List[u8] {
    if types.signed(k) && v >= 9223372036854775808 {
        let mut o = sys.lit("-")
        bytes.append(inout o, bytes.from_u64(0 -% v))
        return o
    }
    if k == types.IK_I32 || k == types.IK_U32 { return bytes.from_u64(v % 4294967296) }
    if k == types.IK_U8 { return bytes.from_u64(v % 256) }
    bytes.from_u64(v)
}

fn c_string(inout out: List[u8], s: List[u8]) {
    out.push(99)
    out.push(34)
    for b in s {
        if b >= 32 && b < 127 && b != 34 && b != 92 {
            out.push(b)
        } else {
            out.push(92)
            let hx = sys.lit("0123456789ABCDEF")
            out.push(hx[(b / 16) as usize])
            out.push(hx[(b % 16) as usize])
        }
    }
    bytes.append(inout out, sys.lit("\\00\""))
}

/// A private constant for a runtime message (the same text the C runtime prints).
fn msg(inout e: E, text: str) -> List[u8] {
    let s = sys.lit(text)
    let k = h64(s)
    match e.msgs.get(k) {
        Some(i) => { return num("@.m", i as u64) }
        None => {}
    }
    let i = e.nmsg
    e.nmsg += 1
    e.msgs.insert(k, i)
    let name = num("@.m", i as u64)
    bytes.append(inout e.gl, name)
    bytes.append(inout e.gl, sys.lit(" = private unnamed_addr constant ["))
    bytes.append(inout e.gl, bytes.from_u64((s.len() + 1) as u64))
    bytes.append(inout e.gl, sys.lit(" x i8] "))
    c_string(inout e.gl, s)
    e.gl.push(10)
    name
}

/// The source line for the runtime (lower.ei's put_line).
fn line_of(e: E, line: u32) -> List[u8] {
    if e.file == 0 || line >= 1048576 { return bytes.from_u64(line as u64) }
    bytes.from_u64((e.file as u64) * 1048576 + line as u64)
}

// ---- declarations and calls

fn declare(inout e: E, name: List[u8], text: List[u8]) {
    let k = h64(name)
    if e.didx.contains(k) { return }
    e.didx.insert(k, e.dnames.len() as u32)
    e.dnames.push(name)
    e.dtext.push(text)
}

fn ext_attr(p: lower.P, ty: u32) -> str {
    if ty >= PTR { return "" }
    let t = types.get(p.t, ty)
    if t.kind == types.T_BOOL || t.kind == types.T_UNIT || t.kind == types.T_NEVER || (t.kind == types.T_INT && t.a == types.IK_U8) { return " zeroext" }
    ""
}

fn coerce_ty(a: abi.Arg) -> List[u8] {
    if a.n == 1 { return num("i", a.b0 as u64) }
    let mut o = num("{ i", a.b0 as u64)
    bytes.append(inout o, sys.lit(", i"))
    bytes.append(inout o, bytes.from_u64(a.b1 as u64))
    bytes.append(inout o, sys.lit(" }"))
    o
}

fn ret_text(inout e: E, p: lower.P, s: abi.Sig) -> List[u8] {
    let r = s.ret
    if r.kind == abi.A_VOID || r.kind == abi.A_SRET { return sys.lit("void") }
    if r.kind == abi.A_DIRECT {
        let mut o = sys.lit(ext_attr(p, r.ty))
        if o.len() > 0 { o = sys.lit("zeroext ") }
        bytes.append(inout o, vty(inout e, p, r.ty))
        return o
    }
    coerce_ty(r)
}

/// The parameter types of a signature (for a declare or define; `names` names them).
fn params_text(inout e: E, p: lower.P, s: abi.Sig, names: List[List[u8]]) -> List[u8] {
    let mut o: List[u8] = List.new()
    let mut first = true
    let mut ni: usize = 0
    if s.ret.kind == abi.A_SRET {
        bytes.append(inout o, sys.lit("ptr sret("))
        bytes.append(inout o, mty(inout e, p, s.ret.ty))
        bytes.append(inout o, sys.lit(") align "))
        bytes.append(inout o, bytes.from_u64(align(inout e, p, s.ret.ty)))
        if names.len() > 0 {
            bytes.append(inout o, sys.lit(" "))
            bytes.append(inout o, names[ni])
            ni += 1
        }
        first = false
    }
    for a in s.args {
        if a.kind == abi.A_DIRECT {
            if !first { bytes.append(inout o, sys.lit(", ")) }
            first = false
            bytes.append(inout o, vty(inout e, p, a.ty))
            bytes.append(inout o, sys.lit(ext_attr(p, a.ty)))
            if names.len() > 0 {
                bytes.append(inout o, sys.lit(" "))
                bytes.append(inout o, names[ni])
                ni += 1
            }
        } else if a.kind == abi.A_COERCE {
            for i in 0..a.n {
                if !first { bytes.append(inout o, sys.lit(", ")) }
                first = false
                let bits = if i == 0 { a.b0 } else { a.b1 }
                bytes.append(inout o, num("i", bits as u64))
                if names.len() > 0 {
                    bytes.append(inout o, sys.lit(" "))
                    bytes.append(inout o, names[ni])
                    ni += 1
                }
            }
        } else {
            if !first { bytes.append(inout o, sys.lit(", ")) }
            first = false
            bytes.append(inout o, sys.lit("ptr byval("))
            bytes.append(inout o, mty(inout e, p, a.ty))
            bytes.append(inout o, sys.lit(") align 8"))
            if names.len() > 0 {
                bytes.append(inout o, sys.lit(" "))
                bytes.append(inout o, names[ni])
                ni += 1
            }
        }
    }
    o
}

fn declare_sig(inout e: E, p: lower.P, name: List[u8], s: abi.Sig, noreturn: bool) {
    if e.didx.contains(h64(name)) { return }
    let mut d = sys.lit("declare ")
    bytes.append(inout d, ret_text(inout e, p, s))
    bytes.append(inout d, sys.lit(" @"))
    bytes.append(inout d, name)
    bytes.append(inout d, sys.lit("("))
    let none: List[List[u8]] = List.new()
    bytes.append(inout d, params_text(inout e, p, s, none))
    bytes.append(inout d, sys.lit(")"))
    if noreturn { bytes.append(inout d, sys.lit(" noreturn")) }
    declare(inout e, name, d)
}

/// Load `bits` bits at byte offset `off` of address a.
fn load_piece(inout e: E, a: List[u8], off: u64, bits: u32) -> List[u8] {
    let mut at = a.copy()
    if off > 0 {
        let mut g = sys.lit("getelementptr i8, ptr ")
        bytes.append(inout g, a)
        bytes.append(inout g, sys.lit(", i64 "))
        bytes.append(inout g, bytes.from_u64(off))
        at = val(inout e, g)
    }
    let mut t = num("load i", bits as u64)
    bytes.append(inout t, sys.lit(", ptr "))
    bytes.append(inout t, at)
    val(inout e, t)
}

fn store_piece(inout e: E, v: List[u8], a: List[u8], off: u64, bits: u32) {
    let mut at = a.copy()
    if off > 0 {
        let mut g = sys.lit("getelementptr i8, ptr ")
        bytes.append(inout g, a)
        bytes.append(inout g, sys.lit(", i64 "))
        bytes.append(inout g, bytes.from_u64(off))
        at = val(inout e, g)
    }
    let mut t = num("store i", bits as u64)
    bytes.append(inout t, sys.lit(" "))
    bytes.append(inout t, v)
    bytes.append(inout t, sys.lit(", ptr "))
    bytes.append(inout t, at)
    stmt_text(inout e, t)
}

/// Call `name` (signature ptys -> ret, the C ABI) with args: a scalar's value (bool as i1),
/// or an aggregate's address. An aggregate result is written to `dst` (an address; a fresh
/// temporary when empty); a scalar result is returned.
fn call(inout e: E, p: lower.P, name: List[u8], ptys: List[u32], args: List[List[u8]], ret: u32, dst: List[u8]) -> List[u8] {
    let s = abi.sig(inout e.lay, p, ptys, ret)
    declare_sig(inout e, p, name, s, false)
    call_sig(inout e, p, catb(sys.lit("@"), name), s, args, dst)
}

fn call_sig(inout e: E, p: lower.P, callee: List[u8], s: abi.Sig, args: List[List[u8]], dst: List[u8]) -> List[u8] {
    let mut d = dst.copy()
    if (s.ret.kind == abi.A_SRET || s.ret.kind == abi.A_COERCE) && d.len() == 0 { d = temp(inout e, p, s.ret.ty) }
    let mut parts: List[List[u8]] = List.new()
    if s.ret.kind == abi.A_SRET {
        let mut x = sys.lit("ptr sret(")
        bytes.append(inout x, mty(inout e, p, s.ret.ty))
        bytes.append(inout x, sys.lit(") align "))
        bytes.append(inout x, bytes.from_u64(align(inout e, p, s.ret.ty)))
        bytes.append(inout x, sys.lit(" "))
        bytes.append(inout x, d)
        parts.push(x)
    }
    for i in 0..s.args.len() {
        let a = s.args[i]
        if a.kind == abi.A_DIRECT {
            let mut x = vty(inout e, p, a.ty)
            bytes.append(inout x, sys.lit(ext_attr(p, a.ty)))
            bytes.append(inout x, sys.lit(" "))
            bytes.append(inout x, args[i])
            parts.push(x)
        } else if a.kind == abi.A_COERCE {
            let v0 = load_piece(inout e, args[i], 0, a.b0)
            parts.push(catb(num("i", a.b0 as u64), catb(sys.lit(" "), v0)))
            if a.n > 1 {
                let v1 = load_piece(inout e, args[i], 8, a.b1)
                parts.push(catb(num("i", a.b1 as u64), catb(sys.lit(" "), v1)))
            }
        } else {
            let mut x = sys.lit("ptr byval(")
            bytes.append(inout x, mty(inout e, p, a.ty))
            bytes.append(inout x, sys.lit(") align 8 "))
            bytes.append(inout x, args[i])
            parts.push(x)
        }
    }
    let mut t = sys.lit("call ")
    bytes.append(inout t, ret_text(inout e, p, s))
    bytes.append(inout t, sys.lit(" "))
    bytes.append(inout t, callee)
    bytes.append(inout t, sys.lit("("))
    bytes.append(inout t, bytes.join(parts, sys.lit(", ")))
    bytes.append(inout t, sys.lit(")"))
    if s.ret.kind == abi.A_DIRECT { return val(inout e, t) }
    if s.ret.kind == abi.A_COERCE {
        let r = val(inout e, t)
        if s.ret.n == 1 {
            store_piece(inout e, r, d, 0, s.ret.b0)
        } else {
            let mut x0 = sys.lit("extractvalue ")
            bytes.append(inout x0, coerce_ty(s.ret))
            bytes.append(inout x0, sys.lit(" "))
            bytes.append(inout x0, r)
            let v0 = val(inout e, cat(x0, ", 0"))
            let v1 = val(inout e, cat(x0, ", 1"))
            store_piece(inout e, v0, d, 0, s.ret.b0)
            store_piece(inout e, v1, d, 8, s.ret.b1)
        }
        return List.new()
    }
    stmt_text(inout e, t)
    List.new()
}

/// A fresh temporary of type ty in the entry block; returns its address.
fn temp(inout e: E, p: lower.P, ty: u32) -> List[u8] {
    let r = reg(inout e)
    bytes.append(inout e.ent, sys.lit("  "))
    bytes.append(inout e.ent, r)
    bytes.append(inout e.ent, sys.lit(" = alloca "))
    let mt = mty(inout e, p, ty)
    let al = align(inout e, p, ty)
    bytes.append(inout e.ent, mt)
    bytes.append(inout e.ent, sys.lit(", align "))
    bytes.append(inout e.ent, bytes.from_u64(al))
    e.ent.push(10)
    r
}

fn rt_call(inout e: E, p: lower.P, name: str, ptys: List[u32], args: List[List[u8]], ret: u32) -> List[u8] {
    let none: List[u8] = List.new()
    call(inout e, p, sys.lit(name), ptys, args, ret, none)
}

fn tys1(a: u32) -> List[u32] {
    let mut o: List[u32] = List.new()
    o.push(a)
    o
}

fn tys2(a: u32, b: u32) -> List[u32] {
    let mut o = tys1(a)
    o.push(b)
    o
}

fn tys3(a: u32, b: u32, c: u32) -> List[u32] {
    let mut o = tys2(a, b)
    o.push(c)
    o
}

fn args1(a: List[u8]) -> List[List[u8]] {
    let mut o: List[List[u8]] = List.new()
    o.push(a)
    o
}

fn args2(a: List[u8], b: List[u8]) -> List[List[u8]] {
    let mut o = args1(a)
    o.push(b)
    o
}

fn args3(a: List[u8], b: List[u8], c: List[u8]) -> List[List[u8]] {
    let mut o = args2(a, b)
    o.push(c)
    o
}

/// Trap with a runtime message when i1 `c` holds: `br c, trap, ok`.
fn trap_if(inout e: E, c: List[u8], text: str, line: u32) {
    let t = new_label(inout e)
    let ok = new_label(inout e)
    condbr(inout e, c, t, ok)
    label(inout e, t)
    let m = msg(inout e, text)
    trap_with(inout e, m, line)
    label(inout e, ok)
}

/// `call ei_trap(m, line); unreachable` (m: a pointer value).
fn trap_with(inout e: E, m: List[u8], line: u32) {
    declare(inout e, sys.lit("ei_trap"), sys.lit("declare void @ei_trap(ptr, i32) noreturn"))
    let mut t = sys.lit("call void @ei_trap(ptr ")
    bytes.append(inout t, m)
    bytes.append(inout t, sys.lit(", i32 "))
    bytes.append(inout t, line_of(e, line))
    bytes.append(inout t, sys.lit(")"))
    stmt_text(inout e, t)
    stmt_text(inout e, sys.lit("unreachable"))
    e.term = true
}

// ---- memory

fn load(inout e: E, p: lower.P, ty: u32, a: List[u8]) -> List[u8] {
    let mut t = sys.lit("load ")
    bytes.append(inout t, mty(inout e, p, ty))
    bytes.append(inout t, sys.lit(", ptr "))
    bytes.append(inout t, a)
    let r = val(inout e, t)
    if ty < PTR && kind(p, ty) == types.T_BOOL {
        return val(inout e, catb(sys.lit("trunc i8 "), cat(r, " to i1")))
    }
    r
}

fn store(inout e: E, p: lower.P, ty: u32, v: List[u8], a: List[u8]) {
    let mut x = v.copy()
    if ty < PTR && kind(p, ty) == types.T_BOOL {
        x = val(inout e, catb(sys.lit("zext i1 "), cat(v, " to i8")))
    }
    let mut t = sys.lit("store ")
    bytes.append(inout t, mty(inout e, p, ty))
    bytes.append(inout t, sys.lit(" "))
    bytes.append(inout t, x)
    bytes.append(inout t, sys.lit(", ptr "))
    bytes.append(inout t, a)
    stmt_text(inout e, t)
}

fn memcpy(inout e: E, p: lower.P, ty: u32, dst: List[u8], src: List[u8]) {
    declare(inout e, sys.lit("llvm.memcpy.p0.p0.i64"), sys.lit("declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)"))
    let mut t = sys.lit("call void @llvm.memcpy.p0.p0.i64(ptr ")
    bytes.append(inout t, dst)
    bytes.append(inout t, sys.lit(", ptr "))
    bytes.append(inout t, src)
    bytes.append(inout t, sys.lit(", i64 "))
    bytes.append(inout t, bytes.from_u64(size(inout e, p, ty)))
    bytes.append(inout t, sys.lit(", i1 false)"))
    stmt_text(inout e, t)
}

fn zero(inout e: E, p: lower.P, ty: u32, a: List[u8]) {
    if is_scalar(p, ty) {
        let z = if ty < PTR && kind(p, ty) == types.T_STR { "null" } else if ty < PTR && kind(p, ty) == types.T_BOOL { "false" } else { "0" }
        store(inout e, p, ty, sys.lit(z), a)
        return
    }
    declare(inout e, sys.lit("llvm.memset.p0.i64"), sys.lit("declare void @llvm.memset.p0.i64(ptr, i8, i64, i1)"))
    let mut t = sys.lit("call void @llvm.memset.p0.i64(ptr ")
    bytes.append(inout t, a)
    bytes.append(inout t, sys.lit(", i8 0, i64 "))
    bytes.append(inout t, bytes.from_u64(size(inout e, p, ty)))
    bytes.append(inout t, sys.lit(", i1 false)"))
    stmt_text(inout e, t)
}

/// Copy a value of type ty from address src to address dst.
fn copy_mem(inout e: E, p: lower.P, ty: u32, dst: List[u8], src: List[u8]) {
    if is_scalar(p, ty) {
        let v = load(inout e, p, ty, src)
        store(inout e, p, ty, v, dst)
    } else {
        memcpy(inout e, p, ty, dst, src)
    }
}

/// The address of member i of the struct %t<ty> (or a variant/buffer struct named by sfx).
fn gep(inout e: E, p: lower.P, sty: List[u8], a: List[u8], i: u32) -> List[u8] {
    let mut t = sys.lit("getelementptr ")
    bytes.append(inout t, sty)
    bytes.append(inout t, sys.lit(", ptr "))
    bytes.append(inout t, a)
    bytes.append(inout t, sys.lit(", i32 0, i32 "))
    bytes.append(inout t, bytes.from_u64(i as u64))
    val(inout e, t)
}

fn field_addr(inout e: E, p: lower.P, ty: u32, a: List[u8], i: u32) -> List[u8] {
    let st = mty(inout e, p, ty)
    gep(inout e, p, st, a, i)
}

/// A pointer member i of the aggregate at a, loaded.
fn load_ptr_field(inout e: E, p: lower.P, ty: u32, a: List[u8], i: u32) -> List[u8] {
    let f = field_addr(inout e, p, ty, a, i)
    val(inout e, catb(sys.lit("load ptr, ptr "), f))
}

fn load_i64_field(inout e: E, p: lower.P, ty: u32, a: List[u8], i: u32) -> List[u8] {
    let f = field_addr(inout e, p, ty, a, i)
    val(inout e, catb(sys.lit("load i64, ptr "), f))
}

/// The address of variant v's field f of the enum at a.
fn payload_addr(inout e: E, p: lower.P, ty: u32, a: List[u8], v: u32, f: u32) -> List[u8] {
    let u = field_addr(inout e, p, ty, a, 1)
    let mut vn = num("%t", ty as u64)
    bytes.append(inout vn, sys.lit(".v"))
    bytes.append(inout vn, bytes.from_u64(v as u64))
    gep(inout e, p, vn, u, f)
}

// ---- locals, operands, places

fn loc(p: lower.P, e: E, l: u32) -> ir.Local { p.ir.locals[(e.lbase + l) as usize] }

fn laddr(l: u32) -> List[u8] { num("%l", l as u64) }

/// A scalar operand's value (bool: i1; () : 0).
fn opv(inout e: E, p: lower.P, id: u32) -> List[u8] {
    let x = p.ir.ops[id as usize]
    if x.kind == ir.O_INT { return int_text(types.ik(p.t, x.ty), x.v) }
    if x.kind == ir.O_BOOL {
        if x.v == 1 { return sys.lit("true") }
        return sys.lit("false")
    }
    if x.kind == ir.O_STR {
        e.sused[x.a as usize] = true
        return num("@.s", x.a as u64)
    }
    if x.kind == ir.O_UNIT { return sys.lit("0") }
    let lt = loc(p, e, x.a).ty
    if is_void(lt) { return sys.lit("0") }
    load(inout e, p, lt, laddr(x.a))
}

/// An aggregate operand's address (it is always a local).
fn opa(inout e: E, p: lower.P, id: u32) -> List[u8] {
    let x = p.ir.ops[id as usize]
    if x.kind != ir.O_LOCAL {
        unsupported(inout e, "an aggregate constant")
        return sys.lit("null")
    }
    laddr(x.a)
}

/// An operand as a call argument of its own type: its value if scalar, else its address.
fn oparg(inout e: E, p: lower.P, id: u32) -> List[u8] {
    if is_scalar(p, ir.op_ty(p.ir, id)) { return opv(inout e, p, id) }
    opa(inout e, p, id)
}

/// Store operand id (of type ty) at address a.
fn put_op(inout e: E, p: lower.P, ty: u32, id: u32, a: List[u8]) {
    if is_scalar(p, ty) {
        let v = opv(inout e, p, id)
        store(inout e, p, ty, v, a)
    } else {
        let s = opa(inout e, p, id)
        memcpy(inout e, p, ty, a, s)
    }
}

/// An index operand widened to i64 (index operands are usize; others are converted as C's
/// `(uint64_t)` cast would).
fn idx64(inout e: E, p: lower.P, id: u32) -> List[u8] {
    let ty = ir.op_ty(p.ir, id)
    let v = opv(inout e, p, id)
    let k = types.ik(p.t, ty)
    if int_bits(k) == 64 { return v }
    let op = if types.signed(k) { "sext " } else { "zext " }
    let mut t = sys.lit(op)
    bytes.append(inout t, sys.lit(int_ty(k)))
    bytes.append(inout t, sys.lit(" "))
    bytes.append(inout t, v)
    bytes.append(inout t, sys.lit(" to i64"))
    val(inout e, t)
}

/// The address of a place (its indices are checked already).
fn paddr(inout e: E, p: lower.P, id: u32) -> List[u8] {
    let x = p.ir.places[id as usize]
    if x.kind == ir.P_LOCAL { return laddr(x.a) }
    let bty = p.ir.places[x.a as usize].ty
    let b = paddr(inout e, p, x.a)
    if x.kind == ir.P_FIELD {
        if lower.shared_rec(p, bty) {
            let q = load_ptr_field(inout e, p, bty, b, 0)
            return gep(inout e, p, cat(num("%t", bty as u64), ".d"), q, x.b)
        }
        return field_addr(inout e, p, bty, b, x.b)
    }
    if x.kind == ir.P_INDEX {
        let i = idx64(inout e, p, x.b)
        let et = types.get(p.t, bty).a
        if kind(p, bty) == types.T_LIST {
            let d = load_ptr_field(inout e, p, bty, b, 0)
            let mut t = sys.lit("getelementptr ")
            bytes.append(inout t, mty(inout e, p, et))
            bytes.append(inout t, sys.lit(", ptr "))
            bytes.append(inout t, d)
            bytes.append(inout t, sys.lit(", i64 "))
            bytes.append(inout t, i)
            return val(inout e, t)
        }
        let mut t = sys.lit("getelementptr ")
        bytes.append(inout t, mty(inout e, p, bty))
        bytes.append(inout t, sys.lit(", ptr "))
        bytes.append(inout t, b)
        bytes.append(inout t, sys.lit(", i32 0, i32 0, i64 "))
        bytes.append(inout t, i)
        return val(inout e, t)
    }
    if x.kind == ir.P_PAYLOAD { return payload_addr(inout e, p, bty, b, x.b, x.c) }
    load_ptr_field(inout e, p, bty, b, 0)
}

/// Bounds checks of every index in place id, outermost first (lower.ei's `checks`).
fn checks(inout e: E, p: lower.P, id: u32) {
    let x = p.ir.places[id as usize]
    if x.kind == ir.P_LOCAL { return }
    checks(inout e, p, x.a)
    if x.kind != ir.P_INDEX { return }
    let i = idx64(inout e, p, x.b)
    let bty = p.ir.places[x.a as usize].ty
    let bt = types.get(p.t, bty)
    let mut n = bytes.from_u64(bt.b as u64)
    if bt.kind == types.T_LIST {
        let b = paddr(inout e, p, x.a)
        n = load_i64_field(inout e, p, bty, b, 1)
    }
    let mut c = sys.lit("icmp uge i64 ")
    bytes.append(inout c, i)
    bytes.append(inout c, sys.lit(", "))
    bytes.append(inout c, n)
    let r = val(inout e, c)
    trap_if(inout e, r, "index out of bounds", x.line)
}

/// `uniq_` (or ei_str_unique) of the value of type ty at address a (lower.ei's uniq_call).
fn uniq_call(inout e: E, p: lower.P, ty: u32, a: List[u8]) {
    let k = kind(p, ty)
    let none: List[u8] = List.new()
    if k == types.T_STRING {
        call(inout e, p, sys.lit("ei_str_unique"), tys1(PTR + ty), args1(a), types.UNIT, none)
    } else if k == types.T_LIST || k == types.T_MAP || k == types.T_BOX || lower.shared_rec(p, ty) {
        let gn_ = gname(e, "uniq_", ty)
        call(inout e, p, gn_, tys1(PTR + ty), args1(a), types.UNIT, none)
    }
}

/// Copy-on-write before a write into place id (lower.ei's `uniqs`).
fn uniqs(inout e: E, p: lower.P, id: u32) {
    let x = p.ir.places[id as usize]
    if x.kind == ir.P_LOCAL { return }
    uniqs(inout e, p, x.a)
    let bty = p.ir.places[x.a as usize].ty
    if x.kind == ir.P_DEREF || (x.kind == ir.P_INDEX && kind(p, bty) == types.T_LIST) || (x.kind == ir.P_FIELD && lower.shared_rec(p, bty)) {
        let b = paddr(inout e, p, x.a)
        uniq_call(inout e, p, bty, b)
    }
}

fn barg(p: lower.P, s: ir.Stmt, i: u32) -> u32 { p.ir.extra[(s.b + i) as usize] }

fn arg_ty(p: lower.P, a: u32) -> u32 {
    if a >= ir.ARG_PLACE { return p.ir.places[(a - ir.ARG_PLACE) as usize].ty }
    ir.op_ty(p.ir, a)
}

/// A builtin or call argument by value: a scalar's value, else an address (a place's or an
/// operand's).
fn argval(inout e: E, p: lower.P, a: u32) -> List[u8] {
    let ty = arg_ty(p, a)
    if a >= ir.ARG_PLACE {
        let ad = paddr(inout e, p, a - ir.ARG_PLACE)
        if is_scalar(p, ty) {
            if is_void(ty) { return sys.lit("0") }
            return load(inout e, p, ty, ad)
        }
        return ad
    }
    oparg(inout e, p, a)
}

/// A builtin argument's address (`&arg`).
fn argptr(inout e: E, p: lower.P, a: u32) -> List[u8] {
    if a >= ir.ARG_PLACE { return paddr(inout e, p, a - ir.ARG_PLACE) }
    let x = p.ir.ops[a as usize]
    if x.kind == ir.O_LOCAL { return laddr(x.a) }
    // a constant's address: a temporary holding it
    let ty = ir.op_ty(p.ir, a)
    let t = temp(inout e, p, ty)
    put_op(inout e, p, ty, a, t)
    t
}

// ---- glue calls (lower.ei's drop_call, clone_expr, eq_expr, cmp_expr, hash_text, show_into)

fn drop_at(inout e: E, p: lower.P, ty: u32, a: List[u8]) {
    if !owns(inout e, p, ty) { return }
    let none: List[u8] = List.new()
    if kind(p, ty) == types.T_STRING {
        call(inout e, p, sys.lit("ei_drop_String"), tys1(PTR + ty), args1(a), types.UNIT, none)
    } else {
        let gn_ = gname(e, "drop_", ty)
        call(inout e, p, gn_, tys1(PTR + ty), args1(a), types.UNIT, none)
    }
}

/// A deep copy (clone) of the value at src written to dst.
fn clone_to(inout e: E, p: lower.P, ty: u32, src: List[u8], dst: List[u8]) {
    if !owns(inout e, p, ty) {
        copy_mem(inout e, p, ty, dst, src)
        return
    }
    if kind(p, ty) == types.T_STRING {
        call(inout e, p, sys.lit("ei_share_String"), tys1(PTR + ty), args1(src), ty, dst)
    } else {
        let gn_ = gname(e, "clone_", ty)
        call(inout e, p, gn_, tys1(PTR + ty), args1(src), ty, dst)
    }
}

fn copy_to(inout e: E, p: lower.P, ty: u32, src: List[u8], dst: List[u8]) {
    let mut seen: Map[u32, bool] = Map.new()
    if !lower.deep(p, ty, inout seen) {
        clone_to(inout e, p, ty, src, dst)
        return
    }
    let gn_ = gname(e, "copy_", ty)
    call(inout e, p, gn_, tys1(PTR + ty), args1(src), ty, dst)
}

fn str_ptr(inout e: E, p: lower.P, ty: u32, v: List[u8]) -> List[u8] {
    if kind(p, ty) == types.T_STRING { return load_ptr_field(inout e, p, ty, v, 0) }
    v
}

fn strcmp(inout e: E, p: lower.P, ty: u32, a: List[u8], b: List[u8]) -> List[u8] {
    let x = str_ptr(inout e, p, ty, a)
    let y = str_ptr(inout e, p, ty, b)
    rt_call(inout e, p, "strcmp", tys2(types.STR, types.STR), args2(x, y), types.I32)
}

/// `a == b` as i1 for values (scalar values or aggregate addresses) of type ty.
fn eq_val(inout e: E, p: lower.P, ty: u32, a: List[u8], b: List[u8]) -> List[u8] {
    let k = kind(p, ty)
    if k == types.T_STR || k == types.T_STRING {
        let c = strcmp(inout e, p, ty, a, b)
        return val(inout e, catb(sys.lit("icmp eq i32 "), cat(c, ", 0")))
    }
    if lower.is_struct_kind(k) {
        let gn_ = gname(e, "eq_", ty)
        return rt_call_b(inout e, p, gn_, tys2(ty, ty), args2(a, b), types.BOOL)
    }
    if k == types.T_UNIT || k == types.T_NEVER { return sys.lit("true") }
    let mut t = sys.lit("icmp eq ")
    bytes.append(inout t, vty(inout e, p, ty))
    bytes.append(inout t, sys.lit(" "))
    bytes.append(inout t, a)
    bytes.append(inout t, sys.lit(", "))
    bytes.append(inout t, b)
    val(inout e, t)
}

fn rt_call_b(inout e: E, p: lower.P, name: List[u8], ptys: List[u32], args: List[List[u8]], ret: u32) -> List[u8] {
    let none: List[u8] = List.new()
    call(inout e, p, name, ptys, args, ret, none)
}

/// The order of a and b as an i32 whose sign is the order (lower.ei's cmp_expr).
fn cmp_val(inout e: E, p: lower.P, ty: u32, a: List[u8], b: List[u8]) -> List[u8] {
    let k = kind(p, ty)
    if k == types.T_STR || k == types.T_STRING { return strcmp(inout e, p, ty, a, b) }
    let gn_ = gname(e, "cmp_", ty)
    if lower.is_struct_kind(k) { return rt_call_b(inout e, p, gn_, tys2(ty, ty), args2(a, b), types.I32) }
    if k == types.T_UNIT || k == types.T_NEVER { return sys.lit("0") }
    let vt = vty(inout e, p, ty)
    let sg = k == types.T_INT && types.signed(types.ik(p.t, ty))
    let gt = icmp(inout e, pick(sg, "sgt", "ugt"), vt, a, b)
    let lt = icmp(inout e, pick(sg, "slt", "ult"), vt, a, b)
    let g32 = val(inout e, catb(sys.lit("zext i1 "), cat(gt, " to i32")))
    let l32 = val(inout e, catb(sys.lit("zext i1 "), cat(lt, " to i32")))
    val(inout e, catb(sys.lit("sub i32 "), catb(g32, catb(sys.lit(", "), l32))))
}

fn icmp(inout e: E, op: str, t: List[u8], a: List[u8], b: List[u8]) -> List[u8] {
    let mut x = sys.lit("icmp ")
    bytes.append(inout x, sys.lit(op))
    bytes.append(inout x, sys.lit(" "))
    bytes.append(inout x, t)
    bytes.append(inout x, sys.lit(" "))
    bytes.append(inout x, a)
    bytes.append(inout x, sys.lit(", "))
    bytes.append(inout x, b)
    val(inout e, x)
}

/// ei_hash_u64 inline (core/eider_rt.h).
fn mix64(inout e: E, x: List[u8]) -> List[u8] {
    let mut v = x.copy()
    for i in 0..3 {
        let s = val(inout e, catb(sys.lit("lshr i64 "), cat(v, ", 33")))
        v = val(inout e, catb(sys.lit("xor i64 "), catb(v, catb(sys.lit(", "), s))))
        if i == 0 { v = val(inout e, catb(sys.lit("mul i64 "), cat(v, ", -49064778989728563"))) }
        if i == 1 { v = val(inout e, catb(sys.lit("mul i64 "), cat(v, ", -4265267296055464877"))) }
    }
    v
}

/// The hash of a value of type ty as i64 (lower.ei's hash_text).
fn hash_val(inout e: E, p: lower.P, ty: u32, v: List[u8]) -> List[u8] {
    let k = kind(p, ty)
    if k == types.T_STRING || k == types.T_STR {
        let s = str_ptr(inout e, p, ty, v)
        return rt_call(inout e, p, "ei_hash_str", tys1(types.STR), args1(s), types.U64)
    }
    let gn_ = gname(e, "hash_", ty)
    if lower.is_struct_kind(k) { return rt_call_b(inout e, p, gn_, tys1(ty), args1(v), types.U64) }
    // (uint64_t)(v): integers widen by their signedness, bool and () are 0 or 1
    let mut x = v.copy()
    if k == types.T_UNIT || k == types.T_NEVER {
        x = sys.lit("0")
    } else if k == types.T_BOOL {
        x = val(inout e, catb(sys.lit("zext i1 "), cat(v, " to i64")))
    } else {
        let ik = types.ik(p.t, ty)
        if int_bits(ik) < 64 {
            let op = if types.signed(ik) { "sext " } else { "zext " }
            x = val(inout e, catb(sys.lit(op), catb(sys.lit(int_ty(ik)), catb(sys.lit(" "), cat(v, " to i64")))))
        }
    }
    mix64(inout e, x)
}

/// Append the text of value v (of type ty) to the String at address o (lower.ei's show_into).
fn show_into(inout e: E, p: lower.P, ty: u32, o: List[u8], v: List[u8]) {
    let t = types.get(p.t, ty)
    let k = t.kind
    let none: List[u8] = List.new()
    let sp = PTR + types.STRING
    if k == types.T_UNIT {
        let m = msg(inout e, "()")
        call(inout e, p, sys.lit("ei_str_push"), tys2(sp, types.STR), args2(o, m), types.UNIT, none)
    } else if k == types.T_INT {
        let x = if int_bits(t.a) == 64 { v.copy() } else if types.signed(t.a) { val(inout e, catb(sys.lit("sext "), catb(sys.lit(int_ty(t.a)), catb(sys.lit(" "), cat(v, " to i64"))))) } else { val(inout e, catb(sys.lit("zext "), catb(sys.lit(int_ty(t.a)), catb(sys.lit(" "), cat(v, " to i64"))))) }
        if types.signed(t.a) {
            call(inout e, p, sys.lit("showi_"), tys2(sp, types.I64), args2(o, x), types.UNIT, none)
        } else {
            call(inout e, p, sys.lit("showu_"), tys2(sp, types.U64), args2(o, x), types.UNIT, none)
        }
    } else if k == types.T_BOOL {
        let tr = msg(inout e, "true")
        let fa = msg(inout e, "false")
        let mut sel = sys.lit("select i1 ")
        bytes.append(inout sel, v)
        bytes.append(inout sel, sys.lit(", ptr "))
        bytes.append(inout sel, tr)
        bytes.append(inout sel, sys.lit(", ptr "))
        bytes.append(inout sel, fa)
        let s = val(inout e, sel)
        call(inout e, p, sys.lit("ei_str_push"), tys2(sp, types.STR), args2(o, s), types.UNIT, none)
    } else if k == types.T_STR {
        call(inout e, p, sys.lit("ei_str_push"), tys2(sp, types.STR), args2(o, v), types.UNIT, none)
    } else if k == types.T_STRING {
        let q = load_ptr_field(inout e, p, ty, v, 0)
        let n = load_i64_field(inout e, p, ty, v, 1)
        call(inout e, p, sys.lit("ei_str_cat"), tys3(sp, types.STR, types.U64), args3(o, q, n), types.UNIT, none)
    } else if lower.plain_show(p, ty) {
        let tag = load_tag(inout e, p, ty, v)
        let gn_ = gname(e, "name_", ty)
        let nm = rt_call_b(inout e, p, gn_, tys1(types.U32), args1(tag), types.STR)
        call(inout e, p, sys.lit("ei_str_push"), tys2(sp, types.STR), args2(o, nm), types.UNIT, none)
    } else {
        let gn_ = gname(e, "show_", ty)
        call(inout e, p, gn_, tys2(sp, ty), args2(o, v), types.UNIT, none)
    }
}

fn load_tag(inout e: E, p: lower.P, ty: u32, a: List[u8]) -> List[u8] {
    let f = field_addr(inout e, p, ty, a, 0)
    val(inout e, catb(sys.lit("load i32, ptr "), f))
}

fn store_tag(inout e: E, p: lower.P, ty: u32, a: List[u8], tag: u32) {
    let f = field_addr(inout e, p, ty, a, 0)
    let mut t = num("store i32 ", tag as u64)
    bytes.append(inout t, sys.lit(", ptr "))
    bytes.append(inout t, f)
    stmt_text(inout e, t)
}

// ---- statements

fn block(inout e: E, p: lower.P, b: u32) {
    let bl = p.ir.blocks[b as usize]
    for i in 0..bl.len {
        if e.fail.len() > 0 { return }
        stmt(inout e, p, p.ir.extra[(bl.start + i) as usize])
    }
}

fn set_line(inout e: E, line: u32) {
    if !e.dbg || line == 0 { return }
    let k = line as u64
    match e.dlines.get(k) {
        Some(m) => {
            e.dloc = m
            return
        }
        None => {}
    }
    let id = e.nmd.copy()
    e.nmd += 1
    bytes.append(inout e.md, num("!", id as u64))
    bytes.append(inout e.md, sys.lit(" = !DILocation(line: "))
    bytes.append(inout e.md, bytes.from_u64(k))
    bytes.append(inout e.md, sys.lit(", scope: !"))
    let sp = e.sp.copy()
    bytes.append(inout e.md, bytes.from_u64(sp as u64))
    bytes.append(inout e.md, sys.lit(")\n"))
    e.dlines.insert(k, id)
    e.dloc = id
}

fn dst_addr(l: u32) -> List[u8] { laddr(l) }

fn stmt(inout e: E, p: lower.P, id: u32) {
    let s = p.ir.stmts[id as usize]
    let k = s.kind
    set_line(inout e, s.line)
    if k == ir.S_IF {
        let c = opv(inout e, p, s.a)
        let lt = new_label(inout e)
        let lf = new_label(inout e)
        let lj = new_label(inout e)
        condbr(inout e, c, lt, lf)
        label(inout e, lt)
        block(inout e, p, s.b)
        if !e.term { br(inout e, lj) }
        label(inout e, lf)
        block(inout e, p, s.c)
        label(inout e, lj)
        return
    }
    if k == ir.S_LOOP {
        let lh = new_label(inout e)
        let ls = new_label(inout e)
        let lx = new_label(inout e)
        label(inout e, lh)
        e.loops.push(ls)
        e.brks.push(lx)
        block(inout e, p, s.a)
        label(inout e, ls)
        block(inout e, p, s.b)
        if !e.term { br(inout e, lh) }
        e.loops.pop()
        e.brks.pop()
        e.term = true
        label(inout e, lx)
        return
    }
    let copies = k == ir.S_COPY || k == ir.S_READ || k == ir.S_MOVE || k == ir.S_CLONE
    if copies && is_void(loc(p, e, s.dst).ty) { return }
    if k == ir.S_DROP && !owns(inout e, p, s.ty) { return }
    if k == ir.S_READ || k == ir.S_STORE || k == ir.S_TAG || k == ir.S_MOVE || k == ir.S_DROP { checks(inout e, p, s.a) }
    if k == ir.S_CHECK {
        checks(inout e, p, s.a)
        return
    }
    if k == ir.S_CALL || k == ir.S_BUILTIN {
        for i in 0..s.c {
            let a = p.ir.extra[(s.b + i) as usize]
            if a >= ir.ARG_PLACE { checks(inout e, p, a - ir.ARG_PLACE) }
        }
    }
    if k == ir.S_STORE || k == ir.S_MOVE || k == ir.S_DROP { uniqs(inout e, p, s.a) }
    if k == ir.S_CALL || k == ir.S_CALLV {
        for i in 0..s.c {
            let a = p.ir.extra[(s.b + i) as usize]
            if a >= ir.ARG_PLACE { uniqs(inout e, p, a - ir.ARG_PLACE) }
        }
    }
    if k == ir.S_BUILTIN && mutates(s.a) && s.c > 0 {
        let a = p.ir.extra[s.b as usize]
        if a >= ir.ARG_PLACE { uniqs(inout e, p, a - ir.ARG_PLACE) }
    }
    if k == ir.S_COPY {
        let dt = loc(p, e, s.dst).ty
        put_op(inout e, p, dt, s.a, dst_addr(s.dst))
    } else if k == ir.S_READ || k == ir.S_MOVE {
        let a = paddr(inout e, p, s.a)
        let dt = loc(p, e, s.dst).ty
        copy_mem(inout e, p, dt, dst_addr(s.dst), a)
    } else if k == ir.S_STORE {
        let pl = p.ir.places[s.a as usize]
        if pl.kind == ir.P_LOCAL && is_void(loc(p, e, pl.a).ty) { return }
        let a = paddr(inout e, p, s.a)
        if is_void(pl.ty) {
            store(inout e, p, pl.ty, sys.lit("0"), a)
        } else {
            put_op(inout e, p, pl.ty, s.b, a)
        }
    } else if k == ir.S_CLONE {
        let ty = ir.op_ty(p.ir, s.a)
        if owns(inout e, p, ty) {
            let src = opa(inout e, p, s.a)
            clone_to(inout e, p, ty, src, dst_addr(s.dst))
        } else {
            put_op(inout e, p, ty, s.a, dst_addr(s.dst))
        }
    } else if k == ir.S_DROP {
        let a = paddr(inout e, p, s.a)
        drop_at(inout e, p, s.ty, a)
    } else if k == ir.S_UNARY {
        unary(inout e, p, s)
    } else if k == ir.S_BINARY {
        binary(inout e, p, s)
    } else if k == ir.S_CAST {
        cast(inout e, p, s)
    } else if k == ir.S_CALL {
        call_fn(inout e, p, s)
    } else if k == ir.S_RECORD && lower.shared_rec(p, s.ty) {
        let mut ptys: List[u32] = List.new()
        let mut args: List[List[u8]] = List.new()
        for i in 0..s.c {
            let a = p.ir.extra[(s.b + i) as usize]
            ptys.push(ir.op_ty(p.ir, a))
            args.push(oparg(inout e, p, a))
        }
        let gn_ = gname(e, "rnew_", s.ty)
        call(inout e, p, gn_, ptys, args, s.ty, dst_addr(s.dst))
    } else if k == ir.S_RECORD || k == ir.S_TUPLE {
        let d = dst_addr(s.dst)
        zero(inout e, p, s.ty, d)
        let ms = abi.parts(p, s.ty, NONE)
        for i in 0..s.c {
            let f = field_addr(inout e, p, s.ty, d, i)
            put_op(inout e, p, ms[i as usize], p.ir.extra[(s.b + i) as usize], f)
        }
    } else if k == ir.S_VARIANT {
        let d = dst_addr(s.dst)
        zero(inout e, p, s.ty, d)
        store_tag(inout e, p, s.ty, d, s.a)
        if s.c > 0 {
            let ms = abi.parts(p, s.ty, s.a)
            for i in 0..s.c {
                let f = payload_addr(inout e, p, s.ty, d, s.a, i)
                put_op(inout e, p, ms[i as usize], p.ir.extra[(s.b + i) as usize], f)
            }
        }
    } else if k == ir.S_ARRAY {
        let d = dst_addr(s.dst)
        let et = types.get(p.t, s.ty).a
        for i in 0..s.c {
            let mut t = sys.lit("getelementptr ")
            bytes.append(inout t, mty(inout e, p, s.ty))
            bytes.append(inout t, sys.lit(", ptr "))
            bytes.append(inout t, d)
            bytes.append(inout t, sys.lit(", i32 0, i32 0, i64 "))
            bytes.append(inout t, bytes.from_u64(i as u64))
            let f = val(inout e, t)
            put_op(inout e, p, et, p.ir.extra[(s.b + i) as usize], f)
        }
    } else if k == ir.S_REPEAT {
        if s.b > 0 { repeat(inout e, p, s) }
    } else if k == ir.S_TAG {
        let a = paddr(inout e, p, s.a)
        let tag = load_tag(inout e, p, p.ir.places[s.a as usize].ty, a)
        let r = val(inout e, catb(sys.lit("icmp eq i32 "), catb(tag, num(", ", s.b as u64))))
        store(inout e, p, types.BOOL, r, dst_addr(s.dst))
    } else if k == ir.S_PRINT {
        print(inout e, p, s)
    } else if k == ir.S_NOWMS {
        let r = rt_call(inout e, p, "ei_now_ms", List.new(), List.new(), types.U64)
        store(inout e, p, types.U64, r, dst_addr(s.dst))
    } else if k == ir.S_PANIC {
        let m = opv(inout e, p, s.a)
        trap_with(inout e, m, s.line)
    } else if k == ir.S_ASSERT {
        let c = opv(inout e, p, s.a)
        let ok = new_label(inout e)
        let bad = new_label(inout e)
        condbr(inout e, c, ok, bad)
        label(inout e, bad)
        let mut m = msg(inout e, "assertion failed")
        if s.b > 0 {
            e.sused[(s.b - 1) as usize] = true
            m = num("@.s", (s.b - 1) as u64)
        }
        trap_with(inout e, m, s.line)
        label(inout e, ok)
    } else if k == ir.S_BUILTIN {
        builtin(inout e, p, s)
    } else if k == ir.S_CLOSURE {
        closure(inout e, p, s)
    } else if k == ir.S_FNREF {
        let d = dst_addr(s.dst)
        zero(inout e, p, s.ty, d)
        let f = field_addr(inout e, p, s.ty, d, 1)
        let tk = catb(sys.lit("k_"), e.fnn[s.a as usize])
        // the thunk's prototype comes from the C half; its address is all that is needed
        declare_thunk(inout e, p, s.a, tk)
        let mut t = sys.lit("store ptr @")
        bytes.append(inout t, tk)
        bytes.append(inout t, sys.lit(", ptr "))
        bytes.append(inout t, f)
        stmt_text(inout e, t)
    } else if k == ir.S_CALLV {
        callv(inout e, p, s)
    } else if k == ir.S_BREAK {
        let t = e.brks[e.brks.len() - 1 - s.a as usize].copy()
        br(inout e, t)
    } else if k == ir.S_CONTINUE {
        let t = e.loops[e.loops.len() - 1 - s.a as usize].copy()
        br(inout e, t)
    } else if k == ir.S_RETURN {
        ret(inout e, p, s)
    } else {
        unsupported(inout e, "an IR statement kind")
    }
}

fn mutates(b: u32) -> bool {
    b == ir.B_SHOW || b == ir.B_STR_PUSH || b == ir.B_STR_APPEND || b == ir.B_STR_PUSH_BYTE || b == ir.B_LIST_PUSH || b == ir.B_LIST_POP || b == ir.B_LIST_CLEAR || b == ir.B_MAP_INSERT || b == ir.B_MAP_REMOVE
}

/// `[x; n]`: a loop storing x into every element.
fn repeat(inout e: E, p: lower.P, s: ir.Stmt) {
    let d = dst_addr(s.dst)
    let et = types.get(p.t, s.ty).a
    live(inout e)
    let pre = e.cur.copy()
    let lh = new_label(inout e)
    let lx = new_label(inout e)
    br(inout e, lh)
    label(inout e, lh)
    let i = reg(inout e)
    let nx = reg(inout e)
    let mut ph = sys.lit("phi i64 [ 0, ")
    bytes.append(inout ph, pre)
    bytes.append(inout ph, sys.lit(" ], [ "))
    bytes.append(inout ph, nx)
    bytes.append(inout ph, sys.lit(", "))
    bytes.append(inout ph, num("%L", lh as u64))
    bytes.append(inout ph, sys.lit(" ]"))
    ins(inout e)
    wb(inout e, i)
    w(inout e, " = ")
    wb(inout e, ph)
    fin(inout e)
    let mut t = sys.lit("getelementptr ")
    bytes.append(inout t, mty(inout e, p, s.ty))
    bytes.append(inout t, sys.lit(", ptr "))
    bytes.append(inout t, d)
    bytes.append(inout t, sys.lit(", i32 0, i32 0, i64 "))
    bytes.append(inout t, i)
    let f = val(inout e, t)
    put_op(inout e, p, et, s.a, f)
    ins(inout e)
    wb(inout e, nx)
    w(inout e, " = add i64 ")
    wb(inout e, i)
    w(inout e, ", 1")
    fin(inout e)
    let c = val(inout e, catb(sys.lit("icmp ult i64 "), catb(nx, num(", ", s.b as u64))))
    condbr(inout e, c, lh, lx)
    label(inout e, lx)
}

fn unary(inout e: E, p: lower.P, s: ir.Stmt) {
    let v = opv(inout e, p, s.b)
    let d = dst_addr(s.dst)
    if s.a == ir.U_NOT {
        let r = val(inout e, catb(sys.lit("xor i1 "), cat(v, ", true")))
        store(inout e, p, types.BOOL, r, d)
        return
    }
    let ik = types.ik(p.t, s.ty)
    let it = sys.lit(int_ty(ik))
    if s.a == ir.U_BNOT {
        let r = val(inout e, catb(sys.lit("xor "), catb(it, catb(sys.lit(" "), cat(v, ", -1")))))
        store(inout e, p, s.ty, r, d)
        return
    }
    let mn = int_text(ik, lower.kmin(ik))
    let c = icmp(inout e, "eq", it, v, mn)
    trap_if(inout e, c, "integer overflow in negation", s.line)
    let r = val(inout e, catb(sys.lit("sub "), catb(it, catb(sys.lit(" 0, "), v))))
    store(inout e, p, s.ty, r, d)
}

fn arith2(inout e: E, op: str, it: List[u8], a: List[u8], b: List[u8]) -> List[u8] {
    let mut t = sys.lit(op)
    bytes.append(inout t, sys.lit(" "))
    bytes.append(inout t, it)
    bytes.append(inout t, sys.lit(" "))
    bytes.append(inout t, a)
    bytes.append(inout t, sys.lit(", "))
    bytes.append(inout t, b)
    val(inout e, t)
}

fn checked(inout e: E, intr: str, it: List[u8], a: List[u8], b: List[u8], text: str, line: u32) -> List[u8] {
    let mut name = sys.lit("llvm.")
    bytes.append(inout name, sys.lit(intr))
    bytes.append(inout name, sys.lit(".with.overflow."))
    bytes.append(inout name, it)
    let mut d = sys.lit("declare { ")
    bytes.append(inout d, it)
    bytes.append(inout d, sys.lit(", i1 } @"))
    bytes.append(inout d, name)
    bytes.append(inout d, sys.lit("("))
    bytes.append(inout d, it)
    bytes.append(inout d, sys.lit(", "))
    bytes.append(inout d, it)
    bytes.append(inout d, sys.lit(")"))
    declare(inout e, name, d)
    let mut t = sys.lit("call { ")
    bytes.append(inout t, it)
    bytes.append(inout t, sys.lit(", i1 } @"))
    bytes.append(inout t, name)
    bytes.append(inout t, sys.lit("("))
    bytes.append(inout t, it)
    bytes.append(inout t, sys.lit(" "))
    bytes.append(inout t, a)
    bytes.append(inout t, sys.lit(", "))
    bytes.append(inout t, it)
    bytes.append(inout t, sys.lit(" "))
    bytes.append(inout t, b)
    bytes.append(inout t, sys.lit(")"))
    let r = val(inout e, t)
    let mut x = sys.lit("extractvalue { ")
    bytes.append(inout x, it)
    bytes.append(inout x, sys.lit(", i1 } "))
    bytes.append(inout x, r)
    let ov = val(inout e, cat(x, ", 1"))
    trap_if(inout e, ov, text, line)
    val(inout e, cat(x, ", 0"))
}

fn binary(inout e: E, p: lower.P, s: ir.Stmt) {
    let o = s.a
    let d = dst_addr(s.dst)
    let tk = kind(p, s.ty)
    if o == ast.OP_EQ || o == ast.OP_NE {
        let a = oparg(inout e, p, s.b)
        let b = oparg(inout e, p, s.c)
        let mut r = eq_val(inout e, p, s.ty, a, b)
        if o == ast.OP_NE { r = val(inout e, catb(sys.lit("xor i1 "), cat(r, ", true"))) }
        store(inout e, p, types.BOOL, r, d)
        return
    }
    if o >= ast.OP_LT && o <= ast.OP_GE {
        let a = oparg(inout e, p, s.b)
        let b = oparg(inout e, p, s.c)
        let sg = tk == types.T_INT && types.signed(types.ik(p.t, s.ty))
        let mut r: List[u8] = List.new()
        if tk == types.T_INT || tk == types.T_BOOL {
            let cc = if o == ast.OP_LT { if sg { "slt" } else { "ult" } } else if o == ast.OP_LE { if sg { "sle" } else { "ule" } } else if o == ast.OP_GT { if sg { "sgt" } else { "ugt" } } else { if sg { "sge" } else { "uge" } }
            let vt = vty(inout e, p, s.ty)
            r = icmp(inout e, cc, vt, a, b)
        } else {
            let c = cmp_val(inout e, p, s.ty, a, b)
            let cc = if o == ast.OP_LT { "slt" } else if o == ast.OP_LE { "sle" } else if o == ast.OP_GT { "sgt" } else { "sge" }
            r = icmp(inout e, cc, sys.lit("i32"), c, sys.lit("0"))
        }
        store(inout e, p, types.BOOL, r, d)
        return
    }
    if tk != types.T_INT {
        unsupported(inout e, "an operator on a non-integer")
        return
    }
    let ik = types.ik(p.t, s.ty)
    let it = sys.lit(int_ty(ik))
    let sg = types.signed(ik)
    let a = opv(inout e, p, s.b)
    let b = opv(inout e, p, s.c)
    let mut r: List[u8] = List.new()
    if o == ast.OP_ADD {
        r = checked(inout e, pick(sg, "sadd", "uadd"), it, a, b, "integer overflow in +", s.line)
    } else if o == ast.OP_SUB {
        r = checked(inout e, pick(sg, "ssub", "usub"), it, a, b, "integer overflow in -", s.line)
    } else if o == ast.OP_MUL {
        r = checked(inout e, pick(sg, "smul", "umul"), it, a, b, "integer overflow in *", s.line)
    } else if o == ast.OP_DIV || o == ast.OP_REM {
        let z = icmp(inout e, "eq", it, b, sys.lit("0"))
        trap_if(inout e, z, pick(o == ast.OP_DIV, "division by zero", "remainder by zero"), s.line)
        if sg {
            let c1 = icmp(inout e, "eq", it, a, int_text(ik, lower.kmin(ik)))
            let c2 = icmp(inout e, "eq", it, b, sys.lit("-1"))
            let c = val(inout e, catb(sys.lit("and i1 "), catb(c1, catb(sys.lit(", "), c2))))
            trap_if(inout e, c, pick(o == ast.OP_DIV, "integer overflow in /", "integer overflow in %"), s.line)
        }
        let op = if o == ast.OP_DIV { if sg { "sdiv" } else { "udiv" } } else { if sg { "srem" } else { "urem" } }
        r = arith2(inout e, op, it, a, b)
    } else if o == ast.OP_WADD {
        r = arith2(inout e, "add", it, a, b)
    } else if o == ast.OP_WSUB {
        r = arith2(inout e, "sub", it, a, b)
    } else if o == ast.OP_WMUL {
        r = arith2(inout e, "mul", it, a, b)
    } else if o == ast.OP_BAND {
        r = arith2(inout e, "and", it, a, b)
    } else if o == ast.OP_BOR {
        r = arith2(inout e, "or", it, a, b)
    } else if o == ast.OP_BXOR {
        r = arith2(inout e, "xor", it, a, b)
    } else if o == ast.OP_SHL || o == ast.OP_SHR {
        // a negative count is a huge unsigned one: one unsigned compare checks both ends
        let c = icmp(inout e, "uge", it, b, bytes.from_u64(int_bits(ik) as u64))
        trap_if(inout e, c, "shift count out of range", s.line)
        let op = if o == ast.OP_SHL { "shl" } else if sg { "ashr" } else { "lshr" }
        r = arith2(inout e, op, it, a, b)
    } else {
        unsupported(inout e, "an operator")
        return
    }
    store(inout e, p, s.ty, r, d)
}

/// `x as target` (lower.ei's cast through ei_s2s/s2u/u2s/u2u).
fn cast(inout e: E, p: lower.P, s: ir.Stmt) {
    let fty = ir.op_ty(p.ir, s.a)
    let from = types.ik(p.t, fty)
    let to = types.ik(p.t, s.ty)
    let v = opv(inout e, p, s.a)
    let mut w64 = v.copy()
    if int_bits(from) < 64 {
        let op = if types.signed(from) { "sext " } else { "zext " }
        w64 = val(inout e, catb(sys.lit(op), catb(sys.lit(int_ty(from)), catb(sys.lit(" "), cat(v, " to i64")))))
    }
    let hi = bytes.from_u64(lower.kmax(to))
    let i64t = sys.lit("i64")
    if types.signed(from) && types.signed(to) {
        let lo = int_text(types.IK_I64, lower.kmin(to))
        let c1 = icmp(inout e, "slt", i64t, w64, lo)
        let c2 = icmp(inout e, "sgt", i64t, w64, hi)
        let c = val(inout e, catb(sys.lit("or i1 "), catb(c1, catb(sys.lit(", "), c2))))
        trap_if(inout e, c, "integer conversion out of range", s.line)
    } else if types.signed(from) {
        let c1 = icmp(inout e, "slt", i64t, w64, sys.lit("0"))
        let c2 = icmp(inout e, "ugt", i64t, w64, int_text(types.IK_U64, lower.kmax(to)))
        let c = val(inout e, catb(sys.lit("or i1 "), catb(c1, catb(sys.lit(", "), c2))))
        trap_if(inout e, c, "integer conversion out of range", s.line)
    } else {
        let lim = if types.signed(to) { hi.copy() } else { int_text(types.IK_U64, lower.kmax(to)) }
        let c = icmp(inout e, "ugt", i64t, w64, lim)
        trap_if(inout e, c, "integer conversion out of range", s.line)
    }
    let mut r = w64.copy()
    if int_bits(to) < 64 { r = val(inout e, catb(sys.lit("trunc i64 "), catb(w64, catb(sys.lit(" to "), sys.lit(int_ty(to)))))) }
    store(inout e, p, s.ty, r, dst_addr(s.dst))
}

fn print(inout e: E, p: lower.P, s: ir.Stmt) {
    let t = types.get(p.t, s.ty)
    let none: List[u8] = List.new()
    if !lower.plain_show(p, s.ty) {
        let o = temp(inout e, p, types.STRING)
        let em = msg(inout e, "")
        call(inout e, p, sys.lit("ei_str_from"), tys1(types.STR), args1(em), types.STRING, o)
        let v = oparg(inout e, p, s.a)
        show_into(inout e, p, s.ty, o, v)
        let q = load_ptr_field(inout e, p, types.STRING, o, 0)
        rt_call(inout e, p, "ei_print_s", tys1(types.STR), args1(q), types.UNIT)
        call(inout e, p, sys.lit("ei_drop_String"), tys1(PTR + types.STRING), args1(o), types.UNIT, none)
        return
    }
    if t.kind == types.T_INT {
        let v = opv(inout e, p, s.a)
        let mut x = v.copy()
        if int_bits(t.a) < 64 {
            let op = if types.signed(t.a) { "sext " } else { "zext " }
            x = val(inout e, catb(sys.lit(op), catb(sys.lit(int_ty(t.a)), catb(sys.lit(" "), cat(v, " to i64")))))
        }
        if types.signed(t.a) {
            rt_call(inout e, p, "ei_print_i", tys1(types.I64), args1(x), types.UNIT)
        } else {
            rt_call(inout e, p, "ei_print_u", tys1(types.U64), args1(x), types.UNIT)
        }
    } else if t.kind == types.T_BOOL {
        let v = opv(inout e, p, s.a)
        rt_call(inout e, p, "ei_print_b", tys1(types.BOOL), args1(v), types.UNIT)
    } else if t.kind == types.T_STR {
        let v = opv(inout e, p, s.a)
        rt_call(inout e, p, "ei_print_s", tys1(types.STR), args1(v), types.UNIT)
    } else if t.kind == types.T_STRING {
        let a = opa(inout e, p, s.a)
        let q = load_ptr_field(inout e, p, s.ty, a, 0)
        rt_call(inout e, p, "ei_print_s", tys1(types.STR), args1(q), types.UNIT)
    } else {
        let a = opa(inout e, p, s.a)
        let tag = load_tag(inout e, p, s.ty, a)
        let gn_ = gname(e, "name_", s.ty)
        let nm = rt_call_b(inout e, p, gn_, tys1(types.U32), args1(tag), types.STR)
        rt_call(inout e, p, "ei_print_s", tys1(types.STR), args1(nm), types.UNIT)
    }
}

/// The parameter types of function f as the C half declares them (inout: a pointer; a
/// closure body: the environment pointer first).
fn fn_ptys(e: E, p: lower.P, f: u32) -> List[u32] {
    let fd = p.ir.fns[f as usize]
    let mut out: List[u32] = List.new()
    if e.clo[f as usize] { out.push(types.STR) }
    let nc = e.ncap[f as usize]
    for i in 0..fd.nparams {
        let l = p.ir.locals[(fd.lstart + nc + i) as usize]
        if l.kind == ir.L_INOUT { out.push(PTR + l.ty) } else { out.push(l.ty) }
    }
    out
}

fn extern_of(p: lower.P, f: u32) -> u32 {
    for i in 0..p.ir.externs.len() {
        if p.ir.externs[i].f == f { return i as u32 }
    }
    NONE
}

fn call_fn(inout e: E, p: lower.P, s: ir.Stmt) {
    let fd = p.ir.fns[s.a as usize]
    let mut name = e.fnn[s.a as usize].copy()
    let mut ptys: List[u32] = List.new()
    let x = extern_of(p, s.a)
    if x != NONE {
        name = p.ir.externs[x as usize].symbol.copy()
        ptys = p.ir.externs[x as usize].params.copy()
    } else {
        ptys = fn_ptys(e, p, s.a)
    }
    let mut args: List[List[u8]] = List.new()
    for i in 0..s.c {
        let a = p.ir.extra[(s.b + i) as usize]
        if a >= ir.ARG_PLACE { args.push(paddr(inout e, p, a - ir.ARG_PLACE)) } else { args.push(oparg(inout e, p, a)) }
    }
    let mut d: List[u8] = List.new()
    if s.dst != NONE { d = dst_addr(s.dst) }
    let r = call(inout e, p, name, ptys, args, fd.ret, d)
    if s.dst != NONE && is_scalar(p, fd.ret) && !is_void(fd.ret) { store(inout e, p, fd.ret, r, d) }
}

/// The C ABI of a fn value's `call`: (void *env, params...) -> ret.
fn fnval_sig(inout e: E, p: lower.P, fty: u32) -> abi.Sig {
    let mut ptys: List[u32] = List.new()
    ptys.push(types.STR)
    for x in types.elems(p.t, fty) {
        if kind(p, x) == types.T_INOUT { ptys.push(PTR + types.get(p.t, x).a) } else { ptys.push(x) }
    }
    abi.sig(inout e.lay, p, ptys, types.get(p.t, fty).b)
}

fn callv(inout e: E, p: lower.P, s: ir.Stmt) {
    let fty = ir.op_ty(p.ir, s.a)
    let fv = opa(inout e, p, s.a)
    let sg = fnval_sig(inout e, p, fty)
    let env = load_ptr_field(inout e, p, fty, fv, 0)
    let fp = load_ptr_field(inout e, p, fty, fv, 1)
    let mut args: List[List[u8]] = List.new()
    args.push(env)
    for i in 0..s.c {
        let a = p.ir.extra[(s.b + i) as usize]
        if a >= ir.ARG_PLACE { args.push(paddr(inout e, p, a - ir.ARG_PLACE)) } else { args.push(oparg(inout e, p, a)) }
    }
    let rt = types.get(p.t, fty).b
    let mut d: List[u8] = List.new()
    if s.dst != NONE { d = dst_addr(s.dst) }
    let r = call_sig(inout e, p, fp, sg, args, d)
    if s.dst != NONE && is_scalar(p, rt) && !is_void(rt) { store(inout e, p, rt, r, d) }
}

fn declare_thunk(inout e: E, p: lower.P, f: u32, name: List[u8]) {
    let fd = p.ir.fns[f as usize]
    let mut ptys: List[u32] = List.new()
    ptys.push(types.STR)
    for i in 0..fd.nparams { ptys.push(p.ir.locals[(fd.lstart + i) as usize].ty) }
    let sg = abi.sig(inout e.lay, p, ptys, fd.ret)
    declare_sig(inout e, p, name, sg, false)
}

/// S_CLOSURE: a new environment holding the captures, and the fn value pointing at the body
/// and the environment's glue (lower.ei's `closure`).
fn closure(inout e: E, p: lower.P, s: ir.Stmt) {
    let d = dst_addr(s.dst)
    zero(inout e, p, s.ty, d)
    let fname = e.fnn[s.a as usize].copy()
    let fd = p.ir.fns[s.a as usize]
    // the body's own address (its prototype is declared with its signature)
    let bp = fn_ptys(e, p, s.a)
    let bs = abi.sig(inout e.lay, p, bp, fd.ret)
    declare_sig(inout e, p, fname, bs, false)
    let f1 = field_addr(inout e, p, s.ty, d, 1)
    stmt_text(inout e, catb(sys.lit("store ptr @"), catb(fname, catb(sys.lit(", ptr "), f1))))
    if s.c == 0 { return }
    let mut cts: List[u32] = List.new()
    for i in 0..s.c { cts.push(p.ir.locals[(fd.lstart + i) as usize].ty) }
    let sz = abi.struct_of(inout e.lay, p, cts)
    let envp = rt_call(inout e, p, "ei_alloc", tys1(types.U64), args1(bytes.from_u64(sz[0])), types.STR)
    let est = members(inout e, p, cts)
    for i in 0..s.c {
        let f = gep(inout e, p, est, envp, i)
        put_op(inout e, p, cts[i as usize], p.ir.extra[(s.b + i) as usize], f)
    }
    let f0 = field_addr(inout e, p, s.ty, d, 0)
    stmt_text(inout e, catb(sys.lit("store ptr "), catb(envp, catb(sys.lit(", ptr "), f0))))
    let glue = ["edrop_", "eclone_", "eown_"]
    for j in 0..3 {
        let gn = catb(sys.lit(glue[j as usize]), fname)
        let rty = if j == 1 { types.STR } else { types.UNIT }
        let gs = abi.sig(inout e.lay, p, tys1(types.STR), rty)
        declare_sig(inout e, p, gn, gs, false)
        let fj = field_addr(inout e, p, s.ty, d, (j + 2) as u32)
        stmt_text(inout e, catb(sys.lit("store ptr @"), catb(gn, catb(sys.lit(", ptr "), fj))))
    }
}

fn ret(inout e: E, p: lower.P, s: ir.Stmt) {
    let r = e.rsig.copy()
    if s.a == 0 || r.kind == abi.A_VOID {
        stmt_text(inout e, sys.lit("ret void"))
        e.term = true
        return
    }
    let o = s.a - 1
    if r.kind == abi.A_DIRECT {
        let v = opv(inout e, p, o)
        let mut t = sys.lit("ret ")
        bytes.append(inout t, vty(inout e, p, r.ty))
        bytes.append(inout t, sys.lit(" "))
        bytes.append(inout t, v)
        stmt_text(inout e, t)
    } else if r.kind == abi.A_SRET {
        let a = opa(inout e, p, o)
        memcpy(inout e, p, r.ty, sys.lit("%sret"), a)
        stmt_text(inout e, sys.lit("ret void"))
    } else {
        let a = opa(inout e, p, o)
        let v0 = load_piece(inout e, a, 0, r.b0)
        if r.n == 1 {
            stmt_text(inout e, catb(num("ret i", r.b0 as u64), catb(sys.lit(" "), v0)))
        } else {
            let v1 = load_piece(inout e, a, 8, r.b1)
            let ct = coerce_ty(r)
            let x = val(inout e, catb(sys.lit("insertvalue "), catb(ct, catb(sys.lit(" poison, i"), catb(bytes.from_u64(r.b0 as u64), catb(sys.lit(" "), cat(v0, ", 0")))))))
            let y = val(inout e, catb(sys.lit("insertvalue "), catb(ct, catb(sys.lit(" "), catb(x, catb(sys.lit(", i"), catb(bytes.from_u64(r.b1 as u64), catb(sys.lit(" "), cat(v1, ", 1")))))))))
            stmt_text(inout e, catb(sys.lit("ret "), catb(ct, catb(sys.lit(" "), y))))
        }
    }
    e.term = true
}

// ---- builtins

/// An Option value at d: None, or Some with the value at address v (of type vt).
fn option_none(inout e: E, p: lower.P, oty: u32, d: List[u8]) {
    zero(inout e, p, oty, d)
    store_tag(inout e, p, oty, d, lower.none_idx(p, oty))
}

fn option_some_from(inout e: E, p: lower.P, oty: u32, d: List[u8], src: List[u8]) {
    zero(inout e, p, oty, d)
    let si = lower.some_idx(p, oty)
    store_tag(inout e, p, oty, d, si)
    let vt = abi.parts(p, oty, si)[0]
    let f = payload_addr(inout e, p, oty, d, si, 0)
    copy_mem(inout e, p, vt, f, src)
}

/// Store a builtin's scalar result r (when the statement has a destination).
fn bset(inout e: E, p: lower.P, s: ir.Stmt, r: List[u8]) {
    if s.dst != NONE && !is_void(s.ty) { store(inout e, p, s.ty, r, dst_addr(s.dst)) }
}

/// The destination address for an aggregate builtin result (a temporary when discarded).
fn bdst(inout e: E, p: lower.P, s: ir.Stmt) -> List[u8] {
    if s.dst != NONE { return dst_addr(s.dst) }
    temp(inout e, p, s.ty)
}

fn len_field(p: lower.P, ty: u32) -> u32 {
    if kind(p, ty) == types.T_MAP { return 3 }
    1
}

fn builtin(inout e: E, p: lower.P, s: ir.Stmt) {
    let b = s.a
    let none: List[u8] = List.new()
    if b == ir.B_STR_FROM || b == ir.B_STR_FROM_INT {
        let v = argval(inout e, p, barg(p, s, 0))
        let d = bdst(inout e, p, s)
        if b == ir.B_STR_FROM {
            call(inout e, p, sys.lit("ei_str_from"), tys1(types.STR), args1(v), types.STRING, d)
        } else {
            call(inout e, p, sys.lit("ei_str_from_i64"), tys1(types.I64), args1(v), types.STRING, d)
        }
        return
    }
    if (b == ir.B_LEN || b == ir.B_IS_EMPTY) && kind(p, arg_ty(p, barg(p, s, 0))) == types.T_STR {
        let v = argval(inout e, p, barg(p, s, 0))
        if b == ir.B_LEN {
            let r = rt_call(inout e, p, "strlen", tys1(types.STR), args1(v), types.U64)
            bset(inout e, p, s, r)
        } else {
            let c = val(inout e, catb(sys.lit("load i8, ptr "), v))
            let r = val(inout e, catb(sys.lit("icmp eq i8 "), cat(c, ", 0")))
            bset(inout e, p, s, r)
        }
        return
    }
    if b == ir.B_LEN || b == ir.B_IS_EMPTY {
        let a = barg(p, s, 0)
        let ty = arg_ty(p, a)
        let ad = argptr(inout e, p, a)
        let n = load_i64_field(inout e, p, ty, ad, len_field(p, ty))
        if b == ir.B_LEN {
            bset(inout e, p, s, n)
        } else {
            let r = val(inout e, catb(sys.lit("icmp eq i64 "), cat(n, ", 0")))
            bset(inout e, p, s, r)
        }
        return
    }
    if b == ir.B_DEFAULT {
        let bd_ = bdst(inout e, p, s)
        default_to(inout e, p, s.ty, bd_)
        return
    }
    if b == ir.B_STR_PUSH {
        let o = argptr(inout e, p, barg(p, s, 0))
        let v = argval(inout e, p, barg(p, s, 1))
        call(inout e, p, sys.lit("ei_str_push"), tys2(PTR + types.STRING, types.STR), args2(o, v), types.UNIT, none)
        return
    }
    if b == ir.B_STR_APPEND {
        let o = argptr(inout e, p, barg(p, s, 0))
        let v = argptr(inout e, p, barg(p, s, 1))
        call(inout e, p, sys.lit("ei_str_append"), tys2(PTR + types.STRING, PTR + types.STRING), args2(o, v), types.UNIT, none)
        return
    }
    if b == ir.B_LIST_NEW || b == ir.B_MAP_NEW {
        let bd_ = bdst(inout e, p, s)
        zero(inout e, p, s.ty, bd_)
        return
    }
    if b == ir.B_BOX_NEW {
        let a = barg(p, s, 0)
        let v = argval(inout e, p, a)
        let gn_ = gname(e, "new_", s.ty)
        let bd_ = bdst(inout e, p, s)
        call(inout e, p, gn_, tys1(arg_ty(p, a)), args1(v), s.ty, bd_)
        return
    }
    if b == ir.B_LIST_PUSH || b == ir.B_LIST_CONTAINS {
        let l = barg(p, s, 0)
        let lt = arg_ty(p, l)
        let lp = argptr(inout e, p, l)
        let x = barg(p, s, 1)
        let xv = argval(inout e, p, x)
        let et = types.get(p.t, lt).a
        if b == ir.B_LIST_PUSH {
            let gn_ = gname(e, "push_", lt)
            call(inout e, p, gn_, tys2(PTR + lt, et), args2(lp, xv), types.UNIT, none)
        } else {
            let gn_ = gname(e, "has_", lt)
            let r = rt_call_b(inout e, p, gn_, tys2(PTR + lt, et), args2(lp, xv), types.BOOL)
            bset(inout e, p, s, r)
        }
        return
    }
    if b == ir.B_LIST_POP {
        let l = barg(p, s, 0)
        let lt = arg_ty(p, l)
        let lp = argptr(inout e, p, l)
        uniq_call(inout e, p, lt, lp)
        let d = bdst(inout e, p, s)
        let n = load_i64_field(inout e, p, lt, lp, 1)
        let z = val(inout e, catb(sys.lit("icmp eq i64 "), cat(n, ", 0")))
        let ln = new_label(inout e)
        let ls = new_label(inout e)
        let lj = new_label(inout e)
        condbr(inout e, z, ln, ls)
        label(inout e, ln)
        option_none(inout e, p, s.ty, d)
        br(inout e, lj)
        label(inout e, ls)
        let m = val(inout e, catb(sys.lit("sub i64 "), cat(n, ", 1")))
        let lf = field_addr(inout e, p, lt, lp, 1)
        stmt_text(inout e, catb(sys.lit("store i64 "), catb(m, catb(sys.lit(", ptr "), lf))))
        let dp = load_ptr_field(inout e, p, lt, lp, 0)
        let et = types.get(p.t, lt).a
        let mut g = sys.lit("getelementptr ")
        bytes.append(inout g, mty(inout e, p, et))
        bytes.append(inout g, sys.lit(", ptr "))
        bytes.append(inout g, dp)
        bytes.append(inout g, sys.lit(", i64 "))
        bytes.append(inout g, m)
        let ep = val(inout e, g)
        option_some_from(inout e, p, s.ty, d, ep)
        label(inout e, lj)
        return
    }
    if b == ir.B_LIST_CLEAR {
        let l = barg(p, s, 0)
        let lt0 = arg_ty(p, l)
        let lp = argptr(inout e, p, l)
        let gn_ = gname(e, "drop_", lt0)
        call(inout e, p, gn_, tys1(PTR + lt0), args1(lp), types.UNIT, none)
        return
    }
    if b == ir.B_LIST_SUM {
        list_sum(inout e, p, s)
        return
    }
    if b == ir.B_MAP_GET {
        let m = barg(p, s, 0)
        let mt = arg_ty(p, m)
        let mp = argptr(inout e, p, m)
        let kv = argval(inout e, p, barg(p, s, 1))
        let kt = types.get(p.t, mt).a
        let gn_ = gname(e, "get_", mt)
        let q = rt_call_b(inout e, p, gn_, tys2(PTR + mt, kt), args2(mp, kv), types.STR)
        let d = bdst(inout e, p, s)
        let nul = val(inout e, catb(sys.lit("icmp eq ptr "), cat(q, ", null")))
        let ln = new_label(inout e)
        let ls = new_label(inout e)
        let lj = new_label(inout e)
        condbr(inout e, nul, ln, ls)
        label(inout e, ln)
        option_none(inout e, p, s.ty, d)
        br(inout e, lj)
        label(inout e, ls)
        option_some_from(inout e, p, s.ty, d, q)
        label(inout e, lj)
        return
    }
    if b == ir.B_MAP_INSERT || b == ir.B_MAP_REMOVE || b == ir.B_MAP_CONTAINS {
        let m = barg(p, s, 0)
        let mt = arg_ty(p, m)
        let mp = argptr(inout e, p, m)
        let kt = types.get(p.t, mt).a
        let vt = types.get(p.t, mt).b
        let kv = argval(inout e, p, barg(p, s, 1))
        if b == ir.B_MAP_INSERT {
            let vv = argval(inout e, p, barg(p, s, 2))
            let gn_ = gname(e, "ins_", mt)
            call(inout e, p, gn_, tys3(PTR + mt, kt, vt), args3(mp, kv, vv), types.UNIT, none)
        } else if b == ir.B_MAP_REMOVE {
            let gn_ = gname(e, "rem_", mt)
            let r = rt_call_b(inout e, p, gn_, tys2(PTR + mt, kt), args2(mp, kv), types.BOOL)
            bset(inout e, p, s, r)
        } else {
            let gn_ = gname(e, "find_", mt)
            let f = rt_call_b(inout e, p, gn_, tys2(PTR + mt, kt), args2(mp, kv), types.I64)
            let r = val(inout e, catb(sys.lit("icmp sge i64 "), cat(f, ", 0")))
            bset(inout e, p, s, r)
        }
        return
    }
    if b == ir.B_STR_PUSH_BYTE {
        let o = argptr(inout e, p, barg(p, s, 0))
        let v = argval(inout e, p, barg(p, s, 1))
        rt_call3_line(inout e, p, o, v, s.line)
        return
    }
    if b == ir.B_STR_FROM_BYTES {
        let a = barg(p, s, 0)
        let lt = arg_ty(p, a)
        let lp = argptr(inout e, p, a)
        let dp = load_ptr_field(inout e, p, lt, lp, 0)
        let n = load_i64_field(inout e, p, lt, lp, 1)
        let gn_ = gname(e, "utf8_", s.ty)
        let bd_ = bdst(inout e, p, s)
        call(inout e, p, gn_, tys2(types.STR, types.U64), args2(dp, n), s.ty, bd_)
        return
    }
    if b == ir.B_STR_BYTES || b == ir.B_STR_BYTE || b == ir.B_STR_SLICE {
        let a = barg(p, s, 0)
        let ty = arg_ty(p, a)
        let mut sp: List[u8] = List.new()
        let mut n: List[u8] = List.new()
        if kind(p, ty) == types.T_STRING {
            let ad = argptr(inout e, p, a)
            sp = load_ptr_field(inout e, p, ty, ad, 0)
            n = load_i64_field(inout e, p, ty, ad, 1)
        } else {
            sp = argval(inout e, p, a)
            n = rt_call(inout e, p, "strlen", tys1(types.STR), args1(sp), types.U64)
        }
        if b == ir.B_STR_BYTES {
            let gn_ = gname(e, "bytes_", s.ty)
            let bd_ = bdst(inout e, p, s)
            call(inout e, p, gn_, tys2(types.STR, types.U64), args2(sp, n), s.ty, bd_)
            return
        }
        let i = argval(inout e, p, barg(p, s, 1))
        let ln = line_of(e, s.line)
        if b == ir.B_STR_BYTE {
            let mut ps = tys3(types.STR, types.U64, types.U64)
            ps.push(types.I32)
            let mut xs = args3(sp, n, i)
            xs.push(ln)
            let r = rt_call(inout e, p, "ei_str_byte", ps, xs, types.U8)
            bset(inout e, p, s, r)
            return
        }
        let j = argval(inout e, p, barg(p, s, 2))
        let mut ps = tys3(types.STR, types.U64, types.U64)
        ps.push(types.U64)
        ps.push(types.I32)
        let mut xs = args3(sp, n, i)
        xs.push(j)
        xs.push(ln)
        let bd_ = bdst(inout e, p, s)
        call(inout e, p, sys.lit("ei_str_slice"), ps, xs, types.STRING, bd_)
        return
    }
    if b >= ir.B_COPY && b <= ir.B_TO_STRING {
        trait_builtin(inout e, p, s)
        return
    }
    if b == ir.B_SPAWN || b == ir.B_MUTEX_NEW || b == ir.B_CHAN_NEW || b == ir.B_TASK_JOIN || b == ir.B_MUTEX_GET || b == ir.B_MUTEX_SET || b == ir.B_MUTEX_UPDATE || b == ir.B_CHAN_SEND {
        thread_builtin(inout e, p, s)
        return
    }
    if b >= ir.B_REF_NEW && b <= ir.B_REF_UPDATE {
        ref_builtin(inout e, p, s)
        return
    }
    if b >= ir.B_MAP_KEYS && b <= ir.B_MAP_ENTRIES {
        map_lists(inout e, p, s)
        return
    }
    if b == ir.B_CHAN_CLOSE {
        let c = argptr(inout e, p, barg(p, s, 0))
        let ct = arg_ty(p, barg(p, s, 0))
        let q = load_ptr_field(inout e, p, ct, c, 0)
        // `struct <chan>_c { ei_rc rc; ei_chan ch; }`: ch follows the 8-byte count
        let ch = val(inout e, catb(sys.lit("getelementptr i8, ptr "), cat(q, ", i64 8")))
        rt_call(inout e, p, "ei_chan_close", tys1(types.STR), args1(ch), types.UNIT)
        return
    }
    if b == ir.B_CHAN_RECV {
        let a = barg(p, s, 0)
        let ct = arg_ty(p, a)
        let el = types.get(p.t, ct).a
        let cv = argval(inout e, p, a)
        let v = temp(inout e, p, el)
        let gn_ = gname(e, "recv_", ct)
        let r = rt_call_b(inout e, p, gn_, tys2(ct, PTR + el), args2(cv, v), types.BOOL)
        let d = bdst(inout e, p, s)
        let ls = new_label(inout e)
        let ln = new_label(inout e)
        let lj = new_label(inout e)
        condbr(inout e, r, ls, ln)
        label(inout e, ls)
        option_some_from(inout e, p, s.ty, d, v)
        br(inout e, lj)
        label(inout e, ln)
        option_none(inout e, p, s.ty, d)
        label(inout e, lj)
        return
    }
    unsupported(inout e, "a builtin")
}

/// B_MAP_KEYS, B_MAP_VALUES, B_MAP_ENTRIES: a new List of copies, in slot order (lower.ei's
/// map_lists).
fn map_lists(inout e: E, p: lower.P, s: ir.Stmt) {
    let b = s.a
    let x = barg(p, s, 0)
    let mt = arg_ty(p, x)
    let kt = types.get(p.t, mt).a
    let vt = types.get(p.t, mt).b
    let el = types.get(p.t, s.ty).a
    let mp = argptr(inout e, p, x)
    let l = temp(inout e, p, s.ty)
    zero(inout e, p, s.ty, l)
    let item = temp(inout e, p, el)
    live(inout e)
    let pre = e.cur.copy()
    let lh = new_label(inout e)
    let lb = new_label(inout e)
    let lu = new_label(inout e)
    let lnx = new_label(inout e)
    let lx = new_label(inout e)
    br(inout e, lh)
    label(inout e, lh)
    let i = reg(inout e)
    let nx = reg(inout e)
    ins(inout e)
    wb(inout e, i)
    w(inout e, " = phi i64 [ 0, ")
    wb(inout e, pre)
    w(inout e, " ], [ ")
    wb(inout e, nx)
    w(inout e, ", %L")
    wn(inout e, lnx as u64)
    w(inout e, " ]")
    fin(inout e)
    let cap = load_i64_field(inout e, p, mt, mp, 4)
    let c = val(inout e, catb(sys.lit("icmp ult i64 "), catb(i, catb(sys.lit(", "), cap))))
    condbr(inout e, c, lb, lx)
    label(inout e, lb)
    let sp = load_ptr_field(inout e, p, mt, mp, 2)
    let sa = val(inout e, catb(sys.lit("getelementptr i8, ptr "), catb(sp, catb(sys.lit(", i64 "), i))))
    let sv = val(inout e, catb(sys.lit("load i8, ptr "), sa))
    let used = val(inout e, catb(sys.lit("icmp eq i8 "), cat(sv, ", 1")))
    condbr(inout e, used, lu, lnx)
    label(inout e, lu)
    let ka = elem_addr(inout e, p, mt, mp, 0, kt, i)
    let va = elem_addr(inout e, p, mt, mp, 1, vt, i)
    if b == ir.B_MAP_KEYS {
        clone_to(inout e, p, kt, ka, item)
    } else if b == ir.B_MAP_VALUES {
        clone_to(inout e, p, vt, va, item)
    } else {
        zero(inout e, p, el, item)
        let f0 = field_addr(inout e, p, el, item, 0)
        clone_to(inout e, p, kt, ka, f0)
        let f1 = field_addr(inout e, p, el, item, 1)
        clone_to(inout e, p, vt, va, f1)
    }
    let mut iv = item.copy()
    if is_scalar(p, el) { iv = load(inout e, p, el, item) }
    let gn_ = gname(e, "push_", s.ty)
    let none: List[u8] = List.new()
    call(inout e, p, gn_, tys2(PTR + s.ty, el), args2(l, iv), types.UNIT, none)
    br(inout e, lnx)
    label(inout e, lnx)
    ins(inout e)
    wb(inout e, nx)
    w(inout e, " = add i64 ")
    wb(inout e, i)
    w(inout e, ", 1")
    fin(inout e)
    br(inout e, lh)
    label(inout e, lx)
    if s.dst != NONE {
        memcpy(inout e, p, s.ty, dst_addr(s.dst), l)
    } else {
        drop_at(inout e, p, s.ty, l)
    }
}

/// &m.k[i] (field 0) or &m.v[i] (field 1) of the Map at mp.
fn elem_addr(inout e: E, p: lower.P, mt: u32, mp: List[u8], fi: u32, et: u32, i: List[u8]) -> List[u8] {
    let base = load_ptr_field(inout e, p, mt, mp, fi)
    let mut g = sys.lit("getelementptr ")
    bytes.append(inout g, mty(inout e, p, et))
    bytes.append(inout g, sys.lit(", ptr "))
    bytes.append(inout g, base)
    bytes.append(inout g, sys.lit(", i64 "))
    bytes.append(inout g, i)
    val(inout e, g)
}

/// Ref[T] (lower.ei's ref_builtin): the access state `st` and the value `v` of the shared
/// buffer `{ int64_t st; T v; }`, with the runtime's access checks inline.
fn ref_builtin(inout e: E, p: lower.P, s: ir.Stmt) {
    let b = s.a
    if b == ir.B_REF_NEW {
        let a = barg(p, s, 0)
        let v = argval(inout e, p, a)
        let gn_ = gname(e, "new_", s.ty)
        let bd_ = bdst(inout e, p, s)
        call(inout e, p, gn_, tys1(arg_ty(p, a)), args1(v), s.ty, bd_)
        return
    }
    let ra = barg(p, s, 0)
    let rt = arg_ty(p, ra)
    let el = types.get(p.t, rt).a
    let upd = b == ir.B_REF_UPDATE || b == ir.B_REF_SET
    let rp = argptr(inout e, p, ra)
    let q = load_ptr_field(inout e, p, rt, rp, 0)
    let mut ms: List[u32] = List.new()
    ms.push(types.I64)
    ms.push(el)
    let voff = abi.offset_of(inout e.lay, p, ms, 1)
    let va = val(inout e, catb(sys.lit("getelementptr i8, ptr "), catb(q, num(", i64 ", voff))))
    let st = val(inout e, catb(sys.lit("load i64, ptr "), q))
    if upd {
        let c1 = icmp(inout e, "slt", sys.lit("i64"), st, sys.lit("0"))
        trap_if(inout e, c1, "Ref updated while it is already being updated", s.line)
        let c2 = icmp(inout e, "sgt", sys.lit("i64"), st, sys.lit("0"))
        trap_if(inout e, c2, "Ref updated while it is being read", s.line)
        stmt_text(inout e, catb(sys.lit("store i64 -1, ptr "), q))
    } else {
        let c = icmp(inout e, "slt", sys.lit("i64"), st, sys.lit("0"))
        trap_if(inout e, c, "Ref read while it is being updated", s.line)
        let n = val(inout e, catb(sys.lit("add i64 "), cat(st, ", 1")))
        stmt_text(inout e, catb(sys.lit("store i64 "), catb(n, catb(sys.lit(", ptr "), q))))
    }
    let mut old: List[u8] = List.new()
    if b == ir.B_REF_GET {
        let d = bdst(inout e, p, s)
        clone_to(inout e, p, el, va, d)
    } else if b == ir.B_REF_SET {
        if owns(inout e, p, el) {
            old = temp(inout e, p, el)
            copy_mem(inout e, p, el, old, va)
        }
        let a = barg(p, s, 1)
        if a >= ir.ARG_PLACE {
            let src = paddr(inout e, p, a - ir.ARG_PLACE)
            copy_mem(inout e, p, el, va, src)
        } else if is_void(el) {
            store(inout e, p, el, sys.lit("0"), va)
        } else {
            put_op(inout e, p, el, a, va)
        }
    } else {
        let fo = barg(p, s, 1)
        let fty = arg_ty(p, fo)
        let fv = argptr(inout e, p, fo)
        let sg = fnval_sig(inout e, p, fty)
        let env = load_ptr_field(inout e, p, fty, fv, 0)
        let fp = load_ptr_field(inout e, p, fty, fv, 1)
        let mut args: List[List[u8]] = List.new()
        args.push(env)
        if upd || !is_scalar(p, el) {
            args.push(va)
        } else if is_void(el) {
            args.push(sys.lit("0"))
        } else {
            args.push(load(inout e, p, el, va))
        }
        let r_ty = types.get(p.t, fty).b
        let mut d: List[u8] = List.new()
        if !is_scalar(p, r_ty) { d = bdst(inout e, p, s) }
        let r = call_sig(inout e, p, fp, sg, args, d)
        if is_scalar(p, r_ty) && !is_void(r_ty) { bset(inout e, p, s, r) }
    }
    if upd {
        stmt_text(inout e, catb(sys.lit("store i64 0, ptr "), q))
    } else {
        let st2 = val(inout e, catb(sys.lit("load i64, ptr "), q))
        let n2 = val(inout e, catb(sys.lit("sub i64 "), cat(st2, ", 1")))
        stmt_text(inout e, catb(sys.lit("store i64 "), catb(n2, catb(sys.lit(", ptr "), q))))
    }
    if old.len() > 0 { drop_at(inout e, p, el, old) }
}

fn rt_call3_line(inout e: E, p: lower.P, o: List[u8], v: List[u8], line: u32) {
    let ln = line_of(e, line)
    rt_call(inout e, p, "ei_str_push_byte", tys3(PTR + types.STRING, types.U8, types.I32), args3(o, v, ln), types.UNIT)
}

fn list_sum(inout e: E, p: lower.P, s: ir.Stmt) {
    let l = barg(p, s, 0)
    let lt = arg_ty(p, l)
    let lp = argptr(inout e, p, l)
    let ik = types.ik(p.t, s.ty)
    let it = sys.lit(int_ty(ik))
    let d = dst_addr(s.dst)
    store(inout e, p, s.ty, sys.lit("0"), d)
    live(inout e)
    let pre = e.cur.copy()
    let lh = new_label(inout e)
    let lb = new_label(inout e)
    let lx = new_label(inout e)
    br(inout e, lh)
    label(inout e, lh)
    let i = reg(inout e)
    let nx = reg(inout e)
    ins(inout e)
    wb(inout e, i)
    w(inout e, " = ")
    // the back edge comes from the block after the add's trap check (named below)
    let back = new_label(inout e)
    let mut ph2 = sys.lit("phi i64 [ 0, ")
    bytes.append(inout ph2, pre)
    bytes.append(inout ph2, sys.lit(" ], [ "))
    bytes.append(inout ph2, nx)
    bytes.append(inout ph2, num(", %L", back as u64))
    bytes.append(inout ph2, sys.lit(" ]"))
    wb(inout e, ph2)
    fin(inout e)
    let n = load_i64_field(inout e, p, lt, lp, 1)
    let c = val(inout e, catb(sys.lit("icmp ult i64 "), catb(i, catb(sys.lit(", "), n))))
    condbr(inout e, c, lb, lx)
    label(inout e, lb)
    let dp = load_ptr_field(inout e, p, lt, lp, 0)
    let mut g = sys.lit("getelementptr ")
    bytes.append(inout g, it)
    bytes.append(inout g, sys.lit(", ptr "))
    bytes.append(inout g, dp)
    bytes.append(inout g, sys.lit(", i64 "))
    bytes.append(inout g, i)
    let ep = val(inout e, g)
    let x = load(inout e, p, s.ty, ep)
    let acc = load(inout e, p, s.ty, d)
    let sg = types.signed(ik)
    let r = checked(inout e, pick(sg, "sadd", "uadd"), it, acc, x, "integer overflow in +", s.line)
    store(inout e, p, s.ty, r, d)
    br(inout e, back)
    label(inout e, back)
    ins(inout e)
    wb(inout e, nx)
    w(inout e, " = add i64 ")
    wb(inout e, i)
    w(inout e, ", 1")
    fin(inout e)
    br(inout e, lh)
    label(inout e, lx)
}

fn default_to(inout e: E, p: lower.P, ty: u32, d: List[u8]) {
    let k = kind(p, ty)
    let f = lower.custom_fn(p, 7, ty)
    if f != NONE {
        let fname = e.fnn[f as usize].copy()
        call(inout e, p, fname, List.new(), List.new(), ty, d)
        if is_scalar(p, ty) { unsupported(inout e, "a scalar custom Default") }
    } else if k == types.T_INT || k == types.T_UNIT || k == types.T_BOOL || k == types.T_LIST || k == types.T_MAP {
        zero(inout e, p, ty, d)
    } else if k == types.T_STR {
        let m = msg(inout e, "")
        store(inout e, p, ty, m, d)
    } else if k == types.T_STRING {
        let m = msg(inout e, "")
        call(inout e, p, sys.lit("ei_str_from"), tys1(types.STR), args1(m), types.STRING, d)
    } else if k == types.T_ENUM {
        option_none(inout e, p, ty, d)
    } else {
        let gn_ = gname(e, "default_", ty)
        call(inout e, p, gn_, List.new(), List.new(), ty, d)
    }
}

fn trait_builtin(inout e: E, p: lower.P, s: ir.Stmt) {
    let b = s.a
    if b == ir.B_SHOW {
        let o = argptr(inout e, p, barg(p, s, 0))
        let x = barg(p, s, 1)
        let v = argval(inout e, p, x)
        show_into(inout e, p, arg_ty(p, x), o, v)
        return
    }
    let x = barg(p, s, 0)
    let ty = arg_ty(p, x)
    if b == ir.B_TO_STRING {
        let v = argval(inout e, p, x)
        let d = bdst(inout e, p, s)
        let em = msg(inout e, "")
        call(inout e, p, sys.lit("ei_str_from"), tys1(types.STR), args1(em), types.STRING, d)
        show_into(inout e, p, ty, d, v)
        if s.dst == NONE { drop_at(inout e, p, types.STRING, d) }
        return
    }
    if b == ir.B_COPY {
        let src = argptr(inout e, p, x)
        let bd_ = bdst(inout e, p, s)
        copy_to(inout e, p, ty, src, bd_)
        return
    }
    if b == ir.B_HASH {
        let v = argval(inout e, p, x)
        let r = hash_val(inout e, p, ty, v)
        bset(inout e, p, s, r)
        return
    }
    // compare: Ordering's Less, Equal, Greater are tags 0, 1, 2
    let v = argval(inout e, p, x)
    let w2 = argval(inout e, p, barg(p, s, 1))
    let c = cmp_val(inout e, p, ty, v, w2)
    let k = kind(p, ty)
    let mut t = c.copy()
    if k == types.T_STR || k == types.T_STRING {
        let g = icmp(inout e, "sgt", sys.lit("i32"), c, sys.lit("0"))
        let l = icmp(inout e, "slt", sys.lit("i32"), c, sys.lit("0"))
        let g32 = val(inout e, catb(sys.lit("zext i1 "), cat(g, " to i32")))
        let l32 = val(inout e, catb(sys.lit("zext i1 "), cat(l, " to i32")))
        t = val(inout e, catb(sys.lit("sub i32 "), catb(g32, catb(sys.lit(", "), l32))))
    }
    let tag = val(inout e, catb(sys.lit("add i32 "), cat(t, ", 1")))
    let d = bdst(inout e, p, s)
    let f = field_addr(inout e, p, s.ty, d, 0)
    stmt_text(inout e, catb(sys.lit("store i32 "), catb(tag, catb(sys.lit(", ptr "), f))))
}

/// Task, Mutex and Chan operations: the C half's glue, called with every argument by value.
fn thread_builtin(inout e: E, p: lower.P, s: ir.Stmt) {
    let b = s.a
    let mut op = "new_"
    let mut gty = s.ty.copy()
    if b == ir.B_SPAWN { op = "spawn_" }
    if b == ir.B_TASK_JOIN || b == ir.B_MUTEX_GET || b == ir.B_MUTEX_SET || b == ir.B_MUTEX_UPDATE || b == ir.B_CHAN_SEND { gty = arg_ty(p, barg(p, s, 0)) }
    if b == ir.B_TASK_JOIN { op = "join_" }
    if b == ir.B_MUTEX_GET { op = "get_" }
    if b == ir.B_MUTEX_SET { op = "set_" }
    if b == ir.B_MUTEX_UPDATE { op = "upd_" }
    if b == ir.B_CHAN_SEND { op = "send_" }
    let mut ptys: List[u32] = List.new()
    let mut args: List[List[u8]] = List.new()
    for i in 0..s.c {
        let a = barg(p, s, i)
        ptys.push(arg_ty(p, a))
        args.push(argval(inout e, p, a))
    }
    let mut d: List[u8] = List.new()
    if !is_scalar(p, s.ty) { d = bdst(inout e, p, s) }
    let gn_ = gname(e, op, gty)
    let r = call(inout e, p, gn_, ptys, args, s.ty, d)
    if is_scalar(p, s.ty) { bset(inout e, p, s, r) }
}

// ---- functions

fn signature_params(inout e: E, p: lower.P, f: u32, sg: abi.Sig) -> List[u8] {
    // parameter names: %sret, then per argument %a<i> (direct, byval) or %a<i>.0/.1
    let mut names: List[List[u8]] = List.new()
    if sg.ret.kind == abi.A_SRET { names.push(sys.lit("%sret")) }
    for i in 0..sg.args.len() {
        let a = sg.args[i]
        if a.kind == abi.A_COERCE {
            names.push(cat(num("%a", i as u64), ".0"))
            if a.n > 1 { names.push(cat(num("%a", i as u64), ".1")) }
        } else {
            names.push(num("%a", i as u64))
        }
    }
    params_text(inout e, p, sg, names)
}

/// One function as LLVM IR into e.fns, or nothing (and e.fail set) when it needs something
/// this backend doesn't lower yet.
fn function(inout e: E, p: lower.P, f: u32) -> bool {
    let fd = p.ir.fns[f as usize]
    e.ent = List.new()
    e.o = List.new()
    e.fail = List.new()
    e.nreg = 0
    e.nlbl = 0
    e.term = false
    e.cur = sys.lit("%entry")
    e.lbase = fd.lstart
    e.nc = e.ncap[f as usize]
    e.file = fd.file
    e.loops = List.new()
    e.brks = List.new()
    e.dloc = 0
    e.dlines = Map.new()
    let md_mark = e.md.len()
    let nmd_mark = e.nmd
    let ptys = fn_ptys(e, p, f)
    let sg = abi.sig(inout e.lay, p, ptys, fd.ret)
    e.rsig = sg.ret
    let first_line = first_line_of(p, fd)
    if e.dbg { subprogram(inout e, p, f, first_line) }
    set_line(inout e, first_line)
    let clo = e.clo[f as usize]
    // parameters into their locals
    let mut ai: usize = 0
    if clo { ai = 1 }
    for i in 0..fd.nparams {
        let li = e.nc + i
        let l = loc(p, e, li)
        let a = sg.args[ai]
        let an = num("%a", ai as u64)
        ai += 1
        if l.kind == ir.L_INOUT {
            stmt_text(inout e, catb(laddr(li), catb(sys.lit(" = getelementptr i8, ptr "), cat(an, ", i64 0"))))
            continue
        }
        if is_void(l.ty) { continue }
        if a.kind == abi.A_BYVAL {
            stmt_text(inout e, catb(laddr(li), catb(sys.lit(" = getelementptr i8, ptr "), cat(an, ", i64 0"))))
            continue
        }
        alloca(inout e, p, li, l.ty)
        if a.kind == abi.A_DIRECT {
            store(inout e, p, l.ty, an, laddr(li))
        } else {
            store_piece(inout e, cat(an, ".0"), laddr(li), 0, a.b0)
            if a.n > 1 { store_piece(inout e, cat(an, ".1"), laddr(li), 8, a.b1) }
        }
    }
    // captures: copies (borrows) of the environment's values; every other local zeroed
    if e.nc > 0 {
        let mut cts: List[u32] = List.new()
        for i in 0..e.nc { cts.push(loc(p, e, i).ty) }
        let est = members(inout e, p, cts)
        for i in 0..e.nc {
            let ct = loc(p, e, i).ty
            if is_void(ct) { continue }
            alloca(inout e, p, i, ct)
            let fa = gep(inout e, p, est, sys.lit("%a0"), i)
            copy_mem(inout e, p, ct, laddr(i), fa)
        }
    }
    for i in 0..fd.lcount {
        if i < e.nc + fd.nparams { continue }
        let l = loc(p, e, i)
        if is_void(l.ty) { continue }
        alloca(inout e, p, i, l.ty)
        zero(inout e, p, l.ty, laddr(i))
    }
    block(inout e, p, fd.body - 1)
    if !e.term {
        if sg.ret.kind == abi.A_VOID || sg.ret.kind == abi.A_SRET { stmt_text(inout e, sys.lit("ret void")) } else { stmt_text(inout e, sys.lit("unreachable")) }
    }
    if e.fail.len() > 0 {
        // roll back this function's metadata
        while e.md.len() > md_mark { e.md.pop() }
        e.nmd = nmd_mark
        return false
    }
    let mut h = sys.lit("define ")
    bytes.append(inout h, ret_text(inout e, p, sg))
    bytes.append(inout h, sys.lit(" @"))
    bytes.append(inout h, e.fnn[f as usize])
    bytes.append(inout h, sys.lit("("))
    bytes.append(inout h, signature_params(inout e, p, f, sg))
    bytes.append(inout h, sys.lit(") nounwind"))
    if e.dbg { bytes.append(inout h, num(" !dbg !", e.sp as u64)) }
    bytes.append(inout h, sys.lit(" {\nentry:\n"))
    let ent = e.ent.copy()
    let body = e.o.copy()
    bytes.append(inout e.fns, h)
    bytes.append(inout e.fns, ent)
    bytes.append(inout e.fns, body)
    bytes.append(inout e.fns, sys.lit("}\n\n"))
    true
}

fn alloca(inout e: E, p: lower.P, l: u32, ty: u32) {
    bytes.append(inout e.ent, sys.lit("  "))
    bytes.append(inout e.ent, laddr(l))
    bytes.append(inout e.ent, sys.lit(" = alloca "))
    let mt = mty(inout e, p, ty)
    let al = align(inout e, p, ty)
    bytes.append(inout e.ent, mt)
    bytes.append(inout e.ent, sys.lit(", align "))
    bytes.append(inout e.ent, bytes.from_u64(al))
    e.ent.push(10)
}

/// The first source line of a function: its first local's or statement's.
fn first_line_of(p: lower.P, fd: ir.Fn) -> u32 {
    for i in 0..fd.lcount {
        let l = p.ir.locals[(fd.lstart + i) as usize]
        if l.line > 0 { return l.line }
    }
    let bl = p.ir.blocks[(fd.body - 1) as usize]
    for i in 0..bl.len {
        let s = p.ir.stmts[p.ir.extra[(bl.start + i) as usize] as usize]
        if s.line > 0 { return s.line }
    }
    1
}

// ---- debug info

fn file_md(inout e: E, m: u32) -> u32 {
    let k = m as u64
    match e.fmd.get(k) {
        Some(id) => { return id }
        None => {}
    }
    let mut path = sys.lit("?")
    if (m as usize) < e.paths.len() { path = e.paths[m as usize].copy() }
    let id = e.nmd.copy()
    e.nmd += 1
    e.fmd.insert(k, id)
    bytes.append(inout e.md, num("!", id as u64))
    bytes.append(inout e.md, sys.lit(" = !DIFile(filename: "))
    md_string(inout e.md, path)
    bytes.append(inout e.md, sys.lit(", directory: "))
    let dir = e.dir.copy()
    md_string(inout e.md, dir)
    bytes.append(inout e.md, sys.lit(")\n"))
    id
}

fn md_string(inout out: List[u8], s: List[u8]) {
    out.push(34)
    for b in s {
        if b >= 32 && b < 127 && b != 34 && b != 92 {
            out.push(b)
        } else {
            out.push(92)
            let hx = sys.lit("0123456789ABCDEF")
            out.push(hx[(b / 16) as usize])
            out.push(hx[(b % 16) as usize])
        }
    }
    out.push(34)
}

fn subprogram(inout e: E, p: lower.P, f: u32, line: u32) {
    let fd = p.ir.fns[f as usize]
    let fm = file_md(inout e, fd.file)
    let id = e.nmd.copy()
    e.nmd += 1
    e.sp = id
    bytes.append(inout e.md, num("!", id as u64))
    bytes.append(inout e.md, sys.lit(" = distinct !DISubprogram(name: "))
    md_string(inout e.md, fd.name)
    bytes.append(inout e.md, sys.lit(", linkageName: "))
    let ln = e.fnn[f as usize].copy()
    md_string(inout e.md, ln)
    bytes.append(inout e.md, num(", scope: !", fm as u64))
    bytes.append(inout e.md, num(", file: !", fm as u64))
    bytes.append(inout e.md, num(", line: ", line as u64))
    bytes.append(inout e.md, sys.lit(", type: !3"))
    bytes.append(inout e.md, num(", scopeLine: ", line as u64))
    bytes.append(inout e.md, sys.lit(", spFlags: DISPFlagDefinition, unit: !0)\n"))
}

// ---- the program

/// The LLVM version this backend's IR needs (opaque pointers, `poison`, the overflow
/// intrinsics' current names): clang's major version must be at least this.
pub const MIN_LLVM: u64 = 17

/// The program as two halves (see the top of the file). `paths`: the module files by index
/// (debug info), `dir` the working directory, `debug` whether to emit debug info.
pub fn program(p: lower.P, file: List[u8], tests: bool, lib: bool, paths: List[List[u8]], dir: List[u8], debug: bool) -> Result[Out, List[u8]] {
    let names = lower.c_names(p)?
    let mut e = E(List.new(), List.new(), List.new(), List.new(), List.new(), List.new(), abi.new_lay(p), List.new(), names.tys, names.fns, List.new(), List.new(), List.new(), List.new(), Map.new(), List.new(), Map.new(), 0, 0, 0, false, List.new(), 0, 0, 0, List.new(), List.new(), false, abi.Arg(0, 0, 0, 0, 0, 0, 0), List.new(), debug, List.new(), 4, 0, 0, Map.new(), Map.new(), paths, dir)
    for i in 0..p.t.tys.len() {
        e.tdone.push(false)
        e.own.push(0)
    }
    for i in 0..p.ir.strs.len() { e.sused.push(false) }
    for f in 0..p.ir.fns.len() {
        let fd = p.ir.fns[f]
        let mut n: u32 = 0
        while n < fd.lcount && p.ir.locals[(fd.lstart + n) as usize].kind == ir.L_CAPTURE { n += 1 }
        e.ncap.push(n)
        e.clo.push(fd.body > 0 && !fd.is_test && is_closure_name(fd.name))
    }
    if debug {
        file_md(inout e, 0)
        for f in 0..p.ir.fns.len() {
            if p.ir.fns[f].body > 0 { file_md(inout e, p.ir.fns[f].file) }
        }
    }
    let mut native: List[bool] = List.new()
    let mut report: List[u8] = List.new()
    let mut nfns: u32 = 0
    let mut nnat: u32 = 0
    let mut defined: Map[u64, bool] = Map.new()
    for f in 0..p.ir.fns.len() {
        let fd = p.ir.fns[f]
        if fd.body == 0 || (!tests && fd.is_test) {
            native.push(false)
            continue
        }
        nfns += 1
        let ok = function(inout e, p, f as u32)
        native.push(ok)
        if ok {
            nnat += 1
            let fname = e.fnn[f].copy()
            defined.insert(h64(fname), true)
        } else {
            bytes.append(inout report, sys.lit("fallback "))
            bytes.append(inout report, fd.name)
            bytes.append(inout report, sys.lit(": "))
            bytes.append(inout report, e.fail)
            report.push(10)
        }
    }
    let c = lower.program_split(p, file, tests, lib, native)?
    let mut ll = sys.lit("; generated by eiderc --backend=llvm from ")
    for b in file {
        if b >= 32 && b < 127 { ll.push(b) }
    }
    bytes.append(inout ll, sys.lit("\n\n%ei.String = type { ptr, i64, i64 }\n"))
    bytes.append(inout ll, e.tdefs)
    ll.push(10)
    for i in 0..p.ir.strs.len() {
        if !e.sused[i] { continue }
        bytes.append(inout ll, num("@.s", i as u64))
        bytes.append(inout ll, sys.lit(" = private unnamed_addr constant ["))
        bytes.append(inout ll, bytes.from_u64((p.ir.strs[i].len() + 1) as u64))
        bytes.append(inout ll, sys.lit(" x i8] "))
        c_string(inout ll, p.ir.strs[i])
        ll.push(10)
    }
    bytes.append(inout ll, e.gl)
    ll.push(10)
    for i in 0..e.dnames.len() {
        if defined.contains(h64(e.dnames[i])) { continue }
        bytes.append(inout ll, e.dtext[i])
        ll.push(10)
    }
    ll.push(10)
    bytes.append(inout ll, e.fns)
    if debug {
        bytes.append(inout ll, sys.lit("!llvm.dbg.cu = !{!0}\n!llvm.module.flags = !{!1, !2}\n"))
        bytes.append(inout ll, sys.lit("!0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !"))
        let f0 = file_md(inout e, 0)
        bytes.append(inout ll, bytes.from_u64(f0 as u64))
        bytes.append(inout ll, sys.lit(", producer: \"eiderc (llvm backend)\", isOptimized: false, runtimeVersion: 0, emissionKind: LineTablesOnly)\n"))
        bytes.append(inout ll, sys.lit("!1 = !{i32 7, !\"Dwarf Version\", i32 5}\n!2 = !{i32 2, !\"Debug Info Version\", i32 3}\n!3 = !DISubroutineType(types: !{})\n"))
        bytes.append(inout ll, e.md)
    }
    Ok(Out(ll, c, native, nfns, nnat, report))
}

fn is_closure_name(s: List[u8]) -> bool {
    let mut i = s.len()
    while i > 0 && bytes.is_digit(s[i - 1]) { i -= 1 }
    if i == s.len() || i < 8 { return false }
    bytes.eq(bytes.slice(s, i - 8, i), sys.lit(".closure"))
}

/// `emit-llvm --coverage`: how many functions are native, then each fallback and why.
pub fn coverage(o: Out) -> List[u8] {
    let mut r = sys.lit("native ")
    bytes.append(inout r, bytes.from_u64(o.nnative as u64))
    r.push(47)
    bytes.append(inout r, bytes.from_u64(o.nfns as u64))
    bytes.append(inout r, sys.lit(" functions\n"))
    bytes.append(inout r, o.report)
    r
}

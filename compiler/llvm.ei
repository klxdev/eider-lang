    } else if k == types.T_MAP {
        uniq_call(inout e, p, ty, x)
        if owns(inout e, p, t.a) || owns(inout e, p, t.b) {
            let kp = load_ptr_field(inout e, p, ty, x, 0)
            let vp = load_ptr_field(inout e, p, ty, x, 1)
            let s = load_ptr_field(inout e, p, ty, x, 2)
            let cap = load_i64_field(inout e, p, ty, x, 4)
            let lp = loop_n(inout e, p, cap)
            let _h81 = catb(lit("load i8, ptr "), elem(inout e, p, types.U8, s, lp.iv))
            let sv = val(inout e, _h81)
            let _h82 = val(inout e, catb(lit("icmp eq i8 "), cat(sv, ", 1")))
            let j2 = if_then(inout e, _h82)
            let _h83 = elem(inout e, p, t.a, kp, lp.iv)
            own_at(inout e, p, t.a, _h83)
            let _h84 = elem(inout e, p, t.b, vp, lp.iv)
            own_at(inout e, p, t.b, _h84)
            if_end(inout e, j2)
            loop_next(inout e, lp)
        }
    } else if k == types.T_BOX {
        uniq_call(inout e, p, ty, x)
        if owns(inout e, p, t.a) {
            let q = load_ptr_field(inout e, p, ty, x, 0)
            let _h85 = not_null(inout e, q)
            let j = if_then(inout e, _h85)
            own_at(inout e, p, t.a, q)
            if_end(inout e, j)
        }
    } else if k == types.T_FN {
        fnval_hook(inout e, p, ty, x, 4)
    } else if k == types.T_REF {
        // the checker keeps every Ref it can see on its thread (E0411); this catches one
        // inside a closure's environment, which no type shows
        let q = load_ptr_field(inout e, p, ty, x, 0)
        let c = not_null(inout e, q)
        trap_if(inout e, c, "a Ref can't be sent to another thread", 0)
    }
    gfn_end(inout e, p, gf)
}

// ---- ==, cmp, hash, Show, variant names

fn g_eq(inout e: E, p: lower.P, ty: u32) {
    let _h86 = gname(e, "eq_", ty)
    let gf = gfn_begin(inout e, p, _h86, tys2(ty, ty), types.BOOL)
    let a = gf.args[0].copy()
    let b = gf.args[1].copy()
    let f = lower.custom_fn(p, lower.TR_EQ, ty)
    if f != NONE {
        let none: List[u8] = List.new()
        let r = call_user(inout e, p, f, args2(a, b), none)
        gret_v(inout e, p, r)
        gfn_end(inout e, p, gf)
        return
    }
    let t = types.get(p.t, ty)
    let k = t.kind
    if k == types.T_MAP {
        // the same keys, each with an equal value (slot order is not part of the value)
        gneed(inout e, lower.GK_FIND, ty)
        let la = load_i64_field(inout e, p, ty, a, 3)
        let lb = load_i64_field(inout e, p, ty, b, 3)
        let _h87 = val(inout e, catb(lit("icmp eq i64 "), catb(la, catb(lit(", "), lb))))
        ret_false_unless(inout e, p, _h87)
        let cap = load_i64_field(inout e, p, ty, a, 4)
        let kp = load_ptr_field(inout e, p, ty, a, 0)
        let vp = load_ptr_field(inout e, p, ty, a, 1)
        let s = load_ptr_field(inout e, p, ty, a, 2)
        let vb = load_ptr_field(inout e, p, ty, b, 1)
        let lp = loop_n(inout e, p, cap)
        let _h88 = catb(lit("load i8, ptr "), elem(inout e, p, types.U8, s, lp.iv))
        let sv = val(inout e, _h88)
        let _h89 = val(inout e, catb(lit("icmp eq i8 "), cat(sv, ", 1")))
        let j = if_then(inout e, _h89)
        let ka = elem(inout e, p, t.a, kp, lp.iv)
        let _h90 = gname(e, "find_", ty)
        let _h257 = args2(b, argof(inout e, p, t.a, ka))
        let fx = rt_call_b(inout e, p, _h90, tys2(PTR + ty, t.a), _h257, types.I64)
        let _h91 = val(inout e, catb(lit("icmp sge i64 "), cat(fx, ", 0")))
        ret_false_unless(inout e, p, _h91)
        let va = elem(inout e, p, t.b, vp, lp.iv)
        let vbx = elem(inout e, p, t.b, vb, fx)
        let _h258 = argof(inout e, p, t.b, va)
        let _h286 = argof(inout e, p, t.b, vbx)
        let _h92 = eq_val(inout e, p, t.b, _h258, _h286)
        ret_false_unless(inout e, p, _h92)
        if_end(inout e, j)
        loop_next(inout e, lp)
    } else if k == types.T_ARRAY || k == types.T_LIST {
        let mut n = bytes.from_u64(t.b as u64)
        let mut da = a.copy()
        let mut db = b.copy()
        if k == types.T_LIST {
            let la = load_i64_field(inout e, p, ty, a, 1)
            let lb = load_i64_field(inout e, p, ty, b, 1)
            let _h93 = val(inout e, catb(lit("icmp eq i64 "), catb(la, catb(lit(", "), lb))))
            ret_false_unless(inout e, p, _h93)
            n = la
            da = load_ptr_field(inout e, p, ty, a, 0)
            db = load_ptr_field(inout e, p, ty, b, 0)
        }
        if k == types.T_LIST || t.b > 0 {
            let lp = loop_n(inout e, p, n)
            let mut xa: List[u8] = List.new()
            let mut xb: List[u8] = List.new()
            if k == types.T_LIST {
                xa = elem(inout e, p, t.a, da, lp.iv)
                xb = elem(inout e, p, t.a, db, lp.iv)
            } else {
                xa = arr_elem(inout e, p, ty, a, lp.iv)
                xb = arr_elem(inout e, p, ty, b, lp.iv)
            }
            let _h259 = argof(inout e, p, t.a, xa)
            let _h287 = argof(inout e, p, t.a, xb)
            let _h94 = eq_val(inout e, p, t.a, _h259, _h287)
            ret_false_unless(inout e, p, _h94)
            loop_next(inout e, lp)
        }
    } else if k == types.T_BOX {
        let qa = load_ptr_field(inout e, p, ty, a, 0)
        let qb = load_ptr_field(inout e, p, ty, b, 0)
        let _h260 = argof(inout e, p, t.a, qa)
        let _h288 = argof(inout e, p, t.a, qb)
        let _h95 = eq_val(inout e, p, t.a, _h260, _h288)
        ret_false_unless(inout e, p, _h95)
    } else if k == types.T_RECORD || k == types.T_TUPLE {
        let ms = abi.parts(p, ty, NONE)
        for i in 0..ms.len() {
            let xa = part_addr(inout e, p, ty, a, i as u32)
            let xb = part_addr(inout e, p, ty, b, i as u32)
            let _h261 = argof(inout e, p, ms[i], xa)
            let _h289 = argof(inout e, p, ms[i], xb)
            let _h96 = eq_val(inout e, p, ms[i], _h261, _h289)
            ret_false_unless(inout e, p, _h96)
        }
    } else if k == types.T_ENUM {
        let d = types.def_of(p.t, ty)
        let ta = tag_of(inout e, p, ty, a)
        let tb = tag_of(inout e, p, ty, b)
        let _h97 = val(inout e, catb(lit("icmp eq i32 "), catb(ta, catb(lit(", "), tb))))
        ret_false_unless(inout e, p, _h97)
        for i in 0..d.len {
            let v = types.variant(p.t, d, i)
            if v.flen == 0 {
                continue
            }
            let _h98 = tag_is(inout e, ta, i)
            let j = if_then(inout e, _h98)
            for fi in 0..v.flen {
                let ft = types.field(p.t, v.fstart, fi).ty
                let xa = payload_addr(inout e, p, ty, a, i, fi)
                let xb = payload_addr(inout e, p, ty, b, i, fi)
                let _h262 = argof(inout e, p, ft, xa)
                let _h290 = argof(inout e, p, ft, xb)
                let _h99 = eq_val(inout e, p, ft, _h262, _h290)
                ret_false_unless(inout e, p, _h99)
            }
            gret_v(inout e, p, lit("true"))
            if_end(inout e, j)
        }
    }
    gret_v(inout e, p, lit("true"))
    gfn_end(inout e, p, gf)
}

/// One part of a lexicographic order: return its order (-1 or 1) when it isn't 0.
fn cmp_part(inout e: E, p: lower.P, ty: u32, xa: List[u8], xb: List[u8]) {
    let _h100 = argof(inout e, p, ty, xa)
    let _h263 = argof(inout e, p, ty, xb)
    let r = cmp_val(inout e, p, ty, _h100, _h263)
    let _h101 = val(inout e, catb(lit("icmp ne i32 "), cat(r, ", 0")))
    let j = if_then(inout e, _h101)
    let lt = val(inout e, catb(lit("icmp slt i32 "), cat(r, ", 0")))
    let _h102 = val(inout e, catb(lit("select i1 "), cat(lt, ", i32 -1, i32 1")))
    gret_v(inout e, p, _h102)
    if_end(inout e, j)
}

fn g_cmp(inout e: E, p: lower.P, ty: u32) {
    let _h103 = gname(e, "cmp_", ty)
    let gf = gfn_begin(inout e, p, _h103, tys2(ty, ty), types.I32)
    let a = gf.args[0].copy()
    let b = gf.args[1].copy()
    let f = lower.custom_fn(p, lower.TR_ORD, ty)
    if f != NONE {
        // Ordering: Less, Equal, Greater -> -1, 0, 1
        let ot = p.ir.fns[f as usize].ret
        let o = temp(inout e, p, ot)
        call_user(inout e, p, f, args2(a, b), o)
        let tg = tag_of(inout e, p, ot, o)
        let _h104 = val(inout e, catb(lit("sub i32 "), cat(tg, ", 1")))
        gret_v(inout e, p, _h104)
        gfn_end(inout e, p, gf)
        return
    }
    let t = types.get(p.t, ty)
    let k = t.kind
    if k == types.T_RECORD || k == types.T_TUPLE {
        let ms = abi.parts(p, ty, NONE)
        for i in 0..ms.len() {
            let _h105 = part_addr(inout e, p, ty, a, i as u32)
            let _h264 = part_addr(inout e, p, ty, b, i as u32)
            cmp_part(inout e, p, ms[i], _h105, _h264)
        }
    } else if k == types.T_ENUM {
        // by variant order, then by the payload
        let d = types.def_of(p.t, ty)
        let ta = tag_of(inout e, p, ty, a)
        let tb = tag_of(inout e, p, ty, b)
        let ne = val(inout e, catb(lit("icmp ne i32 "), catb(ta, catb(lit(", "), tb))))
        let j0 = if_then(inout e, ne)
        let lt = val(inout e, catb(lit("icmp ult i32 "), catb(ta, catb(lit(", "), tb))))
        let _h106 = val(inout e, catb(lit("select i1 "), cat(lt, ", i32 -1, i32 1")))
        gret_v(inout e, p, _h106)
        if_end(inout e, j0)
        for i in 0..d.len {
            let v = types.variant(p.t, d, i)
            if v.flen == 0 {
                continue
            }
            let _h107 = tag_is(inout e, ta, i)
            let j = if_then(inout e, _h107)
            for fi in 0..v.flen {
                let _h108 = payload_addr(inout e, p, ty, a, i, fi)
                let _h265 = payload_addr(inout e, p, ty, b, i, fi)
                cmp_part(inout e, p, types.field(p.t, v.fstart, fi).ty, _h108, _h265)
            }
            if_end(inout e, j)
        }
    } else if k == types.T_ARRAY {
        if t.b > 0 {
            let lp = loop_n(inout e, p, bytes.from_u64(t.b as u64))
            let _h109 = arr_elem(inout e, p, ty, a, lp.iv)
            let _h266 = arr_elem(inout e, p, ty, b, lp.iv)
            cmp_part(inout e, p, t.a, _h109, _h266)
            loop_next(inout e, lp)
        }
    } else if k == types.T_LIST {
        let la = load_i64_field(inout e, p, ty, a, 1)
        let lb = load_i64_field(inout e, p, ty, b, 1)
        let lt = val(inout e, catb(lit("icmp ult i64 "), catb(la, catb(lit(", "), lb))))
        let mn = val(inout e, catb(lit("select i1 "), catb(lt, catb(lit(", i64 "), catb(la, catb(lit(", i64 "), lb))))))
        let da = load_ptr_field(inout e, p, ty, a, 0)
        let db = load_ptr_field(inout e, p, ty, b, 0)
        let lp = loop_n(inout e, p, mn)
        let _h110 = elem(inout e, p, t.a, da, lp.iv)
        let _h267 = elem(inout e, p, t.a, db, lp.iv)
        cmp_part(inout e, p, t.a, _h110, _h267)
        loop_next(inout e, lp)
        let gt = val(inout e, catb(lit("icmp ugt i64 "), catb(la, catb(lit(", "), lb))))
        let g32 = val(inout e, catb(lit("zext i1 "), cat(gt, " to i32")))
        let l32 = val(inout e, catb(lit("zext i1 "), cat(lt, " to i32")))
        let _h111 = val(inout e, catb(lit("sub i32 "), catb(g32, catb(lit(", "), l32))))
        gret_v(inout e, p, _h111)
    } else if k == types.T_BOX {
        let _h112 = load_ptr_field(inout e, p, ty, a, 0)
        let _h268 = load_ptr_field(inout e, p, ty, b, 0)
        cmp_part(inout e, p, t.a, _h112, _h268)
    }
    if !e.term {
        gret_v(inout e, p, lit("0"))
    }
    gfn_end(inout e, p, gf)
}

/// h = mix64(h ^ <hash of the part at xa>), h in the alloca at ha.
fn hash_part(inout e: E, p: lower.P, ty: u32, ha: List[u8], xa: List[u8]) {
    let _h113 = argof(inout e, p, ty, xa)
    let hv = hash_val(inout e, p, ty, _h113)
    let h = load_i64(inout e, ha)
    let x = val(inout e, catb(lit("xor i64 "), catb(h, catb(lit(", "), hv))))
    let _h114 = mix64(inout e, x)
    store_i64(inout e, _h114, ha)
}

fn g_hash(inout e: E, p: lower.P, ty: u32) {
    let _h115 = gname(e, "hash_", ty)
    let gf = gfn_begin(inout e, p, _h115, tys1(ty), types.U64)
    let x = gf.args[0].copy()
    let f = lower.custom_fn(p, lower.TR_HASH, ty)
    if f != NONE {
        let none: List[u8] = List.new()
        let r = call_user(inout e, p, f, args1(x), none)
        gret_v(inout e, p, r)
        gfn_end(inout e, p, gf)
        return
    }
    let t = types.get(p.t, ty)
    let k = t.kind
    let ha = temp(inout e, p, types.U64)
    // 0x9e3779b97f4a7c15
    store_i64(inout e, lit("-7046029254386353131"), ha)
    if k == types.T_RECORD || k == types.T_TUPLE {
        let ms = abi.parts(p, ty, NONE)
        for i in 0..ms.len() {
            let _h116 = part_addr(inout e, p, ty, x, i as u32)
            hash_part(inout e, p, ms[i], ha, _h116)
        }
    } else if k == types.T_ENUM {
        let d = types.def_of(p.t, ty)
        let tg = tag_of(inout e, p, ty, x)
        let h = load_i64(inout e, ha)
        let t64 = val(inout e, catb(lit("zext i32 "), cat(tg, " to i64")))
        let _h269 = val(inout e, catb(lit("xor i64 "), catb(h, catb(lit(", "), t64))))
        let _h117 = mix64(inout e, _h269)
        store_i64(inout e, _h117, ha)
        for i in 0..d.len {
            let v = types.variant(p.t, d, i)
            if v.flen == 0 {
                continue
            }
            let _h118 = tag_is(inout e, tg, i)
            let j = if_then(inout e, _h118)
            for fi in 0..v.flen {
                let _h119 = payload_addr(inout e, p, ty, x, i, fi)
                hash_part(inout e, p, types.field(p.t, v.fstart, fi).ty, ha, _h119)
            }
            if_end(inout e, j)
        }
    } else if k == types.T_ARRAY {
        let lp = loop_n(inout e, p, bytes.from_u64(t.b as u64))
        let _h120 = arr_elem(inout e, p, ty, x, lp.iv)
        hash_part(inout e, p, t.a, ha, _h120)
        loop_next(inout e, lp)
    } else if k == types.T_LIST {
        let n = load_i64_field(inout e, p, ty, x, 1)
        let h = load_i64(inout e, ha)
        let _h270 = val(inout e, catb(lit("xor i64 "), catb(h, catb(lit(", "), n))))
        let _h121 = mix64(inout e, _h270)
        store_i64(inout e, _h121, ha)
        let d = load_ptr_field(inout e, p, ty, x, 0)
        let lp = loop_n(inout e, p, n)
        let _h122 = elem(inout e, p, t.a, d, lp.iv)
        hash_part(inout e, p, t.a, ha, _h122)
        loop_next(inout e, lp)
    } else if k == types.T_BOX {
        let _h123 = load_ptr_field(inout e, p, ty, x, 0)
        hash_part(inout e, p, t.a, ha, _h123)
    }
    let _h124 = load_i64(inout e, ha)
    gret_v(inout e, p, _h124)
    gfn_end(inout e, p, gf)
}

/// Append the text of the value of type ty at address xa to the String at o, as a part of
/// another value: text quoted (lower.ei's show_into with `quoted`).
fn show_part(inout e: E, p: lower.P, ty: u32, o: List[u8], xa: List[u8]) {
    let k = kind(p, ty)
    if k == types.T_STR || k == types.T_STRING {
        let s = if k == types.T_STRING { load_ptr_field(inout e, p, ty, xa, 0) } else { load(inout e, p, ty, xa) }
        let none: List[u8] = List.new()
        call(inout e, p, lit("ei_str_push_quoted"), tys2(PTR + types.STRING, types.STR), args2(o, s), types.UNIT, none)
        return
    }
    let _h125 = argof(inout e, p, ty, xa)
    show_into(inout e, p, ty, o, _h125)
}

fn g_show(inout e: E, p: lower.P, ty: u32) {
    let sp = PTR + types.STRING
    let _h126 = gname(e, "show_", ty)
    let gf = gfn_begin(inout e, p, _h126, tys2(sp, ty), types.UNIT)
    let o = gf.args[0].copy()
    let x = gf.args[1].copy()
    let f = lower.custom_fn(p, lower.TR_SHOW, ty)
    if f != NONE {
        let none: List[u8] = List.new()
        call_user(inout e, p, f, args2(x, o), none)
        gfn_end(inout e, p, gf)
        return
    }
    let t = types.get(p.t, ty)
    let k = t.kind
    if k == types.T_RECORD {
        // `Name { a: 1, b: "x" }`
        let d = types.def_of(p.t, ty)
        let mut head = shown_name(p, d.key)
        if d.len == 0 { bytes.append(inout head, lit(r" {}")) } else { bytes.append(inout head, lit(r" { ")) }
        show_text(inout e, p, o, head)
        for i in 0..d.len {
            let fl = types.field(p.t, d.start, i)
            let mut lab: List[u8] = List.new()
            if i > 0 {
                bytes.append(inout lab, lit(", "))
            }
            bytes.append(inout lab, intern.name(p.names, fl.name))
            bytes.append(inout lab, lit(": "))
            show_text(inout e, p, o, lab)
            let _h127 = part_addr(inout e, p, ty, x, i)
            show_part(inout e, p, fl.ty, o, _h127)
        }
        if d.len > 0 {
            show_text(inout e, p, o, lit(r" }"))
        }
    } else if k == types.T_TUPLE {
        // `(1, "x")`, `(1,)`
        let es = types.elems(p.t, ty)
        show_text(inout e, p, o, lit("("))
        for i in 0..es.len() {
            if i > 0 {
                show_text(inout e, p, o, lit(", "))
            }
            let _h128 = field_addr(inout e, p, ty, x, i as u32)
            show_part(inout e, p, es[i], o, _h128)
        }
        if es.len() == 1 {
            show_text(inout e, p, o, lit(","))
        }
        show_text(inout e, p, o, lit(")"))
    } else if k == types.T_ENUM {
        // `Some(1)`, `None`
        let d = types.def_of(p.t, ty)
        let tg = tag_of(inout e, p, ty, x)
        for i in 0..d.len {
            let v = types.variant(p.t, d, i)
            let _h129 = tag_is(inout e, tg, i)
            let j = if_then(inout e, _h129)
            let mut nmv = shown_name(p, v.key)
            if v.flen > 0 {
                nmv.push(40)
            }
            show_text(inout e, p, o, nmv)
            for fi in 0..v.flen {
                if fi > 0 {
                    show_text(inout e, p, o, lit(", "))
                }
                let _h130 = payload_addr(inout e, p, ty, x, i, fi)
                show_part(inout e, p, types.field(p.t, v.fstart, fi).ty, o, _h130)
            }
            if v.flen > 0 {
                show_text(inout e, p, o, lit(")"))
            }
            if_end(inout e, j)
        }
    } else if k == types.T_ARRAY || k == types.T_LIST {
        // `[1, 2]`
        show_text(inout e, p, o, lit("["))
        let mut n = bytes.from_u64(t.b as u64)
        let mut d: List[u8] = List.new()
        if k == types.T_LIST {
            n = load_i64_field(inout e, p, ty, x, 1)
            d = load_ptr_field(inout e, p, ty, x, 0)
        }
        let lp = loop_n(inout e, p, n)
        let _h131 = val(inout e, catb(lit("icmp ne i64 "), cat(lp.iv, ", 0")))
        let j = if_then(inout e, _h131)
        show_text(inout e, p, o, lit(", "))
        if_end(inout e, j)
        let xa = if k == types.T_LIST { elem(inout e, p, t.a, d, lp.iv) } else { arr_elem(inout e, p, ty, x, lp.iv) }
        show_part(inout e, p, t.a, o, xa)
        loop_next(inout e, lp)
        show_text(inout e, p, o, lit("]"))
    } else if k == types.T_MAP {
        // `{1: "a", 2: "b"}`, in slot order
        show_text(inout e, p, o, lit(r"{"))
        let first = temp(inout e, p, types.BOOL)
        stmt_text(inout e, catb(lit("store i8 1, ptr "), first))
        let kp = load_ptr_field(inout e, p, ty, x, 0)
        let vp = load_ptr_field(inout e, p, ty, x, 1)
        let s = load_ptr_field(inout e, p, ty, x, 2)
        let cap = load_i64_field(inout e, p, ty, x, 4)
        let lp = loop_n(inout e, p, cap)
        let _h132 = catb(lit("load i8, ptr "), elem(inout e, p, types.U8, s, lp.iv))
        let sv = val(inout e, _h132)
        let _h133 = val(inout e, catb(lit("icmp eq i8 "), cat(sv, ", 1")))
        let j = if_then(inout e, _h133)
        let fv = load(inout e, p, types.BOOL, first)
        let _h134 = val(inout e, catb(lit("xor i1 "), cat(fv, ", true")))
        let j2 = if_then(inout e, _h134)
        show_text(inout e, p, o, lit(", "))
        if_end(inout e, j2)
        stmt_text(inout e, catb(lit("store i8 0, ptr "), first))
        let _h135 = elem(inout e, p, t.a, kp, lp.iv)
        show_part(inout e, p, t.a, o, _h135)
        show_text(inout e, p, o, lit(": "))
        let _h136 = elem(inout e, p, t.b, vp, lp.iv)
        show_part(inout e, p, t.b, o, _h136)
        if_end(inout e, j)
        loop_next(inout e, lp)
        show_text(inout e, p, o, lit(r"}"))
    } else if k == types.T_BOX {
        show_text(inout e, p, o, lit("Box("))
        let _h137 = load_ptr_field(inout e, p, ty, x, 0)
        show_part(inout e, p, t.a, o, _h137)
        show_text(inout e, p, o, lit(")"))
    }
    gfn_end(inout e, p, gf)
}

/// A type or variant name as printing (derived Show) spells it (lower.ei's shown_name).
fn shown_name(p: lower.P, key: u64) -> List[u8] { intern.name(p.names, resolve.key_sym(key)) }

/// `name_T(u32 tag) -> ptr`: the variant's name, from a constant table.
fn g_name(inout e: E, p: lower.P, ty: u32) {
    let d = types.def_of(p.t, ty)
    let mut tab = catb(lit("@names."), e.tn[ty as usize])
    let mut def = tab.copy()
    bytes.append(inout def, lit(" = private unnamed_addr constant ["))
    wd(inout def, d.len as u64)
    bytes.append(inout def, lit(" x ptr] ["))
    for i in 0..d.len {
        if i > 0 {
            bytes.append(inout def, lit(", "))
        }
        bytes.append(inout def, lit("ptr "))
        bytes.append(inout def, msgb(inout e, shown_name(p, types.variant(p.t, d, i).key)))
    }
    bytes.append(inout def, lit("]\n"))
    bytes.append(inout e.gl, def)
    let _h138 = gname(e, "name_", ty)
    let gf = gfn_begin(inout e, p, _h138, tys1(types.U32), types.STR)
    let i64t = val(inout e, catb(lit("zext i32 "), cat(gf.args[0], " to i64")))
    let mut g = lit("getelementptr inbounds [")
    wd(inout g, d.len as u64)
    bytes.append(inout g, lit(" x ptr], ptr "))
    bytes.append(inout g, tab)
    bytes.append(inout g, lit(", i64 0, i64 "))
    bytes.append(inout g, i64t)
    let a = val(inout e, g)
    let _h139 = load_p(inout e, a)
    gret_v(inout e, p, _h139)
    gfn_end(inout e, p, gf)
}

// ---- List, text, Box, Map

fn g_push(inout e: E, p: lower.P, ty: u32) {
    let el = types.get(p.t, ty).a
    let _h140 = gname(e, "push_", ty)
    let gf = gfn_begin(inout e, p, _h140, tys2(PTR + ty, el), types.UNIT)
    let l = gf.args[0].copy()
    let xa = addrof(inout e, p, el, gf.args[1])
    uniq_call(inout e, p, ty, l)
    let n = load_i64_field(inout e, p, ty, l, 1)
    let cap = load_i64_field(inout e, p, ty, l, 2)
    let _h141 = val(inout e, catb(lit("icmp eq i64 "), catb(n, catb(lit(", "), cap))))
    let j = if_then(inout e, _h141)
    let nc = rt_call(inout e, p, "ei_grow_cap", tys4(types.U64, types.U64, types.U64, types.U64), args4(cap, n, lit("1"), lit("4")), types.U64)
    if e.prof > 0 {
        let es0 = size(inout e, p, el)
        let gb = mul_const(inout e, nc, es0)
        prof_ev(inout e, p, PEV_GROW, gb)
    }
    let d0 = load_ptr_field(inout e, p, ty, l, 0)
    let _h142 = args3(d0, nc, bytes.from_u64(size(inout e, p, el)))
    let nd = rt_call(inout e, p, "ei_buf_grow", tys3(types.STR, types.U64, types.U64), _h142, types.STR)
    store_field_ptr(inout e, p, ty, l, 0, nd)
    store_field_i64(inout e, p, ty, l, 2, nc)
    if_end(inout e, j)
    let d = load_ptr_field(inout e, p, ty, l, 0)
    if !is_void(el) {
        let _h143 = elem(inout e, p, el, d, n)
        copy_mem(inout e, p, el, _h143, xa)
    }
    let _h144 = val(inout e, catb(lit("add nuw i64 "), cat(n, ", 1")))
    store_field_i64(inout e, p, ty, l, 1, _h144)
    gfn_end(inout e, p, gf)
}

fn g_has(inout e: E, p: lower.P, ty: u32) {
    let el = types.get(p.t, ty).a
    let _h145 = gname(e, "has_", ty)
    let gf = gfn_begin(inout e, p, _h145, tys2(PTR + ty, el), types.BOOL)
    let l = gf.args[0].copy()
    let x = gf.args[1].copy()
    let n = load_i64_field(inout e, p, ty, l, 1)
    let d = load_ptr_field(inout e, p, ty, l, 0)
    let lp = loop_n(inout e, p, n)
    let _h271 = elem(inout e, p, el, d, lp.iv)
    let _h146 = argof(inout e, p, el, _h271)
    let c = eq_val(inout e, p, el, _h146, x)
    let j = if_then(inout e, c)
    gret_v(inout e, p, lit("true"))
    if_end(inout e, j)
    loop_next(inout e, lp)
    gret_v(inout e, p, lit("false"))
    gfn_end(inout e, p, gf)
}

/// `bytes_L(s, n)`: a List[u8] holding bytes s[0..n); `utf8_R(d, n)`: Ok(the String of
/// bytes d[0..n)) when they are valid UTF-8 without NUL, else Err(offset of the first bad
/// byte), for R = Result[String, usize].
fn g_text(inout e: E, p: lower.P, kd: u32, ty: u32) {
    if kd == lower.GK_BYTES {
        let _h147 = gname(e, "bytes_", ty)
        let gf = gfn_begin(inout e, p, _h147, tys2(types.STR, types.U64), ty)
        let s = gf.args[0].copy()
        let n = gf.args[1].copy()
        let r = temp(inout e, p, ty)
        zero(inout e, p, ty, r)
        let _h148 = val(inout e, catb(lit("icmp ne i64 "), cat(n, ", 0")))
        let j = if_then(inout e, _h148)
        let d = buf_alloc(inout e, p, n, 1)
        dyn_memcpy(inout e, d, s, n)
        store_field_ptr(inout e, p, ty, r, 0, d)
        store_field_i64(inout e, p, ty, r, 1, n)
        store_field_i64(inout e, p, ty, r, 2, n)
        if_end(inout e, j)
        gret_a(inout e, p, r)
        gfn_end(inout e, p, gf)
        return
    }
    let _h149 = gname(e, "utf8_", ty)
    let gf = gfn_begin(inout e, p, _h149, tys2(types.STR, types.U64), ty)
    let d = gf.args[0].copy()
    let n = gf.args[1].copy()
    let r = temp(inout e, p, ty)
    zero(inout e, p, ty, r)
    let bad = rt_call(inout e, p, "ei_utf8_check", tys2(types.STR, types.U64), args2(d, n), types.U64)
    let ok = val(inout e, catb(lit("icmp eq i64 "), catb(bad, catb(lit(", "), n))))
    let lo = new_label(inout e)
    let le = new_label(inout e)
    let lj = new_label(inout e)
    condbr(inout e, ok, lo, le)
    label(inout e, lo)
    store_tag(inout e, p, ty, r, 0)
    let _h150 = payload_addr(inout e, p, ty, r, 0, 0)
    call(inout e, p, lit("ei_str_from_n"), tys2(types.STR, types.U64), args2(d, n), types.STRING, _h150)
    br(inout e, lj)
    label(inout e, le)
    store_tag(inout e, p, ty, r, 1)
    let _h151 = payload_addr(inout e, p, ty, r, 1, 0)
    store_i64(inout e, bad, _h151)
    label(inout e, lj)
    gret_a(inout e, p, r)
    gfn_end(inout e, p, gf)
}

/// `new_B(v)` for Box type ty (moves v in).
fn g_box(inout e: E, p: lower.P, ty: u32) {
    let el = types.get(p.t, ty).a
    let _h152 = gname(e, "new_", ty)
    let gf = gfn_begin(inout e, p, _h152, tys1(el), ty)
    let va = addrof(inout e, p, el, gf.args[0])
    let r = temp(inout e, p, ty)
    let _h153 = size(inout e, p, el)
    let q = buf_alloc(inout e, p, lit("1"), _h153)
    if !is_void(el) {
        copy_mem(inout e, p, el, q, va)
    }
    store_field_ptr(inout e, p, ty, r, 0, q)
    gret_a(inout e, p, r)
    gfn_end(inout e, p, gf)
}

/// hash(key) & (cap - 1)
fn slot_of(inout e: E, p: lower.P, kt: u32, kv: List[u8], cap: List[u8]) -> List[u8] {
    let h = hash_val(inout e, p, kt, kv)
    let m = val(inout e, catb(lit("sub i64 "), cat(cap, ", 1")))
    val(inout e, catb(lit("and i64 "), catb(h, catb(lit(", "), m))))
}

fn next_slot(inout e: E, i: List[u8], cap: List[u8]) -> List[u8] {
    let m = val(inout e, catb(lit("sub i64 "), cat(cap, ", 1")))
    let n = val(inout e, catb(lit("add i64 "), cat(i, ", 1")))
    val(inout e, catb(lit("and i64 "), catb(n, catb(lit(", "), m))))
}

fn slot_state(inout e: E, p: lower.P, s: List[u8], i: List[u8]) -> List[u8] {
    let a = elem(inout e, p, types.U8, s, i)
    val(inout e, catb(lit("load i8, ptr "), a))
}

/// The Map operations: `find_M` (slot or -1), `get_M` (pointer to the value or null), `ins_M`
/// (moves key and value in; an existing key keeps its slot, its old value and the new key
/// are dropped), `rem_M` (drops the entry; true if it was there).
fn g_map(inout e: E, p: lower.P, kd: u32, ty: u32) {
    let t = types.get(p.t, ty)
    let kt = t.a
    let vt = t.b
    let none: List[u8] = List.new()
    if kd == lower.GK_FIND {
        let _h155 = gname(e, "find_", ty)
        let gf = gfn_begin(inout e, p, _h155, tys2(PTR + ty, kt), types.I64)
        let m = gf.args[0].copy()
        let key = gf.args[1].copy()
        let cap = load_i64_field(inout e, p, ty, m, 4)
        let _h156 = val(inout e, catb(lit("icmp eq i64 "), cat(cap, ", 0")))
        let j0 = if_then(inout e, _h156)
        gret_v(inout e, p, lit("-1"))
        if_end(inout e, j0)
        let s = load_ptr_field(inout e, p, ty, m, 2)
        let kp = load_ptr_field(inout e, p, ty, m, 0)
        let ia = temp(inout e, p, types.U64)
        let _h157 = slot_of(inout e, p, kt, key, cap)
        store_i64(inout e, _h157, ia)
        let lp = loop_n(inout e, p, cap)
        let i = load_i64(inout e, ia)
        let sv = slot_state(inout e, p, s, i)
        let _h158 = val(inout e, catb(lit("icmp eq i8 "), cat(sv, ", 0")))
        let j1 = if_then(inout e, _h158)
        gret_v(inout e, p, lit("-1"))
        if_end(inout e, j1)
        let _h159 = val(inout e, catb(lit("icmp eq i8 "), cat(sv, ", 1")))
        let j2 = if_then(inout e, _h159)
        let _h272 = elem(inout e, p, kt, kp, i)
        let _h160 = argof(inout e, p, kt, _h272)
        let c = eq_val(inout e, p, kt, _h160, key)
        let j3 = if_then(inout e, c)
        gret_v(inout e, p, i)
        if_end(inout e, j3)
        if_end(inout e, j2)
        let _h161 = next_slot(inout e, i, cap)
        store_i64(inout e, _h161, ia)
        loop_next(inout e, lp)
        gret_v(inout e, p, lit("-1"))
        gfn_end(inout e, p, gf)
        return
    }
    gneed(inout e, lower.GK_FIND, ty)
    let fname = gname(e, "find_", ty)
    if kd == lower.GK_GET {
        let _h162 = gname(e, "get_", ty)
        let gf = gfn_begin(inout e, p, _h162, tys2(PTR + ty, kt), types.STR)
        let m = gf.args[0].copy()
        let f = rt_call_b(inout e, p, fname, tys2(PTR + ty, kt), args2(m, gf.args[1]), types.I64)
        let _h163 = val(inout e, catb(lit("icmp slt i64 "), cat(f, ", 0")))
        let j = if_then(inout e, _h163)
        gret_v(inout e, p, lit("null"))
        if_end(inout e, j)
        let vp = load_ptr_field(inout e, p, ty, m, 1)
        let _h164 = elem(inout e, p, vt, vp, f)
        gret_v(inout e, p, _h164)
        gfn_end(inout e, p, gf)
        return
    }
    if kd == lower.GK_REM {
        let _h165 = gname(e, "rem_", ty)
        let gf = gfn_begin(inout e, p, _h165, tys2(PTR + ty, kt), types.BOOL)
        let m = gf.args[0].copy()
        let f = rt_call_b(inout e, p, fname, tys2(PTR + ty, kt), args2(m, gf.args[1]), types.I64)
        let _h166 = val(inout e, catb(lit("icmp slt i64 "), cat(f, ", 0")))
        let j = if_then(inout e, _h166)
        gret_v(inout e, p, lit("false"))
        if_end(inout e, j)
        // a copy keeps the slots, so f stays valid
        uniq_call(inout e, p, ty, m)
        let _h273 = load_ptr_field(inout e, p, ty, m, 0)
        let _h167 = elem(inout e, p, kt, _h273, f)
        drop_at(inout e, p, kt, _h167)
        let _h274 = load_ptr_field(inout e, p, ty, m, 1)
        let _h168 = elem(inout e, p, vt, _h274, f)
        drop_at(inout e, p, vt, _h168)
        let _h275 = load_ptr_field(inout e, p, ty, m, 2)
        let _h169 = catb(lit("store i8 2, ptr "), elem(inout e, p, types.U8, _h275, f))
        stmt_text(inout e, _h169)
        let n = load_i64_field(inout e, p, ty, m, 3)
        let _h170 = val(inout e, catb(lit("sub i64 "), cat(n, ", 1")))
        store_field_i64(inout e, p, ty, m, 3, _h170)
        gret_v(inout e, p, lit("true"))
        gfn_end(inout e, p, gf)
        return
    }
    let _h171 = gname(e, "ins_", ty)
    let gf = gfn_begin(inout e, p, _h171, tys3(PTR + ty, kt, vt), types.UNIT)
    let m = gf.args[0].copy()
    let key = gf.args[1].copy()
    let ka = addrof(inout e, p, kt, key)
    let va = addrof(inout e, p, vt, gf.args[2])
    let f = rt_call_b(inout e, p, fname, tys2(PTR + ty, kt), args2(m, key), types.I64)
    uniq_call(inout e, p, ty, m)
    let _h172 = val(inout e, catb(lit("icmp sge i64 "), cat(f, ", 0")))
    let j0 = if_then(inout e, _h172)
    let _h173 = load_ptr_field(inout e, p, ty, m, 1)
    let vf = elem(inout e, p, vt, _h173, f)
    drop_at(inout e, p, vt, vf)
    drop_at(inout e, p, kt, ka)
    if !is_void(vt) {
        copy_mem(inout e, p, vt, vf, va)
    }
    gret_void(inout e)
    if_end(inout e, j0)
    // grow at 3/4 full (used counts removed slots too)
    let used = load_i64_field(inout e, p, ty, m, 5)
    let cap = load_i64_field(inout e, p, ty, m, 4)
    let _h174 = catb(lit("mul i64 "), cat(val(inout e, catb(lit("add i64 "), cat(used, ", 1"))), ", 4"))
    let u4 = val(inout e, _h174)
    let c3 = val(inout e, catb(lit("mul i64 "), cat(cap, ", 3")))
    let _h175 = val(inout e, catb(lit("icmp ugt i64 "), catb(u4, catb(lit(", "), c3))))
    let jg = if_then(inout e, _h175)
    let nc = rt_call(inout e, p, "ei_grow_cap", tys4(types.U64, types.U64, types.U64, types.U64), args4(cap, cap, lit("1"), lit("8")), types.U64)
    if e.prof > 0 {
        let w0 = size(inout e, p, kt) + size(inout e, p, vt) + 1
        let rb = mul_const(inout e, nc, w0)
        prof_ev(inout e, p, PEV_REHASH, rb)
    }
    let _h176 = args2(nc, bytes.from_u64(size(inout e, p, kt)))
    let nk = rt_call(inout e, p, "ei_alloc_n", tys2(types.U64, types.U64), _h176, types.STR)
    let _h177 = args2(nc, bytes.from_u64(size(inout e, p, vt)))
    let nv = rt_call(inout e, p, "ei_alloc_n", tys2(types.U64, types.U64), _h177, types.STR)
    let ns = buf_alloc(inout e, p, nc, 1)
    dyn_memset0(inout e, ns, nc)
    let ok = load_ptr_field(inout e, p, ty, m, 0)
    let ov = load_ptr_field(inout e, p, ty, m, 1)
    let os = load_ptr_field(inout e, p, ty, m, 2)
    let lp = loop_n(inout e, p, cap)
    let sv = slot_state(inout e, p, os, lp.iv)
    let _h178 = val(inout e, catb(lit("icmp eq i8 "), cat(sv, ", 1")))
    let j1 = if_then(inout e, _h178)
    let kj = elem(inout e, p, kt, ok, lp.iv)
    let ia = temp(inout e, p, types.U64)
    let _h276 = argof(inout e, p, kt, kj)
    let _h179 = slot_of(inout e, p, kt, _h276, nc)
    store_i64(inout e, _h179, ia)
    let wh = new_label(inout e)
    let wb_ = new_label(inout e)
    let wd_ = new_label(inout e)
    label(inout e, wh)
    let i = load_i64(inout e, ia)
    let si = slot_state(inout e, p, ns, i)
    let _h180 = val(inout e, catb(lit("icmp ne i8 "), cat(si, ", 0")))
    condbr(inout e, _h180, wb_, wd_)
    label(inout e, wb_)
    let _h181 = next_slot(inout e, i, nc)
    store_i64(inout e, _h181, ia)
    br(inout e, wh)
    label(inout e, wd_)
    let i2 = load_i64(inout e, ia)
    if !is_void(kt) {
        let _h182 = elem(inout e, p, kt, nk, i2)
        copy_mem(inout e, p, kt, _h182, kj)
    }
    if !is_void(vt) {
        let _h183 = elem(inout e, p, vt, nv, i2)
        let _h277 = elem(inout e, p, vt, ov, lp.iv)
        copy_mem(inout e, p, vt, _h183, _h277)
    }
    let _h184 = catb(lit("store i8 1, ptr "), elem(inout e, p, types.U8, ns, i2))
    stmt_text(inout e, _h184)
    if_end(inout e, j1)
    loop_next(inout e, lp)
    rt_free(inout e, p, ok)
    rt_free(inout e, p, ov)
    buf_free(inout e, p, os)
    store_field_ptr(inout e, p, ty, m, 0, nk)
    store_field_ptr(inout e, p, ty, m, 1, nv)
    store_field_ptr(inout e, p, ty, m, 2, ns)
    store_field_i64(inout e, p, ty, m, 4, nc)
    let _h185 = load_i64_field(inout e, p, ty, m, 3)
    store_field_i64(inout e, p, ty, m, 5, _h185)
    if_end(inout e, jg)
    let cap2 = load_i64_field(inout e, p, ty, m, 4)
    let s = load_ptr_field(inout e, p, ty, m, 2)
    let ia2 = temp(inout e, p, types.U64)
    let _h186 = slot_of(inout e, p, kt, key, cap2)
    store_i64(inout e, _h186, ia2)
    let wh2 = new_label(inout e)
    let wb2 = new_label(inout e)
    let wd2 = new_label(inout e)
    label(inout e, wh2)
    let k2 = load_i64(inout e, ia2)
    let s2 = slot_state(inout e, p, s, k2)
    let _h187 = val(inout e, catb(lit("icmp eq i8 "), cat(s2, ", 1")))
    condbr(inout e, _h187, wb2, wd2)
    label(inout e, wb2)
    let _h188 = next_slot(inout e, k2, cap2)
    store_i64(inout e, _h188, ia2)
    br(inout e, wh2)
    label(inout e, wd2)
    let k3 = load_i64(inout e, ia2)
    let s3 = slot_state(inout e, p, s, k3)
    let _h189 = val(inout e, catb(lit("icmp eq i8 "), cat(s3, ", 0")))
    let ju = if_then(inout e, _h189)
    let u = load_i64_field(inout e, p, ty, m, 5)
    let _h190 = val(inout e, catb(lit("add i64 "), cat(u, ", 1")))
    store_field_i64(inout e, p, ty, m, 5, _h190)
    if_end(inout e, ju)
    if !is_void(kt) {
        let _h278 = load_ptr_field(inout e, p, ty, m, 0)
        let _h191 = elem(inout e, p, kt, _h278, k3)
        copy_mem(inout e, p, kt, _h191, ka)
    }
    if !is_void(vt) {
        let _h279 = load_ptr_field(inout e, p, ty, m, 1)
        let _h192 = elem(inout e, p, vt, _h279, k3)
        copy_mem(inout e, p, vt, _h192, va)
    }
    let _h193 = catb(lit("store i8 1, ptr "), elem(inout e, p, types.U8, s, k3))
    stmt_text(inout e, _h193)
    let n = load_i64_field(inout e, p, ty, m, 3)
    let _h194 = val(inout e, catb(lit("add i64 "), cat(n, ", 1")))
    store_field_i64(inout e, p, ty, m, 3, _h194)
    gfn_end(inout e, p, gf)
}

// ---- closures

/// The environment of closure body f (`{ c0, c1, ... }`) and its drop (`edrop_F`), clone
/// (`eclone_F`) and own (`eown_F`), which the closure value points to.
fn g_env(inout e: E, p: lower.P, f: u32) {
    let fd = p.ir.fns[f as usize]
    let n = e.ncap[f as usize].copy()
    let fname = e.fnn[f as usize].copy()
    let mut cts: List[u32] = List.new()
    for i in 0..n {
        cts.push(p.ir.locals[(fd.lstart + i) as usize].ty)
    }
    let est = members(inout e, p, cts)
    let sz = abi.struct_of(inout e.lay, p, cts)[0]
    let gd = gfn_begin(inout e, p, catb(lit("edrop_"), fname), tys1(types.STR), types.UNIT)
    let q = gd.args[0].copy()
    for i in 0..n {
        if owns(inout e, p, cts[i as usize]) {
            let _h195 = gep(inout e, p, est, q, i)
            drop_at(inout e, p, cts[i as usize], _h195)
        }
    }
    rt_free(inout e, p, q)
    gfn_end(inout e, p, gd)
    let gc = gfn_begin(inout e, p, catb(lit("eclone_"), fname), tys1(types.STR), types.STR)
    let q2 = gc.args[0].copy()
    let r = rt_call(inout e, p, "ei_alloc", tys1(types.U64), args1(bytes.from_u64(sz)), types.STR)
    dyn_memcpy(inout e, r, q2, bytes.from_u64(sz))
    for i in 0..n {
        if owns(inout e, p, cts[i as usize]) {
            let _h196 = gep(inout e, p, est, q2, i)
            let _h280 = gep(inout e, p, est, r, i)
            clone_to(inout e, p, cts[i as usize], _h196, _h280)
        }
    }
    gret_v(inout e, p, r)
    gfn_end(inout e, p, gc)
    // before the closure runs on (or is handed to) another thread
    let go = gfn_begin(inout e, p, catb(lit("eown_"), fname), tys1(types.STR), types.UNIT)
    let q3 = go.args[0].copy()
    for i in 0..n {
        let _h197 = gep(inout e, p, est, q3, i)
        own_at(inout e, p, cts[i as usize], _h197)
    }
    gfn_end(inout e, p, go)
}

/// `k_F(env, params...)`: function f called through a fn value (no environment).
fn g_thunk(inout e: E, p: lower.P, f: u32) {
    let fd = p.ir.fns[f as usize]
    // as fn values are called (fnval_sig): the environment, then the parameters
    let mut ptys: List[u32] = List.new()
    ptys.push(types.STR)
    for t in fn_ptys(e, p, f) {
        ptys.push(t)
    }
    let _h198 = catb(lit("k_"), e.fnn[f as usize])
    let gf = gfn_begin(inout e, p, _h198, ptys, fd.ret)
    let mut args: List[List[u8]] = List.new()
    for i in 1..gf.args.len() {
        args.push(gf.args[i])
    }
    if is_void(fd.ret) {
        let none: List[u8] = List.new()
        call_user(inout e, p, f, args, none)
    } else if is_scalar(p, fd.ret) {
        let none: List[u8] = List.new()
        let r = call_user(inout e, p, f, args, none)
        gret_v(inout e, p, r)
    } else {
        let r = temp(inout e, p, fd.ret)
        call_user(inout e, p, f, args, r)
        gret_a(inout e, p, r)
    }
    gfn_end(inout e, p, gf)
}

// ---- records with their own Drop, Default, Ref

/// `rnew_T(fields...)`: a record with its own Drop, its fields moved into a new buffer.
fn g_rnew(inout e: E, p: lower.P, ty: u32) {
    let ms = abi.parts(p, ty, NONE)
    let _h199 = gname(e, "rnew_", ty)
    let gf = gfn_begin(inout e, p, _h199, ms, ty)
    let r = temp(inout e, p, ty)
    let _h200 = rec_dsize(inout e, p, ty)
    let q = buf_alloc(inout e, p, lit("1"), _h200)
    let dt = cat(num("%t", ty as u64), ".d")
    if ms.len() == 0 {
        stmt_text(inout e, catb(lit("store i8 0, ptr "), q))
    }
    for i in 0..ms.len() {
        if is_void(ms[i]) {
            continue
        }
        let a = addrof(inout e, p, ms[i], gf.args[i])
        let _h201 = gep(inout e, p, dt, q, i as u32)
        copy_mem(inout e, p, ms[i], _h201, a)
    }
    store_field_ptr(inout e, p, ty, r, 0, q)
    gret_a(inout e, p, r)
    gfn_end(inout e, p, gf)
}

/// `default_T()`: each part's Default (a record, tuple, array or Box).
fn g_default(inout e: E, p: lower.P, ty: u32) {
    let _h202 = gname(e, "default_", ty)
    let gf = gfn_begin(inout e, p, _h202, List.new(), ty)
    let r = temp(inout e, p, ty)
    zero(inout e, p, ty, r)
    let t = types.get(p.t, ty)
    let k = t.kind
    if k == types.T_RECORD || k == types.T_TUPLE {
        let ms = abi.parts(p, ty, NONE)
        for i in 0..ms.len() {
            let _h203 = part_addr(inout e, p, ty, r, i as u32)
            default_to(inout e, p, ms[i], _h203)
        }
    } else if k == types.T_ARRAY {
        if t.b > 0 {
            let lp = loop_n(inout e, p, bytes.from_u64(t.b as u64))
            let _h204 = arr_elem(inout e, p, ty, r, lp.iv)
            default_to(inout e, p, t.a, _h204)
            loop_next(inout e, lp)
        }
    } else if k == types.T_BOX {
        let _h205 = size(inout e, p, t.a)
        let q = buf_alloc(inout e, p, lit("1"), _h205)
        default_to(inout e, p, t.a, q)
        store_field_ptr(inout e, p, ty, r, 0, q)
    }
    gret_a(inout e, p, r)
    gfn_end(inout e, p, gf)
}

/// `new_R(v)`: a new Ref holding v (moved in).
fn g_refnew(inout e: E, p: lower.P, ty: u32) {
    let el = types.get(p.t, ty).a
    let _h206 = gname(e, "new_", ty)
    let gf = gfn_begin(inout e, p, _h206, tys1(el), ty)
    let va = addrof(inout e, p, el, gf.args[0])
    let r = temp(inout e, p, ty)
    let _h207 = ref_size(inout e, p, el)
    let q = buf_alloc(inout e, p, lit("1"), _h207)
    store_i64(inout e, lit("0"), q)
    if !is_void(el) {
        let _h281 = ref_voff(inout e, p, el)
        let _h208 = off_ptr(inout e, q, _h281)
        copy_mem(inout e, p, el, _h208, va)
    }
    store_field_ptr(inout e, p, ty, r, 0, q)
    gret_a(inout e, p, r)
    gfn_end(inout e, p, gf)
}

// ---- the thread handles (Task, Mutex, Chan): objects the runtime makes (core/eider_rt.h
// `ei_h_*`: a count, a lock, a thread and a channel), with the program's part in their data:
// a Task's closure and result `{ f, r }`, a Mutex's value

fn task_fn(p: lower.P, el: u32) -> u32 { types.find_comp(p.t, types.T_FN, types.EMPTY, el) }

/// A Task's data: `{ fn () -> T f, T r }` (the offset of r).
fn task_roff(inout e: E, p: lower.P, el: u32) -> u64 {
    let mut ms: List[u32] = List.new()
    ms.push(task_fn(p, el))
    ms.push(el)
    abi.offset_of(inout e.lay, p, ms, 1)
}

fn task_dsize(inout e: E, p: lower.P, el: u32) -> u64 {
    let mut ms: List[u32] = List.new()
    ms.push(task_fn(p, el))
    ms.push(el)
    abi.struct_of(inout e.lay, p, ms)[0]
}

fn h_obj(inout e: E, p: lower.P, ty: u32, a: List[u8]) -> List[u8] { load_ptr_field(inout e, p, ty, a, 0) }

fn h_data(inout e: E, p: lower.P, h: List[u8]) -> List[u8] { rt_call(inout e, p, "ei_h_data", tys1(types.STR), args1(h), types.STR) }

fn h_void(inout e: E, p: lower.P, name: str, h: List[u8]) {
    let none: List[u8] = List.new()
    call(inout e, p, lit(name), tys1(types.STR), args1(h), types.UNIT, none)
}

/// The drop of a handle at x: the last holder drops the program's part and frees the object.
fn handle_drop(inout e: E, p: lower.P, ty: u32, x: List[u8]) {
    let t = types.get(p.t, ty)
    let h = h_obj(inout e, p, ty, x)
    let last = rt_call(inout e, p, "ei_h_dec", tys1(types.STR), args1(h), types.BOOL)
    let j = if_then(inout e, last)
    if t.kind == types.T_TASK {
        // the thread is joined before its closure and result go
        h_void(inout e, p, "ei_h_join", h)
        let d = h_data(inout e, p, h)
        drop_at(inout e, p, task_fn(p, t.a), d)
        if !is_void(t.a) {
            let _h282 = task_roff(inout e, p, t.a)
            let _h209 = off_ptr(inout e, d, _h282)
            drop_at(inout e, p, t.a, _h209)
        }
    } else if t.kind == types.T_MUTEX {
        let _h210 = h_data(inout e, p, h)
        drop_at(inout e, p, t.a, _h210)
    } else if owns(inout e, p, t.a) {
        let ch = rt_call(inout e, p, "ei_h_chan", tys1(types.STR), args1(h), types.STR)
        let n = rt_call(inout e, p, "ei_chan_len", tys1(types.STR), args1(ch), types.U64)
        let lp = loop_n(inout e, p, n)
        let at = rt_call(inout e, p, "ei_chan_at", tys2(types.STR, types.U64), args2(ch, lp.iv), types.STR)
        drop_at(inout e, p, t.a, at)
        loop_next(inout e, lp)
    }
    h_void(inout e, p, "ei_h_free", h)
    if_end(inout e, j)
    store_field_ptr(inout e, p, ty, x, 0, lit("null"))
}

/// Keep the old value at a (when T owns heap data) to drop after the unlock.
fn old_save(inout e: E, p: lower.P, el: u32, a: List[u8]) -> List[u8] {
    if !owns(inout e, p, el) {
        return List.new()
    }
    let o = temp(inout e, p, el)
    copy_mem(inout e, p, el, o, a)
    o
}

fn g_thread(inout e: E, p: lower.P, kd: u32, ty: u32) {
    let el = types.get(p.t, ty).a
    let unit_r = is_void(el)
    let none: List[u8] = List.new()
    if kd == lower.GK_SPAWN {
        // the thread's entry point: runs the closure, keeps its result in the object
        let ft = task_fn(p, el)
        let _h211 = gname(e, "run_", ty)
        let gr = gfn_begin(inout e, p, _h211, tys1(types.STR), types.STR)
        let d = h_data(inout e, p, gr.args[0])
        let sg = fnval_sig(inout e, p, ft)
        let env = load_ptr_field(inout e, p, ft, d, 0)
        let fp = load_ptr_field(inout e, p, ft, d, 1)
        let _h212 = task_roff(inout e, p, el)
        let ra = off_ptr(inout e, d, _h212)
        let mut rd: List[u8] = List.new()
        if !(unit_r || is_scalar(p, el)) { rd = ra.copy() }
        let r = call_sig(inout e, p, fp, sg, args1(env), rd)
        if !unit_r && is_scalar(p, el) {
            store(inout e, p, el, r, ra)
        }
        gret_v(inout e, p, lit("null"))
        gfn_end(inout e, p, gr)
        let _h213 = gname(e, "spawn_", ty)
        let gf = gfn_begin(inout e, p, _h213, tys1(ft), ty)
        let fa = gf.args[0].copy()
        // the closure runs on the new thread: nothing it captured may share a buffer here
        own_at(inout e, p, ft, fa)
        let _h214 = args2(bytes.from_u64(task_dsize(inout e, p, el)), lit("0"))
        let h = rt_call(inout e, p, "ei_h_new", tys2(types.U64, types.U64), _h214, types.STR)
        let _h215 = h_data(inout e, p, h)
        copy_mem(inout e, p, ft, _h215, fa)
        let _h216 = args2(h, catb(lit("@"), gname(e, "run_", ty)))
        call(inout e, p, lit("ei_h_start"), tys2(types.STR, types.STR), _h216, types.UNIT, none)
        let t = temp(inout e, p, ty)
        store_field_ptr(inout e, p, ty, t, 0, h)
        gret_a(inout e, p, t)
        gfn_end(inout e, p, gf)
        return
    }
    if kd == lower.GK_JOIN {
        // waits for the thread (once, whoever asks first); the result stays in the Task
        let _h217 = gname(e, "join_", ty)
        let gf = gfn_begin(inout e, p, _h217, tys1(ty), el)
        let h = h_obj(inout e, p, ty, gf.args[0])
        h_void(inout e, p, "ei_h_join", h)
        let _h218 = h_data(inout e, p, h)
        let _h283 = task_roff(inout e, p, el)
        let ra = off_ptr(inout e, _h218, _h283)
        if !unit_r && owns(inout e, p, el) {
            // a copy of its own, made under the Task's lock (other threads may be joining)
            h_void(inout e, p, "ei_h_lock", h)
            let r = temp(inout e, p, el)
            clone_to(inout e, p, el, ra, r)
            own_at(inout e, p, el, r)
            h_void(inout e, p, "ei_h_unlock", h)
            gret_a(inout e, p, r)
        } else if !unit_r {
            if is_scalar(p, el) {
                let _h219 = load(inout e, p, el, ra)
                gret_v(inout e, p, _h219)
            } else {
                gret_a(inout e, p, ra)
            }
        }
        gfn_end(inout e, p, gf)
        return
    }
    if kd == lower.GK_MXNEW || kd == lower.GK_CHNEW {
        let mut ptys: List[u32] = List.new()
        if kd == lower.GK_MXNEW { ptys = tys1(el) }
        let _h220 = gname(e, "new_", ty)
        let gf = gfn_begin(inout e, p, _h220, ptys, ty)
        let mut h: List[u8] = List.new()
        if kd == lower.GK_MXNEW {
            let va = addrof(inout e, p, el, gf.args[0])
            own_at(inout e, p, el, va)
            let _h221 = args2(bytes.from_u64(size(inout e, p, el)), lit("0"))
            h = rt_call(inout e, p, "ei_h_new", tys2(types.U64, types.U64), _h221, types.STR)
            if !unit_r {
                let _h222 = h_data(inout e, p, h)
                copy_mem(inout e, p, el, _h222, va)
            }
        } else {
            // a channel of elements of el's size (at least 1)
            let es = size(inout e, p, el)
            h = rt_call(inout e, p, "ei_h_new", tys2(types.U64, types.U64), args2(lit("0"), bytes.from_u64(es)), types.STR)
        }
        let t = temp(inout e, p, ty)
        store_field_ptr(inout e, p, ty, t, 0, h)
        gret_a(inout e, p, t)
        gfn_end(inout e, p, gf)
        return
    }
    if kd == lower.GK_MXGET {
        let _h223 = gname(e, "get_", ty)
        let gf = gfn_begin(inout e, p, _h223, tys1(ty), el)
        let h = h_obj(inout e, p, ty, gf.args[0])
        h_void(inout e, p, "ei_h_lock", h)
        let r = temp(inout e, p, el)
        let _h224 = h_data(inout e, p, h)
        clone_to(inout e, p, el, _h224, r)
        own_at(inout e, p, el, r)
        h_void(inout e, p, "ei_h_unlock", h)
        if unit_r {
            gret_void(inout e)
        } else {
            gret_a(inout e, p, r)
        }
        gfn_end(inout e, p, gf)
        return
    }
    if kd == lower.GK_MXSET || kd == lower.GK_MXUPD {
        let upd = kd == lower.GK_MXUPD
        let at = if upd { lower.update_fn(p, el) } else { el }
        let opn = if upd { "upd_" } else { "set_" }
        let _h225 = gname(e, opn, ty)
        let gf = gfn_begin(inout e, p, _h225, tys2(ty, at), types.UNIT)
        let h = h_obj(inout e, p, ty, gf.args[0])
        let nv = temp(inout e, p, el)
        if !upd {
            let _h226 = addrof(inout e, p, el, gf.args[1])
            copy_mem(inout e, p, el, nv, _h226)
            own_at(inout e, p, el, nv)
            h_void(inout e, p, "ei_h_lock", h)
        } else {
            // the closure runs with the lock held, on a borrow of the value
            h_void(inout e, p, "ei_h_lock", h)
            let fv = gf.args[1].copy()
            let sg = fnval_sig(inout e, p, at)
            let env = load_ptr_field(inout e, p, at, fv, 0)
            let fp = load_ptr_field(inout e, p, at, fv, 1)
            let _h284 = h_data(inout e, p, h)
            let _h227 = args2(env, argof(inout e, p, el, _h284))
            let mut rd: List[u8] = List.new()
            if !is_scalar(p, el) { rd = nv.copy() }
            let r = call_sig(inout e, p, fp, sg, _h227, rd)
            if is_scalar(p, el) && !unit_r {
                store(inout e, p, el, r, nv)
            }
            // the result may share buffers with the old value or the closure's captures
            own_at(inout e, p, el, nv)
        }
        let d = h_data(inout e, p, h)
        let old = old_save(inout e, p, el, d)
        if !unit_r {
            copy_mem(inout e, p, el, d, nv)
        }
        h_void(inout e, p, "ei_h_unlock", h)
        if old.len() > 0 {
            drop_at(inout e, p, el, old)
        }
        gfn_end(inout e, p, gf)
        return
    }
    if kd == lower.GK_CHSEND {
        // the value's bytes move into the queue: the channel owns it now
        let _h228 = gname(e, "send_", ty)
        let gf = gfn_begin(inout e, p, _h228, tys2(ty, el), types.UNIT)
        let h = h_obj(inout e, p, ty, gf.args[0])
        let v = temp(inout e, p, el)
        if !unit_r {
            let _h229 = addrof(inout e, p, el, gf.args[1])
            copy_mem(inout e, p, el, v, _h229)
        }
        own_at(inout e, p, el, v)
        let ch = rt_call(inout e, p, "ei_h_chan", tys1(types.STR), args1(h), types.STR)
        call(inout e, p, lit("ei_chan_send"), tys2(types.STR, types.STR), args2(ch, v), types.UNIT, none)
        gfn_end(inout e, p, gf)
        return
    }
    let _h230 = gname(e, "recv_", ty)
    let gf = gfn_begin(inout e, p, _h230, tys2(ty, PTR + el), types.BOOL)
    let h = h_obj(inout e, p, ty, gf.args[0])
    let ch = rt_call(inout e, p, "ei_h_chan", tys1(types.STR), args1(h), types.STR)
    let _h231 = rt_call(inout e, p, "ei_chan_recv", tys2(types.STR, types.STR), args2(ch, gf.args[1]), types.BOOL)
    gret_v(inout e, p, _h231)
    gfn_end(inout e, p, gf)
}

// ---- the worklist

/// Emit the IR of glue item `key` (GK_* * 2^32 + id).
fn glue(inout e: E, p: lower.P, key: u64) {
    let kd = (key / 4294967296) as u32
    let id = (key % 4294967296) as u32
    if kd == lower.GK_EQ {
        g_eq(inout e, p, id)
    } else if kd == lower.GK_DROP {
        g_drop(inout e, p, id)
    } else if kd == lower.GK_CLONE {
        g_clone(inout e, p, id)
    } else if kd == lower.GK_NAME {
        g_name(inout e, p, id)
    } else if kd == lower.GK_PUSH {
        g_push(inout e, p, id)
    } else if kd == lower.GK_HAS {
        g_has(inout e, p, id)
    } else if kd == lower.GK_NEW {
        g_box(inout e, p, id)
    } else if kd == lower.GK_ENV {
        g_env(inout e, p, id)
    } else if kd == lower.GK_THUNK {
        g_thunk(inout e, p, id)
    } else if kd == lower.GK_UNIQ {
        g_uniq(inout e, p, id)
    } else if kd == lower.GK_OWN {
        g_own(inout e, p, id)
    } else if kd == lower.GK_BYTES || kd == lower.GK_UTF8 {
        g_text(inout e, p, kd, id)
    } else if kd == lower.GK_REFNEW {
        g_refnew(inout e, p, id)
    } else if kd == lower.GK_DEFAULT {
        g_default(inout e, p, id)
    } else if kd == lower.GK_RNEW {
        g_rnew(inout e, p, id)
    } else if kd == lower.GK_CMP {
        g_cmp(inout e, p, id)
    } else if kd == lower.GK_HASH {
        g_hash(inout e, p, id)
    } else if kd == lower.GK_SHOW {
        g_show(inout e, p, id)
    } else if kd == lower.GK_COPY {
        g_copy(inout e, p, id)
    } else if kd >= lower.GK_SPAWN && kd <= lower.GK_CHRECV {
        g_thread(inout e, p, kd, id)
    } else {
        g_map(inout e, p, kd, id)
    }
}

/// Every glue item the program needs, until none is new (glue asks for glue).
fn glue_all(inout e: E, p: lower.P) {
    let mut i: usize = 0
    while i < e.needs.len() {
        let k = e.needs[i].copy()
        glue(inout e, p, k)
        i += 1
    }
}

// ---- the program's entry points (what lower.ei's main_body, test driver and export
// wrappers were): the trap file table, `main`, the test driver, the exports

/// `ei_set_file(file); ei_set_files(@ei_files, n)` (the table is made by files_table).
fn set_files(inout e: E, p: lower.P, file: List[u8]) {
    let none: List[u8] = List.new()
    let _h232 = args1(msgb(inout e, file))
    call(inout e, p, lit("ei_set_file"), tys1(types.STR), _h232, types.UNIT, none)
    if e.tfiles.len() == 0 {
        return
    }
    let mut n: u32 = 0
    for f in e.tfiles {
        if f + 1 > n {
            n = f + 1
        }
    }
    call(inout e, p, lit("ei_set_files"), tys2(types.STR, types.I32), args2(lit("@ei_files"), bytes.from_u64(n as u64)), types.UNIT, none)
}

/// `@ei_files`: the module files whose lines traps encode (file index * 2^20 + line), by index.
fn files_table(inout e: E, p: lower.P) {
    if e.tfiles.len() == 0 {
        return
    }
    let mut n: u32 = 0
    for f in e.tfiles {
        if f + 1 > n {
            n = f + 1
        }
    }
    let mut t = lit("@ei_files = private unnamed_addr constant [")
    wd(inout t, n as u64)
    bytes.append(inout t, lit(" x ptr] ["))
    for i in 0..n {
        if i > 0 {
            bytes.append(inout t, lit(", "))
        }
        if e.tfiles.contains(i) {
            bytes.append(inout t, lit("ptr "))
            bytes.append(inout t, msgb(inout e, p.ir.files[i as usize]))
        } else {
            bytes.append(inout t, lit("ptr null"))
        }
    }
    bytes.append(inout t, lit("]\n"))
    bytes.append(inout e.gl, t)
}

/// `int main(void) { return ei_main(ei_main_body); }` around the Eider `main` (function f)
/// by its result (docs/compiler.md, "C8.2"): () exits 0; an i32 is the exit code (outside
/// 0..255 it traps at main's line); a Result[(), E]'s Err prints `error: <the error>` (or
/// `error: main returned Err` when E can't be printed) to stderr, is dropped, and exits 1.
/// The body runs on the runtime's guarded thread (core/RUNTIME.md "Stack overflow").
fn main_fn(inout e: E, p: lower.P, file: List[u8], f: u32) {
    let gf = gfn_begin(inout e, p, lit("ei_main_body"), List.new(), types.I32)
    set_files(inout e, p, file)
    prof_init(inout e, p, file)
    let none: List[u8] = List.new()
    let rt = p.ir.fns[f as usize].ret
    let rk = kind(p, rt)
    if rk == types.T_INT {
        let c = call_user(inout e, p, f, List.new(), none)
        let lo = icmp(inout e, "slt", lit("i32"), c, lit("0"))
        let hi = icmp(inout e, "sgt", lit("i32"), c, lit("255"))
        e.file = 0
        let _h233 = val(inout e, catb(lit("or i1 "), catb(lo, catb(lit(", "), hi))))
        trap_if(inout e, _h233, "exit code out of range", p.ir.main_line)
        call(inout e, p, lit("ei_check_leaks"), List.new(), List.new(), types.UNIT, none)
        gret_v(inout e, p, c)
    } else if rk != types.T_ENUM {
        call_user(inout e, p, f, List.new(), none)
        call(inout e, p, lit("ei_check_leaks"), List.new(), List.new(), types.UNIT, none)
        gret_v(inout e, p, lit("0"))
    } else {
        let r = temp(inout e, p, rt)
        call_user(inout e, p, f, List.new(), r)
        let tg = tag_of(inout e, p, rt, r)
        let _h234 = tag_is(inout e, tg, 1)
        let j = if_then(inout e, _h234)
        let d = types.def_of(p.t, rt)
        let et = types.field(p.t, types.variant(p.t, d, 1).fstart, 0).ty
        let ea = payload_addr(inout e, p, rt, r, 1, 0)
        let x = types.get(p.t, et)
        if x.kind == types.T_INT {
            let v = load(inout e, p, et, ea)
            let w64 = if int_bits(x.a) == 64 { v.copy() } else if types.signed(x.a) { val(inout e, catb(lit("sext "), catb(lit(int_ty(x.a)), catb(lit(" "), cat(v, " to i64"))))) } else { val(inout e, catb(lit("zext "), catb(lit(int_ty(x.a)), catb(lit(" "), cat(v, " to i64"))))) }
            let fname = if types.signed(x.a) { "ei_main_error_i" } else { "ei_main_error_u" }
            call(inout e, p, lit(fname), tys1(types.U64), args1(w64), types.UNIT, none)
        } else {
            let mut s = msg(inout e, "main returned Err")
            let mut shown: List[u8] = List.new()
            if x.kind == types.T_BOOL {
                let v = load(inout e, p, et, ea)
                let _h235 = catb(lit("select i1 "), catb(v, catb(lit(", ptr "), catb(msg(inout e, "true"), catb(lit(", ptr "), msg(inout e, "false"))))))
                s = val(inout e, _h235)
            } else if x.kind == types.T_STR {
                s = load(inout e, p, et, ea)
            } else if x.kind == types.T_STRING {
                s = load_ptr_field(inout e, p, et, ea, 0)
            } else if x.kind == types.T_ENUM && !types.def_of(p.t, et).payload && lower.plain_show(p, et) {
                gneed(inout e, lower.GK_NAME, et)
                let _h236 = gname(e, "name_", et)
                let _h285 = args1(tag_of(inout e, p, et, ea))
                s = rt_call_b(inout e, p, _h236, tys1(types.U32), _h285, types.STR)
            } else if p.ir.main_show {
                // through Show: a record, an enum with a payload or its own Show, a Failure (its chain)
                shown = temp(inout e, p, types.STRING)
                let em = msg(inout e, "")
                call(inout e, p, lit("ei_str_from"), tys1(types.STR), args1(em), types.STRING, shown)
                let sv = argof(inout e, p, et, ea)
                show_into(inout e, p, et, shown, sv)
                s = load_ptr_field(inout e, p, types.STRING, shown, 0)
            }
            call(inout e, p, lit("ei_main_error"), tys1(types.STR), args1(s), types.UNIT, none)
            if shown.len() > 0 { call(inout e, p, lit("ei_drop_String"), tys1(PTR + types.STRING), args1(shown), types.UNIT, none) }
        }
        drop_at(inout e, p, rt, r)
        call(inout e, p, lit("ei_check_leaks"), List.new(), List.new(), types.UNIT, none)
        gret_v(inout e, p, lit("1"))
        if_end(inout e, j)
        call(inout e, p, lit("ei_check_leaks"), List.new(), List.new(), types.UNIT, none)
        gret_v(inout e, p, lit("0"))
    }
    gfn_end(inout e, p, gf)
    entry_main(inout e, p)
}

/// `main`: the runtime runs ei_main_body on its guarded thread.
fn entry_main(inout e: E, p: lower.P) {
    declare(inout e, lit("ei_main"), lit("declare i32 @ei_main(ptr)"))
    e.fns.push(lit("define i32 @main() nounwind \x7b\nentry:\n  %r = call i32 @ei_main(ptr @ei_main_body)\n  ret i32 %r\n\x7d\n\n"))
}

/// The test driver: each `test` block through the runtime's ei_test (it prints `test <name>
/// ... ok`, or FAILED with the trap that ended it), then the summary (ei_tests_done: the
/// counts, the leak report when none failed, the exit code).
fn test_main(inout e: E, p: lower.P, file: List[u8]) {
    let gf = gfn_begin(inout e, p, lit("ei_main_body"), List.new(), types.I32)
    set_files(inout e, p, file)
    prof_init(inout e, p, file)
    let failed = temp(inout e, p, types.I32)
    stmt_text(inout e, catb(lit("store i32 0, ptr "), failed))
    let mut total: u64 = 0
    for f in 0..p.ir.fns.len() {
        let fd = p.ir.fns[f]
        if fd.body == 0 || !fd.is_test {
            continue
        }
        total += 1
        let _h237 = args2(msgb(inout e, fd.name), catb(lit("@"), iname(e, f as u32)))
        let r = rt_call(inout e, p, "ei_test", tys2(types.STR, types.STR), _h237, types.I32)
        let n = val(inout e, catb(lit("load i32, ptr "), failed))
        let m = val(inout e, catb(lit("add i32 "), catb(n, catb(lit(", "), r))))
        stmt_text(inout e, catb(lit("store i32 "), catb(m, catb(lit(", ptr "), failed))))
    }
    let n = val(inout e, catb(lit("load i32, ptr "), failed))
    let c = rt_call(inout e, p, "ei_tests_done", tys2(types.I32, types.I32), args2(bytes.from_u64(total), n), types.I32)
    gret_v(inout e, p, c)
    gfn_end(inout e, p, gf)
    entry_main(inout e, p)
}

/// A library's entry points: `eider_<name>` for each `export fn`, with the C convention of
/// the header (lower.header), calling it after naming "lib" as the trap file (as
/// tests/oracle expects); for WebAssembly also exported under that name.
fn export_fns(inout e: E, p: lower.P) {
    for x in p.ir.exports {
        // for WebAssembly, an export that takes or returns a String or a List[u8] is the
        // inner `eider.raw.<name>` (not exported); wasm.ei's C wrapper exports `eider_<name>`
        let mut raw = false
        if e.lay.wasm {
            let rfd = p.ir.fns[x.f as usize]
            if abi.wasm_memory(p, rfd.ret) { raw = true }
            for i in 0..rfd.nparams {
                if abi.wasm_memory(p, p.ir.locals[(rfd.lstart + i) as usize].ty) { raw = true }
            }
        }
        let mut name = if raw { lit("eider.raw.") } else { lit("eider_") }
        for b in x.name {
            if bytes.is_ident(b) {
                name.push(b)
            } else {
                name.push(95)
            }
        }
        let f = x.f
        let fd = p.ir.fns[f as usize]
        let _h238 = fn_ptys(e, p, f)
        let gf = gfn_begin(inout e, p, name.copy(), _h238, fd.ret)
        let none: List[u8] = List.new()
        let _h239 = args1(msg(inout e, "lib"))
        call(inout e, p, lit("ei_set_file"), tys1(types.STR), _h239, types.UNIT, none)
        if e.tfiles.len() > 0 {
            let mut n: u32 = 0
            for t in e.tfiles {
                if t + 1 > n {
                    n = t + 1
                }
            }
            call(inout e, p, lit("ei_set_files"), tys2(types.STR, types.I32), args2(lit("@ei_files"), bytes.from_u64(n as u64)), types.UNIT, none)
        }
        if is_void(fd.ret) {
            call_user(inout e, p, f, gf.args, none)
            gret_void(inout e)
        } else if is_scalar(p, fd.ret) {
            let r = call_user(inout e, p, f, gf.args, none)
            gret_v(inout e, p, r)
        } else {
            let r = temp(inout e, p, fd.ret)
            call_user(inout e, p, f, gf.args, r)
            gret_a(inout e, p, r)
        }
        // external, and for wasm32 exported under its name
        if !e.term {
            gret_void(inout e)
        }
        let mut h = lit("define ")
        bytes.append(inout h, ret_text(inout e, p, gf.sig))
        bytes.append(inout h, lit(" @"))
        bytes.append(inout h, name)
        bytes.append(inout h, lit("("))
        bytes.append(inout h, signature_params(inout e, p, gf.sig, false))
        bytes.append(inout h, lit(") nounwind"))
        if e.lay.wasm && !raw {
            bytes.append(inout h, lit(" \"wasm-export-name\"=\""))
            bytes.append(inout h, name)
            bytes.append(inout h, lit("\""))
        }
        bytes.append(inout h, lit(" \x7b\nentry:\n"))
        flush_fn(inout e, h)
        e.gdef.insert(h64(name), true)
    }
}

// ---- the program

/// The LLVM version this backend's IR needs (opaque pointers, `poison`, the overflow
/// intrinsics' current names): clang's major version must be at least this.
pub const MIN_LLVM: u64 = 17

/// The program as one LLVM module (see the top of the file). `paths`: the module files by
/// index (debug info), `dir` the working directory, `debug` whether to emit debug info, `arch`
/// the target (llvm_abi.ei: X86_64, AARCH64, WASM32 for `--wasm`/`--wasm-core`, whose module
/// names its triple and exports `eider_<name>`; no debug info there). A function this
/// backend can't lower is an internal error naming it and the construct.
pub fn program(p: lower.P, file: List[u8], tests: bool, lib: bool, paths: List[List[u8]], dir: List[u8], debug: bool, arch: u32) -> Result[Out, List[u8]] { program_prof(p, file, tests, lib, paths, dir, debug, arch, 0, List.new()) }

/// `program` with the profiler (`what`: lower.prof_what's bits, 0 for none; `version`: the
/// toolchain's, recorded in the profile): every function that calls or loops (lower.framed)
/// keeps a frame on the runtime's shadow stack (eider_rt.h ei_prof_*, inline here), stores
/// the line of each statement that calls, allocates or drops (lower.prof_marks), and the glue
/// reports copy-on-write, growth, rehash, Drop, `.copy()` and Ref events.
pub fn program_prof(p: lower.P, file: List[u8], tests: bool, lib: bool, paths: List[List[u8]], dir: List[u8], debug: bool, arch: u32, what: u32, version: List[u8]) -> Result[Out, List[u8]] {
    let wasm = arch == abi.WASM32
    let names = lower.c_names(p)?
    let mut e = E(List.new(), List.new(), List.new(), List.new(), List.new(), List.new(), abi.new_lay(p, arch), List.new(), names.tys, names.fns, List.new(), List.new(), List.new(), List.new(), Map.new(), List.new(), Map.new(), 0, 0, 0, false, List.new(), 0, 0, 0, List.new(), List.new(), false, abi.Arg(0, 0, 0, 0, 0, 0, 0), List.new(), debug, false, List.new(), List.new(), List.new(), 4, 0, 0, Map.new(), Map.new(), paths, dir, List.new(), List.new(), List.new(), List.new(), List.new(), List.new(), Map.new(), List.new(), List.new(), Map.new(), List.new(), Map.new(), what, version, false, List.new(), 0)
    let nosig = abi.Sig(abi.Arg(0, 0, 0, 0, 0, 0, 0), List.new())
    for f in 0..p.ir.fns.len() {
        e.isigs.push(nosig.copy())
        e.isok.push(false)
        e.csigs.push(nosig.copy())
        e.csok.push(false)
        e.iused.push(false)
    }
    for i in 0..p.t.tys.len() {
        e.tdone.push(false)
        e.own.push(0)
        e.dty.push(0)
    }
    for i in 0..p.ir.strs.len() {
        e.sused.push(false)
    }
    for f in 0..p.ir.fns.len() {
        let fd = p.ir.fns[f]
        let mut n: u32 = 0
        while n < fd.lcount && p.ir.locals[(fd.lstart + n) as usize].kind == ir.L_CAPTURE {
            n += 1
        }
        e.ncap.push(n)
        e.clo.push(fd.body > 0 && !fd.is_test && is_closure_name(fd.name))
    }
    if debug {
        file_md(inout e, 0)
        for f in 0..p.ir.fns.len() {
            if p.ir.fns[f].body > 0 {
                file_md(inout e, p.ir.fns[f].file)
            }
        }
    }
    let mut main_f = NONE
    let mut owner: List[u32] = List.new()
    for f in 0..p.ir.fns.len() {
        let fd = p.ir.fns[f]
        if fd.body == 0 || (!tests && fd.is_test) {
            continue
        }
        if !fd.is_test && bytes.eq(fd.name, lit("main")) {
            main_f = f as u32
        }
        if !function(inout e, p, f as u32) {
            let mut m = lit("the LLVM backend can't lower ")
            bytes.append(inout m, fd.name)
            bytes.append(inout m, lit(": "))
            bytes.append(inout m, e.fail)
            return Err(m)
        }
        e.gdef.insert(h64(e.fnn[f]), true)
        e.gdef.insert(h64(iname(e, f as u32)), true)
        while owner.len() < e.fns.len() { owner.push(f as u32) }
    }
    // the entry points, then the glue everything asks for
    if lib {
        export_fns(inout e, p)
    } else if tests {
        test_main(inout e, p, file)
    } else if main_f != NONE {
        main_fn(inout e, p, file, main_f)
    }
    glue_all(inout e, p)
    files_table(inout e, p)
    while owner.len() < e.fns.len() { owner.push(GLUE) }
    let mut head = lit("; generated by eiderc from ")
    for b in file {
        if b >= 32 && b < 127 {
            head.push(b)
        }
    }
    if wasm {
        bytes.append(inout head, lit("\ntarget triple = \"wasm32-unknown-unknown\""))
    }
    bytes.append(inout head, lit("\n\n%ei.String = type \x7b ptr, i64, i64 \x7d\n"))
    bytes.append(inout head, e.tdefs)
    head.push(10)
    // after the functions (e.fns): the constants and declarations they use (LLVM IR may
    // name them before they are defined)
    let mut ll: List[u8] = List.new()
    ll.push(10)
    for i in 0..p.ir.strs.len() {
        if !e.sused[i] {
            continue
        }
        bytes.append(inout ll, num("@.s", i as u64))
        bytes.append(inout ll, lit(" = private unnamed_addr constant ["))
        bytes.append(inout ll, bytes.from_u64((p.ir.strs[i].len() + 1) as u64))
        bytes.append(inout ll, lit(" x i8] "))
        c_string(inout ll, p.ir.strs[i])
        ll.push(10)
    }
    bytes.append(inout ll, e.gl)
    ll.push(10)
    for i in 0..e.dnames.len() {
        if e.gdef.contains(h64(e.dnames[i])) {
            continue
        }
        bytes.append(inout ll, e.dtext[i])
        ll.push(10)
    }
    if debug {
        bytes.append(inout ll, lit("!llvm.dbg.cu = !\x7b!0\x7d\n!llvm.module.flags = !\x7b!1, !2\x7d\n"))
        bytes.append(inout ll, lit("!0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !"))
        let f0 = file_md(inout e, 0)
        bytes.append(inout ll, bytes.from_u64(f0 as u64))
        bytes.append(inout ll, lit(", producer: \"eiderc (llvm backend)\", isOptimized: false, runtimeVersion: 0, emissionKind: FullDebug)\n"))
        bytes.append(inout ll, lit("!1 = !\x7bi32 7, !\"Dwarf Version\", i32 5\x7d\n!2 = !\x7bi32 2, !\"Debug Info Version\", i32 3\x7d\n!3 = !DISubroutineType(types: !\x7b\x7d)\n"))
        bytes.append(inout ll, e.md)
    }
    e.fns.push(ll)
    Ok(Out(head, e.fns, owner))
}

fn is_closure_name(s: List[u8]) -> bool {
    let mut i = s.len()
    while i > 0 && bytes.is_digit(s[i - 1]) {
        i -= 1
    }
    if i == s.len() || i < 8 {
        return false
    }
    bytes.eq(bytes.slice(s, i - 8, i), lit(".closure"))
}

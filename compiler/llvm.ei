        let ov = load_ptr_field(inout e, p, ty, old, 1)
        store_field_ptr(inout e, p, ty, x, 0, nk)
        store_field_ptr(inout e, p, ty, x, 1, nv)
        store_field_ptr(inout e, p, ty, x, 2, ns)
        let lp = loop_n(inout e, p, cap)

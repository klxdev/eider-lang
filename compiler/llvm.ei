        let q = buf_alloc(inout e, p, lit("1"), _h72)
        store_field_ptr(inout e, p, ty, x, 0, q)
        clone_to(inout e, p, t.a, b0, q)
    }
    let none: List[u8] = List.new()
    let _h73 = gname(e, "drop_", ty)
    call(inout e, p, _h73, tys1(PTR + ty), args1(old), types.UNIT, none)
    gfn_end(inout e, p, gf)
}

fn g_own(inout e: E, p: lower.P, ty: u32) {
    let _h74 = gname(e, "own_", ty)
    let gf = gfn_begin(inout e, p, _h74, tys1(PTR + ty), types.UNIT)

/// `uniq_T(T *x)` for a List, Map, Box or shared record: when x's buffer is shared, x gets a
/// copy (each element a copy, sharing its own buffers in turn) and lets go of the shared one.
fn g_uniq(inout e: E, p: lower.P, ty: u32) {
    let _h58 = gname(e, "uniq_", ty)
    let gf = gfn_begin(inout e, p, _h58, tys1(PTR + ty), types.UNIT)
    let x = gf.args[0].copy()
    let t = types.get(p.t, ty)
    let k = t.kind
    let fi: u32 = if k == types.T_MAP { 2 } else { 0 }
    let b0 = load_ptr_field(inout e, p, ty, x, fi)
    let sh = buf_shared(inout e, p, b0)
    let _h59 = val(inout e, catb(lit("xor i1 "), cat(sh, ", true")))
    let j = if_then(inout e, _h59)
    gret_void(inout e)
    if_end(inout e, j)
    if e.prof > 0 {
        // the copy's bytes
        let mut cb = bytes.from_u64(0)
        if k == types.T_RECORD {
            cb = bytes.from_u64(rec_dsize(inout e, p, ty))
        } else if k == types.T_LIST {
            let c0 = load_i64_field(inout e, p, ty, x, 2)
            let es0 = size(inout e, p, t.a)
            cb = mul_const(inout e, c0, es0)
        } else if k == types.T_MAP {
            let c0 = load_i64_field(inout e, p, ty, x, 4)
            let w0 = size(inout e, p, t.a) + size(inout e, p, t.b) + 1
            cb = mul_const(inout e, c0, w0)
        } else {
            cb = bytes.from_u64(size(inout e, p, t.a))
        }
        prof_ev(inout e, p, PEV_COW, cb)
    }
    if k == types.T_RECORD {
        let n = temp(inout e, p, ty)
        let f = lower.custom_fn(p, lower.TR_COPY, ty)
        if f != NONE {
            let _h60 = args1(argof(inout e, p, ty, x))
            call_user(inout e, p, f, _h60, n)
        } else {
            let d = types.def_of(p.t, ty)
            let dt = cat(num("%t", ty as u64), ".d")
            let ds = rec_dsize(inout e, p, ty)
            let q = buf_alloc(inout e, p, lit("1"), ds)
            dyn_memcpy(inout e, q, b0, bytes.from_u64(ds))
            store_field_ptr(inout e, p, ty, n, 0, q)
            for i in 0..d.len {
                let ft = types.field(p.t, d.start, i).ty
                if owns(inout e, p, ft) {

// ir: the typed IR that `check` produces and `lower` (C4) translates to C.
//
// Everything is an arena of small records addressed by u32 ids, like the AST. A program is
// a list of functions (index = the checker's function index; tests follow the functions)
// and constants. Each function owns a range of `locals` (parameters first) and a body
// block. Expressions are flattened while checking: every intermediate value is a temporary
// local assigned exactly once, in source evaluation order (left to right), and every read
// of a variable is an explicit `read` into a temporary at the point the source reads it.
// So lowering never reorders, hoists or re-evaluates anything; trapping operations carry the
// source line for the runtime error.
//
// Locals     {name sym, ty, kind (L_*), line}
//            L_PARAM, L_INOUT (a parameter passed by reference), L_LET, L_VAR, L_TEMP,
//            L_CAPTURE (a closure function's first locals: the values its environment holds,
//            in S_CLOSURE argument order; read-only)
// Operands   O_INT ty v=value (64-bit two's complement)   O_BOOL v   O_STR v=string index
//            O_UNIT   O_LOCAL a=local (only temporaries and pattern scrutinees)
// Places     P_LOCAL a=local
//            P_FIELD a=base place b=field index (records and tuples)
//            P_INDEX a=base place b=index operand (arrays and Lists, bounds-checked) line
//            P_PAYLOAD a=base place b=variant c=field (the enum at base is that variant)
//            P_DEREF a=base place (the value a Box at base points to)
// Arguments  (calls, constructors, arrays) a list in `extra` of operand ids, except
//            that an `inout` call argument is a place id + ARG_PLACE.
// Statements {kind, dst, a, b, c, ty, line}; a block is a list of statement ids in `extra`
//   S_COPY    dst := op a
//   S_READ    dst := place a
//   S_STORE   place a := op b
//   S_UNARY   dst := a (U_NEG checked, U_NOT, U_BNOT `~`) b=operand
//   S_BINARY  dst := b (op a = ast.OP_*) c; ty = operand type. + - * / % trap on overflow
//             and division by zero; +% -% *% wrap; & | ^ on the bits; << >> trap on a
//             count outside 0..width-1 (>> is arithmetic on signed types); == != compare
//             through Eq for any type that has it; < <= > >= through Ord (integers, bool
//             and text inline, the rest through cmp_ glue; C8.4).
//             (&& and || are lowered to S_IF.)
//   S_CAST    dst := a as ty (traps when out of range)
//   S_CALL    dst := fn a (args [b/c]); dst = NONE for a () result
//   S_RECORD  dst := ty(args [b/c])        S_VARIANT dst := variant a of enum ty (args [b/c])
//   S_ARRAY   dst := [args [b/c]] : ty     S_REPEAT  dst := [op a; b] : ty
//   S_TAG     dst := (place a is variant b)
//   S_PRINT   print op a (of type ty)      S_NOWMS dst := now_ms()
//   S_PANIC   trap with message op a       S_ASSERT  trap unless op a; b = message string+1
//   S_IF      if op a then block b else block c
//   S_LOOP    loop { block a }; `continue` runs block b (the step) and loops again
//   S_BREAK   S_CONTINUE   a = how many enclosing loops it leaves besides the innermost (a
//             labeled exit, docs/compiler.md "C8.22"; 0: the innermost loop's)
//   S_RETURN a = op+1 (0: no value)
//   S_TUPLE   dst := (args [b/c]) : ty
//   S_CLONE   dst := deep copy of op a (of type ty)
//   S_DROP    drop the value in place a (of type ty)
//   S_MOVE    dst := place a, which gives up ownership (it is dead afterwards)
//   S_BUILTIN dst := builtin a (B_*) of args [b/c]; ty = result type; dst = NONE for ()
//             (B_LIST_SUM traps on overflow at `line`)
//   S_CLOSURE dst := closure value of type ty: function a with captured values [b/c] (moved
//             into its environment; the function's L_CAPTURE locals read them)
//   S_FNREF   dst := function a as a closure value of type ty (no environment)
//   S_CALLV   dst := call closure op a with args [b/c] (borrowed); dst = NONE for ()
//   S_NOTE    the checker's own note for the protection rule (a = kind, b = index; check.ei,
//             "References"); removed before checking ends, so no IR that is used has one
//   S_CHECK   the bounds checks of place a, and nothing else (a reference is bound to it:
//             its indices are checked once, then)
// Functions  {name text, def, ret, locals [lstart/lcount], nparams, body block+1 (0 = none),
//             caps, is_test}; generic functions and methods appear once per instance
//             (`name[i32]`, `Option[i32].unwrap`), each closure body is a function of its
//             own (`main.closure1`) whose parameters follow its captures
// Constants  {name text, ty, value op}
// Externs    {f, symbol text, params (types)}: function f is an `extern "c"` declaration
//            bound to the C symbol `symbol`; it has no body or locals (its Fn has body 0
//            and the return type), and is called with an ordinary S_CALL. Parameter and
//            return types are C-safe (integers, bool, str, () as a return type).
// Exports    {f, name text}: function f is an `export fn`; a library build gives it a C
//            entry point `eider_<name>` (name is the mangled `stem__name`), in source order.
//
// Ownership (String, List, Map, Box and anything containing them) is explicit, so lowering
// never decides it. Every local, temporary and place owns the value stored in it. S_READ is
// a bitwise copy: of an owned type it is a *borrow* (a view that is never dropped and is
// used only while the place is unchanged: as a call argument, an operand, a match
// scrutinee). An owned value moves when its owner, a temporary that is never used again,
// is stored (S_COPY, S_STORE, constructor and builtin arguments that take ownership,
// S_RETURN); a borrow that must be stored is first S_CLONEd. Values whose owner goes out of
// scope get an S_DROP on every exit path (end of block, `return`, `break`, `continue`,
// `?`), innermost first, in reverse order of creation; a place that is overwritten is
// dropped right before the store. Builtin argument conventions: the receiver of a mutating
// builtin is a place (+ARG_PLACE); B_LIST_PUSH's element and B_MAP_INSERT's key and value
// are moved in; every other argument is borrowed. B_LIST_POP's result is owned; B_MAP_GET's
// Option borrows its payload from the map (the checker clones it). A reference (a `let` or
// pattern binding of a place, docs/compiler.md "C8.6") has no local: the IR uses the place it
// names wherever the source uses it, so it is never cloned or dropped.
//
// Builtins     B_STR_FROM(str) -> String          B_STR_FROM_INT(i64) -> String
//   B_LEN(x) -> usize, B_IS_EMPTY(x) -> bool, x a String, List or Map
//   B_STR_PUSH(inout s, str)    B_STR_APPEND(inout s, String)
//   B_LIST_NEW -> ty    B_MAP_NEW -> ty    B_BOX_NEW(v) -> ty
//   B_LIST_PUSH(inout l, x)    B_LIST_POP(inout l) -> Option[T]    B_LIST_CLEAR(inout l)
//   B_LIST_CONTAINS(l, x) -> bool    B_LIST_SUM(l) -> T
//   B_MAP_INSERT(inout m, k, v)    B_MAP_CONTAINS(m, k) -> bool    B_MAP_REMOVE(inout m, k) -> bool
//   B_MAP_GET(m, k) -> Option[V]
// Bytes of text (C8.2; x a String or str, borrowed; B_LEN and B_IS_EMPTY take a str too):
//   B_STR_BYTE(x, i) -> u8 (traps out of bounds)    B_STR_SLICE(x, a, b) -> String (traps
//   unless a <= b <= len on character boundaries)    B_STR_BYTES(x) -> List[u8]
//   B_STR_FROM_BYTES(l) -> ty = Result[String, usize] (Err: offset of the first byte that
//   isn't valid UTF-8, or a NUL)    B_STR_PUSH_BYTE(inout s, b) (traps unless b is 1..=127)
// Threads (C7; Task, Mutex and Chan are shared handles, see types.ei). Every receiver is
// a borrowed operand. Moved in: B_SPAWN's closure (the Task owns it and runs it on a new
// thread), B_MUTEX_NEW's and B_MUTEX_SET's value, B_CHAN_SEND's value (the channel owns
// it until a receiver takes it). Owned results: B_TASK_JOIN (a copy of the result; the
// Task keeps its own), B_MUTEX_GET (a copy), B_CHAN_RECV (the value, moved out of the
// channel). B_MUTEX_UPDATE borrows its closure and runs it on the value with the lock held.
//   B_SPAWN(f) -> Task[T]    B_TASK_JOIN(t) -> T
//   B_MUTEX_NEW(v) -> ty    B_MUTEX_GET(m) -> T    B_MUTEX_SET(m, v)    B_MUTEX_UPDATE(m, f)
//   B_CHAN_NEW -> ty    B_CHAN_SEND(c, v)    B_CHAN_RECV(c) -> Option[T]    B_CHAN_CLOSE(c)
// Operation traits (C8.4; x borrowed): B_COPY(x) -> ty (`x.copy()`: a clone, except that a
//   Mutex inside gets a new Mutex with a copy, a part with its own Copy is copied by it, and
//   a record with its own Drop gets a buffer of its own)    B_COMPARE(a, b) -> ty = Ordering
//   B_HASH(x) -> u64    B_SHOW(inout out, x) (appends x's text)    B_TO_STRING(x) -> String
//   (S_BINARY's == and <, S_PRINT and Map keys go through the same glue; a type in
//   Ir.impls uses its own function there)

import core.sys
import std.bytes
import eiderc.ast
import eiderc.intern
import eiderc.types
import eiderc.diag

pub const NONE: u32 = 4294967295
pub const ARG_PLACE: u32 = 2147483648

pub const L_PARAM: u32 = 0
pub const L_INOUT: u32 = 1
pub const L_LET: u32 = 2
pub const L_VAR: u32 = 3
pub const L_TEMP: u32 = 4
pub const L_CAPTURE: u32 = 5

pub const O_INT: u32 = 0
pub const O_BOOL: u32 = 1
pub const O_STR: u32 = 2
pub const O_UNIT: u32 = 3
pub const O_LOCAL: u32 = 4

pub const P_LOCAL: u32 = 0
pub const P_FIELD: u32 = 1
pub const P_INDEX: u32 = 2
pub const P_PAYLOAD: u32 = 3
pub const P_DEREF: u32 = 4

pub const U_NEG: u32 = 0
pub const U_NOT: u32 = 1
pub const U_BNOT: u32 = 2

pub const S_COPY: u32 = 0
pub const S_READ: u32 = 1
pub const S_STORE: u32 = 2
pub const S_UNARY: u32 = 3
pub const S_BINARY: u32 = 4
pub const S_CAST: u32 = 5
pub const S_CALL: u32 = 6
pub const S_RECORD: u32 = 7
pub const S_VARIANT: u32 = 8
pub const S_ARRAY: u32 = 9
pub const S_REPEAT: u32 = 10
pub const S_TAG: u32 = 11
pub const S_PRINT: u32 = 12
pub const S_NOWMS: u32 = 13
pub const S_PANIC: u32 = 14
pub const S_ASSERT: u32 = 15
pub const S_IF: u32 = 16
pub const S_LOOP: u32 = 17
pub const S_BREAK: u32 = 18
pub const S_CONTINUE: u32 = 19
pub const S_RETURN: u32 = 20
pub const S_TUPLE: u32 = 21
pub const S_CLONE: u32 = 22
pub const S_DROP: u32 = 23
pub const S_MOVE: u32 = 24
pub const S_BUILTIN: u32 = 25
pub const S_CLOSURE: u32 = 26
pub const S_FNREF: u32 = 27
pub const S_CALLV: u32 = 28
pub const S_NOTE: u32 = 29
pub const S_CHECK: u32 = 30

pub const B_STR_FROM: u32 = 0
pub const B_STR_FROM_INT: u32 = 1
pub const B_LEN: u32 = 2
pub const B_IS_EMPTY: u32 = 3
pub const B_STR_PUSH: u32 = 4
pub const B_STR_APPEND: u32 = 5
pub const B_LIST_NEW: u32 = 6
pub const B_MAP_NEW: u32 = 7
pub const B_LIST_PUSH: u32 = 8
pub const B_LIST_POP: u32 = 9
pub const B_LIST_CLEAR: u32 = 10
pub const B_LIST_CONTAINS: u32 = 11
pub const B_LIST_SUM: u32 = 12
pub const B_MAP_INSERT: u32 = 13
pub const B_MAP_CONTAINS: u32 = 14
pub const B_MAP_REMOVE: u32 = 15
pub const B_MAP_GET: u32 = 16
pub const B_BOX_NEW: u32 = 17
pub const B_SPAWN: u32 = 18
pub const B_TASK_JOIN: u32 = 19
pub const B_MUTEX_NEW: u32 = 20
pub const B_MUTEX_GET: u32 = 21
pub const B_MUTEX_SET: u32 = 22
pub const B_MUTEX_UPDATE: u32 = 23
pub const B_CHAN_NEW: u32 = 24
pub const B_CHAN_SEND: u32 = 25
pub const B_CHAN_RECV: u32 = 26
pub const B_CHAN_CLOSE: u32 = 27
pub const B_STR_BYTE: u32 = 28
pub const B_STR_SLICE: u32 = 29
pub const B_STR_BYTES: u32 = 30
pub const B_STR_FROM_BYTES: u32 = 31
pub const B_STR_PUSH_BYTE: u32 = 32
pub const B_COPY: u32 = 33
pub const B_COMPARE: u32 = 34
pub const B_HASH: u32 = 35
pub const B_SHOW: u32 = 36
pub const B_TO_STRING: u32 = 37
/// B_MAP_KEYS(m) -> List[K], B_MAP_VALUES(m) -> List[V], B_MAP_ENTRIES(m) -> List[(K, V)]:
/// owned Lists of copies, in slot order (docs/compiler.md, "C8.20")
pub const B_MAP_KEYS: u32 = 38
pub const B_MAP_VALUES: u32 = 39
pub const B_MAP_ENTRIES: u32 = 40
/// Ref[T] (docs/compiler.md, "C8.7"; the receiver is a borrowed operand): B_REF_NEW(v) -> ty
/// (v moved in), B_REF_GET(r) -> T (a copy), B_REF_SET(r, v) (v moved in, the old value
/// dropped), B_REF_READ(r, f) -> R (f: fn(T) -> R, borrowed, called on a borrow of the
/// value), B_REF_UPDATE(r, f) -> R (f: fn(inout T) -> R, called on the value itself); each
/// traps on an overlapping access (line)
pub const B_REF_NEW: u32 = 41
pub const B_REF_GET: u32 = 42
pub const B_REF_SET: u32 = 43
pub const B_REF_READ: u32 = 44
pub const B_REF_UPDATE: u32 = 45
/// B_DEFAULT -> ty: the derived or built-in Default of ty (docs/compiler.md, "C8.23"; a type
/// with its own impl is an S_CALL of it instead): 0, false, "", empty List/Map, None, and a
/// record, tuple, array or Box of its parts' defaults
pub const B_DEFAULT: u32 = 46
/// Interpolation (docs/compiler.md, "C8.28"): B_STR_PAD(inout s, mark, spec) pads what follows
/// byte offset `mark` of s to the spec's width; B_FMT_INT(inout s, n, spec) appends integer n
/// formatted by the spec (an O_INT u64: check.ei's fmt_hole has the layout)
pub const B_STR_PAD: u32 = 47
pub const B_FMT_INT: u32 = 48
/// B_STR_IS(s, lit) -> bool: String s has the text of str lit (a `str` pattern matching a
/// String: docs/compiler.md, "C8.30")
pub const B_STR_IS: u32 = 49

pub fn builtin_name(b: u32) -> str {
    match b {
        0 => "string_from"
        1 => "string_from_int"
        2 => "len"
        3 => "is_empty"
        4 => "push_str"
        5 => "append"
        6 => "list_new"
        7 => "map_new"
        8 => "push"
        9 => "pop"
        10 => "clear"
        11 => "contains"
        12 => "sum"
        13 => "insert"
        14 => "map_contains"
        15 => "remove"
        16 => "map_get"
        17 => "box_new"
        18 => "spawn"
        19 => "join"
        20 => "mutex_new"
        21 => "mutex_get"
        22 => "mutex_set"
        23 => "mutex_update"
        24 => "chan_new"
        25 => "send"
        26 => "recv"
        27 => "close"
        28 => "byte"
        29 => "slice"
        30 => "bytes"
        31 => "from_bytes"
        32 => "push_byte"
        33 => "copy"
        34 => "compare"
        35 => "hash"
        36 => "show"
        37 => "to_string"
        38 => "keys"
        39 => "values"
        40 => "entries"
        41 => "ref_new"
        42 => "ref_get"
        43 => "ref_set"
        44 => "read"
        45 => "update"
        46 => "default"
        47 => "pad"
        48 => "fmt_int"
        _ => "str_is"
    }
}

pub type Local = { name: u32, ty: u32, kind: u32, line: u32 }
pub type Op = { kind: u32, ty: u32, a: u32, v: u64 }
pub type Place = { kind: u32, ty: u32, a: u32, b: u32, c: u32, line: u32 }
pub type Stmt = { kind: u32, dst: u32, a: u32, b: u32, c: u32, ty: u32, line: u32 }
pub type Block = { start: u32, len: u32 }
pub type Fn = {
    name: List[u8], ret: u32, lstart: u32, lcount: u32, nparams: u32, body: u32,
    caps: List[u8], is_test: bool,
    /// the module whose source the body comes from (index into Ir.files; 0: the entry file)
    file: u32,
}
pub type Const = { name: List[u8], ty: u32, op: u32 }
pub type Extern = { f: u32, symbol: List[u8], params: List[u32] }
pub type Export = { f: u32, name: List[u8] }

pub type Ir = {
    fns: List[Fn],
    consts: List[Const],
    externs: List[Extern],
    exports: List[Export],
    locals: List[Local],
    ops: List[Op],
    places: List[Place],
    stmts: List[Stmt],
    blocks: List[Block],
    extra: List[u32],
    strs: List[List[u8]],
    /// statements of the blocks being built, innermost last (see open/close)
    pending: List[u32],
    /// the function being built and its locals so far (they join `locals` at end_fn, so
    /// each function's locals stay contiguous although a closure's body is built in the
    /// middle of its enclosing function's); `outer` saves the enclosing ones
    cur: u32,
    building: List[Local],
    outer: List[Outer],
    /// the line of `main` (its exit code's range check traps there)
    main_line: u32,
    /// `main` returns Result[(), E] and E has Show: its Err is printed through Show (docs/compiler.md, "C8.43")
    main_show: bool,
    /// Operation traits (docs/compiler.md, "C8.4: operation traits"): for a type with its own
    /// impl of a language trait, trait (TR_* in check.ei: 0 Copy, 1 Eq, 2 Ord, 3 Hash, 4 Show,
    /// 5 Iter, 6 Drop) * 2^32 + type -> the function implementing its method; lowering's glue
    /// calls it instead of the derived operation
    impls: Map[u64, u32],
    /// file names for traps, by module index (0: the entry file, named by ei_set_file);
    /// empty for modules whose names aren't needed
    files: List[List[u8]],
    /// the module of the functions begun from now on (begin_fn)
    cur_file: u32,
}

type Outer = { cur: u32, building: List[Local] }

pub fn new() -> Ir {
    Ir(List.new(), List.new(), List.new(), List.new(), List.new(), List.new(), List.new(), List.new(), List.new(), List.new(), List.new(), List.new(), 0, List.new(), List.new(), 0, false, Map.new(), List.new(), 0)
}

// ---- building

/// Declare function `i` (functions are declared in index order before any body is built).
pub fn declare_fn(inout ir: Ir, name: List[u8], is_test: bool) -> u32 {
    ir.fns.push(Fn(name, types.UNIT, 0, 0, 0, 0, List.new(), is_test, 0))
    (ir.fns.len() - 1) as u32
}

/// Start building function f's body.
pub fn begin_fn(inout ir: Ir, f: u32, ret: u32, caps: List[u8]) {
    ir.cur = f
    ir.building = List.new()
    let mut fd = ir.fns[f as usize].copy()
    fd.ret = ret
    fd.caps = caps
    fd.file = ir.cur_file
    ir.fns[f as usize] = fd
}

/// Finish the function being built: its locals are stored and its body is block `body`.
pub fn end_fn(inout ir: Ir, nparams: u32, body: u32) {
    let mut fd = ir.fns[ir.cur as usize].copy()
    fd.lstart = ir.locals.len() as u32
    fd.lcount = ir.building.len() as u32
    for l in ir.building { ir.locals.push(l) }
    ir.building = List.new()
    fd.nparams = nparams
    fd.body = body + 1
    ir.fns[ir.cur as usize] = fd
}

/// Start building function f (a closure body) inside the function being built.
pub fn begin_nested(inout ir: Ir, f: u32, ret: u32, caps: List[u8]) {
    ir.outer.push(Outer(ir.cur, ir.building))
    begin_fn(inout ir, f, ret, caps)
}

/// Finish a function started with begin_nested and resume its enclosing function.
pub fn end_nested(inout ir: Ir, nparams: u32, body: u32) {
    end_fn(inout ir, nparams, body)
    match ir.outer.pop() {
        Some(o) => {
            ir.cur = o.cur
            ir.building = o.building
        }
        None => {}
    }
}

/// Set the return type of the function being built (a closure's is known at its end).
pub fn set_ret(inout ir: Ir, ret: u32) {
    let mut fd = ir.fns[ir.cur as usize].copy()
    fd.ret = ret
    ir.fns[ir.cur as usize] = fd
}

/// The name of the function being built.
pub fn cur_name(ir: Ir) -> List[u8] { ir.fns[ir.cur as usize].name }

/// A new local of the current function (its id is relative to the function).
pub fn local(inout ir: Ir, name: u32, ty: u32, kind: u32, line: u32) -> u32 {
    ir.building.push(Local(name, ty, kind, line))
    ir.building.len() as u32 - 1
}

pub fn temp(inout ir: Ir, ty: u32, line: u32) -> u32 { local(inout ir, 0, ty, L_TEMP, line) }

fn op(inout ir: Ir, o: Op) -> u32 {
    ir.ops.push(o)
    (ir.ops.len() - 1) as u32
}

pub fn op_int(inout ir: Ir, ty: u32, v: u64) -> u32 { op(inout ir, Op(O_INT, ty, 0, v)) }
pub fn op_bool(inout ir: Ir, b: bool) -> u32 {
    let v: u64 = if b { 1 } else { 0 }
    op(inout ir, Op(O_BOOL, types.BOOL, 0, v))
}
pub fn op_str(inout ir: Ir, s: List[u8]) -> u32 {
    ir.strs.push(s)
    let i = (ir.strs.len() - 1) as u32
    op(inout ir, Op(O_STR, types.STR, i, 0))
}
pub fn op_unit(inout ir: Ir) -> u32 { op(inout ir, Op(O_UNIT, types.UNIT, 0, 0)) }
pub fn op_local(inout ir: Ir, l: u32, ty: u32) -> u32 { op(inout ir, Op(O_LOCAL, ty, l, 0)) }

pub fn op_ty(ir: Ir, o: u32) -> u32 { ir.ops[o as usize].ty }

/// The local an operand reads, if it is a temporary.
pub fn op_is_local(ir: Ir, o: u32) -> bool { ir.ops[o as usize].kind == O_LOCAL }
pub fn op_local_id(ir: Ir, o: u32) -> u32 { ir.ops[o as usize].a }

pub fn set_local_ty(inout ir: Ir, l: u32, ty: u32) {
    let mut x = ir.building[l as usize].copy()
    x.ty = ty
    ir.building[l as usize] = x
}

fn place(inout ir: Ir, p: Place) -> u32 {
    ir.places.push(p)
    (ir.places.len() - 1) as u32
}

pub fn place_local(inout ir: Ir, l: u32, ty: u32) -> u32 { place(inout ir, Place(P_LOCAL, ty, l, 0, 0, 0)) }
pub fn place_field(inout ir: Ir, base: u32, i: u32, ty: u32) -> u32 { place(inout ir, Place(P_FIELD, ty, base, i, 0, 0)) }
pub fn place_index(inout ir: Ir, base: u32, idx: u32, ty: u32, line: u32) -> u32 { place(inout ir, Place(P_INDEX, ty, base, idx, 0, line)) }
pub fn place_payload(inout ir: Ir, base: u32, v: u32, f: u32, ty: u32) -> u32 { place(inout ir, Place(P_PAYLOAD, ty, base, v, f, 0)) }
pub fn place_deref(inout ir: Ir, base: u32, ty: u32) -> u32 { place(inout ir, Place(P_DEREF, ty, base, 0, 0, 0)) }

/// The kind of the last statement of the innermost open block (NONE if it is empty).
pub fn last_kind(ir: Ir, mark: u32) -> u32 {
    if ir.pending.len() as u32 <= mark { return NONE }
    ir.stmts[ir.pending[ir.pending.len() - 1] as usize].kind
}

/// Append a statement to the innermost open block.
pub fn emit(inout ir: Ir, kind: u32, dst: u32, a: u32, b: u32, c: u32, ty: u32, line: u32) {
    ir.stmts.push(Stmt(kind, dst, a, b, c, ty, line))
    ir.pending.push((ir.stmts.len() - 1) as u32)
}

/// Store an argument list; returns its start in `extra`.
pub fn list(inout ir: Ir, ids: List[u32]) -> u32 {
    let start = ir.extra.len() as u32
    for x in ids { ir.extra.push(x) }
    start
}

/// Open a block: statements emitted from now on belong to it. Returns its mark.
pub fn open(ir: Ir) -> u32 { ir.pending.len() as u32 }

/// Close the block opened at `mark`; returns the block id.
pub fn close(inout ir: Ir, mark: u32) -> u32 {
    let start = ir.extra.len() as u32
    let mut i = mark as usize
    while i < ir.pending.len() {
        ir.extra.push(ir.pending[i])
        i += 1
    }
    let n = ir.pending.len() as u32 - mark
    while ir.pending.len() as u32 > mark { ir.pending.pop() }
    ir.blocks.push(Block(start, n))
    (ir.blocks.len() - 1) as u32
}

/// An empty block.
pub fn empty_block(inout ir: Ir) -> u32 {
    let m = open(ir)
    close(inout ir, m)
}

pub fn add_const(inout ir: Ir, name: List[u8], ty: u32, o: u32) {
    ir.consts.push(Const(name, ty, o))
}

/// Make function f (declared, never built) the `extern "c"` declaration of C symbol
/// `symbol` with these parameter types and return type.
pub fn add_extern(inout ir: Ir, f: u32, symbol: List[u8], params: List[u32], ret: u32) {
    let mut fd = ir.fns[f as usize].copy()
    fd.ret = ret
    ir.fns[f as usize] = fd
    ir.externs.push(Extern(f, symbol, params))
}

/// Function f is exported (as `eider_<name>` in a library).
pub fn add_export(inout ir: Ir, f: u32, name: List[u8]) {
    ir.exports.push(Export(f, name))
}

// ---- dump (`eiderc ir`): one line per local, statement and constant

type Out = { b: List[u8] }

fn put(inout o: Out, s: str) { bytes.append(inout o.b, sys.lit(s)) }
fn putb(inout o: Out, s: List[u8]) { bytes.append(inout o.b, s) }
fn putn(inout o: Out, n: u64) { bytes.append(inout o.b, bytes.from_u64(n)) }
fn putty(inout o: Out, t: types.Types, names: intern.Interner, ty: u32) { types.show_into(inout o.b, t, names, ty) }

fn ind(inout o: Out, depth: u32) {
    for i in 0..depth { put(inout o, "  ") }
}

fn put_local(inout o: Out, l: u32) {
    put(inout o, "%")
    putn(inout o, l as u64)
}

fn put_op(inout o: Out, ir: Ir, t: types.Types, names: intern.Interner, id: u32) {
    let x = ir.ops[id as usize]
    match x.kind {
        0 => {
            let ik = types.ik(t, x.ty)
            if types.signed(ik) && x.v >= 9223372036854775808 {
                put(inout o, "-")
                putn(inout o, 0 -% x.v)
            } else {
                putn(inout o, x.v)
            }
            put(inout o, types.int_name(ik))
        }
        1 => { if x.v == 1 { put(inout o, "true") } else { put(inout o, "false") } }
        2 => diag.debug_str(inout o.b, ir.strs[x.a as usize])
        3 => put(inout o, "()")
        _ => put_local(inout o, x.a)
    }
}

fn put_place(inout o: Out, ir: Ir, t: types.Types, names: intern.Interner, id: u32) {
    let x = ir.places[id as usize]
    match x.kind {
        0 => put_local(inout o, x.a)
        1 => {
            put_place(inout o, ir, t, names, x.a)
            put(inout o, ".")
            putn(inout o, x.b as u64)
        }
        2 => {
            put_place(inout o, ir, t, names, x.a)
            put(inout o, "[")
            put_op(inout o, ir, t, names, x.b)
            put(inout o, "]@")
            putn(inout o, x.line as u64)
        }
        3 => {
            put_place(inout o, ir, t, names, x.a)
            put(inout o, ".<")
            putn(inout o, x.b as u64)
            put(inout o, ">.")
            putn(inout o, x.c as u64)
        }
        _ => {
            put(inout o, "*")
            put_place(inout o, ir, t, names, x.a)
        }
    }
}

fn put_args(inout o: Out, ir: Ir, t: types.Types, names: intern.Interner, start: u32, n: u32) {
    put(inout o, "(")
    for i in 0..n {
        if i > 0 { put(inout o, ", ") }
        let a = ir.extra[(start + i) as usize]
        if a >= ARG_PLACE {
            put(inout o, "inout ")
            put_place(inout o, ir, t, names, a - ARG_PLACE)
        } else {
            put_op(inout o, ir, t, names, a)
        }
    }
    put(inout o, ")")
}

fn put_dst(inout o: Out, dst: u32) {
    put_local(inout o, dst)
    put(inout o, " = ")
}

fn put_block(inout o: Out, ir: Ir, t: types.Types, names: intern.Interner, b: u32, depth: u32) {
    let bl = ir.blocks[b as usize]
    for i in 0..bl.len {
        put_stmt(inout o, ir, t, names, ir.extra[(bl.start + i) as usize], depth)
    }
}

fn put_stmt(inout o: Out, ir: Ir, t: types.Types, names: intern.Interner, id: u32, depth: u32) {
    let s = ir.stmts[id as usize]
    ind(inout o, depth)
    match s.kind {
        0 => {
            put_dst(inout o, s.dst)
            put_op(inout o, ir, t, names, s.a)
        }
        1 => {
            put_dst(inout o, s.dst)
            put(inout o, "read ")
            put_place(inout o, ir, t, names, s.a)
        }
        2 => {
            put(inout o, "store ")
            put_place(inout o, ir, t, names, s.a)
            put(inout o, " = ")
            put_op(inout o, ir, t, names, s.b)
        }
        3 => {
            put_dst(inout o, s.dst)
            if s.a == U_NEG { put(inout o, "neg ") } else if s.a == U_NOT { put(inout o, "not ") } else { put(inout o, "bnot ") }
            put_op(inout o, ir, t, names, s.b)
        }
        4 => {
            put_dst(inout o, s.dst)
            put_op(inout o, ir, t, names, s.b)
            put(inout o, " ")
            put(inout o, ast.op_text(s.a))
            put(inout o, " ")
            put_op(inout o, ir, t, names, s.c)
        }
        5 => {
            put_dst(inout o, s.dst)
            put_op(inout o, ir, t, names, s.a)
            put(inout o, " as ")
            putty(inout o, t, names, s.ty)
        }
        6 => {
            if s.dst != NONE { put_dst(inout o, s.dst) }
            put(inout o, "call ")
            putb(inout o, ir.fns[s.a as usize].name)
            put_args(inout o, ir, t, names, s.b, s.c)
        }
        7 => {
            put_dst(inout o, s.dst)
            putty(inout o, t, names, s.ty)
            put_args(inout o, ir, t, names, s.b, s.c)
        }
        8 => {
            put_dst(inout o, s.dst)
            putty(inout o, t, names, s.ty)
            put(inout o, ".<")
            putn(inout o, s.a as u64)
            put(inout o, ">")
            put_args(inout o, ir, t, names, s.b, s.c)
        }
        9 => {
            put_dst(inout o, s.dst)
            put(inout o, "array ")
            putty(inout o, t, names, s.ty)
            put_args(inout o, ir, t, names, s.b, s.c)
        }
        10 => {
            put_dst(inout o, s.dst)
            put(inout o, "repeat ")
            putty(inout o, t, names, s.ty)
            put(inout o, " (")
            put_op(inout o, ir, t, names, s.a)
            put(inout o, ")")
        }
        11 => {
            put_dst(inout o, s.dst)
            put(inout o, "tag ")
            put_place(inout o, ir, t, names, s.a)
            put(inout o, " is <")
            putn(inout o, s.b as u64)
            put(inout o, ">")
        }
        12 => {
            put(inout o, "print ")
            put_op(inout o, ir, t, names, s.a)
        }
        13 => {
            put_dst(inout o, s.dst)
            put(inout o, "now_ms()")
        }
        14 => {
            put(inout o, "panic ")
            put_op(inout o, ir, t, names, s.a)
        }
        15 => {
            put(inout o, "assert ")
            put_op(inout o, ir, t, names, s.a)
            if s.b > 0 {
                put(inout o, ", ")
                diag.debug_str(inout o.b, ir.strs[(s.b - 1) as usize])
            }
        }
        16 => {
            put(inout o, "if ")
            put_op(inout o, ir, t, names, s.a)
            put(inout o, " \x7b\n")
            put_block(inout o, ir, t, names, s.b, depth + 1)
            ind(inout o, depth)
            put(inout o, "\x7d else \x7b\n")
            put_block(inout o, ir, t, names, s.c, depth + 1)
            ind(inout o, depth)
            put(inout o, r"}")
        }
        17 => {
            put(inout o, "loop \x7b\n")
            put_block(inout o, ir, t, names, s.a, depth + 1)
            ind(inout o, depth)
            put(inout o, "\x7d step \x7b\n")
            put_block(inout o, ir, t, names, s.b, depth + 1)
            ind(inout o, depth)
            put(inout o, r"}")
        }
        18 => {
            put(inout o, "break")
            if s.a > 0 {
                put(inout o, " outer ")
                putn(inout o, s.a as u64)
            }
        }
        19 => {
            put(inout o, "continue")
            if s.a > 0 {
                put(inout o, " outer ")
                putn(inout o, s.a as u64)
            }
        }
        21 => {
            put_dst(inout o, s.dst)
            put(inout o, "tuple ")
            putty(inout o, t, names, s.ty)
            put_args(inout o, ir, t, names, s.b, s.c)
        }
        22 => {
            put_dst(inout o, s.dst)
            put(inout o, "clone ")
            put_op(inout o, ir, t, names, s.a)
        }
        23 => {
            put(inout o, "drop ")
            put_place(inout o, ir, t, names, s.a)
            put(inout o, ": ")
            putty(inout o, t, names, s.ty)
        }
        24 => {
            put_dst(inout o, s.dst)
            put(inout o, "move ")
            put_place(inout o, ir, t, names, s.a)
        }
        25 => {
            if s.dst != NONE { put_dst(inout o, s.dst) }
            put(inout o, builtin_name(s.a))
            put_args(inout o, ir, t, names, s.b, s.c)
        }
        26 => {
            put_dst(inout o, s.dst)
            put(inout o, "closure ")
            putb(inout o, ir.fns[s.a as usize].name)
            put_args(inout o, ir, t, names, s.b, s.c)
        }
        27 => {
            put_dst(inout o, s.dst)
            put(inout o, "fnref ")
            putb(inout o, ir.fns[s.a as usize].name)
        }
        28 => {
            if s.dst != NONE { put_dst(inout o, s.dst) }
            put(inout o, "callv ")
            put_op(inout o, ir, t, names, s.a)
            put_args(inout o, ir, t, names, s.b, s.c)
        }
        30 => {
            put(inout o, "check ")
            put_place(inout o, ir, t, names, s.a)
        }
        _ => {
            put(inout o, "return")
            if s.a > 0 {
                put(inout o, " ")
                put_op(inout o, ir, t, names, s.a - 1)
            }
        }
    }
    // the source line of operations that can trap (index places print their own)
    let traps = (s.kind == S_UNARY && s.a == U_NEG) || (s.kind == S_BINARY && (s.a <= ast.OP_REM || s.a == ast.OP_SHL || s.a == ast.OP_SHR)) || s.kind == S_CAST || s.kind == S_PANIC || s.kind == S_ASSERT || (s.kind == S_BUILTIN && (s.a == B_LIST_SUM || s.a == B_STR_BYTE || s.a == B_STR_SLICE || s.a == B_STR_PUSH_BYTE))
    if s.line > 0 && traps {
        put(inout o, "  @")
        putn(inout o, s.line as u64)
    }
    put(inout o, "\n")
}

fn kind_text(k: u32) -> str {
    match k {
        0 => "param"
        1 => "inout"
        2 => "let"
        3 => "var"
        5 => "capture"
        _ => "temp"
    }
}

/// The whole program as text.
pub fn dump(ir: Ir, t: types.Types, names: intern.Interner) -> List[u8] {
    let mut o = Out(List.new())
    for c in ir.consts {
        put(inout o, "const ")
        putb(inout o, c.name)
        put(inout o, ": ")
        putty(inout o, t, names, c.ty)
        put(inout o, " = ")
        put_op(inout o, ir, t, names, c.op)
        put(inout o, "\n")
    }
    for x in ir.externs {
        put(inout o, "extern ")
        putb(inout o, ir.fns[x.f as usize].name)
        put(inout o, "(")
        for i in 0..x.params.len() {
            if i > 0 { put(inout o, ", ") }
            putty(inout o, t, names, x.params[i])
        }
        put(inout o, ") -> ")
        putty(inout o, t, names, ir.fns[x.f as usize].ret)
        put(inout o, " = \"")
        putb(inout o, x.symbol)
        put(inout o, "\"\n")
    }
    for x in ir.exports {
        put(inout o, "export ")
        putb(inout o, ir.fns[x.f as usize].name)
        put(inout o, " as eider_")
        putb(inout o, x.name)
        put(inout o, "\n")
    }
    for f in ir.fns {
        if f.body == 0 { continue }
        put(inout o, "\n")
        if f.is_test { put(inout o, "test ") } else { put(inout o, "fn ") }
        putb(inout o, f.name)
        put(inout o, " -> ")
        putty(inout o, t, names, f.ret)
        if f.caps.len() > 0 {
            put(inout o, " uses ")
            putb(inout o, f.caps)
        }
        put(inout o, "\n")
        for i in 0..f.lcount {
            let l = ir.locals[(f.lstart + i) as usize]
            put(inout o, "  ")
            put_local(inout o, i)
            put(inout o, " ")
            put(inout o, kind_text(l.kind))
            if l.kind != L_TEMP {
                put(inout o, " ")
                putb(inout o, intern.name(names, l.name))
            }
            put(inout o, ": ")
            putty(inout o, t, names, l.ty)
            put(inout o, "\n")
        }
        put(inout o, "  \x7b\n")
        put_block(inout o, ir, t, names, f.body - 1, 2)
        put(inout o, "  \x7d\n")
    }
    o.b
}

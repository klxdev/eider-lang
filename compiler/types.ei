// types: the interned type arena. A type is a small record `{kind, a, b}` addressed by a u32
// id; equal types have equal ids, so the checker compares types as integers.
//
//   T_INT     a = int kind (IK_*)          T_BOOL  T_STR  T_UNIT  T_NEVER  T_STRING
//   T_ENUM    a = def                      T_RECORD a = def
//   T_ARRAY   a = element type, b = length
//   T_TUPLE   a = type list (element types), b = element count
//   T_LIST    a = element type             T_BOX   a = element type
//   T_MAP     a = key type, b = value type
//   T_FN      a = type list (parameter types), b = return type
//   T_TASK    a = result type (`Task[T]`; creating one also interns `fn() -> T`)
//   T_MUTEX   a = element type             T_CHAN  a = element type
//             (shared, reference-counted handles: copying one shares the same object)
//   T_POISON  the type of an expression whose checking failed (see `poison` below)
//
// The primitive types have fixed ids (I32 .. STRING below). Enums and records are named
// definitions (`Def`) with their fields or variants in the shared `fields` / `variants`
// lists. A generic type is a template definition that is never filled; each instance
// (`Option[i32]`) is its own definition (`tmpl` = the template, `args` = its type
// arguments), created on demand (monomorphization). A definition is created empty and
// filled once its field types are resolved, so a type that mentions itself sees an empty
// definition while it is being filled (that is how E0108 is detected).
//
// Type lists (tuple elements, fn parameters, instance arguments) are interned too: equal
// lists have equal ids, so composite types are compared as integers as well.

import "core/sys"
import "std/bytes"
import "intern.ei"
import "resolve.ei"

pub const T_INT: u32 = 0
pub const T_BOOL: u32 = 1
pub const T_STR: u32 = 2
pub const T_UNIT: u32 = 3
pub const T_NEVER: u32 = 4
pub const T_ENUM: u32 = 5
pub const T_RECORD: u32 = 6
pub const T_ARRAY: u32 = 7
pub const T_TUPLE: u32 = 8
pub const T_STRING: u32 = 9
pub const T_LIST: u32 = 10
pub const T_MAP: u32 = 11
pub const T_BOX: u32 = 12
pub const T_FN: u32 = 13
pub const T_TASK: u32 = 14
pub const T_MUTEX: u32 = 15
pub const T_CHAN: u32 = 16
pub const T_POISON: u32 = 17
/// A type parameter of a generic declaration, as its body is checked against the bounds
/// (check.ei, "Bounds of generic code"): a = its symbol, b = the declaration + 1. Only the
/// checker's throw-away pass makes them, so lowering never sees one.
pub const T_PARAM: u32 = 18

/// Int kinds, in a fixed order.
pub const IK_I32: u32 = 0
pub const IK_I64: u32 = 1
pub const IK_U8: u32 = 2
pub const IK_U32: u32 = 3
pub const IK_U64: u32 = 4
pub const IK_USIZE: u32 = 5

/// Fixed type ids.
pub const I32: u32 = 0
pub const I64: u32 = 1
pub const U8: u32 = 2
pub const U32: u32 = 3
pub const U64: u32 = 4
pub const USIZE: u32 = 5
pub const BOOL: u32 = 6
pub const STR: u32 = 7
pub const UNIT: u32 = 8
pub const NEVER: u32 = 9
pub const STRING: u32 = 10

/// "no type" / "no definition"
pub const NOTY: u32 = 4294967295

pub type Ty = { kind: u32, a: u32, b: u32 }

/// A record field or a variant field. `name` is a symbol (unnamed variant fields are named
/// by their position); `tnode` is its type in the declaring module's AST.
pub type Field = { name: u32, ty: u32, tnode: u32, line: u32, col: u32 }

/// `key` is the variant's global name key (see resolve.key); `arity` its declared field
/// count (known before the fields are resolved).
pub type Variant = { key: u64, arity: u32, fstart: u32, flen: u32 }

/// An enum or record. `md` is the declaring module. For records `start/len` index
/// `fields`; for enums they index `variants`. `generic` is the template's number of type
/// parameters (0 for instances and non-generic types); `tmpl` is the template definition of
/// an instance (itself for a non-generic type) and `args` its type argument list.
pub type Def = {
    key: u64, md: u32, public: bool, node: u32, is_enum: bool, generic: u32,
    ty: u32, start: u32, len: u32, payload: bool, filled: bool, tmpl: u32, args: u32,
}

pub type Span = { start: u32, len: u32 }

pub type Types = {
    tys: List[Ty],
    arrays: Map[u64, u32],
    defs: List[Def],
    fields: List[Field],
    variants: List[Variant],
    /// interned composite types other than arrays: kind * 2^56 + a * 2^28 + b
    comps: Map[u64, u32],
    /// interned type lists: their cells, and each list's span of them
    cells: List[u32],
    lists: List[Span],
}

pub fn new() -> Types {
    var t = Types(List.new(), Map.new(), List.new(), List.new(), List.new(), Map.new(), List.new(), List.new())
    for i in 0..6 { t.tys.push(Ty(T_INT, i as u32, 0)) }
    t.tys.push(Ty(T_BOOL, 0, 0))
    t.tys.push(Ty(T_STR, 0, 0))
    t.tys.push(Ty(T_UNIT, 0, 0))
    t.tys.push(Ty(T_NEVER, 0, 0))
    t.tys.push(Ty(T_STRING, 0, 0))
    // list 0 is the empty list
    t.lists.push(Span(0, 0))
    t
}

pub const EMPTY: u32 = 0

/// The id of the type list `xs`.
pub fn list(inout t: Types, xs: List[u32]) -> u32 {
    let n = xs.len() as u32
    for i in 0..t.lists.len() {
        let sp = t.lists[i]
        if sp.len != n { continue }
        var same = true
        for j in 0..n {
            if t.cells[(sp.start + j) as usize] != xs[j as usize] {
                same = false
                break
            }
        }
        if same { return i as u32 }
    }
    let start = t.cells.len() as u32
    for x in xs { t.cells.push(x) }
    t.lists.push(Span(start, n))
    (t.lists.len() - 1) as u32
}

pub fn list_len(t: Types, l: u32) -> u32 { t.lists[l as usize].len }
pub fn list_at(t: Types, l: u32, i: u32) -> u32 { t.cells[(t.lists[l as usize].start + i) as usize] }
pub fn list_items(t: Types, l: u32) -> List[u32] {
    var out: List[u32] = List.new()
    let sp = t.lists[l as usize]
    for i in 0..sp.len { out.push(t.cells[(sp.start + i) as usize]) }
    out
}

fn comp(inout t: Types, k: u32, a: u32, b: u32) -> u32 {
    let key = (k as u64) * 72057594037927936 + (a as u64) * 268435456 + b as u64
    match t.comps.get(key) {
        Some(id) => { return id }
        None => {}
    }
    let id = t.tys.len() as u32
    t.tys.push(Ty(k, a, b))
    t.comps.insert(key, id)
    id
}

pub fn tuple(inout t: Types, elems: List[u32]) -> u32 {
    let l = list(inout t, elems)
    comp(inout t, T_TUPLE, l, elems.len() as u32)
}
pub fn list_of(inout t: Types, elem: u32) -> u32 { comp(inout t, T_LIST, elem, 0) }
pub fn map_of(inout t: Types, k: u32, v: u32) -> u32 { comp(inout t, T_MAP, k, v) }
pub fn box_of(inout t: Types, elem: u32) -> u32 { comp(inout t, T_BOX, elem, 0) }
pub fn fn_of(inout t: Types, params: List[u32], ret: u32) -> u32 {
    let l = list(inout t, params)
    comp(inout t, T_FN, l, ret)
}
/// `Task[elem]`; also interns `fn() -> elem`, the closure a Task runs (its layout holds one).
pub fn task_of(inout t: Types, elem: u32) -> u32 {
    let run = fn_of(inout t, List.new(), elem)
    comp(inout t, T_TASK, elem, 0)
}
pub fn mutex_of(inout t: Types, elem: u32) -> u32 { comp(inout t, T_MUTEX, elem, 0) }
pub fn chan_of(inout t: Types, elem: u32) -> u32 { comp(inout t, T_CHAN, elem, 0) }

/// The error type ("poison"): the type of an expression, binding, field or signature part
/// whose checking failed after a diagnostic was recorded. It is compatible with every type,
/// so the checker can go on without reporting errors that are only consequences of the
/// first (check.ei, "Recovery"); it is shown as `{error}`, and a diagnostic whose text
/// mentions it is such a consequence and is never reported. It is interned on first use,
/// so a program without errors never has it (lowering never sees it).
pub fn poison(inout t: Types) -> u32 { comp(inout t, T_POISON, 0, 0) }

/// Type parameter `sym` of declaration `owner` (T_PARAM).
pub fn param(inout t: Types, sym: u32, owner: u32) -> u32 { comp(inout t, T_PARAM, sym, owner + 1) }

/// Whether type `id` is the error type or is built from it (`List[{error}]`, `(i32, {error})`,
/// `Option[{error}]`, ...). NOTY is not.
pub fn has_poison(t: Types, id: u32) -> bool {
    if id == NOTY || id as usize >= t.tys.len() { return false }
    let ty = t.tys[id as usize]
    let k = ty.kind
    if k == T_POISON { return true }
    if k == T_ARRAY || k == T_LIST || k == T_BOX || is_handle(k) { return has_poison(t, ty.a) }
    if k == T_MAP { return has_poison(t, ty.a) || has_poison(t, ty.b) }
    if k == T_TUPLE || k == T_FN {
        for x in list_items(t, ty.a) {
            if has_poison(t, x) { return true }
        }
        return k == T_FN && has_poison(t, ty.b)
    }
    if k == T_ENUM || k == T_RECORD {
        let d = t.defs[ty.a as usize]
        if d.args == NOTY { return false }
        for x in list_items(t, d.args) {
            if has_poison(t, x) { return true }
        }
    }
    false
}

/// Whether `k` is one of the shared handle kinds (Task, Mutex, Chan).
pub fn is_handle(k: u32) -> bool { k == T_TASK || k == T_MUTEX || k == T_CHAN }

/// The id of an interned composite type (not an array) if it exists, else NOTY. Read-only,
/// for passes that can't intern (lowering).
pub fn find_comp(t: Types, k: u32, a: u32, b: u32) -> u32 {
    let key = (k as u64) * 72057594037927936 + (a as u64) * 268435456 + b as u64
    match t.comps.get(key) {
        Some(id) => id
        None => NOTY
    }
}

/// The id of the interned type list `xs` if it exists, else NOTY (read-only `list`).
pub fn find_list(t: Types, xs: List[u32]) -> u32 {
    let n = xs.len() as u32
    for i in 0..t.lists.len() {
        let sp = t.lists[i]
        if sp.len != n { continue }
        var same = true
        for j in 0..n {
            if t.cells[(sp.start + j) as usize] != xs[j as usize] {
                same = false
                break
            }
        }
        if same { return i as u32 }
    }
    NOTY
}

/// The element types of a tuple, or the parameter types of a fn type.
pub fn elems(t: Types, ty: u32) -> List[u32] { list_items(t, t.tys[ty as usize].a) }

/// The instance of template `tmpl` with argument list `args`, if it exists.
pub fn find_inst(t: Types, tmpl: u32, args: u32) -> u32 {
    for i in 0..t.defs.len() {
        let d = t.defs[i]
        if d.tmpl == tmpl && d.args == args && d.generic == 0 { return i as u32 }
    }
    NOTY
}

pub fn kind(t: Types, id: u32) -> u32 { t.tys[id as usize].kind }
pub fn get(t: Types, id: u32) -> Ty { t.tys[id as usize] }

pub fn is_int(t: Types, id: u32) -> bool { t.tys[id as usize].kind == T_INT }

pub fn array(inout t: Types, elem: u32, len: u32) -> u32 {
    let k = (elem as u64) * 4294967296 + len as u64
    match t.arrays.get(k) {
        Some(id) => { return id }
        None => {}
    }
    let id = t.tys.len() as u32
    t.tys.push(Ty(T_ARRAY, elem, len))
    t.arrays.insert(k, id)
    id
}

/// A new (empty) definition and its type.
pub fn add_def(inout t: Types, d: Def) -> u32 {
    let di = t.defs.len() as u32
    let id = t.tys.len() as u32
    let k = if d.is_enum { T_ENUM } else { T_RECORD }
    t.tys.push(Ty(k, di, 0))
    var d2 = d
    d2.ty = id
    if d2.tmpl == NOTY { d2.tmpl = di }
    t.defs.push(d2)
    di
}

pub fn def_of(t: Types, ty: u32) -> Def { t.defs[t.tys[ty as usize].a as usize] }

/// Field `i` of a record definition, or of a variant (`start` = Variant.fstart).
pub fn field(t: Types, start: u32, i: u32) -> Field { t.fields[(start + i) as usize] }

pub fn variant(t: Types, d: Def, i: u32) -> Variant { t.variants[(d.start + i) as usize] }

/// Index of the variant named `key` in enum `d`, if any.
pub fn find_variant(t: Types, d: Def, key: u64) -> Option[u32] {
    for i in 0..d.len {
        if t.variants[(d.start + i) as usize].key == key { return Some(i) }
    }
    None
}

/// Index of the record field named `sym`, if any.
pub fn find_field(t: Types, d: Def, sym: u32) -> Option[u32] {
    for i in 0..d.len {
        if t.fields[(d.start + i) as usize].name == sym { return Some(i) }
    }
    None
}

// ---- integers

pub fn ik(t: Types, id: u32) -> u32 { t.tys[id as usize].a }

pub fn int_name(k: u32) -> str {
    match k {
        0 => "i32"
        1 => "i64"
        2 => "u8"
        3 => "u32"
        4 => "u64"
        _ => "usize"
    }
}

pub fn signed(k: u32) -> bool { k == IK_I32 || k == IK_I64 }

pub fn bits(k: u32) -> u32 {
    match k {
        0 => 32
        3 => 32
        2 => 8
        _ => 64
    }
}

// ---- display (type names as diagnostics print them; module names stay mangled, `diag` demangles)

pub fn show(t: Types, names: intern.Interner, id: u32) -> List[u8] uses ffi {
    var out: List[u8] = List.new()
    show_into(inout out, t, names, id)
    out
}

pub fn show_into(inout out: List[u8], t: Types, names: intern.Interner, id: u32) uses ffi {
    let ty = t.tys[id as usize]
    match ty.kind {
        0 => bytes.append(inout out, sys.lit(int_name(ty.a)))
        1 => bytes.append(inout out, sys.lit("bool"))
        2 => bytes.append(inout out, sys.lit("str"))
        3 => bytes.append(inout out, sys.lit("()"))
        4 => out.push(33)
        7 => {
            out.push(91)
            show_into(inout out, t, names, ty.a)
            bytes.append(inout out, sys.lit("; "))
            bytes.append(inout out, bytes.from_u64(ty.b as u64))
            out.push(93)
        }
        8 => {
            out.push(40)
            show_list(inout out, t, names, ty.a)
            out.push(41)
        }
        9 => bytes.append(inout out, sys.lit("String"))
        10 => {
            bytes.append(inout out, sys.lit("List["))
            show_into(inout out, t, names, ty.a)
            out.push(93)
        }
        11 => {
            bytes.append(inout out, sys.lit("Map["))
            show_into(inout out, t, names, ty.a)
            bytes.append(inout out, sys.lit(", "))
            show_into(inout out, t, names, ty.b)
            out.push(93)
        }
        12 => {
            bytes.append(inout out, sys.lit("Box["))
            show_into(inout out, t, names, ty.a)
            out.push(93)
        }
        14 => {
            bytes.append(inout out, sys.lit("Task["))
            show_into(inout out, t, names, ty.a)
            out.push(93)
        }
        15 => {
            bytes.append(inout out, sys.lit("Mutex["))
            show_into(inout out, t, names, ty.a)
            out.push(93)
        }
        16 => {
            bytes.append(inout out, sys.lit("Chan["))
            show_into(inout out, t, names, ty.a)
            out.push(93)
        }
        17 => bytes.append(inout out, sys.lit("{error}"))
        18 => bytes.append(inout out, intern.name(names, ty.a))
        13 => {
            bytes.append(inout out, sys.lit("fn("))
            show_list(inout out, t, names, ty.a)
            out.push(41)
            if ty.b != UNIT {
                bytes.append(inout out, sys.lit(" -> "))
                show_into(inout out, t, names, ty.b)
            }
        }
        _ => {
            let d = t.defs[ty.a as usize]
            bytes.append(inout out, resolve.key_text(names, d.key))
            if d.args != NOTY && list_len(t, d.args) > 0 {
                out.push(91)
                show_list(inout out, t, names, d.args)
                out.push(93)
            }
        }
    }
}

fn show_list(inout out: List[u8], t: Types, names: intern.Interner, l: u32) uses ffi {
    for i in 0..list_len(t, l) {
        if i > 0 { bytes.append(inout out, sys.lit(", ")) }
        show_into(inout out, t, names, list_at(t, l, i))
    }
}

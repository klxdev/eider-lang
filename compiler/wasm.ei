// wasm: `build --wasm` and `build --wasm-core` (docs/compiler.md, "C7: WebAssembly" and
// "Backends"). WebAssembly is an optional target (LAYERS.md, "Dependencies"): only these
// commands need clang's wasm32 target and wasm-ld.
//
// `--wasm`: the checker has checked the program as a WebAssembly module (check.check_wasm,
// E0806), and llvm.ei has lowered it for wasm32 (4-byte pointers, clang's WebAssembly C ABI),
// whose `eider_<name>` entry points are exported under that name ("wasm-export-name"). Both are built with the WebAssembly core instead of the
// native one (core/wasm/README.md: core/wasm/eider_rt.c, the runtime, and core/wasm/libc.c,
// the freestanding C library) by $WASM_CC (default clang), with an explicit feature set
// (`features`: MVP, sign-ext, bulk-memory, mutable-globals):
//
//   clang <features> -O2 -c -o prog_ll.o prog.ll
//   clang <features> -std=c11 -O2 -ffreestanding -nostdlib -fno-builtin -w
//         -isystem <root>/core/wasm/include -I <root>/core -Wl,--no-entry -Wl,--allow-undefined
//         -o <name>.wasm prog_ll.o <root>/core/wasm/eider_rt.c <root>/core/wasm/libc.c
//
// --allow-undefined turns every function the module does not define (`extern "c"`
// functions, the native core's ec_*) into an import from "env", which the host supplies
// through the loader's `imports`.
//
// Next to <name>.wasm go <name>.d.ts (TypeScript declarations of the exports) and <name>.js
// (an ES module loader that supplies the host imports and wraps the exports), byte-identical
// to what tests/oracle records. `emit-header --wasm` prints both the way the oracle
// records them: the declarations, a \x01 byte, then the loader naming the module `@WASM@`.
//
// `--wasm-core`: an ordinary program (with `main`) as a core module: the same build with
// -DEI_WASM_CORE and 32 MiB of stack placed first; it exports `_start` and imports only the
// C core's functions (env.ec_*, core/ABI.md), so a host that links core/eider_core.c runs it
// (seed/wasm2c.c translates it to C for that: the compiler's seed, seed/README.md).

import core.sys
import std.bytes
import std.fs
import std.io
import std.env
import std.proc
import eiderc.intern
import eiderc.types
import eiderc.ir
import eiderc.lower
import eiderc.driver

fn s(x: str) -> List[u8] { sys.lit(x) }

/// A type as TypeScript sees it crossing the boundary: 64-bit integers are
/// BigInts, the other integers numbers.
fn ts_ty(p: lower.P, ty: u32) -> str {
    if ty == types.UNIT || ty == types.NEVER { return "void" }
    let k = types.kind(p.t, ty)
    if k == types.T_BOOL { return "boolean" }
    let ik = types.ik(p.t, ty)
    if k == types.T_INT && (ik == 1 || ik >= 4) { return "bigint" }
    "number"
}

fn param_name(p: lower.P, fd: ir.Fn, i: u32) -> List[u8] { intern.name(p.names, p.ir.locals[(fd.lstart + i) as usize].name) }

/// <name>.d.ts: the exports' TypeScript declarations.
pub fn dts(p: lower.P) -> List[u8] {
    let mut o = s("// generated by eider\nexport interface EiderExports {\n")
    for x in p.ir.exports {
        let fd = p.ir.fns[x.f as usize]
        bytes.append(inout o, s("  "))
        bytes.append(inout o, x.name)
        o.push(40)
        for i in 0..fd.nparams {
            if i > 0 { bytes.append(inout o, s(", ")) }
            bytes.append(inout o, param_name(p, fd, i))
            bytes.append(inout o, s(": "))
            bytes.append(inout o, s(ts_ty(p, p.ir.locals[(fd.lstart + i) as usize].ty)))
        }
        bytes.append(inout o, s("): "))
        bytes.append(inout o, s(ts_ty(p, fd.ret)))
        bytes.append(inout o, s(";\n"))
    }
    bytes.append(inout o, s("}\nexport interface EiderImports { [name: string]: (...args: any[]) => any }\nexport function load(wasm: BufferSource | WebAssembly.Module, imports?: EiderImports): Promise<EiderExports>;\n"))
    o
}

/// <name>.js: instantiates the module `wasm_file` with the host imports (core/wasm/README.md)
/// plus the caller's, and wraps each export (bool results become JavaScript booleans).
pub fn loader(p: lower.P, wasm_file: List[u8]) -> List[u8] {
    let mut o = s("// generated by eider: loader for ")
    bytes.append(inout o, wasm_file)
    bytes.append(inout o, s("\nexport async function load(wasm, imports = {}) {\n  let mem;\n  const dec = new TextDecoder();\n  const env = {\n    eider_write(p, n) { (typeof process !== 'undefined' ? process.stdout.write.bind(process.stdout) : console.log)(dec.decode(new Uint8Array(mem.buffer, p, n))); },\n    eider_now_ms() { return BigInt(Date.now()); },\n    ...imports,\n  };\n  const src = wasm instanceof WebAssembly.Module ? wasm : await WebAssembly.compile(wasm);\n  const inst = await WebAssembly.instantiate(src, { env });\n  mem = inst.exports.memory;\n  const x = inst.exports;\n  return {\n"))
    for x in p.ir.exports {
        let fd = p.ir.fns[x.f as usize]
        let mut args: List[u8] = List.new()
        for i in 0..fd.nparams {
            if i > 0 { bytes.append(inout args, s(", ")) }
            bytes.append(inout args, param_name(p, fd, i))
        }
        bytes.append(inout o, s("    "))
        bytes.append(inout o, x.name)
        bytes.append(inout o, s(": ("))
        bytes.append(inout o, args)
        bytes.append(inout o, s(") => "))
        if fd.ret == types.BOOL { bytes.append(inout o, s("!!")) }
        bytes.append(inout o, s("x.eider_"))
        bytes.append(inout o, x.name)
        o.push(40)
        bytes.append(inout o, args)
        bytes.append(inout o, s("),\n"))
    }
    bytes.append(inout o, s("  };\n}\n"))
    o
}

/// `emit-header --wasm`: both texts, in the recorded form.
pub fn header(p: lower.P) -> List[u8] {
    let mut o = dts(p)
    o.push(1)
    bytes.append(inout o, loader(p, s("@WASM@")))
    o
}

/// The WebAssembly features modules are built with (and seed/wasm2c.c translates): the MVP,
/// sign extension, bulk memory (memory.copy, memory.fill) and mutable globals.
pub fn features() -> List[List[u8]] {
    let mut f: List[List[u8]] = List.new()
    for a in ["--target=wasm32-unknown-unknown", "-mcpu=mvp", "-msign-ext", "-mbulk-memory", "-mmutable-globals"] { f.push(s(a)) }
    f
}

fn wasm_cc() -> List[u8] uses io {
    let mut cc = s("clang")
    match env.get(s("WASM_CC")) {
        Some(x) => { if x.len() > 0 { cc = x } }
        None => {}
    }
    cc
}

/// Build a module at `wasm_file` from the LLVM IR `ll` (llvm.ei) with the WebAssembly core
/// (core/wasm). `core`: a core module
/// (`--wasm-core`; core/wasm/README.md "Core modules"): -DEI_WASM_CORE, 32 MiB of stack
/// placed first (an overflow is an out-of-bounds access, not corrupted data), `_start`.
fn link(ll: List[u8], wasm_file: List[u8], core_mod: bool) uses io, fs, net, clock {
    let dir = driver.temp_dir()
    let core = fs.join(driver.root(), s("core"))
    let llfile = fs.join(dir, s("prog.ll"))
    driver.write_or_fail(llfile, ll)
    let obj = fs.join(dir, s("prog_ll.o"))
    let cc = wasm_cc()
    let mut ca: List[List[u8]] = List.new()
    ca.push(cc.copy())
    for a in features() { ca.push(a) }
    for a in ["-O2", "-c", "-Wno-override-module", "-o"] { ca.push(s(a)) }
    ca.push(obj.copy())
    ca.push(llfile)
    let mut code = match proc.run(ca) {
        Ok(n) => n
        Err(_) => -1
    }
    if code == 0 {
        let mut argv: List[List[u8]] = List.new()
        argv.push(cc)
        for a in features() { argv.push(a) }
        for a in ["-std=c11", "-O2", "-ffreestanding", "-nostdlib", "-fno-builtin", "-w", "-isystem"] { argv.push(s(a)) }
        argv.push(fs.join(core, s("wasm/include")))
        argv.push(s("-I"))
        argv.push(core.copy())
        if core_mod {
            // --strip-all: no name section (it would name the output file) or producers
            for a in ["-DEI_WASM_CORE", "-Wl,--stack-first", "-Wl,-z,stack-size=33554432", "-Wl,--strip-all"] { argv.push(s(a)) }
        }
        for a in ["-Wl,--no-entry", "-Wl,--allow-undefined", "-o"] { argv.push(s(a)) }
        argv.push(wasm_file)
        argv.push(obj)
        argv.push(fs.join(core, s("wasm/eider_rt.c")))
        argv.push(fs.join(core, s("wasm/libc.c")))
        code = match proc.run(argv) {
            Ok(n) => n
            Err(_) => -1
        }
    }
    fs.remove_all(dir)
    if code != 0 { driver.fail(s("wasm build failed (needs clang with the wasm32 target and wasm-ld; set WASM_CC to override)"), 3) }
}

/// `eiderc build --wasm` (and `run --wasm`, which builds the same): <name>.wasm, <name>.d.ts and
/// <name>.js, where <name> is `-o`'s path, else the source's stem.
pub fn build(ll: List[u8], p: lower.P, file: List[u8], out: List[u8]) uses io, fs, net, clock {
    let mut base = out.copy()
    if base.len() == 0 { base = driver.stem(file) }
    let mut wasm_file = base.copy()
    bytes.append(inout wasm_file, s(".wasm"))
    link(ll, wasm_file, false)
    let mut dts_file = base.copy()
    bytes.append(inout dts_file, s(".d.ts"))
    let mut js_file = base.copy()
    bytes.append(inout js_file, s(".js"))
    driver.write_or_fail(dts_file, dts(p))
    let mut name = wasm_file.copy()
    match bytes.rfind_byte(wasm_file, 47) {
        Some(i) => { name = bytes.slice(wasm_file, i + 1, wasm_file.len()) }
        None => {}
    }
    driver.write_or_fail(js_file, loader(p, name))
    let mut m = s("built ")
    bytes.append(inout m, wasm_file)
    bytes.append(inout m, s(", "))
    bytes.append(inout m, dts_file)
    bytes.append(inout m, s(", "))
    bytes.append(inout m, js_file)
    io.outln(m)
}

/// `eiderc build --wasm-core`: the program as a core module at `-o`'s path, else
/// <stem>.wasm (core/wasm/README.md "Core modules"); prints `built <wasm>`.
pub fn build_core(ll: List[u8], file: List[u8], out: List[u8]) uses io, fs, net, clock {
    let mut wasm_file = out.copy()
    if wasm_file.len() == 0 {
        wasm_file = driver.stem(file)
        bytes.append(inout wasm_file, s(".wasm"))
    }
    link(ll, wasm_file, true)
    let mut m = s("built ")
    bytes.append(inout m, wasm_file)
    io.outln(m)
}

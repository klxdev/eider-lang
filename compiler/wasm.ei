// wasm: `build --wasm` and `build --wasm-core` (docs/compiler.md, "C7: WebAssembly" and
// "Backends"). WebAssembly is an optional target (LAYERS.md, "Dependencies"): only these
// commands need clang's wasm32 target and wasm-ld.
//
// `--wasm`: the checker has checked the program as a WebAssembly module (check.check_wasm,
// E0806), and llvm.ei has lowered it for wasm32 (4-byte pointers, clang's WebAssembly C ABI),
// whose `eider_<name>` entry points are exported under that name ("wasm-export-name"). Both are built with the WebAssembly core instead of the
// native one (core/wasm/README.md: core/wasm/eider_rt.c, the runtime, and core/wasm/libc.c,
// the freestanding C library) by $WASM_CC (default clang), with an explicit feature set
// (`features`: MVP, sign-ext, bulk-memory, mutable-globals):
//
//   clang <features> -O2 -c -o prog_ll.o prog.ll
//   clang <features> -std=c11 -O2 -ffreestanding -nostdlib -fno-builtin -w
//         -isystem <root>/core/wasm/include -I <root>/core -Wl,--no-entry -Wl,--allow-undefined
//         -o <name>.wasm prog_ll.o <root>/core/wasm/eider_rt.c <root>/core/wasm/libc.c
//
// --allow-undefined turns every function the module does not define (`extern "c"`
// functions, the native core's ec_*) into an import from "env", which the host supplies
// through the loader's `imports`.
//
// Next to <name>.wasm go <name>.d.ts (TypeScript declarations of the exports) and <name>.js
// (an ES module loader that supplies the host imports and wraps the exports), byte-identical
// to what tests/oracle records. `emit-header --wasm` prints both the way the oracle
// records them: the declarations, a \x01 byte, then the loader naming the module `@WASM@`.
//
// `--wasm-core`: an ordinary program (with `main`) as a core module: the same build with
// -DEI_WASM_CORE and 32 MiB of stack placed first; it exports `_start` and imports only the
// C core's functions (env.ec_*, core/ABI.md), so a host that links core/eider_core.c runs it
// (seed/wasm2c.c translates it to C for that: the compiler's seed, seed/README.md).

import core.sys
import std.bytes
import std.fs
import std.io
import std.env
import std.proc
import eiderc.intern
import eiderc.types
import eiderc.ir
import eiderc.lower
import eiderc.driver

fn s(x: str) -> List[u8] { sys.lit(x) }

/// Appends the text and a newline.
fn ln(inout o: List[u8], t: str) {
    bytes.append(inout o, s(t))
    o.push(10)
}

/// a if c else b.
fn pick(c: bool, a: str, b: str) -> str {
    if c { return a }
    b
}

fn put(inout o: List[u8], t: str) { bytes.append(inout o, s(t)) }

/// How an export's value crosses the boundary: 0 a number, bool or (), 1 a String, 2 a
/// List[u8] (both through memory: core/wasm/README.md, "Values across the boundary").
fn cross(p: lower.P, ty: u32) -> u32 {
    let k = types.kind(p.t, ty)
    if k == types.T_STRING { return 1 }
    if k == types.T_LIST { return 2 }
    0
}

fn param_ty(p: lower.P, fd: ir.Fn, i: u32) -> u32 { p.ir.locals[(fd.lstart + i) as usize].ty }

/// Whether an export takes or returns a String or List[u8], so that `wrappers` exports it.
fn marshals(p: lower.P, fd: ir.Fn) -> bool {
    if cross(p, fd.ret) != 0 { return true }
    for i in 0..fd.nparams {
        if cross(p, param_ty(p, fd, i)) != 0 { return true }
    }
    false
}

/// Whether any export takes or returns a String or List[u8].
pub fn any_marshals(p: lower.P) -> bool {
    for x in p.ir.exports {
        if marshals(p, p.ir.fns[x.f as usize]) { return true }
    }
    false
}

/// A type as TypeScript sees it crossing the boundary: 64-bit integers are
/// BigInts, the other integers numbers, a String a string, a List[u8] a Uint8Array.
fn ts_ty(p: lower.P, ty: u32) -> str {
    if ty == types.UNIT || ty == types.NEVER { return "void" }
    let c = cross(p, ty)
    if c == 1 { return "string" }
    if c == 2 { return "Uint8Array" }
    let k = types.kind(p.t, ty)
    if k == types.T_BOOL { return "boolean" }
    let ik = types.ik(p.t, ty)
    if k == types.T_INT && (ik == 1 || ik >= 4) { return "bigint" }
    "number"
}

fn param_name(p: lower.P, fd: ir.Fn, i: u32) -> List[u8] { intern.name(p.names, p.ir.locals[(fd.lstart + i) as usize].name) }

/// The name an export has in the module without its `eider_` prefix (llvm.ei's).
fn sym(x: List[u8]) -> List[u8] {
    let mut n: List[u8] = List.new()
    for b in x {
        if bytes.is_ident(b) { n.push(b) } else { n.push(95) }
    }
    n
}

/// <name>.d.ts: the exports' TypeScript declarations.
pub fn dts(p: lower.P) -> List[u8] {
    let mut o = s("// generated by eider\nexport interface EiderExports \x7b\n  readonly memory: WebAssembly.Memory;\n")
    for x in p.ir.exports {
        let fd = p.ir.fns[x.f as usize]
        bytes.append(inout o, s("  "))
        bytes.append(inout o, x.name)
        o.push(40)
        for i in 0..fd.nparams {
            if i > 0 { bytes.append(inout o, s(", ")) }
            bytes.append(inout o, param_name(p, fd, i))
            bytes.append(inout o, s(": "))
            bytes.append(inout o, s(ts_ty(p, param_ty(p, fd, i))))
        }
        bytes.append(inout o, s("): "))
        bytes.append(inout o, s(ts_ty(p, fd.ret)))
        bytes.append(inout o, s(";\n"))
    }
    bytes.append(inout o, s("\x7d\nexport interface EiderImports \x7b [name: string]: (...args: any[]) => any \x7d\nexport function load(wasm: BufferSource | WebAssembly.Module, imports?: EiderImports): Promise<EiderExports>;\n"))
    o
}

/// The JavaScript function for an export that takes or returns a String or List[u8]: it
/// copies each argument into the module (`$str`, `$bytes`), calls `eider_<name>` with
/// (address, length) for each, frees the copies, and copies a result out (`$outStr`, `$outBytes`).
fn marshalled(p: lower.P, fd: ir.Fn, name: List[u8], args: List[u8], o: List[u8]) -> List[u8] {
    let mut r = o.copy()
    let mut call: List[u8] = List.new()
    let mut puts: List[u8] = List.new()
    let mut decl: List[u8] = List.new()
    let mut frees: List[u8] = List.new()
    for i in 0..fd.nparams {
        let pn = param_name(p, fd, i)
        let c = cross(p, param_ty(p, fd, i))
        if i > 0 { put(inout call, ", ") }
        if c == 0 {
            bytes.append(inout call, pn.copy())
        } else {
            let id = bytes.from_u64(i as u64)
            // $a<i> = [address, length]
            if decl.len() > 0 { put(inout decl, ", ") }
            put(inout decl, "$a")
            bytes.append(inout decl, id.copy())
            put(inout decl, " = null")
            put(inout puts, "        $a")
            bytes.append(inout puts, id.copy())
            put(inout puts, pick(c == 1, " = $str(", " = $bytes("))
            bytes.append(inout puts, pn.copy())
            put(inout puts, ", '")
            bytes.append(inout puts, name.copy())
            put(inout puts, "(")
            bytes.append(inout puts, pn.copy())
            put(inout puts, ")');\n")
            put(inout frees, "        if ($a")
            bytes.append(inout frees, id.copy())
            put(inout frees, ") $x.eider_free($a")
            bytes.append(inout frees, id.copy())
            put(inout frees, "[0]);\n")
            put(inout call, "$a")
            bytes.append(inout call, id.copy())
            put(inout call, "[0], $a")
            bytes.append(inout call, id.copy())
            put(inout call, "[1]")
        }
    }
    let rc = cross(p, fd.ret)
    let mut conv: List[u8] = List.new()
    if fd.ret == types.UNIT || fd.ret == types.NEVER {
        put(inout conv, "")
    } else if rc == 1 {
        put(inout conv, "return $outStr($r);")
    } else if rc == 2 {
        put(inout conv, "return $outBytes($r);")
    } else if fd.ret == types.BOOL {
        put(inout conv, "return !!$r;")
    } else {
        put(inout conv, "return $r;")
    }
    let mut callee = s("$x.eider_")
    bytes.append(inout callee, name.copy())
    put(inout callee, "(")
    bytes.append(inout callee, call)
    put(inout callee, ")")
    if decl.len() == 0 {
        // no argument goes through memory: only a result needs converting
        put(inout r, "(")
        bytes.append(inout r, args)
        put(inout r, ") => ")
        if rc == 1 {
            put(inout r, "$outStr(")
            bytes.append(inout r, callee)
            put(inout r, ")")
        } else {
            put(inout r, "$outBytes(")
            bytes.append(inout r, callee)
            put(inout r, ")")
        }
        return r
    }
    put(inout r, "(")
    bytes.append(inout r, args)
    put(inout r, ") => \x7b\n      let ")
    bytes.append(inout r, decl)
    put(inout r, ";\n      try \x7b\n")
    bytes.append(inout r, puts)
    if conv.len() > 0 {
        put(inout r, "        const $r = ")
        bytes.append(inout r, callee)
        put(inout r, ";\n        ")
        bytes.append(inout r, conv)
        put(inout r, "\n")
    } else {
        put(inout r, "        ")
        bytes.append(inout r, callee)
        put(inout r, ";\n")
    }
    put(inout r, "      \x7d finally \x7b\n")
    bytes.append(inout r, frees)
    put(inout r, "      \x7d\n    \x7d")
    r
}

/// <name>.js: instantiates the module `wasm_file` with the host imports (core/wasm/README.md)
/// plus the caller's, and wraps each export (bool results become JavaScript booleans, a
/// String or List[u8] is copied in and out of the module's memory). The result also has the
/// module's `memory`, and an `eider_write` the caller passes is called with it as a third
/// argument: (address, length, memory).
pub fn loader(p: lower.P, wasm_file: List[u8]) -> List[u8] {
    let mut o = s("// generated by eider: loader for ")
    bytes.append(inout o, wasm_file)
    o.push(10)
    ln(inout o, r"export async function load(wasm, imports = {}) {")
    ln(inout o, "  let mem;")
    ln(inout o, "  const dec = new TextDecoder();")
    ln(inout o, r"  const env = {")
    ln(inout o, r"    eider_write(p, n) { (typeof process !== 'undefined' ? process.stdout.write.bind(process.stdout) : console.log)(dec.decode(new Uint8Array(mem.buffer, p, n))); },")
    ln(inout o, r"    eider_now_ms() { return BigInt(Date.now()); },")
    ln(inout o, "    ...imports,")
    ln(inout o, r"  };")
    ln(inout o, "  if (imports.eider_write) env.eider_write = (p, n) => imports.eider_write(p, n, mem);")
    ln(inout o, "  const src = wasm instanceof WebAssembly.Module ? wasm : await WebAssembly.compile(wasm);")
    ln(inout o, r"  const inst = await WebAssembly.instantiate(src, { env });")
    ln(inout o, "  mem = inst.exports.memory;")
    ln(inout o, "  const $x = inst.exports;")
    if any_marshals(p) {
        ln(inout o, "  const enc = new TextEncoder();")
        ln(inout o, r"  const $put = (b) => { const p = $x.eider_alloc(b.length); new Uint8Array(mem.buffer, p, b.length).set(b); return [p, b.length]; };")
        ln(inout o, r"  const $str = (v, what) => {")
        ln(inout o, "    if (typeof v !== 'string') throw new TypeError(what + ' expected a string, got ' + typeof v);")
        ln(inout o, "    if (v.includes('\\0')) throw new TypeError(what + ' expected a string without NUL characters');")
        ln(inout o, "    return $put(enc.encode(v));")
        ln(inout o, r"  };")
        ln(inout o, r"  const $bytes = (v, what) => {")
        ln(inout o, "    if (!(v instanceof Uint8Array)) throw new TypeError(what + ' expected a Uint8Array, got ' + typeof v);")
        ln(inout o, "    return $put(v);")
        ln(inout o, r"  };")
        ln(inout o, r"  const $outStr = (p) => { const s = dec.decode(new Uint8Array(mem.buffer, p, $x.eider_ret_len())); $x.eider_ret_release(); return s; };")
        ln(inout o, r"  const $outBytes = (p) => { const b = new Uint8Array(mem.buffer, p, $x.eider_ret_len()).slice(); $x.eider_ret_release(); return b; };")
    }
    ln(inout o, r"  return {")
    ln(inout o, "    memory: mem,")
    for x in p.ir.exports {
        let fd = p.ir.fns[x.f as usize]
        let mut args: List[u8] = List.new()
        for i in 0..fd.nparams {
            if i > 0 { bytes.append(inout args, s(", ")) }
            bytes.append(inout args, param_name(p, fd, i))
        }
        bytes.append(inout o, s("    "))
        bytes.append(inout o, x.name)
        bytes.append(inout o, s(": "))
        if marshals(p, fd) {
            o = marshalled(p, fd, x.name, args, o)
        } else {
            bytes.append(inout o, s("("))
            bytes.append(inout o, args.copy())
            bytes.append(inout o, s(") => "))
            if fd.ret == types.BOOL { bytes.append(inout o, s("!!")) }
            bytes.append(inout o, s("$x.eider_"))
            bytes.append(inout o, x.name)
            o.push(40)
            bytes.append(inout o, args)
            bytes.append(inout o, s(")"))
        }
        bytes.append(inout o, s(",\n"))
    }
    bytes.append(inout o, s("  \x7d;\n\x7d\n"))
    o
}

/// The C scalar type of an integer, bool or () as the module passes it.
fn c_scalar(p: lower.P, ty: u32) -> str {
    if ty == types.UNIT || ty == types.NEVER { return "void" }
    if types.kind(p.t, ty) == types.T_BOOL { return "bool" }
    let ik = types.ik(p.t, ty)
    if ik == types.IK_I32 { return "int32_t" }
    if ik == types.IK_I64 { return "int64_t" }
    if ik == types.IK_U8 { return "uint8_t" }
    if ik == types.IK_U32 { return "uint32_t" }
    "uint64_t"
}

/// The C type of a value the Eider function (`eider.raw.<name>`) takes or returns.
fn c_raw(p: lower.P, ty: u32) -> str {
    let c = cross(p, ty)
    if c == 1 { return "ei_String" }
    if c == 2 { return "ei_Bytes" }
    c_scalar(p, ty)
}

/// The C source of the wrappers of the exports that take or return a String or List[u8]
/// (empty if there are none; build links core/wasm/marshal.c with it): `eider_<name>` takes
/// each such argument as (address, length), makes a String or List[u8] of it, calls the
/// function (`eider.raw.<name>`, llvm.ei) and drops the copies; a result is returned as an
/// address, its length behind `eider_ret_len` (marshal.c).
pub fn wrappers(p: lower.P) -> List[u8] {
    let mut o: List[u8] = List.new()
    if !any_marshals(p) { return o }
    ln(inout o, "// generated by eider: exports that take or return a String or List[u8]")
    ln(inout o, r#"#include "wasm/marshal.h""#)
    let mut n: u32 = 0
    for x in p.ir.exports {
        let fd = p.ir.fns[x.f as usize]
        if !marshals(p, fd) { continue }
        let id = bytes.from_u64(n as u64)
        let nm = sym(x.name)
        // the function itself
        bytes.append(inout o, s(c_raw(p, fd.ret)))
        put(inout o, " ei_raw")
        bytes.append(inout o, id.copy())
        put(inout o, "(")
        if fd.nparams == 0 { put(inout o, "void") }
        for i in 0..fd.nparams {
            if i > 0 { put(inout o, ", ") }
            put(inout o, c_raw(p, param_ty(p, fd, i)))
        }
        put(inout o, ") __asm__(\"eider.raw.")
        bytes.append(inout o, nm.copy())
        put(inout o, "\");\n")
        // the export
        put(inout o, "__attribute__((export_name(\"eider_")
        bytes.append(inout o, nm.copy())
        put(inout o, "\"))) ")
        let rc = cross(p, fd.ret)
        if rc == 1 {
            put(inout o, "const char *")
        } else if rc == 2 {
            put(inout o, "const uint8_t *")
        } else {
            put(inout o, c_scalar(p, fd.ret))
            put(inout o, " ")
        }
        put(inout o, "ei_w")
        bytes.append(inout o, id.copy())
        put(inout o, "(")
        if fd.nparams == 0 { put(inout o, "void") }
        let mut call: List[u8] = List.new()
        let mut pre: List[u8] = List.new()
        let mut post: List[u8] = List.new()
        for i in 0..fd.nparams {
            let ty = param_ty(p, fd, i)
            let c = cross(p, ty)
            let ai = bytes.from_u64(i as u64)
            if i > 0 {
                put(inout o, ", ")
                put(inout call, ", ")
            }
            if c == 0 {
                put(inout o, c_scalar(p, ty))
                put(inout o, " a")
                bytes.append(inout o, ai.copy())
                put(inout call, "a")
                bytes.append(inout call, ai)
            } else {
                put(inout o, pick(c == 1, "const char *a", "const uint8_t *a"))
                bytes.append(inout o, ai.copy())
                put(inout o, ", uint32_t a")
                bytes.append(inout o, ai.copy())
                put(inout o, "_n")
                put(inout pre, pick(c == 1, "  ei_String s", "  ei_Bytes s"))
                bytes.append(inout pre, ai.copy())
                put(inout pre, pick(c == 1, " = ei_wasm_in_string(a", " = ei_wasm_in_bytes(a"))
                bytes.append(inout pre, ai.copy())
                put(inout pre, ", a")
                bytes.append(inout pre, ai.copy())
                put(inout pre, "_n);\n")
                put(inout post, pick(c == 1, "  ei_drop_String(&s", "  ei_wasm_drop_bytes(&s"))
                bytes.append(inout post, ai.copy())
                put(inout post, ");\n")
                put(inout call, "s")
                bytes.append(inout call, ai)
            }
        }
        put(inout o, ") \x7b\n")
        bytes.append(inout o, pre)
        put(inout o, "  ")
        let unit = fd.ret == types.UNIT || fd.ret == types.NEVER
        if !unit {
            put(inout o, c_raw(p, fd.ret))
            put(inout o, " r = ")
        }
        put(inout o, "ei_raw")
        bytes.append(inout o, id.copy())
        put(inout o, "(")
        bytes.append(inout o, call)
        put(inout o, ");\n")
        bytes.append(inout o, post)
        if rc == 1 {
            ln(inout o, "  return ei_wasm_out_string(r);")
        } else if rc == 2 {
            ln(inout o, "  return ei_wasm_out_bytes(r);")
        } else if !unit {
            ln(inout o, "  return r;")
        }
        ln(inout o, r"}")
        n += 1
    }
    o
}

/// `emit-header --wasm`: both texts, in the recorded form.
pub fn header(p: lower.P) -> List[u8] {
    let mut o = dts(p)
    o.push(1)
    bytes.append(inout o, loader(p, s("@WASM@")))
    o
}

/// The WebAssembly features modules are built with (and seed/wasm2c.c translates): the MVP,
/// sign extension, bulk memory (memory.copy, memory.fill) and mutable globals.
pub fn features() -> List[List[u8]] {
    let mut f: List[List[u8]] = List.new()
    for a in ["--target=wasm32-unknown-unknown", "-mcpu=mvp", "-msign-ext", "-mbulk-memory", "-mmutable-globals"] { f.push(s(a)) }
    f
}

fn wasm_cc() -> List[u8] uses io {
    let mut cc = s("clang")
    match env.get(s("WASM_CC")) {
        Some(x) => { if x.len() > 0 { cc = x } }
        None => {}
    }
    cc
}

/// Build a module at `wasm_file` from the LLVM IR `ll` (llvm.ei) with the WebAssembly core
/// (core/wasm). `core`: a core module
/// (`--wasm-core`; core/wasm/README.md "Core modules"): -DEI_WASM_CORE, 32 MiB of stack
/// placed first (an overflow is an out-of-bounds access, not corrupted data), `_start`.
fn link(ll: List[u8], wrap: List[u8], wasm_file: List[u8], core_mod: bool) uses io, fs, net, clock {
    let dir = driver.temp_dir()
    let core = fs.join(driver.root(), s("core"))
    let llfile = fs.join(dir, s("prog.ll"))
    driver.write_or_fail(llfile, ll)
    let obj = fs.join(dir, s("prog_ll.o"))
    let cc = wasm_cc()
    let mut ca: List[List[u8]] = List.new()
    ca.push(cc.copy())
    for a in features() { ca.push(a) }
    for a in ["-O2", "-c", "-Wno-override-module", "-o"] { ca.push(s(a)) }
    ca.push(obj.copy())
    ca.push(llfile)
    let mut code = match proc.run(ca) {
        Ok(n) => n
        Err(_) => -1
    }
    if code == 0 {
        let mut argv: List[List[u8]] = List.new()
        argv.push(cc)
        for a in features() { argv.push(a) }
        for a in ["-std=c11", "-O2", "-ffreestanding", "-nostdlib", "-fno-builtin", "-w", "-isystem"] { argv.push(s(a)) }
        argv.push(fs.join(core, s("wasm/include")))
        argv.push(s("-I"))
        argv.push(core.copy())
        if core_mod {
            // --strip-all: no name section (it would name the output file) or producers
            for a in ["-DEI_WASM_CORE", "-Wl,--stack-first", "-Wl,-z,stack-size=33554432", "-Wl,--strip-all"] { argv.push(s(a)) }
        }
        for a in ["-Wl,--no-entry", "-Wl,--allow-undefined", "-o"] { argv.push(s(a)) }
        argv.push(wasm_file)
        argv.push(obj)
        argv.push(fs.join(core, s("wasm/eider_rt.c")))
        argv.push(fs.join(core, s("wasm/libc.c")))
        if wrap.len() > 0 {
            // the exports that take or return a String or List[u8] (`wrappers`), with their runtime
            let wfile = fs.join(dir, s("wrappers.c"))
            driver.write_or_fail(wfile, wrap)
            argv.push(wfile)
            argv.push(fs.join(core, s("wasm/marshal.c")))
        }
        code = match proc.run(argv) {
            Ok(n) => n
            Err(_) => -1
        }
    }
    fs.remove_all(dir)
    if code != 0 { driver.fail(s("wasm build failed (needs clang with the wasm32 target and wasm-ld; set WASM_CC to override)"), 3) }
}

/// `eiderc build --wasm` (and `run --wasm`, which builds the same): <name>.wasm, <name>.d.ts and
/// <name>.js, where <name> is `-o`'s path, else the source's stem.
pub fn build(ll: List[u8], p: lower.P, file: List[u8], out: List[u8]) uses io, fs, net, clock {
    let mut base = out.copy()
    if base.len() == 0 { base = driver.stem(file) }
    let mut wasm_file = base.copy()
    bytes.append(inout wasm_file, s(".wasm"))
    link(ll, wrappers(p), wasm_file, false)
    let mut dts_file = base.copy()
    bytes.append(inout dts_file, s(".d.ts"))
    let mut js_file = base.copy()
    bytes.append(inout js_file, s(".js"))
    driver.write_or_fail(dts_file, dts(p))
    let mut name = wasm_file.copy()
    match bytes.rfind_byte(wasm_file, 47) {
        Some(i) => { name = bytes.slice(wasm_file, i + 1, wasm_file.len()) }
        None => {}
    }
    driver.write_or_fail(js_file, loader(p, name))
    let mut m = s("built ")
    bytes.append(inout m, wasm_file)
    bytes.append(inout m, s(", "))
    bytes.append(inout m, dts_file)
    bytes.append(inout m, s(", "))
    bytes.append(inout m, js_file)
    io.outln(m)
}

/// `eiderc build --wasm-core`: the program as a core module at `-o`'s path, else
/// <stem>.wasm (core/wasm/README.md "Core modules"); prints `built <wasm>`.
pub fn build_core(ll: List[u8], file: List[u8], out: List[u8]) uses io, fs, net, clock {
    let mut wasm_file = out.copy()
    if wasm_file.len() == 0 {
        wasm_file = driver.stem(file)
        bytes.append(inout wasm_file, s(".wasm"))
    }
    link(ll, List.new(), wasm_file, true)
    let mut m = s("built ")
    bytes.append(inout m, wasm_file)
    io.outln(m)
}

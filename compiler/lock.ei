// lock: what the compiler reads of a package's eider.toml and of eider.lock, to resolve
// bare imports (docs/compiler.md, "C8.3: packages and modules"). The compiler depends only
// on core and std, so this is its own small reader rather than packages/toml and
// packages/pkg: the same TOML subset (comments, `[a.b]` and `[[a]]` headers, bare, quoted
// and dotted keys, basic strings, integers, booleans, string arrays that may span lines,
// inline tables), flattened to dotted keys as packages/toml does (the n-th `[[a]]` table is
// the prefix `a.<n>`). eider-pkg validates both files when it writes or fetches; here a
// file that doesn't parse is reported, and unknown keys are ignored.

import "core/sys"
import "std/bytes"

/// What the compiler needs of eider.toml: the package name, its entry module (`entry`,
/// default `<name>.ei`), the names of its direct dependencies (`[deps.<name>]`) and, for
/// each, the capabilities it is granted (`uses = [...]`; none when absent;
/// docs/compiler.md, "C8.5: capabilities per package").
pub type Manifest = { name: List[u8], entry: List[u8], deps: List[List[u8]], grants: List[List[List[u8]]] }

/// One `[[package]]` of eider.lock: `path` is the directory of a `path+<dir>` source
/// (relative to the lock's directory unless absolute), `hash` the content hash of a git one.
pub type Locked = { name: List[u8], git: bool, path: List[u8], hash: List[u8] }

/// A package name: lowercase letters, digits and `_`, starting with a letter.
pub fn valid_name(n: List[u8]) -> bool {
    if n.len() == 0 { return false }
    if !(n[0] >= 97 && n[0] <= 122) { return false }
    for c in n {
        if !((c >= 97 && c <= 122) || bytes.is_digit(c) || c == 95) { return false }
    }
    true
}

/// eider.toml text; Err is a message (`line N: ...`).
pub fn manifest(src: List[u8]) -> Result[Manifest, List[u8]] uses ffi {
    let doc = parse(src)?
    let name = text_at(doc, sys.lit("package.name"))
    if name.len() == 0 { return Err(sys.lit("no `name` in [package]")) }
    if !valid_name(name) { return Err(sys.lit("the package name must be lowercase letters, digits and `_`, starting with a letter")) }
    var entry = text_at(doc, sys.lit("package.entry"))
    if entry.len() == 0 { entry = bytes.concat(name, sys.lit(".ei")) }
    let deps = children(doc, sys.lit("deps"))
    var grants: List[List[List[u8]]] = List.new()
    for d in deps {
        var k = sys.lit("deps.")
        bytes.append(inout k, d)
        bytes.append(inout k, sys.lit(".uses"))
        grants.push(items_at(doc, k))
    }
    Ok(Manifest(name, entry, deps, grants))
}

/// eider.lock text: its packages in file order.
pub fn lockfile(src: List[u8]) -> Result[List[Locked], List[u8]] uses ffi {
    let doc = parse(src)?
    var out: List[Locked] = List.new()
    var n: u64 = 0
    while true {
        var pre = sys.lit("package.")
        bytes.append(inout pre, bytes.from_u64(n))
        pre.push(46)
        let name = text_at(doc, bytes.concat(pre, sys.lit("name")))
        if name.len() == 0 { break }
        let source = text_at(doc, bytes.concat(pre, sys.lit("source")))
        let none: List[u8] = List.new()
        if bytes.starts_with(source, sys.lit("path+")) {
            out.push(Locked(name, false, bytes.slice(source, 5, source.len()), none))
        } else if bytes.starts_with(source, sys.lit("git+")) {
            out.push(Locked(name, true, none, text_at(doc, bytes.concat(pre, sys.lit("hash")))))
        } else {
            var m = sys.lit("package `")
            bytes.append(inout m, name)
            bytes.append(inout m, sys.lit("` has no `path+` or `git+` source"))
            return Err(m)
        }
        n += 1
    }
    Ok(out)
}

/// The store directory name of a git package (eider-pkg's store.ei `store_dir`):
/// `<name>-<the first 16 hex digits of its content hash>`.
pub fn store_leaf(name: List[u8], hash: List[u8]) -> List[u8] uses ffi {
    var leaf = name
    leaf.push(45)
    // "sha256-" is 7 bytes
    if hash.len() >= 23 { bytes.append(inout leaf, bytes.slice(hash, 7, 23)) }
    leaf
}

// ---- the TOML subset (packages/toml, flattened)

pub type Entry = { key: List[u8], val: List[u8], items: List[List[u8]] }

type P = { src: List[u8], i: usize, line: u32 }

type Count = { name: List[u8], n: u64 }

fn fail(p: P, m: str) -> List[u8] uses ffi {
    var out = sys.lit("line ")
    bytes.append(inout out, bytes.from_u64(p.line as u64))
    bytes.append(inout out, sys.lit(": "))
    bytes.append(inout out, sys.lit(m))
    out
}

fn peek(p: P) -> u8 {
    if p.i < p.src.len() { return p.src[p.i] }
    0
}

fn at_end(p: P) -> bool { p.i >= p.src.len() }

fn bump(inout p: P) {
    if p.i < p.src.len() {
        if p.src[p.i] == 10 { p.line += 1 }
        p.i += 1
    }
}

fn blank(inout p: P) {
    while peek(p) == 32 || peek(p) == 9 { bump(inout p) }
}

/// Blanks, newlines and comments.
fn space(inout p: P) {
    while !at_end(p) {
        let c = peek(p)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            bump(inout p)
        } else if c == 35 {
            while !at_end(p) && peek(p) != 10 { bump(inout p) }
        } else {
            return
        }
    }
}

fn end_line(inout p: P) -> Result[bool, List[u8]] uses ffi {
    blank(inout p)
    if peek(p) == 35 {
        while !at_end(p) && peek(p) != 10 { bump(inout p) }
    }
    if peek(p) == 13 { bump(inout p) }
    if at_end(p) { return Ok(true) }
    if peek(p) != 10 { return Err(fail(p, "expected the end of the line")) }
    bump(inout p)
    Ok(true)
}

fn string(inout p: P) -> Result[List[u8], List[u8]] uses ffi {
    bump(inout p)
    var out: List[u8] = List.new()
    while true {
        if at_end(p) || peek(p) == 10 { return Err(fail(p, "unterminated string")) }
        let c = peek(p)
        bump(inout p)
        if c == 34 { return Ok(out) }
        if c == 92 {
            let e = peek(p)
            bump(inout p)
            if e == 110 {
                out.push(10)
            } else if e == 116 {
                out.push(9)
            } else if e == 114 {
                out.push(13)
            } else if e == 34 || e == 92 {
                out.push(e)
            } else {
                return Err(fail(p, "unsupported escape"))
            }
        } else {
            out.push(c)
        }
    }
    Ok(out)
}

fn key_part(inout p: P) -> Result[List[u8], List[u8]] uses ffi {
    if peek(p) == 34 { return string(inout p) }
    var out: List[u8] = List.new()
    while bytes.is_ident(peek(p)) || peek(p) == 45 {
        out.push(peek(p))
        bump(inout p)
    }
    if out.len() == 0 { return Err(fail(p, "expected a key")) }
    Ok(out)
}

fn key(inout p: P) -> Result[List[u8], List[u8]] uses ffi {
    var k = key_part(inout p)?
    blank(inout p)
    while peek(p) == 46 {
        bump(inout p)
        blank(inout p)
        let part = key_part(inout p)?
        k.push(46)
        bytes.append(inout k, part)
        blank(inout p)
    }
    Ok(k)
}

fn join_key(prefix: List[u8], k: List[u8]) -> List[u8] {
    if prefix.len() == 0 { return k }
    var out = prefix
    out.push(46)
    bytes.append(inout out, k)
    out
}

/// A value for key `k`: strings and string arrays are kept, integers and booleans skipped,
/// inline tables flattened.
fn value(inout p: P, k: List[u8], inout out: List[Entry]) -> Result[bool, List[u8]] uses ffi {
    let none: List[List[u8]] = List.new()
    let c = peek(p)
    if c == 34 {
        let s = string(inout p)?
        out.push(Entry(k, s, none))
        return Ok(true)
    }
    if c == 91 {
        bump(inout p)
        var items: List[List[u8]] = List.new()
        while true {
            space(inout p)
            if peek(p) == 93 {
                bump(inout p)
                out.push(Entry(k, List.new(), items))
                return Ok(true)
            }
            if peek(p) != 34 { return Err(fail(p, "arrays may only hold strings")) }
            let s = string(inout p)?
            items.push(s)
            space(inout p)
            if peek(p) == 44 {
                bump(inout p)
            } else if peek(p) != 93 {
                return Err(fail(p, "expected `,` or `]`"))
            }
        }
    }
    if c == 123 {
        bump(inout p)
        while true {
            blank(inout p)
            if peek(p) == 125 {
                bump(inout p)
                return Ok(true)
            }
            let sub = key(inout p)?
            if peek(p) != 61 { return Err(fail(p, "expected `=`")) }
            bump(inout p)
            blank(inout p)
            value(inout p, join_key(k, sub), inout out)?
            blank(inout p)
            if peek(p) == 44 { bump(inout p) } else if peek(p) != 125 { return Err(fail(p, "expected `,` or `}`")) }
        }
    }
    // an integer or a boolean
    var any = false
    while bytes.is_ident(peek(p)) || peek(p) == 45 || peek(p) == 43 {
        any = true
        bump(inout p)
    }
    if !any { return Err(fail(p, "expected a value")) }
    Ok(true)
}

fn next_index(inout counts: List[Count], name: List[u8]) -> u64 {
    for i in 0..counts.len() {
        if bytes.eq(counts[i].name, name) {
            let n = counts[i].n
            counts[i] = Count(name, n + 1)
            return n
        }
    }
    counts.push(Count(name, 1))
    0
}

/// The document flattened to dotted keys.
pub fn parse(src: List[u8]) -> Result[List[Entry], List[u8]] uses ffi {
    var p = P(src, 0, 1)
    var out: List[Entry] = List.new()
    var prefix: List[u8] = List.new()
    var counts: List[Count] = List.new()
    while true {
        space(inout p)
        if at_end(p) { return Ok(out) }
        if peek(p) == 91 {
            bump(inout p)
            let is_array = peek(p) == 91
            if is_array { bump(inout p) }
            blank(inout p)
            let name = key(inout p)?
            if peek(p) != 93 { return Err(fail(p, "expected `]`")) }
            bump(inout p)
            if is_array {
                if peek(p) != 93 { return Err(fail(p, "expected `]]`")) }
                bump(inout p)
                let n = next_index(inout counts, name)
                prefix = join_key(name, bytes.from_u64(n))
            } else {
                prefix = name
                // `[deps.json]` with no keys still declares `json`
                out.push(Entry(name, List.new(), List.new()))
            }
            end_line(inout p)?
        } else {
            let k = key(inout p)?
            if peek(p) != 61 { return Err(fail(p, "expected `=` after the key")) }
            bump(inout p)
            blank(inout p)
            value(inout p, join_key(prefix, k), inout out)?
            end_line(inout p)?
        }
    }
    Ok(out)
}

/// The string at key `k` ("" when absent).
pub fn text_at(doc: List[Entry], k: List[u8]) -> List[u8] {
    for e in doc {
        if bytes.eq(e.key, k) { return e.val }
    }
    List.new()
}

/// The strings of the array at key `k` (none when absent).
pub fn items_at(doc: List[Entry], k: List[u8]) -> List[List[u8]] {
    for e in doc {
        if bytes.eq(e.key, k) { return e.items }
    }
    List.new()
}

/// Distinct next segments of keys under `prefix.` (dependency names under `deps`).
pub fn children(doc: List[Entry], prefix: List[u8]) -> List[List[u8]] {
    var want = prefix
    want.push(46)
    var out: List[List[u8]] = List.new()
    for e in doc {
        if bytes.starts_with(e.key, want) {
            let rest = bytes.slice(e.key, want.len(), e.key.len())
            let seg = match bytes.find_byte(rest, 46, 0) {
                Some(i) => bytes.slice(rest, 0, i)
                None => rest
            }
            var seen = false
            for o in out {
                if bytes.eq(o, seg) { seen = true }
            }
            if !seen && seg.len() > 0 { out.push(seg) }
        }
    }
    out
}

// check: type checking, producing the typed IR. The checker runs its passes in a fixed
// order and emits no C itself (lowering does). The order is part of the contract: it
// decides which error is reported first, which must be the one tests/oracle records for the
// input (code, position, message, help, fix), and the order of the errors found after it
// (see "Recovery").
//
// Pass order: type templates (E0107), non-generic types (field types,
// E0108), traits, function names, impls, constants in order, the signatures of every
// concrete function and then of every concrete method, test bodies, then function bodies
// from a stack: every instance created is pushed (concrete functions first,
// generic instances when a call needs them) and the most recent one is checked first. Errors in
// imported modules name their file as the recorded expectations do: explicitly for types and
// signatures, otherwise through `err_mod`, the module of the item being checked (left stale
// while tests are checked, kept for compatibility with tests/oracle).
//
// Generics are monomorphized on demand: a generic type gets one definition per instance
// (types.ei), a generic function or method one IR function per instance, checked with its
// type parameters substituted (`tsubst`). Type arguments are inferred in a fixed order
// (unify_ast: from the expected type, the receiver, then argument by argument).
//
// Ownership: reading owned data out of a place borrows it; storing a borrowed
// value clones it (`take`); a fresh owned value (call result, constructor, ...) lives in a
// temporary registered in the innermost frame (one per block) until it is moved out; every
// frame's owned values are dropped when it ends or is left by return/break/continue/`?`.
// The IR spells all of it out (ir.ei, "Ownership"). A `let` or pattern binding of a place is a
// reference: no storage, no copy, no drop; the place itself stands for it ("References").
//
// Closures are IR functions of their own, built while their enclosing function
// is (ir.begin_nested), with a snapshot of the locals they mention as their environment.
//
// FFI: `extern "c"` declarations are functions without a body whose signatures
// must be C-safe (E0803); calling one needs the `ffi` capability (E0201) and an `unsafe`
// block or `unsafe fn` (E0802), like calling an `unsafe fn`; a callee's `ffi` is not asked of
// callers in another package (`needs_cap`; grants: resolve.ei). `export fn`s (E0805: not
// generic) take C-safe parameters, records of them included; a library (`lib`) needs at
// least one and no `main`. Both are recorded in the IR (ir.ei, Externs and Exports).
// Checking for WebAssembly (`wasm`, check_wasm) is checking a library whose exports take and
// return only integers and bool, with no thread types anywhere (E0806).
//
// Threads (Task/Mutex/Chan, spawn): `spawn` needs the `threads`
// capability; Task, Mutex and Chan are shared handles (copying one shares it), checked in
// `thread_static` / `thread_method` and recorded as builtins (ir.ei, B_SPAWN ...). Values
// moved into a spawned closure, a Mutex or a channel are owned by it from then on.
//
// Features still outside eiderc (`?` in an
// expression-bodied closure, and `extern`/`unsafe` functions used as values, which would
// otherwise pass without `unsafe` or `ffi`; LEARNINGS.md) stop checking with an `unsupported`
// diagnostic at the point where handling them would start, so everything reported
// before is exact.

import "core/sys"
import "std/bytes"
import "intern.ei"
import "lex.ei"
import "ast.ei"
import "diag.ei"
import "resolve.ei"
import "types.ei"
import "fold.ei"
import "pats.ei"
import "ir.ei"

const NONE: u32 = 4294967295

/// A function or method declaration. `generic`: it has its own type parameters. `ir`: the
/// IR function of a concrete free function (declared in order with the functions); `inode`
/// the impl a method belongs to (NONE for free functions).
type FnDef = {
    key: u64, md: u32, node: u32, public: bool, generic: bool, unsafe_fn: bool, ir: u32, inode: u32,
}

/// An instance of a function: its type substitution [sstart, slen) in `sub_s`/`sub_t`, its
/// IR function, and its signature: parameter types in `ptys` [pstart, plen), capability
/// symbols in `capl` [cstart, clen).
type Inst = {
    fd: u32, sstart: u32, slen: u32, ir: u32, ret: u32, pstart: u32, plen: u32, cstart: u32, clen: u32,
}

/// A substitution of type parameters (symbols; `Self` is intern.S_SELF_TYPE) by types.
type Subst = { syms: List[u32], tys: List[u32] }

/// A method registered by an impl: its head (see head_key), name, declaration, and the
/// impl's target as show_ast spells it (for duplicate checks).
type Meth = { head: u64, name: u32, fd: u32, target: List[u8] }

/// An impl of a trait: the trait, the impl (module, node) and its target's spelling.
type TImpl = { tkey: u64, md: u32, node: u32, target: List[u8] }

/// A constant: its type and folded value (`op` is its IR operand).
type ConstDef = { key: u64, md: u32, public: bool, ty: u32, has_k: bool, k: fold.Wide, op: u32, node: u32 }

/// A local variable in scope. `key` is its name key (pattern bindings can carry a module
/// prefix, see resolve.ei); (line, col) is where it is declared (E0305) and (dline, dcol)
/// the `let`/`var` it comes from, for the E0303 fix. (aline, acol) is the declaration the
/// IDE recording names (a closure's captured copy keeps its original's). A reference (C8.6:
/// a `let` or pattern binding of a place, or a `let mut` / `mut` one) has no storage of its
/// own: `alias` is the place it names (else NONE), `refid` its RefInfo and `aroot` the key of
/// the variable that place is rooted at (inout exclusivity, E0301).
type Local = {
    key: u64, ty: u32, mutable: bool, byref: bool, has_decl: bool, line: u32, col: u32,
    ir: u32, dline: u32, dcol: u32, aline: u32, acol: u32, alias: u32, refid: u32, aroot: u64,
}

/// A checked expression: its type, the IR operand holding its value, and its value when it
/// is a compile-time integer (`has_k`).
type V = { ty: u32, op: u32, has_k: bool, k: fold.Wide }

/// A checked place expression (variable, field, element): the IR place, its type, and the
/// operand when the "place" is really a fresh value (`op`, else NONE).
type PV = { place: u32, ty: u32, op: u32 }

/// Where a value form (`if`, `match`, block) delivers its result.
const D_DISCARD: u32 = 0
const D_RETURN: u32 = 1
const D_VAR: u32 = 2
type Dest = { kind: u32, local: u32 }

/// A pattern test, emitted when the arm's condition is built: T_TAG (place is variant a),
/// T_INT (place == value), T_BOOL (place is a=1/0), T_STR (place == string bytes).
const T_TAG: u32 = 0
const T_INT: u32 = 1
const T_BOOL: u32 = 2
const T_STR: u32 = 3
type Test = { kind: u32, place: u32, ty: u32, a: u32, w: fold.Wide, s: List[u8] }
type Bind = { key: u64, place: u32, ty: u32, line: u32, col: u32, mutable: bool }
type Lowered = { tests: List[Test], binds: List[Bind] }

/// An owned value in a frame (`l` = NONE once it moved out).
type Owned = { l: u32, ty: u32 }

/// Heads of methods that aren't named types (head_key).
const H_ARRAY: u64 = 18446744073709551615
const H_UNIT: u64 = 18446744073709551614
const H_NEVER: u64 = 18446744073709551613
const H_FN: u64 = 18446744073709551612

/// The List type `keys()` (mi = M_KEYS), `values()` or `entries()` of Map type mt returns.
fn map_list_type(inout c: C, mt: u32, mi: u32) -> u32 {
    let t = types.get(c.t, mt)
    if mi == M_KEYS { return types.list_of(inout c.t, t.a) }
    if mi == M_VALUES { return types.list_of(inout c.t, t.b) }
    let mut es: List[u32] = List.new()
    es.push(t.a)
    es.push(t.b)
    let tt = types.tuple(inout c.t, es)
    types.list_of(inout c.t, tt)
}

/// Built-in method and associated function names (indexes into W.hm).
const M_LEN: u32 = 0
const M_IS_EMPTY: u32 = 1
const M_PUSH_STR: u32 = 2
const M_APPEND: u32 = 3
const M_PUSH: u32 = 4
const M_POP: u32 = 5
const M_CLEAR: u32 = 6
const M_GET: u32 = 7
const M_CONTAINS: u32 = 8
const M_INSERT: u32 = 9
const M_REMOVE: u32 = 10
const M_MAP: u32 = 11
const M_FILTER: u32 = 12
const M_FOR_EACH: u32 = 13
const M_ANY: u32 = 14
const M_ALL: u32 = 15
const M_FOLD: u32 = 16
const M_SUM: u32 = 17
const M_SET: u32 = 18
const M_FROM: u32 = 19
const M_FROM_INT: u32 = 20
const M_NEW: u32 = 21
const M_BYTE: u32 = 22
const M_SLICE: u32 = 23
const M_BYTES: u32 = 24
const M_PUSH_BYTE: u32 = 25
const M_FROM_BYTES: u32 = 26
const M_KEYS: u32 = 27
const M_VALUES: u32 = 28
const M_ENTRIES: u32 = 29

/// Well-known symbols.
type W = {
    ints: List[u32], s_bool: u32, s_str: u32, s_self: u32, s_string: u32, heap: List[u32],
    print: u32, len: u32, now_ms: u32, panic: u32, spawn: u32, main: u32,
    option: u32, result: u32, caps: List[u32], io: u32, clock: u32, threads: u32,
    list: u32, map: u32, boxs: u32, some: u32, none: u32, ok: u32, errv: u32, hm: List[u32],
}

pub type C = {
    p: resolve.Program,
    t: types.Types,
    ir: ir.Ir,
    pt: pats.Pats,
    w: W,
    tmpl: Map[u64, u32],
    variants: Map[u64, u32],
    fns: Map[u64, u32],
    consts: Map[u64, u32],
    traits: Map[u64, u32],
    trs: List[Item],
    timpls: List[TImpl],
    meths: List[Meth],
    fdefs: List[FnDef],
    insts: List[Inst],
    inst_ix: Map[u64, u32],
    cdefs: List[ConstDef],
    ptys: List[u32],
    capl: List[u32],
    sub_s: List[u32],
    sub_t: List[u32],
    pending: List[u32],
    // the body being checked
    tsubst: Subst,
    scopes: List[Local],
    marks: List[u32],
    frames: List[Owned],
    fmarks: List[u32],
    firs: List[u32],
    fresh: Map[u32, bool],
    loop_bases: List[u32],
    am: u32,
    locals: Map[u32, bool],
    cur_all: bool,
    cur_mod: u32,
    err_mod: u32,
    ret: u32,
    caps: List[u32],
    sig_line: u32,
    sig_col: u32,
    loops: u32,
    unsafe_depth: u32,
    /// parameter/return hints for the closure about to be checked
    lam: LamHint,
    closures: u32,
    /// checking an expression-bodied closure, whose `?` would be checked against the
    /// enclosing function's return type (LEARNINGS.md); eiderc leaves it out
    lam_expr: bool,
    /// checking a library (`build --lib`, `emit-header`): no `main`, at least one export
    lib: bool,
    exports: u32,
    /// checking for WebAssembly (`--wasm`, implies `lib`): exports take and return only
    /// integers and bool, and threads are rejected (E0806)
    wasm: bool,
    /// the IDE recording (see "IDE recording" below); off unless check_ide
    rec: Rec,
    /// every diagnostic recorded so far, in discovery order (see "Recovery" below)
    diags: List[diag.Diag],
    /// the "unknown ..." and missing-capability diagnostics recorded for the body or item
    /// being checked (reported once each)
    seen: List[List[u8]],
    /// drop what is recorded (a further instance of a generic body that had errors)
    mute: bool,
    /// declarations (FnDef index) whose body had errors in some instance
    bad_fd: Map[u32, bool],
    /// a pattern of the `match`/`let` being lowered met the error type
    pat_bad: bool,
    /// the parser skipped a statement of the body being checked (SError): its names are
    /// unknown, so an unknown name in the body may be a consequence
    body_err: bool,
    /// modules with an item the parser skipped before its name (IError without a name):
    /// any unknown name in them may be a consequence
    mod_err: Map[u32, bool],
    /// the names (as messages spell them) of the items the parser skipped after their name
    failed: List[List[u8]],
    /// the operation traits ("Operation traits" below)
    lt: Lang,
    /// references and the protection rule ("References" below)
    rf: Refs,
    /// type aliases ("Type aliases" below)
    al: Aliases,
    /// impls of the prelude's `From` ("Error conversion" below)
    froms: List[FromImpl],
}

/// `impl From[Source] for Target` (module md, IImpl node) and its `from` method (FnDef fd).
type FromImpl = { md: u32, node: u32, fd: u32, target: List[u8], source: List[u8] }

/// Type aliases (docs/compiler.md, "C8.18"): name key -> index into `defs` (the alias's
/// module and IType node); `stack` holds the aliases being resolved (a cycle is E0111).
type Aliases = { keys: Map[u64, u32], defs: List[Item], stack: List[u32] }

/// Expected parameter types (NONE: unknown) and return type of a closure.
type LamHint = { has: bool, params: List[u32], ret: u32 }

fn no_hint() -> LamHint { LamHint(false, List.new(), NONE) }

// ---- IDE recording (ide.ei)
//
// With `c.rec.on` (check_ide only) the checker notes what it resolves, where it resolves
// it: every use of a name with the declaration it resolves to, and the types of bindings
// and of name-like expressions (identifiers, fields, calls, method calls). Positions are
// those of AST nodes: a use is the node's (line, col) in module `m` (`qual`: the node is
// `alias.Name` and starts at the alias); a declaration is the (line, col) of the node that
// declares it in module `tm` (an item's name, a parameter, a `let`/`var`/`for` statement, a
// pattern name, a field). Nothing else in the checker reads the recording, and when it is
// off every note is a test of one bool, so `check`, `build` and the IR are unchanged.

/// A use of a name at (line, col) of module m that resolves to the declaration at
/// (tline, tcol) of module tm.
pub type RecRef = { m: u32, line: u32, col: u32, qual: bool, tm: u32, tline: u32, tcol: u32 }

/// The type `ty` of the expression node at (line, col) of module m, or (`binding`) of the
/// binding declared there.
pub type RecTy = { m: u32, line: u32, col: u32, qual: bool, binding: bool, ty: u32 }

pub type Rec = { on: bool, refs: List[RecRef], tys: List[RecTy] }

/// Whether use node n starts at an import alias (`alias.Name`).
fn is_qual(n: ast.Node) -> bool {
    let k = n.kind
    n.b > 0 && (k == ast.EIdent || k == ast.ECall || k == ast.TName || k == ast.TGeneric || k == ast.PName || k == ast.PVariant)
}

fn note_ref(inout c: C, m: u32, n: ast.Node, tm: u32, tline: u32, tcol: u32) {
    if c.rec.on { c.rec.refs.push(RecRef(m, n.line, n.col, is_qual(n), tm, tline, tcol)) }
}

/// A use of the type (template) di.
fn note_def(inout c: C, m: u32, n: ast.Node, di: u32) {
    if !c.rec.on { return }
    let d = c.t.defs[di as usize].copy()
    let tn = ndm(c, d.md, d.node)
    note_ref(inout c, m, n, d.md, tn.line, tn.col)
}

/// A use of variant `vkey` of enum di.
fn note_variant(inout c: C, n: ast.Node, di: u32, vkey: u64) {
    if !c.rec.on { return }
    let d = c.t.defs[di as usize].copy()
    let tn = ndm(c, d.md, d.node)
    for i in 0..tn.f {
        let vn = ndm(c, d.md, atm(c, d.md, tn.e, i))
        if resolve.item_key(c.p, d.md, vn.a) == vkey {
            let am = c.am.copy()
            note_ref(inout c, am, n, d.md, vn.line, vn.col)
            return
        }
    }
}

fn note_fn(inout c: C, n: ast.Node, fi: u32) {
    if !c.rec.on { return }
    let f = c.fdefs[fi as usize].copy()
    let fnode = ndm(c, f.md, f.node)
    let am = c.am.copy()
    note_ref(inout c, am, n, f.md, fnode.line, fnode.col)
}

fn note_local(inout c: C, n: ast.Node, v: Local) {
    let am = c.am.copy()
    if c.rec.on { note_ref(inout c, am, n, am, v.aline, v.acol) }
}

/// A use of field i of record d.
fn note_field(inout c: C, n: ast.Node, d: types.Def, i: u32) {
    if !c.rec.on { return }
    let f = types.field(c.t, d.start, i)
    let am = c.am.copy()
    note_ref(inout c, am, n, d.md, f.line, f.col)
}

fn note_ty(inout c: C, n: ast.Node, ty: u32) {
    if c.rec.on && !poisoned(c, ty) { c.rec.tys.push(RecTy(c.am, n.line, n.col, is_qual(n), false, ty)) }
}

// ---- messages

fn s(x: str) -> List[u8] { sys.lit(x) }

fn q(pre: str, x: List[u8], post: str) -> List[u8] {
    let mut m = sys.lit(pre)
    bytes.append(inout m, x)
    bytes.append(inout m, sys.lit(post))
    m
}

fn q2(pre: str, x: List[u8], mid: str, y: List[u8], post: str) -> List[u8] {
    let mut m = q(pre, x, mid)
    bytes.append(inout m, y)
    bytes.append(inout m, sys.lit(post))
    m
}

fn q3(pre: str, x: List[u8], m1: str, y: List[u8], m2: str, z: List[u8], post: str) -> List[u8] {
    let mut m = q2(pre, x, m1, y, m2)
    bytes.append(inout m, z)
    bytes.append(inout m, sys.lit(post))
    m
}

fn num(n: u64) -> List[u8] { bytes.from_u64(n) }

fn err(code: str, line: u32, col: u32, msg: List[u8]) -> diag.Diag { diag.new(code, line, col, msg) }

fn errh(code: str, line: u32, col: u32, msg: List[u8], help: str) -> diag.Diag {
    let mut d = diag.new(code, line, col, msg)
    d.help = sys.lit(help)
    d
}

fn unsup(line: u32, col: u32, what: str) -> diag.Diag {
    diag.new("unsupported", line, col, q("not yet supported by eiderc: ", sys.lit(what), ""))
}

fn ts(c: C, ty: u32) -> List[u8] { types.show(c.t, c.p.names, ty) }
fn kt(c: C, k: u64) -> List[u8] { resolve.key_text(c.p.names, k) }
fn nm(c: C, sym: u32) -> List[u8] { intern.name(c.p.names, sym) }

fn mismatch(c: C, line: u32, col: u32, expected: u32, found: u32) -> diag.Diag {
    let mut d = err("E0401", line, col, q2("expected ", ts(c, expected), ", found ", ts(c, found), ""))
    if types.is_int(c.t, expected) && types.is_int(c.t, found) {
        d.help = q("there are no implicit conversions; use an explicit cast: `value as ", ts(c, expected), "`")
    }
    d
}

/// Name the file of module m on `d` unless it already names one (the innermost file wins;
/// the prelude has no file).
fn in_file(c: C, d: diag.Diag, m: u32) -> diag.Diag {
    let mut d2 = d.copy()
    if d2.file.len() == 0 && m != resolve.NOMOD && m != c.p.prelude { d2.file = c.p.mods[m as usize].path }
    d2
}

// ---- Recovery
//
// The checker reports every independent error, not only the first. An error is still an
// `Err` that travels up from where it is found, but it stops at the nearest recovery point
// instead of ending the run: there it is recorded (`record`: the file named as the run's
// end would name it, so the first diagnostic of every program is exactly the one a
// first-error checker reports) and checking resumes after the failed part with the state
// it had before it (`snap`/`restore`). Recovery points: every expression (`expr`, which
// then stands for a value of the error type), every statement of a block (a failed `let`
// still binds its names, to the error type), every function and test body, every item
// of each pass in `run`, each field of a type and each part of a signature. A few errors
// are recorded where they are found and checking goes on as if they weren't there (a
// missing capability, `unsafe`, assigning to something immutable, a private item, an
// unknown or misapplied function whose arguments are then still checked).
//
// No cascades. The error type (types.poison) is compatible with every type (`same`);
// operations on it give it again without a diagnostic, and a diagnostic that would still
// mention it (`{error}`) is a consequence of an earlier one and is dropped, as are the
// `cascade` diagnostics produced where only such a consequence is known. An "unknown ..."
// name or a missing capability is reported once per body (`seen`); a name qualified by a
// module that failed to load is never reported (resolve.Program.broken); a generic body is
// reported for its first instance with errors only (`mute`). `unsupported` still ends
// checking (`fatal`): it is reported only if nothing else was.

/// Checker state that recovery puts back: the lengths of its stacks and the scalars a
/// failed part may have changed.
type Snap = {
    scopes: usize, marks: usize, frames: usize, fmarks: usize, firs: usize, loop_bases: usize,
    pending: usize, outer: usize, loops: u32, unsafe_depth: u32, ret: u32, lam_expr: bool,
}

fn snap(c: C) -> Snap {
    Snap(c.scopes.len(), c.marks.len(), c.frames.len(), c.fmarks.len(), c.firs.len(), c.loop_bases.len(),
        c.ir.pending.len(), c.ir.outer.len(), c.loops, c.unsafe_depth, c.ret, c.lam_expr)
}

fn restore(inout c: C, sp: Snap) {
    while c.scopes.len() > sp.scopes { c.scopes.pop() }
    while c.marks.len() > sp.marks { c.marks.pop() }
    while c.frames.len() > sp.frames { c.frames.pop() }
    while c.fmarks.len() > sp.fmarks { c.fmarks.pop() }
    while c.firs.len() > sp.firs { c.firs.pop() }
    while c.loop_bases.len() > sp.loop_bases { c.loop_bases.pop() }
    while c.ir.pending.len() > sp.pending { c.ir.pending.pop() }
    while c.ir.outer.len() > sp.outer { ir.end_nested(inout c.ir, 0, 0) }
    c.loops = sp.loops
    c.unsafe_depth = sp.unsafe_depth
    c.ret = sp.ret
    c.lam_expr = sp.lam_expr
    c.lam = no_hint()
}

fn is_code(d: diag.Diag, code: str) -> bool { bytes.eq(sys.lit(d.code), sys.lit(code)) }

/// A diagnostic that ends checking even with recovery.
fn fatal(d: diag.Diag) -> bool { is_code(d, "unsupported") }

/// An error that is only a consequence of an earlier one (never reported).
fn quiet() -> diag.Diag { diag.new("cascade", 0, 0, List.new()) }

/// The error type.
fn poison(inout c: C) -> u32 { types.poison(inout c.t) }

/// A value of the error type.
fn poison_v(inout c: C) -> V {
    let t = poison(inout c)
    v_of(t, ir.op_int(inout c.ir, t, 0))
}

/// Whether ty is (or is built from) the error type.
fn poisoned(c: C, ty: u32) -> bool { ty != NONE && types.has_poison(c.t, ty) }

/// Type equality where the error type matches anything.
fn same(c: C, a: u32, b: u32) -> bool { a == b || poisoned(c, a) || poisoned(c, b) }

fn contains_text(hay: List[u8], needle: List[u8]) -> bool {
    match bytes.find(hay, needle, 0) {
        Some(_) => true
        None => false
    }
}

/// Whether d is a consequence of an earlier error: it mentions the error type, or a name of
/// a module that failed to load.
fn consequence(c: C, d: diag.Diag) -> bool {
    if is_code(d, "cascade") { return true }
    let et = s("{error}")
    if contains_text(d.msg, et) || contains_text(d.help, et) { return true }
    for pre in c.p.broken {
        let mut t = s("`")
        bytes.append(inout t, nm(c, pre - 1))
        bytes.append(inout t, s("__"))
        if contains_text(d.msg, t) { return true }
    }
    false
}

/// Whether d may be explained by a syntax error: it is on the line of one, or it is an
/// unknown name and the parser skipped a statement of the body (`body_err`), an item of the
/// module before its name, or the item of that name (ast.ei, SError and IError).
fn syntax_consequence(c: C, d: diag.Diag) -> bool {
    // anything on the line of a syntax error may come from how the parser recovered there
    if c.err_mod != resolve.NOMOD && d.file.len() == 0 && resolve.syntax_in(c.p, c.err_mod, d.line, d.line) { return true }
    let unknown = bytes.starts_with(d.msg, s("unknown name `")) || bytes.starts_with(d.msg, s("unknown function `")) || bytes.starts_with(d.msg, s("unknown type `")) || bytes.starts_with(d.msg, s("unknown trait `"))
    if !unknown { return false }
    if c.body_err || c.mod_err.contains(c.err_mod) { return true }
    for f in c.failed {
        let mut t = s("`")
        bytes.append(inout t, f)
        t.push(96)
        if contains_text(d.msg, t) { return true }
    }
    false
}

/// Note the items the parser skipped (IError: a = keyword sym+1, b = name sym+1 or 0).
fn note_failed_items(inout c: C) {
    for it in items(c.p) {
        let n = ndm(c, it.m, it.node)
        if n.kind != ast.IError { continue }
        if n.b == 0 {
            c.mod_err.insert(it.m, true)
        } else {
            let sym = n.b - 1
            c.failed.push(nm(c, sym))
            c.failed.push(kt(c, resolve.item_key(c.p, it.m, sym)))
        }
    }
}

/// Whether the parser skipped an item of the entry file (it may have been `main` or the
/// export a library needs).
fn entry_skipped(c: C) -> bool {
    let a = c.p.mods[0].ast
    for k in 0..a.items_len {
        if a.nodes[ast.at(a, a.items_start, k) as usize].kind == ast.IError { return true }
    }
    false
}

/// What makes d one of the diagnostics reported once per body: the message of an unknown
/// name, and the fix of a missing capability (one per capability). Empty for the others.
fn once_key(d: diag.Diag) -> List[u8] {
    if bytes.starts_with(d.msg, s("unknown ")) {
        let mut k = sys.lit(d.code)
        bytes.append(inout k, d.msg)
        return k
    }
    // a missing capability, or a missing bound (one per fix)
    if is_code(d, "E0201") || is_code(d, "E0605") {
        match d.fix {
            Some(f) => {
                let mut k = sys.lit(d.code)
                k.push(32)
                bytes.append(inout k, num(f.line as u64))
                k.push(58)
                bytes.append(inout k, num(f.col as u64))
                bytes.append(inout k, f.insert)
                return k
            }
            None => {}
        }
    }
    List.new()
}

/// Record diagnostic d (naming the file of the module being checked, as the end of the
/// run does) unless it is a consequence or a repetition.
fn record(inout c: C, d: diag.Diag) {
    if c.mute || consequence(c, d) || syntax_consequence(c, d) { return }
    let k = once_key(d)
    if k.len() > 0 {
        for x in c.seen {
            if bytes.eq(x, k) { return }
        }
        c.seen.push(k)
    }
    let d2 = in_file(c, d, c.err_mod)
    c.diags.push(d2)
}

/// Record the error of `r` (a fatal one is returned); Ok(true) when there was none.
fn recover(inout c: C, r: Result[bool, diag.Diag]) -> Result[bool, diag.Diag] {
    match r {
        Ok(_) => Ok(true)
        Err(d) => {
            if fatal(d) { return Err(d) }
            record(inout c, d)
            Ok(false)
        }
    }
}

/// Record d, then check the arguments [start/len) of a call that can't go on (each against
/// the error type, so nothing is inferred from them); the call's value is of the error type.
fn fail_call(inout c: C, d: diag.Diag, start: u32, len: u32) -> Result[V, diag.Diag] {
    record(inout c, d)
    let pt = poison(inout c)
    for i in 0..len {
        let a = nd(c, at(c, start, i))
        expr(inout c, a.a, pt)?
    }
    Ok(poison_v(inout c))
}

/// Declare `key` as a local of the error type (the binding of a statement that failed);
/// nothing if the name is already declared in this scope.
fn declare_poison(inout c: C, key: u64, line: u32, col: u32) {
    let ty = poison(inout c)
    let l = ir.local(inout c.ir, resolve.key_sym(key), ty, ir.L_LET, line)
    let m = c.marks[c.marks.len() - 1] as usize
    for i in m..c.scopes.len() {
        if c.scopes[i].key == key { return }
    }
    c.scopes.push(local_at(key, ty, true, line, col, l))
}

/// The names pattern `pat` binds (as lower_pat would), declared with the error type.
fn bind_pat_poison(inout c: C, pat: u32) {
    let n = nd(c, pat)
    if n.kind == ast.PName {
        let k = resolve.name_key(c.p, c.am, n.a, n.b, n.line, n.col)
        if !c.variants.contains(k) { declare_poison(inout c, k, n.line, n.col) }
        return
    }
    if n.kind == ast.PVariant || n.kind == ast.PTuple {
        for i in 0..n.d {
            let sp = at(c, n.c, i)
            bind_pat_poison(inout c, sp)
        }
    }
}

/// The names statement st would have declared, with the error type (it failed).
fn bind_failed(inout c: C, st: u32) {
    let n = nd(c, st)
    if n.kind == ast.SLet { declare_poison(inout c, resolve.key(0, n.a), n.line, n.col) }
    if n.kind == ast.SLetPat { bind_pat_poison(inout c, n.a) }
}

/// check_assignable, recording its error and going on (the expression is still checked).
fn assignable_or_record(inout c: C, target: u32, verb: str) {
    match check_assignable(c, target, verb) {
        Ok(_) => {}
        Err(d) => record(inout c, d)
    }
}

// ---- small helpers

fn nd(c: C, id: u32) -> ast.Node { c.p.mods[c.am as usize].ast.nodes[id as usize] }
fn ndm(c: C, m: u32, id: u32) -> ast.Node { c.p.mods[m as usize].ast.nodes[id as usize] }
fn at(c: C, start: u32, i: u32) -> u32 { c.p.mods[c.am as usize].ast.extra[(start + i) as usize] }
fn atm(c: C, m: u32, start: u32, i: u32) -> u32 { c.p.mods[m as usize].ast.extra[(start + i) as usize] }

fn mget(m: Map[u64, u32], k: u64) -> u32 {
    match m.get(k) {
        Some(v) => v
        None => NONE
    }
}

fn has_sym(xs: List[u32], x: u32) -> bool {
    for y in xs {
        if y == x { return true }
    }
    false
}

fn sym_index(xs: List[u32], x: u32) -> u32 {
    for i in 0..xs.len() {
        if xs[i] == x { return i as u32 }
    }
    NONE
}

/// The int kind of name key k (entry-file names only), or NONE.
fn int_kind(c: C, k: u64) -> u32 {
    if resolve.key_pre(k) != 0 { return NONE }
    sym_index(c.w.ints, resolve.key_sym(k))
}

fn is_root(k: u64, sym: u32) -> bool { resolve.key_pre(k) == 0 && resolve.key_sym(k) == sym }

fn imax(k: u32) -> fold.Wide {
    match k {
        0 => fold.of_u64(2147483647)
        1 => fold.of_u64(9223372036854775807)
        2 => fold.of_u64(255)
        3 => fold.of_u64(4294967295)
        _ => fold.of_u64(18446744073709551615)
    }
}

fn imin(k: u32) -> fold.Wide {
    match k {
        0 => fold.of_neg(2147483648)
        1 => fold.of_neg(9223372036854775808)
        _ => fold.zero()
    }
}

fn fits(k: u32, w: fold.Wide) -> bool { !fold.lt(w, imin(k)) && !fold.gt(w, imax(k)) }

/// The value of the integer literal token `tok` of the current module.
fn lit(c: C, tok: u32) -> fold.Wide {
    let t = c.p.mods[c.am as usize].toks[tok as usize]
    if !t.big { return fold.of_u64(t.val) }
    fold.parse(c.p.mods[c.am as usize].src, t.start as usize, t.end as usize)
}

fn v_of(ty: u32, op: u32) -> V { V(ty, op, false, fold.zero()) }

fn visible(c: C, md: u32, public: bool) -> bool {
    public || md == resolve.NOMOD || md == c.p.prelude || c.cur_all || md == c.cur_mod
}

fn is_value_form(c: C, e: u32) -> bool {
    let k = nd(c, e).kind
    k == ast.EIf || k == ast.EMatch || k == ast.EBlock || k == ast.EUnsafe
}

/// An integer literal, possibly negated.
fn is_lit(c: C, e: u32) -> bool {
    let n = nd(c, e)
    if n.kind == ast.EInt { return true }
    if n.kind == ast.EUnary && n.a == 0 { return is_lit(c, n.b) }
    false
}

fn ekey(c: C, n: ast.Node) -> u64 { resolve.expr_key(c.p, c.am, n.a, n.b, n.line, n.col, c.locals) }

// ---- IR helpers

fn tmp(inout c: C, ty: u32, line: u32) -> u32 { ir.temp(inout c.ir, ty, line) }

fn emit(inout c: C, kind: u32, dst: u32, a: u32, b: u32, x: u32, ty: u32, line: u32) {
    // a write that may invalidate a reference is noted for the protection rule ("References")
    if c.rf.any && (kind == ir.S_STORE || kind == ir.S_CALL || kind == ir.S_BUILTIN) { note_writes(inout c, kind, a, b, x) }
    ir.emit(inout c.ir, kind, dst, a, b, x, ty, line)
}

/// dst := (kind ...) into a fresh temporary; returns its operand.
fn emit_val(inout c: C, kind: u32, a: u32, b: u32, x: u32, ty: u32, rty: u32, line: u32) -> u32 {
    let t = tmp(inout c, rty, line)
    emit(inout c, kind, t, a, b, x, ty, line)
    ir.op_local(inout c.ir, t, rty)
}

fn read(inout c: C, place: u32, ty: u32, line: u32) -> u32 { emit_val(inout c, ir.S_READ, place, 0, 0, ty, ty, line) }

/// A place holding operand `o` (temporaries are places; constants get one).
fn place_of_op(inout c: C, o: u32, ty: u32, line: u32) -> u32 {
    if ir.op_is_local(c.ir, o) {
        let l = ir.op_local_id(c.ir, o)
        return ir.place_local(inout c.ir, l, ty)
    }
    let t = tmp(inout c, ty, line)
    emit(inout c, ir.S_COPY, t, o, 0, 0, ty, line)
    ir.place_local(inout c.ir, t, ty)
}

fn int_op(inout c: C, ty: u32, w: fold.Wide) -> u32 { ir.op_int(inout c.ir, ty, fold.bits64(w)) }

fn const_v(inout c: C, ty: u32, w: fold.Wide) -> V {
    let o = int_op(inout c, ty, w)
    V(ty, o, true, w)
}

/// A builtin operation with a result (dst NONE for ()).
fn builtin_op(inout c: C, b: u32, args: List[u32], rty: u32, line: u32) -> u32 {
    let st = ir.list(inout c.ir, args)
    let n = args.len() as u32
    if rty == types.UNIT {
        emit(inout c, ir.S_BUILTIN, ir.NONE, b, st, n, rty, line)
        return ir.op_unit(inout c.ir)
    }
    emit_val(inout c, ir.S_BUILTIN, b, st, n, rty, rty, line)
}

// ---- ownership

/// Does a value of this type own heap memory?
fn owns(c: C, ty: u32) -> bool {
    let t = types.get(c.t, ty)
    if t.kind == types.T_STRING || t.kind == types.T_LIST || t.kind == types.T_MAP || t.kind == types.T_BOX || t.kind == types.T_FN { return true }
    if types.is_handle(t.kind) { return true }
    if t.kind == types.T_ARRAY { return owns(c, t.a) }
    if t.kind == types.T_TUPLE {
        for x in types.elems(c.t, ty) {
            if owns(c, x) { return true }
        }
        return false
    }
    if t.kind != types.T_ENUM && t.kind != types.T_RECORD { return false }
    // a record with its own Drop lives in a shared buffer ("Operation traits")
    if has_drop(c, ty) { return true }
    let d = c.t.defs[t.a as usize]
    if d.is_enum {
        for i in 0..d.len {
            let v = types.variant(c.t, d, i)
            for j in 0..v.flen {
                if owns(c, types.field(c.t, v.fstart, j).ty) { return true }
            }
        }
        return false
    }
    for j in 0..d.len {
        if owns(c, types.field(c.t, d.start, j).ty) { return true }
    }
    false
}

fn push_frame(inout c: C) {
    c.fmarks.push(c.frames.len() as u32)
    c.firs.push(c.ir.pending.len() as u32)
}

/// Whether the innermost frame's code ends in a jump (its drops would be dead code).
fn frame_done(c: C) -> bool {
    let from = c.firs[c.firs.len() - 1]
    let k = ir.last_kind(c.ir, from)
    k == ir.S_RETURN || k == ir.S_BREAK || k == ir.S_CONTINUE
}

fn emit_drop(inout c: C, place: u32, ty: u32) { emit(inout c, ir.S_DROP, 0, place, 0, 0, ty, 0) }

fn drop_local(inout c: C, o: Owned) {
    let pl = ir.place_local(inout c.ir, o.l, o.ty)
    emit_drop(inout c, pl, o.ty)
}

fn pop_frame(inout c: C, drops: bool) {
    let m: u32 = match c.fmarks.pop() {
        Some(x) => x
        None => 0
    }
    let mut emit_them = drops.copy()
    if emit_them && frame_done(c) { emit_them = false }
    c.firs.pop()
    if emit_them {
        let mut i = c.frames.len()
        while i > m as usize {
            i -= 1
            let o = c.frames[i].copy()
            if o.l != NONE { drop_local(inout c, o) }
        }
    }
    while c.frames.len() as u32 > m { c.frames.pop() }
}

/// Drop everything in frames `base..` (innermost first) without popping them.
fn drop_frames_from(inout c: C, base: u32) {
    if base as usize >= c.fmarks.len() { return }
    let from = c.fmarks[base as usize] as usize
    let mut i = c.frames.len()
    while i > from {
        i -= 1
        let o = c.frames[i].copy()
        if o.l != NONE { drop_local(inout c, o) }
    }
}

fn has_pending_drops(c: C) -> bool {
    for o in c.frames {
        if o.l != NONE { return true }
    }
    false
}

/// Register local l as owning a value of type ty in the innermost frame.
fn register(inout c: C, l: u32, ty: u32) {
    if owns(c, ty) { c.frames.push(Owned(l, ty)) }
}

fn cancel(inout c: C, l: u32) {
    for i in 0..c.frames.len() {
        if c.frames[i].l == l { c.frames[i] = Owned(NONE, 0) }
    }
    c.fresh.remove(l)
}

fn is_fresh(c: C, o: u32) -> bool {
    if !ir.op_is_local(c.ir, o) { return false }
    c.fresh.contains(ir.op_local_id(c.ir, o))
}

/// Make an owned rvalue a registered temporary (dropped with its frame unless moved).
fn mk_fresh(inout c: C, v: V, line: u32) -> V {
    if !owns(c, v.ty) || is_fresh(c, v.op) { return v }
    let mut l: u32 = 0
    if ir.op_is_local(c.ir, v.op) {
        l = ir.op_local_id(c.ir, v.op)
    } else {
        l = tmp(inout c, v.ty, line)
        emit(inout c, ir.S_COPY, l, v.op, 0, 0, v.ty, line)
    }
    c.fresh.insert(l, true)
    register(inout c, l, v.ty)
    v_of(v.ty, ir.op_local(inout c.ir, l, v.ty))
}

/// An operand that owns v's value, ready to be moved into new storage: a fresh temporary
/// leaves its frame, anything else is cloned.
fn take(inout c: C, v: V, line: u32) -> u32 {
    if !owns(c, v.ty) { return v.op }
    if is_fresh(c, v.op) {
        let l = ir.op_local_id(c.ir, v.op)
        cancel(inout c, l)
        return v.op
    }
    emit_val(inout c, ir.S_CLONE, v.op, 0, 0, v.ty, v.ty, line)
}

/// Declare a pattern binding's storage: clones owned data out of the scrutinee.
fn bind_value(inout c: C, l: u32, ty: u32, place: u32) {
    if owns(c, ty) {
        let b = read(inout c, place, ty, 0)
        emit(inout c, ir.S_CLONE, l, b, 0, 0, ty, 0)
        register(inout c, l, ty)
    } else {
        emit(inout c, ir.S_READ, l, place, 0, 0, ty, 0)
    }
}

// ---- References (docs/compiler.md, "C8.6: references by default")
//
// `let x = place` (a variable, field or element, rooted at a variable in scope) binds a
// read-only reference: x has no storage; it names the place, whose indices are evaluated
// once, when x is bound, and every use of x reads (or, for `let mut x = place`, a mutable
// alias, writes) that place. So a reference costs no copy and no drop, always sees the
// place's current value, and becomes a value only where it escapes (stored, returned,
// captured), through the ordinary `take` clone. Pattern bindings of a place scrutinee are
// references the same way (`mut x`: an alias). A fresh value (a call, a literal, a
// constructor, an operation) is owned, as before; `var` keeps making its own copy
// (deprecated: `eiderc migrate-var` rewrites it, "Migration of var" below).
//
// The protection rule: while a reference is alive (until its last use, on any path), no
// write may free, move or reinterpret memory it points into. Every binding (N_DEF), use
// (N_USE) and possibly invalidating write (N_WRITE: an assignment, an `inout` argument, a
// resizing builtin) is noted in the IR as an S_NOTE; `protect` runs a backward liveness
// pass over each function with references and reports E0308 for a write to a place P while
// a live reference R points into it: P is a prefix of R (indices compared as equal, whatever
// they are) and the rest of R's path goes through heap memory (a List element, a Box, a
// record with its own Drop) or an enum payload. Then the notes are removed, so lowering and
// the IR dump never see them.

const N_DEF: u32 = 0
const N_USE: u32 = 1
const N_WRITE: u32 = 2

const W_ASSIGN: u32 = 0
const W_RESIZE: u32 = 1
const W_INOUT: u32 = 2

/// A reference: the place it names, its binding (key, line, col, module m), whether it is
/// a mutable alias, and the fix that makes it own a copy instead (`.copy()` after its
/// initializer or scrutinee; none when its type lacks Copy, or in a generic body: `generic`).
type RefInfo = { place: u32, key: u64, line: u32, col: u32, mutable: bool, fix: Option[diag.Fix], m: u32, generic: bool }

/// A write that may invalidate a reference: of `place`, an assignment, an `inout` argument
/// or a resizing builtin (`what`), at (line, col) of module m.
type WriteInfo = { place: u32, kind: u32, what: List[u8], line: u32, col: u32, m: u32 }

/// The edits that rewrite one `var` (module m) as `let mut` ("Migration of var").
type VarSite = { m: u32, fixes: List[diag.Fix] }

/// The checker's reference state: every reference and noted write of the program, the IR
/// functions that have references, the stack of source positions writes are reported at
/// (the innermost assignment or call being checked), the `var` rewrites, and whether the
/// body being checked has a reference (so other bodies note no writes).
/// With `audit` (`eiderc audit-refs`, "Audit" below), `hits` collects every write that
/// changes what a live reference sees without invalidating it.
type Refs = {
    refs: List[RefInfo], writes: List[WriteInfo], fns: Map[u32, bool], wpos: List[u64], vars: List[VarSite], any: bool,
    audit: bool, hits: List[diag.Diag],
}

fn no_refs() -> Refs { Refs(List.new(), List.new(), Map.new(), List.new(), List.new(), false, false, List.new()) }

fn ref_note(inout c: C, kind: u32, i: u32) { ir.emit(inout c.ir, ir.S_NOTE, 0, kind, i, 0, 0, 0) }

/// The place a local names: its own storage, or for a reference the place it refers to.
fn local_place(inout c: C, v: Local) -> u32 {
    if v.alias == NONE { return ir.place_local(inout c.ir, v.ir, v.ty) }
    ref_note(inout c, N_USE, v.refid)
    v.alias
}

/// Whether expression e is a place rooted at a variable in scope (so `let` binds a
/// reference to it rather than owning a value).
fn ref_init(c: C, e: u32) -> bool {
    if !is_place(c, e) { return false }
    let r = root(c, e)
    r.ok && lookup(c, r.key) != NONE
}

/// The key of the variable the place named by key k is rooted at (k itself unless k is a
/// reference).
fn canon(c: C, k: u64) -> u64 {
    let li = lookup(c, k)
    if li == NONE { return k }
    let v = c.scopes[li as usize]
    if v.alias == NONE { return k }
    v.aroot
}

/// Whether the variable key k may be written through (a `var`, a `let mut`, an `inout`
/// parameter, a mutable alias).
fn writable(c: C, k: u64) -> bool {
    let li = lookup(c, k)
    if li == NONE { return false }
    let v = c.scopes[li as usize]
    v.mutable || v.byref
}

/// `.copy()` inserted at (line, col), when ty has Copy (the fix that makes a binding own a
/// copy instead of referring to a place).
fn copy_fix(c: C, ty: u32, line: u32, col: u32) -> Option[diag.Fix] {
    // (in a generic body `.copy()` may need a bound the fix can't add as well: no fix there)
    if line == 0 || generic_body(c) || poisoned(c, ty) || !has_trait(c, TR_COPY, ty) { return None }
    Some(diag.Fix(line, col, 0, s(".copy()")))
}

/// Whether the body being checked is an instance of a generic one (its type parameters
/// other than a concrete impl's `Self` are substituted).
fn generic_body(c: C) -> bool {
    for x in c.tsubst.syms {
        if x != intern.S_SELF_TYPE { return true }
    }
    false
}

/// E0307: a mutable alias of a place that can't be written (`let mut x = p` with p a
/// parameter, a `let` binding, a capture...).
fn alias_error(c: C, line: u32, col: u32, what: List[u8], rk: u64, fix: Option[diag.Fix]) -> diag.Diag {
    let mut d = err("E0307", line, col, q2("", what, " would be a mutable alias of `", kt(c, rk), "`, which is read-only"))
    d.help = s("an alias can't add write access; take an independent value with `.copy()`")
    d.fix = fix
    d
}

/// E0301 for a reference k into variable r, read by a call that also borrows r mutably.
fn alias_read_error(c: C, line: u32, col: u32, k: u64, r: u64) -> diag.Diag {
    let mut d = err("E0301", line, col, q2("`", kt(c, k), "` refers into `", kt(c, r), "`, which is borrowed mutably by another argument of this call"))
    d.help = q("bind a copy instead of a reference: `.copy()` (the call may change `", kt(c, r), "`)")
    let li = lookup(c, k)
    if li != NONE && c.scopes[li as usize].refid != NONE { d.fix = c.rf.refs[c.scopes[li as usize].refid as usize].fix }
    d
}

/// A new reference named key (declared at line:col) to `place` of type ty, rooted at the
/// variable rk: noted, and the local that stands for it.
fn new_ref(inout c: C, key: u64, ty: u32, place: u32, mutable: bool, rk: u64, line: u32, col: u32, fix: Option[diag.Fix]) -> Local {
    let rid = c.rf.refs.len() as u32
    c.rf.refs.push(RefInfo(place, key, line, col, mutable, fix, c.am, generic_body(c)))
    c.rf.fns.insert(c.ir.cur, true)
    c.rf.any = true
    ref_note(inout c, N_DEF, rid)
    // its indices are checked now, as reading the place would
    if has_index(c, place) { emit(inout c, ir.S_CHECK, 0, place, 0, 0, ty, line) }
    Local(key, ty, mutable, false, true, line, col, NONE, line, col, line, col, place, rid, canon(c, rk))
}

/// A use of every reference expression e names (e is read again where this is noted).
fn note_uses(inout c: C, e: u32) {
    let mut ks: List[u64] = List.new()
    idents(c, e, inout ks)
    for k in ks {
        let li = lookup(c, k)
        if li != NONE && c.scopes[li as usize].alias != NONE {
            let rid = c.scopes[li as usize].refid.copy()
            ref_note(inout c, N_USE, rid)
        }
    }
}

/// Whether a reference is in scope (only then can a write invalidate one).
fn refs_in_scope(c: C) -> bool {
    let mut i = c.scopes.len()
    while i > 0 {
        i -= 1
        if c.scopes[i].alias != NONE { return true }
    }
    false
}

/// The position writes are reported at while checking an assignment or call at line:col.
fn at_pos(inout c: C, line: u32, col: u32) { c.rf.wpos.push((line as u64) * 4294967296 + col as u64) }

fn end_pos(inout c: C) { c.rf.wpos.pop() }

/// Whether builtin b may resize or replace the buffer of its place argument.
fn resizes(b: u32) -> bool {
    b == ir.B_LIST_PUSH || b == ir.B_LIST_POP || b == ir.B_LIST_CLEAR || b == ir.B_MAP_INSERT || b == ir.B_MAP_REMOVE || b == ir.B_STR_PUSH || b == ir.B_STR_APPEND || b == ir.B_STR_PUSH_BYTE
}

/// Whether place p has an element on its path (a bounds check).
fn has_index(c: C, p: u32) -> bool {
    let x = c.ir.places[p as usize]
    if x.kind == ir.P_LOCAL { return false }
    x.kind == ir.P_INDEX || has_index(c, x.a)
}

/// The local a place is rooted at.
fn place_root(c: C, p: u32) -> u32 {
    let x = c.ir.places[p as usize]
    if x.kind == ir.P_LOCAL { return x.a }
    place_root(c, x.a)
}

/// Note the writes of statement (kind, a, b, x) that may invalidate a reference in scope.
fn note_writes(inout c: C, kind: u32, a: u32, b: u32, x: u32) {
    if !refs_in_scope(c) { return }
    if kind == ir.S_STORE {
        write_note(inout c, a, W_ASSIGN, List.new())
        return
    }
    let mut wk = W_INOUT
    let mut what: List[u8] = List.new()
    if kind == ir.S_BUILTIN && resizes(a) {
        wk = W_RESIZE
        what = s(ir.builtin_name(a))
    }
    for i in 0..x {
        let arg = c.ir.extra[(b + i) as usize].copy()
        if arg >= ir.ARG_PLACE { write_note(inout c, arg - ir.ARG_PLACE, wk, what) }
    }
}

fn write_note(inout c: C, place: u32, kind: u32, what: List[u8]) {
    // temporaries are never referred to
    if c.ir.building[place_root(c, place) as usize].kind == ir.L_TEMP { return }
    let mut line: u32 = 0
    let mut col: u32 = 0
    if c.rf.wpos.len() > 0 {
        let pos = c.rf.wpos[c.rf.wpos.len() - 1]
        line = (pos / 4294967296) as u32
        col = (pos % 4294967296) as u32
    }
    c.rf.writes.push(WriteInfo(place, kind, what, line, col, c.am))
    let wi = (c.rf.writes.len() - 1) as u32
    ref_note(inout c, N_WRITE, wi)
}

/// One step of a place's path from its root variable: a field (a = index; through heap
/// memory when the record has its own Drop), an element (of a List: heap memory), an enum
/// payload (a = variant * 65536 + field) or a Box's contents.
type Step = { kind: u32, a: u32, heap: bool }

fn path(c: C, p: u32, inout out: List[Step]) {
    let x = c.ir.places[p as usize]
    if x.kind == ir.P_LOCAL { return }
    path(c, x.a, inout out)
    let bty = c.ir.places[x.a as usize].ty
    if x.kind == ir.P_FIELD {
        let shared = types.kind(c.t, bty) == types.T_RECORD && has_drop(c, bty)
        out.push(Step(ir.P_FIELD, x.b, shared))
    } else if x.kind == ir.P_INDEX {
        out.push(Step(ir.P_INDEX, 0, types.kind(c.t, bty) == types.T_LIST))
    } else if x.kind == ir.P_PAYLOAD {
        out.push(Step(ir.P_PAYLOAD, x.b * 65536 + x.c, true))
    } else {
        out.push(Step(ir.P_DEREF, 0, true))
    }
}

/// Whether a write to place w invalidates reference place r: same root, w's path a prefix of
/// r's (any two indices count as equal), and the rest of r's path goes through heap memory
/// or a payload.
fn invalidates(c: C, r: u32, w: u32) -> bool {
    if place_root(c, r) != place_root(c, w) { return false }
    let mut rs: List[Step] = List.new()
    let mut ws: List[Step] = List.new()
    path(c, r, inout rs)
    path(c, w, inout ws)
    if ws.len() > rs.len() { return false }
    for i in 0..ws.len() {
        if rs[i].kind != ws[i].kind || rs[i].a != ws[i].a { return false }
    }
    for i in ws.len()..rs.len() {
        if rs[i].heap { return true }
    }
    false
}

/// A place as the message names it: `orders[..].qty` (payloads and Box contents are named
/// by their enum or Box).
fn place_name(c: C, f: u32, p: u32) -> List[u8] {
    let x = c.ir.places[p as usize]
    if x.kind == ir.P_LOCAL { return nm(c, c.ir.locals[(c.ir.fns[f as usize].lstart + x.a) as usize].name) }
    let mut t = place_name(c, f, x.a)
    if x.kind == ir.P_FIELD {
        let bty = c.ir.places[x.a as usize].ty
        t.push(46)
        if types.kind(c.t, bty) == types.T_RECORD {
            let d = types.def_of(c.t, bty)
            bytes.append(inout t, nm(c, types.field(c.t, d.start, x.b).name))
        } else {
            bytes.append(inout t, num(x.b as u64))
        }
    } else if x.kind == ir.P_INDEX {
        bytes.append(inout t, s("[..]"))
    }
    t
}

fn union(a: List[u32], b: List[u32]) -> List[u32] {
    let mut out = a.copy()
    for x in b {
        if !out.contains(x) { out.push(x) }
    }
    out
}

fn without(a: List[u32], x: u32) -> List[u32] {
    let mut out: List[u32] = List.new()
    for y in a {
        if y != x { out.push(y) }
    }
    out
}

/// The protection rule over every function with references (see the top of this section),
/// then the notes are removed from the IR.
fn protect(inout c: C) {
    if c.rf.refs.len() == 0 { return }
    let mut seen: List[u64] = List.new()
    for f in 0..c.ir.fns.len() {
        if !c.rf.fns.contains(f as u32) { continue }
        let body = c.ir.fns[f].body.copy()
        if body == 0 { continue }
        let none: List[u32] = List.new()
        let mut found: List[Found] = List.new()
        lv_block(inout c, f as u32, body - 1, none, none, none, true, inout seen, inout found)
        // a function's errors in source order (the pass found them backwards)
        let mut sorted: List[Found] = List.new()
        for x in found {
            let mut i: usize = 0
            while i < sorted.len() && (sorted[i].d.line < x.d.line || (sorted[i].d.line == x.d.line && sorted[i].d.col <= x.d.col)) { i += 1 }
            let mut next: List[Found] = List.new()
            for j in 0..i { next.push(sorted[j]) }
            next.push(x)
            for j in i..sorted.len() { next.push(sorted[j]) }
            sorted = next
        }
        for x in sorted {
            c.err_mod = x.m
            record(inout c, x.d)
        }
    }
    c.err_mod = resolve.NOMOD
    strip_notes(inout c)
}

/// An E0308 found in module m.
type Found = { d: diag.Diag, m: u32 }

/// Liveness of references, backwards through block b of function f: the references live
/// before it, given those live after it (`after`), at a `break` (`brk`) and at a `continue`
/// (`cont`). With `report`, every noted write is checked against those live after it.
fn lv_block(inout c: C, f: u32, b: u32, after: List[u32], brk: List[u32], cont: List[u32], report: bool, inout seen: List[u64], inout found: List[Found]) -> List[u32] {
    let bl = c.ir.blocks[b as usize].copy()
    let mut live = after.copy()
    let mut i = bl.len.copy()
    while i > 0 {
        i -= 1
        let st = c.ir.stmts[c.ir.extra[(bl.start + i) as usize] as usize].copy()
        let k = st.kind
        if k == ir.S_NOTE {
            if st.a == N_USE {
                if !live.contains(st.b) { live.push(st.b) }
            } else if st.a == N_DEF {
                live = without(live, st.b)
            } else if report {
                check_write(inout c, f, st.b, live, inout seen, inout found)
            }
        } else if k == ir.S_IF {
            let t = lv_block(inout c, f, st.b, live, brk, cont, report, inout seen, inout found)
            let e = lv_block(inout c, f, st.c, live, brk, cont, report, inout seen, inout found)
            live = union(t, e)
        } else if k == ir.S_LOOP {
            live = lv_loop(inout c, f, st.a, st.b, live, report, inout seen, inout found)
        } else if k == ir.S_BREAK {
            live = brk
        } else if k == ir.S_CONTINUE {
            live = cont
        } else if k == ir.S_RETURN || k == ir.S_PANIC {
            live = List.new()
        }
    }
    live
}

/// A loop: its body falls through, and `continue` goes, to the step, then the body again;
/// `break` leaves it to `after`. The references live at its head, to a fixed point.
fn lv_loop(inout c: C, f: u32, body: u32, step: u32, after: List[u32], report: bool, inout seen: List[u64], inout found: List[Found]) -> List[u32] {
    let mut head: List[u32] = List.new()
    while true {
        let sin = lv_block(inout c, f, step, head, after, head, false, inout seen, inout found)
        let bin = lv_block(inout c, f, body, sin, after, sin, false, inout seen, inout found)
        let nh = union(head, bin)
        if nh.len() == head.len() { break }
        head = nh
    }
    if report {
        let sin = lv_block(inout c, f, step, head, after, head, true, inout seen, inout found)
        lv_block(inout c, f, body, sin, after, sin, true, inout seen, inout found)
    }
    head
}

/// E0308 when write w (of function f) invalidates a reference in `live` (the earliest one).
fn check_write(inout c: C, f: u32, w: u32, live: List[u32], inout seen: List[u64], inout found: List[Found]) {
    let wi = c.rf.writes[w as usize].copy()
    if c.rf.audit { audit_write(inout c, f, wi, live) }
    let mut best = NONE
    for r in live {
        if (best == NONE || r < best) && invalidates(c, c.rf.refs[r as usize].place, wi.place) { best = r }
    }
    if best == NONE { return }
    // once per write (generic bodies are checked once per instance)
    let key = (wi.m as u64) * 1099511627776 + (wi.line as u64) * 1048576 + wi.col as u64
    if seen.contains(key) { return }
    seen.push(key)
    let rf = c.rf.refs[best as usize]
    let pn = place_name(c, f, wi.place)
    let rn = kt(c, rf.key)
    let mut msg: List[u8] = List.new()
    if wi.kind == W_RESIZE {
        msg = q3("can't call `", wi.what, "` on `", pn, "` while `", rn, "` refers into it")
    } else if wi.kind == W_INOUT {
        msg = q2("can't pass `", pn, "` as `inout` while `", rn, "` refers into it")
    } else {
        msg = q2("can't assign to `", pn, "` while `", rn, "` refers into it")
    }
    let mut d = err("E0308", wi.line, wi.col, msg)
    let mut h = q("`", rn, "` is used after this change, which may free, move or replace what it refers to; use it before the change")
    let has_fix = match rf.fix {
        Some(_) => true
        None => false
    }
    if has_fix || rf.generic { bytes.append(inout h, s(", or bind a copy with `.copy()`")) }
    if rf.generic && !has_fix { bytes.append(inout h, s(" (with a `Copy` bound on its type parameter)")) }
    if has_fix && rf.mutable { bytes.append(inout h, s(" (then writes through it change only the copy)")) }
    d.help = h
    d.fix = rf.fix
    found.push(Found(d, wi.m))
}

// ---- Audit (`eiderc audit-refs`, docs/compiler.md "C8.6")
//
// Code written when `let` copied a place means something else now wherever it writes the
// place while the binding is still used: the binding sees the write. Invalidating writes are
// E0308; the audit reports the others, each with the `.copy()` that restores the old meaning
// (none in a generic body or for a type without Copy). It covers `let` and pattern
// references (both were copies), not `let mut` / `mut` aliases (new code means the alias).

/// Whether a write to place w changes what reference place r sees: same root, and one path
/// a prefix of the other (any two indices count as equal).
fn overlaps(c: C, r: u32, w: u32) -> bool {
    if place_root(c, r) != place_root(c, w) { return false }
    let mut rs: List[Step] = List.new()
    let mut ws: List[Step] = List.new()
    path(c, r, inout rs)
    path(c, w, inout ws)
    let mut i: usize = 0
    while i < rs.len() && i < ws.len() {
        if rs[i].kind != ws[i].kind || rs[i].a != ws[i].a { return false }
        i += 1
    }
    true
}

fn audit_write(inout c: C, f: u32, wi: WriteInfo, live: List[u32]) {
    for r in live {
        let rf = c.rf.refs[r as usize]
        if rf.mutable || !overlaps(c, rf.place, wi.place) || invalidates(c, rf.place, wi.place) { continue }
        // (repeats, from the instances of a generic body, go in audit_hits)
        let rn = kt(c, rf.key)
        let mut msg = q2("this write changes what `", rn, "` sees (`", place_name(c, f, wi.place), "`): `")
        bytes.append(inout msg, rn)
        bytes.append(inout msg, s("` is a reference since C8.6, it used to be a copy (line "))
        bytes.append(inout msg, num(rf.line as u64))
        bytes.append(inout msg, s(")"))
        let mut d = err("audit", wi.line, wi.col, msg)
        d.help = s("bind a copy to keep the old meaning: `.copy()`")
        let fixed = match rf.fix {
            Some(_) => true
            None => false
        }
        if !fixed && rf.generic { d.help = s("bind a copy to keep the old meaning: `.copy()`, with a `Copy` bound on the type parameter") }
        if !fixed && !rf.generic { d.help = s("its type has no Copy: bind it with `var` (deprecated, but a share of the value, as `let` made before C8.6)") }
        d.fix = rf.fix
        c.rf.hits.push(in_file(c, d, wi.m))
    }
}

/// `check_all` with the audit on.
pub fn check_audit(p: resolve.Program) -> Checked {
    let mut c = new_checker(p, false)
    c.rf.audit = true
    finish(inout c)
}

/// The audit's findings, by file (the entry's first), line and column.
pub fn audit_hits(c: C) -> List[diag.Diag] {
    let mut out: List[diag.Diag] = List.new()
    for d in c.rf.hits {
        let mut i: usize = 0
        while i < out.len() && before_or_same(out[i], d) { i += 1 }
        let mut next: List[diag.Diag] = List.new()
        for j in 0..i { next.push(out[j]) }
        next.push(d)
        for j in i..out.len() { next.push(out[j]) }
        out = next
    }
    diag.dedup(out)
}

fn before_or_same(a: diag.Diag, b: diag.Diag) -> bool {
    if !bytes.eq(a.file, b.file) { return a.file.len() == 0 || (b.file.len() > 0 && bytes.compare(a.file, b.file) < 0) }
    a.line < b.line || (a.line == b.line && a.col <= b.col)
}

/// Remove the S_NOTEs from every block (they are the checker's own; lowering never sees them).
fn strip_notes(inout c: C) {
    for b in 0..c.ir.blocks.len() {
        let bl = c.ir.blocks[b]
        let mut n: u32 = 0
        for i in 0..bl.len {
            let sid = c.ir.extra[(bl.start + i) as usize]
            if c.ir.stmts[sid as usize].kind != ir.S_NOTE {
                c.ir.extra[(bl.start + n) as usize] = sid
                n += 1
            }
        }
        if n != bl.len { c.ir.blocks[b] = ir.Block(bl.start, n) }
    }
}

// ---- scopes

fn push_scope(inout c: C) { c.marks.push(c.scopes.len() as u32) }

fn pop_scope(inout c: C) {
    let m: u32 = match c.marks.pop() {
        Some(x) => x
        None => 0
    }
    while c.scopes.len() as u32 > m { c.scopes.pop() }
}

fn lookup(c: C, k: u64) -> u32 {
    let mut i = c.scopes.len()
    while i > 0 {
        i -= 1
        if c.scopes[i].key == k { return i as u32 }
    }
    NONE
}

fn declare(inout c: C, l: Local) -> Result[bool, diag.Diag] {
    let m = c.marks[c.marks.len() - 1] as usize
    for i in m..c.scopes.len() {
        if c.scopes[i].key == l.key {
            return Err(errh("E0305", l.line, l.col, q("`", kt(c, l.key), "` is already declared in this scope"), "assign to it (declare with `var`), or pick a different name"))
        }
    }
    c.scopes.push(l)
    if c.rec.on && !poisoned(c, l.ty) { c.rec.tys.push(RecTy(c.am, l.aline, l.acol, false, true, l.ty)) }
    Ok(true)
}

fn local_at(key: u64, ty: u32, mutable: bool, line: u32, col: u32, l: u32) -> Local {
    Local(key, ty, mutable, false, true, line, col, l, line, col, line, col, NONE, NONE, 0)
}

fn local_plain(key: u64, ty: u32, byref: bool, line: u32, col: u32, l: u32) -> Local {
    Local(key, ty, false, byref, false, line, col, l, line, col, line, col, NONE, NONE, 0)
}

// ---- substitutions

fn no_subst() -> Subst { Subst(List.new(), List.new()) }

fn subst_get(sb: Subst, sym: u32) -> u32 {
    for i in 0..sb.syms.len() {
        if sb.syms[i] == sym { return sb.tys[i] }
    }
    NONE
}

fn subst_set(inout sb: Subst, sym: u32, ty: u32) {
    for i in 0..sb.syms.len() {
        if sb.syms[i] == sym {
            sb.tys[i] = ty
            return
        }
    }
    sb.syms.push(sym)
    sb.tys.push(ty)
}

/// The type parameter symbols of generic parameter list [start/len) in module m.
fn gparams(c: C, m: u32, start: u32, len: u32) -> List[u32] {
    let mut out: List[u32] = List.new()
    for i in 0..len { out.push(ndm(c, m, atm(c, m, start, i)).a) }
    out
}

// ---- types

/// Resolve type node `tn` of module `am` (names resolve in that module, visibility from the
/// module being checked, type parameters from `tsubst`).
fn resolve_ty(inout c: C, am: u32, tn: u32) -> Result[u32, diag.Diag] {
    let n = ndm(c, am, tn)
    match n.kind {
        ast.TUnit => Ok(types.UNIT)
        ast.TArray => {
            if n.b == 0 { return Err(err("E0111", n.line, n.col, s("array length must be at least 1"))) }
            let e = resolve_ty(inout c, am, n.a)?
            Ok(types.array(inout c.t, e, n.b))
        }
        ast.TName => {
            if n.b == 0 {
                let sub = subst_get(c.tsubst, n.a)
                if sub != NONE { return Ok(sub) }
            }
            let k = resolve.name_key(c.p, am, n.a, n.b, n.line, n.col)
            let ik = int_kind(c, k)
            if ik != NONE { return Ok(ik) }
            if is_root(k, c.w.s_bool) { return Ok(types.BOOL) }
            if is_root(k, c.w.s_str) { return Ok(types.STR) }
            if is_root(k, c.w.s_string) { return Ok(types.STRING) }
            if resolve.key_pre(k) == 0 && has_sym(c.w.heap, n.a) {
                return Err(err("E0111", n.line, n.col, q2("type `", kt(c, k), "` needs type arguments: `", kt(c, k), "[...]`")))
            }
            let ai = mget(c.al.keys, k)
            if ai != NONE { return alias_ty(inout c, ai, List.new(), n.line, n.col) }
            let di = mget(c.tmpl, k)
            if di == NONE { return Err(err("E0111", n.line, n.col, q("unknown type `", kt(c, k), "`"))) }
            note_def(inout c, am, n, di)
            let g = c.t.defs[di as usize].generic
            if g > 0 {
                return Err(err("E0111", n.line, n.col, q3("type `", kt(c, k), "` needs ", num(g as u64), " type argument(s): `", kt(c, k), "[...]`")))
            }
            inst_type(inout c, di, List.new(), n.line, n.col)
        }
        ast.TGeneric => {
            let mut args: List[u32] = List.new()
            for i in 0..n.d {
                let arg = atm(c, am, n.c, i)
                args.push(resolve_ty(inout c, am, arg)?)
            }
            let k = resolve.name_key(c.p, am, n.a, n.b, n.line, n.col)
            if resolve.key_pre(k) == 0 && has_sym(c.w.heap, n.a) {
                let mut want: u32 = 1
                if n.a == c.w.map { want = 2 }
                if args.len() as u32 != want {
                    return Err(err("E0111", n.line, n.col, q3("type `", kt(c, k), "` takes ", num(want as u64), " type argument(s), but ", num(args.len() as u64), " were given")))
                }
                let is_task = n.a == c.w.heap[3]
                for a in args {
                    if (a == types.UNIT || a == types.NEVER) && !is_task {
                        return Err(err("E0111", n.line, n.col, q("`", kt(c, k), "` can't hold ()")))
                    }
                }
                if n.a == c.w.list { return Ok(types.list_of(inout c.t, args[0])) }
                if n.a == c.w.boxs { return Ok(types.box_of(inout c.t, args[0])) }
                if n.a == c.w.map {
                    check_map_key(c, args[0], n.line, n.col)?
                    return Ok(types.map_of(inout c.t, args[0], args[1]))
                }
                if is_task { return Ok(types.task_of(inout c.t, args[0])) }
                if n.a == c.w.heap[4] { return Ok(types.mutex_of(inout c.t, args[0])) }
                return Ok(types.chan_of(inout c.t, args[0]))
            }
            let ai = mget(c.al.keys, k)
            if ai != NONE { return alias_ty(inout c, ai, args, n.line, n.col) }
            let di = mget(c.tmpl, k)
            if di == NONE { return Err(err("E0111", n.line, n.col, q("unknown type `", kt(c, k), "`"))) }
            note_def(inout c, am, n, di)
            inst_type(inout c, di, args, n.line, n.col)
        }
        ast.TTuple => {
            let mut elems: List[u32] = List.new()
            for i in 0..n.d {
                let x = atm(c, am, n.c, i)
                elems.push(resolve_ty(inout c, am, x)?)
            }
            Ok(types.tuple(inout c.t, elems))
        }
        _ => {
            let mut ps: List[u32] = List.new()
            for i in 0..n.d {
                let x = atm(c, am, n.c, i)
                ps.push(resolve_ty(inout c, am, x)?)
            }
            let mut r = types.UNIT
            if n.g > 0 { r = resolve_ty(inout c, am, n.g - 1)? }
            Ok(types.fn_of(inout c.t, ps, r))
        }
    }
}

// ---- Type aliases
//
// `type Name[T, ...] = <type>` names a type; it is the same type wherever it is written
// (transparent: no new type, no conversion), resolved at each use with the alias's
// parameters bound to the use's arguments. An alias is a type name only: it isn't a
// constructor, and its variants (for an alias of an enum) keep their own names.

/// The type alias ai stands for, applied to `args` (at line, col of the use).
fn alias_ty(inout c: C, ai: u32, args: List[u32], line: u32, col: u32) -> Result[u32, diag.Diag] {
    let a = c.al.defs[ai as usize].copy()
    let n = ndm(c, a.m, a.node)
    let k = resolve.item_key(c.p, a.m, n.a)
    if !visible(c, a.m, n.b == 1) {
        let path = c.p.mods[a.m as usize].path
        return Err(errh("E0801", line, col, q2("type `", kt(c, k), "` is private to module `", path, "`"), "mark it `pub` in its own file to use it from other modules"))
    }
    if args.len() as u32 != n.d {
        if args.len() == 0 {
            return Err(err("E0111", line, col, q3("type `", kt(c, k), "` needs ", num(n.d as u64), " type argument(s): `", kt(c, k), "[...]`")))
        }
        return Err(err("E0111", line, col, q3("type `", kt(c, k), "` takes ", num(n.d as u64), " type argument(s), but ", num(args.len() as u64), " were given")))
    }
    if c.al.stack.contains(ai) {
        return Err(errh("E0111", line, col, q("type alias `", kt(c, k), "` refers to itself"), "an alias is another name for a type; a recursive type needs a record or an enum (`type Tree = { kids: List[Tree] }`)"))
    }
    let gs = gparams(c, a.m, n.c, n.d)
    let mut sb = no_subst()
    for i in 0..gs.len() { subst_set(inout sb, gs[i], args[i]) }
    c.al.stack.push(ai)
    let r = resolve_with(inout c, a.m, n.g - 1, sb)
    c.al.stack.pop()
    match r {
        Ok(t) => Ok(t)
        Err(d) => Err(in_file(c, d, a.m))
    }
}

/// The alias a type name of module m names (n: TName or TGeneric), or NONE.
fn alias_of(c: C, m: u32, n: ast.Node) -> u32 {
    if c.al.defs.len() == 0 { return NONE }
    mget(c.al.keys, resolve.name_key(c.p, m, n.a, n.b, n.line, n.col))
}

/// unify_ast for a use n of alias ai: the alias's type against `actual` binds the alias's
/// parameters, whose types are then matched against the use's arguments.
fn unify_alias(c: C, m: u32, n: ast.Node, ai: u32, actual: u32, inout sb: Subst, gs: List[u32]) -> bool {
    let a = c.al.defs[ai as usize]
    let an = ndm(c, a.m, a.node)
    // a use with the wrong number of arguments is reported when it is resolved
    if c.al.stack.len() > 32 || (n.kind == ast.TName && an.d > 0) || (n.kind == ast.TGeneric && an.d != n.d) { return true }
    let ags = gparams(c, a.m, an.c, an.d)
    let mut s2 = no_subst()
    if !unify_ast(c, a.m, an.g - 1, actual, inout s2, ags) { return false }
    if n.kind == ast.TName { return true }
    for i in 0..n.d {
        let bound = subst_get(s2, ags[i as usize])
        if bound == NONE { continue }
        if !unify_ast(c, m, atm(c, m, n.c, i), bound, inout sb, gs) { return false }
    }
    true
}

/// Resolve `tn` of module am with the type parameters of `sb` (and no others).
fn resolve_with(inout c: C, am: u32, tn: u32, sb: Subst) -> Result[u32, diag.Diag] {
    let saved = c.tsubst.copy()
    c.tsubst = sb
    let r = resolve_ty(inout c, am, tn)
    c.tsubst = saved
    r
}

/// A Map key type has Hash and Eq ("Operation traits"); a part with its own `==` needs its own
/// hash too, since equal keys must hash alike.
fn check_map_key(c: C, k: u32, line: u32, col: u32) -> Result[bool, diag.Diag] {
    for tr in [TR_HASH, TR_EQ] {
        let mut seen: Map[u32, bool] = Map.new()
        let part = lacks(c, tr, k, inout seen)
        if part != NONE && types.kind(c.t, part) == types.T_PARAM {
            // generic code: the key's type parameter needs both bounds
            let mut trs: List[u32] = List.new()
            if !has_trait(c, TR_HASH, part) { trs.push(TR_HASH) }
            if !has_trait(c, TR_EQ, part) || !has_trait(c, TR_HASH, part) { trs.push(TR_EQ) }
            return Err(bound_err(c, line, col, q("a key of ", ts(c, k), ""), trait_names(c, trs), part))
        }
        if part != NONE {
            let mut m = q2("", ts(c, k), " can't be a Map key: it doesn't implement `", trait_name(c, tr), "`")
            if part != k { bytes.append(inout m, q(" (its part ", ts(c, part), " doesn't)")) }
            let h = lack_help(c, tr, part)
            if s(h).len() == 0 { return Err(err("E0701", line, col, m)) }
            return Err(errh("E0701", line, col, m, h))
        }
    }
    let mut seen2: Map[u32, bool] = Map.new()
    let odd = eq_without_hash(c, k, inout seen2)
    if odd != NONE {
        return Err(errh("E0701", line, col, q2("", ts(c, k), " can't be a Map key: ", ts(c, odd), " has its own `Eq` but a derived `Hash`"), "equal keys must hash alike: implement `Hash` for it too"))
    }
    Ok(true)
}

/// A part of ty with its own Eq and a derived Hash, or NONE.
fn eq_without_hash(c: C, ty: u32, inout seen: Map[u32, bool]) -> u32 {
    if seen.contains(ty) || poisoned(c, ty) { return NONE }
    seen.insert(ty, true)
    let t = types.get(c.t, ty)
    let k = t.kind
    if k == types.T_RECORD || k == types.T_ENUM {
        let hc = custom(c, TR_HASH, ty)
        if custom(c, TR_EQ, ty) && !hc { return ty }
        if hc { return NONE }
        let d = types.def_of(c.t, ty)
        if d.is_enum {
            for i in 0..d.len {
                let v = types.variant(c.t, d, i)
                for j in 0..v.flen {
                    let x = eq_without_hash(c, types.field(c.t, v.fstart, j).ty, inout seen)
                    if x != NONE { return x }
                }
            }
            return NONE
        }
        for j in 0..d.len {
            let x = eq_without_hash(c, types.field(c.t, d.start, j).ty, inout seen)
            if x != NONE { return x }
        }
        return NONE
    }
    if k == types.T_ARRAY || k == types.T_LIST || k == types.T_BOX { return eq_without_hash(c, t.a, inout seen) }
    if k == types.T_TUPLE {
        for x in types.elems(c.t, ty) {
            let y = eq_without_hash(c, x, inout seen)
            if y != NONE { return y }
        }
    }
    NONE
}

/// The type of template di applied to `args`, resolving its fields the first time
/// (memoized per instance).
fn inst_type(inout c: C, di: u32, args: List[u32], line: u32, col: u32) -> Result[u32, diag.Diag] {
    let d = c.t.defs[di as usize].copy()
    if !visible(c, d.md, d.public) {
        let path = c.p.mods[d.md as usize].path
        return Err(errh("E0801", line, col, q2("type `", kt(c, d.key), "` is private to module `", path, "`"), "mark it `pub` in its own file to use it from other modules"))
    }
    if args.len() as u32 != d.generic {
        return Err(err("E0111", line, col, q3("type `", kt(c, d.key), "` takes ", num(d.generic as u64), " type argument(s), but ", num(args.len() as u64), " were given")))
    }
    let mut inst = di.copy()
    let mut sb = no_subst()
    if d.generic > 0 {
        let lid = types.list(inout c.t, args)
        let found = types.find_inst(c.t, di, lid)
        if found != types.NOTY { return Ok(c.t.defs[found as usize].ty) }
        let tn = ndm(c, d.md, d.node)
        let gs = gparams(c, d.md, tn.c, tn.d)
        for i in 0..gs.len() { subst_set(inout sb, gs[i], args[i]) }
        let mut start = d.start.copy()
        if d.is_enum {
            start = c.t.variants.len() as u32
            for i in 0..d.len {
                let v = types.variant(c.t, d, i)
                c.t.variants.push(types.Variant(v.key, v.arity, 0, 0))
            }
        }
        inst = types.add_def(inout c.t, types.Def(d.key, d.md, d.public, d.node, d.is_enum, 0, 0, start, d.len, false, true, di, lid))
    } else {
        if d.filled { return Ok(d.ty) }
        let mut d2 = d.copy()
        d2.filled = true
        c.t.defs[di as usize] = d2
    }
    let saved_all = c.cur_all.copy()
    let saved_mod = c.cur_mod.copy()
    let saved_sub = c.tsubst.copy()
    c.cur_all = false
    c.cur_mod = d.md
    c.tsubst = sb
    let r = fill_type(inout c, inst)
    c.cur_all = saved_all
    c.cur_mod = saved_mod
    c.tsubst = saved_sub
    match r {
        Ok(_) => {}
        Err(e) => { return Err(in_file(c, e, d.md)) }
    }
    // by-value recursion would have infinite size
    let d3 = c.t.defs[inst as usize]
    let mut seen: Map[u32, bool] = Map.new()
    if d3.is_enum {
        for i in 0..d3.len {
            let v = types.variant(c.t, d3, i)
            for j in 0..v.flen {
                if reaches(c, types.field(c.t, v.fstart, j).ty, inst, inout seen) { return Err(recursive(c, d3)) }
            }
        }
    } else {
        for j in 0..d3.len {
            if reaches(c, types.field(c.t, d3.start, j).ty, inst, inout seen) { return Err(recursive(c, d3)) }
        }
    }
    Ok(d3.ty)
}

fn recursive(c: C, d: types.Def) -> diag.Diag {
    let n = ndm(c, d.md, d.node)
    errh("E0108", n.line, n.col, q("type `", ts(c, d.ty), "` contains itself and would have infinite size"), "use an index into a List, or Box[T], to express recursion")
}

fn reaches(c: C, ty: u32, target: u32, inout seen: Map[u32, bool]) -> bool {
    let t = types.get(c.t, ty)
    if t.kind == types.T_ARRAY { return reaches(c, t.a, target, inout seen) }
    if t.kind == types.T_TUPLE {
        for x in types.elems(c.t, ty) {
            if reaches(c, x, target, inout seen) { return true }
        }
        return false
    }
    if t.kind != types.T_ENUM && t.kind != types.T_RECORD { return false }
    if t.a == target { return true }
    if seen.contains(t.a) { return false }
    seen.insert(t.a, true)
    let d = c.t.defs[t.a as usize]
    if d.is_enum {
        for i in 0..d.len {
            let v = types.variant(c.t, d, i)
            for j in 0..v.flen {
                if reaches(c, types.field(c.t, v.fstart, j).ty, target, inout seen) { return true }
            }
        }
        return false
    }
    for j in 0..d.len {
        if reaches(c, types.field(c.t, d.start, j).ty, target, inout seen) { return true }
    }
    false
}

fn has_field(fs: List[types.Field], sym: u32) -> bool {
    for f in fs {
        if f.name == sym { return true }
    }
    false
}

/// Resolve the fields of definition di.
fn fill_type(inout c: C, di: u32) -> Result[bool, diag.Diag] {
    let d = c.t.defs[di as usize]
    let m = d.md.copy()
    let n = ndm(c, m, d.node)
    if !d.is_enum {
        if n.f == 0 { return Err(err("E0111", n.line, n.col, s("records need at least one field"))) }
        let mut fs: List[types.Field] = List.new()
        for i in 0..n.f {
            let fnode = ndm(c, m, atm(c, m, n.e, i))
            // a duplicate is reported and kept (lookups find the first)
            if has_field(fs, fnode.a) {
                let rd = in_file(c, err("E0107", fnode.line, fnode.col, q("duplicate field `", nm(c, fnode.a), "`")), m)
                record(inout c, rd)
            }
            let ty = item_ty(inout c, m, fnode.b)?
            fs.push(types.Field(fnode.a, ty, fnode.b, fnode.line, fnode.col))
        }
        let mut d2 = c.t.defs[di as usize].copy()
        d2.start = c.t.fields.len() as u32
        d2.len = fs.len() as u32
        for f in fs { c.t.fields.push(f) }
        c.t.defs[di as usize] = d2
        return Ok(true)
    }
    // enum: resolve every variant's fields, then store them contiguously
    let mut all: List[types.Field] = List.new()
    let mut lens: List[u32] = List.new()
    for i in 0..n.f {
        let vn = ndm(c, m, atm(c, m, n.e, i))
        let mut fs: List[types.Field] = List.new()
        for j in 0..vn.d {
            let vf = ndm(c, m, atm(c, m, vn.c, j))
            let mut fname = vf.a.copy()
            if vf.c == 0 {
                let digits = bytes.from_u64(vf.a as u64)
                fname = intern.intern(inout c.p.names, digits, 0, digits.len())
            }
            if has_field(fs, fname) {
                let rd = in_file(c, err("E0107", vn.line, vn.col, q("duplicate field `", nm(c, fname), "`")), m)
                record(inout c, rd)
            }
            let ty = item_ty(inout c, m, vf.b)?
            fs.push(types.Field(fname, ty, vf.b, vf.line, vf.col))
        }
        lens.push(fs.len() as u32)
        for f in fs { all.push(f) }
    }
    let mut at_f = c.t.fields.len() as u32
    for f in all { c.t.fields.push(f) }
    let mut d2 = c.t.defs[di as usize].copy()
    let mut payload = false
    for i in 0..d2.len {
        let mut v = c.t.variants[(d2.start + i) as usize].copy()
        v.fstart = at_f
        v.flen = lens[i as usize]
        at_f += v.flen
        if v.flen > 0 { payload = true }
        c.t.variants[(d2.start + i) as usize] = v
    }
    d2.payload = payload
    c.t.defs[di as usize] = d2
    Ok(true)
}

/// The type of a field or in a signature (type node tn of module m, the item's own): one
/// that doesn't resolve is recorded, naming m's file as inst_type and instantiate do, and is
/// the error type.
fn item_ty(inout c: C, m: u32, tn: u32) -> Result[u32, diag.Diag] {
    match resolve_ty(inout c, m, tn) {
        Ok(t) => Ok(t)
        Err(d) => {
            if fatal(d) { return Err(d) }
            let rd = in_file(c, d, m)
            record(inout c, rd)
            Ok(poison(inout c))
        }
    }
}

// ---- generic inference (unify_ast and friends), over type nodes of module m

/// Does type node tn mention a type parameter of `gs` that `sb` doesn't bind?
fn has_unbound(c: C, m: u32, tn: u32, sb: Subst, gs: List[u32]) -> bool {
    let n = ndm(c, m, tn)
    match n.kind {
        ast.TName => n.b == 0 && has_sym(gs, n.a) && subst_get(sb, n.a) == NONE
        ast.TArray => has_unbound(c, m, n.a, sb, gs)
        ast.TUnit => false
        _ => {
            for i in 0..n.d {
                if has_unbound(c, m, atm(c, m, n.c, i), sb, gs) { return true }
            }
            if n.kind == ast.TFn && n.g > 0 { return has_unbound(c, m, n.g - 1, sb, gs) }
            false
        }
    }
}

/// The type arguments of the heap type `t` named by symbol `sym`, or None if they differ.
fn heap_parts(c: C, sym: u32, t: types.Ty) -> Option[List[u32]] {
    let mut parts: List[u32] = List.new()
    if t.kind == types.T_LIST && sym == c.w.list {
        parts.push(t.a)
        return Some(parts)
    }
    if t.kind == types.T_BOX && sym == c.w.boxs {
        parts.push(t.a)
        return Some(parts)
    }
    if t.kind == types.T_MAP && sym == c.w.map {
        parts.push(t.a)
        parts.push(t.b)
        return Some(parts)
    }
    if (t.kind == types.T_TASK && sym == c.w.heap[3]) || (t.kind == types.T_MUTEX && sym == c.w.heap[4]) || (t.kind == types.T_CHAN && sym == c.w.heap[5]) {
        parts.push(t.a)
        return Some(parts)
    }
    None
}

/// Whether the type name n (not a type parameter) of module m names `actual`: a built-in
/// type, or a non-generic record or enum. A name that names nothing concrete here (`Self`, an
/// unknown name, a generic type without arguments: reported elsewhere) fits anything
/// (docs/compiler.md, "C8.16").
fn name_fits(c: C, m: u32, n: ast.Node, actual: u32) -> bool {
    if n.b == 0 && n.a == intern.S_SELF_TYPE { return true }
    let k = resolve.name_key(c.p, m, n.a, n.b, n.line, n.col)
    let ik = int_kind(c, k)
    if ik != NONE { return actual == ik }
    if is_root(k, c.w.s_bool) { return actual == types.BOOL }
    if is_root(k, c.w.s_str) { return actual == types.STR }
    if is_root(k, c.w.s_string) { return actual == types.STRING }
    let di = mget(c.tmpl, k)
    if di == NONE || c.t.defs[di as usize].generic > 0 { return true }
    let t = types.get(c.t, actual)
    if t.kind != types.T_ENUM && t.kind != types.T_RECORD { return false }
    c.t.defs[types.def_of(c.t, actual).tmpl as usize].key == k
}

/// Bind the type parameters `gs` in type node tn by matching it against `actual`. False on
/// a conflict. A name that isn't a type parameter must name `actual` (name_fits).
fn unify_ast(c: C, m: u32, tn: u32, actual: u32, inout sb: Subst, gs: List[u32]) -> bool {
    // an error type fits anything and binds nothing
    if poisoned(c, actual) { return true }
    let n = ndm(c, m, tn)
    let t = types.get(c.t, actual)
    match n.kind {
        ast.TName => {
            if n.b == 0 && has_sym(gs, n.a) {
                let bound = subst_get(sb, n.a)
                if bound != NONE { return bound == actual }
                subst_set(inout sb, n.a, actual)
                return true
            }
            let ai = alias_of(c, m, n)
            if ai != NONE { return unify_alias(c, m, n, ai, actual, inout sb, gs) }
            name_fits(c, m, n, actual)
        }
        ast.TGeneric => {
            let ai = alias_of(c, m, n)
            if ai != NONE { return unify_alias(c, m, n, ai, actual, inout sb, gs) }
            let mut parts: List[u32] = List.new()
            if n.b == 0 && has_sym(c.w.heap, n.a) {
                match heap_parts(c, n.a, t) {
                    Some(ps) => { parts = ps }
                    None => { return false }
                }
            } else {
                if t.kind != types.T_ENUM && t.kind != types.T_RECORD { return false }
                let d = types.def_of(c.t, actual)
                let k = resolve.name_key(c.p, m, n.a, n.b, n.line, n.col)
                if c.t.defs[d.tmpl as usize].key != k { return false }
                if d.args != types.NOTY { parts = types.list_items(c.t, d.args) }
            }
            if parts.len() as u32 != n.d { return false }
            for i in 0..n.d {
                if !unify_ast(c, m, atm(c, m, n.c, i), parts[i as usize], inout sb, gs) { return false }
            }
            true
        }
        ast.TArray => t.kind == types.T_ARRAY && t.b == n.b && unify_ast(c, m, n.a, t.a, inout sb, gs)
        ast.TTuple => {
            if t.kind != types.T_TUPLE || t.b != n.d { return false }
            let es = types.elems(c.t, actual)
            for i in 0..n.d {
                if !unify_ast(c, m, atm(c, m, n.c, i), es[i as usize], inout sb, gs) { return false }
            }
            true
        }
        ast.TFn => {
            if t.kind != types.T_FN { return false }
            let ps = types.elems(c.t, actual)
            if ps.len() as u32 != n.d { return false }
            for i in 0..n.d {
                if !unify_ast(c, m, atm(c, m, n.c, i), ps[i as usize], inout sb, gs) { return false }
            }
            if n.g > 0 { return unify_ast(c, m, n.g - 1, t.b, inout sb, gs) }
            t.b == types.UNIT
        }
        _ => actual == types.UNIT
    }
}

/// A type node as messages spell it (show_ast: module items mangled, type
/// parameters `gens` as written).
fn show_ast(c: C, m: u32, tn: u32, gens: List[u32]) -> List[u8] {
    let n = ndm(c, m, tn)
    let mut out: List[u8] = List.new()
    match n.kind {
        ast.TName => { bytes.append(inout out, ty_name(c, m, n, gens)) }
        ast.TGeneric => {
            bytes.append(inout out, ty_name(c, m, n, gens))
            out.push(91)
            show_list(c, m, n.c, n.d, gens, inout out)
            out.push(93)
        }
        ast.TArray => {
            out.push(91)
            bytes.append(inout out, show_ast(c, m, n.a, gens))
            bytes.append(inout out, s("; "))
            bytes.append(inout out, num(n.b as u64))
            out.push(93)
        }
        ast.TTuple => {
            out.push(40)
            show_list(c, m, n.c, n.d, gens, inout out)
            out.push(41)
        }
        ast.TFn => {
            bytes.append(inout out, s("fn("))
            show_list(c, m, n.c, n.d, gens, inout out)
            out.push(41)
            if n.g > 0 {
                bytes.append(inout out, s(" -> "))
                bytes.append(inout out, show_ast(c, m, n.g - 1, gens))
            }
        }
        _ => { bytes.append(inout out, s("()")) }
    }
    out
}

fn show_list(c: C, m: u32, start: u32, len: u32, gens: List[u32], inout out: List[u8]) {
    for i in 0..len {
        if i > 0 { bytes.append(inout out, s(", ")) }
        bytes.append(inout out, show_ast(c, m, atm(c, m, start, i), gens))
    }
}

fn ty_name(c: C, m: u32, n: ast.Node, gens: List[u32]) -> List[u8] {
    if n.b == 0 && has_sym(gens, n.a) { return nm(c, n.a) }
    kt(c, resolve.name_key(c.p, m, n.a, n.b, n.line, n.col))
}

/// `text` with every `Self` replaced by `with`, textually (also inside `MySelf`; a C8 candidate).
fn replace_self(text: List[u8], with: List[u8]) -> List[u8] {
    let mut out: List[u8] = List.new()
    let mut i: usize = 0
    while i < text.len() {
        if i + 4 <= text.len() && text[i] == 83 && text[i + 1] == 101 && text[i + 2] == 108 && text[i + 3] == 102 {
            bytes.append(inout out, with)
            i += 4
        } else {
            out.push(text[i])
            i += 1
        }
    }
    out
}

/// The method-table head of an impl target.
fn head_key(c: C, m: u32, tn: u32, gens: List[u32]) -> u64 {
    let n = ndm(c, m, tn)
    if n.kind == ast.TName || n.kind == ast.TGeneric {
        if n.b == 0 && has_sym(gens, n.a) { return resolve.key(0, n.a) }
        return resolve.name_key(c.p, m, n.a, n.b, n.line, n.col)
    }
    if n.kind == ast.TArray { return H_ARRAY }
    if n.kind == ast.TFn { return H_FN }
    H_UNIT
}

/// The method-table head of a type.
fn head_of(c: C, ty: u32) -> u64 {
    let t = types.get(c.t, ty)
    match t.kind {
        0 => resolve.key(0, c.w.ints[t.a as usize])
        1 => resolve.key(0, c.w.s_bool)
        2 => resolve.key(0, c.w.s_str)
        3 => H_UNIT
        4 => H_NEVER
        5 => c.t.defs[c.t.defs[t.a as usize].tmpl as usize].key
        6 => c.t.defs[c.t.defs[t.a as usize].tmpl as usize].key
        7 => H_ARRAY
        8 => H_UNIT
        9 => resolve.key(0, c.w.s_string)
        10 => resolve.key(0, c.w.list)
        11 => resolve.key(0, c.w.map)
        12 => resolve.key(0, c.w.boxs)
        14 => resolve.key(0, c.w.heap[3])
        15 => resolve.key(0, c.w.heap[4])
        16 => resolve.key(0, c.w.heap[5])
        _ => H_FN
    }
}

fn head_text(c: C, h: u64) -> List[u8] {
    if h == H_ARRAY { return s("[]") }
    if h == H_UNIT { return s("()") }
    if h == H_NEVER { return s("!") }
    if h == H_FN { return s("fn") }
    kt(c, h)
}

/// Does `ty` implement trait `tk`? (yes when the target of some impl unifies with it)
fn implements(c: C, tk: u64, ty: u32) -> bool {
    // a language trait: derived, or the type's own impl ("Operation traits")
    let tr = lang_of_key(c, tk)
    if tr != NONE { return has_trait(c, tr, ty) }
    if types.kind(c.t, ty) == types.T_PARAM { return param_has(c, ty, tk) }
    for im in c.timpls {
        if im.tkey != tk { continue }
        let n = ndm(c, im.md, im.node)
        let gs = gparams(c, im.md, n.c, n.d)
        let mut sb = no_subst()
        if unify_ast(c, im.md, n.b, ty, inout sb, gs) { return true }
    }
    false
}

// ---- Operation traits (docs/compiler.md, "C8.4: operation traits")
//
// The prelude's Copy, Eq, Ord, Hash, Show, Iter and Drop are the operations the language
// performs on values: `.copy()`, `==`/`!=`, `<` ... and `compare`, Map keys and `hash`,
// `print` and `show`/`to_string`, `for x in e`, cleanup. A type has one when its own package
// implements it (a "custom" impl; `heads` has a bit per trait for each impl target's head,
// collected before any type is resolved), or, for every type but Iter and Drop, when all its
// parts have it (derived; `lacks` decides, and names the part that lacks it). Derived
// operations are lowering's glue, as before (so they cost what they cost); the method
// instance of a custom impl is recorded in ir.Ir.impls for every concrete type it applies to
// (`scan_impls`), and the glue calls it there, also inside derived glue (a List of a type
// with its own `==`). A trait the entry module defines with a language trait's name shadows
// that trait in the program's names (the language goes on using the prelude's). Only the
// package that defines a type may implement a language trait for it (E0604).

const TR_COPY: u32 = 0
const TR_EQ: u32 = 1
const TR_ORD: u32 = 2
const TR_HASH: u32 = 3
const TR_SHOW: u32 = 4
const TR_ITER: u32 = 5
const TR_DROP: u32 = 6
const NTR: u32 = 7

/// `names`/`meths`: each trait's symbol and its method's (copy, eq, compare, hash, show,
/// next, drop); `shadow`: the entry module defines a trait of that name; `heads`: per method
/// head (head_key), the bits (bit(TR_*)) of the traits some impl implements for it;
/// `registered`: impls are registered (pass 5), so an impl's target and bounds are checked;
/// `ordering`: the prelude's Ordering (a def; NONE until seen); `scanned`: the defs scan_impls
/// has looked at. `abs`: checking generic bodies against their bounds ("Bounds of generic
/// code"), where `pty`, `pm`, `pn` are the type parameters (T_PARAM types) with their
/// module and GParam node.
type Lang = {
    names: List[u32], meths: List[u32], shadow: List[bool], heads: Map[u64, u32], registered: bool,
    ordering: u32, scanned: u32, to_string: u32, s_ordering: u32,
    abs: bool, pty: List[u32], pm: List[u32], pn: List[u32],
}

fn new_lang(inout names: intern.Interner) -> Lang {
    let mut ns: List[u32] = List.new()
    for w in ["Copy", "Eq", "Ord", "Hash", "Show", "Iter", "Drop"] { ns.push(sym(inout names, w)) }
    let mut ms: List[u32] = List.new()
    for w in ["copy", "eq", "compare", "hash", "show", "next", "drop"] { ms.push(sym(inout names, w)) }
    let mut sh: List[bool] = List.new()
    for i in 0..NTR { sh.push(false) }
    Lang(ns, ms, sh, Map.new(), false, NONE, 0, sym(inout names, "to_string"), sym(inout names, "Ordering"),
        false, List.new(), List.new(), List.new())
}

fn bit(i: u32) -> u32 {
    let mut b: u32 = 1
    for k in 0..i { b = b * 2 }
    b
}

fn has_bit(bits: u32, i: u32) -> bool { (bits / bit(i)) % 2 == 1 }

fn trait_name(c: C, tr: u32) -> List[u8] { nm(c, c.lt.names[tr as usize]) }

/// The language trait trait key k names (NONE: another trait, or a shadowed one).
fn lang_of_key(c: C, k: u64) -> u32 {
    for i in 0..NTR {
        if k == resolve.key(0, c.lt.names[i as usize]) && !c.lt.shadow[i as usize] { return i }
    }
    NONE
}

/// The language trait whose method is `name` (a derived one can be called as a method), or
/// NTR for `to_string`, or NONE.
fn lang_method(c: C, name: u32) -> u32 {
    if name == c.lt.to_string { return NTR }
    for i in 0..NTR {
        if name == c.lt.meths[i as usize] { return i }
    }
    NONE
}

/// Which language traits the entry module shadows, and which heads have impls of each (before
/// any type is resolved, so a Map key type with its own Hash is known while fields resolve).
fn lang_prepass(inout c: C, its: List[Item]) {
    for it in its {
        let n = ndm(c, it.m, it.node)
        if n.kind != ast.ITrait || it.m == c.p.prelude { continue }
        let k = resolve.item_key(c.p, it.m, n.a)
        for i in 0..NTR {
            if k == resolve.key(0, c.lt.names[i as usize]) { c.lt.shadow[i as usize] = true }
        }
    }
    for it in its {
        let n = ndm(c, it.m, it.node)
        if n.kind != ast.IImpl || n.a == 0 { continue }
        let tn = ndm(c, it.m, n.a - 1)
        let tr = lang_of_key(c, resolve.name_key(c.p, it.m, tn.a, tn.b, tn.line, tn.col))
        if tr == NONE { continue }
        let h = head_key(c, it.m, n.b, gparams(c, it.m, n.c, n.d))
        let mut bits: u32 = 0
        let old = mget(c.lt.heads, h)
        if old != NONE { bits = old }
        if !has_bit(bits, tr) { bits += bit(tr) }
        c.lt.heads.insert(h, bits)
    }
}

// ---- Error conversion (docs/compiler.md, "C8.21")
//
// The prelude's `trait From { fn from(value: Source) -> Self }` is implemented as `impl
// From[E1] for E2 { fn from(value: E1) -> E2 { ... } }`, any number of times per target
// (one per source type), only in the target's package (the orphan rule, E0604). Its `from`
// is reached two ways: `E2.from(x)` (the impl is chosen by x's type) and `?`, which in a
// function returning Result[_, E2] turns Err(e: E1) into Err(E2.from(e)). `from` declares
// no capabilities, since `?` converts wherever it is written.

/// Check and register `impl From[...] for ...` (module m, node id).
fn register_from(inout c: C, m: u32, id: u32, igens: List[u32], target: List[u8], inout concrete: List[u32]) -> Result[bool, diag.Diag] {
    let im = ndm(c, m, id)
    let tn = ndm(c, m, im.a - 1)
    if tn.kind != ast.TGeneric || tn.d != 1 {
        record(inout c, errh("E0603", tn.line, tn.col, s("`From` takes the type it converts from: `impl From[Source] for Target`"), "e.g. `impl From[stream.Error] for AppError { fn from(value: stream.Error) -> AppError { ... } }`"))
        return Ok(true)
    }
    let snode = atm(c, m, tn.c, 0)
    let source = show_ast(c, m, snode, igens)
    // the orphan rule: the target's own package
    let h = head_key(c, m, im.b, igens)
    let di = mget(c.tmpl, h)
    let tgt = ndm(c, m, im.b)
    let named = (tgt.kind == ast.TName || tgt.kind == ast.TGeneric) && !(tgt.b == 0 && has_sym(igens, tgt.a))
    let mut ok = false
    if named && di != NONE {
        let dm = c.t.defs[di as usize].md
        ok = dm != c.p.prelude && c.p.mods[dm as usize].pkg == c.p.mods[m as usize].pkg
    }
    if !ok {
        let msg = q2("only the package that defines `", target, "` can implement `From` for it", List.new(), "")
        record(inout c, errh("E0604", im.line, im.col, msg, "convert in a function of your own, or wrap the type in a record of your own"))
        return Ok(true)
    }
    // exactly `fn from(value: Source) -> Target` (or `-> Self`)
    let mut fi = NONE
    for i in 0..im.f {
        let mid = atm(c, m, im.e, i)
        let mn = ndm(c, m, mid)
        if !is_word(c, mn.a, "from") {
            let rd = err("E0602", mn.line, mn.col, q("trait `From` has no method `", nm(c, mn.a), "`"))
            record(inout c, rd)
            continue
        }
        if fi != NONE {
            record(inout c, err("E0107", mn.line, mn.col, s("method `from` is defined twice in this impl")))
            continue
        }
        let mut fits = mn.f == 1 && mn.g > 0 && mn.d == 0
        if fits {
            let pn = ndm(c, m, atm(c, m, mn.e, 0))
            let rt = show_ast(c, m, mn.g - 1, igens)
            fits = pn.c == 0 && !is_word(c, pn.a, "self") && bytes.eq(show_ast(c, m, pn.b, igens), source) && (bytes.eq(rt, target) || bytes.eq(rt, s("Self")))
        }
        if !fits {
            record(inout c, errh("E0602", mn.line, mn.col, q2("method `from` doesn't match the signature in trait `From`: it is `fn from(value: ", source, ") -> ", target, "`"), "a conversion takes the value to convert and returns the target"))
            continue
        }
        if mn.j > 0 {
            record(inout c, errh("E0602", mn.line, mn.col, s("`from` can't declare capabilities"), "`?` converts errors wherever it is written; do the work that needs a capability before returning the error"))
            continue
        }
        fi = c.fdefs.len() as u32
        c.fdefs.push(FnDef(resolve.key(0, mn.a), m, mid, true, false, ast.has(mn.b, ast.FN_UNSAFE), NONE, id))
        if im.d == 0 && mn.h > 0 { concrete.push(fi) }
    }
    if fi == NONE {
        if im.f == 0 { record(inout c, err("E0602", im.line, im.col, s("impl of `From` is missing method `from`"))) }
        return Ok(true)
    }
    for x in c.froms {
        if bytes.eq(x.target, target) && bytes.eq(x.source, source) {
            record(inout c, err("E0107", im.line, im.col, q2("`From[", source, "]` is already implemented for `", target, "`")))
            return Ok(true)
        }
    }
    c.froms.push(FromImpl(m, id, fi, target, source))
    Ok(true)
}

/// A `From` impl (of target head `head`, 0: any) that converts `source` into `target` (NONE:
/// unknown):
/// its index in c.froms and the substitution of its type parameters (and Self).
type FromHit = { ix: u32, sb: Subst }

fn find_from(c: C, head: u64, target: u32, source: u32) -> FromHit {
    for i in 0..c.froms.len() {
        let x = c.froms[i]
        let n = ndm(c, x.md, x.node)
        let gs = gparams(c, x.md, n.c, n.d)
        if head != 0 && head_key(c, x.md, n.b, gs) != head { continue }
        let tn = ndm(c, x.md, n.a - 1)
        let mut sb = no_subst()
        if source != NONE && !unify_ast(c, x.md, atm(c, x.md, tn.c, 0), source, inout sb, gs) { continue }
        if target != NONE && !unify_ast(c, x.md, n.b, target, inout sb, gs) { continue }
        if !impl_bounds_hold(c, x.md, n, sb) { continue }
        return FromHit(i as u32, sb)
    }
    FromHit(NONE, no_subst())
}

/// The instance of hit's `from`, its target type resolved (the impl's type parameters must
/// all be bound by the source and target).
fn from_instance(inout c: C, hit: FromHit, line: u32, col: u32) -> Result[u32, diag.Diag] {
    let x = c.froms[hit.ix as usize].copy()
    let n = ndm(c, x.md, x.node)
    let gs = gparams(c, x.md, n.c, n.d)
    for g in gs {
        if subst_get(hit.sb, g) == NONE {
            return Err(errh("E0409", line, col, q("cannot infer the type `From` converts into for `", x.target, "`"), "add a type annotation to the binding that receives the result"))
        }
    }
    let ty = resolve_with(inout c, x.md, n.b, hit.sb)?
    let mut sb = hit.sb.copy()
    subst_set(inout sb, intern.S_SELF_TYPE, ty)
    instantiate(inout c, x.fd, sb)
}

/// Whether some `From` impl targets head h.
fn has_from(c: C, h: u64) -> bool {
    for x in c.froms {
        let n = ndm(c, x.md, x.node)
        if head_key(c, x.md, n.b, gparams(c, x.md, n.c, n.d)) == h { return true }
    }
    false
}

/// `Target.from(x)`: the `From` impl for x's type (and the expected type, if any).
fn from_call(inout c: C, n: ast.Node, head: u64, exp: u32) -> Result[V, diag.Diag] {
    let label = label_of(c, kt(c, head), n.b)
    if n.d != 1 { return Err(err("E0405", n.line, n.col, q2("`", label, "` takes 1 argument(s), but ", num(n.d as u64), " were given"))) }
    let a = nd(c, at(c, n.c, 0))
    let x = nd(c, a.a)
    if a.b == 1 { return Err(err("E0304", x.line, x.col, s("`inout` is not allowed here"))) }
    let v = expr(inout c, a.a, NONE)?
    if poisoned(c, v.ty) { return Ok(poison_v(inout c)) }
    let hit = find_from(c, head, exp, v.ty)
    if hit.ix == NONE {
        return Err(errh("E0401", x.line, x.col, q2("`", kt(c, head), "` has no `From` conversion from ", ts(c, v.ty), ""), "implement `From[...]` for it with that source type"))
    }
    let ii = from_instance(inout c, hit, n.line, n.col)?
    let inst = c.insts[ii as usize].copy()
    let st = ir.list(inout c.ir, one(v.op))
    Ok(v_of(inst.ret, emit_val(inout c, ir.S_CALL, inst.ir, st, 1, inst.ret, inst.ret, n.line)))
}

/// The impl (index in timpls) of language trait tr that applies to record or enum ty: its
/// target has ty's head and unifies with it, and its type parameters meet their bounds.
fn custom_impl(c: C, tr: u32, ty: u32) -> u32 {
    if c.lt.shadow[tr as usize] { return NONE }
    let tk = resolve.key(0, c.lt.names[tr as usize])
    let h = head_of(c, ty)
    for i in 0..c.timpls.len() {
        let im = c.timpls[i]
        if im.tkey != tk { continue }
        let n = ndm(c, im.md, im.node)
        let gs = gparams(c, im.md, n.c, n.d)
        if head_key(c, im.md, n.b, gs) != h { continue }
        let mut sb = no_subst()
        if !unify_ast(c, im.md, n.b, ty, inout sb, gs) { continue }
        if impl_bounds_hold(c, im.md, n, sb) { return i as u32 }
    }
    NONE
}

/// Whether the type parameters of impl node n (module m), bound by sb, meet their bounds.
fn impl_bounds_hold(c: C, m: u32, n: ast.Node, sb: Subst) -> bool {
    for i in 0..n.d {
        let g = ndm(c, m, atm(c, m, n.c, i))
        let ty = subst_get(sb, g.a)
        if ty == NONE { continue }
        for j in 0..g.d {
            let b = ndm(c, m, atm(c, m, g.c, j))
            if !implements(c, resolve.name_key(c.p, m, b.a, b.b, b.line, b.col), ty) { return false }
        }
    }
    true
}

/// Whether record or enum ty has its own impl of language trait tr. Before impls are
/// registered, an impl for its head is enough.
fn custom(c: C, tr: u32, ty: u32) -> bool {
    let bits = mget(c.lt.heads, head_of(c, ty))
    if bits == NONE || !has_bit(bits, tr) { return false }
    if !c.lt.registered { return true }
    custom_impl(c, tr, ty) != NONE
}

/// Whether record ty has a Drop impl (they are for every instance, so the head says it).
fn has_drop(c: C, ty: u32) -> bool {
    if types.kind(c.t, ty) != types.T_RECORD { return false }
    let bits = mget(c.lt.heads, head_of(c, ty))
    bits != NONE && has_bit(bits, TR_DROP)
}

/// Whether ty has language trait tr.
fn has_trait(c: C, tr: u32, ty: u32) -> bool {
    let mut seen: Map[u32, bool] = Map.new()
    lacks(c, tr, ty, inout seen) == NONE
}

/// The part of ty that lacks language trait tr: ty itself, or the innermost part that keeps
/// it from being derived; NONE when ty has it. (A type met again while deciding, through a
/// List or Box, has it as far as that part is concerned.)
fn lacks(c: C, tr: u32, ty: u32, inout seen: Map[u32, bool]) -> u32 {
    if ty == NONE || poisoned(c, ty) || seen.contains(ty) { return NONE }
    let t = types.get(c.t, ty)
    let k = t.kind
    // a type parameter has what its bounds say (Ord and Hash promise Eq too)
    if k == types.T_PARAM {
        if param_has(c, ty, resolve.key(0, c.lt.names[tr as usize])) { return NONE }
        if tr == TR_EQ && (param_has(c, ty, resolve.key(0, c.lt.names[TR_ORD as usize])) || param_has(c, ty, resolve.key(0, c.lt.names[TR_HASH as usize]))) { return NONE }
        return ty
    }
    if k == types.T_RECORD || k == types.T_ENUM {
        if custom(c, tr, ty) { return NONE }
        if tr == TR_ITER || tr == TR_DROP { return ty }
        seen.insert(ty, true)
        let d = types.def_of(c.t, ty)
        if d.is_enum {
            for i in 0..d.len {
                let v = types.variant(c.t, d, i)
                for j in 0..v.flen {
                    let x = lacks(c, tr, types.field(c.t, v.fstart, j).ty, inout seen)
                    if x != NONE { return x }
                }
            }
            return NONE
        }
        for j in 0..d.len {
            let x = lacks(c, tr, types.field(c.t, d.start, j).ty, inout seen)
            if x != NONE { return x }
        }
        return NONE
    }
    if tr == TR_DROP { return ty }
    if tr == TR_ITER {
        if k == types.T_LIST || k == types.T_ARRAY { return NONE }
        return ty
    }
    // (`()` too, as a part: `Ok(()) == r`, `print(Ok(()))`; comparing two ()s is E0401)
    if k == types.T_INT || k == types.T_BOOL || k == types.T_STR || k == types.T_STRING || k == types.T_UNIT { return NONE }
    if k == types.T_ARRAY || k == types.T_LIST || k == types.T_BOX { return lacks(c, tr, t.a, inout seen) }
    if k == types.T_TUPLE {
        for x in types.elems(c.t, ty) {
            let y = lacks(c, tr, x, inout seen)
            if y != NONE { return y }
        }
        return NONE
    }
    if k == types.T_MAP {
        // Maps have no order and no hash (their slots' order is not part of their value)
        if tr == TR_ORD || tr == TR_HASH { return ty }
        let x = lacks(c, tr, t.a, inout seen)
        if x != NONE { return x }
        return lacks(c, tr, t.b, inout seen)
    }
    // a fn value copies its environment; a Mutex copies its contents into a new Mutex
    if k == types.T_FN && tr == TR_COPY { return NONE }
    if k == types.T_MUTEX && tr == TR_COPY { return lacks(c, tr, t.a, inout seen) }
    // !, Task and Chan have none; fn values and Mutexes only Copy
    ty
}

/// The error when `what` needs language trait tr of ty, which it lacks (`part`: lacks' answer).
fn lack_msg(c: C, what: List[u8], tr: u32, ty: u32, part: u32) -> List[u8] {
    let mut m = q2("", what, " needs `", trait_name(c, tr), "`, which ")
    bytes.append(inout m, ts(c, ty))
    bytes.append(inout m, s(" doesn't implement"))
    if part != ty && part != NONE { bytes.append(inout m, q(" (its part ", ts(c, part), " doesn't)")) }
    m
}

/// The help for a type that lacks trait tr because of `part`.
fn lack_help(c: C, tr: u32, part: u32) -> str {
    let k = types.kind(c.t, part)
    if k == types.T_TASK || k == types.T_CHAN {
        if tr == TR_COPY { return "a running thread can't be cloned and a copied queue has no clear meaning; share the handle instead" }
        return "Task, Mutex and Chan values are shared handles: they have no equality, order, hash or text"
    }
    if k == types.T_MUTEX { return "Task, Mutex and Chan values are shared handles: they have no equality, order, hash or text" }
    if k == types.T_FN { return "fn values have no equality, order, hash or text" }
    ""
}

fn lack_err(c: C, code: str, line: u32, col: u32, what: List[u8], tr: u32, ty: u32) -> diag.Diag {
    match param_lack(c, line, col, what, tr, ty) {
        Some(d) => { return d }
        None => {}
    }
    let mut seen: Map[u32, bool] = Map.new()
    let part = lacks(c, tr, ty, inout seen)
    if part == NONE { return err(code, line, col, lack_msg(c, what, tr, ty, part)) }
    let h = lack_help(c, tr, part)
    if s(h).len() == 0 { return err(code, line, col, lack_msg(c, what, tr, ty, part)) }
    errh(code, line, col, lack_msg(c, what, tr, ty, part), h)
}

/// The type of the prelude's Ordering.
fn ordering_ty(inout c: C, line: u32, col: u32) -> Result[u32, diag.Diag] {
    if c.lt.ordering == NONE { return Err(unsup(line, col, "a prelude without `Ordering`")) }
    let od = c.lt.ordering.copy()
    inst_type(inout c, od, List.new(), line, col)
}

/// The method instance of impl ix (timpls) of language trait tr for type ty, recorded for
/// lowering in ir.Ir.impls.
fn impl_instance(inout c: C, tr: u32, ix: u32, ty: u32) -> Result[u32, diag.Diag] {
    let im = c.timpls[ix as usize]
    let n = ndm(c, im.md, im.node)
    let gs = gparams(c, im.md, n.c, n.d)
    let mut fd = NONE
    for m in c.meths {
        let f = c.fdefs[m.fd as usize]
        if f.inode == im.node && f.md == im.md && m.name == c.lt.meths[tr as usize] { fd = m.fd }
    }
    if fd == NONE { return Ok(NONE) }
    let mut sb = no_subst()
    unify_ast(c, im.md, n.b, ty, inout sb, gs)
    subst_set(inout sb, intern.S_SELF_TYPE, ty)
    let ii = instantiate(inout c, fd, sb)?
    let key = (tr as u64) * 4294967296 + ty as u64
    c.ir.impls.insert(key, c.insts[ii as usize].ir)
    Ok(ii)
}

/// Instantiate the language-trait impls of every concrete record and enum that has one, so
/// lowering's glue can call them; again for the types and bodies that brings in.
fn scan_impls(inout c: C) {
    while (c.lt.scanned as usize) < c.t.defs.len() {
        let d = c.t.defs[c.lt.scanned as usize].copy()
        c.lt.scanned += 1
        if d.generic > 0 || !d.filled || poisoned(c, d.ty) { continue }
        let bits = mget(c.lt.heads, head_of(c, d.ty))
        if bits == NONE { continue }
        for tr in 0..NTR {
            if !has_bit(bits, tr) { continue }
            let ix = custom_impl(c, tr, d.ty)
            if ix == NONE { continue }
            match impl_instance(inout c, tr, ix, d.ty) {
                Ok(_) => {}
                Err(e) => record(inout c, e)
            }
        }
    }
}

/// Check impl node im (module m) of language trait tr: the orphan rule (E0604) and what
/// Drop, Ord and Hash need (E0606, E0601). False: it is left out (its methods aren't
/// registered).
fn check_lang_impl(inout c: C, m: u32, im: ast.Node, tr: u32, igens: List[u32]) -> bool {
    let tn = ndm(c, m, im.b)
    let tname = show_ast(c, m, im.b, igens)
    let h = head_key(c, m, im.b, igens)
    let di = mget(c.tmpl, h)
    let mut owner = s("the language core")
    let mut ok = false
    let named = tn.kind == ast.TName || tn.kind == ast.TGeneric
    if named && tn.b == 0 && has_sym(igens, tn.a) {
        owner = s("no package: a type parameter stands for every type")
    } else if named && di != NONE {
        let dm = c.t.defs[di as usize].md
        let dpk = c.p.mods[dm as usize].pkg
        if dm != c.p.prelude && dpk == c.p.mods[m as usize].pkg { ok = true }
        if dpk != resolve.NOPKG {
            owner = q("package `", c.p.pkgs[dpk as usize].name, "`")
        } else {
            owner = q("`", c.p.mods[dm as usize].path, "`, which is in no package")
        }
        if dm == c.p.prelude { owner = s("the language core") }
    }
    if !ok {
        let msg = q3("only the package that defines `", tname, "` can implement `", trait_name(c, tr), "` for it (it is defined by ", owner, ")")
        record(inout c, errh("E0604", im.line, im.col, msg, "implement the trait in the type's own package, or wrap the type in a record of your own"))
        return false
    }
    let d = c.t.defs[di as usize]
    if tr == TR_DROP {
        // a Drop impl is for a record, for each of its instances: `impl[T] Drop for R[T]`
        let mut whole = !d.is_enum && tn.d == im.d
        if tn.kind == ast.TGeneric {
            for i in 0..tn.d {
                let a = ndm(c, m, atm(c, m, tn.c, i))
                if !(a.kind == ast.TName && a.b == 0 && i < igens.len() as u32 && a.a == igens[i as usize]) { whole = false }
            }
        }
        for i in 0..im.d {
            if ndm(c, m, atm(c, m, im.c, i)).d > 0 { whole = false }
        }
        if !whole {
            record(inout c, errh("E0606", im.line, im.col, q("`Drop` can only be implemented for a record, for all its instances: `impl Drop for ", tname, "` doesn't qualify"), "write `impl[T] Drop for R[T]` for a generic record; an enum that needs cleanup can hold a record that has it"))
            return false
        }
        for i in 0..im.f {
            let mn = ndm(c, m, atm(c, m, im.e, i))
            if mn.a == c.lt.meths[TR_DROP as usize] && mn.j > 0 {
                record(inout c, errh("E0606", mn.line, mn.col, s("`drop` can't declare capabilities: it runs wherever the value's last holder goes"), "do the work that needs a capability in a method the program calls before the value goes"))
                return false
            }
        }
    }
    if (tr == TR_ORD || tr == TR_HASH) && im.d == 0 {
        // `Ord` and `Hash` need `Eq` (derived, or its own)
        let ty = d.ty
        if d.generic == 0 && d.filled && !has_trait(c, TR_EQ, ty) {
            let rd = err("E0601", im.line, im.col, q2("type ", ts(c, ty), " doesn't implement trait `Eq` (required by `", trait_name(c, tr), "`)"))
            record(inout c, rd)
            return false
        }
    }
    true
}

// ---- Bounds of generic code (docs/compiler.md, "C8.4: operation traits")
//
// A generic body may use an operation on a type parameter only when the parameter's bounds
// promise it (`T: Eq` for `==` on T). Instances are checked with concrete types, which
// can't tell a T from the type it stands for, so after every body is checked each generic
// declaration that has an instance is checked once more with its type parameters as
// T_PARAM types, which have only what their bounds say (`abstract_bodies`). That pass
// throws its work away (the checker's state is put back) and keeps only E0605, the missing
// bound, with a fix that adds it; everything else it would find, the instances found or
// will find with real types.

/// The index of type parameter type ty in the registry (NONE).
fn param_ix(c: C, ty: u32) -> u32 {
    for i in 0..c.lt.pty.len() {
        if c.lt.pty[i] == ty { return i as u32 }
    }
    NONE
}

/// Whether type parameter ty has trait key tk among its bounds.
fn param_has(c: C, ty: u32, tk: u64) -> bool {
    let i = param_ix(c, ty)
    if i == NONE { return false }
    let m = c.lt.pm[i as usize]
    let g = ndm(c, m, c.lt.pn[i as usize])
    for j in 0..g.d {
        let b = ndm(c, m, atm(c, m, g.c, j))
        if resolve.name_key(c.p, m, b.a, b.b, b.line, b.col) == tk { return true }
    }
    false
}

/// The names of language traits `trs`.
/// [TR_ITER] (for_each has a local named `one`).
fn iter_only() -> List[u32] {
    let mut out: List[u32] = List.new()
    out.push(TR_ITER)
    out
}

fn trait_names(c: C, trs: List[u32]) -> List[List[u8]] {
    let mut out: List[List[u8]] = List.new()
    for tr in trs { out.push(trait_name(c, tr)) }
    out
}

/// E0605: `what` needs type parameter ty to have the traits named `trs`; the fix adds them
/// to its bounds.
fn bound_err(c: C, line: u32, col: u32, what: List[u8], trs: List[List[u8]], ty: u32) -> diag.Diag {
    let name = nm(c, types.get(c.t, ty).a)
    let mut bounds: List[u8] = List.new()
    for i in 0..trs.len() {
        if i > 0 { bytes.append(inout bounds, s(" + ")) }
        bytes.append(inout bounds, trs[i])
    }
    let mut want = name.copy()
    bytes.append(inout want, s(": "))
    bytes.append(inout want, bounds)
    let mut d = errh("E0605", line, col, q2("", what, " needs `", want, "`"), "a generic body can only use what its type parameters' bounds promise; add the bound")
    let i = param_ix(c, ty)
    if i == NONE { return d }
    let m = c.lt.pm[i as usize]
    let g = ndm(c, m, c.lt.pn[i as usize])
    // after the parameter's name, or after its last bound
    let mut at_line = g.line.copy()
    let mut at_col = g.col + name.len() as u32
    let mut ins = s(": ")
    if g.d > 0 {
        let b = ndm(c, m, atm(c, m, g.c, g.d - 1))
        at_line = b.line
        at_col = b.col + nm(c, b.a).len() as u32
        if b.b > 0 { at_col += nm(c, b.b - 1).len() as u32 + 1 }
        ins = s(" + ")
    }
    bytes.append(inout ins, bounds)
    d.fix = Some(diag.Fix(at_line, at_col, 0, ins))
    d
}

/// lack_err's E0605 when the part lacking trait tr is a type parameter (else NONE-coded: the
/// caller reports its own error).
fn param_lack(c: C, line: u32, col: u32, what: List[u8], tr: u32, ty: u32) -> Option[diag.Diag] {
    let mut seen: Map[u32, bool] = Map.new()
    let part = lacks(c, tr, ty, inout seen)
    if part == NONE || types.kind(c.t, part) != types.T_PARAM { return None }
    Some(bound_err(c, line, col, what, trait_names(c, one(tr)), part))
}

/// Check every generic declaration with an instance against its bounds (see above); the
/// E0605s found are appended.
fn abstract_bodies(inout c: C) {
    let mut fds: List[u32] = List.new()
    for inst in c.insts {
        if inst.slen == 0 || has_sym(fds, inst.fd) { continue }
        let f = c.fdefs[inst.fd as usize]
        if f.md == c.p.prelude || all_gparam_nodes(c, inst.fd).len() == 0 { continue }
        fds.push(inst.fd)
    }
    if fds.len() == 0 { return }
    let saved = c.copy()
    c.lt.abs = true
    let mut found: List[diag.Diag] = List.new()
    for fd in fds {
        let f = c.fdefs[fd as usize].copy()
        let mut sb = no_subst()
        for gn in all_gparam_nodes(c, fd) {
            let g = ndm(c, f.md, gn)
            let ty = types.param(inout c.t, g.a, fd)
            if param_ix(c, ty) == NONE {
                c.lt.pty.push(ty)
                c.lt.pm.push(f.md)
                c.lt.pn.push(gn)
            }
            subst_set(inout sb, g.a, ty)
        }
        if f.inode != NONE {
            let im = ndm(c, f.md, f.inode)
            c.cur_mod = f.md
            c.cur_all = false
            let st = resolve_with(inout c, f.md, im.b, sb)
            c.cur_mod = resolve.NOMOD
            c.cur_all = true
            match st {
                Ok(t) => subst_set(inout sb, intern.S_SELF_TYPE, t)
                Err(_) => { continue }
            }
        }
        c.diags = List.new()
        c.mute = false
        c.seen = List.new()
        c.err_mod = f.md
        match instantiate(inout c, fd, sb) {
            Ok(ii) => {
                match check_fn(inout c, ii) {
                    Ok(_) => {}
                    Err(d) => record(inout c, d)
                }
            }
            Err(d) => record(inout c, d)
        }
        for d in c.diags {
            if is_code(d, "E0605") { found.push(d) }
        }
    }
    c = saved
    for d in found { c.diags.push(d) }
}

// ---- program

fn well_known(inout names: intern.Interner) -> W {
    let mut ints: List[u32] = List.new()
    for w in ["i32", "i64", "u8", "u32", "u64", "usize"] { ints.push(sym(inout names, w)) }
    let mut heap: List[u32] = List.new()
    for w in ["List", "Map", "Box", "Task", "Mutex", "Chan"] { heap.push(sym(inout names, w)) }
    let mut caps: List[u32] = List.new()
    for w in ["io", "clock", "fs", "net", "threads", "ffi", "python", "js", "wasm"] { caps.push(sym(inout names, w)) }
    let mut hm: List[u32] = List.new()
    for w in ["len", "is_empty", "push_str", "append", "push", "pop", "clear", "get", "contains", "insert", "remove",
        "map", "filter", "for_each", "any", "all", "fold", "sum", "set", "from", "from_int", "new",
        "byte", "slice", "bytes", "push_byte", "from_bytes", "keys", "values", "entries"] { hm.push(sym(inout names, w)) }
    W(ints, sym(inout names, "bool"), sym(inout names, "str"), sym(inout names, "Self"), sym(inout names, "String"), heap,
        sym(inout names, "print"), sym(inout names, "len"), sym(inout names, "now_ms"), sym(inout names, "panic"),
        sym(inout names, "spawn"), sym(inout names, "main"), sym(inout names, "Option"), sym(inout names, "Result"),
        caps, caps[0], caps[1], caps[4], heap[0], heap[1], heap[2],
        sym(inout names, "Some"), sym(inout names, "None"), sym(inout names, "Ok"), sym(inout names, "Err"), hm)
}

fn sym(inout names: intern.Interner, w: str) -> u32 {
    let b = sys.lit(w)
    intern.intern(inout names, b, 0, b.len())
}

fn new_checker(p: resolve.Program, lib: bool) -> C {
    let mut p2 = p.copy()
    let w = well_known(inout p2.names)
    let lt = new_lang(inout p2.names)
    C(p2, types.new(), ir.new(), pats.new(), w, Map.new(), Map.new(), Map.new(), Map.new(), Map.new(),
        List.new(), List.new(), List.new(), List.new(), List.new(), Map.new(), List.new(), List.new(), List.new(),
        List.new(), List.new(), List.new(),
        no_subst(), List.new(), List.new(), List.new(), List.new(), List.new(), Map.new(), List.new(),
        0, Map.new(), true, resolve.NOMOD, resolve.NOMOD, types.UNIT, List.new(), 0, 0, 0, 0, no_hint(), 0, false, lib, 0, false, Rec(false, List.new(), List.new()),
        List.new(), List.new(), false, Map.new(), false, false, Map.new(), List.new(), lt, no_refs(),
        Aliases(Map.new(), List.new(), List.new()), List.new())
}

/// Every item of the program in load order (resolve.ei), as (module, node) pairs.
type Item = { m: u32, node: u32 }

fn items(p: resolve.Program) -> List[Item] {
    let mut out: List[Item] = List.new()
    for m in p.order {
        let a = p.mods[m as usize].ast
        for k in 0..a.items_len { out.push(Item(m, ast.at(a, a.items_start, k))) }
    }
    out
}

fn is_builtin_type(c: C, k: u64) -> bool {
    if resolve.key_pre(k) != 0 { return false }
    let x = resolve.key_sym(k)
    has_sym(c.w.ints, x) || has_sym(c.w.heap, x) || x == c.w.s_bool || x == c.w.s_str || x == c.w.s_self || x == c.w.s_string
}

fn is_builtin_fn(c: C, k: u64) -> bool {
    if resolve.key_pre(k) != 0 { return false }
    let x = resolve.key_sym(k)
    x == c.w.print || x == c.w.len || x == c.w.now_ms || x == c.w.panic || x == c.w.spawn
}

fn fn_key(c: C, m: u32, n: ast.Node) -> u64 {
    if ast.has(n.b, ast.FN_EXTERN) || n.a == c.w.main { return resolve.key(0, n.a) }
    resolve.item_key(c.p, m, n.a)
}

/// Check the whole program; on success `c.ir` holds the typed IR.
pub fn check(p: resolve.Program) -> Result[C, diag.Diag] { check_mode(p, false) }

/// Check the program as a program (`lib` = false) or as a library of `export fn`s: the
/// first diagnostic of check_all, if any.
pub fn check_mode(p: resolve.Program, lib: bool) -> Result[C, diag.Diag] { first(check_all(p, lib, false)) }

/// Check the program as a WebAssembly module (`--wasm`): a library
/// whose exports cross the boundary as integers and bool only, without threads (E0806).
pub fn check_wasm(p: resolve.Program) -> Result[C, diag.Diag] { first(check_all(p, true, true)) }

fn first(k: Checked) -> Result[C, diag.Diag] {
    if k.diags.len() > 0 { return Err(k.diags[0]) }
    Ok(k.c)
}

/// What check_all found: the checker (its IR is complete when there are no diagnostics) and
/// every diagnostic, in the order found (the first is the one a first-error checker reports).
pub type Checked = { c: C, diags: List[diag.Diag] }

/// Check the program (as a library with `lib`, as a WebAssembly module with `wasm`),
/// recovering from errors (see "Recovery").
pub fn check_all(p: resolve.Program, lib: bool, wasm: bool) -> Checked {
    let mut c = new_checker(p, lib)
    c.wasm = wasm
    finish(inout c)
}

/// Run the passes on c; its diagnostics, with an `unsupported` that ended the run reported
/// only if nothing else was.
fn finish(inout c: C) -> Checked {
    match run(inout c) {
        Ok(_) => {}
        Err(d) => {
            let mut d2 = in_file(c, d, c.err_mod)
            // Until eiderc checks threads, `spawn` and the thread types stop it with
            // `unsupported`; thread types are noted for the E0806 at the end (wasm_threads).
            if c.wasm && bytes.eq(d.msg, s("not yet supported by eiderc: threads")) { d2 = wasm_threads_error() }
            if c.diags.len() == 0 { c.diags.push(d2) }
        }
    }
    let ds = c.diags
    Checked(c, ds)
}

/// What check_ide gathered: the checker as far as it got (its recording in `c.rec`), and
/// every diagnostic `check` reports.
pub type Recorded = { c: C, diags: List[diag.Diag] }

/// `check` with the IDE recording on (ide.ei). The diagnostics are check's; the recording
/// holds everything noted, also after an error.
pub fn check_ide(p: resolve.Program) -> Recorded {
    let mut c = new_checker(p, false)
    c.rec.on = true
    let k = finish(inout c)
    Recorded(k.c, k.diags)
}

fn wasm_threads_error() -> diag.Diag {
    err("E0806", 1, 1, s("threads (`spawn`, `Task`, `Mutex`, `Chan`) aren't available when targeting WebAssembly"))
}

/// Whether the program uses a thread type (`Task`, `Mutex` or `Chan`, wherever it is met;
/// the type arena holds every type the program uses).
fn uses_thread_types(c: C) -> bool {
    for ty in 0..c.t.tys.len() {
        let k = types.kind(c.t, ty as u32)
        if k == types.T_RECORD || k == types.T_ENUM { continue }
        let t = types.show(c.t, c.p.names, ty as u32)
        if bytes.starts_with(t, s("Task[")) || bytes.starts_with(t, s("Mutex[")) || bytes.starts_with(t, s("Chan[")) { return true }
    }
    false
}

/// Start checking item `it` (of the passes in `run`): its module names the file of what is
/// recorded, and "unknown ..." names are reported once per item.
fn begin_item(inout c: C, it: Item) {
    c.err_mod = it.m
    c.seen = List.new()
}

fn run(inout c: C) -> Result[bool, diag.Diag] {
    let its = items(c.p)
    note_failed_items(inout c)
    lang_prepass(inout c, its)
    // comptime constants are evaluated before checking
    for it in its {
        let n = ndm(c, it.m, it.node)
        if n.kind == ast.IConst && n.e == 1 { return Err(unsup(n.line, n.col, "comptime")) }
    }
    // 1. type templates (a second definition of a name is reported and left out)
    for it in its {
        let n = ndm(c, it.m, it.node)
        if n.kind != ast.IType { continue }
        begin_item(inout c, it)
        let k = resolve.item_key(c.p, it.m, n.a)
        if c.tmpl.contains(k) || c.al.keys.contains(k) || is_builtin_type(c, k) {
            let rd = in_file(c, err("E0107", n.line, n.col, q("`", kt(c, k), "` is already defined")), it.m)
            record(inout c, rd)
            continue
        }
        if n.g > 0 {
            c.al.keys.insert(k, c.al.defs.len() as u32)
            c.al.defs.push(it)
            continue
        }
        let mut is_enum = false
        if n.f > 0 { is_enum = ndm(c, it.m, atm(c, it.m, n.e, 0)).kind == ast.Variant }
        let start = c.t.variants.len() as u32
        let mut vlen: u32 = 0
        if is_enum { vlen = n.f }
        let di = types.add_def(inout c.t, types.Def(k, it.m, n.b == 1, it.node, is_enum, n.d, 0, start, vlen, false, false, types.NOTY, types.EMPTY))
        if is_enum {
            let mut mine: List[u64] = List.new()
            for i in 0..n.f {
                let vn = ndm(c, it.m, atm(c, it.m, n.e, i))
                let vk = resolve.item_key(c.p, it.m, vn.a)
                if mine.contains(vk) || c.variants.contains(vk) {
                    // the variant is kept (the enum keeps its arity), its name means the first
                    let rd = err("E0107", vn.line, vn.col, q("variant `", kt(c, vk), "` is already defined (variant names must be unique)"))
                    record(inout c, rd)
                } else {
                    c.variants.insert(vk, di)
                }
                mine.push(vk)
                c.t.variants.push(types.Variant(vk, vn.d, 0, 0))
            }
        }
        c.tmpl.insert(k, di)
        if it.m == c.p.prelude && n.a == c.lt.s_ordering { c.lt.ordering = di }
    }
    // 2. non-generic types
    for it in its {
        let n = ndm(c, it.m, it.node)
        if n.kind != ast.IType || n.d > 0 { continue }
        // the prelude's Ordering is resolved when a program uses it (so a program that
        // doesn't has the types, and the C, it had before)
        if it.m == c.p.prelude { continue }
        begin_item(inout c, it)
        if n.g > 0 {
            // a non-generic alias's type is checked once, here; a generic one where it is used
            let ai = mget(c.al.keys, resolve.item_key(c.p, it.m, n.a))
            if ai == NONE || c.al.defs[ai as usize].node != it.node || c.al.defs[ai as usize].m != it.m { continue }
            let r = alias_ty(inout c, ai, List.new(), n.line, n.col)
            match r {
                Ok(_) => {}
                Err(d) => {
                    if fatal(d) { return Err(d) }
                    record(inout c, d)
                }
            }
            continue
        }
        let di = mget(c.tmpl, resolve.item_key(c.p, it.m, n.a))
        // a definition left out in pass 1
        if di == NONE || c.t.defs[di as usize].node != it.node || c.t.defs[di as usize].md != it.m { continue }
        let r = inst_type(inout c, di, List.new(), n.line, n.col)
        match r {
            Ok(_) => {}
            Err(d) => {
                if fatal(d) { return Err(d) }
                record(inout c, d)
            }
        }
    }
    // 3. traits
    for it in its {
        let n = ndm(c, it.m, it.node)
        if n.kind != ast.ITrait { continue }
        begin_item(inout c, it)
        let k = resolve.item_key(c.p, it.m, n.a)
        // a trait named like one of the prelude's shadows it in the program's names
        let prior = mget(c.traits, k)
        let shadows = prior != NONE && c.trs[prior as usize].m == c.p.prelude && it.m != c.p.prelude
        if (c.traits.contains(k) && !shadows) || c.tmpl.contains(k) {
            let rd = err("E0107", n.line, n.col, q("`", kt(c, k), "` is already defined"))
            record(inout c, rd)
            continue
        }
        c.traits.insert(k, c.trs.len() as u32)
        c.trs.push(it)
    }
    // 4. free functions (a misdeclared one is reported and still declared)
    for it in its {
        let n = ndm(c, it.m, it.node)
        if n.kind != ast.IFn { continue }
        begin_item(inout c, it)
        let k = fn_key(c, it.m, n)
        if c.fns.contains(k) || c.tmpl.contains(k) || c.variants.contains(k) || is_builtin_fn(c, k) {
            let rd = in_file(c, err("E0107", n.line, n.col, q("`", kt(c, k), "` is already defined")), it.m)
            record(inout c, rd)
            continue
        }
        if ast.has(n.b, ast.FN_EXPORT) {
            if n.d > 0 {
                let rd = in_file(c, errh("E0805", n.line, n.col, s("an `export fn` can't be generic"), "exported functions need a fixed C signature; export a concrete wrapper"), it.m)
                record(inout c, rd)
            }
        }
        // (the return type is checked with the signature, pass 7)
        if n.a == c.w.main && (n.f > 0 || n.d > 0) { record(inout c, main_error(n)) }
        check_bounds_known(inout c, it.m, n.c, n.d)?
        c.fns.insert(k, c.fdefs.len() as u32)
        // every free function gets an IR function in order; a generic one never gets a body
        // (its instances are functions of their own)
        let fname = kt(c, k)
        let decl_ir = ir.declare_fn(inout c.ir, fname, false)
        let irf = if n.d == 0 { decl_ir } else { NONE }
        c.fdefs.push(FnDef(k, it.m, it.node, ast.has(n.b, ast.FN_PUBLIC), n.d > 0, ast.has(n.b, ast.FN_UNSAFE), irf, NONE))
    }
    // 5. impls
    let mut concrete: List[u32] = List.new()
    for it in its {
        let n = ndm(c, it.m, it.node)
        if n.kind != ast.IImpl { continue }
        begin_item(inout c, it)
        register_impl(inout c, it.m, it.node, inout concrete)?
    }
    c.lt.registered = true
    // constants and other code outside functions build into a scratch IR function
    let scratch = ir.declare_fn(inout c.ir, s("<const>"), false)
    ir.begin_fn(inout c.ir, scratch, types.UNIT, List.new())
    // 6. constants (one that fails is a constant of the error type)
    for it in its {
        let n = ndm(c, it.m, it.node)
        if n.kind != ast.IConst { continue }
        begin_item(inout c, it)
        c.cur_mod = it.m
        c.cur_all = false
        c.am = it.m
        c.locals = Map.new()
        c.scopes = List.new()
        c.marks = List.new()
        reset_frames(inout c)
        push_scope(inout c)
        let k = resolve.item_key(c.p, it.m, n.a)
        if c.consts.contains(k) || c.fns.contains(k) {
            let rd = err("E0107", n.line, n.col, q("`", kt(c, k), "` is already defined"))
            record(inout c, rd)
            continue
        }
        // a comptime constant whose evaluation failed (comptime.ei) was reported then
        let mut ok = n.e != 2
        if ok {
            let sp = snap(c)
            let r = check_const(inout c, it, n, k)
            match r {
                Ok(done) => { ok = done }
                Err(d) => {
                    if fatal(d) { return Err(d) }
                    record(inout c, d)
                    restore(inout c, sp)
                    ok = false
                }
            }
        }
        if !ok {
            let pv = poison_v(inout c)
            c.consts.insert(k, c.cdefs.len() as u32)
            c.cdefs.push(ConstDef(k, it.m, n.b == 1, pv.ty, false, fold.zero(), pv.op, it.node))
        }
    }
    c.cur_all = true
    c.cur_mod = resolve.NOMOD
    // 7. signatures of every concrete function, then of every concrete method
    for fi in 0..c.fdefs.len() {
        let f = c.fdefs[fi].copy()
        if f.generic || f.inode != NONE { continue }
        c.err_mod = f.md
        c.seen = List.new()
        let ii = instantiate(inout c, fi as u32, no_subst())?
        let fnode = ndm(c, f.md, f.node)
        if f.key == resolve.key(0, c.w.main) {
            c.ir.main_line = fnode.line
            if fnode.f == 0 && fnode.d == 0 && !main_returns_ok(c, c.insts[ii as usize].ret) { record(inout c, main_error(fnode)) }
        }
        let fl = fnode.b
        if ast.has(fl, ast.FN_EXTERN) || ast.has(fl, ast.FN_EXPORT) { record_ffi(inout c, ii) }
    }
    for fi in concrete {
        let f = c.fdefs[fi as usize].copy()
        c.err_mod = f.md
        c.seen = List.new()
        c.cur_mod = f.md
        c.cur_all = false
        let target = ndm(c, f.md, f.inode).b
        let st = resolve_ty(inout c, f.md, target)
        c.cur_mod = resolve.NOMOD
        c.cur_all = true
        let mut self_ty = types.UNIT
        match st {
            Ok(t) => { self_ty = t }
            Err(d) => {
                if fatal(d) { return Err(d) }
                record(inout c, d)
                // the method is left out: its impl's target doesn't resolve
                continue
            }
        }
        let mut sb = no_subst()
        subst_set(inout sb, intern.S_SELF_TYPE, self_ty)
        instantiate(inout c, fi, sb)?
    }
    // tests (checked with every capability; err_mod is left as it was, as tests/oracle expects)
    for it in its {
        let n = ndm(c, it.m, it.node)
        if n.kind == ast.ITest {
            c.seen = List.new()
            let sp = snap(c)
            let r = check_test(inout c, it.m, n)
            match r {
                Ok(_) => {}
                Err(d) => {
                    if fatal(d) { return Err(d) }
                    record(inout c, d)
                    restore(inout c, sp)
                }
            }
        }
    }
    // function bodies: the most recently instantiated first
    while c.pending.len() > 0 {
        let i: u32 = match c.pending.pop() {
            Some(x) => x
            None => 0
        }
        let fd = c.insts[i as usize].fd.copy()
        let generic = c.insts[i as usize].slen > 0
        // a further instance of a generic body that had errors would repeat them
        c.mute = generic && c.bad_fd.contains(fd)
        let before = c.diags.len()
        let r = check_fn(inout c, i)
        match r {
            Ok(_) => {}
            Err(d) => {
                if fatal(d) { return Err(d) }
                record(inout c, d)
            }
        }
        c.mute = false
        if c.diags.len() > before { c.bad_fd.insert(fd, true) }
        // then the language-trait impls of the types made so far, whose bodies may make more
        if c.pending.len() == 0 { scan_impls(inout c) }
    }
    // the protection rule (E0308), over every body ("References")
    protect(inout c)
    // generic bodies against their bounds (E0605)
    abstract_bodies(inout c)
    c.err_mod = resolve.NOMOD
    c.seen = List.new()
    c.body_err = false
    // (an item the parser skipped may have been the missing one)
    let skipped = entry_skipped(c)
    if c.lib {
        if c.exports == 0 && !skipped { record(inout c, err("E0805", 1, 1, s("a library needs at least one `export fn`"))) }
    } else if !c.fns.contains(resolve.key(0, c.w.main)) && !skipped {
        record(inout c, err("E0112", 1, 1, s("no `main` function")))
    }
    if c.wasm && uses_thread_types(c) { record(inout c, wasm_threads_error()) }
    Ok(true)
}

/// Check constant node n (key k) of item it; false when it is a constant of the error type
/// (its initializer failed, and that was recorded).
/// E0111: `main`'s signature (docs/compiler.md, "C8.2: small language gaps").
fn main_error(n: ast.Node) -> diag.Diag {
    errh("E0111", n.line, n.col, s("`main` takes no parameters and returns (), i32 or Result[(), E]"), "an i32 is the exit code (0 to 255); an Err is printed and exits with 1")
}

/// Whether `main` may return ty: (), i32 (the exit code) or Result[(), E] for any E.
fn main_returns_ok(c: C, ty: u32) -> bool {
    if ty == types.UNIT || ty == types.I32 || poisoned(c, ty) { return true }
    main_result(c, ty)
}

/// Whether ty is Result[(), E].
fn main_result(c: C, ty: u32) -> bool {
    if types.kind(c.t, ty) != types.T_ENUM { return false }
    let d = types.def_of(c.t, ty)
    let rk = resolve.key(0, c.w.result)
    if c.t.defs[d.tmpl as usize].key != rk || d.args == types.EMPTY { return false }
    types.list_at(c.t, d.args, 0) == types.UNIT
}

fn check_const(inout c: C, it: Item, n: ast.Node, k: u64) -> Result[bool, diag.Diag] {
    let ty = resolve_ty(inout c, it.m, n.c)?
    let vn = ndm(c, it.m, n.d)
    if owns(c, ty) { return Err(err("E0504", vn.line, vn.col, s("constants can't own heap memory; build the value in a function instead"))) }
    let mark = ir.open(c.ir)
    let v = expr(inout c, n.d, ty)?
    ir.close(inout c.ir, mark)
    if poisoned(c, v.ty) { return Ok(false) }
    if v.ty != ty { return Err(mismatch(c, vn.line, vn.col, ty, v.ty)) }
    let tk = types.kind(c.t, ty)
    let ok = (tk == types.T_INT && v.has_k) || (tk == types.T_BOOL && vn.kind == ast.EBool) || (tk == types.T_STR && vn.kind == ast.EStr)
    if !ok { return Err(err("E0504", vn.line, vn.col, s("constant initializers must be literals or compile-time integer expressions"))) }
    c.consts.insert(k, c.cdefs.len() as u32)
    c.cdefs.push(ConstDef(k, it.m, n.b == 1, ty, v.has_k, v.k, v.op, it.node))
    let cname = kt(c, k)
    ir.add_const(inout c.ir, cname, ty, v.op)
    Ok(true)
}

/// Record instance ii of an `extern "c"` or `export` function in the IR.
fn record_ffi(inout c: C, ii: u32) {
    let inst = c.insts[ii as usize].copy()
    let f = c.fdefs[inst.fd as usize]
    let n = ndm(c, f.md, f.node)
    if ast.has(n.b, ast.FN_EXTERN) {
        let mut ps: List[u32] = List.new()
        for i in 0..inst.plen { ps.push(c.ptys[(inst.pstart + i) as usize]) }
        let sym = nm(c, n.a)
        ir.add_extern(inout c.ir, inst.ir, sym, ps, inst.ret)
    } else {
        // the C interface shows the stem, as programs do (resolve.ei `shown`)
        let name = resolve.key_shown(c.p.names, f.key)
        ir.add_export(inout c.ir, inst.ir, name)
        c.exports += 1
    }
}

/// Whether type ty can cross the C boundary: integers, bool and str; ()
/// as a return type; records made only of those when `records` (exports).
fn ffi_safe(c: C, ty: u32, is_ret: bool, records: bool) -> bool {
    let k = types.kind(c.t, ty)
    if k == types.T_INT || k == types.T_BOOL || k == types.T_STR { return true }
    if k == types.T_UNIT { return is_ret }
    // (a record with its own Drop lives in a shared buffer)
    if k != types.T_RECORD || !records || has_drop(c, ty) { return false }
    let d = types.def_of(c.t, ty)
    for i in 0..d.len {
        if !ffi_safe(c, types.field(c.t, d.start, i).ty, false, true) { return false }
    }
    true
}

/// E0803 for an `extern "c"` or `export` signature that can't cross the C boundary
/// (node n of module m, parameter types ps).
fn check_ffi_sig(c: C, m: u32, n: ast.Node, ps: List[u32], ret: u32) -> Result[bool, diag.Diag] {
    let is_export = ast.has(n.b, ast.FN_EXPORT)
    let what = if is_export { "export" } else { "extern \"c\"" }
    let help = "C-safe types: integers, bool, str (const char*), and records made only of those (export only)"
    if is_export && c.wasm {
        for i in 0..n.f {
            let k = types.kind(c.t, ps[i as usize])
            if k != types.T_INT && k != types.T_BOOL {
                let pn = ndm(c, m, atm(c, m, n.e, i))
                return Err(err("E0806", pn.line, pn.col, q2("parameter `", nm(c, pn.a), "` has type ", ts(c, ps[i as usize]), "; WebAssembly exports take only integers and bool")))
            }
        }
        let rk = types.kind(c.t, ret)
        if rk != types.T_INT && rk != types.T_BOOL && rk != types.T_UNIT {
            return Err(err("E0806", n.line, n.col, q("return type ", ts(c, ret), " isn't supported for WebAssembly exports (integers, bool, or ())")))
        }
    }
    for i in 0..n.f {
        let pn = ndm(c, m, atm(c, m, n.e, i))
        if pn.c == 1 {
            return Err(err("E0803", pn.line, pn.col, q2("`", nm(c, pn.a), "` is `inout`; ", sys.lit(what), " functions can't take `inout` parameters")))
        }
        if !ffi_safe(c, ps[i as usize], false, is_export && !c.wasm) {
            return Err(errh("E0803", pn.line, pn.col, q2("parameter `", nm(c, pn.a), "` has type ", ts(c, ps[i as usize]), ", which can't cross the C boundary"), help))
        }
    }
    if !ffi_safe(c, ret, true, is_export && !c.wasm) {
        return Err(errh("E0803", n.line, n.col, q("return type ", ts(c, ret), " can't cross the C boundary"), help))
    }
    Ok(true)
}

/// E0603 for a bound naming no trait, on generic parameters [start/len) of module m.
fn check_bounds_known(inout c: C, m: u32, start: u32, len: u32) -> Result[bool, diag.Diag] {
    for i in 0..len {
        let g = ndm(c, m, atm(c, m, start, i))
        for j in 0..g.d {
            let b = ndm(c, m, atm(c, m, g.c, j))
            let bk = resolve.name_key(c.p, m, b.a, b.b, b.line, b.col)
            if !c.traits.contains(bk) {
                let rd = err("E0603", g.line, g.col, q("unknown trait `", kt(c, bk), "`"))
                record(inout c, rd)
                continue
            }
            if c.rec.on {
                let tr = c.trs[mget(c.traits, bk) as usize].copy()
                let trn = ndm(c, tr.m, tr.node)
                note_ref(inout c, m, b, tr.m, trn.line, trn.col)
            }
        }
    }
    Ok(true)
}

fn find_method(c: C, m: u32, start: u32, len: u32, name: u32) -> u32 {
    for i in 0..len {
        let id = atm(c, m, start, i)
        if ndm(c, m, id).a == name { return id }
    }
    NONE
}

/// A trait method's return type or parameter type as compared by register_impl.
fn norm(c: C, m: u32, tn1: u32, gens: List[u32], target: List[u8]) -> List[u8] {
    if tn1 == 0 { return s("()") }
    replace_self(show_ast(c, m, tn1 - 1, gens), target)
}

fn concat_syms(a: List[u32], b: List[u32]) -> List[u32] {
    let mut out = a.copy()
    for x in b { out.push(x) }
    out
}

/// Whether method node mn (module m) returns `Option[...]`.
fn option_ret(c: C, m: u32, mn: ast.Node) -> bool {
    if mn.g == 0 { return false }
    let r = ndm(c, m, mn.g - 1)
    r.kind == ast.TGeneric && r.d == 1 && resolve.name_key(c.p, m, r.a, r.b, r.line, r.col) == resolve.key(0, c.w.option)
}

/// Register the methods of impl node `id` of module m. Its errors are recorded as they are
/// found; its methods are registered (an unknown trait's as inherent ones) unless the impl
/// repeats another, each name once.
fn register_impl(inout c: C, m: u32, id: u32, inout concrete: List[u32]) -> Result[bool, diag.Diag] {
    let im = ndm(c, m, id)
    let igens = gparams(c, m, im.c, im.d)
    let tgt = ndm(c, m, im.b)
    if (tgt.kind == ast.TName || tgt.kind == ast.TGeneric) && alias_of(c, m, tgt) != NONE {
        // methods belong to a type, which an alias only names (docs/compiler.md, "C8.18")
        let rd = errh("E0111", tgt.line, tgt.col, q("`", show_ast(c, m, im.b, igens), "` is a type alias; an impl names the type itself"), "write the impl for the type the alias stands for")
        record(inout c, rd)
        return Ok(true)
    }
    let head = head_key(c, m, im.b, igens)
    let target = show_ast(c, m, im.b, igens)
    let mut names: List[u32] = List.new()
    for i in 0..im.f {
        let mn = ndm(c, m, atm(c, m, im.e, i))
        if has_sym(names, mn.a) {
            let rd = err("E0107", mn.line, mn.col, q("method `", nm(c, mn.a), "` is defined twice in this impl"))
            record(inout c, rd)
        } else {
            names.push(mn.a)
        }
    }
    if im.a > 0 {
        let tn = ndm(c, m, im.a - 1)
        let tk = resolve.name_key(c.p, m, tn.a, tn.b, tn.line, tn.col)
        let ti = mget(c.traits, tk)
        let is_from = ti != NONE && c.trs[ti as usize].m == c.p.prelude && is_word(c, tn.a, "From") && tn.b == 0
        if is_from { return register_from(inout c, m, id, igens, target, inout concrete) }
        if ti != NONE && tn.kind == ast.TGeneric {
            let rd = err("E0603", tn.line, tn.col, q("trait `", kt(c, tk), "` takes no type arguments"))
            record(inout c, rd)
            return Ok(true)
        }
        if ti == NONE {
            let rd = err("E0603", tn.line, tn.col, q("unknown trait `", kt(c, tk), "`"))
            record(inout c, rd)
        } else {
            let tr = c.trs[ti as usize].copy()
            let trn = ndm(c, tr.m, tr.node)
            note_ref(inout c, m, tn, tr.m, trn.line, trn.col)
            // a language trait: the orphan rule and what each needs ("Operation traits")
            let lang = lang_of_key(c, tk)
            if lang != NONE && !check_lang_impl(inout c, m, im, lang, igens) { return Ok(true) }
            for i in 0..trn.d {
                let tm = ndm(c, tr.m, atm(c, tr.m, trn.c, i))
                let mid = find_method(c, m, im.e, im.f, tm.a)
                if mid == NONE {
                    let rd = err("E0602", im.line, im.col, q2("impl of `", kt(c, tk), "` is missing method `", nm(c, tm.a), "`"))
                    record(inout c, rd)
                    continue
                }
                let mn = ndm(c, m, mid)
                let mgens = concat_syms(igens, gparams(c, m, mn.c, mn.d))
                let tgens = gparams(c, tr.m, tm.c, tm.d)
                let mut differs = !bytes.eq(norm(c, m, mn.g, mgens, target), norm(c, tr.m, tm.g, tgens, target))
                // Iter's `next` returns `Option[Item]` for the item type the impl chooses
                if lang == TR_ITER { differs = !option_ret(c, m, mn) }
                let mut k: u32 = 1
                while k < mn.f && k < tm.f {
                    let a = ndm(c, m, atm(c, m, mn.e, k))
                    let b = ndm(c, tr.m, atm(c, tr.m, tm.e, k))
                    if !bytes.eq(norm(c, m, a.b + 1, mgens, target), norm(c, tr.m, b.b + 1, tgens, target)) { differs = true }
                    k += 1
                }
                if mn.f != tm.f { differs = true }
                k = 0
                while k < mn.f && k < tm.f {
                    let a = ndm(c, m, atm(c, m, mn.e, k))
                    let b = ndm(c, tr.m, atm(c, tr.m, tm.e, k))
                    if a.c != b.c { differs = true }
                    k += 1
                }
                if differs {
                    let rd = err("E0602", mn.line, mn.col, q2("method `", nm(c, mn.a), "` doesn't match the signature in trait `", kt(c, tk), "`"))
                    record(inout c, rd)
                }
            }
            for i in 0..im.f {
                let mn = ndm(c, m, atm(c, m, im.e, i))
                if find_method(c, tr.m, trn.c, trn.d, mn.a) == NONE {
                    let rd = err("E0602", mn.line, mn.col, q2("trait `", kt(c, tk), "` has no method `", nm(c, mn.a), "`"))
                    record(inout c, rd)
                }
            }
            for x in c.timpls {
                if x.tkey == tk && bytes.eq(x.target, target) {
                    // a second impl: its methods would only repeat the first's
                    let rd = err("E0107", im.line, im.col, q2("`", kt(c, tk), "` is already implemented for `", target, "`"))
                    record(inout c, rd)
                    return Ok(true)
                }
            }
            c.timpls.push(TImpl(tk, m, id, target))
        }
    }
    let mut done: List[u32] = List.new()
    for i in 0..im.f {
        let mid = atm(c, m, im.e, i)
        let mn = ndm(c, m, mid)
        if has_sym(done, mn.a) { continue }
        done.push(mn.a)
        let mut dup = false
        for x in c.meths {
            if x.head == head && x.name == mn.a && bytes.eq(x.target, target) { dup = true }
        }
        if dup {
            let rd = err("E0107", mn.line, mn.col, q2("method `", nm(c, mn.a), "` is already defined for `", target, "`"))
            record(inout c, rd)
            continue
        }
        let bk = builtin_head_kind(c, head)
        if bk != NONE && (builtin_method(c, bk, mn.a) || builtin_static(c, resolve.key_sym(head), mn.a)) {
            let rd = in_file(c, errh("E0116", mn.line, mn.col, q2("`", target, "` already has a built-in `", nm(c, mn.a), "`"), "built-in methods can't be replaced; give this method another name"), m)
            record(inout c, rd)
            continue
        }
        let fi = c.fdefs.len() as u32
        c.fdefs.push(FnDef(resolve.key(0, mn.a), m, mid, true, mn.d > 0, ast.has(mn.b, ast.FN_UNSAFE), NONE, id))
        if im.d == 0 && mn.d == 0 && mn.h > 0 { concrete.push(fi) }
        c.meths.push(Meth(head, mn.a, fi, target))
    }
    Ok(true)
}

/// The type parameters of declaration fi, impl's first (call_decl's all_generics).
fn all_generics(c: C, fi: u32) -> List[u32] {
    let f = c.fdefs[fi as usize]
    let n = ndm(c, f.md, f.node)
    let mut out: List[u32] = List.new()
    if f.inode != NONE {
        let im = ndm(c, f.md, f.inode)
        out = gparams(c, f.md, im.c, im.d)
    }
    for x in gparams(c, f.md, n.c, n.d) { out.push(x) }
    out
}

/// The generic parameter nodes of declaration fi, impl's first.
fn all_gparam_nodes(c: C, fi: u32) -> List[u32] {
    let f = c.fdefs[fi as usize]
    let n = ndm(c, f.md, f.node)
    let mut out: List[u32] = List.new()
    if f.inode != NONE {
        let im = ndm(c, f.md, f.inode)
        for i in 0..im.d { out.push(atm(c, f.md, im.c, i)) }
    }
    for i in 0..n.d { out.push(atm(c, f.md, n.c, i)) }
    out
}

/// The IR name of an instance: `name`, `name[T1, ..]`, `Self.name[..]`.
fn inst_name(c: C, fi: u32, sb: Subst) -> List[u8] {
    let f = c.fdefs[fi as usize]
    let mut out: List[u8] = List.new()
    if f.inode != NONE {
        bytes.append(inout out, ts(c, subst_get(sb, intern.S_SELF_TYPE)))
        out.push(46)
    }
    bytes.append(inout out, kt(c, f.key))
    let n = ndm(c, f.md, f.node)
    if n.d > 0 {
        out.push(91)
        let gs = gparams(c, f.md, n.c, n.d)
        for i in 0..gs.len() {
            if i > 0 { bytes.append(inout out, s(", ")) }
            bytes.append(inout out, ts(c, subst_get(sb, gs[i])))
        }
        out.push(93)
    }
    out
}

/// The instance of declaration fi for substitution sb, resolving its signature the first
/// time and queueing its body.
fn instantiate(inout c: C, fi: u32, sb: Subst) -> Result[u32, diag.Diag] {
    let f = c.fdefs[fi as usize].copy()
    let mut keyl: List[u32] = List.new()
    if f.inode != NONE { keyl.push(subst_get(sb, intern.S_SELF_TYPE)) } else { keyl.push(NONE) }
    for g in all_generics(c, fi) { keyl.push(subst_get(sb, g)) }
    let lid = types.list(inout c.t, keyl)
    let ik = (fi as u64) * 4294967296 + lid as u64
    let found = mget(c.inst_ix, ik)
    if found != NONE { return Ok(found) }
    let saved_all = c.cur_all.copy()
    let saved_mod = c.cur_mod.copy()
    let saved_sub = c.tsubst.copy()
    c.cur_all = false
    c.cur_mod = f.md
    c.tsubst = sb
    let r = signature(inout c, fi)
    c.cur_all = saved_all
    c.cur_mod = saved_mod
    c.tsubst = saved_sub
    let mut inst = match r {
        Ok(x) => x
        Err(d) => { return Err(in_file(c, d, f.md)) }
    }
    inst.sstart = c.sub_s.len() as u32
    inst.slen = sb.syms.len() as u32
    for i in 0..sb.syms.len() {
        c.sub_s.push(sb.syms[i])
        c.sub_t.push(sb.tys[i])
    }
    if f.ir != NONE {
        inst.ir = f.ir
    } else {
        let mut iname = inst_name(c, fi, sb)
        // a `From` impl's `from` is named by its source too: one target has several
        for x in c.froms {
            if x.fd == fi && inst.plen > 0 {
                iname.push(91)
                bytes.append(inout iname, ts(c, c.ptys[inst.pstart as usize]))
                iname.push(93)
            }
        }
        inst.ir = ir.declare_fn(inout c.ir, iname, false)
    }
    let ii = c.insts.len() as u32
    c.insts.push(inst)
    c.inst_ix.insert(ik, ii)
    if ndm(c, f.md, f.node).h > 0 { c.pending.push(ii) }
    Ok(ii)
}

/// The parts of a signature that fail are recorded (naming the file as instantiate does) and
/// are the error type, or left out (a capability), so the instance always exists.
fn signature(inout c: C, fi: u32) -> Result[Inst, diag.Diag] {
    let f = c.fdefs[fi as usize]
    let m = f.md.copy()
    let n = ndm(c, m, f.node)
    let mut ps: List[u32] = List.new()
    for i in 0..n.f {
        let pn = ndm(c, m, atm(c, m, n.e, i))
        let mut ty = item_ty(inout c, m, pn.b)?
        if ty == types.UNIT {
            let rd = in_file(c, err("E0111", pn.line, pn.col, s("parameters can't have type ()")), m)
            record(inout c, rd)
            ty = poison(inout c)
        }
        ps.push(ty)
    }
    let mut ret = types.UNIT
    if n.g > 0 { ret = item_ty(inout c, m, n.g - 1)? }
    let mut caps: List[u32] = List.new()
    for i in 0..n.j {
        let cn = ndm(c, m, atm(c, m, n.i, i))
        if !has_sym(c.w.caps, cn.a) {
            let rd = in_file(c, errh("E0203", cn.line, cn.col, q("unknown capability `", nm(c, cn.a), "`"), "known capabilities: io, clock, fs, net, threads, ffi, python, js, wasm"), m)
            record(inout c, rd)
            continue
        }
        caps.push(cn.a)
    }
    let mut whole = !poisoned(c, ret)
    for x in ps {
        if poisoned(c, x) { whole = false }
    }
    if whole && (ast.has(n.b, ast.FN_EXTERN) || ast.has(n.b, ast.FN_EXPORT)) {
        match check_ffi_sig(c, m, n, ps, ret) {
            Ok(_) => {}
            Err(d) => {
                let rd = in_file(c, d, m)
                record(inout c, rd)
            }
        }
    }
    let pstart = c.ptys.len() as u32
    for x in ps { c.ptys.push(x) }
    let cstart = c.capl.len() as u32
    for x in caps { c.capl.push(x) }
    Ok(Inst(fi, 0, 0, NONE, ret, pstart, ps.len() as u32, cstart, caps.len() as u32))
}

fn caps_text(c: C, caps: List[u32]) -> List[u8] {
    let mut out: List[u8] = List.new()
    for i in 0..caps.len() {
        if i > 0 { bytes.append(inout out, s(", ")) }
        bytes.append(inout out, nm(c, caps[i]))
    }
    out
}

fn reset_frames(inout c: C) {
    c.frames = List.new()
    c.fmarks = List.new()
    c.firs = List.new()
    c.fresh = Map.new()
    c.loop_bases = List.new()
    push_frame(inout c)
}

fn begin_body(inout c: C, m: u32, ret: u32, caps: List[u32], line: u32, col: u32) {
    c.am = m
    c.ret = ret
    c.caps = caps
    c.sig_line = line
    c.sig_col = col
    c.loops = 0
    c.scopes = List.new()
    c.marks = List.new()
    c.rf.any = false
    push_scope(inout c)
}

/// The file index lowering encodes in the trap lines of a body from module m (docs/
/// compiler.md, "C8.16"): 0 for the entry file (and past 2047 modules), else m, whose name
/// goes into ir.files.
fn trap_file(inout c: C, m: u32) -> u32 {
    if m == 0 || m == resolve.NOMOD || m >= 2048 || m as usize >= c.p.shown.len() { return 0 }
    while c.ir.files.len() as u32 <= m { c.ir.files.push(List.new()) }
    if c.ir.files[m as usize].len() == 0 { c.ir.files[m as usize] = c.p.shown[m as usize].copy() }
    m
}

fn check_test(inout c: C, m: u32, n: ast.Node) -> Result[bool, diag.Diag] {
    c.tsubst = no_subst()
    c.cur_all = true
    c.cur_mod = resolve.NOMOD
    c.unsafe_depth = 0
    c.locals = Map.new()
    let caps = c.w.caps.copy()
    begin_body(inout c, m, types.UNIT, caps, n.line, n.col)
    let tname = c.p.mods[m as usize].strs[n.a as usize].copy()
    let f = ir.declare_fn(inout c.ir, tname, true)
    let ctext = caps_text(c, caps)
    c.ir.cur_file = trap_file(inout c, m)
    ir.begin_fn(inout c.ir, f, types.UNIT, ctext)
    reset_frames(inout c)
    c.seen = List.new()
    c.body_err = resolve.syntax_in(c.p, m, n.line, ndm(c, m, n.b).end_line)
    let mark = ir.open(c.ir)
    block_body(inout c, n.b, Dest(D_DISCARD, 0), NONE)?
    let b = ir.close(inout c.ir, mark)
    ir.end_fn(inout c.ir, 0, b)
    Ok(true)
}

fn check_fn(inout c: C, ii: u32) -> Result[bool, diag.Diag] {
    let inst = c.insts[ii as usize].copy()
    let f = c.fdefs[inst.fd as usize].copy()
    let m = f.md.copy()
    let n = ndm(c, m, f.node)
    let mut sb = no_subst()
    for i in 0..inst.slen {
        sb.syms.push(c.sub_s[(inst.sstart + i) as usize])
        sb.tys.push(c.sub_t[(inst.sstart + i) as usize])
    }
    c.tsubst = sb
    c.cur_all = false
    c.cur_mod = m
    c.err_mod = m
    c.seen = List.new()
    c.body_err = false
    c.unsafe_depth = if f.unsafe_fn { 1 } else { 0 }
    c.locals = Map.new()
    if c.p.mods[m as usize].pre > 0 { c.locals = resolve.fn_locals(c.p, m, n) }
    let mut caps: List[u32] = List.new()
    for i in 0..inst.clen { caps.push(c.capl[(inst.cstart + i) as usize]) }
    begin_body(inout c, m, inst.ret, caps, n.end_line, n.end_col)
    let ctext = caps_text(c, caps)
    c.ir.cur_file = trap_file(inout c, m)
    ir.begin_fn(inout c.ir, inst.ir, inst.ret, ctext)
    reset_frames(inout c)
    for i in 0..n.f {
        let pn = ndm(c, m, atm(c, m, n.e, i))
        let ty = c.ptys[(inst.pstart + i) as usize].copy()
        let kind = if pn.c == 1 { ir.L_INOUT } else { ir.L_PARAM }
        let l = ir.local(inout c.ir, pn.a, ty, kind, pn.line)
        // a parameter named twice is reported; the body sees the first
        let r = declare(inout c, local_plain(resolve.key(0, pn.a), ty, pn.c == 1, pn.line, pn.col, l))
        recover(inout c, r)?
    }
    let dest = if inst.ret == types.UNIT { Dest(D_DISCARD, 0) } else { Dest(D_RETURN, 0) }
    let body = n.h - 1
    // a syntax error in the body: what was skipped may have declared names or ended it
    c.body_err = resolve.syntax_in(c.p, m, n.line, ndm(c, m, body).end_line)
    let mark = ir.open(c.ir)
    let t = block_body(inout c, body, dest, inst.ret)?
    let b = ir.close(inout c.ir, mark)
    if inst.ret != types.UNIT && t != types.NEVER && !same(c, t, inst.ret) && !c.body_err {
        let bn = ndm(c, m, body)
        return Err(errh("E0401", bn.end_line, bn.end_col, q2("function `", kt(c, f.key), "` must return ", ts(c, inst.ret), ", but its body ends without producing one"), "add a `return` or end the body with an expression of that type"))
    }
    ir.end_fn(inout c.ir, n.f, b)
    c.tsubst = no_subst()
    Ok(true)
}

// ---- statements

fn block_body(inout c: C, b: u32, dest: Dest, exp: u32) -> Result[u32, diag.Diag] {
    let n = nd(c, b)
    push_scope(inout c)
    push_frame(inout c)
    let mut ty = types.UNIT
    let mut saw_err = false
    for i in 0..n.d {
        let st = at(c, n.c, i)
        let sn = nd(c, st)
        // a statement the parser skipped: the block may have lost its last expression
        if sn.kind == ast.SError { saw_err = true }
        let tail = i + 1 == n.d && sn.kind == ast.SExpr
        // a recovery point: a failed statement is recorded and its names bound to the error type
        let sp = snap(c)
        let r = if tail { compile_value(inout c, sn.a, dest, exp) } else { stmt(inout c, st) }
        match r {
            Ok(t) => { ty = t }
            Err(d) => {
                if fatal(d) { return Err(d) }
                record(inout c, d)
                restore(inout c, sp)
                bind_failed(inout c, st)
                // a failed last statement may have been meant to end the block (`return`,
                // its value): nothing is concluded from how the block ends
                ty = types.UNIT
                if i + 1 == n.d { ty = poison(inout c) }
            }
        }
    }
    if saw_err && ty != types.NEVER { ty = poison(inout c) }
    pop_scope(inout c)
    pop_frame(inout c, ty != types.NEVER)
    Ok(ty)
}

fn check_bindable(c: C, actual: u32, fin: u32, line: u32, col: u32) -> Result[bool, diag.Diag] {
    if poisoned(c, actual) || poisoned(c, fin) { return Ok(true) }
    if actual == types.NEVER { return Err(err("E0401", line, col, s("this expression never produces a value"))) }
    if actual == types.UNIT { return Err(err("E0401", line, col, s("cannot bind a value of type ()"))) }
    if actual != fin { return Err(mismatch(c, line, col, fin, actual)) }
    Ok(true)
}

fn stmt(inout c: C, st: u32) -> Result[u32, diag.Diag] {
    let n = nd(c, st)
    match n.kind {
        ast.SLet => {
            let mut declared = NONE
            let am = c.am.copy()
            if n.b > 0 {
                // an annotation that doesn't resolve: the initializer is still checked
                declared = match resolve_ty(inout c, am, n.b - 1) {
                    Ok(t) => t
                    Err(d) => {
                        if fatal(d) { return Err(d) }
                        record(inout c, d)
                        poison(inout c)
                    }
                }
            }
            let init = nd(c, n.c)
            // `let x = place`, `let mut x = place`: a reference ("References"), unless it
            // would be a mutable alias of a read-only place (E0307: then x owns a copy, as the
            // fix's `.copy()` makes it)
            let place_init = ref_init(c, n.c)
            let alias_ro = place_init && n.d == 2 && !writable(c, root(c, n.c).key)
            if place_init && n.d != 1 && !alias_ro { return let_ref(inout c, n, declared) }
            let kind = if n.d == 0 { ir.L_LET } else { ir.L_VAR }
            let mut fin = declared.copy()
            let mut l: u32 = 0
            if is_value_form(c, n.c) {
                l = ir.local(inout c.ir, n.a, declared, kind, n.line)
                let t = compile_value(inout c, n.c, Dest(D_VAR, l), declared)?
                if fin == NONE { fin = t }
                check_bindable(c, t, fin, init.line, init.col)?
                ir.set_local_ty(inout c.ir, l, fin)
            } else {
                let v = expr(inout c, n.c, declared)?
                if fin == NONE { fin = v.ty }
                check_bindable(c, v.ty, fin, init.line, init.col)?
                if alias_ro {
                    let what = q("`let mut ", nm(c, n.a), "`")
                    let rr = root(c, n.c)
                    let ad = alias_error(c, rr.line, rr.col, what, rr.key, copy_fix(c, fin, n.e, n.f))
                    record(inout c, ad)
                }
                let o = take(inout c, v, n.line)
                l = ir.local(inout c.ir, n.a, fin, kind, n.line)
                emit(inout c, ir.S_COPY, l, o, 0, 0, fin, n.line)
            }
            register(inout c, l, fin)
            declare(inout c, local_at(resolve.key(0, n.a), fin, n.d != 0, n.line, n.col, l))?
            if n.d == 1 { note_var(inout c, n, place_init, fin, List.new()) }
            Ok(types.UNIT)
        }
        ast.SLetPat => let_pat(inout c, n)
        ast.SAssign => assign(inout c, n)
        ast.SExpr => compile_value(inout c, n.a, Dest(D_DISCARD, 0), NONE)
        ast.SWhile => {
            let lm = ir.open(c.ir)
            let base = c.fmarks.len() as u32
            // temporaries of the condition live for one iteration
            push_frame(inout c)
            let cv = expr(inout c, n.a, types.BOOL)?
            if !same(c, cv.ty, types.BOOL) {
                let cn = nd(c, n.a)
                return Err(mismatch(c, cn.line, cn.col, types.BOOL, cv.ty))
            }
            c.loops += 1
            c.loop_bases.push(base)
            emit_exit_unless(inout c, cv.op, base, n.line)
            block_body(inout c, n.b, Dest(D_DISCARD, 0), NONE)?
            pop_frame(inout c, true)
            c.loop_bases.pop()
            c.loops -= 1
            let body = ir.close(inout c.ir, lm)
            let step = ir.empty_block(inout c.ir)
            emit(inout c, ir.S_LOOP, 0, body, step, 0, 0, n.line)
            Ok(types.UNIT)
        }
        ast.SFor => for_range(inout c, n)
        ast.SForEach => for_each(inout c, n)
        ast.SReturn => {
            if n.a == 0 {
                if c.ret != types.UNIT { return Err(err("E0401", n.line, n.col, q("`return` needs a value of type ", ts(c, c.ret), ""))) }
                drop_frames_from(inout c, 0)
                emit(inout c, ir.S_RETURN, 0, 0, 0, 0, 0, n.line)
                return Ok(types.NEVER)
            }
            let e = nd(c, n.a - 1)
            if c.ret == types.UNIT && e.kind == ast.ETuple && e.d == 0 {
                // `return ()` is `return`
                drop_frames_from(inout c, 0)
                emit(inout c, ir.S_RETURN, 0, 0, 0, 0, 0, n.line)
                return Ok(types.NEVER)
            }
            if c.ret == types.UNIT { return Err(err("E0401", e.line, e.col, s("this function returns (), it can't return a value"))) }
            let ret = c.ret.copy()
            let t = compile_value(inout c, n.a - 1, Dest(D_RETURN, 0), ret)?
            if !same(c, t, c.ret) && t != types.NEVER { return Err(mismatch(c, e.line, e.col, c.ret, t)) }
            Ok(types.NEVER)
        }
        ast.SBreak => loop_exit(inout c, n, ir.S_BREAK)
        ast.SContinue => loop_exit(inout c, n, ir.S_CONTINUE)
        ast.SError => {
            // reported by the parser; the names it would have declared are unknown
            c.body_err = true
            Ok(types.UNIT)
        }
        _ => {
            // SAssert
            let cv = expr(inout c, n.a, types.BOOL)?
            if !same(c, cv.ty, types.BOOL) {
                let cn = nd(c, n.a)
                return Err(mismatch(c, cn.line, cn.col, types.BOOL, cv.ty))
            }
            let mut msg: u32 = 0
            if n.b > 0 {
                c.ir.strs.push(c.p.mods[c.am as usize].strs[(n.b - 1) as usize])
                msg = c.ir.strs.len() as u32
            }
            emit(inout c, ir.S_ASSERT, 0, cv.op, msg, 0, 0, n.line)
            Ok(types.UNIT)
        }
    }
}

/// `let PAT = init`.
fn let_pat(inout c: C, n: ast.Node) -> Result[u32, diag.Diag] {
    let init = nd(c, n.c)
    // of a place (not `var`): the bindings are references into it ("References")
    let place_init = ref_init(c, n.c)
    let is_ref = place_init && n.d != 1
    let mut vty: u32 = 0
    let mut acc: u32 = 0
    if is_ref {
        let sp = snap(c)
        match place_expr(inout c, n.c) {
            Ok(pv) => {
                if c.rec.on && init.kind == ast.EField { note_ty(inout c, init, pv.ty) }
                vty = pv.ty
                acc = pv.place
            }
            Err(d) => {
                if fatal(d) { return Err(d) }
                record(inout c, d)
                restore(inout c, sp)
                bind_pat_poison(inout c, n.a)
                return Ok(types.UNIT)
            }
        }
        check_bindable(c, vty, vty, init.line, init.col)?
        if poisoned(c, vty) {
            bind_pat_poison(inout c, n.a)
            return Ok(types.UNIT)
        }
    } else {
        let v = expr(inout c, n.c, NONE)?
        check_bindable(c, v.ty, v.ty, init.line, init.col)?
        if poisoned(c, v.ty) {
            bind_pat_poison(inout c, n.a)
            return Ok(types.UNIT)
        }
        vty = v.ty
        acc = place_of_op(inout c, v.op, v.ty, n.line)
    }
    let mut lw = Lowered(List.new(), List.new())
    c.pat_bad = false
    let pir = lower_pat(inout c, n.a, vty, acc, inout lw)?
    let mut rows = pats.empty(1)
    let mut row: List[u32] = List.new()
    row.push(pir)
    pats.add_row(inout rows, row)
    let mut tys: List[u32] = List.new()
    tys.push(vty)
    let missing: Option[List[List[u8]]] = if c.pat_bad { None } else { pats.missing(c.pt, c.t, c.p.names, rows, tys) }
    match missing {
        Some(w) => {
            let pn = nd(c, n.a)
            return Err(errh("E0101", pn.line, pn.col, q("refutable pattern in `let`: `", w[0], "` is not matched"), "use `match` or `if let` for patterns that can fail"))
        }
        None => {}
    }
    let rk: u64 = if is_ref { root(c, n.c).key } else { 0 }
    for b in lw.binds {
        let mutable = n.d == 1 || b.mutable
        if is_ref {
            if !b.mutable || writable(c, rk) {
                let fx = copy_fix(c, vty, n.e, n.f)
                let mut v = new_ref(inout c, b.key, b.ty, b.place, b.mutable, rk, b.line, b.col, fx)
                v.dline = n.line
                v.dcol = n.col
                declare(inout c, v)?
                continue
            }
            // a mutable alias of a read-only place: it owns a copy (E0307)
            let ad = alias_error(c, b.line, b.col, q("`mut ", kt(c, b.key), "`"), rk, copy_fix(c, vty, n.e, n.f))
            record(inout c, ad)
        }
        let kind = if mutable { ir.L_VAR } else { ir.L_LET }
        let l = ir.local(inout c.ir, resolve.key_sym(b.key), b.ty, kind, b.line)
        bind_value(inout c, l, b.ty, b.place)
        declare(inout c, Local(b.key, b.ty, mutable, false, true, b.line, b.col, l, n.line, n.col, b.line, b.col, NONE, NONE, 0))?
    }
    if n.d == 1 { note_var(inout c, n, place_init, vty, lw.binds) }
    Ok(types.UNIT)
}

/// `let x = place` or `let mut x = place` (n.d 0 or 2; the place's root may be written for
/// `let mut`): x refers to the place ("References").
fn let_ref(inout c: C, n: ast.Node, declared: u32) -> Result[u32, diag.Diag] {
    let init = nd(c, n.c)
    let key = resolve.key(0, n.a)
    let sp = snap(c)
    let pv = match place_expr(inout c, n.c) {
        Ok(x) => x
        Err(d) => {
            if fatal(d) { return Err(d) }
            record(inout c, d)
            restore(inout c, sp)
            // a failed initializer: the name has the error type (as `expr` would give it)
            let pt = poison(inout c)
            let fin = if declared != NONE { declared } else { pt }
            let l = ir.local(inout c.ir, n.a, fin, ir.L_LET, n.line)
            declare(inout c, local_at(key, fin, n.d == 2, n.line, n.col, l))?
            return Ok(types.UNIT)
        }
    }
    if c.rec.on && init.kind == ast.EField { note_ty(inout c, init, pv.ty) }
    let fin = if declared != NONE { declared } else { pv.ty }
    check_bindable(c, pv.ty, fin, init.line, init.col)?
    let rk = root(c, n.c).key
    let fx = copy_fix(c, fin, n.e, n.f)
    let v = new_ref(inout c, key, fin, pv.place, n.d == 2, rk, n.line, n.col, fx)
    declare(inout c, v)?
    Ok(types.UNIT)
}

// ---- Migration of `var` (docs/compiler.md, "C8.6")
//
// `var` is deprecated: `var x = place` is `let mut x = place.copy()` (a `var` makes its own
// value), `var x = fresh` is `let mut x = fresh`, `var (a, b) = e` is `let (mut a, mut b) = e`
// (with `.copy()` when e is a place). Every `var` of a body checked with concrete types is
// recorded with those edits; `eiderc migrate-var` applies them. A `var` of a place whose
// type lacks Copy, or of a place in a generic body (where `.copy()` may need a bound), is left.

fn note_var(inout c: C, n: ast.Node, place: bool, ty: u32, binds: List[Bind]) {
    // (in a generic body only a fresh value: `.copy()` of a place could need a bound)
    if (place && generic_body(c)) || poisoned(c, ty) { return }
    let mut fx: List[diag.Fix] = List.new()
    if place {
        // `.copy()` must make what `var` made: the implicit copy, which shares a Mutex and a
        // record with its own Drop and never runs an own `copy`
        let mut seen: Map[u32, bool] = Map.new()
        if copy_differs(c, ty, inout seen) { return }
        match copy_fix(c, ty, n.e, n.f) {
            Some(f) => fx.push(f)
            None => { return }
        }
    }
    if n.kind == ast.SLet {
        fx.push(diag.Fix(n.line, n.col, 3, s("let mut")))
    } else {
        fx.push(diag.Fix(n.line, n.col, 3, s("let")))
        for b in binds {
            if !b.mutable { fx.push(diag.Fix(b.line, b.col, 0, s("mut "))) }
        }
    }
    c.rf.vars.push(VarSite(c.am, fx))
}

/// Whether `.copy()` of a ty differs from the copy binding and passing make: ty holds a
/// Mutex (`.copy()` makes a new one), a record with its own Drop (`.copy()` gives it a buffer
/// of its own) or a type with its own Copy (`.copy()` runs it).
fn copy_differs(c: C, ty: u32, inout seen: Map[u32, bool]) -> bool {
    if seen.contains(ty) { return false }
    seen.insert(ty, true)
    let t = types.get(c.t, ty)
    let k = t.kind
    if k == types.T_MUTEX { return true }
    if k == types.T_LIST || k == types.T_BOX || k == types.T_ARRAY { return copy_differs(c, t.a, inout seen) }
    if k == types.T_MAP { return copy_differs(c, t.a, inout seen) || copy_differs(c, t.b, inout seen) }
    if k == types.T_TUPLE {
        for x in types.elems(c.t, ty) {
            if copy_differs(c, x, inout seen) { return true }
        }
        return false
    }
    if k != types.T_RECORD && k != types.T_ENUM { return false }
    if custom(c, TR_COPY, ty) || has_drop(c, ty) { return true }
    let d = c.t.defs[t.a as usize]
    if d.is_enum {
        for i in 0..d.len {
            let v = types.variant(c.t, d, i)
            for j in 0..v.flen {
                if copy_differs(c, types.field(c.t, v.fstart, j).ty, inout seen) { return true }
            }
        }
        return false
    }
    for j in 0..d.len {
        if copy_differs(c, types.field(c.t, d.start, j).ty, inout seen) { return true }
    }
    false
}

/// The edits that rewrite the `var`s of module m (each edit once, last in the file first, so
/// they can be applied in order).
pub fn var_fixes(c: C, m: u32) -> List[diag.Fix] {
    let mut all: List[diag.Fix] = List.new()
    for v in c.rf.vars {
        if v.m != m { continue }
        for f in v.fixes {
            let mut dup = false
            for g in all {
                if g.line == f.line && g.col == f.col { dup = true }
            }
            if !dup { all.push(f) }
        }
    }
    // insertion sort, by position, descending
    let mut out: List[diag.Fix] = List.new()
    for f in all {
        let mut i: usize = 0
        while i < out.len() && (out[i].line > f.line || (out[i].line == f.line && out[i].col > f.col)) { i += 1 }
        let mut next: List[diag.Fix] = List.new()
        for j in 0..i { next.push(out[j]) }
        next.push(f)
        for j in i..out.len() { next.push(out[j]) }
        out = next
    }
    out
}

fn loop_exit(inout c: C, n: ast.Node, kind: u32) -> Result[u32, diag.Diag] {
    if c.loops == 0 { return Err(err("E0306", n.line, n.col, s("`break`/`continue` outside of a loop"))) }
    let base: u32 = if c.loop_bases.len() > 0 { c.loop_bases[c.loop_bases.len() - 1] } else { 0 }
    drop_frames_from(inout c, base)
    emit(inout c, kind, 0, 0, 0, 0, 0, n.line)
    Ok(types.NEVER)
}

/// `if !cond { <drop frames base..>; break }` at the top of a loop body.
fn emit_exit_unless(inout c: C, cond: u32, base: u32, line: u32) {
    let then = ir.empty_block(inout c.ir)
    let m = ir.open(c.ir)
    drop_frames_from(inout c, base)
    emit(inout c, ir.S_BREAK, 0, 0, 0, 0, 0, line)
    let els = ir.close(inout c.ir, m)
    emit(inout c, ir.S_IF, 0, cond, then, els, 0, line)
}

fn for_range(inout c: C, n: ast.Node) -> Result[u32, diag.Diag] {
    let mut vl = v_of(types.UNIT, 0)
    let mut vh = v_of(types.UNIT, 0)
    if is_lit(c, n.b) && !is_lit(c, n.c) {
        vh = expr(inout c, n.c, NONE)?
        vl = expr(inout c, n.b, vh.ty)?
    } else {
        vl = expr(inout c, n.b, NONE)?
        vh = expr(inout c, n.c, vl.ty)?
    }
    let lo = nd(c, n.b)
    let hi = nd(c, n.c)
    if !poisoned(c, vl.ty) && !types.is_int(c.t, vl.ty) {
        return Err(err("E0401", lo.line, lo.col, q("range bounds must be integers, found ", ts(c, vl.ty), "")))
    }
    if !same(c, vh.ty, vl.ty) { return Err(mismatch(c, hi.line, hi.col, vl.ty, vh.ty)) }
    // an error bound: the variable is of the other bound's type, else of the error type
    let it = if poisoned(c, vl.ty) { vh.ty } else { vl.ty }
    // i := lo; end := hi; loop { if !(i < end) break; body } step { i = i +% 1 }
    let end = place_of_op(inout c, vh.op, it, n.line)
    let l = ir.local(inout c.ir, n.a, it, ir.L_LET, n.line)
    emit(inout c, ir.S_COPY, l, vl.op, 0, 0, it, n.line)
    let pl = ir.place_local(inout c.ir, l, it)
    let lm = ir.open(c.ir)
    let iv = read(inout c, pl, it, 0)
    let ev = read(inout c, end, it, 0)
    let cond = emit_val(inout c, ir.S_BINARY, ast.OP_LT, iv, ev, it, types.BOOL, 0)
    let base = c.fmarks.len() as u32
    emit_exit_unless(inout c, cond, base, n.line)
    c.loops += 1
    c.loop_bases.push(base)
    push_scope(inout c)
    declare(inout c, local_plain(resolve.key(0, n.a), it, false, n.line, n.col, l))?
    block_body(inout c, n.d, Dest(D_DISCARD, 0), NONE)?
    pop_scope(inout c)
    c.loop_bases.pop()
    c.loops -= 1
    let body = ir.close(inout c.ir, lm)
    let sm = ir.open(c.ir)
    let cur = read(inout c, pl, it, 0)
    let one = ir.op_int(inout c.ir, it, 1)
    let next = emit_val(inout c, ir.S_BINARY, ast.OP_WADD, cur, one, it, it, 0)
    emit(inout c, ir.S_STORE, 0, pl, next, 0, it, 0)
    let step = ir.close(inout c.ir, sm)
    emit(inout c, ir.S_LOOP, 0, body, step, 0, 0, n.line)
    Ok(types.UNIT)
}

fn for_each(inout c: C, n: ast.Node) -> Result[u32, diag.Diag] {
    let mut pv = place_expr(inout c, n.b)?
    let mut snapshot = false
    if types.kind(c.t, pv.ty) == types.T_MAP {
        // over a Map: its (key, value) pairs, a List of copies made before the loop, so the
        // body may change the Map (docs/compiler.md, "C8.20")
        let ro = recv_op(inout c, pv)
        let lt = map_list_type(inout c, pv.ty, M_ENTRIES)
        let mut eargs: List[u32] = List.new()
        eargs.push(ro)
        let o = builtin_op(inout c, ir.B_MAP_ENTRIES, eargs, lt, n.line)
        let tl = tmp(inout c, lt, n.line)
        emit(inout c, ir.S_COPY, tl, o, 0, 0, lt, n.line)
        register(inout c, tl, lt)
        pv = PV(ir.place_local(inout c.ir, tl, lt), lt, NONE)
        snapshot = true
    }
    let t = types.get(c.t, pv.ty)
    // (over a type parameter, with the bound, the body is checked as over an error value)
    let err_seq = t.kind == types.T_POISON || (t.kind == types.T_PARAM && has_trait(c, TR_ITER, pv.ty))
    if t.kind == types.T_PARAM && !err_seq {
        let itn = nd(c, n.b)
        return Err(bound_err(c, itn.line, itn.col, s("`for`"), trait_names(c, iter_only()), pv.ty))
    }
    if (t.kind == types.T_RECORD || t.kind == types.T_ENUM) && custom(c, TR_ITER, pv.ty) { return for_iter(inout c, n, pv) }
    if t.kind != types.T_ARRAY && t.kind != types.T_LIST && !err_seq {
        let itn = nd(c, n.b)
        return Err(errh("E0401", itn.line, itn.col, q("can't iterate over a value of type ", ts(c, pv.ty), ""), "iterate over a List, an array, a Map, a range (`for i in 0..n`) or a type that implements `Iter`"))
    }
    let is_list = t.kind == types.T_LIST
    // over an error value the body is still checked, with the variable of the error type
    let et = if err_seq { poison(inout c) } else { t.a }
    // arrays are copied first; a List is iterated in place, its length read every time:
    // i := 0; loop { if !(i < len) break; x := clone(seq[i]); body } step { i = i +% 1 }
    let mut seq = pv.place.copy()
    if !is_list {
        let mut o = pv.op.copy()
        if o == NONE { o = read(inout c, pv.place, pv.ty, 0) }
        seq = place_of_op(inout c, o, pv.ty, n.line)
    }
    let idx = tmp(inout c, types.USIZE, n.line)
    let zero = ir.op_int(inout c.ir, types.USIZE, 0)
    emit(inout c, ir.S_COPY, idx, zero, 0, 0, types.USIZE, n.line)
    let ip = ir.place_local(inout c.ir, idx, types.USIZE)
    let lm = ir.open(c.ir)
    // a List is read again every iteration: the references it is named through stay alive
    // for the whole loop ("References")
    if is_list && c.rf.any && !snapshot { note_uses(inout c, n.b) }
    let iv = read(inout c, ip, types.USIZE, 0)
    let mut lim = ir.op_int(inout c.ir, types.USIZE, t.b as u64)
    if is_list {
        let lv = read(inout c, seq, pv.ty, 0)
        let mut largs: List[u32] = List.new()
        largs.push(lv)
        lim = builtin_op(inout c, ir.B_LEN, largs, types.USIZE, 0)
    }
    let cond = emit_val(inout c, ir.S_BINARY, ast.OP_LT, iv, lim, types.USIZE, types.BOOL, 0)
    let base = c.fmarks.len() as u32
    emit_exit_unless(inout c, cond, base, n.line)
    c.loops += 1
    c.loop_bases.push(base)
    push_frame(inout c)
    push_scope(inout c)
    let l = ir.local(inout c.ir, n.a, et, ir.L_LET, n.line)
    let mut eline: u32 = 0
    if is_list { eline = n.line }
    let ep = ir.place_index(inout c.ir, seq, iv, et, eline)
    bind_value(inout c, l, et, ep)
    if n.e > 0 {
        let lp = ir.place_local(inout c.ir, l, et)
        for_pat(inout c, n, et, lp)?
    } else {
        declare(inout c, local_plain(resolve.key(0, n.a), et, false, n.line, n.col, l))?
    }
    block_body(inout c, n.d, Dest(D_DISCARD, 0), NONE)?
    pop_scope(inout c)
    pop_frame(inout c, true)
    c.loop_bases.pop()
    c.loops -= 1
    let body = ir.close(inout c.ir, lm)
    let sm = ir.open(c.ir)
    let cur = read(inout c, ip, types.USIZE, 0)
    let one = ir.op_int(inout c.ir, types.USIZE, 1)
    let next = emit_val(inout c, ir.S_BINARY, ast.OP_WADD, cur, one, types.USIZE, types.USIZE, 0)
    emit(inout c, ir.S_STORE, 0, ip, next, 0, types.USIZE, 0)
    let step = ir.close(inout c.ir, sm)
    emit(inout c, ir.S_LOOP, 0, body, step, 0, 0, n.line)
    Ok(types.UNIT)
}

/// The bindings of `for (pattern) in e` (n.e) from the element held at place `acc` (an
/// unnamed loop local of type et): each binding owns a copy of its part, as a `for`
/// variable does (C8.6), and the pattern must not be refutable (E0101).
fn for_pat(inout c: C, n: ast.Node, et: u32, acc: u32) -> Result[bool, diag.Diag] {
    if poisoned(c, et) {
        bind_pat_poison(inout c, n.e - 1)
        return Ok(true)
    }
    let mut lw = Lowered(List.new(), List.new())
    c.pat_bad = false
    let pir = lower_pat(inout c, n.e - 1, et, acc, inout lw)?
    let mut rows = pats.empty(1)
    let mut row: List[u32] = List.new()
    row.push(pir)
    pats.add_row(inout rows, row)
    let mut tys: List[u32] = List.new()
    tys.push(et)
    let missing: Option[List[List[u8]]] = if c.pat_bad { None } else { pats.missing(c.pt, c.t, c.p.names, rows, tys) }
    match missing {
        Some(w) => {
            let pn = nd(c, n.e - 1)
            return Err(errh("E0101", pn.line, pn.col, q("refutable pattern in `for`: `", w[0], "` is not matched"), "match on each element inside the loop instead"))
        }
        None => {}
    }
    for b in lw.binds {
        let kind = if b.mutable { ir.L_VAR } else { ir.L_LET }
        let l = ir.local(inout c.ir, resolve.key_sym(b.key), b.ty, kind, b.line)
        bind_value(inout c, l, b.ty, b.place)
        declare(inout c, Local(b.key, b.ty, b.mutable, false, true, b.line, b.col, l, n.line, n.col, b.line, b.col, NONE, NONE, 0))?
    }
    Ok(true)
}

/// `for x in e` over a type with its own Iter ("Operation traits"): the loop runs on a copy
/// of e, owned by the loop and dropped after it:
/// it := e; loop { r := it.next(); if !(r is Some) break; x := r's item; body }
fn for_iter(inout c: C, n: ast.Node, pv: PV) -> Result[u32, diag.Diag] {
    let ty = pv.ty
    let ix = custom_impl(c, TR_ITER, ty)
    let ii = impl_instance(inout c, TR_ITER, ix, ty)?
    // (an impl without `next` was reported)
    if ii == NONE { return Err(quiet()) }
    let inst = c.insts[ii as usize].copy()
    let fnode = ndm(c, c.fdefs[inst.fd as usize].md, c.fdefs[inst.fd as usize].node)
    for i in 0..fnode.j {
        let cap = ndm(c, c.fdefs[inst.fd as usize].md, atm(c, c.fdefs[inst.fd as usize].md, fnode.i, i)).a
        if !has_sym(c.caps, cap) {
            let rd = cap_error(c, n.line, n.col, label_of(c, ts(c, ty), c.lt.meths[TR_ITER as usize]), cap)
            record(inout c, rd)
            break
        }
    }
    let oty = inst.ret.copy()
    let mut et = poison(inout c)
    let mut si: u32 = 0
    if types.kind(c.t, oty) == types.T_ENUM && !poisoned(c, oty) {
        let od = types.def_of(c.t, oty)
        for i in 0..od.len {
            let v = types.variant(c.t, od, i)
            if v.flen == 1 {
                si = i
                et = types.field(c.t, v.fstart, 0).ty
            }
        }
    }
    let mut o = pv.op.copy()
    if o == NONE { o = read(inout c, pv.place, ty, 0) }
    let owned = take(inout c, v_of(ty, o), n.line)
    let itl = tmp(inout c, ty, n.line)
    emit(inout c, ir.S_COPY, itl, owned, 0, 0, ty, n.line)
    register(inout c, itl, ty)
    let itp = ir.place_local(inout c.ir, itl, ty)
    let lm = ir.open(c.ir)
    let base = c.fmarks.len() as u32
    push_frame(inout c)
    let st = ir.list(inout c.ir, one(itp + ir.ARG_PLACE))
    let r = emit_val(inout c, ir.S_CALL, inst.ir, st, 1, oty, oty, n.line)
    let rv = mk_fresh(inout c, v_of(oty, r), n.line)
    let rp = place_of_op(inout c, rv.op, oty, n.line)
    let cond = emit_val(inout c, ir.S_TAG, rp, si, 0, oty, types.BOOL, n.line)
    emit_exit_unless(inout c, cond, base, n.line)
    c.loops += 1
    c.loop_bases.push(base)
    push_scope(inout c)
    let l = ir.local(inout c.ir, n.a, et, ir.L_LET, n.line)
    let ep = ir.place_payload(inout c.ir, rp, si, 0, et)
    bind_value(inout c, l, et, ep)
    if n.e > 0 {
        let lp = ir.place_local(inout c.ir, l, et)
        for_pat(inout c, n, et, lp)?
    } else {
        declare(inout c, local_plain(resolve.key(0, n.a), et, false, n.line, n.col, l))?
    }
    block_body(inout c, n.d, Dest(D_DISCARD, 0), NONE)?
    pop_scope(inout c)
    pop_frame(inout c, true)
    c.loop_bases.pop()
    c.loops -= 1
    let body = ir.close(inout c.ir, lm)
    let step = ir.empty_block(inout c.ir)
    emit(inout c, ir.S_LOOP, 0, body, step, 0, 0, n.line)
    Ok(types.UNIT)
}

/// The variable an assignment target or `inout` argument is rooted at.
type Root = { ok: bool, key: u64, line: u32, col: u32 }

fn root(c: C, e: u32) -> Root {
    let n = nd(c, e)
    if n.kind == ast.EIdent { return Root(true, ekey(c, n), n.line, n.col) }
    if n.kind == ast.EField || n.kind == ast.EIndex { return root(c, n.a) }
    Root(false, 0, 0, 0)
}

fn check_assignable(c: C, target: u32, verb: str) -> Result[bool, diag.Diag] {
    let r = root(c, target)
    if !r.ok {
        let tn = nd(c, target)
        return Err(err("E0303", tn.line, tn.col, q3("cannot ", s(verb), " this expression", List.new(), "", List.new(), "")))
    }
    let li = lookup(c, r.key)
    if li != NONE {
        let v = c.scopes[li as usize]
        if v.mutable || v.byref { return Ok(true) }
        let mut d = err("E0303", r.line, r.col, q2("cannot ", s(verb), " `", kt(c, r.key), "`: it is not mutable"))
        if v.has_decl {
            d.help = q("declare `", kt(c, r.key), "` with `var`")
            d.fix = Some(diag.Fix(v.dline, v.dcol, 3, s("var")))
        } else {
            d.help = s("parameters are immutable; declare it `inout` to modify the caller's value")
        }
        return Err(d)
    }
    if c.consts.contains(r.key) { return Err(err("E0303", r.line, r.col, q2("cannot ", s(verb), " constant `", kt(c, r.key), "`"))) }
    Err(err("E0110", r.line, r.col, q("unknown name `", kt(c, r.key), "`")))
}

fn assign(inout c: C, n: ast.Node) -> Result[u32, diag.Diag] {
    at_pos(inout c, n.line, n.col)
    let r = assign_in(inout c, n)
    end_pos(inout c)
    r
}

fn assign_in(inout c: C, n: ast.Node) -> Result[u32, diag.Diag] {
    match check_assignable(c, n.a, "assign to") {
        Ok(_) => {}
        Err(d) => {
            // the value is still checked
            record(inout c, d)
            let pt = poison(inout c)
            expr(inout c, n.c, pt)?
            return Ok(types.UNIT)
        }
    }
    let tv = place_expr(inout c, n.a)?
    let vn = nd(c, n.c)
    if n.b == 0 && is_value_form(c, n.c) {
        let t0 = tmp(inout c, tv.ty, n.line)
        let t = compile_value(inout c, n.c, Dest(D_VAR, t0), tv.ty)?
        check_bindable(c, t, tv.ty, vn.line, vn.col)?
        let o = ir.op_local(inout c.ir, t0, tv.ty)
        if owns(c, tv.ty) { emit_drop(inout c, tv.place, tv.ty) }
        emit(inout c, ir.S_STORE, 0, tv.place, o, 0, tv.ty, n.line)
        return Ok(types.UNIT)
    }
    let vv = expr(inout c, n.c, tv.ty)?
    if !same(c, vv.ty, tv.ty) { return Err(mismatch(c, vn.line, vn.col, tv.ty, vv.ty)) }
    if n.b == 0 {
        let o = take(inout c, vv, n.line)
        if owns(c, tv.ty) { emit_drop(inout c, tv.place, tv.ty) }
        emit(inout c, ir.S_STORE, 0, tv.place, o, 0, tv.ty, n.line)
        return Ok(types.UNIT)
    }
    let op = n.b - 1
    if !types.is_int(c.t, tv.ty) && !poisoned(c, tv.ty) && !poisoned(c, vv.ty) {
        return Err(err("E0401", n.line, n.col, q2("operator ", s(ast.op_text(op)), "= needs integers, found ", ts(c, tv.ty), "")))
    }
    if (op == ast.OP_SHL || op == ast.OP_SHR) && types.is_int(c.t, tv.ty) { check_shift(c, vn, types.ik(c.t, tv.ty), vv)? }
    let cur = read(inout c, tv.place, tv.ty, n.line)
    let r = emit_val(inout c, ir.S_BINARY, op, cur, vv.op, tv.ty, tv.ty, n.line)
    emit(inout c, ir.S_STORE, 0, tv.place, r, 0, tv.ty, n.line)
    Ok(types.UNIT)
}

// ---- value forms

fn compile_value(inout c: C, e: u32, dest: Dest, exp: u32) -> Result[u32, diag.Diag] {
    let n = nd(c, e)
    if n.kind == ast.EIf { return compile_if(inout c, n, dest, exp) }
    if n.kind == ast.EMatch { return compile_match(inout c, n, dest, exp) }
    if n.kind == ast.EBlock { return block_body(inout c, n.a, dest, exp) }
    if n.kind == ast.EUnsafe {
        c.unsafe_depth += 1
        let r = block_body(inout c, n.a, dest, exp)
        c.unsafe_depth -= 1
        return r
    }
    let v = expr(inout c, e, exp)?
    if v.ty == types.NEVER { return Ok(types.NEVER) }
    if dest.kind == D_RETURN {
        if !same(c, v.ty, c.ret) { return Err(mismatch(c, n.line, n.col, c.ret, v.ty)) }
        let o = take(inout c, v, n.line)
        drop_frames_from(inout c, 0)
        emit(inout c, ir.S_RETURN, 0, o + 1, 0, 0, 0, n.line)
        return Ok(v.ty)
    }
    if dest.kind == D_VAR {
        if v.ty == types.UNIT { return Err(err("E0401", n.line, n.col, s("cannot bind a value of type ()"))) }
        let o = take(inout c, v, n.line)
        emit(inout c, ir.S_COPY, dest.local, o, 0, 0, v.ty, n.line)
        return Ok(v.ty)
    }
    Ok(types.UNIT)
}

fn unify(c: C, a: u32, b: u32, line: u32, col: u32) -> Result[u32, diag.Diag] {
    if a == types.NEVER { return Ok(b) }
    if b == types.NEVER || a == b { return Ok(a) }
    if poisoned(c, a) { return Ok(b) }
    if poisoned(c, b) { return Ok(a) }
    Err(err("E0401", line, col, q2("branches have different types: ", ts(c, a), " and ", ts(c, b), "")))
}

fn compile_if(inout c: C, n: ast.Node, dest: Dest, exp: u32) -> Result[u32, diag.Diag] {
    let cv = expr(inout c, n.a, types.BOOL)?
    if !same(c, cv.ty, types.BOOL) {
        let cn = nd(c, n.a)
        return Err(mismatch(c, cn.line, cn.col, types.BOOL, cv.ty))
    }
    let tm = ir.open(c.ir)
    let t1 = block_body(inout c, n.b, dest, exp)?
    let then = ir.close(inout c.ir, tm)
    if n.c == 0 {
        let els = ir.empty_block(inout c.ir)
        emit(inout c, ir.S_IF, 0, cv.op, then, els, 0, n.line)
        return Ok(types.UNIT)
    }
    let el = nd(c, n.c - 1)
    let em = ir.open(c.ir)
    let mut t2 = types.UNIT
    if el.kind == ast.EBlock {
        t2 = block_body(inout c, el.a, dest, exp)?
    } else {
        t2 = compile_value(inout c, n.c - 1, dest, exp)?
    }
    let els = ir.close(inout c.ir, em)
    emit(inout c, ir.S_IF, 0, cv.op, then, els, 0, n.line)
    unify(c, t1, t2, el.line, el.col)
}

// ---- patterns

fn lower_pat(inout c: C, pat: u32, ty: u32, place: u32, inout lw: Lowered) -> Result[u32, diag.Diag] {
    let n = nd(c, pat)
    let tk = types.kind(c.t, ty)
    if tk == types.T_POISON {
        // matching an error value: the names bind to it, and the match is not judged
        // (reachability, exhaustiveness)
        c.pat_bad = true
        poison_binds(inout c, pat, ty, place, inout lw)
        return Ok(pats.WILD)
    }
    match n.kind {
        ast.PWild => Ok(pats.WILD)
        ast.PName => {
            let k = resolve.name_key(c.p, c.am, n.a, n.b, n.line, n.col)
            if tk == types.T_ENUM {
                let d = types.def_of(c.t, ty)
                match types.find_variant(c.t, d, k) {
                    Some(vi) => {
                        let v = types.variant(c.t, d, vi)
                        if v.flen > 0 {
                            return Err(err("E0410", n.line, n.col, q3("variant `", kt(c, k), "` has ", num(v.flen as u64), " field(s); write `", kt(c, k), "(...)`")))
                        }
                        note_variant(inout c, n, d.tmpl, v.key)
                        lw.tests.push(Test(T_TAG, place, ty, vi, fold.zero(), List.new()))
                        return Ok(pats.ctor(inout c.pt, pats.C_VARIANT, vi, 0, List.new()))
                    }
                    None => {}
                }
            }
            let other = mget(c.variants, k)
            if other != NONE {
                return Err(err("E0401", n.line, n.col, q3("`", kt(c, k), "` is a variant of ", kt(c, c.t.defs[other as usize].key), ", but the value has type ", ts(c, ty), "")))
            }
            lw.binds.push(Bind(k, place, ty, n.line, n.col, n.c == 1))
            Ok(pats.WILD)
        }
        ast.PInt => {
            if tk != types.T_INT { return Err(mismatch(c, n.line, n.col, ty, types.I32)) }
            let mut w = lit(c, n.a)
            if n.b == 1 { w = fold.neg(w) }
            let ik = types.ik(c.t, ty)
            if !fits(ik, w) {
                return Err(err("E0501", n.line, n.col, q2("pattern ", fold.text(w), " doesn't fit in ", s(types.int_name(ik)), "")))
            }
            lw.tests.push(Test(T_INT, place, ty, 0, w, List.new()))
            let neg: u32 = if w.neg { 1 } else { 0 }
            Ok(pats.ctor(inout c.pt, pats.C_INT, neg, w.lo, List.new()))
        }
        ast.PBool => {
            if tk != types.T_BOOL { return Err(mismatch(c, n.line, n.col, ty, types.BOOL)) }
            lw.tests.push(Test(T_BOOL, place, ty, n.a, fold.zero(), List.new()))
            Ok(pats.ctor(inout c.pt, pats.C_BOOL, n.a, 0, List.new()))
        }
        ast.PStr => {
            if tk != types.T_STR { return Err(mismatch(c, n.line, n.col, ty, types.STR)) }
            let b = c.p.mods[c.am as usize].strs[n.a as usize].copy()
            let id = intern.intern(inout c.p.names, b, 0, b.len())
            lw.tests.push(Test(T_STR, place, ty, 0, fold.zero(), b))
            Ok(pats.ctor(inout c.pt, pats.C_STR, id, 0, List.new()))
        }
        ast.PTuple => {
            // `()` matches the one unit value
            if n.d == 0 && tk == types.T_UNIT { return Ok(pats.WILD) }
            if tk != types.T_TUPLE { return Err(err("E0401", n.line, n.col, q("tuple pattern used on a value of type ", ts(c, ty), ""))) }
            let es = types.elems(c.t, ty)
            if es.len() as u32 != n.d {
                return Err(err("E0410", n.line, n.col, q2("tuple pattern has ", num(n.d as u64), " elements, but the value has ", num(es.len() as u64), "")))
            }
            let mut subs: List[u32] = List.new()
            for j in 0..n.d {
                let fp = ir.place_field(inout c.ir, place, j, es[j as usize])
                let sp = at(c, n.c, j)
                subs.push(lower_pat(inout c, sp, es[j as usize], fp, inout lw)?)
            }
            Ok(pats.ctor(inout c.pt, pats.C_SINGLE, 0, 0, subs))
        }
        _ => {
            // PVariant
            let k = resolve.name_key(c.p, c.am, n.a, n.b, n.line, n.col)
            if tk == types.T_ENUM {
                let d = types.def_of(c.t, ty)
                match types.find_variant(c.t, d, k) {
                    Some(vi) => {
                        let v = types.variant(c.t, d, vi)
                        if v.flen != n.d {
                            return Err(err("E0410", n.line, n.col, q3("variant `", kt(c, k), "` has ", num(v.flen as u64), " field(s), but the pattern has ", num(n.d as u64), "")))
                        }
                        note_variant(inout c, n, d.tmpl, v.key)
                        lw.tests.push(Test(T_TAG, place, ty, vi, fold.zero(), List.new()))
                        let mut subs: List[u32] = List.new()
                        for j in 0..n.d {
                            let f = types.field(c.t, v.fstart, j)
                            let fp = ir.place_payload(inout c.ir, place, vi, j, f.ty)
                            let sp = at(c, n.c, j)
                            subs.push(lower_pat(inout c, sp, f.ty, fp, inout lw)?)
                        }
                        return Ok(pats.ctor(inout c.pt, pats.C_VARIANT, vi, 0, subs))
                    }
                    None => {}
                }
            }
            if tk == types.T_RECORD {
                let d = types.def_of(c.t, ty)
                if d.key == k {
                    if c.rec.on {
                        let am = c.am.copy()
                        note_def(inout c, am, n, d.tmpl)
                    }
                    if d.len != n.d {
                        return Err(err("E0410", n.line, n.col, q3("`", kt(c, k), "` has ", num(d.len as u64), " field(s), but the pattern has ", num(n.d as u64), "")))
                    }
                    let mut subs: List[u32] = List.new()
                    for j in 0..n.d {
                        let f = types.field(c.t, d.start, j)
                        let fp = ir.place_field(inout c.ir, place, j, f.ty)
                        let sp = at(c, n.c, j)
                        subs.push(lower_pat(inout c, sp, f.ty, fp, inout lw)?)
                    }
                    return Ok(pats.ctor(inout c.pt, pats.C_SINGLE, 0, 0, subs))
                }
            }
            let other = mget(c.variants, k)
            if other != NONE {
                return Err(err("E0401", n.line, n.col, q3("`", kt(c, k), "` is a variant of ", kt(c, c.t.defs[other as usize].key), ", but the value has type ", ts(c, ty), "")))
            }
            Err(err("E0114", n.line, n.col, q2("type ", ts(c, ty), " has no variant or constructor `", kt(c, k), "`")))
        }
    }
}

/// The names pattern `pat` binds, all to `place` of the error type ty.
fn poison_binds(inout c: C, pat: u32, ty: u32, place: u32, inout lw: Lowered) {
    let n = nd(c, pat)
    if n.kind == ast.PName {
        let k = resolve.name_key(c.p, c.am, n.a, n.b, n.line, n.col)
        if !c.variants.contains(k) { lw.binds.push(Bind(k, place, ty, n.line, n.col, n.c == 1)) }
        return
    }
    if n.kind == ast.PVariant || n.kind == ast.PTuple {
        for i in 0..n.d {
            let sp = at(c, n.c, i)
            poison_binds(inout c, sp, ty, place, inout lw)
        }
    }
}

/// One arm alternative: its pattern tests.
type Alt = { tests: List[Test] }

fn compile_match(inout c: C, m: ast.Node, dest: Dest, exp: u32) -> Result[u32, diag.Diag] {
    let sn = nd(c, m.a)
    // a place scrutinee: the bindings are references into it ("References")
    let is_ref = ref_init(c, m.a)
    let mut sv = v_of(types.UNIT, 0)
    let mut place: u32 = NONE
    if is_ref {
        let sp = snap(c)
        match place_expr(inout c, m.a) {
            Ok(pv) => {
                if c.rec.on && sn.kind == ast.EField { note_ty(inout c, sn, pv.ty) }
                sv = v_of(pv.ty, 0)
                place = pv.place
            }
            Err(d) => {
                if fatal(d) { return Err(d) }
                record(inout c, d)
                restore(inout c, sp)
                sv = poison_v(inout c)
            }
        }
    } else {
        sv = expr(inout c, m.a, NONE)?
    }
    // a syntax error inside: an arm may have been skipped, so the match isn't judged
    c.pat_bad = resolve.syntax_in(c.p, c.am, m.line, m.end_line)
    if sv.ty == types.UNIT || sv.ty == types.NEVER {
        return Err(err("E0401", sn.line, sn.col, q("cannot match on a value of type ", ts(c, sv.ty), "")))
    }
    if m.d == 0 { return Err(err("E0101", m.line, m.col, s("match has no arms"))) }
    if place == NONE { place = place_of_op(inout c, sv.op, sv.ty, m.line) }
    let rk: u64 = if place != NONE && is_ref { root(c, m.a).key } else { 0 }
    let sc = Scrut(is_ref, rk, sv.ty, m.e, m.f)
    // lower every pattern, checking reachability
    let mut rows = pats.empty(1)
    let mut tys: List[u32] = List.new()
    tys.push(sv.ty)
    let mut alts: List[Alt] = List.new()
    let mut alt_start: List[u32] = List.new()
    let mut arm_binds: List[List[Bind]] = List.new()
    for i in 0..m.d {
        let arm = nd(c, at(c, m.c, i))
        let mut useful = false
        let mut binds: List[Bind] = List.new()
        alt_start.push(alts.len() as u32)
        if arm.d == 0 {
            // an arm the parser skipped (no patterns, an EError body): the match isn't judged
            c.pat_bad = true
            alts.push(Alt(List.new()))
        }
        for j in 0..arm.d {
            let pid = at(c, arm.c, j)
            let mut lw = Lowered(List.new(), List.new())
            let pir = lower_pat(inout c, pid, sv.ty, place, inout lw)?
            if arm.d > 1 && lw.binds.len() > 0 && !c.pat_bad {
                let pn = nd(c, pid)
                return Err(err("E0001", pn.line, pn.col, s("or-patterns can't bind names")))
            }
            let mut v: List[u32] = List.new()
            v.push(pir)
            if pats.useful(c.pt, c.t, rows, v, tys) { useful = true }
            pats.add_row(inout rows, v)
            alts.push(Alt(lw.tests))
            binds = lw.binds
        }
        if !useful && !c.pat_bad {
            let p0 = nd(c, at(c, arm.c, 0))
            return Err(err("E0102", p0.line, p0.col, s("unreachable arm: everything it matches is already handled above")))
        }
        arm_binds.push(binds)
    }
    alt_start.push(alts.len() as u32)
    let missing: Option[List[List[u8]]] = if c.pat_bad { None } else { pats.missing(c.pt, c.t, c.p.names, rows, tys) }
    match missing {
        Some(w) => {
            return Err(errh("E0101", m.line, m.col, q("non-exhaustive match: `", w[0], "` is not handled"), "add an arm for it, or a `_` arm"))
        }
        None => {}
    }
    match_arms(inout c, m, 0, alts, alt_start, arm_binds, sc, dest, exp, types.NEVER)
}

/// A match's scrutinee as its bindings need it: a place (`is_ref`) rooted at variable `rk`,
/// of type ty, ending just before (line, col) (where a fix puts `.copy()`).
type Scrut = { is_ref: bool, rk: u64, ty: u32, line: u32, col: u32 }

/// Emit arms i.. as an if/else chain (the last arm needs no test: the match is exhaustive);
/// `result` is the unified type of the arms before i.
fn match_arms(inout c: C, m: ast.Node, i: u32, alts: List[Alt], alt_start: List[u32], arm_binds: List[List[Bind]], sc: Scrut, dest: Dest, exp: u32, result: u32) -> Result[u32, diag.Diag] {
    if i + 1 == m.d {
        let t = arm_body(inout c, m, i, arm_binds[i as usize], sc, dest, exp)?
        return finish_match(c, m, i, dest, result, t)
    }
    let cond = alt_cond(inout c, alts, alt_start[i as usize], alt_start[(i + 1) as usize], m.line)
    let tm = ir.open(c.ir)
    let t = arm_body(inout c, m, i, arm_binds[i as usize], sc, dest, exp)?
    let then = ir.close(inout c.ir, tm)
    let r1 = finish_arm(c, m, i, result, t)?
    let em = ir.open(c.ir)
    let r = match_arms(inout c, m, i + 1, alts, alt_start, arm_binds, sc, dest, exp, r1)?
    let els = ir.close(inout c.ir, em)
    emit(inout c, ir.S_IF, 0, cond, then, els, 0, m.line)
    Ok(r)
}

fn arm_pos(c: C, arm: ast.Node) -> ast.Node { nd(c, arm.a) }

fn finish_arm(c: C, m: ast.Node, i: u32, result: u32, t: u32) -> Result[u32, diag.Diag] {
    let arm = nd(c, at(c, m.c, i))
    let b = arm_pos(c, arm)
    unify(c, result, t, b.line, b.col)
}

fn finish_match(c: C, m: ast.Node, i: u32, dest: Dest, result: u32, t: u32) -> Result[u32, diag.Diag] {
    let r = finish_arm(c, m, i, result, t)?
    if dest.kind == D_DISCARD && r != types.NEVER { return Ok(types.UNIT) }
    Ok(r)
}

fn arm_body(inout c: C, m: ast.Node, i: u32, binds: List[Bind], sc: Scrut, dest: Dest, exp: u32) -> Result[u32, diag.Diag] {
    let arm = nd(c, at(c, m.c, i))
    push_scope(inout c)
    push_frame(inout c)
    for b in binds {
        if sc.is_ref {
            if !b.mutable || writable(c, sc.rk) {
                let fx = copy_fix(c, sc.ty, sc.line, sc.col)
                let mut v = new_ref(inout c, b.key, b.ty, b.place, b.mutable, sc.rk, b.line, b.col, fx)
                // (assigning to an arm binding is reported as before: it is no `let`)
                v.has_decl = false
                declare(inout c, v)?
                continue
            }
            // a mutable alias of a read-only place: it owns a copy (E0307)
            let ad = alias_error(c, b.line, b.col, q("`mut ", kt(c, b.key), "`"), sc.rk, copy_fix(c, sc.ty, sc.line, sc.col))
            record(inout c, ad)
        }
        let kind = if b.mutable { ir.L_VAR } else { ir.L_LET }
        let l = ir.local(inout c.ir, resolve.key_sym(b.key), b.ty, kind, b.line)
        bind_value(inout c, l, b.ty, b.place)
        let mut v = local_plain(b.key, b.ty, false, b.line, b.col, l)
        v.mutable = b.mutable
        declare(inout c, v)?
    }
    let mut t = types.UNIT
    if arm.b == 1 {
        t = stmt(inout c, arm.a)?
    } else {
        let body = nd(c, arm.a)
        if body.kind == ast.EBlock {
            t = block_body(inout c, body.a, dest, exp)?
        } else {
            t = compile_value(inout c, arm.a, dest, exp)?
        }
    }
    pop_frame(inout c, t != types.NEVER)
    pop_scope(inout c)
    Ok(t)
}

/// The condition of alternatives [from, to): any alternative whose tests all pass.
fn alt_cond(inout c: C, alts: List[Alt], from: u32, to: u32, line: u32) -> u32 {
    if to - from == 1 { return tests_cond(inout c, alts[from as usize].tests, line) }
    let r = tmp(inout c, types.BOOL, line)
    let first = tests_cond(inout c, alts[from as usize].tests, line)
    emit(inout c, ir.S_COPY, r, first, 0, 0, types.BOOL, line)
    let rv = ir.op_local(inout c.ir, r, types.BOOL)
    for k in from + 1..to {
        // if !r { r = alt k }
        let then = ir.empty_block(inout c.ir)
        let em = ir.open(c.ir)
        let x = tests_cond(inout c, alts[k as usize].tests, line)
        emit(inout c, ir.S_COPY, r, x, 0, 0, types.BOOL, line)
        let els = ir.close(inout c.ir, em)
        emit(inout c, ir.S_IF, 0, rv, then, els, 0, line)
    }
    rv
}

/// All of `tests`, short-circuiting (a payload is only read once its tag matched).
fn tests_cond(inout c: C, tests: List[Test], line: u32) -> u32 {
    if tests.len() == 0 { return ir.op_bool(inout c.ir, true) }
    if tests.len() == 1 { return test_val(inout c, tests[0], line) }
    let r = tmp(inout c, types.BOOL, line)
    let first = test_val(inout c, tests[0], line)
    emit(inout c, ir.S_COPY, r, first, 0, 0, types.BOOL, line)
    let rv = ir.op_local(inout c.ir, r, types.BOOL)
    for k in 1..tests.len() {
        let tm = ir.open(c.ir)
        let x = test_val(inout c, tests[k], line)
        emit(inout c, ir.S_COPY, r, x, 0, 0, types.BOOL, line)
        let then = ir.close(inout c.ir, tm)
        let els = ir.empty_block(inout c.ir)
        emit(inout c, ir.S_IF, 0, rv, then, els, 0, line)
    }
    rv
}

fn test_val(inout c: C, t: Test, line: u32) -> u32 {
    if t.kind == T_TAG { return emit_val(inout c, ir.S_TAG, t.place, t.a, 0, t.ty, types.BOOL, line) }
    let v = read(inout c, t.place, t.ty, 0)
    if t.kind == T_BOOL {
        if t.a == 1 { return v }
        return emit_val(inout c, ir.S_UNARY, ir.U_NOT, v, 0, types.BOOL, types.BOOL, 0)
    }
    let mut k = ir.op_str(inout c.ir, t.s)
    if t.kind == T_INT { k = int_op(inout c, t.ty, t.w) }
    emit_val(inout c, ir.S_BINARY, ast.OP_EQ, v, k, t.ty, types.BOOL, 0)
}

// ---- expressions

/// Is e a place (variable, field, element) rather than a fresh value?
fn is_place(c: C, e: u32) -> bool {
    let n = nd(c, e)
    if n.kind == ast.EIdent { return lookup(c, ekey(c, n)) != NONE }
    if n.kind == ast.EField { return static_tmpl(c, n) == NONE }
    n.kind == ast.EIndex
}

/// Check expression e against the expected type `exp` (NONE: no expectation). An owned
/// rvalue comes back as a registered temporary.
fn expr(inout c: C, e: u32, exp: u32) -> Result[V, diag.Diag] {
    // a recovery point: a failed expression is recorded and stands for an error value
    let sp = snap(c)
    let v = match expr_raw(inout c, e, exp) {
        Ok(x) => x
        Err(d) => {
            if fatal(d) { return Err(d) }
            record(inout c, d)
            restore(inout c, sp)
            return Ok(poison_v(inout c))
        }
    }
    if c.rec.on {
        let n = nd(c, e)
        if n.kind == ast.EIdent || n.kind == ast.EField || n.kind == ast.ECall || n.kind == ast.EMethod { note_ty(inout c, n, v.ty) }
    }
    if !owns(c, v.ty) || is_place(c, e) || is_fresh(c, v.op) { return Ok(v) }
    let line = nd(c, e).line
    Ok(mk_fresh(inout c, v, line))
}

fn expr_raw(inout c: C, e: u32, exp: u32) -> Result[V, diag.Diag] {
    let n = nd(c, e)
    match n.kind {
        ast.EInt => {
            let mut ik = types.IK_I32
            if exp != NONE && types.is_int(c.t, exp) { ik = types.ik(c.t, exp) }
            let w = lit(c, n.a)
            if fold.gt(w, imax(ik)) {
                return Err(err("E0501", n.line, n.col, q3("literal ", fold.text(w), " doesn't fit in ", s(types.int_name(ik)), " (max ", fold.text(imax(ik)), ")")))
            }
            Ok(const_v(inout c, ik, w))
        }
        ast.EBool => {
            let o = ir.op_bool(inout c.ir, n.a == 1)
            Ok(v_of(types.BOOL, o))
        }
        ast.EStr => {
            let text = c.p.mods[c.am as usize].strs[n.a as usize].copy()
            let o = ir.op_str(inout c.ir, text)
            Ok(v_of(types.STR, o))
        }
        ast.EIdent => {
            let k = ekey(c, n)
            let li = lookup(c, k)
            if li != NONE {
                let v = c.scopes[li as usize].copy()
                note_local(inout c, n, v)
                let pl = local_place(inout c, v)
                let o = read(inout c, pl, v.ty, 0)
                return Ok(v_of(v.ty, o))
            }
            ident_value(inout c, n, k, exp)
        }
        ast.EField => {
            let di = static_tmpl(c, n)
            if di != NONE {
                let d = c.t.defs[di as usize]
                if d.is_enum {
                    let fk = resolve.key(0, n.b)
                    match types.find_variant(c.t, d, fk) {
                        Some(_) => {
                            if c.rec.on {
                                let am = c.am.copy()
                                let base = nd(c, n.a)
                                note_def(inout c, am, base, di)
                                note_variant(inout c, n, di, fk)
                            }
                            return construct(inout c, n.line, n.col, di, fk, 0, 0, exp)
                        }
                        None => {
                            return Err(err("E0114", n.line, n.col, q2("enum `", kt(c, d.key), "` has no variant `", nm(c, n.b), "`")))
                        }
                    }
                }
            }
            let pv = place_expr(inout c, e)?
            if pv.op != NONE { return Ok(v_of(pv.ty, pv.op)) }
            let o = read(inout c, pv.place, pv.ty, 0)
            Ok(v_of(pv.ty, o))
        }
        ast.EIndex => {
            let pv = place_expr(inout c, e)?
            if pv.op != NONE { return Ok(v_of(pv.ty, pv.op)) }
            let o = read(inout c, pv.place, pv.ty, n.line)
            Ok(v_of(pv.ty, o))
        }
        ast.EUnary => {
            if n.a == 0 { return negate(inout c, n, exp) }
            if n.a == 2 { return bit_not(inout c, n, exp) }
            let v = expr(inout c, n.b, types.BOOL)?
            if !same(c, v.ty, types.BOOL) {
                let x = nd(c, n.b)
                return Err(mismatch(c, x.line, x.col, types.BOOL, v.ty))
            }
            Ok(v_of(types.BOOL, emit_val(inout c, ir.S_UNARY, ir.U_NOT, v.op, 0, types.BOOL, types.BOOL, n.line)))
        }
        ast.EBinary => binary(inout c, n, exp)
        ast.ECall => call(inout c, n, exp)
        ast.EMethod => method_call(inout c, n, exp)
        ast.ECast => cast(inout c, n)
        ast.EArray => array_lit(inout c, n, exp)
        ast.ERepeat => {
            let mut exp_elem = NONE
            if exp != NONE && types.kind(c.t, exp) == types.T_ARRAY { exp_elem = types.get(c.t, exp).a }
            let v = expr(inout c, n.a, exp_elem)?
            let x = nd(c, n.a)
            if exp_elem != NONE && !same(c, v.ty, exp_elem) { return Err(mismatch(c, x.line, x.col, exp_elem, v.ty)) }
            if owns(c, v.ty) {
                return Err(err("E0401", x.line, x.col, q("`[x; n]` can't repeat a ", ts(c, v.ty), " (it owns heap memory); build the array element by element")))
            }
            let ty = types.array(inout c.t, v.ty, n.b)
            Ok(v_of(ty, emit_val(inout c, ir.S_REPEAT, v.op, n.b, 0, ty, ty, n.line)))
        }
        ast.ETuple => tuple_lit(inout c, n, exp)
        ast.ETry => try_op(inout c, n)
        ast.ELambda => lambda(inout c, n, exp)
        // reported by the parser: an error value
        ast.EError => Err(quiet())
        _ => {
            // EIf, EMatch, EBlock, EUnsafe in expression position
            Err(errh("E0103", n.line, n.col, s("`if`, `match` and blocks can only be used as a statement, a function's final expression, or the right side of `let`, `=` or `return`"), "bind the result first: `let x = match ... { ... }`, then use `x`"))
        }
    }
}

/// A name that isn't a local: a constant, a unit variant, or an error.
fn ident_value(inout c: C, n: ast.Node, k: u64, exp: u32) -> Result[V, diag.Diag] {
    let ci = mget(c.consts, k)
    if ci != NONE {
        let cd = c.cdefs[ci as usize].copy()
        if !visible(c, cd.md, cd.public) {
            // reported, then used as if it were visible
            let rd = err("E0801", n.line, n.col, q2("constant `", kt(c, k), "` is private to module `", c.p.mods[cd.md as usize].path, "`"))
            record(inout c, rd)
        }
        if c.rec.on {
            let am = c.am.copy()
            let cn = ndm(c, cd.md, cd.node)
            note_ref(inout c, am, n, cd.md, cn.line, cn.col)
        }
        return Ok(V(cd.ty, cd.op, cd.has_k, cd.k))
    }
    let di = mget(c.variants, k)
    if di != NONE {
        note_variant(inout c, n, di, k)
        return construct(inout c, n.line, n.col, di, k, 0, 0, exp)
    }
    if c.fns.contains(k) {
        if exp != NONE && types.kind(c.t, exp) == types.T_FN {
            let fi = mget(c.fns, k)
            note_fn(inout c, n, fi)
            return fn_as_value(inout c, n, k, exp)
        }
        return Err(err("E0110", n.line, n.col, q2("`", kt(c, k), "` is a function; call it with `", kt(c, k), "(...)`")))
    }
    Err(err("E0110", n.line, n.col, q("unknown name `", kt(c, k), "`")))
}

/// `Type.x` where `Type` names a type template (not a local or constant): the template.
fn static_tmpl(c: C, n: ast.Node) -> u32 {
    let b = nd(c, n.a)
    if b.kind != ast.EIdent { return NONE }
    let tk = ekey(c, b)
    if lookup(c, tk) != NONE || c.consts.contains(tk) { return NONE }
    mget(c.tmpl, tk)
}

/// A place expression (variable, field, element), or a value held in a temporary.
fn place_expr(inout c: C, e: u32) -> Result[PV, diag.Diag] {
    let n = nd(c, e)
    if n.kind == ast.EIdent {
        let k = ekey(c, n)
        let li = lookup(c, k)
        if li != NONE {
            let v = c.scopes[li as usize].copy()
            if c.rec.on {
                note_local(inout c, n, v)
                note_ty(inout c, n, v.ty)
            }
            return Ok(PV(local_place(inout c, v), v.ty, NONE))
        }
    }
    if n.kind == ast.EField {
        let di = static_tmpl(c, n)
        if di != NONE && c.t.defs[di as usize].is_enum {
            let v = expr(inout c, e, NONE)?
            return Ok(value_place(inout c, v, n.line))
        }
        let b = place_expr(inout c, n.a)?
        let bt = types.get(c.t, b.ty)
        if bt.kind == types.T_POISON {
            let pv = poison_v(inout c)
            return Ok(value_place(inout c, pv, n.line))
        }
        if bt.kind == types.T_RECORD {
            let d = types.def_of(c.t, b.ty)
            match types.find_field(c.t, d, n.b) {
                Some(i) => {
                    let ft = types.field(c.t, d.start, i).ty
                    if c.rec.on {
                        note_field(inout c, n, d, i)
                        note_ty(inout c, n, ft)
                    }
                    return Ok(PV(ir.place_field(inout c.ir, b.place, i, ft), ft, NONE))
                }
                None => {
                    return Err(err("E0113", n.line, n.col, q2("type `", ts(c, b.ty), "` has no field `", nm(c, n.b), "`")))
                }
            }
        }
        if bt.kind == types.T_TUPLE {
            let es = types.elems(c.t, b.ty)
            match bytes.parse_u64(nm(c, n.b)) {
                Some(i) => {
                    if i < es.len() as u64 {
                        let ft = es[i as usize]
                        note_ty(inout c, n, ft)
                        return Ok(PV(ir.place_field(inout c.ir, b.place, i as u32, ft), ft, NONE))
                    }
                }
                None => {}
            }
            return Err(err("E0113", n.line, n.col, q2("tuple ", ts(c, b.ty), " has no element `", nm(c, n.b), "`")))
        }
        return Err(err("E0113", n.line, n.col, q("type ", ts(c, b.ty), " has no fields")))
    }
    if n.kind == ast.EIndex {
        let b = place_expr(inout c, n.a)?
        let bt = types.get(c.t, b.ty)
        if bt.kind == types.T_POISON {
            expr(inout c, n.b, types.USIZE)?
            let pv = poison_v(inout c)
            return Ok(value_place(inout c, pv, n.line))
        }
        if bt.kind == types.T_LIST {
            let vi = expr(inout c, n.b, types.USIZE)?
            let x = nd(c, n.b)
            if !same(c, vi.ty, types.USIZE) { return Err(mismatch(c, x.line, x.col, types.USIZE, vi.ty)) }
            return Ok(PV(ir.place_index(inout c.ir, b.place, vi.op, bt.a, n.line), bt.a, NONE))
        }
        if bt.kind != types.T_ARRAY {
            return Err(err("E0401", n.line, n.col, q("cannot index a value of type ", ts(c, b.ty), "")))
        }
        let vi = expr(inout c, n.b, types.USIZE)?
        let x = nd(c, n.b)
        if !same(c, vi.ty, types.USIZE) { return Err(mismatch(c, x.line, x.col, types.USIZE, vi.ty)) }
        if vi.has_k && !fold.lt(vi.k, fold.of_u64(bt.b as u64)) {
            return Err(err("E0503", x.line, x.col, q2("index ", fold.text(vi.k), " is out of bounds for an array of length ", num(bt.b as u64), "")))
        }
        return Ok(PV(ir.place_index(inout c.ir, b.place, vi.op, bt.a, n.line), bt.a, NONE))
    }
    let v = expr(inout c, e, NONE)?
    Ok(value_place(inout c, v, n.line))
}

fn value_place(inout c: C, v: V, line: u32) -> PV {
    let pl = place_of_op(inout c, v.op, v.ty, line)
    PV(pl, v.ty, v.op)
}

fn negate(inout c: C, n: ast.Node, exp: u32) -> Result[V, diag.Diag] {
    let x = nd(c, n.b)
    if x.kind == ast.EInt {
        let mut ik = types.IK_I32
        if exp != NONE && types.is_int(c.t, exp) { ik = types.ik(c.t, exp) }
        if !types.signed(ik) {
            return Err(err("E0401", n.line, n.col, q("cannot negate an unsigned integer (", s(types.int_name(ik)), ")")))
        }
        let w = lit(c, x.a)
        if fold.lt(fold.neg(w), imin(ik)) {
            return Err(err("E0501", n.line, n.col, q2("literal -", fold.text(w), " doesn't fit in ", s(types.int_name(ik)), "")))
        }
        return Ok(const_v(inout c, ik, fold.neg(w)))
    }
    let v = expr(inout c, n.b, exp)?
    if poisoned(c, v.ty) { return Ok(v) }
    if !types.is_int(c.t, v.ty) || !types.signed(types.ik(c.t, v.ty)) {
        return Err(err("E0401", n.line, n.col, q("cannot negate a value of type ", ts(c, v.ty), "")))
    }
    let ik = types.ik(c.t, v.ty)
    if v.has_k {
        if fold.gt(fold.neg(v.k), imax(ik)) {
            return Err(err("E0501", n.line, n.col, q2("negating ", fold.text(v.k), " overflows ", s(types.int_name(ik)), "")))
        }
        return Ok(const_v(inout c, ik, fold.neg(v.k)))
    }
    Ok(v_of(v.ty, emit_val(inout c, ir.S_UNARY, ir.U_NEG, v.op, 0, v.ty, v.ty, n.line)))
}

/// `~x`: the bitwise complement of an integer (any integer type; no trap).
fn bit_not(inout c: C, n: ast.Node, exp: u32) -> Result[V, diag.Diag] {
    let v = expr(inout c, n.b, exp)?
    if poisoned(c, v.ty) { return Ok(v) }
    if !types.is_int(c.t, v.ty) {
        return Err(err("E0401", n.line, n.col, q("operator ~ needs an integer, found ", ts(c, v.ty), "")))
    }
    let ik = types.ik(c.t, v.ty)
    if v.has_k { return Ok(const_v(inout c, v.ty, fold.bitwise(5, v.k, fold.zero(), types.bits(ik), types.signed(ik)))) }
    Ok(v_of(v.ty, emit_val(inout c, ir.S_UNARY, ir.U_BNOT, v.op, 0, v.ty, v.ty, n.line)))
}

fn binary(inout c: C, n: ast.Node, exp: u32) -> Result[V, diag.Diag] {
    let op = n.a
    let ln = nd(c, n.b)
    let rn = nd(c, n.c)
    if op == ast.OP_AND || op == ast.OP_OR {
        let vl = expr(inout c, n.b, types.BOOL)?
        if !same(c, vl.ty, types.BOOL) { return Err(mismatch(c, ln.line, ln.col, types.BOOL, vl.ty)) }
        // t := lhs; if t (or !t for ||) { t := rhs }
        let t = tmp(inout c, types.BOOL, n.line)
        emit(inout c, ir.S_COPY, t, vl.op, 0, 0, types.BOOL, n.line)
        let rm = ir.open(c.ir)
        push_frame(inout c)
        let vr = expr(inout c, n.c, types.BOOL)?
        if !same(c, vr.ty, types.BOOL) { return Err(mismatch(c, rn.line, rn.col, types.BOOL, vr.ty)) }
        emit(inout c, ir.S_COPY, t, vr.op, 0, 0, types.BOOL, n.line)
        pop_frame(inout c, true)
        let rb = ir.close(inout c.ir, rm)
        let eb = ir.empty_block(inout c.ir)
        let tv = ir.op_local(inout c.ir, t, types.BOOL)
        if op == ast.OP_AND {
            emit(inout c, ir.S_IF, 0, tv, rb, eb, 0, n.line)
        } else {
            emit(inout c, ir.S_IF, 0, tv, eb, rb, 0, n.line)
        }
        return Ok(v_of(types.BOOL, tv))
    }
    let arith = op <= ast.OP_WMUL || ast.is_bitwise(op)
    let exp_operand = if arith { exp } else { NONE }
    let mut vl = v_of(types.UNIT, 0)
    let mut vr = v_of(types.UNIT, 0)
    if is_lit(c, n.b) && !is_lit(c, n.c) {
        vr = expr(inout c, n.c, exp_operand)?
        vl = expr(inout c, n.b, vr.ty)?
    } else {
        vl = expr(inout c, n.b, exp_operand)?
        vr = expr(inout c, n.c, vl.ty)?
    }
    if poisoned(c, vl.ty) || poisoned(c, vr.ty) {
        // an operand failed: an arithmetic result is an error value too, a comparison a bool
        if arith { return Ok(poison_v(inout c)) }
        return Ok(v_of(types.BOOL, ir.op_bool(inout c.ir, false)))
    }
    if vl.ty != vr.ty { return Err(mismatch(c, rn.line, rn.col, vl.ty, vr.ty)) }
    let ty = vl.ty
    if arith {
        if !types.is_int(c.t, ty) {
            return Err(err("E0401", n.line, n.col, q2("operator ", s(ast.op_text(op)), " needs integers, found ", ts(c, ty), "")))
        }
        let ik = types.ik(c.t, ty)
        if (op == ast.OP_DIV || op == ast.OP_REM) && vr.has_k && fold.is_zero(vr.k) {
            return Err(err("E0502", rn.line, rn.col, s("division by zero")))
        }
        if op == ast.OP_SHL || op == ast.OP_SHR { check_shift(c, rn, ik, vr)? }
        if vl.has_k && vr.has_k {
            if ast.is_bitwise(op) { return Ok(const_v(inout c, ty, fold.bitwise(op - ast.OP_BAND, vl.k, vr.k, types.bits(ik), types.signed(ik)))) }
            return fold_arith(inout c, n, op, ik, ty, vl.k, vr.k)
        }
        return Ok(v_of(ty, emit_val(inout c, ir.S_BINARY, op, vl.op, vr.op, ty, ty, n.line)))
    }
    let tk = types.kind(c.t, ty)
    if tk == types.T_UNIT || tk == types.T_NEVER {
        return Err(err("E0401", n.line, n.col, q("cannot compare values of type ", ts(c, ty), "")))
    }
    // == != through Eq, < <= > >= through Ord ("Operation traits"): integers, bool, and
    // String and str by their bytes (Unicode scalar order) are built in, the rest derived
    // or the type's own
    let tr = if op == ast.OP_EQ || op == ast.OP_NE { TR_EQ } else { TR_ORD }
    if !has_trait(c, tr, ty) {
        return Err(lack_err(c, "E0401", n.line, n.col, q("`", s(ast.op_text(op)), "`"), tr, ty))
    }
    Ok(v_of(types.BOOL, emit_val(inout c, ir.S_BINARY, op, vl.op, vr.op, ty, types.BOOL, n.line)))
}

/// A shift count known at compile time must be below the width (and not negative): E0505.
fn check_shift(c: C, rn: ast.Node, ik: u32, vr: V) -> Result[bool, diag.Diag] {
    if !vr.has_k { return Ok(true) }
    let bits = types.bits(ik)
    if fold.lt(vr.k, fold.zero()) || !fold.lt(vr.k, fold.of_u64(bits as u64)) {
        let m = q3("shift count ", fold.text(vr.k), " is out of range for ", s(types.int_name(ik)), " (0 to ", num((bits - 1) as u64), ")")
        return Err(errh("E0505", rn.line, rn.col, m, "a shift count must be at least 0 and less than the type's width in bits"))
    }
    Ok(true)
}

fn fold_arith(inout c: C, n: ast.Node, op: u32, ik: u32, ty: u32, a: fold.Wide, b: fold.Wide) -> Result[V, diag.Diag] {
    let mut wide = fold.zero()
    let mut wraps = false
    if op == ast.OP_ADD || op == ast.OP_WADD { wide = fold.add(a, b) }
    if op == ast.OP_SUB || op == ast.OP_WSUB { wide = fold.sub(a, b) }
    if op == ast.OP_MUL || op == ast.OP_WMUL { wide = fold.mul(a, b) }
    if op == ast.OP_DIV { wide = fold.div(a, b) }
    if op == ast.OP_REM { wide = fold.rem(a, b) }
    if op == ast.OP_WADD || op == ast.OP_WSUB || op == ast.OP_WMUL { wraps = true }
    if wraps { return Ok(const_v(inout c, ty, fold.wrap(wide, types.bits(ik), types.signed(ik)))) }
    if !fits(ik, wide) {
        let mut m = fold.text(a)
        bytes.append(inout m, q2(" ", s(ast.op_text(op)), " ", fold.text(b), " = "))
        bytes.append(inout m, q2("", fold.text(wide), " doesn't fit in ", s(types.int_name(ik)), ""))
        let mut d = err("E0501", n.line, n.col, m)
        let w = if op == ast.OP_ADD { "+%" } else if op == ast.OP_SUB { "-%" } else { "*%" }
        d.help = q("use the wrapping operator `", s(w), "` if overflow is intended")
        return Err(d)
    }
    Ok(const_v(inout c, ty, wide))
}

fn cast(inout c: C, n: ast.Node) -> Result[V, diag.Diag] {
    let am = c.am.copy()
    let target = resolve_ty(inout c, am, n.b)?
    if !types.is_int(c.t, target) {
        return Err(err("E0401", n.line, n.col, q("`as` only converts between integer types, not to ", ts(c, target), "")))
    }
    let hint = if is_lit(c, n.a) { target } else { NONE }
    let v = expr(inout c, n.a, hint)?
    if poisoned(c, v.ty) { return Ok(v_of(target, v.op)) }
    if !types.is_int(c.t, v.ty) {
        return Err(err("E0401", n.line, n.col, q("`as` only converts between integer types, not from ", ts(c, v.ty), "")))
    }
    let tk = types.ik(c.t, target)
    if v.has_k {
        if !fits(tk, v.k) {
            return Err(err("E0501", n.line, n.col, q2("", fold.text(v.k), " doesn't fit in ", s(types.int_name(tk)), "")))
        }
        return Ok(const_v(inout c, target, v.k))
    }
    if v.ty == target { return Ok(v) }
    Ok(v_of(target, emit_val(inout c, ir.S_CAST, v.op, 0, 0, target, target, n.line)))
}

fn array_lit(inout c: C, n: ast.Node, exp: u32) -> Result[V, diag.Diag] {
    let mut exp_elem = NONE
    if exp != NONE && types.kind(c.t, exp) == types.T_ARRAY { exp_elem = types.get(c.t, exp).a }
    if n.d == 0 { return Err(err("E0401", n.line, n.col, s("cannot infer the element type of an empty array"))) }
    let mut vs: List[V] = List.new()
    let mut first = NONE
    for i in 0..n.d {
        let x = at(c, n.c, i)
        let mut want = exp_elem.copy()
        if want == NONE { want = first }
        let v = expr(inout c, x, want)?
        if want != NONE && !same(c, v.ty, want) {
            let xn = nd(c, x)
            return Err(mismatch(c, xn.line, xn.col, want, v.ty))
        }
        if first == NONE || poisoned(c, first) { first = v.ty }
        vs.push(v)
    }
    let mut ops: List[u32] = List.new()
    for v in vs { ops.push(take(inout c, v, n.line)) }
    let ty = types.array(inout c.t, first, n.d)
    let start = ir.list(inout c.ir, ops)
    Ok(v_of(ty, emit_val(inout c, ir.S_ARRAY, 0, start, n.d, ty, ty, n.line)))
}

fn tuple_lit(inout c: C, n: ast.Node, exp: u32) -> Result[V, diag.Diag] {
    // `()`: the unit value
    if n.d == 0 { return Ok(v_of(types.UNIT, ir.op_unit(inout c.ir))) }
    let mut hints: List[u32] = List.new()
    if exp != NONE && types.kind(c.t, exp) == types.T_TUPLE && types.get(c.t, exp).b == n.d { hints = types.elems(c.t, exp) }
    let mut vs: List[V] = List.new()
    let mut tys: List[u32] = List.new()
    for i in 0..n.d {
        let x = at(c, n.c, i)
        let mut h = NONE
        if hints.len() > 0 { h = hints[i as usize] }
        let v = expr(inout c, x, h)?
        if v.ty == types.UNIT || v.ty == types.NEVER {
            let xn = nd(c, x)
            return Err(err("E0401", xn.line, xn.col, s("tuple elements can't be ()")))
        }
        tys.push(v.ty)
        vs.push(v)
    }
    let ty = types.tuple(inout c.t, tys)
    let mut ops: List[u32] = List.new()
    for v in vs { ops.push(take(inout c, v, n.line)) }
    let start = ir.list(inout c.ir, ops)
    Ok(v_of(ty, emit_val(inout c, ir.S_TUPLE, 0, start, n.d, ty, ty, n.line)))
}

/// `x?` on a Result or Option: on Err/None, drop everything and return it.
fn try_op(inout c: C, n: ast.Node) -> Result[V, diag.Diag] {
    if c.lam_expr { return Err(unsup(n.line, n.col, "`?` in a closure without a block body")) }
    let v = expr(inout c, n.a, NONE)?
    if poisoned(c, v.ty) || poisoned(c, c.ret) { return Ok(poison_v(inout c)) }
    let vt = types.get(c.t, v.ty)
    if vt.kind != types.T_ENUM {
        return Err(err("E0406", n.line, n.col, q("`?` needs a Result or Option, found ", ts(c, v.ty), "")))
    }
    let d = types.def_of(c.t, v.ty)
    let tkey = c.t.defs[d.tmpl as usize].key
    let is_result = is_root(tkey, c.w.result)
    if !is_result && !is_root(tkey, c.w.option) {
        return Err(err("E0406", n.line, n.col, q("`?` needs a Result or Option, found ", ts(c, v.ty), "")))
    }
    let tname = kt(c, tkey)
    let rt = types.get(c.t, c.ret)
    let mut same = false
    if rt.kind == types.T_ENUM { same = c.t.defs[types.def_of(c.t, c.ret).tmpl as usize].key == tkey }
    if !same {
        return Err(err("E0406", n.line, n.col, q3("`?` on a ", tname, " needs the enclosing function to return a ", tname, ", but it returns ", ts(c, c.ret), "")))
    }
    let args = types.list_items(c.t, d.args)
    // `From` converts the error ("Error conversion"): the instance of its `from`, or NONE
    let mut conv = NONE
    if is_result {
        let rargs = types.list_items(c.t, types.def_of(c.t, c.ret).args)
        if args[1] != rargs[1] {
            let hit = find_from(c, 0, rargs[1], args[1])
            if hit.ix == NONE {
                let mut cd = err("E0401", n.line, n.col, q2("`?` can't convert the error type ", ts(c, args[1]), " into ", ts(c, rargs[1]), ""))
                let rk = types.kind(c.t, rargs[1])
                if rk == types.T_RECORD || rk == types.T_ENUM { cd.help = q2("implement `From[", ts(c, args[1]), "]` for ", ts(c, rargs[1]), " (in its package), or convert with `match`") }
                return Err(cd)
            }
            conv = from_instance(inout c, hit, n.line, n.col)?
        }
    }
    // t := x (owned); if t is Err/None { return Err(move t.error) / None } ; value := move t.value
    let o = take(inout c, v, n.line)
    let tp = place_of_op(inout c, o, v.ty, n.line)
    let mut bad = c.w.none.copy()
    let mut good = c.w.some.copy()
    if is_result {
        bad = c.w.errv
        good = c.w.ok
    }
    let bad_i = variant_index(c, v.ty, bad)
    let good_i = variant_index(c, v.ty, good)
    let rbad_i = variant_index(c, c.ret, bad)
    let isbad = emit_val(inout c, ir.S_TAG, tp, bad_i, 0, v.ty, types.BOOL, n.line)
    let bm = ir.open(c.ir)
    let mut rargs: List[u32] = List.new()
    if is_result {
        let et = args[1]
        let ep = ir.place_payload(inout c.ir, tp, bad_i, 0, et)
        let mv = emit_val(inout c, ir.S_MOVE, ep, 0, 0, et, et, n.line)
        if conv == NONE {
            rargs.push(mv)
        } else {
            // Err(Target.from(e)): `from` borrows e, which is dropped after the call
            let inst = c.insts[conv as usize].copy()
            let cst = ir.list(inout c.ir, one(mv))
            rargs.push(emit_val(inout c, ir.S_CALL, inst.ir, cst, 1, inst.ret, inst.ret, n.line))
            if owns(c, et) {
                let mp = place_of_op(inout c, mv, et, n.line)
                emit(inout c, ir.S_DROP, 0, mp, 0, 0, et, n.line)
            }
        }
    }
    let st = ir.list(inout c.ir, rargs)
    let rty = c.ret.copy()
    let rv = emit_val(inout c, ir.S_VARIANT, rbad_i, st, rargs.len() as u32, rty, rty, n.line)
    drop_frames_from(inout c, 0)
    emit(inout c, ir.S_RETURN, 0, rv + 1, 0, 0, 0, n.line)
    let then = ir.close(inout c.ir, bm)
    let els = ir.empty_block(inout c.ir)
    emit(inout c, ir.S_IF, 0, isbad, then, els, 0, n.line)
    let vt0 = args[0]
    let vp = ir.place_payload(inout c.ir, tp, good_i, 0, vt0)
    if owns(c, vt0) { return Ok(v_of(vt0, emit_val(inout c, ir.S_MOVE, vp, 0, 0, vt0, vt0, n.line))) }
    Ok(v_of(vt0, read(inout c, vp, vt0, 0)))
}

/// The index of the variant named `sym` (an unprefixed name) of enum type ty.
fn variant_index(c: C, ty: u32, sym: u32) -> u32 {
    let vi: u32 = match types.find_variant(c.t, types.def_of(c.t, ty), resolve.key(0, sym)) {
        Some(i) => i
        None => 0
    }
    vi
}

// ---- calls

fn arg_expr(c: C, a: u32) -> u32 { nd(c, a).a }

fn call(inout c: C, n: ast.Node, exp: u32) -> Result[V, diag.Diag] {
    at_pos(inout c, n.line, n.col)
    let r = call_in(inout c, n, exp)
    end_pos(inout c)
    r
}

fn call_in(inout c: C, n: ast.Node, exp: u32) -> Result[V, diag.Diag] {
    let k = ekey(c, n)
    if is_builtin_fn(c, k) { return builtin(inout c, n, resolve.key_sym(k)) }
    let vd = mget(c.variants, k)
    if vd != NONE {
        note_variant(inout c, n, vd, k)
        return construct(inout c, n.line, n.col, vd, k, n.c, n.d, exp)
    }
    let td = mget(c.tmpl, k)
    if td != NONE && !c.t.defs[td as usize].is_enum {
        let am = c.am.copy()
        note_def(inout c, am, n, td)
        return construct(inout c, n.line, n.col, td, NONE as u64, n.c, n.d, exp)
    }
    let li = lookup(c, k)
    if li != NONE {
        let v = c.scopes[li as usize].copy()
        note_local(inout c, n, v)
        let pl = local_place(inout c, v)
        let fv = v_of(v.ty, read(inout c, pl, v.ty, 0))
        let label = kt(c, k)
        return call_value(inout c, n, label, fv)
    }
    let fi = mget(c.fns, k)
    if fi == NONE {
        let fd = err("E0112", n.line, n.col, q("unknown function `", kt(c, k), "`"))
        return fail_call(inout c, fd, n.c, n.d)
    }
    let f = c.fdefs[fi as usize]
    if !visible(c, f.md, f.public) {
        // reported, then called as if it were visible
        let rd = errh("E0801", n.line, n.col, q2("function `", kt(c, k), "` is private to module `", c.p.mods[f.md as usize].path, "`"), "mark it `pub` in its own file to use it from other modules")
        record(inout c, rd)
    }
    let label = kt(c, k)
    call_decl(inout c, n, label, fi, no_subst(), no_recv(), exp, false)
}

/// The field type nodes (in the template's module) of record di or of variant `vkey` of
/// enum di.
fn field_nodes(c: C, di: u32, vkey: u64) -> List[u32] {
    let d = c.t.defs[di as usize]
    let tn = ndm(c, d.md, d.node)
    let mut out: List[u32] = List.new()
    if vkey == NONE as u64 {
        for i in 0..tn.f { out.push(ndm(c, d.md, atm(c, d.md, tn.e, i)).b) }
        return out
    }
    for i in 0..tn.f {
        let vn = ndm(c, d.md, atm(c, d.md, tn.e, i))
        if resolve.item_key(c.p, d.md, vn.a) == vkey {
            for j in 0..vn.d { out.push(ndm(c, d.md, atm(c, d.md, vn.c, j)).b) }
        }
    }
    out
}

/// Construct record template `di` (vkey = NONE) or variant `vkey` of enum template `di`
/// from the arguments [start/len), inferring type arguments from the expected type and
/// the arguments.
fn construct(inout c: C, line: u32, col: u32, di: u32, vkey: u64, start: u32, len: u32, exp: u32) -> Result[V, diag.Diag] {
    let d = c.t.defs[di as usize].copy()
    let fas = field_nodes(c, di, vkey)
    let label = if vkey != NONE as u64 { kt(c, vkey) } else { kt(c, d.key) }
    if len != fas.len() as u32 {
        let fd = err("E0405", line, col, q3("`", label, "` takes ", num(fas.len() as u64), " value(s), but ", num(len as u64), " were given"))
        return fail_call(inout c, fd, start, len)
    }
    let tn = ndm(c, d.md, d.node)
    let gs = gparams(c, d.md, tn.c, tn.d)
    let mut sb = no_subst()
    if exp != NONE {
        let et = types.get(c.t, exp)
        if et.kind == types.T_ENUM || et.kind == types.T_RECORD {
            let ed = types.def_of(c.t, exp)
            if ed.tmpl == di && ed.args != types.NOTY {
                let args = types.list_items(c.t, ed.args)
                for i in 0..gs.len() {
                    if i < args.len() { subst_set(inout sb, gs[i], args[i]) }
                }
            }
        }
    }
    let mut vs: List[V] = List.new()
    let mut tainted = poisoned(c, exp)
    for i in 0..len {
        let a = nd(c, at(c, start, i))
        let x = nd(c, a.a)
        if a.b == 1 { return Err(err("E0304", x.line, x.col, s("`inout` is not allowed here"))) }
        let fa = fas[i as usize]
        let mut hint = NONE
        if !has_unbound(c, d.md, fa, sb, gs) { hint = resolve_with(inout c, d.md, fa, sb)? }
        let v = expr(inout c, a.a, hint)?
        if poisoned(c, v.ty) { tainted = true }
        if hint != NONE {
            if !same(c, v.ty, hint) { return Err(mismatch(c, x.line, x.col, hint, v.ty)) }
        } else if !unify_ast(c, d.md, fa, v.ty, inout sb, gs) {
            return Err(err("E0401", x.line, x.col, q2("this value has type ", ts(c, v.ty), ", which doesn't fit field type `", show_ast(c, d.md, fa, gs), "`")))
        }
        vs.push(v)
    }
    let mut targs: List[u32] = List.new()
    for g in gs {
        let t = subst_get(sb, g)
        // nothing to infer from an error value
        if t == NONE && tainted { return Ok(poison_v(inout c)) }
        if t == NONE {
            return Err(errh("E0409", line, col, q2("cannot infer type parameter `", nm(c, g), "` of `", kt(c, d.key), "`"), "add a type annotation, e.g. `let x: Option[i32] = None`"))
        }
        targs.push(t)
    }
    let ty = inst_type(inout c, di, targs, line, col)?
    let mut ops: List[u32] = List.new()
    for v in vs { ops.push(take(inout c, v, line)) }
    let st = ir.list(inout c.ir, ops)
    if vkey != NONE as u64 {
        let vi: u32 = match types.find_variant(c.t, types.def_of(c.t, ty), vkey) {
            Some(i) => i
            None => 0
        }
        return Ok(v_of(ty, emit_val(inout c, ir.S_VARIANT, vi, st, len, ty, ty, line)))
    }
    Ok(v_of(ty, emit_val(inout c, ir.S_RECORD, 0, st, len, ty, ty, line)))
}

/// Every name an argument reads (not through calls' names or value forms).
fn idents(c: C, e: u32, inout out: List[u64]) {
    let n = nd(c, e)
    match n.kind {
        ast.EIdent => out.push(ekey(c, n))
        ast.EUnary => idents(c, n.b, inout out)
        ast.ECast => idents(c, n.a, inout out)
        ast.EField => idents(c, n.a, inout out)
        ast.ERepeat => idents(c, n.a, inout out)
        ast.ETry => idents(c, n.a, inout out)
        ast.EBinary => {
            idents(c, n.b, inout out)
            idents(c, n.c, inout out)
        }
        ast.EIndex => {
            idents(c, n.a, inout out)
            idents(c, n.b, inout out)
        }
        ast.ECall => { for i in 0..n.d { idents(c, arg_expr(c, at(c, n.c, i)), inout out) } }
        ast.EMethod => {
            idents(c, n.a, inout out)
            for i in 0..n.d { idents(c, arg_expr(c, at(c, n.c, i)), inout out) }
        }
        ast.EArray => { for i in 0..n.d { idents(c, at(c, n.c, i), inout out) } }
        ast.ETuple => { for i in 0..n.d { idents(c, at(c, n.c, i), inout out) } }
        _ => {}
    }
}

fn cap_error(c: C, line: u32, col: u32, what: List[u8], cap: u32) -> diag.Diag {
    let mut d = err("E0201", line, col, q2("call to `", what, "` requires capability `", nm(c, cap), "`"))
    let ins = if c.caps.len() == 0 { q(" uses ", nm(c, cap), "") } else { q(", ", nm(c, cap), "") }
    d.fix = Some(diag.Fix(c.sig_line, c.sig_col, 0, ins))
    d
}

/// Whether calling a function of module `fm` that declares capability `cap` needs `cap` in
/// the body being checked: always, except `ffi` across a package boundary, which stays
/// inside the package that has the unmanaged code (docs/compiler.md, "C8.5: capabilities
/// per package"). Files in no package (and the prelude) are one package.
fn needs_cap(c: C, fm: u32, cap: u32) -> bool {
    if cap != c.w.caps[5] { return true }
    c.p.mods[fm as usize].pkg == c.p.mods[c.am as usize].pkg
}

/// A method call's receiver: its expression and place (`has` = false for none).
type Recv = { has: bool, e: u32, pv: PV }

fn no_recv() -> Recv { Recv(false, 0, PV(0, 0, NONE)) }

/// Call declaration fi with the arguments of call node n (ECall or EMethod), inferring its
/// type parameters.
fn call_decl(inout c: C, n: ast.Node, label: List[u8], fi: u32, sb0: Subst, recv: Recv, exp: u32, is_method: bool) -> Result[V, diag.Diag] {
    note_fn(inout c, n, fi)
    let f = c.fdefs[fi as usize].copy()
    let fm = f.md.copy()
    let fnode = ndm(c, fm, f.node)
    let mut sb = sb0.copy()
    let mut gs = gparams(c, fm, fnode.c, fnode.d)
    let mut target: u32 = NONE
    if f.inode != NONE {
        let im = ndm(c, fm, f.inode)
        target = im.b
        for g in gparams(c, fm, im.c, im.d) { gs.push(g) }
        gs.push(intern.S_SELF_TYPE)
    }
    let gnodes = all_gparam_nodes(c, fi)
    let mut has_self = false
    if fnode.f > 0 { has_self = ndm(c, fm, atm(c, fm, fnode.e, 0)).a == intern.S_SELF }
    if recv.has && !has_self {
        let fd = err("E0115", n.line, n.col, q2("`", label, "` is an associated function; call it as `Type.", nm(c, fnode.a), "(...)`"))
        return fail_call(inout c, fd, n.c, n.d)
    }
    if !recv.has && has_self && is_method {
        let fd = err("E0115", n.line, n.col, q2("`", label, "` takes `self`; call it as `value.", nm(c, fnode.a), "(...)`"))
        return fail_call(inout c, fd, n.c, n.d)
    }
    let skip: u32 = if recv.has { 1 } else { 0 }
    let np = fnode.f - skip
    if n.d != np {
        let fd = err("E0405", n.line, n.col, q3("`", label, "` takes ", num(np as u64), " argument(s), but ", num(n.d as u64), " were given"))
        return fail_call(inout c, fd, n.c, n.d)
    }
    let mut tainted = poisoned(c, exp) || (recv.has && poisoned(c, recv.pv.ty))
    // bind type parameters from the expected type, then from the receiver type
    if fnode.g > 0 && exp != NONE {
        let mut s2 = sb.copy()
        if unify_ast(c, fm, fnode.g - 1, exp, inout s2, gs) { sb = s2 }
    }
    if target != NONE {
        let st = subst_get(sb, intern.S_SELF_TYPE)
        if st != NONE {
            let mut s2 = sb.copy()
            if unify_ast(c, fm, target, st, inout s2, gs) { sb = s2 }
        }
    }
    // exclusivity of inout borrows
    let mut roots: List[u64] = List.new()
    // (a reference counts as the variable its place is rooted at: `canon`)
    if recv.has && ndm(c, fm, atm(c, fm, fnode.e, 0)).c == 1 {
        let r = root(c, recv.e)
        if r.ok { roots.push(canon(c, r.key)) }
    }
    for i in 0..n.d {
        let a = nd(c, at(c, n.c, i))
        let pn = ndm(c, fm, atm(c, fm, fnode.e, i + skip))
        if pn.c == 1 && a.b == 1 {
            let r = root(c, a.a)
            if r.ok {
                let rk = canon(c, r.key)
                if roots.contains(rk) {
                    if rk != r.key { return Err(err("E0301", r.line, r.col, q2("`", kt(c, r.key), "` is an alias of `", kt(c, rk), "`, which is borrowed mutably more than once in this call"))) }
                    return Err(err("E0301", r.line, r.col, q("`", kt(c, r.key), "` is borrowed mutably more than once in this call")))
                }
                roots.push(rk)
            }
        }
    }
    for i in 0..n.d {
        let a = nd(c, at(c, n.c, i))
        let pn = ndm(c, fm, atm(c, fm, fnode.e, i + skip))
        if pn.c != 1 {
            let mut ids: List[u64] = List.new()
            idents(c, a.a, inout ids)
            for r in roots {
                for k in ids {
                    if canon(c, k) == r {
                        let x = nd(c, a.a)
                        if k != r { return Err(alias_read_error(c, x.line, x.col, k, r)) }
                        return Err(err("E0301", x.line, x.col, q("`", kt(c, r), "` is borrowed mutably by another argument of this call and can't be read here")))
                    }
                }
            }
        }
    }
    let mut args: List[u32] = List.new()
    if recv.has {
        if ndm(c, fm, atm(c, fm, fnode.e, 0)).c == 1 {
            assignable_or_record(inout c, recv.e, "borrow as inout")
            args.push(recv.pv.place + ir.ARG_PLACE)
        } else if recv.pv.op != NONE {
            args.push(recv.pv.op)
        } else {
            args.push(read(inout c, recv.pv.place, recv.pv.ty, 0))
        }
    }
    for i in 0..n.d {
        let a = nd(c, at(c, n.c, i))
        let x = nd(c, a.a)
        let pn = ndm(c, fm, atm(c, fm, fnode.e, i + skip))
        let mut hint = NONE
        if !has_unbound(c, fm, pn.b, sb, gs) { hint = resolve_with(inout c, fm, pn.b, sb)? }
        let ptn = ndm(c, fm, pn.b)
        if hint == NONE && ptn.kind == ast.TFn && x.kind == ast.ELambda {
            let mut hp: List[u32] = List.new()
            for j in 0..ptn.d {
                let pt = atm(c, fm, ptn.c, j)
                if has_unbound(c, fm, pt, sb, gs) { hp.push(NONE) } else { hp.push(resolve_with(inout c, fm, pt, sb)?) }
            }
            let mut hr = types.UNIT
            if ptn.g > 0 {
                hr = NONE
                if !has_unbound(c, fm, ptn.g - 1, sb, gs) { hr = resolve_with(inout c, fm, ptn.g - 1, sb)? }
            }
            c.lam = LamHint(true, hp, hr)
        }
        if pn.c == 1 && a.b == 0 {
            let mut d = err("E0304", x.line, x.col, q("parameter `", nm(c, pn.a), "` is `inout`; pass the argument as `inout ...`"))
            d.fix = Some(diag.Fix(x.line, x.col, 0, s("inout ")))
            return Err(d)
        }
        if pn.c != 1 && a.b == 1 {
            return Err(err("E0304", x.line, x.col, q("parameter `", nm(c, pn.a), "` is not `inout`; remove the `inout`")))
        }
        let mut ty: u32 = 0
        if pn.c == 1 {
            assignable_or_record(inout c, a.a, "borrow as inout")
            let pv = place_expr(inout c, a.a)?
            ty = pv.ty
            args.push(pv.place + ir.ARG_PLACE)
        } else {
            let mut hint2 = hint.copy()
            if hint2 == NONE && ptn.kind == ast.TFn && x.kind == ast.EIdent {
                let xk = ekey(c, x)
                let xf = mget(c.fns, xk)
                if lookup(c, xk) == NONE && xf != NONE && !c.fdefs[xf as usize].generic {
                    let xi = instantiate(inout c, xf, no_subst())?
                    hint2 = inst_fn_type(inout c, xi)
                }
            }
            let v = expr(inout c, a.a, hint2)?
            ty = v.ty
            args.push(v.op)
        }
        if poisoned(c, ty) { tainted = true }
        if hint != NONE {
            if !same(c, ty, hint) { return Err(mismatch(c, x.line, x.col, hint, ty)) }
        } else if !unify_ast(c, fm, pn.b, ty, inout sb, gs) {
            return Err(err("E0401", x.line, x.col, q2("argument of type ", ts(c, ty), " doesn't match parameter type `", show_ast(c, fm, pn.b, gs), "`")))
        }
    }
    // finish inference
    if target != NONE && subst_get(sb, intern.S_SELF_TYPE) == NONE && !has_unbound(c, fm, target, sb, gs) {
        let t = resolve_with(inout c, fm, target, sb)?
        subst_set(inout sb, intern.S_SELF_TYPE, t)
    }
    for g in gnodes {
        let gn = ndm(c, fm, g)
        // nothing to infer from an error value
        if subst_get(sb, gn.a) == NONE && tainted { return Ok(poison_v(inout c)) }
        if subst_get(sb, gn.a) == NONE {
            return Err(errh("E0409", n.line, n.col, q2("cannot infer type parameter `", nm(c, gn.a), "` of `", label, "`"), "add a type annotation to the binding that receives the result"))
        }
    }
    if target != NONE && subst_get(sb, intern.S_SELF_TYPE) == NONE {
        if tainted { return Ok(poison_v(inout c)) }
        return Err(err("E0409", n.line, n.col, q("cannot infer the type for `", label, "`")))
    }
    for g in gnodes {
        let gn = ndm(c, fm, g)
        let ty = subst_get(sb, gn.a)
        if poisoned(c, ty) { continue }
        for j in 0..gn.d {
            let b = ndm(c, fm, atm(c, fm, gn.c, j))
            let bk = resolve.name_key(c.p, fm, b.a, b.b, b.line, b.col)
            if !c.traits.contains(bk) { return Err(err("E0603", gn.line, gn.col, q("unknown trait `", kt(c, bk), "`"))) }
            if !implements(c, bk, ty) {
                // in generic code, a type parameter's bound (or a part's) is what's missing
                let mut seen: Map[u32, bool] = Map.new()
                let tr = lang_of_key(c, bk)
                let mut part = ty.copy()
                if tr != NONE { part = lacks(c, tr, ty, inout seen) }
                if part != NONE && types.kind(c.t, part) == types.T_PARAM {
                    let mut names: List[List[u8]] = List.new()
                    names.push(kt(c, bk))
                    return Err(bound_err(c, n.line, n.col, q("`", label, "`"), names, part))
                }
                return Err(err("E0601", n.line, n.col, q3("type ", ts(c, ty), " doesn't implement trait `", kt(c, bk), "` (required by `", label, "`)")))
            }
        }
    }
    // a missing capability or `unsafe` is reported, and the call is otherwise fine
    for i in 0..fnode.j {
        let cap = ndm(c, fm, atm(c, fm, fnode.i, i)).a
        if !needs_cap(c, fm, cap) { continue }
        if !has_sym(c.caps, cap) {
            let rd = cap_error(c, n.line, n.col, label, cap)
            record(inout c, rd)
            break
        }
    }
    let is_extern = ast.has(fnode.b, ast.FN_EXTERN)
    if is_extern && !has_sym(c.caps, c.w.caps[5]) {
        let rd = cap_error(c, n.line, n.col, label, c.w.caps[5])
        record(inout c, rd)
    }
    if f.unsafe_fn && c.unsafe_depth == 0 {
        let what = if is_extern { "call to C function `" } else { "call to unsafe function `" }
        record(inout c, errh("E0802", n.line, n.col, q(what, label, "` is only allowed in an `unsafe` block or `unsafe fn`"), "wrap the call: `unsafe { ... }`"))
    }
    // an instance for an error type would only report consequences
    for t in sb.tys {
        if poisoned(c, t) { return Ok(poison_v(inout c)) }
    }
    let ii = instantiate(inout c, fi, sb)?
    let inst = c.insts[ii as usize].copy()
    let ret = inst.ret
    let st = ir.list(inout c.ir, args)
    let na = args.len() as u32
    if ret == types.UNIT {
        emit(inout c, ir.S_CALL, ir.NONE, inst.ir, st, na, ret, n.line)
        return Ok(v_of(ret, ir.op_unit(inout c.ir)))
    }
    Ok(v_of(ret, emit_val(inout c, ir.S_CALL, inst.ir, st, na, ret, ret, n.line)))
}

fn builtin(inout c: C, n: ast.Node, which: u32) -> Result[V, diag.Diag] {
    for i in 0..n.d {
        let a = nd(c, at(c, n.c, i))
        if a.b == 1 {
            let x = nd(c, a.a)
            return Err(err("E0304", x.line, x.col, s("`inout` is not allowed here")))
        }
    }
    if which == c.w.print {
        // a missing capability is reported, and the call is otherwise fine
        if !has_sym(c.caps, c.w.io) {
            let rd = cap_error(c, n.line, n.col, s("print"), c.w.io)
            record(inout c, rd)
        }
        if n.d != 1 {
            let fd = err("E0405", n.line, n.col, s("`print` takes exactly one argument"))
            return fail_call(inout c, fd, n.c, n.d)
        }
        let ae = arg_expr(c, at(c, n.c, 0))
        let v = expr(inout c, ae, NONE)?
        // through Show ("Operation traits")
        if !has_trait(c, TR_SHOW, v.ty) {
            let x = nd(c, ae)
            return Err(lack_err(c, "E0401", x.line, x.col, s("`print`"), TR_SHOW, v.ty))
        }
        emit(inout c, ir.S_PRINT, 0, v.op, 0, 0, v.ty, n.line)
        return Ok(v_of(types.UNIT, ir.op_unit(inout c.ir)))
    }
    if which == c.w.len {
        if n.d != 1 {
            let fd = err("E0405", n.line, n.col, s("`len` takes exactly one argument"))
            return fail_call(inout c, fd, n.c, n.d)
        }
        let ae = arg_expr(c, at(c, n.c, 0))
        let v = expr(inout c, ae, NONE)?
        if poisoned(c, v.ty) { return Ok(v_of(types.USIZE, ir.op_int(inout c.ir, types.USIZE, 0))) }
        let t = types.get(c.t, v.ty)
        if t.kind == types.T_ARRAY { return Ok(const_v(inout c, types.USIZE, fold.of_u64(t.b as u64))) }
        if t.kind == types.T_STRING || t.kind == types.T_STR || t.kind == types.T_LIST || t.kind == types.T_MAP {
            let mut largs: List[u32] = List.new()
            largs.push(v.op)
            return Ok(v_of(types.USIZE, builtin_op(inout c, ir.B_LEN, largs, types.USIZE, n.line)))
        }
        let x = nd(c, ae)
        return Err(err("E0401", x.line, x.col, q("`len` needs an array, List, Map or String, found ", ts(c, v.ty), "")))
    }
    if which == c.w.spawn {
        if !has_sym(c.caps, c.w.threads) {
            let rd = cap_error(c, n.line, n.col, s("spawn"), c.w.threads)
            record(inout c, rd)
        }
        return spawn(inout c, n)
    }
    if which == c.w.panic {
        if n.d != 1 {
            let fd = err("E0405", n.line, n.col, s("`panic` takes exactly one message"))
            return fail_call(inout c, fd, n.c, n.d)
        }
        let ae = arg_expr(c, at(c, n.c, 0))
        let v = expr(inout c, ae, types.STR)?
        if !same(c, v.ty, types.STR) {
            let x = nd(c, ae)
            return Err(mismatch(c, x.line, x.col, types.STR, v.ty))
        }
        emit(inout c, ir.S_PANIC, 0, v.op, 0, 0, 0, n.line)
        return Ok(v_of(types.NEVER, ir.op_unit(inout c.ir)))
    }
    // now_ms
    if !has_sym(c.caps, c.w.clock) {
        let rd = cap_error(c, n.line, n.col, s("now_ms"), c.w.clock)
        record(inout c, rd)
    }
    if n.d != 0 {
        let fd = err("E0405", n.line, n.col, s("`now_ms` takes no arguments"))
        return fail_call(inout c, fd, n.c, n.d)
    }
    Ok(v_of(types.U64, emit_val(inout c, ir.S_NOWMS, 0, 0, 0, 0, types.U64, n.line)))
}

// ---- methods

/// Whether name key k names a type.
fn is_type_name(c: C, k: u64) -> bool {
    if c.tmpl.contains(k) { return true }
    if resolve.key_pre(k) != 0 { return false }
    let x = resolve.key_sym(k)
    has_sym(c.w.ints, x) || x == c.w.s_bool || x == c.w.s_str || x == c.w.s_string || has_sym(c.w.heap, x)
}

fn label_of(c: C, head: List[u8], name: u32) -> List[u8] {
    let mut l = head.copy()
    l.push(46)
    bytes.append(inout l, nm(c, name))
    l
}

fn method_call(inout c: C, n: ast.Node, exp: u32) -> Result[V, diag.Diag] {
    at_pos(inout c, n.line, n.col)
    let r = method_call_in(inout c, n, exp)
    end_pos(inout c)
    r
}

fn method_call_in(inout c: C, n: ast.Node, exp: u32) -> Result[V, diag.Diag] {
    let r = nd(c, n.a)
    let mut static_head: u64 = 0
    let mut is_static = false
    if r.kind == ast.EIdent {
        let k = ekey(c, r)
        if lookup(c, k) == NONE && !c.consts.contains(k) && is_type_name(c, k) {
            is_static = true
            static_head = k
        }
    }
    if is_static {
        if c.rec.on {
            let tdi = mget(c.tmpl, static_head)
            let am = c.am.copy()
            if tdi != NONE { note_def(inout c, am, r, tdi) }
        }
        let x = resolve.key_sym(static_head)
        let heap_head = resolve.key_pre(static_head) == 0 && (has_sym(c.w.heap, x) || x == c.w.s_string)
        if heap_head && builtin_static(c, x, n.b) { return heap_static(inout c, n, x, exp) }
        if is_word(c, n.b, "from") && has_from(c, static_head) { return from_call(inout c, n, static_head, exp) }
        for m in c.meths {
            if m.head == static_head && m.name == n.b {
                let label = label_of(c, kt(c, static_head), n.b)
                return call_decl(inout c, n, label, m.fd, no_subst(), no_recv(), exp, true)
            }
        }
        if heap_head { return heap_static(inout c, n, x, exp) }
        let fd = err("E0115", n.line, n.col, q2("type ", kt(c, static_head), " has no method `", nm(c, n.b), "`"))
        return fail_call(inout c, fd, n.c, n.d)
    }
    let pv = place_expr(inout c, n.a)?
    let tk = types.kind(c.t, pv.ty)
    // a method of an error value: only its arguments are checked
    if tk == types.T_POISON { return fail_call(inout c, quiet(), n.c, n.d) }
    if builtin_method(c, tk, n.b) {
        if types.is_handle(tk) { return thread_method(inout c, n, pv) }
        return heap_method(inout c, n, pv)
    }
    let head = head_of(c, pv.ty)
    if n.b == c.lt.meths[TR_DROP as usize] && has_drop(c, pv.ty) {
        let fd = errh("E0115", n.line, n.col, q("`drop` of ", ts(c, pv.ty), " can't be called"), "it runs by itself, once, when the value's last holder goes")
        return fail_call(inout c, fd, n.c, n.d)
    }
    let mut any = false
    for m in c.meths {
        if m.head != head || m.name != n.b { continue }
        any = true
        let f = c.fdefs[m.fd as usize]
        let im = ndm(c, f.md, f.inode)
        let gs = gparams(c, f.md, im.c, im.d)
        let mut sb = no_subst()
        if !unify_ast(c, f.md, im.b, pv.ty, inout sb, gs) { continue }
        subst_set(inout sb, intern.S_SELF_TYPE, pv.ty)
        let label = label_of(c, head_text(c, head), n.b)
        return call_decl(inout c, n, label, m.fd, sb, Recv(true, n.a, pv), exp, true)
    }
    // a handle's unknown method: thread_method's message
    if !any && types.is_handle(tk) && lang_method(c, n.b) == NONE { return thread_method(inout c, n, pv) }
    // a field holding a function is called when the type has no method of that name: its
    // own, built-in and language-trait methods (derived ones too) win (docs/compiler.md,
    // "C8.19")
    let lm = lang_method(c, n.b)
    let lneed = if lm == NTR { TR_SHOW } else { lm }
    if lm != NONE && lm != TR_ITER && lm != TR_DROP && has_trait(c, lneed, pv.ty) { return trait_method(inout c, n, pv, lm) }
    if !any && tk == types.T_RECORD {
        let d = types.def_of(c.t, pv.ty)
        match types.find_field(c.t, d, n.b) {
            Some(i) => {
                let ft = types.field(c.t, d.start, i).ty
                if types.kind(c.t, ft) == types.T_FN {
                    let fp = ir.place_field(inout c.ir, pv.place, i, ft)
                    let fv = v_of(ft, read(inout c, fp, ft, 0))
                    let label = nm(c, n.b)
                    return call_value(inout c, n, label, fv)
                }
            }
            None => {}
        }
    }
    // a language trait's method, derived ("Operation traits")
    let li = lang_method(c, n.b)
    if li != NONE && li != TR_ITER && li != TR_DROP { return trait_method(inout c, n, pv, li) }
    if is_word(c, n.b, "take") || is_word(c, n.b, "replace") { return take_replace(inout c, n, pv) }
    let fd = err("E0115", n.line, n.col, q2("type ", ts(c, pv.ty), " has no method `", nm(c, n.b), "`"))
    fail_call(inout c, fd, n.c, n.d)
}

/// `x.replace(v)` and `x.take()` (docs/compiler.md, "C8.15: take and replace"), for a type
/// with no method of that name: the value moves out of the place x (no copy) and v, or for
/// `take` the type's empty value (String, List, Map: empty; Option: None), moves in; the old
/// value is the result. x must be writable, as for any write.
fn take_replace(inout c: C, n: ast.Node, pv: PV) -> Result[V, diag.Diag] {
    let ty = pv.ty
    let label = label_of(c, ts(c, ty), n.b)
    let is_take = is_word(c, n.b, "take")
    let tk = types.kind(c.t, ty)
    if is_take && tk != types.T_STRING && tk != types.T_LIST && tk != types.T_MAP && !is_option(c, ty) {
        let fd = errh("E0115", n.line, n.col, q2("type ", ts(c, ty), " has no method `", nm(c, n.b), "`"), "`take()` leaves an empty value behind, so it is for String, List, Map and Option; `x.replace(v)` takes any value out and leaves v")
        return fail_call(inout c, fd, n.c, n.d)
    }
    if pv.op != NONE {
        let fd = errh("E0303", n.line, n.col, q("`", label, "` needs a place to move the value out of"), "call it on a variable, a field or an element")
        return fail_call(inout c, fd, n.c, n.d)
    }
    assignable_or_record(inout c, n.a, "modify")
    let mut newv: u32 = 0
    if is_take {
        eval_args(inout c, n, List.new(), label)?
        if tk == types.T_STRING {
            let mut sargs: List[u32] = List.new()
            sargs.push(ir.op_str(inout c.ir, List.new()))
            newv = builtin_op(inout c, ir.B_STR_FROM, sargs, ty, n.line)
        } else if tk == types.T_LIST {
            newv = builtin_op(inout c, ir.B_LIST_NEW, List.new(), ty, n.line)
        } else if tk == types.T_MAP {
            newv = builtin_op(inout c, ir.B_MAP_NEW, List.new(), ty, n.line)
        } else {
            let st = ir.list(inout c.ir, List.new())
            let ni = variant_index(c, ty, c.w.none)
            newv = emit_val(inout c, ir.S_VARIANT, ni, st, 0, ty, ty, n.line)
        }
    } else {
        let mut tys: List[u32] = List.new()
        tys.push(ty)
        let vs = eval_args(inout c, n, tys, label)?
        newv = take(inout c, vs[0], n.line)
    }
    let old = emit_val(inout c, ir.S_MOVE, pv.place, 0, 0, ty, ty, n.line)
    emit(inout c, ir.S_STORE, 0, pv.place, newv, 0, ty, n.line)
    Ok(v_of(ty, old))
}

fn is_option(c: C, ty: u32) -> bool {
    if types.kind(c.t, ty) != types.T_ENUM { return false }
    c.t.defs[types.def_of(c.t, ty).tmpl as usize].key == resolve.key(0, c.w.option)
}

/// `x.copy()`, `x.eq(y)`, `x.compare(y)`, `x.hash()`, `x.show(inout out)` and `x.to_string()`
/// (tr = NTR) of a type that derives the trait (a type with its own impl has the method).
fn trait_method(inout c: C, n: ast.Node, pv: PV, tr: u32) -> Result[V, diag.Diag] {
    let ty = pv.ty
    let label = label_of(c, ts(c, ty), n.b)
    let need = if tr == NTR { TR_SHOW } else { tr }
    if !has_trait(c, need, ty) {
        let mut what = s("`.")
        bytes.append(inout what, nm(c, n.b))
        bytes.append(inout what, s("()`"))
        let mut seen: Map[u32, bool] = Map.new()
        let part = lacks(c, need, ty, inout seen)
        if part != NONE && types.kind(c.t, part) == types.T_PARAM {
            let bd = bound_err(c, n.line, n.col, what, trait_names(c, one(need)), part)
            return fail_call(inout c, bd, n.c, n.d)
        }
        let mut m = q3("type ", ts(c, ty), " doesn't implement trait `", trait_name(c, need), "` (required by ", what, ")")
        if part != ty && part != NONE { bytes.append(inout m, q(": its part ", ts(c, part), " doesn't")) }
        let h = lack_help(c, need, part)
        let fd = if s(h).len() == 0 { err("E0601", n.line, n.col, m) } else { errh("E0601", n.line, n.col, m, h) }
        return fail_call(inout c, fd, n.c, n.d)
    }
    if tr == TR_SHOW {
        if n.d != 1 { return Err(err("E0405", n.line, n.col, q("`", label, "` takes 1 argument(s): `inout out: String`"))) }
        let a = nd(c, at(c, n.c, 0))
        let x = nd(c, a.a)
        if a.b != 1 {
            let mut d = err("E0304", x.line, x.col, s("parameter `out` is `inout`; pass the argument as `inout ...`"))
            d.fix = Some(diag.Fix(x.line, x.col, 0, s("inout ")))
            return Err(d)
        }
        let rr = root(c, n.a)
        let ar = root(c, a.a)
        if rr.ok && ar.ok && canon(c, rr.key) == canon(c, ar.key) {
            let r = nd(c, n.a)
            if canon(c, rr.key) != rr.key { return Err(alias_read_error(c, r.line, r.col, rr.key, canon(c, ar.key))) }
            return Err(err("E0301", r.line, r.col, q("`", kt(c, rr.key), "` is borrowed mutably by another argument of this call and can't be read here")))
        }
        assignable_or_record(inout c, a.a, "borrow as inout")
        let ro = recv_op(inout c, pv)
        let opv = place_expr(inout c, a.a)?
        if !same(c, opv.ty, types.STRING) { return Err(mismatch(c, x.line, x.col, types.STRING, opv.ty)) }
        builtin_op(inout c, ir.B_SHOW, two(opv.place + ir.ARG_PLACE, ro), types.UNIT, n.line)
        return Ok(v_of(types.UNIT, ir.op_unit(inout c.ir)))
    }
    if tr == TR_EQ || tr == TR_ORD {
        let ro = recv_op(inout c, pv)
        let vs = eval_args(inout c, n, one(ty), label)?
        let o = vs[0]
        if tr == TR_EQ { return Ok(v_of(types.BOOL, emit_val(inout c, ir.S_BINARY, ast.OP_EQ, ro, o.op, ty, types.BOOL, n.line))) }
        let oty = ordering_ty(inout c, n.line, n.col)?
        return Ok(v_of(oty, builtin_op(inout c, ir.B_COMPARE, two(ro, o.op), oty, n.line)))
    }
    let ro = recv_op(inout c, pv)
    eval_args(inout c, n, List.new(), label)?
    if tr == TR_COPY { return Ok(v_of(ty, builtin_op(inout c, ir.B_COPY, one(ro), ty, n.line))) }
    if tr == TR_HASH { return Ok(v_of(types.U64, builtin_op(inout c, ir.B_HASH, one(ro), types.U64, n.line))) }
    Ok(v_of(types.STRING, builtin_op(inout c, ir.B_TO_STRING, one(ro), types.STRING, n.line)))
}

/// The built-in methods of type kind tk (heap_method, thread_method): an impl on the type
/// can add methods (found after these), but not one of these names (E0116).
fn builtin_method(c: C, tk: u32, name: u32) -> bool {
    let mi = sym_index(c.w.hm, name)
    if tk == types.T_STRING {
        return mi == M_LEN || mi == M_IS_EMPTY || mi == M_PUSH_STR || mi == M_APPEND || mi == M_BYTE || mi == M_SLICE || mi == M_BYTES || mi == M_PUSH_BYTE
    }
    if tk == types.T_STR { return mi == M_LEN || mi == M_IS_EMPTY || mi == M_BYTE || mi == M_SLICE || mi == M_BYTES }
    if tk == types.T_LIST { return mi == M_LEN || mi == M_IS_EMPTY || (mi >= M_PUSH && mi <= M_CONTAINS) || (mi >= M_MAP && mi <= M_SUM) }
    if tk == types.T_MAP { return mi == M_LEN || mi == M_IS_EMPTY || mi == M_GET || mi == M_CONTAINS || mi == M_INSERT || mi == M_REMOVE || (mi >= M_KEYS && mi <= M_ENTRIES) }
    if tk == types.T_BOX { return mi == M_GET || mi == M_SET }
    if tk == types.T_TASK { return is_word(c, name, "join") }
    if tk == types.T_MUTEX { return mi == M_GET || mi == M_SET || is_word(c, name, "update") }
    if tk == types.T_CHAN { return is_word(c, name, "send") || is_word(c, name, "recv") || is_word(c, name, "close") }
    false
}

/// The built-in associated functions of String, List, Map, Box, Mutex and Chan (head: the
/// type's symbol).
fn builtin_static(c: C, head: u32, name: u32) -> bool {
    let mi = sym_index(c.w.hm, name)
    if head == c.w.s_string { return mi == M_FROM || mi == M_FROM_INT || mi == M_FROM_BYTES }
    mi == M_NEW && head != c.w.heap[3]
}

/// The type kind of a built-in method head (head_of), or NONE.
fn builtin_head_kind(c: C, head: u64) -> u32 {
    if resolve.key_pre(head) != 0 { return NONE }
    let x = resolve.key_sym(head)
    if x == c.w.s_string { return types.T_STRING }
    if x == c.w.s_str { return types.T_STR }
    if x == c.w.list { return types.T_LIST }
    if x == c.w.map { return types.T_MAP }
    if x == c.w.boxs { return types.T_BOX }
    if x == c.w.heap[3] { return types.T_TASK }
    if x == c.w.heap[4] { return types.T_MUTEX }
    if x == c.w.heap[5] { return types.T_CHAN }
    NONE
}

/// Check the arguments of a built-in method against `tys`.
fn eval_args(inout c: C, n: ast.Node, tys: List[u32], label: List[u8]) -> Result[List[V], diag.Diag] {
    if n.d != tys.len() as u32 {
        return Err(err("E0405", n.line, n.col, q3("`", label, "` takes ", num(tys.len() as u64), " argument(s), but ", num(n.d as u64), " were given")))
    }
    let mut vs: List[V] = List.new()
    for i in 0..n.d {
        let a = nd(c, at(c, n.c, i))
        let x = nd(c, a.a)
        if a.b == 1 { return Err(err("E0304", x.line, x.col, s("`inout` is not allowed here"))) }
        let t = tys[i as usize]
        let v = expr(inout c, a.a, t)?
        if !same(c, v.ty, t) { return Err(mismatch(c, x.line, x.col, t, v.ty)) }
        vs.push(v)
    }
    Ok(vs)
}

fn one(t: u32) -> List[u32] {
    let mut out: List[u32] = List.new()
    out.push(t)
    out
}

fn two(a: u32, b: u32) -> List[u32] {
    let mut out: List[u32] = List.new()
    out.push(a)
    out.push(b)
    out
}

/// `String.from(..)`, `List.new()`, ...
fn heap_static(inout c: C, n: ast.Node, head: u32, exp: u32) -> Result[V, diag.Diag] {
    let label = label_of(c, nm(c, head), n.b)
    let mi = sym_index(c.w.hm, n.b)
    if head == c.w.s_string && mi == M_FROM {
        let vs = eval_args(inout c, n, one(types.STR), label)?
        return Ok(v_of(types.STRING, builtin_op(inout c, ir.B_STR_FROM, one(vs[0].op), types.STRING, n.line)))
    }
    if head == c.w.s_string && mi == M_FROM_BYTES {
        let lt = types.list_of(inout c.t, types.U8)
        let vs = eval_args(inout c, n, one(lt), label)?
        let di = mget(c.tmpl, resolve.key(0, c.w.result))
        let rt = inst_type(inout c, di, two(types.STRING, types.USIZE), n.line, n.col)?
        return Ok(v_of(rt, builtin_op(inout c, ir.B_STR_FROM_BYTES, one(vs[0].op), rt, n.line)))
    }
    if head == c.w.s_string && mi == M_FROM_INT {
        let vs = eval_args(inout c, n, one(types.I64), label)?
        return Ok(v_of(types.STRING, builtin_op(inout c, ir.B_STR_FROM_INT, one(vs[0].op), types.STRING, n.line)))
    }
    if (head == c.w.list || head == c.w.map) && mi == M_NEW {
        let want_list = head == c.w.list
        if poisoned(c, exp) { return Ok(poison_v(inout c)) }
        let mut ok = false
        if exp != NONE {
            let ek = types.kind(c.t, exp)
            ok = (want_list && ek == types.T_LIST) || (!want_list && ek == types.T_MAP)
        }
        if !ok {
            let ex = if want_list { "annotate the binding, e.g. `let x: List[i32] = List.new()`" } else { "annotate the binding, e.g. `let x: Map[str, i32] = Map.new()`" }
            return Err(errh("E0409", n.line, n.col, q("cannot infer the type arguments of `", nm(c, head), "`"), ex))
        }
        if n.d > 0 { return Err(err("E0405", n.line, n.col, q("`", label, "` takes no arguments"))) }
        let b = if want_list { ir.B_LIST_NEW } else { ir.B_MAP_NEW }
        return Ok(v_of(exp, builtin_op(inout c, b, List.new(), exp, n.line)))
    }
    if head == c.w.boxs && mi == M_NEW {
        if n.d != 1 { return Err(err("E0405", n.line, n.col, s("`Box.new` takes exactly one argument"))) }
        let mut hint = NONE
        if exp != NONE && types.kind(c.t, exp) == types.T_BOX { hint = types.get(c.t, exp).a }
        let ae = arg_expr(c, at(c, n.c, 0))
        let x = nd(c, ae)
        let v = expr(inout c, ae, hint)?
        if hint != NONE && !same(c, v.ty, hint) { return Err(mismatch(c, x.line, x.col, hint, v.ty)) }
        if v.ty == types.UNIT || v.ty == types.NEVER { return Err(err("E0401", x.line, x.col, s("can't box ()"))) }
        let ty = types.box_of(inout c.t, v.ty)
        let o = take(inout c, v, n.line)
        return Ok(v_of(ty, builtin_op(inout c, ir.B_BOX_NEW, one(o), ty, n.line)))
    }
    if (head == c.w.heap[4] || head == c.w.heap[5]) && mi == M_NEW { return thread_static(inout c, n, head, exp) }
    Err(err("E0115", n.line, n.col, q2("`", nm(c, head), "` has no associated function `", nm(c, n.b), "`")))
}

/// The receiver's value (borrowed), read where the receiver was evaluated.
fn recv_op(inout c: C, pv: PV) -> u32 {
    if pv.op != NONE { return pv.op }
    read(inout c, pv.place, pv.ty, 0)
}

/// Methods of String, List, Map and Box. Mutating methods need the
/// receiver to be assignable and take it as a place.
fn heap_method(inout c: C, n: ast.Node, pv: PV) -> Result[V, diag.Diag] {
    let ty = pv.ty
    let t = types.get(c.t, ty)
    let tk = t.kind
    let label = label_of(c, ts(c, ty), n.b)
    let mi = sym_index(c.w.hm, n.b)
    let place = pv.place + ir.ARG_PLACE
    let is_str = tk == types.T_STRING
    let is_list = tk == types.T_LIST
    let is_map = tk == types.T_MAP
    let is_cstr = tk == types.T_STR
    if (is_str || is_cstr || is_list || is_map) && (mi == M_LEN || mi == M_IS_EMPTY) {
        let ro = recv_op(inout c, pv)
        eval_args(inout c, n, List.new(), label)?
        if mi == M_LEN { return Ok(v_of(types.USIZE, builtin_op(inout c, ir.B_LEN, one(ro), types.USIZE, n.line))) }
        return Ok(v_of(types.BOOL, builtin_op(inout c, ir.B_IS_EMPTY, one(ro), types.BOOL, n.line)))
    }
    if is_map && mi == M_LEN {
        let ro = recv_op(inout c, pv)
        eval_args(inout c, n, List.new(), label)?
        return Ok(v_of(types.USIZE, builtin_op(inout c, ir.B_LEN, one(ro), types.USIZE, n.line)))
    }
    if is_str || is_cstr {
        let tv = text_method(inout c, n, pv, mi, label)?
        if tv.ty != NONE { return Ok(tv) }
    }
    if is_str && (mi == M_PUSH_STR || mi == M_APPEND) {
        assignable_or_record(inout c, n.a, "modify")
        let argt = if mi == M_PUSH_STR { types.STR } else { types.STRING }
        let vs = eval_args(inout c, n, one(argt), label)?
        let b = if mi == M_PUSH_STR { ir.B_STR_PUSH } else { ir.B_STR_APPEND }
        return Ok(v_of(types.UNIT, builtin_op(inout c, b, two(place, vs[0].op), types.UNIT, n.line)))
    }
    if is_list {
        let el = t.a
        if mi == M_PUSH {
            assignable_or_record(inout c, n.a, "modify")
            let vs = eval_args(inout c, n, one(el), label)?
            let x = take(inout c, vs[0], n.line)
            return Ok(v_of(types.UNIT, builtin_op(inout c, ir.B_LIST_PUSH, two(place, x), types.UNIT, n.line)))
        }
        if mi == M_POP {
            assignable_or_record(inout c, n.a, "modify")
            eval_args(inout c, n, List.new(), label)?
            let opt = option_of(inout c, el, n)?
            return Ok(v_of(opt, builtin_op(inout c, ir.B_LIST_POP, one(place), opt, n.line)))
        }
        if mi == M_CLEAR {
            assignable_or_record(inout c, n.a, "modify")
            eval_args(inout c, n, List.new(), label)?
            return Ok(v_of(types.UNIT, builtin_op(inout c, ir.B_LIST_CLEAR, one(place), types.UNIT, n.line)))
        }
        if mi == M_GET {
            let ro = recv_op(inout c, pv)
            let vs = eval_args(inout c, n, one(types.USIZE), label)?
            let lp = place_of_op(inout c, ro, ty, n.line)
            let ep = ir.place_index(inout c.ir, lp, vs[0].op, el, n.line)
            let o = read(inout c, ep, el, n.line)
            if owns(c, el) { return Ok(v_of(el, emit_val(inout c, ir.S_CLONE, o, 0, 0, el, el, n.line))) }
            return Ok(v_of(el, o))
        }
        if mi == M_CONTAINS {
            let ro = recv_op(inout c, pv)
            let vs = eval_args(inout c, n, one(el), label)?
            if !has_trait(c, TR_EQ, el) { return Err(lack_err(c, "E0401", n.line, n.col, q("`", label, "`"), TR_EQ, el)) }
            return Ok(v_of(types.BOOL, builtin_op(inout c, ir.B_LIST_CONTAINS, two(ro, vs[0].op), types.BOOL, n.line)))
        }
        if mi == M_MAP || mi == M_FILTER || mi == M_FOR_EACH || mi == M_ANY || mi == M_ALL {
            if n.d != 1 { return Err(err("E0405", n.line, n.col, q("`", label, "` takes exactly one closure"))) }
            return combinator(inout c, n, pv, mi)
        }
        if mi == M_FOLD {
            if n.d != 2 { return Err(err("E0405", n.line, n.col, s("`fold` takes an initial value and a closure"))) }
            return fold_list(inout c, n, pv)
        }
        if mi == M_SUM {
            if !types.is_int(c.t, el) && !poisoned(c, el) {
                return Err(err("E0401", n.line, n.col, q("`sum` needs a List of integers, found List[", ts(c, el), "]")))
            }
            let ro = recv_op(inout c, pv)
            eval_args(inout c, n, List.new(), label)?
            return Ok(v_of(el, builtin_op(inout c, ir.B_LIST_SUM, one(ro), el, n.line)))
        }
    }
    if is_map {
        let kty = t.a
        let vty = t.b
        if mi == M_INSERT {
            assignable_or_record(inout c, n.a, "modify")
            let vs = eval_args(inout c, n, two(kty, vty), label)?
            let ko = take(inout c, vs[0], n.line)
            let vo = take(inout c, vs[1], n.line)
            let mut args = two(place, ko)
            args.push(vo)
            return Ok(v_of(types.UNIT, builtin_op(inout c, ir.B_MAP_INSERT, args, types.UNIT, n.line)))
        }
        if mi == M_CONTAINS {
            let ro = recv_op(inout c, pv)
            let vs = eval_args(inout c, n, one(kty), label)?
            return Ok(v_of(types.BOOL, builtin_op(inout c, ir.B_MAP_CONTAINS, two(ro, vs[0].op), types.BOOL, n.line)))
        }
        if mi == M_REMOVE {
            assignable_or_record(inout c, n.a, "modify")
            let vs = eval_args(inout c, n, one(kty), label)?
            return Ok(v_of(types.BOOL, builtin_op(inout c, ir.B_MAP_REMOVE, two(place, vs[0].op), types.BOOL, n.line)))
        }
        if mi >= M_KEYS && mi <= M_ENTRIES {
            // copies in slot order (docs/compiler.md, "C8.20")
            let ro = recv_op(inout c, pv)
            eval_args(inout c, n, List.new(), label)?
            let lt = map_list_type(inout c, ty, mi)
            let b = if mi == M_KEYS { ir.B_MAP_KEYS } else if mi == M_VALUES { ir.B_MAP_VALUES } else { ir.B_MAP_ENTRIES }
            return Ok(v_of(lt, builtin_op(inout c, b, one(ro), lt, n.line)))
        }
        if mi == M_GET {
            let ro = recv_op(inout c, pv)
            let vs = eval_args(inout c, n, one(kty), label)?
            let opt = option_of(inout c, vty, n)?
            let o = builtin_op(inout c, ir.B_MAP_GET, two(ro, vs[0].op), opt, n.line)
            if owns(c, opt) { return Ok(v_of(opt, emit_val(inout c, ir.S_CLONE, o, 0, 0, opt, opt, n.line))) }
            return Ok(v_of(opt, o))
        }
    }
    if tk == types.T_BOX {
        let el = t.a
        if mi == M_GET {
            let ro = recv_op(inout c, pv)
            eval_args(inout c, n, List.new(), label)?
            let bp = place_of_op(inout c, ro, ty, n.line)
            let dp = ir.place_deref(inout c.ir, bp, el)
            let o = read(inout c, dp, el, 0)
            if owns(c, el) { return Ok(v_of(el, emit_val(inout c, ir.S_CLONE, o, 0, 0, el, el, n.line))) }
            return Ok(v_of(el, o))
        }
        if mi == M_SET {
            assignable_or_record(inout c, n.a, "modify")
            let vs = eval_args(inout c, n, one(el), label)?
            let x = take(inout c, vs[0], n.line)
            let dp = ir.place_deref(inout c.ir, pv.place, el)
            if owns(c, el) { emit_drop(inout c, dp, el) }
            emit(inout c, ir.S_STORE, 0, dp, x, 0, el, n.line)
            return Ok(v_of(types.UNIT, ir.op_unit(inout c.ir)))
        }
    }
    let fd = err("E0115", n.line, n.col, q2("type ", ts(c, ty), " has no method `", nm(c, n.b), "`"))
    fail_call(inout c, fd, n.c, n.d)
}

/// The byte methods of String and str (C8.2): byte, slice, bytes, and push_byte on String.
/// V.ty is NONE when `mi` isn't one of them.
fn text_method(inout c: C, n: ast.Node, pv: PV, mi: u32, label: List[u8]) -> Result[V, diag.Diag] {
    if mi == M_BYTE {
        let ro = recv_op(inout c, pv)
        let vs = eval_args(inout c, n, one(types.USIZE), label)?
        return Ok(v_of(types.U8, builtin_op(inout c, ir.B_STR_BYTE, two(ro, vs[0].op), types.U8, n.line)))
    }
    if mi == M_SLICE {
        let ro = recv_op(inout c, pv)
        let vs = eval_args(inout c, n, two(types.USIZE, types.USIZE), label)?
        let mut args = two(ro, vs[0].op)
        args.push(vs[1].op)
        return Ok(v_of(types.STRING, builtin_op(inout c, ir.B_STR_SLICE, args, types.STRING, n.line)))
    }
    if mi == M_BYTES {
        let ro = recv_op(inout c, pv)
        eval_args(inout c, n, List.new(), label)?
        let lt = types.list_of(inout c.t, types.U8)
        return Ok(v_of(lt, builtin_op(inout c, ir.B_STR_BYTES, one(ro), lt, n.line)))
    }
    if mi == M_PUSH_BYTE && types.kind(c.t, pv.ty) == types.T_STRING {
        assignable_or_record(inout c, n.a, "modify")
        let vs = eval_args(inout c, n, one(types.U8), label)?
        let v = vs[0]
        if v.has_k && (fold.is_zero(v.k) || !fold.lt(v.k, fold.of_u64(128))) {
            let x = nd(c, arg_expr(c, at(c, n.c, 0)))
            return Err(errh("E0506", x.line, x.col, q("`push_byte` takes an ASCII byte (1 to 127), not ", fold.text(v.k), ""), "a String is always valid UTF-8: build other text with `push_str`, `append` or `String.from_bytes`"))
        }
        let place = pv.place + ir.ARG_PLACE
        return Ok(v_of(types.UNIT, builtin_op(inout c, ir.B_STR_PUSH_BYTE, two(place, v.op), types.UNIT, n.line)))
    }
    Ok(v_of(NONE, 0))
}

/// The prelude's Option[el].
fn option_of(inout c: C, el: u32, n: ast.Node) -> Result[u32, diag.Diag] {
    let di = mget(c.tmpl, resolve.key(0, c.w.option))
    inst_type(inout c, di, one(el), n.line, n.col)
}

// ---- closures

/// Every name a closure body mentions (patterns are not walked).
fn walk_expr(c: C, e: u32, inout out: List[u64]) {
    let n = nd(c, e)
    match n.kind {
        ast.EIdent => out.push(ekey(c, n))
        ast.EUnary => walk_expr(c, n.b, inout out)
        ast.ECast => walk_expr(c, n.a, inout out)
        ast.EField => walk_expr(c, n.a, inout out)
        ast.ERepeat => walk_expr(c, n.a, inout out)
        ast.ETry => walk_expr(c, n.a, inout out)
        ast.EBinary => {
            walk_expr(c, n.b, inout out)
            walk_expr(c, n.c, inout out)
        }
        ast.EIndex => {
            walk_expr(c, n.a, inout out)
            walk_expr(c, n.b, inout out)
        }
        ast.ECall => {
            out.push(ekey(c, n))
            for i in 0..n.d { walk_expr(c, arg_expr(c, at(c, n.c, i)), inout out) }
        }
        ast.EMethod => {
            walk_expr(c, n.a, inout out)
            for i in 0..n.d { walk_expr(c, arg_expr(c, at(c, n.c, i)), inout out) }
        }
        ast.EArray => { for i in 0..n.d { walk_expr(c, at(c, n.c, i), inout out) } }
        ast.ETuple => { for i in 0..n.d { walk_expr(c, at(c, n.c, i), inout out) } }
        ast.ELambda => walk_expr(c, n.a, inout out)
        ast.EIf => {
            walk_expr(c, n.a, inout out)
            walk_block(c, n.b, inout out)
            if n.c > 0 { walk_expr(c, n.c - 1, inout out) }
        }
        ast.EMatch => {
            walk_expr(c, n.a, inout out)
            for i in 0..n.d {
                let arm = nd(c, at(c, n.c, i))
                if arm.b == 1 { walk_stmt(c, arm.a, inout out) } else { walk_expr(c, arm.a, inout out) }
            }
        }
        ast.EBlock => walk_block(c, n.a, inout out)
        ast.EUnsafe => walk_block(c, n.a, inout out)
        _ => {}
    }
}

fn walk_block(c: C, b: u32, inout out: List[u64]) {
    let n = nd(c, b)
    for i in 0..n.d { walk_stmt(c, at(c, n.c, i), inout out) }
}

fn walk_stmt(c: C, st: u32, inout out: List[u64]) {
    let n = nd(c, st)
    match n.kind {
        ast.SLet => walk_expr(c, n.c, inout out)
        ast.SLetPat => walk_expr(c, n.c, inout out)
        ast.SAssign => {
            walk_expr(c, n.a, inout out)
            walk_expr(c, n.c, inout out)
        }
        ast.SExpr => walk_expr(c, n.a, inout out)
        ast.SWhile => {
            walk_expr(c, n.a, inout out)
            walk_block(c, n.b, inout out)
        }
        ast.SFor => {
            walk_expr(c, n.b, inout out)
            walk_expr(c, n.c, inout out)
            walk_block(c, n.d, inout out)
        }
        ast.SForEach => {
            walk_expr(c, n.b, inout out)
            walk_block(c, n.d, inout out)
        }
        ast.SReturn => { if n.a > 0 { walk_expr(c, n.a - 1, inout out) } }
        ast.SAssert => walk_expr(c, n.a, inout out)
        _ => {}
    }
}

/// A captured variable: its name key and its local in the enclosing function.
type Capture = { key: u64, ty: u32, ir: u32, aline: u32, acol: u32, alias: u32, refid: u32 }

/// The state of the enclosing function while a closure body is checked.
type Saved = {
    scopes: List[Local], marks: List[u32], frames: List[Owned], fmarks: List[u32], firs: List[u32],
    fresh: Map[u32, bool], ret: u32, loops: u32, loop_bases: List[u32], lam_expr: bool,
}

/// `|params| body`: the body becomes an IR function of its own whose
/// environment holds a snapshot (clone) of every enclosing local the body mentions.
fn lambda(inout c: C, n: ast.Node, exp: u32) -> Result[V, diag.Diag] {
    let mut hp: List[u32] = List.new()
    let mut hr = NONE
    // a closure where an error value is expected: its parameters and result are of the error type
    let err_exp = poisoned(c, exp) && types.kind(c.t, exp) != types.T_FN
    if err_exp { hr = exp }
    if exp != NONE && types.kind(c.t, exp) == types.T_FN {
        hp = types.elems(c.t, exp)
        hr = types.get(c.t, exp).b
    } else if c.lam.has {
        hp = c.lam.params
        hr = c.lam.ret
    }
    c.lam = no_hint()
    if hp.len() > 0 && hp.len() as u32 != n.d {
        return Err(err("E0405", n.line, n.col, q2("this closure takes ", num(n.d as u64), " parameter(s), but ", num(hp.len() as u64), " are expected here")))
    }
    let mut ptys: List[u32] = List.new()
    let mut pkeys: List[u64] = List.new()
    for i in 0..n.d {
        let lp = nd(c, at(c, n.c, i))
        let mut hinted = NONE
        if (i as usize) < hp.len() { hinted = hp[i as usize] }
        let mut ty = hinted.copy()
        if lp.b > 0 {
            let am = c.am.copy()
            let t = resolve_ty(inout c, am, lp.b - 1)?
            if hinted != NONE && !same(c, hinted, t) { return Err(mismatch(c, lp.line, lp.col, hinted, t)) }
            ty = t
        } else if hinted == NONE && err_exp {
            ty = exp
        } else if hinted == NONE {
            let pn = nm(c, lp.a)
            let mut d = err("E0409", lp.line, lp.col, q("cannot infer the type of closure parameter `", pn, "`"))
            d.help = q("annotate it: `|", pn, ": i32| ...`")
            return Err(d)
        }
        ptys.push(ty)
        pkeys.push(resolve.key(0, lp.a))
    }
    let mut ret_hint = hr.copy()
    if n.g > 0 {
        let am = c.am.copy()
        ret_hint = resolve_ty(inout c, am, n.g - 1)?
    }
    // captured variables
    let mut names: List[u64] = List.new()
    walk_expr(c, n.a, inout names)
    let mut caps: List[Capture] = List.new()
    let mut ckeys: List[u64] = List.new()
    for k in names {
        if pkeys.contains(k) || ckeys.contains(k) { continue }
        let li = lookup(c, k)
        if li != NONE {
            let v = c.scopes[li as usize]
            caps.push(Capture(k, v.ty, v.ir, v.aline, v.acol, v.alias, v.refid))
            ckeys.push(k)
        }
    }
    c.closures += 1
    let mut fname = ir.cur_name(c.ir)
    bytes.append(inout fname, s(".closure"))
    bytes.append(inout fname, num(c.closures as u64))
    let f = ir.declare_fn(inout c.ir, fname, false)
    let saved = Saved(c.scopes, c.marks, c.frames, c.fmarks, c.firs, c.fresh, c.ret, c.loops, c.loop_bases, c.lam_expr)
    let ctext = caps_text(c, c.caps)
    ir.begin_nested(inout c.ir, f, types.UNIT, ctext)
    c.scopes = List.new()
    c.marks = List.new()
    push_scope(inout c)
    reset_frames(inout c)
    c.loops = 0
    let mark = ir.open(c.ir)
    let r = lambda_in(inout c, n, caps, ptys, pkeys, ret_hint)
    // the enclosing function's state comes back also when the closure failed
    let b = ir.close(inout c.ir, mark)
    let mut rty = types.UNIT
    match r {
        Ok(t) => { rty = t }
        Err(_) => {}
    }
    ir.set_ret(inout c.ir, rty)
    ir.end_nested(inout c.ir, n.d, b)
    c.scopes = saved.scopes
    c.marks = saved.marks
    c.frames = saved.frames
    c.fmarks = saved.fmarks
    c.firs = saved.firs
    c.fresh = saved.fresh
    c.ret = saved.ret
    c.loops = saved.loops
    c.loop_bases = saved.loop_bases
    c.lam_expr = saved.lam_expr
    match r {
        Ok(_) => {}
        Err(d) => { return Err(d) }
    }
    let fty = types.fn_of(inout c.t, ptys, rty)
    // the environment: a snapshot of each captured variable
    let mut ops: List[u32] = List.new()
    for cp in caps {
        let mut pl = cp.alias.copy()
        if pl == NONE {
            pl = ir.place_local(inout c.ir, cp.ir, cp.ty)
        } else {
            ref_note(inout c, N_USE, cp.refid)
        }
        let o = read(inout c, pl, cp.ty, 0)
        ops.push(take(inout c, v_of(cp.ty, o), n.line))
    }
    let st = ir.list(inout c.ir, ops)
    Ok(v_of(fty, emit_val(inout c, ir.S_CLOSURE, f, st, ops.len() as u32, fty, fty, n.line)))
}

/// The closure's captures and parameters declared, its body checked; its return type.
fn lambda_in(inout c: C, n: ast.Node, caps: List[Capture], ptys: List[u32], pkeys: List[u64], ret_hint: u32) -> Result[u32, diag.Diag] {
    let body = nd(c, n.a)
    for cp in caps {
        let l = ir.local(inout c.ir, resolve.key_sym(cp.key), cp.ty, ir.L_CAPTURE, body.line)
        let mut cl = local_plain(cp.key, cp.ty, false, body.line, body.col, l)
        cl.aline = cp.aline
        cl.acol = cp.acol
        declare(inout c, cl)?
    }
    for i in 0..n.d {
        let lp = nd(c, at(c, n.c, i))
        let l = ir.local(inout c.ir, lp.a, ptys[i as usize], ir.L_PARAM, lp.line)
        declare(inout c, local_plain(pkeys[i as usize], ptys[i as usize], false, lp.line, lp.col, l))?
    }
    lambda_body(inout c, n.a, ret_hint)
}

/// Check a closure body; returns its return type.
fn lambda_body(inout c: C, e: u32, ret_hint: u32) -> Result[u32, diag.Diag] {
    let body = nd(c, e)
    if is_value_form(c, e) {
        if ret_hint == NONE {
            return Err(errh("E0409", body.line, body.col, s("cannot infer the closure's return type"), "write it: `|x| -> i32 { ... }`"))
        }
        c.ret = ret_hint
        c.lam_expr = false
        let dest = if ret_hint == types.UNIT { Dest(D_DISCARD, 0) } else { Dest(D_RETURN, 0) }
        let t = compile_value(inout c, e, dest, ret_hint)?
        if ret_hint != types.UNIT && t != types.NEVER && !same(c, t, ret_hint) { return Err(mismatch(c, body.line, body.col, ret_hint, t)) }
        return Ok(ret_hint)
    }
    c.lam_expr = true
    let v = expr(inout c, e, ret_hint)?
    if ret_hint != NONE && !same(c, v.ty, ret_hint) && v.ty != types.NEVER { return Err(mismatch(c, body.line, body.col, ret_hint, v.ty)) }
    let mut ret = ret_hint.copy()
    if ret == NONE {
        ret = v.ty
        if v.ty == types.NEVER { ret = types.UNIT }
    }
    c.ret = ret
    if v.ty == types.NEVER { return Ok(ret) }
    if ret == types.UNIT {
        drop_frames_from(inout c, 0)
        return Ok(ret)
    }
    let o = take(inout c, v, body.line)
    drop_frames_from(inout c, 0)
    emit(inout c, ir.S_RETURN, 0, o + 1, 0, 0, 0, body.line)
    Ok(ret)
}

/// Call the closure value fv with the arguments of call node n.
fn call_value(inout c: C, n: ast.Node, label: List[u8], fv: V) -> Result[V, diag.Diag] {
    if types.kind(c.t, fv.ty) != types.T_FN {
        let d = if poisoned(c, fv.ty) { quiet() } else { err("E0112", n.line, n.col, q2("`", label, "` has type ", ts(c, fv.ty), ", so it can't be called")) }
        return fail_call(inout c, d, n.c, n.d)
    }
    let ps = types.elems(c.t, fv.ty)
    let r = types.get(c.t, fv.ty).b
    if n.d != ps.len() as u32 {
        let fd = err("E0405", n.line, n.col, q3("`", label, "` takes ", num(ps.len() as u64), " argument(s), but ", num(n.d as u64), " were given"))
        return fail_call(inout c, fd, n.c, n.d)
    }
    let mut args: List[u32] = List.new()
    for i in 0..n.d {
        let a = nd(c, at(c, n.c, i))
        let x = nd(c, a.a)
        if a.b == 1 { return Err(err("E0304", x.line, x.col, s("closures can't take `inout` arguments"))) }
        let t = ps[i as usize]
        let v = expr(inout c, a.a, t)?
        if !same(c, v.ty, t) { return Err(mismatch(c, x.line, x.col, t, v.ty)) }
        args.push(v.op)
    }
    Ok(v_of(r, callv(inout c, fv.op, args, r, n.line)))
}

fn callv(inout c: C, f: u32, args: List[u32], r: u32, line: u32) -> u32 {
    let st = ir.list(inout c.ir, args)
    let na = args.len() as u32
    if r == types.UNIT {
        emit(inout c, ir.S_CALLV, ir.NONE, f, st, na, r, line)
        return ir.op_unit(inout c.ir)
    }
    emit_val(inout c, ir.S_CALLV, f, st, na, r, r, line)
}

/// The fn type of instance ii.
fn inst_fn_type(inout c: C, ii: u32) -> u32 {
    let inst = c.insts[ii as usize].copy()
    let mut ps: List[u32] = List.new()
    for i in 0..inst.plen { ps.push(c.ptys[(inst.pstart + i) as usize]) }
    types.fn_of(inout c.t, ps, inst.ret)
}

/// A named function used as a value of the expected fn type.
fn fn_as_value(inout c: C, n: ast.Node, k: u64, exp: u32) -> Result[V, diag.Diag] {
    let fi = mget(c.fns, k)
    let f = c.fdefs[fi as usize].copy()
    let label = kt(c, k)
    if f.generic {
        return Err(err("E0409", n.line, n.col, q("generic function `", label, "` can't be used as a value; wrap it in a closure")))
    }
    let ii = instantiate(inout c, fi, no_subst())?
    let fnode = ndm(c, f.md, f.node)
    for i in 0..fnode.f {
        if ndm(c, f.md, atm(c, f.md, fnode.e, i)).c == 1 {
            return Err(err("E0304", n.line, n.col, q("`", label, "` has `inout` parameters and can't be used as a value")))
        }
    }
    let actual = inst_fn_type(inout c, ii)
    if !same(c, actual, exp) { return Err(mismatch(c, n.line, n.col, exp, actual)) }
    let inst = c.insts[ii as usize].copy()
    for i in 0..inst.clen {
        let cap = c.capl[(inst.cstart + i) as usize]
        if needs_cap(c, f.md, cap) && !has_sym(c.caps, cap) { return Err(cap_error(c, n.line, n.col, label, cap)) }
    }
    // checking declared capabilities alone would pass these with neither `unsafe` nor `ffi`
    if f.unsafe_fn { return Err(unsup(n.line, n.col, "`extern` and `unsafe` functions as values")) }
    Ok(v_of(actual, emit_val(inout c, ir.S_FNREF, inst.ir, 0, 0, actual, actual, n.line)))
}

/// A loop over the elements of the List at place `seq` (see list_loop_end).
type ListLoop = { ip: u32, mark: u32, iv: u32 }

/// i := 0; loop { if !(i < len(seq)) break; ...
fn list_loop(inout c: C, seq: u32, lty: u32, line: u32) -> ListLoop {
    let idx = tmp(inout c, types.USIZE, line)
    let zero = ir.op_int(inout c.ir, types.USIZE, 0)
    emit(inout c, ir.S_COPY, idx, zero, 0, 0, types.USIZE, line)
    let ip = ir.place_local(inout c.ir, idx, types.USIZE)
    let lm = ir.open(c.ir)
    let iv = read(inout c, ip, types.USIZE, 0)
    let lv = read(inout c, seq, lty, 0)
    let lim = builtin_op(inout c, ir.B_LEN, one(lv), types.USIZE, 0)
    let cond = emit_val(inout c, ir.S_BINARY, ast.OP_LT, iv, lim, types.USIZE, types.BOOL, 0)
    let base = c.fmarks.len() as u32
    emit_exit_unless(inout c, cond, base, line)
    ListLoop(ip, lm, iv)
}

/// ... } step { i = i +% 1 }
fn list_loop_end(inout c: C, lp: ListLoop, line: u32) {
    let body = ir.close(inout c.ir, lp.mark)
    let sm = ir.open(c.ir)
    let cur = read(inout c, lp.ip, types.USIZE, 0)
    let one1 = ir.op_int(inout c.ir, types.USIZE, 1)
    let next = emit_val(inout c, ir.S_BINARY, ast.OP_WADD, cur, one1, types.USIZE, types.USIZE, 0)
    emit(inout c, ir.S_STORE, 0, lp.ip, next, 0, types.USIZE, 0)
    let step = ir.close(inout c.ir, sm)
    emit(inout c, ir.S_LOOP, 0, body, step, 0, 0, line)
}

/// The closure argument of a List combinator, checked against `fn(el) -> want`.
fn closure_arg(inout c: C, n: ast.Node, i: u32, ps: List[u32], want: u32) -> Result[V, diag.Diag] {
    c.lam = LamHint(true, ps, want)
    let ae = arg_expr(c, at(c, n.c, i))
    let fv = expr(inout c, ae, NONE)?
    c.lam = no_hint()
    Ok(fv)
}

/// map / filter / for_each / any / all on a List.
fn combinator(inout c: C, n: ast.Node, pv: PV, mi: u32) -> Result[V, diag.Diag] {
    let ty = pv.ty
    let el = types.get(c.t, ty).a
    let mut want = NONE
    if mi == M_FILTER || mi == M_ANY || mi == M_ALL { want = types.BOOL }
    if mi == M_FOR_EACH { want = types.UNIT }
    let ro = recv_op(inout c, pv)
    let fv = closure_arg(inout c, n, 0, one(el), want)?
    let ae = nd(c, arg_expr(c, at(c, n.c, 0)))
    if poisoned(c, fv.ty) || poisoned(c, el) { return Ok(poison_v(inout c)) }
    let mut ok = types.kind(c.t, fv.ty) == types.T_FN
    if ok {
        let ps = types.elems(c.t, fv.ty)
        ok = ps.len() == 1 && ps[0] == el
    }
    if !ok {
        return Err(err("E0401", ae.line, ae.col, q2("expected a closure taking ", ts(c, el), ", found ", ts(c, fv.ty), "")))
    }
    let rt = types.get(c.t, fv.ty).b
    if want != NONE && !same(c, rt, want) { return Err(mismatch(c, ae.line, ae.col, want, rt)) }
    let seq = place_of_op(inout c, ro, ty, n.line)
    if mi == M_MAP {
        if rt == types.UNIT || rt == types.NEVER { return Err(err("E0401", ae.line, ae.col, s("`map` needs a closure that returns a value"))) }
        let out_ty = types.list_of(inout c.t, rt)
        let out = builtin_op(inout c, ir.B_LIST_NEW, List.new(), out_ty, n.line)
        let outp = place_of_op(inout c, out, out_ty, n.line) + ir.ARG_PLACE
        let lp = list_loop(inout c, seq, ty, n.line)
        let ipl = ir.place_index(inout c.ir, seq, lp.iv, el, n.line)
    let item = read(inout c, ipl, el, 0)
        let r = callv(inout c, fv.op, one(item), rt, n.line)
        builtin_op(inout c, ir.B_LIST_PUSH, two(outp, r), types.UNIT, n.line)
        list_loop_end(inout c, lp, n.line)
        return Ok(v_of(out_ty, out))
    }
    if mi == M_FILTER {
        let out = builtin_op(inout c, ir.B_LIST_NEW, List.new(), ty, n.line)
        let outp = place_of_op(inout c, out, ty, n.line) + ir.ARG_PLACE
        let lp = list_loop(inout c, seq, ty, n.line)
        let ipl = ir.place_index(inout c.ir, seq, lp.iv, el, n.line)
    let item = read(inout c, ipl, el, 0)
        let keep = callv(inout c, fv.op, one(item), types.BOOL, n.line)
        let tm = ir.open(c.ir)
        let mut x = item.copy()
        if owns(c, el) { x = emit_val(inout c, ir.S_CLONE, item, 0, 0, el, el, n.line) }
        builtin_op(inout c, ir.B_LIST_PUSH, two(outp, x), types.UNIT, n.line)
        let then = ir.close(inout c.ir, tm)
        let els = ir.empty_block(inout c.ir)
        emit(inout c, ir.S_IF, 0, keep, then, els, 0, n.line)
        list_loop_end(inout c, lp, n.line)
        return Ok(v_of(ty, out))
    }
    if mi == M_FOR_EACH {
        let lp = list_loop(inout c, seq, ty, n.line)
        let ipl = ir.place_index(inout c.ir, seq, lp.iv, el, n.line)
    let item = read(inout c, ipl, el, 0)
        callv(inout c, fv.op, one(item), types.UNIT, n.line)
        list_loop_end(inout c, lp, n.line)
        return Ok(v_of(types.UNIT, ir.op_unit(inout c.ir)))
    }
    // any / all: r := !any; loop { if f(x) == any { r = any; break } }
    let any = mi == M_ANY
    let r = tmp(inout c, types.BOOL, n.line)
    let init = ir.op_bool(inout c.ir, !any)
    emit(inout c, ir.S_COPY, r, init, 0, 0, types.BOOL, n.line)
    let lp = list_loop(inout c, seq, ty, n.line)
    let ipl = ir.place_index(inout c.ir, seq, lp.iv, el, n.line)
    let item = read(inout c, ipl, el, 0)
    let b = callv(inout c, fv.op, one(item), types.BOOL, n.line)
    let hm = ir.open(c.ir)
    let val = ir.op_bool(inout c.ir, any)
    emit(inout c, ir.S_COPY, r, val, 0, 0, types.BOOL, n.line)
    emit(inout c, ir.S_BREAK, 0, 0, 0, 0, 0, n.line)
    let hit = ir.close(inout c.ir, hm)
    let none = ir.empty_block(inout c.ir)
    if any {
        emit(inout c, ir.S_IF, 0, b, hit, none, 0, n.line)
    } else {
        emit(inout c, ir.S_IF, 0, b, none, hit, 0, n.line)
    }
    list_loop_end(inout c, lp, n.line)
    Ok(v_of(types.BOOL, ir.op_local(inout c.ir, r, types.BOOL)))
}

/// `l.fold(init, f)`: acc := init; for x in l { acc = f(acc, x) } (the old acc dropped).
fn fold_list(inout c: C, n: ast.Node, pv: PV) -> Result[V, diag.Diag] {
    let ty = pv.ty
    let el = types.get(c.t, ty).a
    let ro = recv_op(inout c, pv)
    let ie = arg_expr(c, at(c, n.c, 0))
    let init = expr(inout c, ie, NONE)?
    let acc_ty = init.ty
    let fv = closure_arg(inout c, n, 1, two(acc_ty, el), acc_ty)?
    let want = types.fn_of(inout c.t, two(acc_ty, el), acc_ty)
    if poisoned(c, fv.ty) || poisoned(c, want) { return Ok(poison_v(inout c)) }
    if fv.ty != want {
        let ae = nd(c, arg_expr(c, at(c, n.c, 1)))
        let mut m = q3("expected fn(", ts(c, acc_ty), ", ", ts(c, el), ") -> ", ts(c, acc_ty), ", found ")
        bytes.append(inout m, ts(c, fv.ty))
        return Err(err("E0401", ae.line, ae.col, m))
    }
    let seq = place_of_op(inout c, ro, ty, n.line)
    let acc = tmp(inout c, acc_ty, n.line)
    let io = take(inout c, init, n.line)
    emit(inout c, ir.S_COPY, acc, io, 0, 0, acc_ty, n.line)
    let accp = ir.place_local(inout c.ir, acc, acc_ty)
    let lp = list_loop(inout c, seq, ty, n.line)
    let ipl = ir.place_index(inout c.ir, seq, lp.iv, el, n.line)
    let item = read(inout c, ipl, el, 0)
    let av = read(inout c, accp, acc_ty, 0)
    let nv = callv(inout c, fv.op, two(av, item), acc_ty, n.line)
    if owns(c, acc_ty) { emit_drop(inout c, accp, acc_ty) }
    emit(inout c, ir.S_STORE, 0, accp, nv, 0, acc_ty, n.line)
    list_loop_end(inout c, lp, n.line)
    Ok(v_of(acc_ty, ir.op_local(inout c.ir, acc, acc_ty)))
}

// ---- threads (Task/Mutex/Chan, spawn)
//
// Task, Mutex and Chan are shared handles: copying one shares the object (a reference
// count), so threads share data only through them; everything else a closure captures is a
// snapshot. Receivers are borrowed operands (no method mutates the handle itself, so none
// needs an assignable receiver). The closure given to `spawn`, a Mutex's new value and a
// sent value are moved in (`take`); `join`, `get` and `recv` give owned results.

fn is_word(c: C, sym: u32, w: str) -> bool { bytes.eq(nm(c, sym), s(w)) }

/// `spawn(closure)`; the `threads` capability is checked by the caller.
fn spawn(inout c: C, n: ast.Node) -> Result[V, diag.Diag] {
    if n.d != 1 { return Err(err("E0405", n.line, n.col, s("`spawn` takes exactly one closure"))) }
    let ae = arg_expr(c, at(c, n.c, 0))
    let x = nd(c, ae)
    c.lam = no_hint()
    let fv = expr(inout c, ae, NONE)?
    if poisoned(c, fv.ty) { return Ok(poison_v(inout c)) }
    let ft = types.get(c.t, fv.ty)
    if ft.kind != types.T_FN || types.list_len(c.t, ft.a) != 0 {
        return Err(err("E0401", x.line, x.col, q("`spawn` needs a closure with no parameters, found ", ts(c, fv.ty), "")))
    }
    if ft.b == types.NEVER { return Err(err("E0401", x.line, x.col, s("the closure never returns a value"))) }
    let ty = types.task_of(inout c.t, ft.b)
    let o = take(inout c, fv, n.line)
    Ok(v_of(ty, builtin_op(inout c, ir.B_SPAWN, one(o), ty, n.line)))
}

/// `Mutex.new(v)` and `Chan.new()`.
fn thread_static(inout c: C, n: ast.Node, head: u32, exp: u32) -> Result[V, diag.Diag] {
    if head == c.w.heap[4] {
        if n.d != 1 { return Err(err("E0405", n.line, n.col, s("`Mutex.new` takes exactly one argument"))) }
        let mut hint = NONE
        if exp != NONE && types.kind(c.t, exp) == types.T_MUTEX { hint = types.get(c.t, exp).a }
        let ae = arg_expr(c, at(c, n.c, 0))
        let x = nd(c, ae)
        let v = expr(inout c, ae, hint)?
        if hint != NONE && !same(c, v.ty, hint) { return Err(mismatch(c, x.line, x.col, hint, v.ty)) }
        if v.ty == types.UNIT || v.ty == types.NEVER { return Err(err("E0401", x.line, x.col, s("can't put () in a Mutex"))) }
        let ty = types.mutex_of(inout c.t, v.ty)
        let o = take(inout c, v, n.line)
        return Ok(v_of(ty, builtin_op(inout c, ir.B_MUTEX_NEW, one(o), ty, n.line)))
    }
    if poisoned(c, exp) { return Ok(poison_v(inout c)) }
    if exp == NONE || types.kind(c.t, exp) != types.T_CHAN {
        return Err(errh("E0409", n.line, n.col, s("cannot infer the element type of `Chan`"), "annotate the binding, e.g. `let c: Chan[i32] = Chan.new()`"))
    }
    if n.d > 0 { return Err(err("E0405", n.line, n.col, s("`Chan.new` takes no arguments"))) }
    Ok(v_of(exp, builtin_op(inout c, ir.B_CHAN_NEW, List.new(), exp, n.line)))
}

/// Methods of Task, Mutex and Chan.
fn thread_method(inout c: C, n: ast.Node, pv: PV) -> Result[V, diag.Diag] {
    let ty = pv.ty
    let t = types.get(c.t, ty)
    let el = t.a
    let label = label_of(c, ts(c, ty), n.b)
    if t.kind == types.T_TASK && is_word(c, n.b, "join") {
        let ro = recv_op(inout c, pv)
        eval_args(inout c, n, List.new(), label)?
        return Ok(v_of(el, builtin_op(inout c, ir.B_TASK_JOIN, one(ro), el, n.line)))
    }
    if t.kind == types.T_MUTEX {
        if is_word(c, n.b, "get") {
            let ro = recv_op(inout c, pv)
            eval_args(inout c, n, List.new(), label)?
            return Ok(v_of(el, builtin_op(inout c, ir.B_MUTEX_GET, one(ro), el, n.line)))
        }
        if is_word(c, n.b, "set") {
            let ro = recv_op(inout c, pv)
            let vs = eval_args(inout c, n, one(el), label)?
            let x = take(inout c, vs[0], n.line)
            return Ok(v_of(types.UNIT, builtin_op(inout c, ir.B_MUTEX_SET, two(ro, x), types.UNIT, n.line)))
        }
        if is_word(c, n.b, "update") {
            if n.d != 1 { return Err(err("E0405", n.line, n.col, s("`update` takes exactly one closure"))) }
            let ro = recv_op(inout c, pv)
            let fv = closure_arg(inout c, n, 0, one(el), el)?
            let want = types.fn_of(inout c.t, one(el), el)
            if !same(c, fv.ty, want) {
                let ae = nd(c, arg_expr(c, at(c, n.c, 0)))
                return Err(mismatch(c, ae.line, ae.col, want, fv.ty))
            }
            // the closure is borrowed: its owner (a fresh temporary or a variable) drops it
            return Ok(v_of(types.UNIT, builtin_op(inout c, ir.B_MUTEX_UPDATE, two(ro, fv.op), types.UNIT, n.line)))
        }
    }
    if t.kind == types.T_CHAN {
        if is_word(c, n.b, "send") {
            let ro = recv_op(inout c, pv)
            let vs = eval_args(inout c, n, one(el), label)?
            let x = take(inout c, vs[0], n.line)
            return Ok(v_of(types.UNIT, builtin_op(inout c, ir.B_CHAN_SEND, two(ro, x), types.UNIT, n.line)))
        }
        if is_word(c, n.b, "close") {
            let ro = recv_op(inout c, pv)
            eval_args(inout c, n, List.new(), label)?
            return Ok(v_of(types.UNIT, builtin_op(inout c, ir.B_CHAN_CLOSE, one(ro), types.UNIT, n.line)))
        }
        if is_word(c, n.b, "recv") {
            let ro = recv_op(inout c, pv)
            eval_args(inout c, n, List.new(), label)?
            let opt = option_of(inout c, el, n)?
            return Ok(v_of(opt, builtin_op(inout c, ir.B_CHAN_RECV, one(ro), opt, n.line)))
        }
    }
    Err(err("E0115", n.line, n.col, q2("type ", ts(c, ty), " has no method `", nm(c, n.b), "`")))
}

// sha256: SHA-256 (FIPS 180-4) for the driver's cache keys (driver.ei, "Cache"; build.ei).
//
// The compiler may depend only on core and std (LAYERS.md, "compiler/ and packages"), so it
// has its own. Written with the bitwise operators (C8.2, which the seed has), streaming: a
// `Hasher` takes the input in pieces (`update`), so a key over many large parts (unit texts)
// never concatenates them. `new()` and `digest` are the one-shot form.


/// The SHA-256 round constants; `new()` builds it once (cheap) and a caller reuses it.
pub type Sha = { k: List[u32] }

/// A hash in progress: the chaining value, the bytes of a block not yet full, and how many
/// bytes went in.
pub type Hasher = { k: List[u32], h: [u32; 8], buf: List[u8], n: u64 }

pub fn new() -> Sha {
    let k: [u32; 64] = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ]
    let mut kl: List[u32] = List.new()
    for i in 0..64 { kl.push(k[i as usize]) }
    Sha(kl)
}

/// A new streaming hash.
pub fn start(s: Sha) -> Hasher {
    let h: [u32; 8] = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    Hasher(s.k, h, List.new(), 0)
}

fn rotr(x: u32, n: u32) -> u32 { (x >> n) | (x << (32 - n)) }

/// `h0` with the 64-byte block of `d` at `off` compressed into it.
fn block(k: List[u32], h0: [u32; 8], d: List[u8], off: usize) -> [u32; 8] {
    let mut h = h0.copy()
    let mut w: [u32; 64] = [0; 64]
    for t16 in 0..16 {
        let t = t16 as usize
        let j = off + t * 4
        w[t] = ((d[j] as u32) << 24) | ((d[j + 1] as u32) << 16) | ((d[j + 2] as u32) << 8) | (d[j + 3] as u32)
    }
    for t64 in 16..64 {
        let t = t64 as usize
        let x = w[t - 15]
        let y = w[t - 2]
        let s0 = rotr(x, 7) ^ rotr(x, 18) ^ (x >> 3)
        let s1 = rotr(y, 17) ^ rotr(y, 19) ^ (y >> 10)
        w[t] = w[t - 16] +% s0 +% w[t - 7] +% s1
    }
    let mut a = h[0].copy()
    let mut b = h[1].copy()
    let mut c = h[2].copy()
    let mut dd = h[3].copy()
    let mut e = h[4].copy()
    let mut f = h[5].copy()
    let mut g = h[6].copy()
    let mut hh = h[7].copy()
    for t64 in 0..64 {
        let t = t64 as usize
        let S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
        let ch = (e & f) ^ (~e & g)
        let t1 = hh +% S1 +% ch +% k[t] +% w[t]
        let S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
        let maj = (a & b) ^ (a & c) ^ (b & c)
        let t2 = S0 +% maj
        hh = g
        g = f
        f = e
        e = dd +% t1
        dd = c
        c = b
        b = a
        a = t1 +% t2
    }
    h[0] = h[0] +% a
    h[1] = h[1] +% b
    h[2] = h[2] +% c
    h[3] = h[3] +% dd
    h[4] = h[4] +% e
    h[5] = h[5] +% f
    h[6] = h[6] +% g
    h[7] = h[7] +% hh
    h
}

/// Add `data` to the hash.
pub fn update(inout s: Hasher, data: List[u8]) {
    let n = data.len()
    s.n += n as u64
    let mut i: usize = 0
    // first top up a partial block
    if s.buf.len() > 0 {
        while i < n && s.buf.len() < 64 {
            s.buf.push(data[i])
            i += 1
        }
        if s.buf.len() < 64 { return }
        s.h = block(s.k, s.h, s.buf, 0)
        s.buf = List.new()
    }
    while i + 64 <= n {
        s.h = block(s.k, s.h, data, i)
        i += 64
    }
    while i < n {
        s.buf.push(data[i])
        i += 1
    }
}

/// The 32-byte digest of everything added.
pub fn finish(s: Hasher) -> List[u8] {
    let mut h = s.h.copy()
    let mut tail = s.buf.copy()
    tail.push(128)
    while tail.len() % 64 != 56 { tail.push(0) }
    let bits = s.n *% 8
    let mut j: u64 = 8
    while j > 0 {
        j -= 1
        tail.push(((bits >> (j * 8)) & 255) as u8)
    }
    let mut off: usize = 0
    while off < tail.len() {
        h = block(s.k, h, tail, off)
        off += 64
    }
    let mut out: List[u8] = List.new()
    for j8 in 0..8 {
        let x = h[j8 as usize].copy()
        out.push((x >> 24) as u8)
        out.push(((x >> 16) & 255) as u8)
        out.push(((x >> 8) & 255) as u8)
        out.push((x & 255) as u8)
    }
    out
}

/// The 32-byte digest of `data`.
pub fn digest(s: Sha, data: List[u8]) -> List[u8] {
    let mut st = start(s)
    update(inout st, data)
    finish(st)
}

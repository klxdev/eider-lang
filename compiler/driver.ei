// driver: `build`, `build --lib`, `run` and `test` (docs/compiler.md, "C7: driver",
// "Backends" and "C8.27: incremental builds").
//
// The program's LLVM IR (llvm.ei, as units: llvm_units.ei) is compiled by clang
// ($EIDER_LLVM_CC, default clang, LLVM 17+) and linked with the C core (core/eider_rt.c, the
// language runtime, and core/eider_core.c, the OS ABI that std sits on), which $CC (default
// cc) compiles with -std=c11 -pedantic -Wall -Wextra -O0|-O2 -pthread $EIDER_CFLAGS -I
// <root>/core. `run` and `test` use -O0, `build` and `run --release` -O2. EIDER_CFLAGS (split
// at spaces) adds flags, e.g. a sanitizer (clang gets its -fsanitize*, -g and -O flags for the
// IR). `-l <lib>` options link C libraries (for `extern "c"` functions outside the core).
//
// Cache ($EIDER_CACHE: `off`, or a directory; default $XDG_CACHE_HOME/eider, else
// $HOME/.cache/eider). A build is units compiled to objects and linked (build.ei, whose top
// has the cache layout and keys; docs/compiler.md "C8.27: incremental builds"): here the units
// are the IR's units, compiled by clang, and the C core's two sources (eider_rt.c, eider_core.c),
// compiled by the cc argv (cc, every flag, EIDER_CFLAGS, -I path), at most -j at a time (default
// $EIDER_JOBS, else the CPUs), each object cached by its text, headers, argv and `cc
// --version`; the program is cached by the link command, the objects' keys and the -l
// libraries. Not part of any key: the contents of `-l` libraries and of system headers beyond
// what `--version` identifies. A work directory (tmp/eiderc-<ms>-<n>/) per compile.
//
// Every install is atomic: files are made in the process's own work directory (mkdir is
// exclusive, so two processes never share one) and renamed into place, so a concurrent
// eiderc sees either nothing or a complete entry; two processes building the same entry
// both succeed and one rename wins. With the cache off the objects stay in the work
// directory, which is under <root>/target/tmp/ (else $TMPDIR, else /tmp).
//
// `build --lib` compiles the IR with -O2 -fPIC to an object, takes the core objects
// for the same flags, and makes lib<name>.a (ar rcs) and lib<name>.so (cc -shared, with the
// -l libraries) from them, plus <name>.h (lower.header); <name> is `-o`'s file name, else the
// source's stem, and the files go next to `-o`'s path (else in the working directory), as
// tests/oracle expects. The library is self-contained: it carries the runtime and the core.
//
// Reusable entry points (comptime evaluation builds and runs IR through them):
// `try_executable` returns a built program (cached or in a work directory) and `discard`
// removes its work directory; `build_llvm`, `build_lib_llvm` and `run_llvm` are the commands.
//
// The toolchain root (the directory holding core/) is toolchain.find's (toolchain.ei, shared
// with resolve): $EIDER_ROOT if set; otherwise the nearest directory above the eiderc binary
// (argv[0], symlinks resolved) that contains core/eider_rt.h, so target/eiderc in a checkout
// finds the checkout; otherwise the same search from the working directory.

import core.sys
import std.bytes
import std.fs
import std.io
import std.env
import std.proc
import eiderc.build
import eiderc.toolchain

fn s(x: str) -> List[u8] { sys.lit(x) }

pub fn fail(msg: List[u8], code: i32) uses io {
    let mut m = s("eiderc: ")
    bytes.append(inout m, msg)
    io.errln(m)
    env.exit(code)
}

/// The toolchain root (see the top of this file).
pub fn root() -> List[u8] uses io, fs {
    let r = find_root()
    if r.len() == 0 { fail(s("cannot find the toolchain (a directory with core/eider_rt.h); set EIDER_ROOT"), 2) }
    // absolute: generated units are compiled from their own directories (build.compile)
    match fs.absolute(r) {
        Ok(x) => x
        Err(_) => r
    }
}

/// `root`, or "" when there is none (instead of exiting): toolchain.find, the lookup resolve
/// uses for the prelude and std too.
pub fn find_root() -> List[u8] uses io, fs { toolchain.find() }

/// A new work directory of our own (`work_dir`: under the cache or target/, never shared
/// with another process); the caller removes it.
pub fn temp_dir() -> List[u8] uses io, fs, clock { work_dir() }

/// The file name of `path` without directories and without its extension.
pub fn stem(path: List[u8]) -> List[u8] {
    let mut start: usize = 0
    match bytes.rfind_byte(path, 47) {
        Some(i) => { start = i + 1 }
        None => {}
    }
    let mut end = path.len()
    match bytes.rfind_byte(path, 46) {
        Some(i) => { if i > start { end = i } }
        None => {}
    }
    bytes.slice(path, start, end)
}

fn extra_flags(inout argv: List[List[u8]]) uses io {
    match env.get(s("EIDER_CFLAGS")) {
        Some(f) => {
            for x in bytes.split(f, 32) {
                if x.len() > 0 { argv.push(x) }
            }
        }
        None => {}
    }
}

pub fn write_or_fail(path: List[u8], data: List[u8]) uses io, fs {
    match fs.write(path, data) {
        Ok(_) => {}
        Err(_) => {
            let mut m = s("cannot write ")
            bytes.append(inout m, path)
            fail(m, 3)
        }
    }
}

/// The toolchain's version: the first line of <root>/VERSION ("" when there is none). A
/// profile records it (docs/runtime.md "Profile format").
pub fn version() -> List[u8] uses io, fs {
    let r = find_root()
    if r.len() == 0 { return List.new() }
    match fs.read(fs.join(r, s("VERSION"))) {
        Ok(t) => {
            let mut v: List[u8] = List.new()
            for b in t {
                if b == 10 || b == 13 { break }
                if b >= 32 && b < 127 && b != 34 && b != 92 { v.push(b) }
            }
            v
        }
        Err(_) => List.new()
    }
}

/// The C compiler and the flags every compile uses (core = <root>/core).
pub fn cc_argv(core: List[u8], release: bool) -> List[List[u8]] uses io {
    let mut cc = s("cc")
    match env.get(s("CC")) {
        Some(x) => { if x.len() > 0 { cc = x } }
        None => {}
    }
    let mut argv: List[List[u8]] = List.new()
    argv.push(cc)
    argv.push(s("-std=c11"))
    argv.push(s("-pedantic"))
    argv.push(s("-Wall"))
    argv.push(s("-Wextra"))
    argv.push(s("-Wno-unused-function"))
    argv.push(s("-Wno-unused-variable"))
    argv.push(s("-Wno-unused-but-set-variable"))
    argv.push(s("-Wno-unused-parameter"))
    if release { argv.push(s("-O2")) } else { argv.push(s("-O0")) }
    argv.push(s("-pthread"))
    extra_flags(inout argv)
    argv.push(s("-I"))
    argv.push(core)
    argv
}

fn add_libs(inout argv: List[List[u8]], libs: List[List[u8]]) {
    for l in libs {
        let mut a = s("-l")
        bytes.append(inout a, l)
        argv.push(a)
    }
}

/// Run a toolchain command; exit 3 when it can't be started or fails (`what` names it).
fn tool(argv: List[List[u8]], what: str) uses io, fs, net {
    let code = match proc.run(argv) {
        Ok(n) => n
        Err(_) => {
            let mut m = s("cannot run `")
            bytes.append(inout m, argv[0])
            bytes.append(inout m, s("`"))
            fail(m, 3)
            3
        }
    }
    if code != 0 { fail(s(what), 3) }
}

// ------------------------------------------------------------------ cache and work dirs

/// The cache directory (see the top of this file), or "" when the cache is off.
pub fn cache_dir() -> List[u8] uses io {
    match env.get(s("EIDER_CACHE")) {
        Some(d) => {
            if bytes.eq(d, s("off")) { return List.new() }
            if d.len() > 0 { return d }
        }
        None => {}
    }
    match env.get(s("XDG_CACHE_HOME")) {
        Some(x) => { if x.len() > 0 { return fs.join(x, s("eider")) } }
        None => {}
    }
    match env.get(s("HOME")) {
        Some(h) => { if h.len() > 0 { return fs.join(h, s(".cache/eider")) } }
        None => {}
    }
    List.new()
}

/// Lowercase hex SHA-256 of `parts`, each prefixed with its length (build.key).
pub fn key(parts: List[List[u8]]) -> List[u8] { build.key(parts) }

/// The parallel compile jobs: `jobs` when it is set (-j), else $EIDER_JOBS, else 0 (one per
/// CPU, build.cpus).
pub fn jobs_or_default(jobs: u64) -> u64 uses io {
    if jobs > 0 { return jobs }
    match env.get(s("EIDER_JOBS")) {
        Some(v) => {
            match bytes.parse_u64(v) {
                Some(n) => n
                None => 0
            }
        }
        None => 0
    }
}

/// A new, empty directory of our own under `base` ("" if it can't be made).
fn fresh_dir(base: List[u8]) -> List[u8] uses fs, clock {
    match fs.mkdir_all(base) {
        Ok(_) => {}
        Err(_) => { return List.new() }
    }
    let stamp = now_ms()
    for k in 0..10000 {
        let mut name = s("eiderc-")
        bytes.append(inout name, bytes.from_u64(stamp))
        name.push(45)
        bytes.append(inout name, bytes.from_u64(k as u64))
        let d = fs.join(base, name)
        // mkdir fails if the directory exists, so a success means it is ours
        sys.send(d)
        if sys.mkdir() == 0 { return d }
        if !fs.is_dir(base) { return List.new() }
    }
    List.new()
}

/// The work directory for one compile: under <cache>/tmp/, else <root>/target/tmp/, else
/// $TMPDIR (or /tmp), whichever is writable first.
fn work_dir() -> List[u8] uses io, fs, clock {
    // without a toolchain, exit 2 for that first (as before try_work_dir existed)
    root()
    let d = try_work_dir()
    if d.len() == 0 { fail(s("cannot create a work directory"), 3) }
    d
}

/// `work_dir`, or "" when none can be made (instead of exiting).
pub fn try_work_dir() -> List[u8] uses io, fs, clock {
    let mut bases: List[List[u8]] = List.new()
    let cache = cache_dir()
    if cache.len() > 0 { bases.push(fs.join(cache, s("tmp"))) }
    let r = find_root()
    if r.len() > 0 { bases.push(fs.join(r, s("target/tmp"))) }
    let mut t = s("/tmp")
    match env.get(s("TMPDIR")) {
        Some(x) => { if x.len() > 0 { t = x } }
        None => {}
    }
    bases.push(t)
    for b in bases {
        let d = fresh_dir(b)
        if d.len() > 0 { return d }
    }
    List.new()
}

fn read_or_fail(path: List[u8]) -> List[u8] uses io, fs {
    match fs.read(path) {
        Ok(t) => t
        Err(_) => {
            let mut m = s("cannot read ")
            bytes.append(inout m, path)
            fail(m, 3)
            List.new()
        }
    }
}

/// The identity of the compiler of `cc` for the cache keys (build.tool_id), or "" with the
/// cache off (nothing is keyed, so `--version` isn't run).
fn tool_of(cc: List[List[u8]]) -> List[u8] uses io, fs, net {
    if cache_dir().len() == 0 { return List.new() }
    build.tool_id(cc[0])
}

/// The C core's two units (eider_rt.c, eider_core.c) compiled by `cc`.
fn core_units(cc: List[List[u8]], core: List[u8], tool: List[u8]) -> List[build.Unit] uses io, fs {
    let mut hdr: List[List[u8]] = List.new()
    hdr.push(read_or_fail(fs.join(core, s("eider_rt.h"))))
    let mut units: List[build.Unit] = List.new()
    let rt = fs.join(core, s("eider_rt.c"))
    let mut rdeps = hdr.copy()
    for a in cc {
        if bytes.eq(a, s("-DEI_RT_PROFILE")) { rdeps.push(read_or_fail(fs.join(core, s("eider_prof.c")))) }
    }
    units.push(build.Unit(s("eider_rt"), s(".c"), read_or_fail(rt), rt, cc, tool, rdeps))
    let co = fs.join(core, s("eider_core.c"))
    let mut cdeps: List[List[u8]] = List.new()
    cdeps.push(read_or_fail(fs.join(core, s("eider_core_ext.h"))))
    units.push(build.Unit(s("eider_core"), s(".c"), read_or_fail(co), co, cc, tool, cdeps))
    units
}

/// Compile `units` (build.compile) and link them with `link_argv` and `post` (build.link)
/// into `exe`, or the cache. On a compile failure: `quiet` returns "", else exit 3 saying
/// which unit failed (`internal`: the units that are generated code, from the first; the rest
/// are the C core). A link that fails because a cached object vanished (a concurrent `cache
/// clean` or trim) compiles again once.
fn build_units(units: List[build.Unit], internal: usize, link_argv: List[List[u8]], nokey: List[List[u8]], post: List[List[u8]], tool: List[u8], dir: List[u8], exe: List[u8], jobs: u64, quiet: bool) -> List[u8] uses io, fs, net, clock {
    let cache = cache_dir()
    for attempt in 0..2 {
        let b = build.compile(units, cache, dir, jobs_or_default(jobs), quiet)
        if b.failed >= 0 {
            if quiet { return List.new() }
            if (b.failed as usize) < internal {
                let mut m = s("internal error: generated code failed to compile (kept at ")
                bytes.append(inout m, b.failed_src)
                m.push(41)
                fail(m, 3)
            }
            fail(s("compiling the C core failed"), 3)
        }
        let path = build.link(link_argv, nokey, b.keys, b.objs, post, tool, cache, exe, quiet)
        if path.len() > 0 {
            if b.compiled.len() > 0 { build.maybe_trim(cache) }
            return path
        }
        let mut lost = false
        for o in b.objs {
            if !fs.exists(o) { lost = true }
        }
        if !lost || attempt == 1 { break }
    }
    if quiet { return List.new() }
    fail(s("linking the program failed"), 3)
    List.new()
}

/// The name of the library `build --lib` makes from `file` with `-o out` (lib<name>.a,
/// <name>.h): out's file name, else the source's stem. The header's include guard is
/// derived from it (lower.header).
pub fn lib_name(file: List[u8], out: List[u8]) -> List[u8] {
    let mut base = out.copy()
    if base.len() == 0 { base = stem(file) }
    match bytes.rfind_byte(base, 47) {
        Some(i) => bytes.slice(base, i + 1, base.len())
        None => base
    }
}

/// `eiderc build --lib`: lib<name>.a, lib<name>.so and <name>.h (see the top of this file)
/// from the library's objects `extra` (its IR's) and the C core, in work directory `dir`.
fn build_lib_with(h: List[u8], file: List[u8], out: List[u8], libs: List[List[u8]], extra: List[List[u8]], dir: List[u8], jobs: u64) uses io, fs, net, clock {
    let mut base = out.copy()
    if base.len() == 0 { base = stem(file) }
    let mut name = base.copy()
    let mut odir: List[u8] = List.new()
    match bytes.rfind_byte(base, 47) {
        Some(i) => {
            name = bytes.slice(base, i + 1, base.len())
            odir = bytes.slice(base, 0, i + 1)
        }
        None => {}
    }
    let mut hfile = base.copy()
    bytes.append(inout hfile, s(".h"))
    let mut afile = odir.copy()
    bytes.append(inout afile, s("lib"))
    bytes.append(inout afile, name)
    let mut sofile = afile.copy()
    bytes.append(inout afile, s(".a"))
    bytes.append(inout sofile, s(".so"))
    let core = fs.join(root(), s("core"))
    let mut cc = cc_argv(core, true)
    cc.push(s("-fPIC"))
    let tl = tool_of(cc)
    let units = core_units(cc, core, tl)
    let b = build.compile(units, cache_dir(), dir, jobs_or_default(jobs), false)
    if b.failed >= 0 { fail(s("compiling the C core failed"), 3) }
    let mut objs = extra.copy()
    for x in b.objs { objs.push(x) }
    fs.remove_all(afile)
    let mut ar: List[List[u8]] = List.new()
    ar.push(s("ar"))
    ar.push(s("rcs"))
    ar.push(afile)
    for o in objs { ar.push(o) }
    tool(ar, "`ar` failed")
    let mut so: List[List[u8]] = List.new()
    so.push(cc[0])
    so.push(s("-shared"))
    so.push(s("-pthread"))
    so.push(s("-o"))
    so.push(sofile)
    for o in objs { so.push(o) }
    add_libs(inout so, libs)
    tool(so, "linking the shared library failed")
    write_or_fail(hfile, h)
    fs.remove_all(dir)
    let mut m = s("built ")
    bytes.append(inout m, afile)
    bytes.append(inout m, s(", "))
    bytes.append(inout m, sofile)
    bytes.append(inout m, s(", "))
    bytes.append(inout m, hfile)
    io.outln(m)
}

// ------------------------------------------------------------------ building the IR
//
// build, run, test, build --lib and comptime evaluators (llvm.ei; docs/compiler.md,
// "Backends", "C8.27: incremental builds"): the LLVM IR, as units (llvm_units.ei), is compiled
// by clang ($EIDER_LLVM_CC, default clang; LLVM 17 or newer, checked first), the C core by $CC,
// and $CC (or clang, with ThinLTO) links them. Of EIDER_CFLAGS, clang gets the
// -fsanitize*/-fno-sanitize* flags (instrumentation of the IR), -g and -O<n> (after the
// driver's own, so `EIDER_CFLAGS=-O0 eiderc build` is -O0 everywhere); $CC gets them all.

/// clang for the IR; exits 3 when it can't run or is older than LLVM `min`.
pub fn llvm_cc(min: u64) -> List[u8] uses io, fs, net {
    let mut cc = s("clang")
    match env.get(s("EIDER_LLVM_CC")) {
        Some(x) => { if x.len() > 0 { cc = x } }
        None => {}
    }
    let mut v: List[List[u8]] = List.new()
    v.push(cc)
    v.push(s("--version"))
    let out: List[u8] = match proc.run_with(v, proc.captured()) {
        Ok(o) => o.out
        Err(_) => {
            let mut m = s("building a program needs clang (LLVM ")
            bytes.append(inout m, bytes.from_u64(min))
            bytes.append(inout m, s(" or newer); cannot run `"))
            bytes.append(inout m, cc)
            bytes.append(inout m, s("` (set EIDER_LLVM_CC)"))
            fail(m, 3)
            List.new()
        }
    }
    let mut major: u64 = 0
    match bytes.find(out, s("version "), 0) {
        Some(i) => {
            let mut j = i + 8
            while j < out.len() && bytes.is_digit(out[j]) {
                major = major * 10 + (out[j] - 48) as u64
                j += 1
            }
        }
        None => {}
    }
    if major < min {
        let mut m = s("building a program needs clang (LLVM ")
        bytes.append(inout m, bytes.from_u64(min))
        bytes.append(inout m, s(" or newer), but `"))
        bytes.append(inout m, cc)
        bytes.append(inout m, s("` is LLVM "))
        bytes.append(inout m, bytes.from_u64(major))
        fail(m, 3)
    }
    cc
}

/// The target clang builds for (`<clang> -dumpmachine`): llvm_abi's AARCH64 for aarch64 or
/// arm64, else X86_64 (also without clang: emit-llvm then emits x86-64 IR).
pub fn target_arch() -> u32 uses io, fs, net {
    let mut cc = s("clang")
    match env.get(s("EIDER_LLVM_CC")) {
        Some(x) => { if x.len() > 0 { cc = x } }
        None => {}
    }
    let mut v: List[List[u8]] = List.new()
    v.push(cc)
    v.push(s("-dumpmachine"))
    match proc.run_with(v, proc.captured()) {
        Ok(o) => {
            if bytes.starts_with(o.out, s("aarch64")) || bytes.starts_with(o.out, s("arm64")) { return 1 }
        }
        Err(_) => {}
    }
    0
}

/// clang's argv for the IR (without the output and input files).
fn llvm_argv(lcc: List[u8], release: bool, debug: bool, pic: bool, lto: bool) -> List[List[u8]] uses io {
    let mut argv: List[List[u8]] = List.new()
    argv.push(lcc)
    argv.push(s("-c"))
    if release { argv.push(s("-O2")) } else { argv.push(s("-O0")) }
    if debug { argv.push(s("-g")) }
    if pic { argv.push(s("-fPIC")) }
    if lto { argv.push(s("-flto")) }
    match env.get(s("EIDER_CFLAGS")) {
        Some(f) => {
            for x in bytes.split(f, 32) {
                if bytes.starts_with(x, s("-fsanitize")) || bytes.starts_with(x, s("-fno-sanitize")) || bytes.eq(x, s("-g")) || bytes.starts_with(x, s("-O")) { argv.push(x) }
            }
        }
        None => {}
    }
    argv.push(s("-Wno-override-module"))
    argv
}

fn ll_object(ll: List[u8], dir: List[u8], release: bool, debug: bool, pic: bool, lto: bool) -> List[u8] uses io, fs, net {
    let llfile = fs.join(dir, s("prog.ll"))
    write_or_fail(llfile, ll)
    let obj = fs.join(dir, s("prog_ll.o"))
    let mut argv = llvm_argv(llvm_cc(17), release, debug, pic, lto)
    argv.push(s("-o"))
    argv.push(obj)
    argv.push(llfile)
    let code = match proc.run(argv) {
        Ok(n) => n
        Err(_) => 3
    }
    if code != 0 {
        let mut m = s("internal error: generated LLVM IR failed to compile (kept at ")
        bytes.append(inout m, llfile)
        m.push(41)
        fail(m, 3)
    }
    obj
}

/// Whether EIDER_CFLAGS's last -O flag is -O0 (a release build made unoptimized: no LTO).
fn unoptimized() -> bool uses io {
    let mut o0 = false
    match env.get(s("EIDER_CFLAGS")) {
        Some(f) => {
            for x in bytes.split(f, 32) {
                if bytes.starts_with(x, s("-O")) { o0 = bytes.eq(x, s("-O0")) }
            }
        }
        None => {}
    }
    o0
}

/// Whether the LLVM module is split into units (llvm_units.ei): unless EIDER_LLVM_UNITS is
/// `0` or `off` (the whole module as one unit, as before C8.27; for comparison).
pub fn llvm_units_on() -> bool uses io {
    match env.get(s("EIDER_LLVM_UNITS")) {
        Some(x) => !(bytes.eq(x, s("0")) || bytes.eq(x, s("off")))
        None => true
    }
}

/// Whether clang `cc` links a ThinLTO probe with lld (EIDER_LLVM_LTO=0: no LTO).
fn thin_lto(cc: List[u8], dir: List[u8]) -> bool uses io, fs, net {
    match env.get(s("EIDER_LLVM_LTO")) {
        Some(x) => { if bytes.eq(x, s("0")) || bytes.eq(x, s("off")) { return false } }
        None => {}
    }
    let src = fs.join(dir, s("lto_probe.c"))
    write_or_fail(src, s("int main(void) { return 0; }\n"))
    let mut argv: List[List[u8]] = List.new()
    argv.push(cc.copy())
    argv.push(s("-flto=thin"))
    argv.push(s("-fuse-ld=lld"))
    argv.push(s("-o"))
    argv.push(fs.join(dir, s("lto_probe")))
    argv.push(src)
    match proc.run_with(argv, proc.captured()) {
        Ok(o) => o.code == 0
        Err(_) => false
    }
}

/// Build the LLVM units `lls` (names `lnames`; llvm_units.split, or the whole module as one)
/// into a program (build.ei; docs/compiler.md "C8.27: incremental builds"), returning its path
/// (in the cache, else `exe`; "" with `quiet` on a failure, which is otherwise exit 3). Units:
/// every LLVM unit compiled by clang, the C core's two sources (native, by $CC; with
/// -DEI_RT_PROFILE for a `--profile` build, `prof`). A release build uses ThinLTO when clang
/// links with lld (thin_lto): the LLVM units are compiled to bitcode with `-flto=thin`, and
/// clang links everything with lld, `--thinlto-jobs` the job count and lld's own cache in
/// <cache>/lto (pruned by lld: a quarter of EIDER_CACHE_MAX, a week). Otherwise, and at -O0
/// (also when EIDER_CFLAGS ends with -O0), native objects linked by $CC.
fn compile_llvm(lnames: List[List[u8]], lls: List[List[u8]], dir: List[u8], exe: List[u8], release: bool, libs: List[List[u8]], debug: bool, prof: bool, jobs: u64, quiet: bool) -> List[u8] uses io, fs, net, clock {
    let core = fs.join(root(), s("core"))
    let mut cc = cc_argv(core, release)
    if debug { cc.push(s("-g")) }
    if prof { cc.push(s("-DEI_RT_PROFILE")) }
    let cache = cache_dir()
    let lcc = llvm_cc(17)
    let lto = release && !unoptimized() && thin_lto(lcc, dir)
    let ltool = tool_of(lcc_argv(lcc))
    let mut la: List[List[u8]] = List.new()
    la.push(lcc.copy())
    if release { la.push(s("-O2")) } else { la.push(s("-O0")) }
    if debug { la.push(s("-g")) }
    if lto { la.push(s("-flto=thin")) }
    match env.get(s("EIDER_CFLAGS")) {
        Some(f) => {
            for x in bytes.split(f, 32) {
                if bytes.starts_with(x, s("-fsanitize")) || bytes.starts_with(x, s("-fno-sanitize")) || bytes.eq(x, s("-g")) || bytes.starts_with(x, s("-O")) { la.push(x) }
            }
        }
        None => {}
    }
    la.push(s("-Wno-override-module"))
    let mut units: List[build.Unit] = List.new()
    let none: List[List[u8]] = List.new()
    for i in 0..lls.len() {
        units.push(build.Unit(lnames[i], s(".ll"), lls[i], List.new(), la, ltool, none))
    }
    let ctool = tool_of(cc)
    for u in core_units(cc, core, ctool) { units.push(u) }
    let mut post: List[List[u8]] = List.new()
    add_libs(inout post, libs)
    let mut nokey: List[List[u8]] = List.new()
    if lto {
        let mut ld: List[List[u8]] = List.new()
        ld.push(lcc.copy())
        for i in 1..cc.len() { ld.push(cc[i].copy()) }
        ld.push(s("-flto=thin"))
        ld.push(s("-fuse-ld=lld"))
        let mut j = s("-Wl,--thinlto-jobs=")
        let mut n = jobs_or_default(jobs)
        if n == 0 { n = build.cpus() }
        bytes.append(inout j, bytes.from_u64(n))
        nokey.push(j)
        if cache.len() > 0 {
            let mut d = s("-Wl,--thinlto-cache-dir=")
            bytes.append(inout d, fs.join(cache, s("lto")))
            nokey.push(d)
            let mut pol = s("-Wl,--thinlto-cache-policy=prune_interval=15m:prune_after=168h")
            match build.max_size() {
                Some(m) => {
                    if m > 0 {
                        bytes.append(inout pol, s(":cache_size_bytes="))
                        bytes.append(inout pol, bytes.from_u64(m / 4))
                    }
                }
                None => {}
            }
            nokey.push(pol)
        }
        return build_units(units, lls.len(), ld, nokey, post, ltool, dir, exe, jobs, quiet)
    }
    build_units(units, lls.len(), cc, nokey, post, ctool, dir, exe, jobs, quiet)
}

/// A compiled program: `path` is the executable (in the cache, or in `dir`); `dir` is the
/// work directory, removed by `discard`.
pub type Exe = { path: List[u8], dir: List[u8] }

/// Build the IR `ll` (from source `file`) into a program for the caller to run, at -O0; None
/// (and the work directory removed) when it doesn't build, the tools' output discarded
/// (comptime evaluators).
pub fn try_executable(ll: List[u8], file: List[u8]) -> Option[Exe] uses io, fs, net, clock {
    let dir = work_dir()
    let mut names: List[List[u8]] = List.new()
    names.push(s("prog"))
    let mut lls: List[List[u8]] = List.new()
    lls.push(ll)
    let path = compile_llvm(names, lls, dir, fs.join(dir, stem(file)), false, List.new(), false, false, 0, true)
    if path.len() == 0 {
        fs.remove_all(dir)
        return None
    }
    Some(Exe(path, dir))
}

pub fn discard(e: Exe) uses fs { fs.remove_all(e.dir) }

fn lcc_argv(lcc: List[u8]) -> List[List[u8]] {
    let mut a: List[List[u8]] = List.new()
    a.push(lcc)
    a
}

/// `eiderc build`: an -O2 executable at `out` (default: the source file's stem).
pub fn build_llvm(lnames: List[List[u8]], lls: List[List[u8]], file: List[u8], out: List[u8], libs: List[List[u8]], debug: bool, prof: bool, jobs: u64) uses io, fs, net, clock {
    let mut dest = out.copy()
    if dest.len() == 0 { dest = stem(file) }
    let dir = work_dir()
    if cache_dir().len() == 0 {
        compile_llvm(lnames, lls, dir, dest, true, libs, debug, prof, jobs, false)
    } else {
        let path = compile_llvm(lnames, lls, dir, fs.join(dir, stem(file)), true, libs, debug, prof, jobs, false)
        // a new file rather than a rewrite of the old one, which may be running
        fs.remove_all(dest)
        let mut cp: List[List[u8]] = List.new()
        cp.push(s("cp"))
        cp.push(path)
        cp.push(dest)
        tool(cp, "cannot copy the program out of the cache")
    }
    fs.remove_all(dir)
}

/// `eiderc run|test`: build (or take from the cache), run, exit with the program's exit code
/// (a program killed by signal n exits 128 + n). `args` are the program's arguments (`eiderc
/// run x.ei [--] args...`; none for `test`).
pub fn run_llvm(lnames: List[List[u8]], lls: List[List[u8]], file: List[u8], release: bool, libs: List[List[u8]], debug: bool, prof: bool, args: List[List[u8]], jobs: u64) uses io, fs, net, clock {
    let dir = work_dir()
    let exe = compile_llvm(lnames, lls, dir, fs.join(dir, stem(file)), release, libs, debug, prof, jobs, false)
    let mut argv: List[List[u8]] = List.new()
    argv.push(exe)
    for x in args { argv.push(x) }
    let code = match proc.run(argv) {
        Ok(n) => n
        Err(_) => {
            fs.remove_all(dir)
            fail(s("cannot run the compiled program"), 3)
            3
        }
    }
    fs.remove_all(dir)
    env.exit(code)
}

/// `eiderc build --lib`: the library's IR compiled with -O2 -fPIC, with the C core.
pub fn build_lib_llvm(ll: List[u8], h: List[u8], file: List[u8], out: List[u8], libs: List[List[u8]], debug: bool) uses io, fs, net, clock {
    let dir = work_dir()
    let obj = ll_object(ll, dir, true, debug, true, false)
    let mut extra: List[List[u8]] = List.new()
    extra.push(obj)
    build_lib_with(h, file, out, libs, extra, dir, 0)
}

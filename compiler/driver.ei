// driver: `emit-c`, `build`, `build --lib`, `run` and `test` (docs/compiler.md, "C4:
// lowering", "C7: FFI" and "C7: driver").
//
// The C is compiled together with the C core (core/eider_rt.c, the language runtime, and
// core/eider_core.c, the OS ABI that std sits on) by $CC (default cc):
//
//   cc -std=c11 -pedantic -Wall -Wextra -Wno-unused-* -O0|-O2 -pthread $EIDER_CFLAGS
//      -I <root>/core -o <exe> <prog>.c <core objects or sources> -l<lib>..
//
// `run` and `test` use -O0 (fast C compiles), `build` and `run --release` -O2.
// EIDER_CFLAGS (split at spaces) adds flags, e.g. `-Werror` or a sanitizer. `-l <lib>`
// options link C libraries (for `extern "c"` functions outside the core).
//
// Cache ($EIDER_CACHE: `off`, or a directory; default $XDG_CACHE_HOME/eider, else
// $HOME/.cache/eider). Keys are SHA-256 (sha256.ei) over length-prefixed parts:
//
//   core/<key>/eider_rt.o, eider_core.o   the C core compiled once per toolchain: key over
//       the cc argv (cc, every flag, EIDER_CFLAGS, -I path), `$CC --version`, LIBRARY_PATH,
//       CPATH, C_INCLUDE_PATH, and the bytes of eider_rt.h, eider_rt.c and eider_core.c
//   bin/<key>                              an executable: key over the same toolchain parts,
//       the core objects (their paths, which hold the core key), the -l libraries and the
//       generated C (which holds the trap file name)
//   tmp/eiderc-<ms>-<n>/                   one work directory per compile
//
// Every install is atomic: files are made in the process's own work directory (mkdir is
// exclusive, so two processes never share one) and renamed into place, so a concurrent
// eiderc sees either nothing or a complete entry; two processes building the same entry
// both succeed and one rename wins. Not part of any key: the contents of `-l` libraries and
// of system headers beyond what `--version` identifies. With the cache off the core sources
// are compiled into every program and the work directory is under <root>/target/tmp/ (else
// $TMPDIR, else /tmp).
//
// `build --lib` compiles the generated C with -O2 -fPIC to an object, takes the core objects
// for the same flags, and makes lib<name>.a (ar rcs) and lib<name>.so (cc -shared, with the
// -l libraries) from them, plus <name>.h (lower.header); <name> is `-o`'s file name, else the
// source's stem, and the files go next to `-o`'s path (else in the working directory), as
// tests/oracle expects. The library is self-contained: it carries the runtime and the core.
//
// Reusable entry points (comptime evaluation builds and runs C through them): `executable`
// returns a built program (cached or in a work directory) and `discard` removes its work
// directory; `build`, `build_lib` and `run` are the commands.
//
// The toolchain root (the directory holding core/) is toolchain.find's (toolchain.ei, shared
// with resolve): $EIDER_ROOT if set; otherwise the nearest directory above the eiderc binary
// (argv[0], symlinks resolved) that contains core/eider_rt.h, so target/eiderc in a checkout
// finds the checkout; otherwise the same search from the working directory.

import "core/sys"
import "std/bytes"
import "std/fs"
import "std/io"
import "std/env"
import "std/proc"
import "sha256.ei"
import "toolchain.ei"

fn s(x: str) -> List[u8] { sys.lit(x) }

pub fn fail(msg: List[u8], code: i32) uses io {
    let mut m = s("eiderc: ")
    bytes.append(inout m, msg)
    io.errln(m)
    env.exit(code)
}

/// The toolchain root (see the top of this file).
pub fn root() -> List[u8] uses io, fs {
    let r = find_root()
    if r.len() == 0 { fail(s("cannot find the toolchain (a directory with core/eider_rt.h); set EIDER_ROOT"), 2) }
    r
}

/// `root`, or "" when there is none (instead of exiting): toolchain.find, the lookup resolve
/// uses for the prelude and std too.
pub fn find_root() -> List[u8] uses io, fs { toolchain.find() }

/// A new work directory of our own (`work_dir`: under the cache or target/, never shared
/// with another process); the caller removes it.
pub fn temp_dir() -> List[u8] uses io, fs, clock { work_dir() }

/// The file name of `path` without directories and without its extension.
pub fn stem(path: List[u8]) -> List[u8] {
    let mut start: usize = 0
    match bytes.rfind_byte(path, 47) {
        Some(i) => { start = i + 1 }
        None => {}
    }
    let mut end = path.len()
    match bytes.rfind_byte(path, 46) {
        Some(i) => { if i > start { end = i } }
        None => {}
    }
    bytes.slice(path, start, end)
}

fn extra_flags(inout argv: List[List[u8]]) uses io {
    match env.get(s("EIDER_CFLAGS")) {
        Some(f) => {
            for x in bytes.split(f, 32) {
                if x.len() > 0 { argv.push(x) }
            }
        }
        None => {}
    }
}

pub fn write_or_fail(path: List[u8], data: List[u8]) uses io, fs {
    match fs.write(path, data) {
        Ok(_) => {}
        Err(_) => {
            let mut m = s("cannot write ")
            bytes.append(inout m, path)
            fail(m, 3)
        }
    }
}

/// The toolchain's version: the first line of <root>/VERSION ("" when there is none). A
/// profile records it (docs/runtime.md "Profile format").
pub fn version() -> List[u8] uses io, fs {
    let r = find_root()
    if r.len() == 0 { return List.new() }
    match fs.read(fs.join(r, s("VERSION"))) {
        Ok(t) => {
            let mut v: List[u8] = List.new()
            for b in t {
                if b == 10 || b == 13 { break }
                if b >= 32 && b < 127 && b != 34 && b != 92 { v.push(b) }
            }
            v
        }
        Err(_) => List.new()
    }
}

/// `argv` for the C of a program built with `--profile` (it starts with `#define
/// EI_RT_PROFILE`): plus -DEI_RT_PROFILE, so the core is compiled with the profiler
/// (core/eider_prof.c) and cached apart. Any other C keeps `argv`.
fn profiled(argv: List[List[u8]], c: List[u8]) -> List[List[u8]] {
    if !bytes.starts_with(c, s("#define EI_RT_PROFILE 1\n")) { return argv }
    let mut a = argv.copy()
    a.push(s("-DEI_RT_PROFILE"))
    a
}

/// The C compiler and the flags every compile uses (core = <root>/core).
pub fn cc_argv(core: List[u8], release: bool) -> List[List[u8]] uses io {
    let mut cc = s("cc")
    match env.get(s("CC")) {
        Some(x) => { if x.len() > 0 { cc = x } }
        None => {}
    }
    let mut argv: List[List[u8]] = List.new()
    argv.push(cc)
    argv.push(s("-std=c11"))
    argv.push(s("-pedantic"))
    argv.push(s("-Wall"))
    argv.push(s("-Wextra"))
    argv.push(s("-Wno-unused-function"))
    argv.push(s("-Wno-unused-variable"))
    argv.push(s("-Wno-unused-but-set-variable"))
    argv.push(s("-Wno-unused-parameter"))
    if release { argv.push(s("-O2")) } else { argv.push(s("-O0")) }
    argv.push(s("-pthread"))
    extra_flags(inout argv)
    argv.push(s("-I"))
    argv.push(core)
    argv
}

fn add_libs(inout argv: List[List[u8]], libs: List[List[u8]]) {
    for l in libs {
        let mut a = s("-l")
        bytes.append(inout a, l)
        argv.push(a)
    }
}

/// Run a toolchain command; exit 3 when it can't be started or fails (`what` names it).
fn tool(argv: List[List[u8]], what: str) uses io, fs, net {
    let code = match proc.run(argv) {
        Ok(n) => n
        Err(_) => {
            let mut m = s("cannot run `")
            bytes.append(inout m, argv[0])
            bytes.append(inout m, s("`"))
            fail(m, 3)
            3
        }
    }
    if code != 0 { fail(s(what), 3) }
}

// ------------------------------------------------------------------ cache and work dirs

/// The cache directory (see the top of this file), or "" when the cache is off.
pub fn cache_dir() -> List[u8] uses io {
    match env.get(s("EIDER_CACHE")) {
        Some(d) => {
            if bytes.eq(d, s("off")) { return List.new() }
            if d.len() > 0 { return d }
        }
        None => {}
    }
    match env.get(s("XDG_CACHE_HOME")) {
        Some(x) => { if x.len() > 0 { return fs.join(x, s("eider")) } }
        None => {}
    }
    match env.get(s("HOME")) {
        Some(h) => { if h.len() > 0 { return fs.join(h, s(".cache/eider")) } }
        None => {}
    }
    List.new()
}

/// Lowercase hex SHA-256 of `parts`, each prefixed with its length so no two lists of parts
/// hash the same bytes.
pub fn key(parts: List[List[u8]]) -> List[u8] {
    let mut m: List[u8] = List.new()
    for p in parts {
        bytes.append(inout m, bytes.from_u64(p.len() as u64))
        m.push(58)
        bytes.append(inout m, p)
    }
    bytes.hex(sha256.digest(sha256.new(), m))
}

/// A new, empty directory of our own under `base` ("" if it can't be made).
fn fresh_dir(base: List[u8]) -> List[u8] uses fs, clock {
    match fs.mkdir_all(base) {
        Ok(_) => {}
        Err(_) => { return List.new() }
    }
    let stamp = now_ms()
    for k in 0..10000 {
        let mut name = s("eiderc-")
        bytes.append(inout name, bytes.from_u64(stamp))
        name.push(45)
        bytes.append(inout name, bytes.from_u64(k as u64))
        let d = fs.join(base, name)
        // mkdir fails if the directory exists, so a success means it is ours
        sys.send(d)
        if sys.mkdir() == 0 { return d }
        if !fs.is_dir(base) { return List.new() }
    }
    List.new()
}

/// The work directory for one compile: under <cache>/tmp/, else <root>/target/tmp/, else
/// $TMPDIR (or /tmp), whichever is writable first.
fn work_dir() -> List[u8] uses io, fs, clock {
    // without a toolchain, exit 2 for that first (as before try_work_dir existed)
    root()
    let d = try_work_dir()
    if d.len() == 0 { fail(s("cannot create a work directory"), 3) }
    d
}

/// `work_dir`, or "" when none can be made (instead of exiting).
pub fn try_work_dir() -> List[u8] uses io, fs, clock {
    let mut bases: List[List[u8]] = List.new()
    let cache = cache_dir()
    if cache.len() > 0 { bases.push(fs.join(cache, s("tmp"))) }
    let r = find_root()
    if r.len() > 0 { bases.push(fs.join(r, s("target/tmp"))) }
    let mut t = s("/tmp")
    match env.get(s("TMPDIR")) {
        Some(x) => { if x.len() > 0 { t = x } }
        None => {}
    }
    bases.push(t)
    for b in bases {
        let d = fresh_dir(b)
        if d.len() > 0 { return d }
    }
    List.new()
}

/// What identifies the C toolchain for the cache: the cc argv, `<cc> --version`, and the
/// environment variables that change what cc finds.
fn toolchain_id(argv: List[List[u8]]) -> List[List[u8]] uses io, fs, net {
    let mut id: List[List[u8]] = List.new()
    id.push(s("eiderc cache 1"))
    id.push(bytes.from_u64(argv.len() as u64))
    for a in argv { id.push(a) }
    let mut v: List[List[u8]] = List.new()
    v.push(argv[0])
    v.push(s("--version"))
    let ver: List[u8] = match proc.run_with(v, proc.captured()) {
        Ok(o) => o.out
        Err(_) => List.new()
    }
    id.push(ver)
    for e in ["LIBRARY_PATH", "CPATH", "C_INCLUDE_PATH"] {
        match env.get(s(e)) {
            Some(x) => { id.push(x) }
            None => { id.push(List.new()) }
        }
    }
    id
}

fn read_or_fail(path: List[u8]) -> List[u8] uses io, fs {
    match fs.read(path) {
        Ok(t) => t
        Err(_) => {
            let mut m = s("cannot read ")
            bytes.append(inout m, path)
            fail(m, 3)
            List.new()
        }
    }
}

/// The C core for compiles with `argv` (cc and its flags): with the cache on, its two
/// objects from <cache>/core/ (compiled into `dir` and renamed into place first if missing;
/// `id` is toolchain_id(argv)), else its two sources. `quiet`: a failure returns no inputs
/// instead of being reported (and exiting).
fn core_inputs(argv: List[List[u8]], id: List[List[u8]], core: List[u8], cache: List[u8], dir: List[u8], quiet: bool) -> List[List[u8]] uses io, fs, net {
    let mut srcs: List[List[u8]] = List.new()
    srcs.push(fs.join(core, s("eider_rt.c")))
    srcs.push(fs.join(core, s("eider_core.c")))
    if cache.len() == 0 { return srcs }
    let mut parts = id.copy()
    parts.push(s("core objects"))
    parts.push(read_or_fail(fs.join(core, s("eider_rt.h"))))
    for f in srcs { parts.push(read_or_fail(f)) }
    // the profiling runtime is part of eider_rt.c when it is compiled in
    for a in argv {
        if bytes.eq(a, s("-DEI_RT_PROFILE")) { parts.push(read_or_fail(fs.join(core, s("eider_prof.c")))) }
    }
    let objdir = fs.join(fs.join(cache, s("core")), key(parts))
    let mut objs: List[List[u8]] = List.new()
    objs.push(fs.join(objdir, s("eider_rt.o")))
    objs.push(fs.join(objdir, s("eider_core.o")))
    // the directory is renamed into place whole, so it exists only when both objects do
    if fs.is_dir(objdir) { return objs }
    let tmp = fs.join(dir, s("core"))
    sys.send(tmp)
    if sys.mkdir() != 0 {
        if quiet { return List.new() }
        fail(s("cannot create a work directory"), 3)
    }
    let mut made: List[List[u8]] = List.new()
    made.push(fs.join(tmp, s("eider_rt.o")))
    made.push(fs.join(tmp, s("eider_core.o")))
    for i in 0..2 {
        let mut a = argv.copy()
        a.push(s("-c"))
        a.push(s("-o"))
        a.push(made[i as usize])
        a.push(srcs[i as usize])
        if quiet {
            if !quiet_ok(a) { return List.new() }
        } else {
            tool(a, "compiling the C core failed")
        }
    }
    match fs.mkdir_all(fs.join(cache, s("core"))) {
        Ok(_) => {}
        Err(_) => { return made }
    }
    match fs.rename(tmp, objdir) {
        Ok(_) => {}
        Err(_) => {
            // another eiderc installed the same objects first (a rename onto a non-empty
            // directory fails), or the cache is not writable
            if !fs.is_dir(objdir) { return made }
        }
    }
    objs
}

/// Run a command with its output captured; whether it succeeded.
fn quiet_ok(argv: List[List[u8]]) -> bool uses io, fs, net {
    match proc.run_with(argv, proc.captured()) {
        Ok(o) => o.code == 0
        Err(_) => false
    }
}

/// Run the C compiler on the generated C `cfile` with inherited stdio; exit 3 if it can't
/// start or fails (the C is kept).
fn cc_or_fail(argv: List[List[u8]], cfile: List[u8]) uses io, fs, net {
    let code = match proc.run(argv) {
        Ok(n) => n
        Err(_) => {
            let mut m = s("cannot run the C compiler `")
            bytes.append(inout m, argv[0])
            bytes.append(inout m, s("` (set $CC)"))
            fail(m, 3)
            3
        }
    }
    if code != 0 {
        let mut m = s("internal error: generated C failed to compile (kept at ")
        bytes.append(inout m, cfile)
        m.push(41)
        fail(m, 3)
    }
}

/// A compiled program: `path` is the executable (in the cache, or in `dir`); `dir` is the
/// work directory, removed by `discard`.
pub type Exe = { path: List[u8], dir: List[u8] }

/// Compile C text `c` into an executable at `exe`; with the cache on, into the cache (`exe`
/// is then only the scratch name, and nothing is compiled when the binary is cached).
/// Returns the executable's path. The C file goes to `dir`; on failure the C is kept and
/// the process exits with 3 (the recorded exit code), or with `quiet` the C compiler's output is
/// captured and "" returned.
fn compile(c: List[u8], dir: List[u8], exe: List[u8], release: bool, libs: List[List[u8]], quiet: bool) -> List[u8] uses io, fs, net {
    let core = fs.join(root(), s("core"))
    let cc = profiled(cc_argv(core, release), c)
    let cache = cache_dir()
    let mut id: List[List[u8]] = List.new()
    if cache.len() > 0 { id = toolchain_id(cc) }
    let inputs = core_inputs(cc, id, core, cache, dir, quiet)
    if inputs.len() == 0 { return List.new() }
    let mut bin: List[u8] = List.new()
    if cache.len() > 0 {
        let mut parts = id.copy()
        parts.push(s("executable"))
        parts.push(bytes.from_u64(inputs.len() as u64))
        for x in inputs { parts.push(x) }
        parts.push(bytes.from_u64(libs.len() as u64))
        for l in libs { parts.push(l) }
        parts.push(c)
        bin = fs.join(fs.join(cache, s("bin")), key(parts))
        if fs.exists(bin) { return bin }
    }
    let cfile = fs.join(dir, s("prog.c"))
    if quiet {
        match fs.write(cfile, c) {
            Ok(_) => {}
            Err(_) => { return List.new() }
        }
    } else {
        write_or_fail(cfile, c)
    }
    let mut argv = cc.copy()
    argv.push(s("-o"))
    argv.push(exe)
    argv.push(cfile)
    for x in inputs { argv.push(x) }
    add_libs(inout argv, libs)
    if quiet {
        if !quiet_ok(argv) { return List.new() }
    } else {
        cc_or_fail(argv, cfile)
    }
    fs.remove_all(cfile)
    if bin.len() > 0 {
        match fs.mkdir_all(fs.join(cache, s("bin"))) {
            Ok(_) => {
                // atomic: a concurrent eiderc finds no binary or a complete one
                match fs.rename(exe, bin) {
                    Ok(_) => { return bin }
                    Err(_) => {}
                }
            }
            Err(_) => {}
        }
    }
    exe
}

/// Build C text `c` (from source `file`) into a program for the caller to run; `release`
/// picks -O2. Remove its work directory with `discard` when done.
pub fn executable(c: List[u8], file: List[u8], release: bool, libs: List[List[u8]]) -> Exe uses io, fs, net, clock {
    let dir = work_dir()
    let path = compile(c, dir, fs.join(dir, stem(file)), release, libs, false)
    Exe(path, dir)
}

/// `executable` for C that may not compile (comptime evaluators): the C compiler's output is
/// captured, and on any failure the work directory is removed and the result is None.
pub fn try_executable(c: List[u8], file: List[u8], release: bool, libs: List[List[u8]]) -> Option[Exe] uses io, fs, net, clock {
    let dir = work_dir()
    let path = compile(c, dir, fs.join(dir, stem(file)), release, libs, true)
    if path.len() == 0 {
        fs.remove_all(dir)
        return None
    }
    Some(Exe(path, dir))
}

pub fn discard(e: Exe) uses fs { fs.remove_all(e.dir) }

/// `eiderc build`: an -O2 executable at `out` (default: the source file's stem).
pub fn build(c: List[u8], file: List[u8], out: List[u8], libs: List[List[u8]]) uses io, fs, net, clock {
    let mut dest = out.copy()
    if dest.len() == 0 { dest = stem(file) }
    let dir = work_dir()
    if cache_dir().len() == 0 {
        compile(c, dir, dest, true, libs, false)
    } else {
        let path = compile(c, dir, fs.join(dir, stem(file)), true, libs, false)
        // a new file rather than a rewrite of the old one, which may be running
        fs.remove_all(dest)
        let mut cp: List[List[u8]] = List.new()
        cp.push(s("cp"))
        cp.push(path)
        cp.push(dest)
        tool(cp, "cannot copy the program out of the cache")
    }
    fs.remove_all(dir)
}

/// `eiderc build --lib`: lib<name>.a, lib<name>.so and <name>.h (see the top of this file)
/// from the library C `c` and its header `h`.
/// The name of the library `build --lib` makes from `file` with `-o out` (lib<name>.a,
/// <name>.h): out's file name, else the source's stem. The header's include guard is
/// derived from it (lower.header).
pub fn lib_name(file: List[u8], out: List[u8]) -> List[u8] {
    let mut base = out.copy()
    if base.len() == 0 { base = stem(file) }
    match bytes.rfind_byte(base, 47) {
        Some(i) => bytes.slice(base, i + 1, base.len())
        None => base
    }
}

pub fn build_lib(c: List[u8], h: List[u8], file: List[u8], out: List[u8], libs: List[List[u8]]) uses io, fs, net, clock {
    let dir = work_dir()
    build_lib_with(c, h, file, out, libs, List.new(), dir)
}

/// build_lib with more objects in the library (`extra`), in work directory `dir`.
fn build_lib_with(c: List[u8], h: List[u8], file: List[u8], out: List[u8], libs: List[List[u8]], extra: List[List[u8]], dir: List[u8]) uses io, fs, net, clock {
    let mut base = out.copy()
    if base.len() == 0 { base = stem(file) }
    let mut name = base.copy()
    let mut odir: List[u8] = List.new()
    match bytes.rfind_byte(base, 47) {
        Some(i) => {
            name = bytes.slice(base, i + 1, base.len())
            odir = bytes.slice(base, 0, i + 1)
        }
        None => {}
    }
    let mut hfile = base.copy()
    bytes.append(inout hfile, s(".h"))
    let mut afile = odir.copy()
    bytes.append(inout afile, s("lib"))
    bytes.append(inout afile, name)
    let mut sofile = afile.copy()
    bytes.append(inout afile, s(".a"))
    bytes.append(inout sofile, s(".so"))
    let core = fs.join(root(), s("core"))
    let mut cc = cc_argv(core, true)
    cc.push(s("-fPIC"))
    let cache = cache_dir()
    let mut id: List[List[u8]] = List.new()
    if cache.len() > 0 { id = toolchain_id(cc) }
    let cfile = fs.join(dir, s("lib.c"))
    write_or_fail(cfile, c)
    let mut srcs: List[List[u8]] = List.new()
    srcs.push(cfile)
    for x in core_inputs(cc, id, core, cache, dir, false) { srcs.push(x) }
    for x in extra { srcs.push(x) }
    let mut objs: List[List[u8]] = List.new()
    for i in 0..srcs.len() {
        if bytes.ends_with(srcs[i], s(".o")) {
            objs.push(srcs[i])
            continue
        }
        let mut o = fs.join(dir, s("o"))
        bytes.append(inout o, bytes.from_u64(i as u64))
        bytes.append(inout o, s(".o"))
        let mut argv = cc.copy()
        argv.push(s("-c"))
        argv.push(s("-o"))
        argv.push(o)
        argv.push(srcs[i])
        let what = if i == 0 { "internal error: generated C failed to compile" } else { "compiling the C core failed" }
        tool(argv, what)
        objs.push(o)
    }
    fs.remove_all(afile)
    let mut ar: List[List[u8]] = List.new()
    ar.push(s("ar"))
    ar.push(s("rcs"))
    ar.push(afile)
    for o in objs { ar.push(o) }
    tool(ar, "`ar` failed")
    let mut so: List[List[u8]] = List.new()
    so.push(cc[0])
    so.push(s("-shared"))
    so.push(s("-pthread"))
    so.push(s("-o"))
    so.push(sofile)
    for o in objs { so.push(o) }
    add_libs(inout so, libs)
    tool(so, "linking the shared library failed")
    write_or_fail(hfile, h)
    fs.remove_all(dir)
    let mut m = s("built ")
    bytes.append(inout m, afile)
    bytes.append(inout m, s(", "))
    bytes.append(inout m, sofile)
    bytes.append(inout m, s(", "))
    bytes.append(inout m, hfile)
    io.outln(m)
}

/// `eiderc run` / `eiderc test`: build (or take from the cache), run, exit with the
/// program's exit code (a program killed by signal n exits 128 + n). `args` are the
/// program's arguments (`eiderc run x.ei [--] args...`; none for `test`).
pub fn run(c: List[u8], file: List[u8], release: bool, libs: List[List[u8]], args: List[List[u8]]) uses io, fs, net, clock {
    let e = executable(c, file, release, libs)
    let mut argv: List[List[u8]] = List.new()
    argv.push(e.path)
    for x in args { argv.push(x) }
    let code = match proc.run(argv) {
        Ok(n) => n
        Err(_) => {
            discard(e)
            fail(s("cannot run the compiled program"), 3)
            3
        }
    }
    discard(e)
    env.exit(code)
}

// ------------------------------------------------------------------ --backend=llvm
//
// The LLVM backend's two halves (llvm.ei; docs/compiler.md, "Backends"): the LLVM IR is
// compiled by clang ($EIDER_LLVM_CC, default clang; LLVM 17 or newer, checked first) to an
// object with -O0/-O2 (and -g), then linked with the C half by $CC exactly as `compile` does
// (no binary cache: the core objects are still cached). Of EIDER_CFLAGS, clang gets the
// -fsanitize*/-fno-sanitize* flags (instrumentation of the IR half), -g and -O<n> (after the
// driver's own, so `EIDER_CFLAGS=-O0 eiderc build` is -O0 in both halves).

/// clang for the LLVM half; exits 3 when it can't run or is older than LLVM `min`.
pub fn llvm_cc(min: u64) -> List[u8] uses io, fs, net {
    let mut cc = s("clang")
    match env.get(s("EIDER_LLVM_CC")) {
        Some(x) => { if x.len() > 0 { cc = x } }
        None => {}
    }
    let mut v: List[List[u8]] = List.new()
    v.push(cc)
    v.push(s("--version"))
    let out: List[u8] = match proc.run_with(v, proc.captured()) {
        Ok(o) => o.out
        Err(_) => {
            let mut m = s("--backend=llvm needs clang (LLVM ")
            bytes.append(inout m, bytes.from_u64(min))
            bytes.append(inout m, s(" or newer); cannot run `"))
            bytes.append(inout m, cc)
            bytes.append(inout m, s("` (set EIDER_LLVM_CC)"))
            fail(m, 3)
            List.new()
        }
    }
    let mut major: u64 = 0
    match bytes.find(out, s("version "), 0) {
        Some(i) => {
            let mut j = i + 8
            while j < out.len() && bytes.is_digit(out[j]) {
                major = major * 10 + (out[j] - 48) as u64
                j += 1
            }
        }
        None => {}
    }
    if major < min {
        let mut m = s("--backend=llvm needs clang (LLVM ")
        bytes.append(inout m, bytes.from_u64(min))
        bytes.append(inout m, s(" or newer), but `"))
        bytes.append(inout m, cc)
        bytes.append(inout m, s("` is LLVM "))
        bytes.append(inout m, bytes.from_u64(major))
        fail(m, 3)
    }
    cc
}

fn ll_object(ll: List[u8], dir: List[u8], release: bool, debug: bool, pic: bool, lto: bool) -> List[u8] uses io, fs, net {
    let llfile = fs.join(dir, s("prog.ll"))
    write_or_fail(llfile, ll)
    let obj = fs.join(dir, s("prog_ll.o"))
    let mut argv: List[List[u8]] = List.new()
    argv.push(llvm_cc(17))
    argv.push(s("-c"))
    if release { argv.push(s("-O2")) } else { argv.push(s("-O0")) }
    if debug { argv.push(s("-g")) }
    if pic { argv.push(s("-fPIC")) }
    if lto { argv.push(s("-flto")) }
    match env.get(s("EIDER_CFLAGS")) {
        Some(f) => {
            for x in bytes.split(f, 32) {
                if bytes.starts_with(x, s("-fsanitize")) || bytes.starts_with(x, s("-fno-sanitize")) || bytes.eq(x, s("-g")) || bytes.starts_with(x, s("-O")) { argv.push(x) }
            }
        }
        None => {}
    }
    argv.push(s("-Wno-override-module"))
    argv.push(s("-o"))
    argv.push(obj)
    argv.push(llfile)
    let code = match proc.run(argv) {
        Ok(n) => n
        Err(_) => 3
    }
    if code != 0 {
        let mut m = s("internal error: generated LLVM IR failed to compile (kept at ")
        bytes.append(inout m, llfile)
        m.push(41)
        fail(m, 3)
    }
    obj
}

/// The linker for link-time optimization of a release build (`-fuse-ld=` value): lld, else
/// gold with LLVM's plugin, whichever links an `-flto` probe with clang `cc`; empty when
/// neither does or EIDER_LLVM_LTO=0, and the halves are then linked as plain objects.
fn lto_linker(cc: List[u8], dir: List[u8]) -> List[u8] uses io, fs, net {
    match env.get(s("EIDER_LLVM_LTO")) {
        Some(x) => { if bytes.eq(x, s("0")) || bytes.eq(x, s("off")) { return List.new() } }
        None => {}
    }
    let src = fs.join(dir, s("lto_probe.c"))
    write_or_fail(src, s("int main(void) { return 0; }\n"))
    let ld = ["lld", "gold"]
    for i in 0..2 {
        let mut argv: List[List[u8]] = List.new()
        argv.push(cc.copy())
        argv.push(s("-flto"))
        let mut u = s("-fuse-ld=")
        bytes.append(inout u, s(ld[i as usize]))
        argv.push(u)
        argv.push(s("-o"))
        argv.push(fs.join(dir, s("lto_probe")))
        argv.push(src.copy())
        if quiet_ok(argv) { return s(ld[i as usize]) }
    }
    List.new()
}

/// Build the two halves into `exe`. A release build links them with link-time optimization
/// when clang has a linker for it (lto_linker), so the C half's glue inlines into the IR:
/// both halves are compiled by clang to bitcode (`-flto`; the C half with `-w`: it is
/// generated code, checked under $CC by the C backend), the C core's objects stay native, and
/// clang links everything with `-fuse-ld=lld` (or gold). Otherwise, and for -O0, $CC compiles
/// the C half and links it with the IR's object.
fn compile_llvm(c: List[u8], ll: List[u8], dir: List[u8], exe: List[u8], release: bool, libs: List[List[u8]], debug: bool) uses io, fs, net {
    let core = fs.join(root(), s("core"))
    let mut cc = cc_argv(core, release)
    if debug { cc.push(s("-g")) }
    let cache = cache_dir()
    let mut id: List[List[u8]] = List.new()
    if cache.len() > 0 { id = toolchain_id(cc) }
    let inputs = core_inputs(cc, id, core, cache, dir, false)
    let mut ld: List[u8] = List.new()
    let mut lcc: List[u8] = List.new()
    if release {
        lcc = llvm_cc(17)
        ld = lto_linker(lcc, dir)
    }
    let lto = ld.len() > 0
    let obj = ll_object(ll, dir, release, debug, false, lto)
    let cfile = fs.join(dir, s("prog.c"))
    write_or_fail(cfile, c)
    if lto {
        let cobj = fs.join(dir, s("prog_c.o"))
        let mut ca: List[List[u8]] = List.new()
        ca.push(lcc.copy())
        for i in 1..cc.len() { ca.push(cc[i].copy()) }
        ca.push(s("-w"))
        ca.push(s("-flto"))
        ca.push(s("-c"))
        ca.push(s("-o"))
        ca.push(cobj.copy())
        ca.push(cfile.copy())
        cc_or_fail(ca, cfile)
        let mut la: List[List[u8]] = List.new()
        la.push(lcc.copy())
        for i in 1..cc.len() { la.push(cc[i].copy()) }
        la.push(s("-flto"))
        let mut u = s("-fuse-ld=")
        bytes.append(inout u, ld)
        la.push(u)
        la.push(s("-o"))
        la.push(exe)
        la.push(cobj)
        la.push(obj)
        for x in inputs { la.push(x) }
        add_libs(inout la, libs)
        cc_or_fail(la, cfile)
        return
    }
    let mut argv = cc.copy()
    argv.push(s("-o"))
    argv.push(exe)
    argv.push(cfile)
    argv.push(obj)
    for x in inputs { argv.push(x) }
    add_libs(inout argv, libs)
    cc_or_fail(argv, cfile)
}

/// `eiderc build --backend=llvm`.
pub fn build_llvm(c: List[u8], ll: List[u8], file: List[u8], out: List[u8], libs: List[List[u8]], debug: bool) uses io, fs, net, clock {
    let mut dest = out.copy()
    if dest.len() == 0 { dest = stem(file) }
    let dir = work_dir()
    compile_llvm(c, ll, dir, dest, true, libs, debug)
    fs.remove_all(dir)
}

/// `eiderc run|test --backend=llvm`: build in a work directory, run, exit with its code.
pub fn run_llvm(c: List[u8], ll: List[u8], file: List[u8], release: bool, libs: List[List[u8]], debug: bool, args: List[List[u8]]) uses io, fs, net, clock {
    let dir = work_dir()
    let exe = fs.join(dir, stem(file))
    compile_llvm(c, ll, dir, exe, release, libs, debug)
    let mut argv: List[List[u8]] = List.new()
    argv.push(exe)
    for x in args { argv.push(x) }
    let code = match proc.run(argv) {
        Ok(n) => n
        Err(_) => {
            fs.remove_all(dir)
            fail(s("cannot run the compiled program"), 3)
            3
        }
    }
    fs.remove_all(dir)
    env.exit(code)
}

/// `eiderc build --lib --backend=llvm`: build_lib with the LLVM half's object added.
pub fn build_lib_llvm(c: List[u8], ll: List[u8], h: List[u8], file: List[u8], out: List[u8], libs: List[List[u8]], debug: bool) uses io, fs, net, clock {
    let dir = work_dir()
    let obj = ll_object(ll, dir, true, debug, true, false)
    let mut extra: List[List[u8]] = List.new()
    extra.push(obj)
    build_lib_with(c, h, file, out, libs, extra, dir)
}

// Copy-on-write across threads (docs/compiler.md, "C8.1: copy-on-write"): buffer counts
// are not atomic, so every value is made unique before another thread can see it: spawn
// captures, Mutex.new/set/update/get, Chan.send and Task.join. Each thread here copies and
// changes values that started out shared with values on other threads; TSan (the sanitize
// pass) checks that no count is touched by two threads. Expected output: cow_threads.out.

fn join_all(l: List[String]) -> String {
    var s = String.from("")
    for x in l { s.append(x) }
    s
}

fn words(n: i32) -> List[String] {
    var l: List[String] = List.new()
    for i in 0..n { l.push(String.from_int(i as i64)) }
    l
}

/// Every thread captures a copy of one shared List of Strings and changes its copy.
fn captures(threads: i32) -> i64 uses threads {
    let base = words(50)
    var ts: List[Task[i64]] = List.new()
    for i in 0..threads {
        let mine = base
        let other = base
        ts.push(spawn(|| -> i64 {
            var l = mine
            for j in 0..100 {
                l.push(String.from("x"))
                l[0].push_str("y")
                let keep = other
                var k = keep
                k.pop()
            }
            return l.len() as i64 + l[0].len() as i64
        }))
    }
    var total: i64 = 0
    for t in ts { total += t.join() }
    total + base.len() as i64 + base[0].len() as i64
}

/// A Mutex holding a List of Strings: values put in share with the caller's, values taken
/// out are changed by the taker, and update closures return values shared with captures.
fn mutex(threads: i32) -> String uses threads {
    let seed = words(10)
    let m = Mutex.new(seed)
    var ts: List[Task[()]] = List.new()
    for i in 0..threads {
        let mm = m
        let extra = seed
        ts.push(spawn(|| -> () {
            for j in 0..50 {
                var got = mm.get()
                got[0].push_str("g")
                mm.update(|l: List[String]| -> List[String] {
                    var n = l
                    n.push(String.from("u"))
                    if n.len() > 40 { return extra }
                    return n
                })
                if j % 10 == 0 { mm.set(extra) }
            }
        }))
    }
    for t in ts { t.join() }
    var after = m.get()
    after.push(String.from("end"))
    var s = join_all(seed)
    s.push_str(" ")
    s.append(String.from_int(seed.len() as i64))
    s.push_str(" ")
    s.append(String.from_int(m.get()[0].len() as i64))
    s
}

/// Values sent through a channel share with values the sender keeps and changes.
fn channel(producers: i32) -> i64 uses threads {
    let c: Chan[List[String]] = Chan.new()
    let shared = words(20)
    var ts: List[Task[()]] = List.new()
    for i in 0..producers {
        let cc = c
        let src = shared
        ts.push(spawn(|| -> () {
            var mine = src
            for j in 0..100 {
                cc.send(mine)
                mine[0].push_str("s")
                mine.push(String.from("p"))
            }
        }))
    }
    let r = c
    let consumer = spawn(|| -> i64 {
        var n: i64 = 0
        var seen: List[List[String]] = List.new()
        var k = 0
        while k < producers * 100 {
            match r.recv() {
                Some(l) => {
                    var x = l
                    x[1].push_str("r")
                    n += x.len() as i64
                    seen.push(l)
                }
                None => {
                    k = producers * 100
                }
            }
            k += 1
        }
        return n
    })
    for t in ts { t.join() }
    c.close()
    consumer.join() + shared[0].len() as i64
}

/// One Task joined from many threads at once: each gets a copy of its own and changes it.
fn joins(threads: i32) -> i64 uses threads {
    let w = words(30)
    let task = spawn(|| -> List[String] {
        var l = w
        l.push(String.from("done"))
        return l
    })
    var ts: List[Task[i64]] = List.new()
    for i in 0..threads {
        let tt = task
        ts.push(spawn(|| -> i64 {
            var l = tt.join()
            l[0].push_str("j")
            l.push(String.from("more"))
            return l.len() as i64 + l[0].len() as i64
        }))
    }
    var total: i64 = 0
    for t in ts { total += t.join() }
    let last = task.join()
    total + last.len() as i64 + last[0].len() as i64
}

fn main() uses io, threads {
    print(captures(8))
    print(mutex(8))
    print(channel(4))
    print(joins(8))
}

// Map hashing is SipHash-1-3 under a per-map seed (decision C805, core/RUNTIME.md "Map
// hashing"): lookups, growth, removal and copy-on-write work for every key type; the order of
// keys()/values()/entries() is unspecified, and differs between maps made with Map.new(); a map
// made with Map.deterministic() has the same order in every run.
type Pt = { x: i32, y: i32 }
type Color = | Red | Green | Rgb(u8, u8, u8)

fn order(m: Map[i32, i32]) -> List[i32] { m.keys() }

fn main() uses io {
    let mut a: Map[i32, i32] = Map.new()
    for i in 0..1000 { a.insert(i * 7, i) }
    let mut ok = true
    for i in 0..1000 {
        match a.get(i * 7) {
            Some(v) => { if v != i { ok = false } }
            None => { ok = false }
        }
    }
    print(ok)
    print(a.len())
    let b = a.copy()
    for i in 0..500 { a.remove(i * 7) }
    print(a.len())
    print(b.len())
    print(a.contains(7 * 600))
    print(a.contains(7 * 100))
    print(b.contains(7 * 100))

    let mut s: Map[String, i32] = Map.new()
    for i in 0..100 { s.insert(String.from_int(i as i64), i) }
    let mut sum = 0
    for k in s.keys() { sum += s.get(k).unwrap() }
    print(sum)
    print(s.contains(String.from("42")))

    let mut r: Map[Pt, String] = Map.new()
    r.insert(Pt(1, 2), String.from("a"))
    r.insert(Pt(2, 1), String.from("b"))
    r.insert(Pt(1, 2), String.from("c"))
    print(r.len())
    print(r.get(Pt(1, 2)).unwrap())
    print(r.get(Pt(2, 1)).unwrap())

    let mut c: Map[Color, i32] = Map.new()
    c.insert(Red, 1)
    c.insert(Rgb(1, 2, 3), 2)
    c.insert(Rgb(3, 2, 1), 3)
    print(c.get(Rgb(1, 2, 3)).unwrap())
    print(c.get(Rgb(3, 2, 1)).unwrap())
    print(c.contains(Green))

    let mut t: Map[(i32, str), bool] = Map.new()
    t.insert((1, "x"), true)
    t.insert((2, "x"), false)
    print(t.get((1, "x")).unwrap())
    print(t.get((2, "x")).unwrap())

    let mut l: Map[List[u8], i32] = Map.new()
    let mut k1: List[u8] = List.new()
    k1.push(1)
    k1.push(2)
    l.insert(k1.copy(), 5)
    k1.push(3)
    l.insert(k1.copy(), 6)
    print(l.get(k1).unwrap())

    // per-map seeds: 30 maps with the same 64 keys do not all list them in the same order
    let mut first: List[i32] = List.new()
    let mut differ = false
    for n in 0..30 {
        let mut m: Map[i32, i32] = Map.new()
        for i in 0..64 { m.insert(i, i) }
        if n == 0 { first = order(m) } else if order(m) != first { differ = true }
    }
    print(differ)

    // the named deterministic hasher: the same order every time
    let mut d1: Map[i32, i32] = Map.deterministic()
    let mut d2: Map[i32, i32] = Map.deterministic()
    for i in 0..20 {
        d1.insert(i, i)
        d2.insert(i, i)
    }
    print(order(d1) == order(d2))
    print(order(d1))
}

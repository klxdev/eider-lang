// Bootstrap bug: a method of the String that `Mutex.get` returns, used inside a call
// argument (`String.from_int(m.get().len() as i64)`), makes stage 0 emit `void tN = ;`
// (its C does not compile). eiderc evaluates it like any other temporary.
fn main() uses io {
    let log = Mutex.new(String.from("abc"))
    var out = String.from("")
    out.append(String.from_int(log.get().len() as i64))
    print(out)
    let l: List[String] = List.new()
    var o2 = String.from("")
    o2.append(String.from_int(l.len() as i64))
    print(o2)
}

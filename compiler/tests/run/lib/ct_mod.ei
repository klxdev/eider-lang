// helper module for compiler/tests/run/comptime.ei: comptime constants of an imported
// module, using its private items and each other
fn hidden() -> i32 { return 7 }
pub fn sq(n: i32) -> i32 { return n * n }
pub const AREA: i32 = comptime sq(4) + hidden()
pub const NEG: i64 = comptime 0 - 5
pub const TWICE: i32 = comptime AREA * 2
pub const ON: bool = comptime AREA > 20

test "module constants" {
    assert AREA == 23
    assert TWICE == 46
}

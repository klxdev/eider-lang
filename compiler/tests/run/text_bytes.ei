// Byte access on String and str (docs/compiler.md, "C8.2: small language gaps"): len,
// byte, slice (byte offsets, on character boundaries), bytes, String.from_bytes (UTF-8
// checked), push_byte (ASCII), and ordering comparisons. Expected output in the comments.

fn show(r: Result[String, usize]) uses io {
    match r {
        Ok(s) => print(s)
        Err(at) => {
            print("invalid at")
            print(at)
        }
    }
}

fn from(bs: [u8; 4], n: usize) -> List[u8] {
    var out: List[u8] = List.new()
    for i in 0..n { out.push(bs[i]) }
    out
}

fn main() uses io {
    let s = String.from("añb€")
    print(s.len())             // 7
    print(len(s))              // 7
    print(s.byte(0))           // 97
    print(s.byte(1))           // 195
    print(s.byte(6))           // 172
    print(s.slice(0, 3))       // añ
    print(s.slice(3, 7))       // b€
    print(s.slice(7, 7).is_empty())  // true
    let lit = "hello"
    print(lit.len())           // 5
    print(len(lit))            // 5
    print(lit.byte(4))         // 111
    print(lit.slice(1, 4))     // ell
    print("".is_empty())       // true
    print(lit.is_empty())      // false
    // a loop over the bytes
    var sum: u32 = 0
    for i in 0..lit.len() { sum += lit.byte(i) as u32 }
    print(sum)                 // 532
    let bs = s.bytes()
    print(bs.len())            // 7
    print(bs[4])               // 226
    let back = String.from_bytes(bs)
    show(back)                 // añb€
    show(String.from_bytes(lit.bytes()))  // hello
    let empty: List[u8] = List.new()
    show(String.from_bytes(empty))        // (an empty line)
    // invalid UTF-8: a lone continuation, a truncated sequence, an overlong form, a
    // surrogate, past U+10FFFF, a NUL
    show(String.from_bytes(from([104, 128, 0, 0], 2)))     // invalid at 1
    show(String.from_bytes(from([104, 105, 226, 130], 4))) // invalid at 2
    show(String.from_bytes(from([192, 175, 0, 0], 2)))     // invalid at 0
    show(String.from_bytes(from([237, 160, 128, 0], 3)))   // invalid at 0
    show(String.from_bytes(from([244, 144, 128, 128], 4))) // invalid at 0
    show(String.from_bytes(from([97, 0, 98, 0], 3)))       // invalid at 1
    show(String.from_bytes(from([240, 159, 144, 166], 4))) // 🐦 (U+1F426, 4 bytes)
    var b = String.from("ab")
    b.push_byte(99)
    b.push_byte(10)
    b.push_byte(126)
    print(b)                   // abc, then ~ on the next line
    // ordering: byte order, which is Unicode scalar order
    let x = String.from("apple")
    let y = String.from("apricot")
    print(x < y)               // true
    print(x >= y)              // false
    print(y > x)               // true
    print(x <= x)              // true
    print("é" > "z")           // true
    print("ab" < "abc")        // true
    print("b" <= "a")          // false
}

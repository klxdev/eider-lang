// Regression: Mutex.update once dropped the closure it was given, and the caller dropped it
// again, so a closure that captures anything owned was freed twice (a double-free crash).
// eiderc's update deliberately borrows the closure; its owner drops it once.

fn main() uses io, threads {
    let m = Mutex.new(String.from("a"))
    let suffix = String.from("bc")
    m.update(|s: String| -> String {
        let mut t = s.copy()
        t.append(suffix)
        return t
    })
    print(m.get())
    // a stored closure, used twice
    let add = |s: String| -> String {
        let mut t = s.copy()
        t.append(suffix)
        return t
    }
    m.update(add)
    m.update(add)
    print(m.get())
    // from several threads, capturing a handle and a String
    let n = Mutex.new(0)
    let step = Mutex.new(3)
    let mut ts: List[Task[i32]] = List.new()
    for i in 0..8 {
        let nn = n
        let ss = step
        let tag = String.from("tag")
        ts.push(spawn(|| -> i32 {
            for j in 0..100 { nn.update(|x: i32| -> i32 x + ss.get() + tag.len() as i32 - 3) }
            return 0
        }))
    }
    for t in ts { let z = t.join() }
    print(n.get())
}

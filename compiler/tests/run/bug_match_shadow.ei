// Regression (LEARNINGS.md): a match-arm binding named like the `let` it initialises
// (`let p = match r { Ok(p) => p ... }`) once became a second C variable, so the outer `p`
// was never assigned. eiderc deliberately assigns it. Expected output: bug_match_shadow.out.

type Res = | Good(v: i32) | Bad(code: u8)
type Pt = { x: i64, y: i64 }
type Opt = | Some2(p: Pt) | None2

fn get(ok: bool) -> Res {
    if ok { Good(41) } else { Bad(3) }
}

fn main() uses io {
    let v = match get(true) {
        Good(v) => v + 1
        Bad(_) => 0
    }
    print(v)
    let code: u8 = match get(false) {
        Good(_) => 0
        Bad(code) => code
    }
    print(code)
    let p = match Some2(Pt(5, -6)) {
        Some2(p) => p
        None2 => Pt(0, 0)
    }
    print(p.x)
    print(p.y)
    let mut x: i32 = 0
    x = match get(true) {
        Good(x) => x * 2
        Bad(_) => 1
    }
    print(x)
}

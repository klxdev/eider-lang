// Unit values (docs/compiler.md, "C8.2: small language gaps"): `()` as an expression and
// as a pattern, `Ok(())`, `Result[(), E]` with `?`, `return ()`, Option[()].

type Fault = | Small | Big

fn check(n: i32) -> Result[(), Fault] {
    if n > 10 { return Err(Big) }
    if n < 0 { return Err(Small) }
    Ok(())
}

fn both(a: i32, b: i32) -> Result[(), Fault] {
    check(a)?
    check(b)?
    Ok(())
}

fn early(n: i32) uses io {
    if n == 0 { return () }
    print(n)
}

fn found(xs: List[i32], x: i32) -> Option[()] {
    for y in xs {
        if y == x { return Some(()) }
    }
    None
}

fn name(r: Result[(), Fault]) -> str {
    match r {
        Ok(()) => "ok"
        Err(Small) => "small"
        Err(Big) => "big"
    }
}

fn main() uses io {
    print(name(check(3)))      // ok
    print(name(check(30)))     // big
    print(name(both(1, -1)))   // small
    print(name(both(1, 2)))    // ok
    early(0)
    early(5)                   // 5
    var xs: List[i32] = List.new()
    xs.push(4)
    match found(xs, 4) {
        Some(()) => print("found")   // found
        None => print("missing")
    }
    print(found(xs, 5).is_none())    // true
    let r: Result[(), str] = Ok(())
    print(r.is_ok())                 // true
    print(r == Ok(()))               // true
    let e: Result[(), String] = Err(String.from("owned error"))
    match e {
        Ok(()) => print("no")
        Err(m) => print(m)           // owned error
    }
}

}

test "i64 div by zero" {
    let x = id_i64(7) / id_i64(0)
    assert false, "not reached"
}

test "i64 rem by zero" {
    let x = id_i64(7) % id_i64(0)
    assert false, "not reached"
}

test "i64 add overflows below" {

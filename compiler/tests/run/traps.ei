test "u8 add overflows" {
    let x = id_u8(255) + id_u8(1)
    assert false, "not reached"
}

test "u8 sub overflows" {
    let x = id_u8(0) - id_u8(1)
    assert false, "not reached"
}

test "u8 mul overflows" {
    let x = id_u8(255) * id_u8(2)
    assert false, "not reached"
}

test "u8 div by zero" {
    let x = id_u8(7) / id_u8(0)
    assert false, "not reached"
}

test "u8 rem by zero" {
    let x = id_u8(7) % id_u8(0)
    assert false, "not reached"
}

test "u8 sub below zero" {
    let x = id_u8(3) - id_u8(4)
    assert false, "not reached"
}

test "u8 compound assignment overflows" {
    let mut x = id_u8(255)
    x += id_u8(1)
}

test "u32 add overflows" {
    let x = id_u32(4294967295) + id_u32(1)
    assert false, "not reached"
}

test "u32 sub overflows" {

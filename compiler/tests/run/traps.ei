    let x = id_usize(4294967296) as u32
}

test "usize 18446744073709551615 as u32" {
    let x = id_usize(18446744073709551615) as u32
}

test "index past the end" {
    let a = [1, 2, 3]
    let x = a[id_usize(3)]
}

test "index far past the end" {
    let a = [1, 2, 3]
    let x = a[id_usize(18446744073709551615)]
}

test "store out of bounds" {
    let mut a: [u8; 4] = [0; 4]
    a[id_usize(4)] = 1
    assert a[0] == 1
}

test "inner index of a nested array" {
    let mut g = [[1, 2], [3, 4], [5, 6]]
    g[id_usize(2)][id_usize(2)] += 1
}

test "outer index of a nested array" {
    let g = [[1, 2], [3, 4], [5, 6]]
    let x = g[id_usize(3)][id_usize(0)]
}

test "passes between the traps" {
    let mut a = [10, 20, 30]
    a[id_usize(2)] = 31
    assert a[2] == 31
    assert len(a) == 3
}

fn bump(inout x: i32) { x += 1 }

test "inout argument out of bounds" {
    let mut a = [1, 2]
    bump(inout a[id_usize(2)])
}

test "panic" {
    panic("explicit panic")
}

test "assert without a message" {
    assert id_i32(1) == 2
}

test "assert with a message" {
    assert id_i32(1) == 2, "one is not two"
}

test "passes at the end" {
    assert id_u8(255) as u32 == 255
}

fn main() {}

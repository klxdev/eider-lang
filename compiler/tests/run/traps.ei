// Every runtime trap, one per test block (`eiderc test` keeps going after a failure), next
// to tests that pass. Values go through `id_*` functions so nothing is folded.

fn id_i32(x: i32) -> i32 { x }
fn id_i64(x: i64) -> i64 { x }
fn id_u8(x: u8) -> u8 { x }
fn id_u32(x: u32) -> u32 { x }
fn id_u64(x: u64) -> u64 { x }
fn id_usize(x: usize) -> usize { x }

fn wide_i64(x: i64) -> i64 { x }

test "passes before the traps" {
    assert id_i32(2) + id_i32(2) == 4
}

test "i32 add overflows" {
    let x = id_i32(2147483647) + id_i32(1)
    assert false, "not reached"
}

test "i32 sub overflows" {
    let x = id_i32((-2147483647 - 1)) - id_i32(1)
    assert false, "not reached"
}

test "i32 mul overflows" {
    let x = id_i32(2147483647) * id_i32(2)
    assert false, "not reached"
}

test "i32 div by zero" {
    let x = id_i32(7) / id_i32(0)
    assert false, "not reached"
}

test "i32 rem by zero" {
    let x = id_i32(7) % id_i32(0)
    assert false, "not reached"
}

test "i32 add overflows below" {
    let x = id_i32((-2147483647 - 1)) + id_i32(-1)
    assert false, "not reached"
}

test "i32 sub overflows above" {
    let x = id_i32(2147483647) - id_i32(-1)
    assert false, "not reached"
}

test "i32 mul overflows negative" {
    let x = id_i32((-2147483647 - 1)) * id_i32(2)
    assert false, "not reached"
}

test "i32 mul min by -1" {
    let x = id_i32((-2147483647 - 1)) * id_i32(-1)
    assert false, "not reached"
}

test "i32 div overflows" {
    let x = id_i32((-2147483647 - 1)) / id_i32(-1)
    assert false, "not reached"
}

test "i32 rem overflows" {
    let x = id_i32((-2147483647 - 1)) % id_i32(-1)
    assert false, "not reached"
}

test "i32 negation overflows" {
    let x = -id_i32((-2147483647 - 1))
    assert false, "not reached"
}

test "i32 compound assignment overflows" {
    let mut x = id_i32(2147483647)
    x += id_i32(1)
}

test "i64 add overflows" {
    let x = id_i64(9223372036854775807) + id_i64(1)
    assert false, "not reached"
}

test "i64 sub overflows" {
    let x = id_i64((-9223372036854775807 - 1)) - id_i64(1)
    assert false, "not reached"
}

test "i64 mul overflows" {
    let x = id_i64(9223372036854775807) * id_i64(2)

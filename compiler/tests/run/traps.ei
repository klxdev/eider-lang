test "i32 (-2147483647 - 1) as u8" {
    let x = id_i32((-2147483647 - 1)) as u8
}

test "i32 -1 as u8" {
    let x = id_i32(-1) as u8
}

test "i32 256 as u8" {
    let x = id_i32(256) as u8
}

test "i32 2147483647 as u8" {
    let x = id_i32(2147483647) as u8
}

test "i32 (-2147483647 - 1) as u32" {
    let x = id_i32((-2147483647 - 1)) as u32
}

test "i32 -1 as u32" {
    let x = id_i32(-1) as u32
}


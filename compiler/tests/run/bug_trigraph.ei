// Regression: string literals were once pasted into C unescaped except for `"`, `\`, newline,
// tab, and gcc in -std=c11 mode reads `??(` as the trigraph `[` (with a -Wtrigraphs warning
// on stderr). eiderc escapes `?`, so the text survives. Expected output: bug_trigraph.out.

const Q: str = "??= ??( ??) ??< ??> ??/ ??' ??! ??-"

fn main() uses io {
    print("what??(")
    print(Q)
    print(Q == "??= ??( ??) ??< ??> ??/ ??' ??! ??-")
}

test "name with ??( a trigraph" {
    assert "??(" != "["
}

// A frame larger than the 64 KiB stack guard must not step over it (#196): the prologue
// probes every page of a big frame, so the overflow lands in the guard and is reported as
// `stack overflow` (exit 101), not a bare SIGSEGV. The frame here is 320 KB. The bounded call
// is fine.
// nosan: thread
// llvm-nosan: how deep the bounded recursion gets before ASan's larger frames overflow the
// stack depends on each backend's frame sizes (scripts/llvm-diff.sh skips its ASan leg)

fn deep(n: i64, stop: i64) -> i64 {
    if n == stop { return 0 }
    let mut pad: [i64; 40000] = [0; 40000]
    pad[(n % 40000) as usize] = n
    deep(n + 1, stop) + pad[(n % 40000) as usize] - n + 1
}

fn main() uses io {
    print(deep(0, 100))
    print(deep(0, -1))
}

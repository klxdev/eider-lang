// The traps of C8.2's operations, one per test block, next to the edges that don't trap:
// shift counts out of range (per type, negative counts of signed types), byte access and
// slicing out of bounds or inside a character (on a str: a trapped test doesn't drop what it
// owns, so the String cases are run-mode programs, trap_text.ei and trap_push_byte.ei).
// Values go through `id_*` functions so nothing is folded.

fn id_i32(x: i32) -> i32 { x }
fn id_i64(x: i64) -> i64 { x }
fn id_u8(x: u8) -> u8 { x }
fn id_u32(x: u32) -> u32 { x }
fn id_u64(x: u64) -> u64 { x }
fn id_usize(x: usize) -> usize { x }
fn id_str(x: str) -> str { x }

test "the widest shifts pass" {
    assert id_u8(1) << id_u8(7) == 128
    assert id_u32(1) << id_u32(31) == 2147483648
    assert id_u64(1) << id_u64(63) == 9223372036854775808
    assert id_i32(1) << id_i32(31) == -2147483647 - 1
    assert id_i64(-1) >> id_i64(63) == -1
    assert id_usize(8) >> id_usize(3) == 1
}

test "u8 shift by 8" {
    let x = id_u8(1) << id_u8(8)
    assert false, "not reached"
}

test "u32 shift by 32" {
    let x = id_u32(1) >> id_u32(32)
    assert false, "not reached"
}

test "u64 shift by 64" {
    let x = id_u64(1) << id_u64(64)
    assert false, "not reached"
}

test "usize shift by 200" {
    let x = id_usize(1) >> id_usize(200)
    assert false, "not reached"
}

test "i32 shift by 32" {
    let x = id_i32(1) << id_i32(32)
    assert false, "not reached"
}

test "i32 shift by a negative count" {
    let x = id_i32(1) >> id_i32(-1)
    assert false, "not reached"
}

test "i64 shift by a negative count" {
    let x = id_i64(1) << id_i64(-9223372036854775807 - 1)
    assert false, "not reached"
}

test "i64 shift by 64 in a compound assignment" {
    let mut x = id_i64(5)
    x >>= id_i64(64)
    assert false, "not reached"
}

test "String bytes in range pass" {
    let s = String.from("aé")
    assert s.byte(0) == 97
    assert s.byte(2) == 169
    assert s.slice(3, 3).len() == 0
    assert s.slice(1, 3).len() == 2
    assert s.slice(0, 1) == String.from("a")
}

test "str byte out of bounds" {
    let b = id_str("").byte(id_usize(0))
    assert false, "not reached"
}

test "str slice past the end" {
    let t = id_str("abc").slice(id_usize(1), id_usize(4))
    assert false, "not reached"
}

test "str slice backwards" {
    let t = id_str("abc").slice(id_usize(2), id_usize(1))
    assert false, "not reached"
}

test "str slice starting inside a character" {
    let t = id_str("aé").slice(id_usize(2), id_usize(3))
    assert false, "not reached"
}

test "str slice ending inside a character" {
    let t = id_str("€uro").slice(id_usize(0), id_usize(2))
    assert false, "not reached"
}

fn main() uses io {
    print(id_u8(1) << id_u8(9))
}

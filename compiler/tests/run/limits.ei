const MIN_I32: i32 = (-2147483647 - 1)
const MAX_I32: i32 = 2147483647
fn id_i64(x: i64) -> i64 { x }
const MIN_I64: i64 = (-9223372036854775807 - 1)
const MAX_I64: i64 = 9223372036854775807
fn id_u8(x: u8) -> u8 { x }
const MIN_U8: u8 = 0
const MAX_U8: u8 = 255
fn id_u32(x: u32) -> u32 { x }
const MIN_U32: u32 = 0
const MAX_U32: u32 = 4294967295
fn id_u64(x: u64) -> u64 { x }
const MIN_U64: u64 = 0
const MAX_U64: u64 = 18446744073709551615

// Control flow and odd shapes: `continue` in `for` loops (it must still run the step),
// nested loops with break/continue, early returns from inside loops and matches, value-form
// `if`/`match`/blocks, unsafe blocks, nested records.

type Unit0 = { b: bool }
type Wrap = { e: Unit0, n: [u8; 1], k: u32 }

fn first_multiple(xs: [u32; 6], of: u32) -> u32 {
    for x in xs {
        if x == 0 { continue }
        if x % of == 0 { return x }
    }
    0
}

fn sum_odd(n: u64) -> u64 {
    let mut t: u64 = 0
    for i in 0..n {
        if i % 2 == 0 { continue }
        t += i
    }
    t
}

fn grid() -> u32 uses io {
    let mut hits: u32 = 0
    for i in 0..4 {
        if i == 3 { break }
        let mut j: u32 = 0
        while true {
            j += 1
            if j > 5 { break }
            if j % 2 == 1 { continue }
            for k in 0..3 {
                if k == 1 { continue }
                hits += 1
            }
        }
    }
    print(hits)
    hits
}

unsafe fn raw(x: i32) -> i32 { x * 2 }

fn pick(n: i32) -> i32 {
    let a = {
        let b = n * 2
        b + 1
    }
    let c = if a > 10 { a - 10 } else if a > 5 { a - 5 } else { a }
    let d = match c {
        1 | 2 | 3 => {
            if c == 2 { return 200 }
            c * 10
        }
        _ => c
    }
    let e = unsafe { raw(d) }
    e
}

fn main() uses io {
    print(first_multiple([0, 3, 0, 8, 12, 16], 4))
    print(first_multiple([1, 3, 5, 7, 9, 11], 4))
    print(sum_odd(10))
    print(grid())
    for n in -2..8 { print(pick(n)) }
    let w = Wrap(Unit0(false), [0; 1], 3)
    print(w.k)
    print(len(w.n))
    print(w == Wrap(Unit0(false), [0; 1], 3))
    print(w.e == Unit0(false))
    let mut total: i64 = 0
    let mut i: i64 = 10
    while i > 0 {
        i -= 1
        if i == 5 { continue }
        total += i
    }
    print(total)
}

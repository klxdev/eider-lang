// `main` returning Ok(()) exits 0; an Err whose type can't be printed (a record here)
// prints `error: main returned Err`.

type Why = { code: i32, line: u32 }

fn step(n: i32) -> Result[(), Why] {
    if n > 2 { return Err(Why(n, 9)) }
    Ok(())
}

fn main() -> Result[(), Why] uses io {
    step(1)?
    print("one")
    step(2)?
    print("two")
    step(3)?
    print("not reached")
    Ok(())
}

// `main` returning Ok(()) exits 0; an Err of a record prints through its (derived) Show,
// `error: Why { code: 3, line: 9 }` (#12).

type Why = { code: i32, line: u32 }

fn step(n: i32) -> Result[(), Why] {
    if n > 2 { return Err(Why(n, 9)) }
    Ok(())
}

fn main() -> Result[(), Why] uses io {
    step(1)?
    print("one")
    step(2)?
    print("two")
    step(3)?
    print("not reached")
    Ok(())
}

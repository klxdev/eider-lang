// Ownership: nested owned data in records, enums, tuples, arrays, Lists and Boxes; reading
// out of a place copies (mutating the copy leaves the original alone, and the other way
// round); fresh values move; parameters are borrowed; overwritten places are dropped.
type Inner = { tags: List[String], label: String }

type Outer = { inner: Inner, extra: Option[Inner], pair: (String, List[i32]) }

type Tree = | Leaf(v: i32) | Node(l: Box[Tree], r: Box[Tree], name: String)

fn mk_inner(l: str) -> Inner {
    let mut t: List[String] = List.new()
    t.push(String.from(l))
    Inner(t, String.from(l))
}

fn sum(t: Tree) -> i32 {
    match t {
        Leaf(v) => v
        Node(l, r, _) => sum(l.get()) + sum(r.get())
    }
}

fn names(t: Tree) -> String {
    match t {
        Leaf(_) => String.from(".")
        Node(l, r, n) => {
            let mut s = n.copy()
            s.append(names(l.get()))
            s.append(names(r.get()))
            s
        }
    }
}

fn bump(inout o: Outer) {
    o.inner.tags.push(String.from("bumped"))
    o.pair.1.push(99)
}

fn main() uses io {
    let mut o = Outer(mk_inner("a"), Some(mk_inner("b")), (String.from("p"), List.new()))
    let mut copy = o.copy()
    copy.inner.label.push_str("!")
    copy.inner.tags.push(String.from("c"))
    print(o.inner.label)
    print(copy.inner.label)
    print(o.inner.tags.len())
    print(copy.inner.tags.len())
    bump(inout o)
    print(o.inner.tags.len())
    print(o.pair.1.len())
    print(copy.pair.1.len())
    match o.extra {
        Some(x) => print(x.label)
        None => print("none")
    }
    o.extra = None
    o.inner = mk_inner("z")
    print(o.inner.label)
    o.pair = (String.from("q"), List.new())
    print(o.pair.0)

    let mut arr = [String.from("x"), String.from("y")]
    let arr2 = arr.copy()
    arr[0].push_str("x")
    print(arr[0])
    print(arr2[0])

    let t = Node(Box.new(Leaf(1)), Box.new(Node(Box.new(Leaf(2)), Box.new(Leaf(3)), String.from("in"))), String.from("top"))
    print(sum(t))
    print(names(t))
    let mut b = Box.new(mk_inner("boxed"))
    let b2 = b.copy()
    b.set(mk_inner("reset"))
    print(b.get().label)
    print(b2.get().label)
    let mut bl: Box[List[i32]] = Box.new(List.new())
    let mut inner = bl.get()
    inner.push(4)
    bl.set(inner)
    print(bl.get().len())
    print(bl == Box.new(inner))

    let mut ls: List[Inner] = List.new()
    ls.push(mk_inner("l0"))
    ls.push(mk_inner("l1"))
    let picked = ls[1].copy()
    ls[1].label.push_str("-changed")
    print(picked.label)
    print(ls[1].label)
    let mut tuples: List[(String, i32)] = List.new()
    tuples.push((String.from("t"), 1))
    let (ts, tn) = tuples[0]
    print(ts)
    print(tn)
    let mut opts: List[Option[String]] = List.new()
    opts.push(Some(String.from("o")))
    opts.push(None)
    print(opts[0].is_some())
    print(opts[1].is_none())
}

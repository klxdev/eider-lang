// Handles inside other values: records, enums, Options, Boxes, Lists and channels of
// handles (request/reply), a recursive type through a Mutex, copies of handles that share
// one object, and fn values (closures and named functions) spawned more than once.

type Msg =
    | Work(i32, Chan[i64])
    | Stop

type Pool = { jobs: Chan[Msg], done: Mutex[i32] }

type Node = { v: i32, next: Option[Mutex[Node]] }

fn square(x: i32) -> i64 { (x as i64) * (x as i64) }

/// Workers take requests from one channel and answer on the reply channel each carries.
fn serve(workers: i32, requests: i32) -> i64 uses threads {
    let pool = Pool(Chan.new(), Mutex.new(0))
    let mut ts: List[Task[i32]] = List.new()
    for w in 0..workers {
        let p = pool
        ts.push(spawn(|| -> i32 {
            let mut served = 0
            let mut going = true
            while going {
                match p.jobs.recv() {
                    Some(m) => {
                        match m {
                            Work(x, reply) => {
                                reply.send(square(x))
                                served = served + 1
                            }
                            Stop => { going = false }
                        }
                    }
                    None => { going = false }
                }
            }
            for k in 0..served { p.done.update(|d: i32| -> i32 d + 1) }
            return served
        }))
    }
    let mut replies: List[Chan[i64]] = List.new()
    for i in 0..requests {
        let r: Chan[i64] = Chan.new()
        pool.jobs.send(Work(i, r))
        replies.push(r)
    }
    for w in 0..workers { pool.jobs.send(Stop) }
    let mut total: i64 = 0
    for r in replies {
        match r.recv() {
            Some(v) => { total = total + v }
            None => {}
        }
    }
    let mut served = 0
    for t in ts { served = served + t.join() }
    total + (served + pool.done.get()) as i64
}

/// A linked list whose links are Mutexes; the last one is changed through a copy.
fn chain() -> i32 {
    let last = Mutex.new(Node(3, None))
    let mid = Mutex.new(Node(2, Some(last)))
    let head = Node(1, Some(mid))
    let alias = last
    alias.set(Node(30, None))
    let mut sum = head.v.copy()
    match head.next {
        Some(m) => {
            let n = m.get()
            sum = sum + n.v
            match n.next {
                Some(m2) => { sum = sum + m2.get().v }
                None => {}
            }
        }
        None => {}
    }
    sum
}

/// Channels of Tasks and Boxes of Mutexes.
fn nested_handles() -> i64 uses threads {
    let tasks: Chan[Task[i64]] = Chan.new()
    for i in 0..8 { tasks.send(spawn(|| -> i64 square(i))) }
    tasks.close()
    let mut acc: i64 = 0
    let mut going = true
    while going {
        match tasks.recv() {
            Some(t) => { acc = acc + t.join() }
            None => { going = false }
        }
    }
    let b = Box.new(Mutex.new(5))
    let inner = b.get()
    inner.set(6)
    let opt: Option[Chan[String]] = Some(Chan.new())
    match opt {
        Some(c) => {
            c.send(String.from("kept"))
            c.send(String.from("queued"))
        }
        None => {}
    }
    acc + b.get().get() as i64
}

fn seven() -> i32 { 7 }

/// The same fn value spawned several times (each Task owns a copy of its environment).
fn reuse() -> i32 uses threads {
    let mut label = String.from("abc")
    let f = || -> i32 label.len() as i32
    let g: fn() -> i32 = seven
    let mut ts: List[Task[i32]] = List.new()
    for i in 0..5 {
        ts.push(spawn(f))
        ts.push(spawn(g))
    }
    label.push_str("defg")
    let mut total = 0
    for t in ts { total = total + t.join() }
    total
}

fn main() uses io, threads {
    print(serve(4, 300))
    print(serve(1, 10))
    print(chain())
    print(nested_handles())
    print(reuse())
}

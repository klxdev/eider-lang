// Every arithmetic operator, comparison and conversion on every integer type, at ordinary
// values and at the edges of each range (wrapping operators wrap there). Values go through
// `id_*` functions so nothing is folded at compile time.

fn id_i32(x: i32) -> i32 { x }
fn id_i64(x: i64) -> i64 { x }
fn id_u8(x: u8) -> u8 { x }
fn id_u32(x: u32) -> u32 { x }
fn id_u64(x: u64) -> u64 { x }
fn id_usize(x: usize) -> usize { x }

fn ops_i32(a: i32, b: i32) uses io {
    print(a + b)
    print(a - b)
    print(a * b)
    print(a / b)
    print(a % b)
    print(a +% b)
    print(a -% b)
    print(a *% b)
    print(a == b)
    print(a != b)
    print(a < b)
    print(a <= b)
    print(a > b)
    print(a >= b)
}

fn ops_i64(a: i64, b: i64) uses io {
    print(a + b)
    print(a - b)
    print(a * b)
    print(a / b)
    print(a % b)
    print(a +% b)
    print(a -% b)
    print(a *% b)
    print(a == b)
    print(a != b)
    print(a < b)
    print(a <= b)
    print(a > b)
    print(a >= b)
}

fn ops_u8(a: u8, b: u8) uses io {
    print(a + b)
    print(a - b)
    print(a * b)
    print(a / b)
    print(a % b)
    print(a +% b)
    print(a -% b)
    print(a *% b)
    print(a == b)
    print(a != b)
    print(a < b)
    print(a <= b)
    print(a > b)
    print(a >= b)
}

fn ops_u32(a: u32, b: u32) uses io {
    print(a + b)
    print(a - b)
    print(a * b)
    print(a / b)
    print(a % b)
    print(a +% b)
    print(a -% b)
    print(a *% b)
    print(a == b)
    print(a != b)
    print(a < b)
    print(a <= b)
    print(a > b)
    print(a >= b)
}

fn ops_u64(a: u64, b: u64) uses io {
    print(a + b)
    print(a - b)
    print(a * b)
    print(a / b)
    print(a % b)
    print(a +% b)
    print(a -% b)
    print(a *% b)
    print(a == b)
    print(a != b)
    print(a < b)
    print(a <= b)
    print(a > b)
    print(a >= b)
}

fn ops_usize(a: usize, b: usize) uses io {
    print(a + b)
    print(a - b)
    print(a * b)
    print(a / b)
    print(a % b)
    print(a +% b)
    print(a -% b)
    print(a *% b)
    print(a == b)
    print(a != b)
    print(a < b)
    print(a <= b)
    print(a > b)
    print(a >= b)
}

fn main() uses io {
    // i32
    ops_i32(id_i32(7), id_i32(3))
    ops_i32(id_i32(-7), id_i32(3))
    ops_i32(id_i32(7), id_i32(-3))
    ops_i32(id_i32(-7), id_i32(-3))
    ops_i32(id_i32(-2147483647), id_i32(-1))
    print(id_i32(2147483647) +% id_i32(1))
    print(id_i32((-2147483647 - 1)) -% id_i32(1))
    print(id_i32(2147483647) *% id_i32(2))
    print(id_i32(2147483647) *% id_i32(2147483647))
    print(id_i32((-2147483647 - 1)) +% id_i32((-2147483647 - 1)))
    print(id_i32(2147483647) -% id_i32((-2147483647 - 1)))
    print(id_i32((-2147483647 - 1)) *% id_i32(-1))
    print(-id_i32(-2147483647))
    print(-id_i32(5))
    print(id_i32((-2147483647 - 1)) / id_i32(1))
    print(id_i32((-2147483647 - 1)) % id_i32(7))
    print(id_i32((-2147483647 - 1)) < id_i32(2147483647))
    print(id_i32(2147483647) == id_i32(2147483647))
    print(id_i32((-2147483647 - 1)) <= id_i32((-2147483647 - 1)))
    var ci32 = id_i32(10)
    ci32 += id_i32(3)
    print(ci32)
    ci32 -= id_i32(3)
    print(ci32)
    ci32 *= id_i32(3)
    print(ci32)
    ci32 /= id_i32(3)
    print(ci32)
    ci32 %= id_i32(3)
    print(ci32)
    // i64
    ops_i64(id_i64(7), id_i64(3))
    ops_i64(id_i64(-7), id_i64(3))
    ops_i64(id_i64(7), id_i64(-3))
    ops_i64(id_i64(-7), id_i64(-3))
    ops_i64(id_i64(-9223372036854775807), id_i64(-1))
    print(id_i64(9223372036854775807) +% id_i64(1))
    print(id_i64((-9223372036854775807 - 1)) -% id_i64(1))
    print(id_i64(9223372036854775807) *% id_i64(2))
    print(id_i64(9223372036854775807) *% id_i64(9223372036854775807))
    print(id_i64((-9223372036854775807 - 1)) +% id_i64((-9223372036854775807 - 1)))
    print(id_i64(9223372036854775807) -% id_i64((-9223372036854775807 - 1)))
    print(id_i64((-9223372036854775807 - 1)) *% id_i64(-1))
    print(-id_i64(-9223372036854775807))
    print(-id_i64(5))
    print(id_i64((-9223372036854775807 - 1)) / id_i64(1))
    print(id_i64((-9223372036854775807 - 1)) % id_i64(7))
    print(id_i64((-9223372036854775807 - 1)) < id_i64(9223372036854775807))
    print(id_i64(9223372036854775807) == id_i64(9223372036854775807))
    print(id_i64((-9223372036854775807 - 1)) <= id_i64((-9223372036854775807 - 1)))
    var ci64 = id_i64(10)
    ci64 += id_i64(3)
    print(ci64)
    ci64 -= id_i64(3)
    print(ci64)
    ci64 *= id_i64(3)
    print(ci64)
    ci64 /= id_i64(3)
    print(ci64)
    ci64 %= id_i64(3)
    print(ci64)
    // u8
    ops_u8(id_u8(7), id_u8(3))
    print(id_u8(255) +% id_u8(1))
    print(id_u8(0) -% id_u8(1))
    print(id_u8(255) *% id_u8(2))
    print(id_u8(255) *% id_u8(255))
    print(id_u8(0) +% id_u8(0))
    print(id_u8(255) -% id_u8(0))
    print(id_u8(255) == id_u8(255))
    print(id_u8(0) <= id_u8(0))
    var cu8 = id_u8(10)
    cu8 += id_u8(3)
    print(cu8)
    cu8 -= id_u8(3)
    print(cu8)
    cu8 *= id_u8(3)
    print(cu8)
    cu8 /= id_u8(3)
    print(cu8)
    cu8 %= id_u8(3)
    print(cu8)
    // u32
    ops_u32(id_u32(7), id_u32(3))
    ops_u32(id_u32(200), id_u32(13))
    print(id_u32(4294967295) +% id_u32(1))
    print(id_u32(0) -% id_u32(1))
    print(id_u32(4294967295) *% id_u32(2))
    print(id_u32(4294967295) *% id_u32(4294967295))
    print(id_u32(0) +% id_u32(0))
    print(id_u32(4294967295) -% id_u32(0))
    print(id_u32(4294967295) == id_u32(4294967295))
    print(id_u32(0) <= id_u32(0))
    var cu32 = id_u32(10)
    cu32 += id_u32(3)
    print(cu32)
    cu32 -= id_u32(3)
    print(cu32)
    cu32 *= id_u32(3)
    print(cu32)
    cu32 /= id_u32(3)
    print(cu32)
    cu32 %= id_u32(3)
    print(cu32)
    // u64
    ops_u64(id_u64(7), id_u64(3))
    ops_u64(id_u64(200), id_u64(13))
    print(id_u64(18446744073709551615) +% id_u64(1))
    print(id_u64(0) -% id_u64(1))
    print(id_u64(18446744073709551615) *% id_u64(2))
    print(id_u64(18446744073709551615) *% id_u64(18446744073709551615))
    print(id_u64(0) +% id_u64(0))
    print(id_u64(18446744073709551615) -% id_u64(0))
    print(id_u64(18446744073709551615) == id_u64(18446744073709551615))
    print(id_u64(0) <= id_u64(0))
    var cu64 = id_u64(10)
    cu64 += id_u64(3)
    print(cu64)
    cu64 -= id_u64(3)
    print(cu64)
    cu64 *= id_u64(3)
    print(cu64)
    cu64 /= id_u64(3)
    print(cu64)
    cu64 %= id_u64(3)
    print(cu64)
    // usize
    ops_usize(id_usize(7), id_usize(3))
    ops_usize(id_usize(200), id_usize(13))
    print(id_usize(18446744073709551615) +% id_usize(1))
    print(id_usize(0) -% id_usize(1))
    print(id_usize(18446744073709551615) *% id_usize(2))
    print(id_usize(18446744073709551615) *% id_usize(18446744073709551615))
    print(id_usize(0) +% id_usize(0))
    print(id_usize(18446744073709551615) -% id_usize(0))
    print(id_usize(18446744073709551615) == id_usize(18446744073709551615))
    print(id_usize(0) <= id_usize(0))
    var cusize = id_usize(10)
    cusize += id_usize(3)
    print(cusize)
    cusize -= id_usize(3)
    print(cusize)
    cusize *= id_usize(3)
    print(cusize)
    cusize /= id_usize(3)
    print(cusize)
    cusize %= id_usize(3)
    print(cusize)
    // conversions in range
    print(id_i32((-2147483647 - 1)) as i64)
    print(id_i32(0) as i64)
    print(id_i32(2147483647) as i64)
    print(id_i32(0) as u8)
    print(id_i32(255) as u8)
    print(id_i32(0) as u32)
    print(id_i32(2147483647) as u32)
    print(id_i32(0) as u64)
    print(id_i32(2147483647) as u64)
    print(id_i32(0) as usize)
    print(id_i32(2147483647) as usize)
    print(id_i64(-2147483648) as i32)
    print(id_i64(0) as i32)
    print(id_i64(2147483647) as i32)
    print(id_i64(0) as u8)
    print(id_i64(255) as u8)
    print(id_i64(0) as u32)
    print(id_i64(4294967295) as u32)
    print(id_i64(0) as u64)
    print(id_i64(9223372036854775807) as u64)
    print(id_i64(0) as usize)
    print(id_i64(9223372036854775807) as usize)
    print(id_u8(0) as i32)
    print(id_u8(255) as i32)
    print(id_u8(0) as i64)
    print(id_u8(255) as i64)
    print(id_u8(0) as u32)
    print(id_u8(255) as u32)
    print(id_u8(0) as u64)
    print(id_u8(255) as u64)
    print(id_u8(0) as usize)
    print(id_u8(255) as usize)
    print(id_u32(0) as i32)
    print(id_u32(2147483647) as i32)
    print(id_u32(0) as i64)
    print(id_u32(4294967295) as i64)
    print(id_u32(0) as u8)
    print(id_u32(255) as u8)
    print(id_u32(0) as u64)
    print(id_u32(4294967295) as u64)
    print(id_u32(0) as usize)
    print(id_u32(4294967295) as usize)
    print(id_u64(0) as i32)
    print(id_u64(2147483647) as i32)
    print(id_u64(0) as i64)
    print(id_u64(9223372036854775807) as i64)
    print(id_u64(0) as u8)
    print(id_u64(255) as u8)
    print(id_u64(0) as u32)
    print(id_u64(4294967295) as u32)
    print(id_u64(0) as usize)
    print(id_u64(18446744073709551615) as usize)
    print(id_usize(0) as i32)
    print(id_usize(2147483647) as i32)
    print(id_usize(0) as i64)
    print(id_usize(9223372036854775807) as i64)
    print(id_usize(0) as u8)
    print(id_usize(255) as u8)
    print(id_usize(0) as u32)
    print(id_usize(4294967295) as u32)
    print(id_usize(0) as u64)
    print(id_usize(18446744073709551615) as u64)
}

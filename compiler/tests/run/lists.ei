// List[T]: new, push (with growth), pop, indexing (read and write), get, clear, contains,
// len, is_empty, for-each, sum, map/filter/fold/any/all, nested Lists, Lists of records and
// arrays, and equality.
type P = { x: i32, y: i32 }

fn total(xs: List[i64]) -> i64 {
    var t: i64 = 0
    for x in xs { t += x }
    t
}

fn main() uses io {
    var xs: List[i64] = List.new()
    print(xs.len())
    print(xs.is_empty())
    var i: i64 = 0
    while i < 100 {
        xs.push(i * i)
        i += 1
    }
    print(xs.len())
    print(xs[7])
    print(xs.get(99))
    xs[7] = -1
    print(xs[7])
    print(total(xs))
    print(xs.sum())
    print(xs.contains(81))
    print(xs.contains(49))
    match xs.pop() {
        Some(v) => print(v)
        None => print("empty")
    }
    print(xs.len())
    xs.clear()
    print(xs.len())
    print(xs.is_empty())
    match xs.pop() {
        Some(v) => print(v)
        None => print("empty")
    }
    xs.push(5)
    print(xs[0])

    var grid: List[List[u8]] = List.new()
    for r in 0..3 {
        var row: List[u8] = List.new()
        for c in 0..4 { row.push((r * 4 + c) as u8) }
        grid.push(row)
    }
    grid[1][2] = 200
    print(grid[1][2])
    print(grid[2][3])
    var n: usize = 0
    for row in grid {
        for v in row { n += v as usize }
    }
    print(n)
    let first = grid[0]
    grid[0].push(9)
    print(first.len())
    print(grid[0].len())

    var ps: List[P] = List.new()
    ps.push(P(1, 2))
    ps.push(P(3, 4))
    ps[1].x = 30
    print(ps[1].x)
    print(ps.contains(P(1, 2)))
    print(ps.contains(P(3, 4)))

    var arrs: List[[i32; 3]] = List.new()
    arrs.push([1, 2, 3])
    arrs[0][2] = 7
    print(arrs[0][2])

    var words: List[String] = List.new()
    words.push(String.from("alpha"))
    words.push(String.from("be"))
    words.push(String.from("gamma"))
    let lens = words.map(|w| w.len())
    print(lens.sum())
    let long = words.filter(|w| w.len() > 2)
    print(long.len())
    print(long[1])
    print(words.any(|w| w.len() == 2))
    print(words.all(|w| w.len() > 2))
    let joined = words.fold(String.from(""), |acc, w| -> String {
        var r = acc
        r.append(w)
        r
    })
    print(joined)
    words.for_each(|w| print(w))
    match words.pop() {
        Some(w) => print(w)
        None => {}
    }
    print(words.len())
    var a: List[i32] = List.new()
    var b: List[i32] = List.new()
    a.push(1)
    b.push(1)
    print(a == b)
    b.push(2)
    print(a == b)
}

// `panic` takes a computed message, a String as well as a str (eider-lang#47): the trap says the
// text, and what was printed before it is flushed.
fn describe(n: i32) -> String {
    let mut m = String.from("bad value ")
    m.append(n.to_string())
    m
}

fn check(n: i32) -> i32 {
    if n > 2 { panic(describe(n)) }
    n
}

fn main() uses io {
    print(check(1))
    print(check(2))
    let ok = "static text"
    if check(2) == 3 { panic(ok) }
    print(check(7))
}

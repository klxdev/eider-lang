  %16 temp: u32
  %17 temp: bool
  %18 temp: bool
  %19 let w: u32
  %20 let h: u32
  %21 temp: u32
  %22 temp: u32
  %23 temp: u32
  {
    %1 = tag %0 is <0>
    if %1 {
      %2 = read %0.<0>.0
      %3 = read %2
      %4 = 3u32 * %3  @6
      %5 = read %2
      %6 = %4 * %5  @6
      return %6
    } else {
      %9 = tag %0 is <1>
      %8 = %9
      if %8 {
        %10 = read %0.<1>.0
        %11 = %10 == 1u32
        %8 = %11
      } else {
      }
      if %8 {
        %12 = read %0.<1>.1
        %13 = %12 == 1u32
        %8 = %13
      } else {
      }
      %7 = %8
      if %7 {
      } else {
        %15 = tag %0 is <1>
        %14 = %15
        if %14 {
          %16 = read %0.<1>.0
          %17 = %16 == 0u32
          %14 = %17
        } else {
        }
        %7 = %14
      }
      if %7 {
        return 1u32
      } else {
        %18 = tag %0 is <1>
        if %18 {
          %19 = read %0.<1>.0
          %20 = read %0.<1>.1
          %21 = read %19
          %22 = read %20
          %23 = %21 * %22  @8
          return %23
        } else {

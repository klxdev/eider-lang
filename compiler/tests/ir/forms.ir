  }

fn pick -> i64
  %0 param c: bool
  %1 param n: i64
  %2 let x: i64
  %3 temp: bool
  %4 temp: i64
  %5 temp: i64
  %6 temp: i64
  %7 var y: i64
  %8 temp: i64
  %9 temp: i64
  %10 temp: bool
  %11 temp: i64
  %12 temp: i64
  %13 temp: bool
  %14 temp: i64
  %15 temp: i64
  %16 temp: i64
  %17 temp: bool
  %18 temp: i64
  {
    %3 = read %0
    if %3 {
      %4 = read %1
      %2 = %4
    } else {
      %5 = read %1
      %6 = neg %5  @14
      %2 = %6
    }
    %7 = 0i64
    %9 = read %2
    %10 = %9 == 0i64
    if %10 {
      %8 = 1i64
    } else {
      %11 = read %2
      %8 = %11
    }
    store %7 = %8
    loop {
      %12 = read %7
      %13 = %12 > 10i64
      if %13 {
      } else {
        break
      }
      %14 = read %7
      %15 = %14 - 10i64  @21
      store %7 = %15
      %16 = read %7
      %17 = %16 == 13i64
      if %17 {
        break
      } else {
      }
    } step {
    }
    %18 = read %7
    return %18
  }

fn sum -> u32
  %0 param xs: [u8; 4]
  %1 var t: u32
  %2 temp: [u8; 4]
  %3 temp: usize
  %4 temp: usize
  %5 temp: bool
  %6 let x: u8
  %7 temp: u8
  %8 temp: u32
  %9 temp: u32
  %10 temp: u32
  %11 temp: usize
  %12 temp: usize
  %13 temp: u32
  {
    %1 = 0u32
    %2 = read %0
    %3 = 0usize
    loop {
      %4 = read %3
      %5 = %4 < 4usize
      if %5 {
      } else {
        break
      }
      %6 = read %2[%4]@0
      %7 = read %6
      %8 = %7 as u32  @29
      %9 = read %1
      %10 = %9 + %8  @29
      store %1 = %10
    } step {
      %11 = read %3
      %12 = %11 +% 1usize
      store %3 = %12
    }
    %13 = read %1
    return %13
  }

fn main -> () uses io
  %0 temp: Shape
  %1 temp: u32
  %2 temp: [u8; 4]
  %3 temp: u32
  %4 temp: u32
  %5 temp: i64
  %6 temp: [u8; 4]
  %7 temp: u32
  %8 temp: bool
  {
    %0 = Shape.<1>(2u32, 3u32)
    %1 = call area(%0)
    %2 = repeat [u8; 4] (1u8)
    %3 = call sum(%2)
    %4 = %1 + %3  @34
    print %4
    %5 = call pick(true, 25i64)
    print %5
    %6 = array [u8; 4](1u8, 2u8, 3u8, 4u8)
    %7 = call sum(%6)
    %8 = %7 == 10u32
    assert %8, "sum"  @36
  }

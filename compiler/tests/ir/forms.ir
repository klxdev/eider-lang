
fn area -> u32
  %0 param s: Shape
  %1 temp: Shape
  %2 temp: bool
  %3 let r: u32
  %4 temp: u32
  %5 temp: u32
  %6 temp: u32
  %7 temp: u32
  %8 temp: bool
  %9 temp: bool
  %10 temp: bool
  %11 temp: u32
  %12 temp: bool
  %13 temp: u32
  %14 temp: bool
  %15 temp: bool
  %16 temp: bool
  %17 temp: u32
  %18 temp: bool
  %19 temp: bool
  %20 let w: u32
  %21 let h: u32
  %22 temp: u32
  %23 temp: u32
  %24 temp: u32
  {
    %1 = read %0
    %2 = tag %1 is <0>
    if %2 {
      %3 = read %1.<0>.0
      %4 = read %3
      %5 = 3u32 * %4  @6
      %6 = read %3
      %7 = %5 * %6  @6
      return %7
    } else {
      %10 = tag %1 is <1>
      %9 = %10
      if %9 {
        %11 = read %1.<1>.0
        %12 = %11 == 1u32
        %9 = %12
      } else {
      }
      if %9 {
        %13 = read %1.<1>.1
        %14 = %13 == 1u32
        %9 = %14
      } else {
      }
      %8 = %9
      if %8 {
      } else {
        %16 = tag %1 is <1>
        %15 = %16
        if %15 {
          %17 = read %1.<1>.0
          %18 = %17 == 0u32
          %15 = %18
        } else {
        }
        %8 = %15
      }
      if %8 {
        return 1u32
      } else {
        %19 = tag %1 is <1>
        if %19 {
          %20 = read %1.<1>.0
          %21 = read %1.<1>.1
          %22 = read %20
          %23 = read %21
          %24 = %22 * %23  @8
          return %24
        } else {
          return 0u32
        }
      }
    }
  }

fn pick -> i64
  %0 param c: bool
  %1 param n: i64
  %2 let x: i64
  %3 temp: bool
  %4 temp: i64
  %5 temp: i64
  %6 temp: i64
  %7 var y: i64
  %8 temp: i64
  %9 temp: i64
  %10 temp: i64
  %11 temp: bool
  %12 temp: i64
  %13 temp: i64
  %14 temp: bool
  %15 temp: i64
  %16 temp: i64
  %17 temp: i64
  %18 temp: bool
  %19 temp: i64
  {
    %3 = read %0
    if %3 {
      %4 = read %1
      %2 = %4
    } else {
      %5 = read %1
      %6 = neg %5  @14
      %2 = %6
    }
    %7 = 0i64
    %9 = read %2
    %10 = read %9
    %11 = %10 == 0i64
    if %11 {
      %8 = 1i64
    } else {
      %12 = read %2
      %8 = %12
    }
    store %7 = %8
    loop {
      %13 = read %7
      %14 = %13 > 10i64
      if %14 {
      } else {
        break
      }
      %15 = read %7
      %16 = %15 - 10i64  @21
      store %7 = %16
      %17 = read %7
      %18 = %17 == 13i64
      if %18 {
        break
      } else {
      }
    } step {
    }
    %19 = read %7
    return %19
  }

fn sum -> u32
  %0 param xs: [u8; 4]
  %1 var t: u32
  %2 temp: [u8; 4]
  %3 temp: usize
  %4 temp: usize
  %5 temp: bool
  %6 let x: u8
  %7 temp: u8
  %8 temp: u32
  %9 temp: u32
  %10 temp: u32
  %11 temp: usize
  %12 temp: usize
  %13 temp: u32
  {
    %1 = 0u32
    %2 = read %0
    %3 = 0usize
    loop {
      %4 = read %3
      %5 = %4 < 4usize
      if %5 {
      } else {
        break
      }
      %6 = read %2[%4]@0
      %7 = read %6
      %8 = %7 as u32  @29
      %9 = read %1
      %10 = %9 + %8  @29
      store %1 = %10
    } step {
      %11 = read %3
      %12 = %11 +% 1usize
      store %3 = %12
    }
    %13 = read %1
    return %13
  }

fn main -> () uses io
  %0 temp: Shape
  %1 temp: u32
  %2 temp: [u8; 4]
  %3 temp: u32
  %4 temp: u32
  %5 temp: i64
  %6 temp: [u8; 4]
  %7 temp: u32
  %8 temp: bool
  {
    %0 = Shape.<1>(2u32, 3u32)
    %1 = call area(%0)
    %2 = repeat [u8; 4] (1u8)
    %3 = call sum(%2)
    %4 = %1 + %3  @34
    print %4
    %5 = call pick(true, 25i64)
    print %5
    %6 = array [u8; 4](1u8, 2u8, 3u8, 4u8)
    %7 = call sum(%6)
    %8 = %7 == 10u32
    assert %8, "sum"  @36
  }

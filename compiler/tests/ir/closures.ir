fn main.closure1 -> i32 uses io
  %0 capture k: i32
  %1 param x: i32
  %2 temp: i32
  %3 temp: i32
  %4 temp: i32
  {
    %2 = read %1
    %3 = read %0
    %4 = %2 * %3  @9
    return %4
  }

fn main.closure2 -> i32 uses io
  %0 capture greeting: String
  %1 param n: i32
  %2 temp: String
  %3 temp: i32
  %4 temp: bool
  %5 temp: i32
  {
    %2 = read %0
    print %2
    %3 = read %1
    %4 = %3 > 9i32
    if %4 {
      return 9i32
    } else {
    }
    %5 = read %1
    return %5
  }

fn main.closure3 -> i32 uses io
  %0 param x: i32
  %1 temp: i32
  %2 temp: i32
  {
    %1 = read %0
    %2 = %1 * 10i32  @21
    return %2
  }

fn main.closure4 -> bool uses io
  %0 param x: i32
  %1 temp: i32
  %2 temp: bool
  {
    %1 = read %0
    %2 = %1 > 10i32
    return %2
  }

fn main.closure5 -> bool uses io
  %0 param x: i32
  %1 temp: i32
  %2 temp: bool
  {
    %1 = read %0
    %2 = %1 == 2i32
    return %2
  }

fn main.closure6 -> i32 uses io
  %0 param a: i32
  %1 param x: i32
  %2 temp: i32
  %3 temp: i32
  %4 temp: i32
  {
    %2 = read %0
    %3 = read %1
    %4 = %2 + %3  @24
    return %4
  }

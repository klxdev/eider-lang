
fn apply -> i32
  %0 param x: i32
  %1 param f: fn(i32) -> i32
  %2 temp: fn(i32) -> i32
  %3 temp: i32
  %4 temp: i32
  {
    %2 = read %1
    %3 = read %0
    %4 = callv %2(%3)
    return %4
  }

fn twice -> i32
  %0 param x: i32
  %1 temp: i32
  %2 temp: i32
  {
    %1 = read %0
    %2 = %1 * 2i32  @5
    return %2
  }



fn half -> Result[u32, bool]
  %0 param n: u32
  %1 temp: u32
  %2 temp: u32
  %3 temp: bool
  %4 temp: Result[u32, bool]
  %5 temp: u32
  %6 temp: u32
  %7 temp: Result[u32, bool]
  {
    %1 = read %0
    %2 = %1 % 2u32  @23
    %3 = %2 == 1u32
    if %3 {
      %4 = Result[u32, bool].<1>(true)
      return %4
    } else {
    }
    %5 = read %0
    %6 = %5 / 2u32  @24
    %7 = Result[u32, bool].<0>(%6)
    return %7
  }

fn quarter -> Result[u32, bool]
  %0 param n: u32
  %1 temp: u32
  %2 temp: Result[u32, bool]
  %3 temp: bool
  %4 temp: bool
  %5 temp: Result[u32, bool]
  %6 temp: u32
  %7 let h: u32
  %8 temp: u32
  %9 temp: Result[u32, bool]
  {
    %1 = read %0
    %2 = call half(%1)
    %3 = tag %2 is <1>
    if %3 {
      %4 = move %2.<1>.0
      %5 = Result[u32, bool].<1>(%4)
      return %5
    } else {
    }
    %6 = read %2.<0>.0
    %7 = %6
    %8 = read %7
    %9 = call half(%8)
    return %9
  }

fn main -> () uses io
  %0 temp: Pair[i32, bool]
  %1 temp: Pair[bool, i32]
  %2 let p: Pair[bool, i32]
  %3 temp: bool
  %4 temp: i32
  %5 temp: (bool, i32)
  %6 let t: (bool, i32)
  %7 let x: bool
  %8 let y: i32
  %9 temp: bool
  %10 temp: i32
  %11 temp: Sq
  %12 var s: Sq
  %13 temp: Sq
  %14 temp: Sq
  %15 temp: u32
  %16 temp: Result[u32, bool]
  %17 temp: bool
  %18 let q: u32
  %19 temp: u32
  %20 temp: Result[u32, bool]
  %21 temp: u32
  {
    %0 = Pair[i32, bool](1i32, true)
    %1 = call swap[i32, bool](%0)
    %2 = %1
    %3 = read %2.0
    %4 = read %2.1
    %5 = tuple (bool, i32)(%3, %4)
    %6 = %5
    %7 = read %6.0
    %8 = read %6.1
    %9 = read %7
    if %9 {
      %10 = read %8
      print %10
    } else {
    }
    %11 = Sq(2u32)
    %12 = %11
    call Sq.grow(inout %12, 1u32)
    %13 = read %12
    %14 = Sq(1u32)
    %15 = call total[Sq](%13, %14)
    print %15
    %16 = call quarter(8u32)
    %17 = tag %16 is <0>
    if %17 {
      %18 = read %16.<0>.0
      %19 = read %18
      print %19
    } else {
    }
    %20 = call half(3u32)
    %21 = call Result[u32, bool].unwrap_or(%20, 0u32)
    print %21
  }

fn Sq.area -> u32
  %0 param self: Sq
  %1 temp: u32
  %2 temp: u32
  %3 temp: u32
  {
    %1 = read %0.0
    %2 = read %0.0
    %3 = %1 * %2  @11
    return %3
  }

fn Sq.grow -> ()
  %0 inout self: Sq
  %1 param by: u32
  %2 temp: u32
  %3 temp: u32
  %4 temp: u32
  {
    %2 = read %1
    %3 = read %0.0
    %4 = %3 + %2  @15
    store %0.0 = %4
  }

fn swap[i32, bool] -> Pair[bool, i32]
  %0 param p: Pair[i32, bool]
  %1 temp: bool
  %2 temp: i32
  %3 temp: Pair[bool, i32]
  {
    %1 = read %0.1
    %2 = read %0.0
    %3 = Pair[bool, i32](%1, %2)
    return %3
  }

fn total[Sq] -> u32
  %0 param a: Sq
  %1 param b: Sq
  %2 temp: Sq
  %3 temp: u32
  %4 temp: Sq
  %5 temp: u32
  %6 temp: u32
  {
    %2 = read %0
    %3 = call Sq.area(%2)
    %4 = read %1
    %5 = call Sq.area(%4)
    %6 = %3 + %5  @20
    return %6
  }

fn Result[u32, bool].unwrap_or -> u32
  %0 param self: Result[u32, bool]
  %1 param default: u32
  %2 temp: bool
  %3 let v: u32
  %4 temp: u32
  %5 temp: u32
  {
    %2 = tag %0 is <0>
    if %2 {
      %3 = read %0.<0>.0
      %4 = read %3
      return %4
    } else {
      %5 = read %1
      return %5
    }
  }

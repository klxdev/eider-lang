
fn half -> Result[u32, bool]
  %0 param n: u32
  %1 temp: u32
  %2 temp: u32
  %3 temp: bool
  %4 temp: Result[u32, bool]
  %5 temp: u32
  %6 temp: u32
  %7 temp: Result[u32, bool]
  {
    %1 = read %0
    %2 = %1 % 2u32  @23
    %3 = %2 == 1u32
    if %3 {
      %4 = Result[u32, bool].<1>(true)
      return %4
    } else {
    }
    %5 = read %0
    %6 = %5 / 2u32  @24
    %7 = Result[u32, bool].<0>(%6)
    return %7
  }

fn quarter -> Result[u32, bool]
  %0 param n: u32
  %1 temp: u32
  %2 temp: Result[u32, bool]
  %3 temp: bool
  %4 temp: bool
  %5 temp: Result[u32, bool]
  %6 temp: u32
  %7 let h: u32
  %8 temp: u32
  %9 temp: Result[u32, bool]
  {
    %1 = read %0
    %2 = call half(%1)
    %3 = tag %2 is <1>
    if %3 {
      %4 = move %2.<1>.0
      %5 = Result[u32, bool].<1>(%4)
      return %5
    } else {
    }
    %6 = read %2.<0>.0
    %7 = %6
    %8 = read %7
    %9 = call half(%8)
    return %9
  }

fn main -> () uses io
  %0 temp: Pair[i32, bool]
  %1 temp: Pair[bool, i32]
  %2 let p: Pair[bool, i32]
  %3 temp: bool
  %4 temp: i32
  %5 temp: (bool, i32)
  %6 let t: (bool, i32)
  %7 temp: bool
  %8 temp: i32
  %9 temp: Sq
  %10 var s: Sq
  %11 temp: Sq
  %12 temp: Sq
  %13 temp: u32
  %14 temp: Result[u32, bool]
  %15 temp: bool
  %16 let q: u32
  %17 temp: u32
  %18 temp: Result[u32, bool]
  %19 temp: u32
  {
    %0 = Pair[i32, bool](1i32, true)
    %1 = call swap[i32, bool](%0)
    %2 = %1
    %3 = read %2.0
    %4 = read %2.1
    %5 = tuple (bool, i32)(%3, %4)
    %6 = %5
    %7 = read %6.0
    if %7 {
      %8 = read %6.1
      print %8
    } else {
    }
    %9 = Sq(2u32)
    %10 = %9
    call Sq.grow(inout %10, 1u32)
    %11 = read %10
    %12 = Sq(1u32)
    %13 = call total[Sq](%11, %12)
    print %13
    %14 = call quarter(8u32)
    %15 = tag %14 is <0>
    if %15 {
      %16 = read %14.<0>.0
      %17 = read %16
      print %17
    } else {
    }
    %18 = call half(3u32)
    %19 = call Result[u32, bool].unwrap_or(%18, 0u32)
    print %19
  }

fn Sq.area -> u32
  %0 param self: Sq
  %1 temp: u32
  %2 temp: u32
  %3 temp: u32
  {
    %1 = read %0.0
    %2 = read %0.0
    %3 = %1 * %2  @11
    return %3
  }

fn Sq.grow -> ()
  %0 inout self: Sq
  %1 param by: u32
  %2 temp: u32
  %3 temp: u32
  %4 temp: u32
  {
    %2 = read %1
    %3 = read %0.0
    %4 = %3 + %2  @15
    store %0.0 = %4
  }

fn swap[i32, bool] -> Pair[bool, i32]
  %0 param p: Pair[i32, bool]
  %1 temp: bool
  %2 temp: i32
  %3 temp: Pair[bool, i32]
  {
    %1 = read %0.1
    %2 = read %0.0
    %3 = Pair[bool, i32](%1, %2)
    return %3
  }

fn total[Sq] -> u32
  %0 param a: Sq
  %1 param b: Sq
  %2 temp: Sq
  %3 temp: u32
  %4 temp: Sq
  %5 temp: u32
  %6 temp: u32
  {
    %2 = read %0
    %3 = call Sq.area(%2)
    %4 = read %1
    %5 = call Sq.area(%4)
    %6 = %3 + %5  @20
    return %6
  }

fn Result[u32, bool].unwrap_or -> u32
  %0 param self: Result[u32, bool]
  %1 param default: u32
  %2 temp: bool
  %3 temp: u32
  %4 temp: u32
  {
    %2 = tag %0 is <0>
    if %2 {
      %3 = read %0.<0>.0
      return %3
    } else {
      %4 = read %1
      return %4
    }
  }

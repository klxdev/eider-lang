// IR golden: value forms, patterns and loops.
type Shape = | Circle(r: u32) | Rect(w: u32, h: u32) | Dot

fn area(s: Shape) -> u32 {
    match s {
        Circle(r) => 3 * r * r
        Rect(1, 1) | Rect(0, _) => 1
        Rect(w, h) => w * h
        Dot => 0
    }
}

fn pick(c: bool, n: i64) -> i64 {
    let x = if c { n } else { -n }
    let mut y: i64 = 0
    y = match x {
        0 => 1
        _ => x
    }
    while y > 10 {
        y -= 10
        if y == 13 { break }
    }
    y
}

fn sum(xs: [u8; 4]) -> u32 {
    let mut t: u32 = 0
    for x in xs { t += x as u32 }
    t
}

fn main() uses io {
    print(area(Rect(2, 3)) + sum([1; 4]))
    print(pick(true, 25))
    assert sum([1, 2, 3, 4]) == 10, "sum"
}

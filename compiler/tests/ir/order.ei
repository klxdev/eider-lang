// IR golden: evaluation order, temporaries and places.
type P = { x: i32, xs: [i32; 3] }

fn next(inout n: i32) -> i32 {
    n += 1
    n
}

const K: i32 = 2 * 21

fn main() uses io {
    let mut n = 0
    // left to right: the read of n happens before next() changes it
    let a = n + next(inout n)
    let mut p = P(a, [K; 3])
    // the index is evaluated before the value; the element is read after it (compound)
    p.xs[next(inout n) as usize] += next(inout n)
    let ok = a > 0 && p.xs[0] == K
    for i in 0..2 {
        if i == 1 { continue }
        print(i)
    }
    print(ok)
}

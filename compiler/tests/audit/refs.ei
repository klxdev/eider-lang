// `eiderc audit-refs --json` (docs/compiler.md, "C8.6"): every write that changes what a
// `let` or pattern reference sees, written as if `let` still copied. Expected: refs.out.
type P = { x: i32, tags: List[String] }

fn swap(inout xs: List[i32], i: usize, j: usize) {
    let t = xs[i]
    xs[i] = xs[j]
    xs[j] = t
}

fn main() uses io {
    let mut p = P(1, List.new())
    let old = p.x
    p.x += 1
    print(old)
    let snap = p
    p.tags.push(String.from("t"))
    print(snap.tags.len())
    let mut pair = (1, 2)
    let (a, b) = pair
    pair.0 = b
    print(a)
    // a copy, or no later use: nothing to report
    let c = p.x.copy()
    p.x = 0
    print(c)
    let d = p.x
    print(d)
    p.x = 5
    let mut xs: List[i32] = List.new()
    xs.push(1)
    xs.push(2)
    swap(inout xs, 0, 1)
}

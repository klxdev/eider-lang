// pkgtest: expand
// `eiderc expand`: the specialized IR of the bodies that used comptime reflection, here
// the `@derive`d `enc` for two types (docs/compiler.md, "C8.57")
@[derive]
trait Enc {
    fn enc(self, inout out: String) {
        comptime for f in fields(Self) {
            self.[f].enc(inout out)
        }
    }
}

impl Enc for i64 {
    fn enc(self, inout out: String) { out.append(String.from_int(self)) }
}

type Point = { x: i64, y: i64 }
type Pair = { a: Point, b: i64 }

fn main() uses io {
    let mut s = String.from("")
    Pair(Point(1, 2), 3).enc(inout s)
    print(s)
}

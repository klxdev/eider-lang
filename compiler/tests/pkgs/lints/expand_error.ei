// pkgtest: check
// an error inside a specialization names the iteration (type and field) and the
// specialization (docs/compiler.md, "C8.57")
attr enc { skip: bool = false }

@[derive]
trait Enc {
    fn enc(self, inout out: String) {
        comptime for f in fields(Self) {
            self.[f].enc(inout out)
        }
    }
}

impl Enc for i64 {
    fn enc(self, inout out: String) { out.append(String.from_int(self)) }
}

@[derive(Enc)]
type Point = { x: i64, @[enc(skip)] y: f64 }

fn main() uses io {
    let mut s = String.from("")
    Point(1, 2.0).enc(inout s)
    print(s)
}

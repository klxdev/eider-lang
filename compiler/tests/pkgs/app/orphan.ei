// pkgtest: check
// only geo may implement a language trait for geo's types (E0604, C8.4); the app may for its
// own, also for one holding a geo type
import geo.util as gu

type Mine = { u: gu.Unit }

impl Show for Mine {
    fn show(self, inout out: String) { out.push_str("mine") }
}

impl Show for gu.Unit {
    fn show(self, inout out: String) { out.push_str("unit") }
}

fn main() uses io { print(Mine(gu.Metre)) }

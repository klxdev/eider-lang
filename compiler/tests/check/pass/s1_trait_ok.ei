// mode: build
trait Area {
    fn area(self) -> u32
}
type Sq = { s: u32 }
type Rect = { w: u32, h: u32 }
impl Area for Sq { fn area(self) -> u32 { self.s * self.s } }
impl Area for Rect { fn area(self) -> u32 { self.w * self.h } }
impl Sq {
    fn new(s: u32) -> Sq { Sq(s) }
    fn grow(inout self, by: u32) { self.s += by }
    fn double(self) -> Self { Sq(self.s * 2) }
}
fn total[T: Area](a: T, b: T) -> u32 { a.area() + b.area() }
fn main() uses io {
    var s = Sq.new(2)
    s.grow(1)
    print(s.area())
    print(total(s, s.double()))
    print(total(Rect(1, 2), Rect(3, 4)))
}

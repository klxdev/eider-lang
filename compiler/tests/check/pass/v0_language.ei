// mode: build
// Every v0 construct eiderc checks, in one program the bootstrap accepts.
type Suit = | Hearts | Spades
type Card = { rank: u8, suit: Suit }
type Hand = { cards: [Card; 3], owner: str }
type Shape = | Circle(r: u32) | Rect(w: u32, h: u32) | Dot
type Pair = | Two(Suit, bool)

const LIMIT: u32 = 10 * 10 + 1
const NEG: i64 = -(5 - 9)
const MASK: u8 = 255 +% 2
const BIG: u64 = 18446744073709551615
const NAME: str = "deck"
const ON: bool = true
const LAST: usize = len([1, 2, 3]) - 1

fn area(s: Shape) -> u32 {
    match s {
        Circle(r) => 3 * r * r
        Rect(w, h) => w * h
        Dot => 0
    }
}

fn describe(p: Pair) -> i32 {
    match p {
        Two(Hearts, true) => 1
        Two(Hearts, false) => 2
        Two(Spades, _) => 3
    }
}

fn classify(n: i64) -> str {
    match n {
        -1 => "minus one"
        0 | 1 => "small"
        other => if other > 100 { "big" } else { "medium" }
    }
}

fn word(s: str) -> u8 {
    match s {
        "one" => 1
        "two" => 2
        _ => 0
    }
}

fn bump(inout c: Card) { c.rank += 1 }

fn swap_first(inout h: Hand, inout other: Hand) {
    let t = h.cards[0]
    h.cards[0] = other.cards[0]
    other.cards[0] = t
}

fn total(h: Hand) -> u32 {
    var sum: u32 = 0
    for c in h.cards {
        sum += c.rank as u32
    }
    sum
}

fn count_down(n: u32) -> u32 {
    var i = n
    var steps: u32 = 0
    while true {
        if i == 0 { break }
        i -= 1
        if i % 2 == 0 { continue }
        steps += 1
    }
    steps
}

fn first_even(xs: [i32; 4]) -> i32 {
    for i in 0..4 {
        let x = xs[i as usize]
        if x % 2 == 0 { return x }
    }
    -1
}

fn suit_of(c: Card) -> Suit { c.suit }

fn pick(b: bool) -> Suit {
    if b { Suit.Hearts } else { Spades }
}

unsafe fn raw(n: i32) -> i32 { n *% 3 }

fn checked(n: i32) -> i32 {
    let x = unsafe { raw(n) }
    if let Circle(r) = Circle(2) {
        return x + r as i32
    }
    x
}

fn logic(a: bool, b: bool) -> bool { (a && !b) || (b && a) == false }

fn widen(a: u8, b: u32, c: i64) -> u64 {
    let x = a as u64 + b as u64
    let y = (c as u64) +% x
    y -% 1
}

fn main() uses io, clock {
    var card = Card(1, Hearts)
    bump(inout card)
    let hand = Hand([card, Card(5, Spades), Card(7, Suit.Hearts)], NAME)
    var a = hand
    var b = Hand([Card(2, Spades); 3], "b")
    swap_first(inout a, inout b)
    print(total(a))
    print(area(Rect(2, 3)) + area(Dot))
    print(describe(Two(Spades, true)))
    print(classify(NEG))
    print(word("two"))
    print(count_down(LIMIT))
    print(first_even([1, 3, 4, 5]))
    print(suit_of(card))
    print(pick(ON))
    print(checked(4))
    print(logic(true, false))
    print(widen(MASK, 2, 1))
    print(BIG)
    print(LAST)
    let t = now_ms()
    assert t >= 0, "time runs forward"
    let grid = [[0; 2]; 2]
    var g = grid
    g[1][0] = 9
    print(g[1][0] + grid[0][1])
}

test "arithmetic" {
    assert 2 + 2 == 4
    let x: i64 = -9223372036854775807 - 1
    assert x < 0
    print("tests have every capability")
}

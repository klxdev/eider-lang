// expect: E0115 12:36
// a bound naming a non-generic impl target is met by every type (the bootstrap's unify_ast
// matches any type against a name that isn't a type parameter), so the error comes from
// the instance's body
trait Area {
    fn area(self) -> u32
}
type Sq = { s: u32 }
impl Area for Sq {
    fn area(self) -> u32 { self.s }
}
fn total[T: Area](a: T) -> u32 { a.area() }
fn main() {
    let x = total(5)
}

// expect: E0308 12:7
type Stack = { items: List[String] }
impl Stack {
    fn push(inout self, x: String) { self.items.push(x) }
}
fn main() uses io {
    let mut s = Stack(List.new())
    s.push(String.from("a"))
    let top = s.items[0]
    print(top)
    let again = s.items[0]
    s.push(String.from("b"))
    print(again)
}

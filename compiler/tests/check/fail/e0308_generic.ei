// expect: E0308 5:8
fn last_then_clear[T](inout xs: List[T]) -> usize {
    let n = xs.len()
    let first = xs[0]
    xs.clear()
    let k = Some(first)
    if k.is_some() { return n }
    0
}
fn main() uses io {
    let mut xs: List[String] = List.new()
    xs.push(String.from("a"))
    print(last_then_clear(inout xs))
}

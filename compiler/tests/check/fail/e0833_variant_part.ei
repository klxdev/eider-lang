// expect: E0833 14:14
// the path of a variant's field: Shape.Circle.r
@[derive]
trait Enc {
    fn enc(self, inout out: String) {
        comptime if is_enum_type[Self] { out.push_str("e") } else { out.push_str("r") }
    }
}

type Inner = { n: i64 }

@[derive(Enc)]
type Shape =
    | Circle(r: Inner)
    | Empty

fn main() {}

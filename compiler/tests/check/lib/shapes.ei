// Helper module for compiler/tests/check (imported, never checked on its own).
pub type Color = | Red | Green | Blue
pub type Shape = | Circle(r: u32) | Square(side: u32)
pub type Point = { x: i32, y: i32 }
type Secret = { v: i32 }
pub type Wrap = { s: Secret }

const HIDDEN: i32 = 7
pub const ORIGIN_X: i32 = HIDDEN - 7

pub fn area(s: Shape) -> u32 {
    match s {
        Circle(r) => 3 * r * r
        Square(side) => side * side
    }
}

pub fn secret() -> Secret { Secret(HIDDEN) }

pub fn name(c: Color) -> str {
    match c {
        Red => "red"
        Green => "green"
        Blue => "blue"
    }
}

fn helper(n: i32) -> i32 { n + 1 }

pub fn uses_helper(n: i32) -> i32 {
    let value = helper(n)
    value
}

/// A parameter named like one of the module's functions shadows it.
pub fn shadow(area: i32) -> i32 { area + 1 }

pub fn origin() -> Point { Point(ORIGIN_X, 0) }

pub fn bump(inout p: Point) { p.x += 1 }

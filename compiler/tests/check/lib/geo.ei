pub type Point[T] = { x: T, y: T }
pub type Shape = | Circle(r: u32) | Sq(s: u32)
pub trait Area { fn area(self) -> u32 }
impl Area for Shape {
    fn area(self) -> u32 {
        match self {
            Circle(r) => 3 * r * r
            Sq(s) => s * s
        }
    }
}
impl[T] Point[T] {
    fn swap(self) -> Point[T] { Point(self.y, self.x) }
    fn mk(a: T, b: T) -> Point[T] { Point(a, b) }
}
pub fn origin[T](z: T) -> Point[T] { Point(z, z) }
pub fn total[A: Area](a: A, b: A) -> u32 { a.area() + b.area() }
fn hidden() -> u32 { 1 }
pub fn names() -> List[String] {
    var l: List[String] = List.new()
    l.push(String.from("a"))
    l
}
pub fn bad[T](x: T) -> T { x + 1 }

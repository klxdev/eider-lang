// Results when type checking fails midway: bodies are checked last first, so `later` is
// checked, then `broken`'s error is recorded and checking goes on (its later statements and
// `early` are checked too: their refs and types are reported).

type Cell = { v: i32 }

fn early(c: Cell) -> i32 {
    let w = c.v
    w
}

fn broken(c: Cell) -> i32 {
    let ok = c.v + 1
    let bad: bool = ok
    ok
}

fn later(c: Cell) -> i32 { broken(c) + early(c) }

fn main() uses io { print(later(Cell(1))) }

// --profile: CPU samples, labels and snapshots (scripts/test-compiler.sh, "profile"). `hot`
// takes most of the time, `warm` some, both under labels; a snapshot is written by
// std/profile, and the profile at exit (EIDER_PROF) has everything.
import std.profile

fn hot(n: i64) -> i64 {
    let mut s: i64 = 0
    for i in 0..n { s = (s + i * i) % 1000003 }
    s
}

fn warm(n: i64) -> i64 {
    let mut s: i64 = 0
    for i in 0..n { s = (s + i) % 999983 }
    s
}

fn main() uses io, fs {
    print(profile.enabled())
    let a = profile.with_label("phase", "hot", || -> i64 { hot(120000000) })
    let b = profile.with_label("phase", "warm", || -> i64 { warm(20000000) })
    print(a > 0 && b > 0)
    match profile.snapshot(List.new()) {
        Ok(_) => print("snapshot")
        Err(e) => print(e)
    }
}

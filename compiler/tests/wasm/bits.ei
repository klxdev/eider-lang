// C8.2 in a WebAssembly module: bitwise operators and shifts (with their trap), and the
// byte methods of String and str (which run in core/wasm's runtime).
export fn mix(a: u32, b: u32) -> u32 { return ((a & 0xFF) | (b << 8)) ^ 1 }
export fn sar(v: i64, n: i64) -> i64 { return v >> n }
export fn flip(v: u8) -> u8 { return ~v }
export fn text_sum() -> u32 {
    var s = String.from("añ")
    s.push_byte(66)
    var sum: u32 = 0
    for b in s.bytes() { sum += b as u32 }
    let t = s.slice(1, 3)
    match String.from_bytes(t.bytes()) {
        Ok(u) => { sum += u.len() as u32 }
        Err(at) => { sum += 1000 }
    }
    return sum + "xyz".byte(2) as u32
}

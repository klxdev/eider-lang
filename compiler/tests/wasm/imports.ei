// An `extern "c"` function the module does not define is an import from `env`, supplied by
// the host through the loader's `imports`.
extern "c" fn host_scale(v: i32) -> i32
export fn scaled_sum(n: i32) -> i32 uses ffi {
    let mut t: i32 = 0
    for i in 0..n {
        let k = unsafe { host_scale(i) }
        t = t + k
    }
    return t
}

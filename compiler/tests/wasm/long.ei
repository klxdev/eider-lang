// oracle differs: the recorded oracle's shim formatted each printf into a 512-byte buffer
// and dropped the rest, so a line over 511 bytes came out cut. core/wasm/libc.c writes it in chunks.
export fn long_line(n: i32) -> i32 uses io {
    let mut s = String.from("")
    for i in 0..n { s.push_str("0123456789") }
    print(s)
    return n * 10
}

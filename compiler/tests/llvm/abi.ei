// The LLVM backend's System V x86-64 classifier against C (compiler/tests/llvm/run.sh): records
// of mixed field types cross between C (abi_consumer.c, through the export wrappers and the
// glue) and the functions the LLVM backend emits, by value in both directions.
//
//   B2   2 bytes   one INTEGER eightbyte, coerced to i16
//   M12  12 bytes  two INTEGER eightbytes (i64, i32), with padding inside
//   L16  16 bytes  two INTEGER eightbytes (i64, i8)
//   T24  24 bytes  MEMORY: byval argument, sret result
//   Q    16 bytes  a bool and an i64 in separate eightbytes
//   N    16 bytes  nested records (B2 at 0, M12 at 4)
//   S    16 bytes  a str and a u32
// `many` passes three M12 (six registers) and then an L16, which no longer fits in registers
// and goes on the stack as a whole; `eqs` compares with ==, which is the eq_ glue
// called from LLVM IR with both records by value.

type B2 = { a: u8, b: bool }
type M12 = { a: u8, b: u32, c: bool }
type L16 = { a: i64, b: u8 }
type T24 = { a: i64, b: i64, c: i32 }
type Q = { x: bool, y: i64 }
type N = { b: B2, m: M12 }
type S = { s: str, n: u32 }

export fn b2_sum(x: B2) -> u32 {
    let k: u32 = if x.b { 1000 } else { 0 }
    (x.a as u32) + k
}

export fn m12_make(a: u8, b: u32, c: bool) -> M12 { M12(a, b, c) }

export fn m12_bump(x: M12) -> M12 { M12(x.a +% 1, x.b * 2, !x.c) }

export fn l16_mix(x: L16, y: L16) -> L16 { L16(x.a - y.a, x.b ^ y.b) }

export fn t24_rot(x: T24) -> T24 { T24(x.b, x.c as i64, x.a as i32) }

export fn many(a: M12, b: M12, c: M12, d: L16) -> i64 {
    (a.b as i64) + (b.b as i64) * 10 + (c.b as i64) * 100 + d.a * 1000 + (d.b as i64)
}

export fn mixed(i: i32, x: Q, j: u8, n: N, s: S) -> N {
    let flip: u32 = if x.x { 1 } else { 0 }
    N(B2(n.b.a +% j, !n.b.b), M12(n.m.a, n.m.b + ((i * i) as u32) + s.n + flip + (x.y as u32), n.m.c))
}

export fn eqs(a: M12, b: M12) -> bool { a == b && same_b2(B2(a.a, a.c), B2(b.a, b.c)) }

fn same_b2(x: B2, y: B2) -> bool { x == y }

export fn label(x: S) -> str { x.s }

export fn q_neg(x: Q) -> Q { Q(!x.x, 0 - x.y) }

// Floating point (SSE eightbytes on x86-64, FP registers on AArch64; docs/decisions.md C660):
//   F2   8 bytes   two f32 in one XMM register (`<2 x float>`); an AArch64 HFA of two floats
//   F3   12 bytes  `<2 x float>` and a `float`
//   D2   16 bytes  two SSE eightbytes (two doubles); an AArch64 HFA of two doubles
//   FD   16 bytes  a float (with padding) and a double: two SSE eightbytes
//   DL   16 bytes  one SSE and one INTEGER eightbyte (`{ double, i64 }`)
//   LD   16 bytes  one INTEGER and one SSE eightbyte
//   FFD  16 bytes  `<2 x float>` and a double
//   D3   24 bytes  MEMORY
//   FI   8 bytes   a float and an int share an eightbyte: INTEGER
type F2 = { a: f32, b: f32 }
type F3 = { a: f32, b: f32, c: f32 }
type D2 = { a: f64, b: f64 }
type D3 = { a: f64, b: f64, c: f64 }
type FD = { a: f32, b: f64 }
type DL = { a: f64, b: i64 }
type LD = { a: i64, b: f64 }
type FFD = { a: f32, b: f32, c: f64 }
type FI = { a: f32, b: i32 }

export fn fsum(a: f32, b: f64, c: f32) -> f64 { (a as f64) + b + (c as f64) }

export fn f2_scale(x: F2, k: f32) -> F2 { F2(x.a * k, x.b * k) }

export fn f3_rot(x: F3) -> F3 { F3(x.b, x.c, x.a) }

export fn d2_swap(x: D2) -> D2 { D2(x.b, x.a) }

export fn d3_neg(x: D3) -> D3 { D3(-x.a, -x.b, -x.c) }

export fn fd_mix(x: FD, y: FD) -> FD { FD(x.a + y.a, x.b * y.b) }

export fn dl_next(x: DL) -> DL { DL(x.a + 0.5, x.b + 1) }

export fn ld_next(x: LD) -> LD { LD(x.a - 1, x.b * 2.0) }

export fn ffd_sum(x: FFD) -> f64 { (x.a as f64) + (x.b as f64) + x.c }

export fn fi_sum(x: FI) -> f64 { (x.a as f64) + (x.b as f64) }

export fn mixf(i: i32, d: D2, j: i32, f: F2, k: i64) -> D2 { D2(d.a + (i + j) as f64 + (k as f64) + (f.a as f64), d.b) }

// nine doubles and a D2: eight XMM registers hold the doubles, so the D2 goes on the stack
export fn manyd(a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, g: f64, h: f64, i: f64, j: D2) -> f64 {
    a + b * 2.0 + c * 3.0 + d * 4.0 + e * 5.0 + f * 6.0 + g * 7.0 + h * 8.0 + i * 9.0 + j.a * 100.0 + j.b
}

export fn nan_is(x: f64) -> bool { x != x }

export fn f32_next(x: f32) -> f32 { x + 1.0 }

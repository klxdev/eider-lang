// DWARF variables and types (`-g`, docs/compiler.md "Backends"): compiler/tests/llvm/run.sh
// builds this with -g and finds each variable, parameter and member below in
// `readelf --debug-dump=info` (llvm-dwarfdump when it is installed).

type Point = { px: i64, py: i64 }

type Shape = | Dot | Circle(centre: Point, radius: u32)

fn area(shape_arg: Shape, scale_arg: u64) -> u64 {
    let mut acc_total: u64 = 0
    match shape_arg {
        Dot => { acc_total = 1 }
        Circle(c, r) => { acc_total = (r as u64) * (r as u64) * 3 + (c.px as u64) }
    }
    acc_total * scale_arg  // BREAK-AREA
}

// a generic function and a closure, for the debugger sessions (tests/debug/session.sh)
fn twice[T](x: T, f: fn(T) -> T) -> T {
    let once = f(x)
    f(once)  // BREAK-GENERIC
}

fn main() uses io {
    let origin_pt = Point(4, 5)
    let mut names_list: List[String] = List.new()
    names_list.push(String.from("a"))
    let flag_ok = names_list.len() == 1
    let mut ages_map: Map[String, i64] = Map.new()
    ages_map.insert(String.from("a"), 7)
    let bumped = twice(40 as i64, |v: i64| -> i64 {
        let next = v + 1  // BREAK-CLOSURE
        next
    })
    print(area(Circle(origin_pt, 2), 3))
    print(flag_ok)  // BREAK-MAIN
}

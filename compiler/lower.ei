// lower: the typed IR (ir.ei) to C11 text. See docs/compiler.md, "C4: lowering" and
// "C5: lowering".
//
// The IR already fixes evaluation order (every intermediate value is a temporary assigned in
// source order) and ownership (every clone, move and drop is an IR statement), so lowering is
// a direct translation, one C statement per IR statement. The C calls the language runtime in
// core/eider_rt.h for everything that can trap or must not be undefined (checked and wrapping
// arithmetic, conversions, bounds checks, traps, allocation, String, print); the only C
// written here besides the program itself is per-type glue (drop, clone, `==`, List/Map/Box
// operations, enum names, closure environments, fn-value thunks), generated once per type
// and only when something uses it.
//
// C names depend only on what they name (module identity, symbol, and for instances the type
// arguments), never on arena indexes or declaration order, so editing one module renames
// nothing elsewhere. The module identity is the module name (resolve.ei: the file stem
// outside packages, `<stem>__0<package>[_s<path>]` inside one; unique per program by E0808;
// the entry module has none), which the checker already spells into every name as
// `<module name>__name`; what a program prints (variant names) and a C interface's names
// show only the stem (resolve.shown). <h> below is 8 hex digits of a 64-bit hash of the
// spelled name or type (`swap[i32, bool]`, `Pair[i32, bool]`, `List[String]`):
//   t_<key>[_<h>]  record or enum (`_<h>` for instances of generic types)
//   ta_<h> tt_<h> tl_<h> tm_<h> tb_<h> tf_<h>   array, tuple, List, Map, Box, fn type
//   tk_<h> tx_<h> tc_<h>   Task, Mutex, Chan handles (`struct <name>_c` is the shared object)
//   f_<name>[_<h>] function: `.` becomes `__` (methods `Sq__area`, closures `main__closure1`,
//                  numbered per enclosing function), `[...]` is dropped and `_<h>` appended
//   x_<name>_<h>   test block (`_2`, `_3`... for repeated names)
//   <op>_<type>    glue: eq_ drop_ clone_ name_ push_ has_ find_ get_ ins_ rem_ new_
//                  uniq_ own_ (copy-on-write)
//                  threads: spawn_ run_ join_ (Task), new_ get_ set_ upd_ (Mutex),
//                  new_ send_ recv_ (Chan)
//   env_<f> edrop_<f> eclone_<f> eown_<f> k_<f>   closure environment and its glue; thunk of a
//                  function used as a value
//   l<i>[_<name>]  local i of the function being lowered (parameters first)
//   s<n>           the n-th loop's `continue` label (only when its step block is not empty)
// Every global name is registered with what it names; two things with one C name stop
// lowering with an internal error instead of miscompiling.
//
// Layout: records and tuples are structs (`f<n>`); arrays `struct { T a[N]; }` so they copy
// by value; every enum is `struct { uint32_t tag; union { struct { ... } v<n>; ... } u; }`
// (the union only when some variant has fields); `str` is `const char *`; String is the
// runtime's `ei_String`; List[T] `{ T *d; uint64_t len, cap; }`; Map[K, V] an open
// addressing table `{ K *k; V *v; uint8_t *s; uint64_t len, cap, used; }` (s: 0 empty, 1 used,
// 2 deleted; hashing and probing fixed by tests/oracle); Box[T] `{ T *p; }`; a fn value
// `{ void *env; R (*call)(void *, ...); void (*drop)(void *); void *(*clone)(void *);
// void (*own)(void *); }`;
// Task[T], Mutex[T] and Chan[T] `{ struct <name>_c *p; }`, a pointer to a shared object that
// starts with the runtime's `ei_rc` count and embeds the runtime's thread, mutex or channel
// (see "threads" below). Copying a handle shares the object; the last drop frees it.
// Copy-on-write (docs/compiler.md, "C8.1: copy-on-write"): the String bytes, the List `d`,
// the Map arrays (counted on `s`) and the Box `p` are the runtime's shared buffers
// (core/eider_rt.h `ei_buf_*`). A clone counts one more holder; a write first makes the
// buffer its own (`uniq_` glue on every List and Box on the path to the written place, and
// inside the List/Map/String operations); the last drop drops the elements. Counts are not
// atomic: values are made unique (`own_` glue) before another thread can see them.
// Every struct type is forward-declared, then defined after the types it contains by value.
// `inout` parameters are pointers. Every local is declared at the top of its function with a
// zero initializer, so no path reads an uninitialized variable (and gcc -O2 has nothing to
// report).
//
// Output order: includes, extern prototypes, types, prototypes (shared glue, then functions),
// shared glue, then the functions per module (the entry module first, then the others in
// order of first appearance), generic instances (sorted by C name), tests, and `main`.

import "core/sys"
import "std/bytes"
import "intern.ei"
import "types.ei"
import "resolve.ei"
import "ast.ei"
import "ir.ei"

const NONE: u32 = 4294967295

/// The program being lowered.
pub type P = { ir: ir.Ir, t: types.Types, names: intern.Interner }

// glue kinds (a glue item is kind * 2^32 + type id, or + function id for env/thunk)
pub const GK_EQ: u32 = 1
pub const GK_DROP: u32 = 2
pub const GK_CLONE: u32 = 3
pub const GK_NAME: u32 = 4
pub const GK_PUSH: u32 = 5
pub const GK_HAS: u32 = 6
pub const GK_FIND: u32 = 7
pub const GK_GET: u32 = 8
pub const GK_INS: u32 = 9
pub const GK_REM: u32 = 10
pub const GK_NEW: u32 = 11
pub const GK_ENV: u32 = 12
pub const GK_THUNK: u32 = 13
// threads (keyed by the handle type)
pub const GK_SPAWN: u32 = 14
pub const GK_JOIN: u32 = 15
pub const GK_MXNEW: u32 = 16
pub const GK_MXGET: u32 = 17
pub const GK_MXSET: u32 = 18
pub const GK_MXUPD: u32 = 19
pub const GK_CHNEW: u32 = 20
pub const GK_CHSEND: u32 = 21
pub const GK_CHRECV: u32 = 22
// copy-on-write (keyed by the type): give a List, Map or Box a buffer of its own (uniq_),
// make every buffer a value reaches its own before it crosses to another thread (own_)
pub const GK_UNIQ: u32 = 23
pub const GK_OWN: u32 = 24
// bytes of text (C8.2): `bytes_L` (List[u8] L from bytes), `utf8_R` (String.from_bytes, R its
// Result[String, usize])
pub const GK_BYTES: u32 = 25
pub const GK_UTF8: u32 = 26
// operation traits (C8.4; "Operation traits" below): `cmp_T` (Ord), `hash_T` (Map keys and
// `hash` of other types than integers, bool and text), `show_T` (text), `copy_T`
// (`.copy()` where it is more than a clone), `rnew_R` (a record with its own Drop), and the
// text helpers `showq_` (quoted text) and `showi_`/`showu_` (numbers), keyed by type 0
pub const GK_CMP: u32 = 27
pub const GK_HASH: u32 = 28
pub const GK_SHOW: u32 = 29
pub const GK_SHOWQ: u32 = 30
pub const GK_SHOWN: u32 = 31
pub const GK_COPY: u32 = 32
pub const GK_RNEW: u32 = 33
// Ref[T] (C8.7): `new_R`, a new Ref holding a value
pub const GK_REFNEW: u32 = 34
// Default (C8.23): `default_T`, the derived Default of a record, tuple, array or Box
pub const GK_DEFAULT: u32 = 35
// the traits, as check.ei numbers them in ir.Ir.impls
const TR_COPY: u32 = 0
const TR_EQ: u32 = 1
const TR_ORD: u32 = 2
const TR_HASH: u32 = 3
const TR_SHOW: u32 = 4
const TR_DROP: u32 = 6
const TR_DEFAULT: u32 = 7

/// Output and lowering state. `o` is the text being written; `pr` collects glue prototypes
/// and `envs` closure environment structs while glue is generated. Per type: its C name
/// (`tn`, empty for types that are not C structs or not concrete) and whether it owns heap
/// data (`own`: 0 unknown, 1 no, 2 yes). Per function: its C name, whether it is a closure
/// body and how many captures it has. The function being lowered: its first local and the
/// loops around the current statement (the label number of each, NONE when `continue` can be
/// a plain C `continue` because the loop's step block is empty).
type G = {
    o: List[u8],
    lbase: u32,
    loops: List[u32],
    nlabels: u32,
    tn: List[List[u8]],
    own: List[u8],
    fnn: List[List[u8]],
    clo: List[bool],
    ncap: List[u32],
    need: List[u64],
    seen: Map[u64, bool],
    pr: List[u8],
    envs: List[u8],
    reg: Map[u64, u32],
    reg_name: List[List[u8]],
    reg_from: List[List[u8]],
    err: List[u8],
    /// the file index of the function being emitted (ir.Fn.file) and the indices whose
    /// names the trap table needs (put_line)
    file: u32,
    files: List[u32],
    /// per loop in `loops`: the label after it that a labeled `break` from a nested loop
    /// jumps to (NONE: none needed; docs/compiler.md, "C8.22")
    brks: List[u32],
    /// `--profile`: what to profile (PROF_CPU | PROF_MEM | PROF_CONC; 0: not profiling, and
    /// then nothing below is emitted), and the line the shadow frame was last set to in the
    /// straight-line code being emitted (NONE at block boundaries)
    prof: u32,
    pline: u32,
    /// whether the function being emitted has a shadow frame (framed), and the toolchain
    /// version the profile records
    pframe: bool,
    pver: List[u8],
    /// the functions another backend emits (docs/compiler.md, "Backends"; empty: none): their
    /// bodies are lowered only for the glue they need, and only their prototypes are kept
    native: List[bool],
}

// ---- profiling (`eiderc build|run --profile`; docs/runtime.md "Profiler"). The C starts with
// `#define EI_RT_PROFILE 1` (the driver then links the profiling runtime, core/eider_prof.c).
// Every Eider function pushes a shadow frame (`ei_prof_frame *ei_pf = ei_prof_enter(<id>);`,
// id = its index + 1 in the name table `ei_prof_names`), sets `ei_pf->line` before each
// statement with a line that differs from the last one set in the same straight-line code,
// and pops it before every `return` and at the end. The glue reports the events that make
// Eider programs slow (copy-on-write unshares, `.copy()`, Drop calls, List growth, Map
// rehashes) with `ei_prof_ev`. Without --profile none of this is emitted.

pub const PROF_CPU: u32 = 1
pub const PROF_MEM: u32 = 2
pub const PROF_CONC: u32 = 4

/// What `--profile[=cpu,mem,conc]` asks for (PROF_CPU | PROF_MEM | PROF_CONC); a bare
/// `--profile` is all three. 0: not a valid selection.
pub fn prof_what(arg: List[u8]) -> u32 {
    if bytes.eq(arg, sys.lit("--profile")) { return PROF_CPU + PROF_MEM + PROF_CONC }
    if !bytes.starts_with(arg, sys.lit("--profile=")) { return 0 }
    let mut what: u32 = 0
    for part in bytes.split(bytes.slice(arg, 10, arg.len()), 44) {
        if bytes.eq(part, sys.lit("cpu")) {
            if what % 2 == 0 { what += PROF_CPU }
        } else if bytes.eq(part, sys.lit("mem")) {
            if (what / 2) % 2 == 0 { what += PROF_MEM }
        } else if bytes.eq(part, sys.lit("conc")) {
            if (what / 4) % 2 == 0 { what += PROF_CONC }
        } else {
            return 0
        }
    }
    what
}

/// Whether a function whose body is block b gets a shadow frame: when it calls a function
/// (S_CALL, S_CALLV) or loops, directly or in a nested block. Straight-line code that calls
/// nothing (accessors, small helpers, wrappers of a builtin) gets none: like a function the C
/// compiler inlines, its time, allocations and copies count for its caller, at the line of
/// the call. That keeps the profiler cheap on code made of many small functions (eiderc:
/// +31% instead of +52%), and every function that can take time of its own is still named.
fn framed(p: P, b: u32) -> bool {
    let bl = p.ir.blocks[b as usize]
    for i in 0..bl.len {
        let s = p.ir.stmts[p.ir.extra[(bl.start + i) as usize] as usize]
        if s.kind == ir.S_CALL || s.kind == ir.S_CALLV || s.kind == ir.S_LOOP { return true }
        if s.kind == ir.S_IF && (framed(p, s.b) || framed(p, s.c)) { return true }
    }
    false
}

/// Whether statement s gets its line in the shadow frame: those that call, allocate or run a
/// Drop (calls, builtins, closures, records with their own Drop, drops of owned values,
/// prints), which are the positions a profile names (call sites in the frames above, the
/// sites of allocations and copies). Other statements don't: a store per statement costs
/// more than the rest of the profiler (eiderc: +75% against +20%), so time in call-free code
/// is attributed to its function at the line of its last call.
fn prof_marks(p: P, s: ir.Stmt) -> bool {
    let k = s.kind
    if k == ir.S_CALL || k == ir.S_CALLV || k == ir.S_BUILTIN || k == ir.S_CLOSURE || k == ir.S_PRINT || k == ir.S_DROP { return true }
    k == ir.S_RECORD && shared_rec(p, s.ty)
}

/// `ei_pf->line = <line>;` before a statement of line `line`, unless it is already set.
fn prof_line(inout g: G, line: u32, depth: u32) {
    if !g.pframe || line == 0 || line == g.pline { return }
    ind(inout g, depth)
    put(inout g, "ei_pf->line = ")
    putn(inout g, line as u64)
    put(inout g, ";\n")
    g.pline = line
}

/// `ei_prof_ev(<kind>, <bytes>); ` in glue (nothing without --profile).
fn prof_ev(inout g: G, kind: str, bytes: str) {
    if g.prof == 0 { return }
    put(inout g, "ei_prof_ev(")
    put(inout g, kind)
    put(inout g, ", ")
    put(inout g, bytes)
    put(inout g, "); ")
}

/// The name table and the profiler's start-up table (before `main`).
fn prof_table(inout g: G, p: P, file: List[u8]) {
    put(inout g, "static const char *const ei_prof_names[] = { \"\"")
    for f in 0..p.ir.fns.len() {
        put(inout g, ", ")
        let n = p.ir.fns[f].name.copy()
        str_lit(inout g.o, n)
    }
    put(inout g, " };\nstatic const uint32_t ei_prof_file_of[] = { 0")
    for f in 0..p.ir.fns.len() {
        put(inout g, ", ")
        putn(inout g, p.ir.fns[f].file as u64)
    }
    put(inout g, " };\nstatic const char *const ei_prof_files[] = { ")
    str_lit(inout g.o, file)
    for i in 1..p.ir.files.len() {
        put(inout g, ", ")
        let name = p.ir.files[i].copy()
        str_lit(inout g.o, name)
    }
    put(inout g, " };\nstatic const ei_prof_table ei_prof_tab = { ei_prof_names, ei_prof_file_of, ")
    putn(inout g, (p.ir.fns.len() + 1) as u64)
    put(inout g, ", ei_prof_files, ")
    let mut nf = p.ir.files.len()
    if nf == 0 { nf = 1 }
    putn(inout g, nf as u64)
    put(inout g, ", ")
    let what = g.prof.copy()
    putn(inout g, what as u64)
    put(inout g, ", ")
    str_lit(inout g.o, file)
    put(inout g, ", ")
    let ver = g.pver.copy()
    str_lit(inout g.o, ver)
    put(inout g, " };\n\n")
}

fn put(inout g: G, s: str) { bytes.append(inout g.o, sys.lit(s)) }
fn putb(inout g: G, s: List[u8]) { bytes.append(inout g.o, s) }
fn putn(inout g: G, n: u64) { bytes.append(inout g.o, bytes.from_u64(n)) }

/// A source line for the runtime (ei_trap and the checked helpers): in a function from an
/// imported module, the module's file index times 2^20 plus the line, which ei_trap
/// decodes through the table that files_table emits (docs/compiler.md, "C8.16"). Lines from
/// 2^20 on are emitted as they are (and name the entry file).
fn put_line(inout g: G, line: u32) {
    if g.file == 0 || line >= 1048576 {
        putn(inout g, line as u64)
        return
    }
    if !g.files.contains(g.file) { g.files.push(g.file) }
    let v = (g.file as u64) * 1048576 + line as u64
    putn(inout g, v)
}

/// The trap file table, if a function from an imported module has a trap line: a static
/// array of file names by index (`call`: false), or the call after `ei_set_file` that
/// hands it to the runtime (`call`: true).
fn files_table(inout g: G, p: P, call: bool) {
    if g.files.len() == 0 { return }
    let mut n: u32 = 0
    for f in g.files {
        if f + 1 > n { n = f + 1 }
    }
    if call {
        put(inout g, "ei_set_files(ei_files, ")
        putn(inout g, n as u64)
        put(inout g, ");\n  ")
        return
    }
    put(inout g, "static const char *const ei_files[")
    putn(inout g, n as u64)
    put(inout g, "] = {")
    for i in 0..n {
        if i > 0 { put(inout g, ",") }
        if g.files.contains(i) {
            put(inout g, " ")
            let name = p.ir.files[i as usize].copy()
            str_lit(inout g.o, name)
        } else {
            put(inout g, " 0")
        }
    }
    put(inout g, " };\n\n")
}

fn ind(inout g: G, depth: u32) {
    for i in 0..depth { put(inout g, "  ") }
}

/// Identifier characters of `s`; anything else becomes `_`.
fn ident_into(inout out: List[u8], s: List[u8]) {
    for b in s {
        if bytes.is_ident(b) { out.push(b) } else { out.push(95) }
    }
}

fn ident(inout g: G, s: List[u8]) { ident_into(inout g.o, s) }

/// A C string literal with the bytes of `s` (escaped as tests/oracle expects; `?` is escaped too, so no
/// trigraph can form).
pub fn str_lit(inout out: List[u8], s: List[u8]) {
    out.push(34)
    for b in s {
        if b == 34 || b == 92 || b == 63 {
            out.push(92)
            out.push(b)
        } else if b == 10 {
            out.push(92)
            out.push(110)
        } else if b == 9 {
            out.push(92)
            out.push(116)
        } else if b >= 32 && b < 127 {
            out.push(b)
        } else {
            out.push(92)
            out.push(48 + b / 64)
            out.push(48 + (b / 8) % 8)
            out.push(48 + b % 8)
        }
    }
    out.push(34)
}

// ---- stable names

/// A 64-bit hash of `s` (FNV-style, written without bitwise operators). Only used to make
/// short, stable C names; clashes are caught by `register`.
fn h64(s: List[u8]) -> u64 {
    let mut h: u64 = 14695981039346656037
    for b in s { h = (h +% (b as u64)) *% 1099511628211 }
    h
}

/// The top 32 bits of `h` as 8 lowercase hex digits.
fn hex8(inout out: List[u8], h: u64) {
    let mut x = h / 4294967296
    let mut ds: List[u8] = List.new()
    for i in 0..8 {
        let d = (x % 16) as u8
        if d < 10 { ds.push(48 + d) } else { ds.push(87 + d) }
        x = x / 16
    }
    let mut i: usize = 8
    while i > 0 {
        i -= 1
        out.push(ds[i])
    }
}

/// Claim C name `name` for `from` (what it names). False if something else has it.
fn register(inout g: G, name: List[u8], from: List[u8]) -> bool {
    let k = h64(name)
    match g.reg.get(k) {
        Some(i) => {
            if bytes.eq(g.reg_name[i as usize], name) { return false }
            // a 64-bit hash collision of two different names: they don't clash
            return true
        }
        None => {}
    }
    g.reg.insert(k, g.reg_name.len() as u32)
    g.reg_name.push(name)
    g.reg_from.push(from)
    true
}

fn clash(inout g: G, name: List[u8], from: List[u8]) {
    if g.err.len() > 0 { return }
    let mut m = sys.lit("C name clash: `")
    bytes.append(inout m, name)
    bytes.append(inout m, sys.lit("` names both `"))
    let k = h64(name)
    match g.reg.get(k) {
        Some(i) => bytes.append(inout m, g.reg_from[i as usize])
        None => {}
    }
    bytes.append(inout m, sys.lit("` and `"))
    bytes.append(inout m, from)
    bytes.append(inout m, sys.lit("`"))
    g.err = m
}

pub fn is_struct_kind(k: u32) -> bool {
    k == types.T_ENUM || k == types.T_RECORD || k == types.T_ARRAY || k == types.T_TUPLE || k == types.T_LIST || k == types.T_MAP || k == types.T_BOX || k == types.T_FN || types.is_handle(k) || k == types.T_REF
}

/// Whether type `ty` is concrete (no generic template inside it).
pub fn usable(p: P, ty: u32) -> bool {
    let t = types.get(p.t, ty)
    let k = t.kind
    if k == types.T_ENUM || k == types.T_RECORD {
        let d = types.def_of(p.t, ty)
        return d.generic == 0 && d.filled
    }
    if k == types.T_ARRAY || k == types.T_LIST || k == types.T_BOX || types.is_handle(k) || k == types.T_REF || k == types.T_INOUT { return usable(p, t.a) }
    if k == types.T_MAP { return usable(p, t.a) && usable(p, t.b) }
    if k == types.T_TUPLE {
        for x in types.elems(p.t, ty) {
            if !usable(p, x) { return false }
        }
        return true
    }
    if k == types.T_FN {
        for x in types.elems(p.t, ty) {
            if !usable(p, x) { return false }
        }
        return usable(p, t.b)
    }
    true
}

/// The C name of struct type `ty` (see the top of the file).
fn type_name(p: P, ty: u32) -> List[u8] {
    let k = types.kind(p.t, ty)
    let mut out: List[u8] = List.new()
    let shown = types.show(p.t, p.names, ty)
    if k == types.T_ENUM || k == types.T_RECORD {
        let d = types.def_of(p.t, ty)
        bytes.append(inout out, sys.lit("t_"))
        ident_into(inout out, resolve.key_text(p.names, d.key))
        if d.args != types.NOTY && types.list_len(p.t, d.args) > 0 {
            out.push(95)
            hex8(inout out, h64(shown))
        }
        return out
    }
    if k == types.T_ARRAY { bytes.append(inout out, sys.lit("ta_")) }
    if k == types.T_TUPLE { bytes.append(inout out, sys.lit("tt_")) }
    if k == types.T_LIST { bytes.append(inout out, sys.lit("tl_")) }
    if k == types.T_MAP { bytes.append(inout out, sys.lit("tm_")) }
    if k == types.T_BOX { bytes.append(inout out, sys.lit("tb_")) }
    if k == types.T_FN { bytes.append(inout out, sys.lit("tf_")) }
    if k == types.T_TASK { bytes.append(inout out, sys.lit("tk_")) }
    if k == types.T_MUTEX { bytes.append(inout out, sys.lit("tx_")) }
    if k == types.T_CHAN { bytes.append(inout out, sys.lit("tc_")) }
    if k == types.T_REF { bytes.append(inout out, sys.lit("tr_")) }
    hex8(inout out, h64(shown))
    out
}

/// Where `.closure<digits>` starts at the end of `s` (a closure body's name), if it does.
fn closure_at(s: List[u8]) -> Option[usize] {
    let mut i = s.len()
    while i > 0 && bytes.is_digit(s[i - 1]) { i -= 1 }
    if i == s.len() || i < 8 { return None }
    let tail = bytes.slice(s, i - 8, i)
    if bytes.eq(tail, sys.lit(".closure")) { return Some(i - 8) }
    None
}

/// The name texts with closure bodies numbered per enclosing function (`main.closure1`,
/// `main.closure2`, ...) instead of by the checker's program-wide counter.
fn renumber(p: P) -> List[List[u8]] {
    let mut out: List[List[u8]] = List.new()
    let mut count: Map[u64, u32] = Map.new()
    let mut byold: Map[u64, u32] = Map.new()
    for i in 0..p.ir.fns.len() {
        let fd = p.ir.fns[i]
        let mut nt = fd.name.copy()
        if !fd.is_test {
            match closure_at(fd.name) {
                Some(at) => {
                    let parent = bytes.slice(fd.name, 0, at)
                    let mut np = parent.copy()
                    match byold.get(h64(parent)) {
                        Some(j) => { np = out[j as usize] }
                        None => {}
                    }
                    let ck = h64(np)
                    let mut n: u32 = 1
                    match count.get(ck) {
                        Some(c) => { n = c + 1 }
                        None => {}
                    }
                    count.insert(ck, n)
                    nt = np
                    bytes.append(inout nt, sys.lit(".closure"))
                    bytes.append(inout nt, bytes.from_u64(n as u64))
                }
                None => {}
            }
            byold.insert(h64(fd.name), i as u32)
        }
        out.push(nt)
    }
    out
}

/// `f_<name>[_<h>]` for a function named `text` (see the top of the file).
fn fn_cname(text: List[u8]) -> List[u8] {
    let mut out = sys.lit("f_")
    let mut depth: u32 = 0
    let mut args = false
    for b in text {
        if b == 91 {
            depth += 1
            args = true
        } else if b == 93 {
            if depth > 0 { depth -= 1 }
        } else if depth == 0 {
            if b == 46 {
                out.push(95)
                out.push(95)
            } else if bytes.is_ident(b) {
                out.push(b)
            } else {
                out.push(95)
            }
        }
    }
    if args {
        out.push(95)
        hex8(inout out, h64(text))
    }
    out
}

/// `x_<name>_<h>` for a test block named `text`.
fn test_cname(text: List[u8]) -> List[u8] {
    let mut out = sys.lit("x_")
    let mut n: usize = 0
    for b in text {
        if n == 24 { break }
        if bytes.is_ident(b) { out.push(b) } else { out.push(95) }
        n += 1
    }
    out.push(95)
    hex8(inout out, h64(text))
    out
}

/// Whether `text` names a generic instance (or a method or closure of one).
fn is_instance(text: List[u8]) -> bool {
    for b in text {
        if b == 91 { return true }
    }
    false
}

/// The module a function belongs to: the `stem` of a leading `stem__name` ("" for the entry
/// module).
fn module_of(text: List[u8]) -> List[u8] {
    let mut i: usize = 0
    while i + 1 < text.len() && bytes.is_ident(text[i]) {
        if i > 0 && text[i] == 95 && text[i + 1] == 95 { return bytes.slice(text, 0, i) }
        i += 1
    }
    List.new()
}

fn ncaptures(p: P, f: u32) -> u32 {
    let fd = p.ir.fns[f as usize]
    let mut n: u32 = 0
    while n < fd.lcount && p.ir.locals[(fd.lstart + n) as usize].kind == ir.L_CAPTURE { n += 1 }
    n
}

/// Names for every type and function, with the clash check.
fn name_all(inout g: G, p: P) {
    for ty in 0..p.t.tys.len() {
        let k = types.kind(p.t, ty as u32)
        let mut n: List[u8] = List.new()
        if is_struct_kind(k) && usable(p, ty as u32) {
            n = type_name(p, ty as u32)
            let from = types.show(p.t, p.names, ty as u32)
            if !register(inout g, n, from) { clash(inout g, n, from) }
        }
        g.tn.push(n)
        g.own.push(0)
    }
    let texts = renumber(p)
    for f in 0..p.ir.fns.len() {
        let fd = p.ir.fns[f]
        let mut n: List[u8] = List.new()
        let mut is_clo = false
        if fd.body > 0 && fd.is_test {
            let base = test_cname(fd.name)
            n = base
            let mut k: u64 = 2
            while !register(inout g, n, fd.name) {
                n = base
                n.push(95)
                bytes.append(inout n, bytes.from_u64(k))
                k += 1
            }
        } else if fd.body > 0 {
            n = fn_cname(texts[f])
            if !register(inout g, n, texts[f]) { clash(inout g, n, texts[f]) }
            let at = closure_at(fd.name)
            is_clo = at.is_some()
        }
        g.fnn.push(n)
        g.clo.push(is_clo)
        g.ncap.push(ncaptures(p, f as u32))
    }
    // `extern "c"` functions (no body): `xc_<name>`, bound to their symbol by extern_protos
    for x in p.ir.externs {
        let name = p.ir.fns[x.f as usize].name
        let mut n = sys.lit("xc_")
        ident_into(inout n, name)
        let mut from = sys.lit("extern ")
        bytes.append(inout from, name)
        if !register(inout g, n, from) { clash(inout g, n, from) }
        g.fnn[x.f as usize] = n
    }
    // a library's entry points `eider_<name>` (export_wrappers)
    for x in p.ir.exports {
        let mut n = sys.lit("eider_")
        ident_into(inout n, x.name)
        let mut from = sys.lit("export ")
        bytes.append(inout from, x.name)
        if !register(inout g, n, from) { clash(inout g, n, from) }
    }
}

// ---- types

fn ty_kind(p: P, ty: u32) -> u32 { types.kind(p.t, ty) }

/// The C spelling of integer kind k's function suffix (usize uses the u64 functions).
fn suffix(k: u32) -> str {
    match k {
        0 => "i32"
        1 => "i64"
        2 => "u8"
        3 => "u32"
        _ => "u64"
    }
}

fn int_cty(k: u32) -> str {
    match k {
        0 => "int32_t"
        1 => "int64_t"
        2 => "uint8_t"
        3 => "uint32_t"
        _ => "uint64_t"
    }
}

fn is_void(p: P, ty: u32) -> bool { ty == types.UNIT || ty == types.NEVER }

fn cty(inout g: G, p: P, ty: u32) {
    let t = types.get(p.t, ty)
    let k = t.kind
    if k == types.T_INT {
        put(inout g, int_cty(t.a))
    } else if k == types.T_BOOL {
        put(inout g, "bool")
    } else if k == types.T_STR {
        put(inout g, "const char *")
    } else if k == types.T_UNIT || k == types.T_NEVER {
        put(inout g, "uint8_t")
    } else if k == types.T_STRING {
        put(inout g, "ei_String")
    } else if k == types.T_INOUT {
        // an `inout` parameter of a fn value: a pointer to the place (docs/compiler.md, "C8.7")
        cty(inout g, p, t.a)
        put(inout g, " *")
    } else {
        let n = g.tn[ty as usize].copy()
        putb(inout g, n)
    }
}

/// The C return type of a function or fn value returning `ty`.
fn ret_cty(inout g: G, p: P, ty: u32) {
    if is_void(p, ty) { put(inout g, "void") } else { cty(inout g, p, ty) }
}

/// Whether values of type `ty` own heap data, memoized.
fn owns(inout g: G, p: P, ty: u32) -> bool {
    let m = g.own[ty as usize]
    if m > 0 { return m == 2 }
    let t = types.get(p.t, ty)
    let k = t.kind
    let mut r = false
    if k == types.T_STRING || k == types.T_LIST || k == types.T_MAP || k == types.T_BOX || k == types.T_FN || types.is_handle(k) || k == types.T_REF {
        r = true
    } else if k == types.T_ARRAY {
        r = owns(inout g, p, t.a)
    } else if k == types.T_TUPLE {
        for x in types.elems(p.t, ty) {
            if owns(inout g, p, x) { r = true }
        }
    } else if k == types.T_RECORD {
        let d = types.def_of(p.t, ty)
        for j in 0..d.len {
            if owns(inout g, p, types.field(p.t, d.start, j).ty) { r = true }
        }
        if shared_rec(p, ty) { r = true }
    } else if k == types.T_ENUM {
        let d = types.def_of(p.t, ty)
        for i in 0..d.len {
            let v = types.variant(p.t, d, i)
            for j in 0..v.flen {
                if owns(inout g, p, types.field(p.t, v.fstart, j).ty) { r = true }
            }
        }
    }
    let v: u8 = if r { 2 } else { 1 }
    g.own[ty as usize] = v
    r
}

pub fn any_payload(p: P, d: types.Def) -> bool {
    for i in 0..d.len {
        if types.variant(p.t, d, i).flen > 0 { return true }
    }
    false
}

/// The indices of Option's `Some` (the variant with a field) and `None`.
pub fn some_idx(p: P, ty: u32) -> u32 {
    let d = types.def_of(p.t, ty)
    for i in 0..d.len {
        if types.variant(p.t, d, i).flen > 0 { return i }
    }
    0
}

pub fn none_idx(p: P, ty: u32) -> u32 {
    let d = types.def_of(p.t, ty)
    for i in 0..d.len {
        if types.variant(p.t, d, i).flen == 0 { return i }
    }
    0
}

/// Define struct type `ty` after the types it contains by value, once.
fn def_ty(inout g: G, p: P, ty: u32, inout done: Map[u32, bool]) {
    if g.tn[ty as usize].len() == 0 || done.contains(ty) { return }
    done.insert(ty, true)
    let t = types.get(p.t, ty)
    let k = t.kind
    if k == types.T_ARRAY {
        def_ty(inout g, p, t.a, inout done)
        put(inout g, "struct ")
        cty(inout g, p, ty)
        put(inout g, " { ")
        cty(inout g, p, t.a)
        put(inout g, " a[")
        // C has no zero-length arrays; a [T; 0] keeps one unused element
        if t.b == 0 { put(inout g, "1") } else { putn(inout g, t.b as u64) }
        put(inout g, "]; };\n")
        return
    }
    if k == types.T_TUPLE {
        let es = types.elems(p.t, ty)
        for e in es { def_ty(inout g, p, e, inout done) }
        put(inout g, "struct ")
        cty(inout g, p, ty)
        put(inout g, " {")
        for i in 0..es.len() {
            put(inout g, " ")
            cty(inout g, p, es[i])
            put(inout g, " f")
            putn(inout g, i as u64)
            put(inout g, ";")
        }
        put(inout g, " };\n")
        return
    }
    if k == types.T_LIST {
        put(inout g, "struct ")
        cty(inout g, p, ty)
        put(inout g, " { ")
        cty(inout g, p, t.a)
        put(inout g, " *d; uint64_t len; uint64_t cap; };\n")
        return
    }
    if k == types.T_MAP {
        put(inout g, "struct ")
        cty(inout g, p, ty)
        put(inout g, " { ")
        cty(inout g, p, t.a)
        put(inout g, " *k; ")
        cty(inout g, p, t.b)
        put(inout g, " *v; uint8_t *s; uint64_t len; uint64_t cap; uint64_t used; };\n")
        return
    }
    if k == types.T_BOX {
        put(inout g, "struct ")
        cty(inout g, p, ty)
        put(inout g, " { ")
        cty(inout g, p, t.a)
        put(inout g, " *p; };\n")
        return
    }
    if types.is_handle(k) || k == types.T_REF {
        // the shared object's struct is defined after every type (handle_bodies)
        put(inout g, "struct ")
        cty(inout g, p, ty)
        put(inout g, " { struct ")
        cty(inout g, p, ty)
        put(inout g, "_c *p; };\n")
        return
    }
    if k == types.T_FN {
        put(inout g, "struct ")
        cty(inout g, p, ty)
        put(inout g, " { void *env; ")
        ret_cty(inout g, p, t.b)
        put(inout g, " (*call)(void *")
        for x in types.elems(p.t, ty) {
            put(inout g, ", ")
            cty(inout g, p, x)
        }
        put(inout g, "); void (*drop)(void *); void *(*clone)(void *); void (*own)(void *); };\n")
        return
    }
    let d = types.def_of(p.t, ty)
    if k == types.T_RECORD {
        for i in 0..d.len { def_ty(inout g, p, types.field(p.t, d.start, i).ty, inout done) }
        put(inout g, "struct ")
        // a record with its own Drop is a pointer to a shared buffer holding its fields
        let shared = shared_rec(p, ty)
        if shared { shared_name(inout g, p, ty) } else { cty(inout g, p, ty) }
        put(inout g, " {")
        if d.len == 0 { put(inout g, " uint8_t unused;") }
        for i in 0..d.len {
            put(inout g, " ")
            cty(inout g, p, types.field(p.t, d.start, i).ty)
            put(inout g, " f")
            putn(inout g, i as u64)
            put(inout g, ";")
        }
        put(inout g, " };\n")
        if shared {
            put(inout g, "struct ")
            cty(inout g, p, ty)
            put(inout g, " { struct ")
            shared_name(inout g, p, ty)
            put(inout g, " *p; };\n")
        }
        return
    }
    for i in 0..d.len {
        let v = types.variant(p.t, d, i)
        for j in 0..v.flen { def_ty(inout g, p, types.field(p.t, v.fstart, j).ty, inout done) }
    }
    put(inout g, "struct ")
    cty(inout g, p, ty)
    put(inout g, " { uint32_t tag;")
    if any_payload(p, d) {
        put(inout g, " union {")
        for i in 0..d.len {
            let v = types.variant(p.t, d, i)
            if v.flen == 0 { continue }
            put(inout g, " struct {")
            for j in 0..v.flen {
                put(inout g, " ")
                cty(inout g, p, types.field(p.t, v.fstart, j).ty)
                put(inout g, " f")
                putn(inout g, j as u64)
                put(inout g, ";")
            }
            put(inout g, " } v")
            putn(inout g, i as u64)
            put(inout g, ";")
        }
        put(inout g, " } u;")
    }
    put(inout g, " };\n")
}

// ---- glue

/// Ask for glue item (kind, id); it is generated once, after the functions.
fn need(inout g: G, kind: u32, id: u32) {
    let key = (kind as u64) * 4294967296 + id as u64
    if g.seen.contains(key) { return }
    g.seen.insert(key, true)
    g.need.push(key)
}

/// The name of glue `op` for type ty, e.g. `drop_tl_1a2b3c4d`.
fn gname(inout g: G, p: P, op: str, ty: u32) {
    put(inout g, op)
    cty(inout g, p, ty)
}

fn txt(a: str, n: u64, b: str) -> List[u8] {
    let mut m = sys.lit(a)
    bytes.append(inout m, bytes.from_u64(n))
    bytes.append(inout m, sys.lit(b))
    m
}

/// `a == b` for C expressions a and b of Eider type ty.
fn eq_expr(inout g: G, p: P, ty: u32, a: List[u8], b: List[u8]) {
    let k = ty_kind(p, ty)
    if k == types.T_STR || k == types.T_STRING {
        put(inout g, "(strcmp(")
        putb(inout g, a)
        if k == types.T_STRING { put(inout g, ".p") }
        put(inout g, ", ")
        putb(inout g, b)
        if k == types.T_STRING { put(inout g, ".p") }
        put(inout g, ") == 0)")
    } else if is_struct_kind(k) {
        need(inout g, GK_EQ, ty)
        gname(inout g, p, "eq_", ty)
        put(inout g, "(")
        putb(inout g, a)
        put(inout g, ", ")
        putb(inout g, b)
        put(inout g, ")")
    } else {
        put(inout g, "(")
        putb(inout g, a)
        put(inout g, " == ")
        putb(inout g, b)
        put(inout g, ")")
    }
}

/// `drop(ptr); ` for a value of type ty at C pointer expression ptr (nothing unless it owns
/// heap data).
fn drop_call(inout g: G, p: P, ty: u32, ptr: List[u8]) {
    if !owns(inout g, p, ty) { return }
    if ty_kind(p, ty) == types.T_STRING {
        put(inout g, "ei_drop_String(")
    } else {
        need(inout g, GK_DROP, ty)
        gname(inout g, p, "drop_", ty)
        put(inout g, "(")
    }
    putb(inout g, ptr)
    put(inout g, "); ")
}

/// A deep copy of the value of type ty at C pointer expression ptr.
fn clone_expr(inout g: G, p: P, ty: u32, ptr: List[u8]) {
    if !owns(inout g, p, ty) {
        put(inout g, "(*")
        putb(inout g, ptr)
        put(inout g, ")")
        return
    }
    if ty_kind(p, ty) == types.T_STRING {
        put(inout g, "ei_share_String(")
    } else {
        need(inout g, GK_CLONE, ty)
        gname(inout g, p, "clone_", ty)
        put(inout g, "(")
    }
    putb(inout g, ptr)
    put(inout g, ")")
}

/// `uniq(ptr)` (no `;`) for the String, List, Map or Box of type ty at C pointer expression
/// ptr: it gets a buffer of its own, copied only when the buffer is shared (copy-on-write),
/// before it is changed. Nothing for other types.
fn uniq_call(inout g: G, p: P, ty: u32, ptr: List[u8]) {
    let k = ty_kind(p, ty)
    if k == types.T_STRING {
        put(inout g, "ei_str_unique(")
    } else if k == types.T_LIST || k == types.T_MAP || k == types.T_BOX || shared_rec(p, ty) {
        need(inout g, GK_UNIQ, ty)
        gname(inout g, p, "uniq_", ty)
        put(inout g, "(")
    } else {
        return
    }
    putb(inout g, ptr)
    put(inout g, ")")
}

/// `own(ptr); ` for a value of type ty at C pointer expression ptr that is about to be seen
/// by another thread: every buffer it reaches becomes its own (counts are not atomic, so no
/// buffer may be shared across threads). Handles (Task, Mutex, Chan) are shared on purpose
/// and synchronise themselves, so nothing is done inside them.
fn own_call(inout g: G, p: P, ty: u32, ptr: List[u8]) {
    if !owns(inout g, p, ty) || types.is_handle(ty_kind(p, ty)) { return }
    if ty_kind(p, ty) == types.T_STRING {
        put(inout g, "ei_str_unique(")
    } else {
        need(inout g, GK_OWN, ty)
        gname(inout g, p, "own_", ty)
        put(inout g, "(")
    }
    putb(inout g, ptr)
    put(inout g, "); ")
}

/// The hash of Map key expression v of type kty (hash_text).
fn hash_expr(inout g: G, p: P, kty: u32, v: str) { hash_text(inout g, p, kty, sys.lit(v)) }

/// Copy the signature written since `mark` into the prototypes.
fn proto(inout g: G, mark: usize) {
    let s = bytes.slice(g.o, mark, g.o.len())
    bytes.append(inout g.pr, s)
    g.pr.push(59)
    g.pr.push(10)
}

fn glue(inout g: G, p: P, key: u64) {
    let kind = (key / 4294967296) as u32
    let id = (key % 4294967296) as u32
    if kind == GK_EQ {
        eq_glue(inout g, p, id)
    } else if kind == GK_DROP {
        drop_glue(inout g, p, id)
    } else if kind == GK_CLONE {
        clone_glue(inout g, p, id)
    } else if kind == GK_NAME {
        name_glue(inout g, p, id)
    } else if kind == GK_PUSH || kind == GK_HAS {
        list_glue(inout g, p, kind, id)
    } else if kind == GK_NEW {
        box_glue(inout g, p, id)
    } else if kind == GK_ENV {
        env_glue(inout g, p, id)
    } else if kind == GK_THUNK {
        thunk_glue(inout g, p, id)
    } else if kind == GK_UNIQ {
        uniq_glue(inout g, p, id)
    } else if kind == GK_OWN {
        own_glue(inout g, p, id)
    } else if kind == GK_BYTES || kind == GK_UTF8 {
        text_glue(inout g, p, kind, id)
    } else if kind == GK_REFNEW {
        ref_new_glue(inout g, p, id)
    } else if kind == GK_DEFAULT {
        default_glue(inout g, p, id)
    } else if kind >= GK_CMP {
        trait_glue(inout g, p, kind, id)
    } else if kind >= GK_SPAWN {
        thread_glue(inout g, p, kind, id)
    } else {
        map_glue(inout g, p, kind, id)
    }
}

/// Structural equality: `static bool eq_T(T a, T b)`.
fn eq_glue(inout g: G, p: P, ty: u32) {
    let mark = g.o.len()
    put(inout g, "static bool ")
    gname(inout g, p, "eq_", ty)
    put(inout g, "(")
    cty(inout g, p, ty)
    put(inout g, " a, ")
    cty(inout g, p, ty)
    put(inout g, " b)")
    proto(inout g, mark)
    put(inout g, " {\n")
    if custom_call(inout g, p, TR_EQ, ty, "(a, b)") { return }
    let t = types.get(p.t, ty)
    let k = t.kind
    if k == types.T_MAP {
        // the same keys, each with an equal value (slot order is not part of the value)
        need(inout g, GK_FIND, ty)
        put(inout g, "  if (a.len != b.len) return false;\n  for (uint64_t i = 0; i < a.cap; i++) if (a.s[i] == 1) {\n    int64_t f = ")
        gname(inout g, p, "find_", ty)
        put(inout g, "(&b, a.k[i]);\n    if (f < 0 || !")
        eq_expr(inout g, p, t.b, sys.lit("a.v[i]"), sys.lit("b.v[f]"))
        put(inout g, ") return false;\n  }\n  return true;\n}\n")
        return
    }
    if k == types.T_ARRAY {
        if t.b == 0 {
            put(inout g, "  return true;\n}\n")
            return
        }
        put(inout g, "  for (uint64_t i = 0; i < ")
        putn(inout g, t.b as u64)
        put(inout g, "; i++) if (!")
        eq_expr(inout g, p, t.a, sys.lit("a.a[i]"), sys.lit("b.a[i]"))
        put(inout g, ") return false;\n  return true;\n}\n")
        return
    }
    if k == types.T_LIST {
        put(inout g, "  if (a.len != b.len) return false;\n  for (uint64_t i = 0; i < a.len; i++) if (!")
        eq_expr(inout g, p, t.a, sys.lit("a.d[i]"), sys.lit("b.d[i]"))
        put(inout g, ") return false;\n  return true;\n}\n")
        return
    }
    if k == types.T_BOX {
        put(inout g, "  return ")
        eq_expr(inout g, p, t.a, sys.lit("(*a.p)"), sys.lit("(*b.p)"))
        put(inout g, ";\n}\n")
        return
    }
    if k == types.T_TUPLE {
        put(inout g, "  return true")
        let es = types.elems(p.t, ty)
        for i in 0..es.len() {
            put(inout g, " && ")
            eq_expr(inout g, p, es[i], txt("a.f", i as u64, ""), txt("b.f", i as u64, ""))
        }
        put(inout g, ";\n}\n")
        return
    }
    if k != types.T_RECORD && k != types.T_ENUM {
        // Map and fn values have no `==` (the checker rejects it)
        put(inout g, "  return true;\n}\n")
        return
    }
    let d = types.def_of(p.t, ty)
    if k == types.T_RECORD {
        put(inout g, "  return true")
        for i in 0..d.len {
            put(inout g, " && ")
            eq_expr(inout g, p, types.field(p.t, d.start, i).ty, rf(p, ty, "a", i), rf(p, ty, "b", i))
        }
        put(inout g, ";\n}\n")
        return
    }
    put(inout g, "  if (a.tag != b.tag) return false;\n")
    for i in 0..d.len {
        let v = types.variant(p.t, d, i)
        if v.flen == 0 { continue }
        put(inout g, "  if (a.tag == ")
        putn(inout g, i as u64)
        put(inout g, ") return true")
        for j in 0..v.flen {
            let mut x = txt("a.u.v", i as u64, ".f")
            bytes.append(inout x, bytes.from_u64(j as u64))
            let mut y = txt("b.u.v", i as u64, ".f")
            bytes.append(inout y, bytes.from_u64(j as u64))
            put(inout g, " && ")
            eq_expr(inout g, p, types.field(p.t, v.fstart, j).ty, x, y)
        }
        put(inout g, ";\n")
    }
    put(inout g, "  return true;\n}\n")
}

/// `static void drop_T(T *x)`: frees what x owns and leaves it empty.
fn drop_glue(inout g: G, p: P, ty: u32) {
    let mark = g.o.len()
    put(inout g, "static void ")
    gname(inout g, p, "drop_", ty)
    put(inout g, "(")
    cty(inout g, p, ty)
    put(inout g, " *x)")
    proto(inout g, mark)
    put(inout g, " {\n  ")
    let t = types.get(p.t, ty)
    let k = t.kind
    if k == types.T_RECORD && shared_rec(p, ty) {
        // its own drop runs once, when the last holder goes, before the fields are dropped
        // (in order); a holder that drop gives the value to keeps it alive
        let d = types.def_of(p.t, ty)
        put(inout g, "if (!x->p) return;\n  if (ei_buf_count(x->p) == 1) ")
        if g.prof > 0 { put(inout g, "{ ei_prof_ev(EI_PEV_DROP, sizeof *x->p); ") }
        fn_name(inout g, p, custom_fn(p, TR_DROP, ty))
        put(inout g, "(x);")
        if g.prof > 0 { put(inout g, " }") }
        put(inout g, "\n  if (ei_buf_dec(x->p)) {\n    ")
        for i in 0..d.len { drop_call(inout g, p, types.field(p.t, d.start, i).ty, rfp(p, ty, i)) }
        put(inout g, "ei_buf_free(x->p);\n  }\n  x->p = NULL;")
    } else if k == types.T_RECORD {
        let d = types.def_of(p.t, ty)
        for i in 0..d.len { drop_call(inout g, p, types.field(p.t, d.start, i).ty, txt("&x->f", i as u64, "")) }
    } else if k == types.T_TUPLE {
        let es = types.elems(p.t, ty)
        for i in 0..es.len() { drop_call(inout g, p, es[i], txt("&x->f", i as u64, "")) }
    } else if k == types.T_ENUM {
        let d = types.def_of(p.t, ty)
        put(inout g, "switch (x->tag) { ")
        for i in 0..d.len {
            let v = types.variant(p.t, d, i)
            let mut any = false
            for j in 0..v.flen {
                if owns(inout g, p, types.field(p.t, v.fstart, j).ty) { any = true }
            }
            if !any { continue }
            put(inout g, "case ")
            putn(inout g, i as u64)
            put(inout g, ": ")
            for j in 0..v.flen {
                let mut x = txt("&x->u.v", i as u64, ".f")
                bytes.append(inout x, bytes.from_u64(j as u64))
                drop_call(inout g, p, types.field(p.t, v.fstart, j).ty, x)
            }
            put(inout g, "break; ")
        }
        put(inout g, "default: break; }")
    } else if k == types.T_ARRAY {
        if t.b > 0 {
            put(inout g, "for (uint64_t i = 0; i < ")
            putn(inout g, t.b as u64)
            put(inout g, "; i++) { ")
            drop_call(inout g, p, t.a, sys.lit("&x->a[i]"))
            put(inout g, "}")
        }
    } else if k == types.T_LIST {
        // the last holder of the shared buffer drops the elements, once
        put(inout g, "if (ei_buf_dec(x->d)) {\n    ")
        if owns(inout g, p, t.a) {
            put(inout g, "for (uint64_t i = 0; i < x->len; i++) { ")
            drop_call(inout g, p, t.a, sys.lit("&x->d[i]"))
            put(inout g, "}\n    ")
        }
        put(inout g, "ei_buf_free(x->d);\n  }\n  x->d = NULL; x->len = 0; x->cap = 0;")
    } else if k == types.T_MAP {
        // the count is on the slot states `s`; k and v go with it
        put(inout g, "if (ei_buf_dec(x->s)) {\n    ")
        if owns(inout g, p, t.a) || owns(inout g, p, t.b) {
            put(inout g, "for (uint64_t i = 0; i < x->cap; i++) if (x->s[i] == 1) { ")
            drop_call(inout g, p, t.a, sys.lit("&x->k[i]"))
            drop_call(inout g, p, t.b, sys.lit("&x->v[i]"))
            put(inout g, "}\n    ")
        }
        put(inout g, "ei_free(x->k); ei_free(x->v); ei_buf_free(x->s);\n  }\n  x->k = NULL; x->v = NULL; x->s = NULL; x->len = 0; x->cap = 0; x->used = 0;")
    } else if k == types.T_BOX {
        put(inout g, "if (ei_buf_dec(x->p)) {\n    ")
        drop_call(inout g, p, t.a, sys.lit("x->p"))
        put(inout g, "ei_buf_free(x->p);\n  }\n  x->p = NULL;")
    } else if k == types.T_FN {
        put(inout g, "if (x->drop) { x->drop(x->env); }\n  x->env = NULL; x->drop = NULL; x->clone = NULL; x->own = NULL;")
    } else if k == types.T_REF {
        // the last holder drops the value, once
        put(inout g, "if (ei_buf_dec(x->p)) {\n    ")
        drop_call(inout g, p, t.a, sys.lit("&x->p->v"))
        put(inout g, "ei_buf_free(x->p);\n  }\n  x->p = NULL;")
    } else if types.is_handle(k) {
        handle_drop(inout g, p, ty)
    }
    put(inout g, "\n}\n")
}

/// `static T clone_T(const T *x)`: a copy. Lists, Maps, Boxes and Strings share their buffer
/// (copy-on-write), so this copies no heap data: it counts one more holder of each buffer.
fn clone_glue(inout g: G, p: P, ty: u32) {
    let mark = g.o.len()
    put(inout g, "static ")
    cty(inout g, p, ty)
    put(inout g, " ")
    gname(inout g, p, "clone_", ty)
    put(inout g, "(const ")
    cty(inout g, p, ty)
    put(inout g, " *x)")
    proto(inout g, mark)
    put(inout g, " {\n  ")
    cty(inout g, p, ty)
    put(inout g, " r = *x;\n  ")
    let t = types.get(p.t, ty)
    let k = t.kind
    if k == types.T_RECORD && shared_rec(p, ty) {
        // a record with its own Drop: the copy shares the buffer
        put(inout g, "ei_buf_inc(r.p);")
    } else if k == types.T_RECORD {
        let d = types.def_of(p.t, ty)
        for i in 0..d.len {
            let ft = types.field(p.t, d.start, i).ty
            if !owns(inout g, p, ft) { continue }
            put(inout g, "r.f")
            putn(inout g, i as u64)
            put(inout g, " = ")
            clone_expr(inout g, p, ft, txt("&x->f", i as u64, ""))
            put(inout g, "; ")
        }
    } else if k == types.T_TUPLE {
        let es = types.elems(p.t, ty)
        for i in 0..es.len() {
            if !owns(inout g, p, es[i]) { continue }
            put(inout g, "r.f")
            putn(inout g, i as u64)
            put(inout g, " = ")
            clone_expr(inout g, p, es[i], txt("&x->f", i as u64, ""))
            put(inout g, "; ")
        }
    } else if k == types.T_ENUM {
        let d = types.def_of(p.t, ty)
        put(inout g, "switch (x->tag) { ")
        for i in 0..d.len {
            let v = types.variant(p.t, d, i)
            let mut any = false
            for j in 0..v.flen {
                if owns(inout g, p, types.field(p.t, v.fstart, j).ty) { any = true }
            }
            if !any { continue }
            put(inout g, "case ")
            putn(inout g, i as u64)
            put(inout g, ": ")
            for j in 0..v.flen {
                let ft = types.field(p.t, v.fstart, j).ty
                if !owns(inout g, p, ft) { continue }
                let mut lhs = txt("r.u.v", i as u64, ".f")
                bytes.append(inout lhs, bytes.from_u64(j as u64))
                let mut x = txt("&x->u.v", i as u64, ".f")
                bytes.append(inout x, bytes.from_u64(j as u64))
                putb(inout g, lhs)
                put(inout g, " = ")
                clone_expr(inout g, p, ft, x)
                put(inout g, "; ")
            }
            put(inout g, "break; ")
        }
        put(inout g, "default: break; }")
    } else if k == types.T_ARRAY {
        if t.b > 0 {
            put(inout g, "for (uint64_t i = 0; i < ")
            putn(inout g, t.b as u64)
            put(inout g, "; i++) r.a[i] = ")
            clone_expr(inout g, p, t.a, sys.lit("&x->a[i]"))
            put(inout g, ";")
        }
    } else if k == types.T_LIST {
        // copy-on-write: the copy shares the buffer
        put(inout g, "ei_buf_inc(r.d);")
    } else if k == types.T_MAP {
        put(inout g, "ei_buf_inc(r.s);")
    } else if k == types.T_BOX {
        put(inout g, "ei_buf_inc(r.p);")
    } else if k == types.T_FN {
        put(inout g, "if (x->clone) { r.env = x->clone(x->env); }")
    } else if k == types.T_REF {
        // shares the cell (a count that isn't atomic: a Ref stays on its thread)
        put(inout g, "ei_buf_inc(r.p);")
    } else if types.is_handle(k) {
        // shares the object
        put(inout g, "if (r.p) ei_rc_inc(&r.p->rc);")
    }
    put(inout g, "\n  return r;\n}\n")
}

/// `static void uniq_T(T *x)` for a List, Map or Box: when x's buffer is shared, x gets a
/// copy (of the elements: each is a copy, so it shares its own buffers in turn) and lets go
/// of the shared one, which stays with its other holders.
fn uniq_glue(inout g: G, p: P, ty: u32) {
    let mark = g.o.len()
    put(inout g, "static void ")
    gname(inout g, p, "uniq_", ty)
    put(inout g, "(")
    cty(inout g, p, ty)
    put(inout g, " *x)")
    proto(inout g, mark)
    let t = types.get(p.t, ty)
    let k = t.kind
    if k == types.T_RECORD {
        // a record with its own Drop: a copy through its own Copy, else of its fields as any
        // copy makes them (both values are dropped, each once)
        put(inout g, " {\n  if (!ei_buf_shared(x->p)) return;\n  ")
        prof_ev(inout g, "EI_PEV_COW", "sizeof *x->p")
        cty(inout g, p, ty)
        let f = custom_fn(p, TR_COPY, ty)
        if f != NONE {
            put(inout g, " n = ")
            fn_name(inout g, p, f)
            put(inout g, "(*x);\n  ")
        } else {
            put(inout g, " n;\n  n.p = ei_buf_alloc(1, sizeof *n.p);\n  *n.p = *x->p;\n  ")
            let d = types.def_of(p.t, ty)
            for i in 0..d.len {
                let ft = types.field(p.t, d.start, i).ty
                if !owns(inout g, p, ft) { continue }
                put(inout g, "n.p->f")
                putn(inout g, i as u64)
                put(inout g, " = ")
                clone_expr(inout g, p, ft, txt("&x->p->f", i as u64, ""))
                put(inout g, ";\n  ")
            }
        }
        put(inout g, "(void)ei_buf_dec(x->p);\n  *x = n;\n}\n")
        return
    }
    need(inout g, GK_DROP, ty)
    if k == types.T_LIST {
        put(inout g, " {\n  if (!ei_buf_shared(x->d)) return;\n  ")
        prof_ev(inout g, "EI_PEV_COW", "x->cap * sizeof *x->d")
        cty(inout g, p, ty)
        put(inout g, " old = *x;\n  x->d = ei_buf_alloc(x->cap, sizeof *x->d);\n  ")
        if owns(inout g, p, t.a) {
            put(inout g, "for (uint64_t i = 0; i < x->len; i++) x->d[i] = ")
            clone_expr(inout g, p, t.a, sys.lit("&old.d[i]"))
            put(inout g, ";\n  ")
        } else {
            put(inout g, "if (x->len) memcpy(x->d, old.d, (size_t)x->len * sizeof *x->d);\n  ")
        }
    } else if k == types.T_MAP {
        put(inout g, " {\n  if (!ei_buf_shared(x->s)) return;\n  ")
        prof_ev(inout g, "EI_PEV_COW", "x->cap * (sizeof *x->k + sizeof *x->v + 1)")
        cty(inout g, p, ty)
        put(inout g, " old = *x;\n  x->k = ei_alloc_n(x->cap, sizeof *x->k);\n  x->v = ei_alloc_n(x->cap, sizeof *x->v);\n  x->s = ei_buf_alloc(x->cap, 1);\n  for (uint64_t i = 0; i < x->cap; i++) {\n    x->s[i] = old.s[i];\n    if (old.s[i] == 1) { x->k[i] = ")
        clone_expr(inout g, p, t.a, sys.lit("&old.k[i]"))
        put(inout g, "; x->v[i] = ")
        clone_expr(inout g, p, t.b, sys.lit("&old.v[i]"))
        put(inout g, "; }\n  }\n  ")
    } else {
        put(inout g, " {\n  if (!ei_buf_shared(x->p)) return;\n  ")
        prof_ev(inout g, "EI_PEV_COW", "sizeof *x->p")
        cty(inout g, p, ty)
        put(inout g, " old = *x;\n  x->p = ei_buf_alloc(1, sizeof *x->p);\n  *x->p = ")
        clone_expr(inout g, p, t.a, sys.lit("old.p"))
        put(inout g, ";\n  ")
    }
    // one holder fewer of the shared buffer (never the last: it was shared)
    gname(inout g, p, "drop_", ty)
    put(inout g, "(&old);\n}\n")
}

/// `static void own_T(T *x)`: every buffer x reaches becomes its own (B_SPAWN's closure,
/// values going into a Mutex or a channel, and the copies Mutex.get and Task.join hand out),
/// so no buffer is reachable from two threads.
fn own_glue(inout g: G, p: P, ty: u32) {
    let mark = g.o.len()
    put(inout g, "static void ")
    gname(inout g, p, "own_", ty)
    put(inout g, "(")
    cty(inout g, p, ty)
    put(inout g, " *x)")
    proto(inout g, mark)
    put(inout g, " {\n  (void)x;\n  ")
    let t = types.get(p.t, ty)
    let k = t.kind
    if k == types.T_RECORD && shared_rec(p, ty) {
        uniq_call(inout g, p, ty, sys.lit("x"))
        put(inout g, ";\n  ")
        let d = types.def_of(p.t, ty)
        for i in 0..d.len { own_call(inout g, p, types.field(p.t, d.start, i).ty, rfp(p, ty, i)) }
    } else if k == types.T_RECORD {
        let d = types.def_of(p.t, ty)
        for i in 0..d.len { own_call(inout g, p, types.field(p.t, d.start, i).ty, txt("&x->f", i as u64, "")) }
    } else if k == types.T_TUPLE {
        let es = types.elems(p.t, ty)
        for i in 0..es.len() { own_call(inout g, p, es[i], txt("&x->f", i as u64, "")) }
    } else if k == types.T_ENUM {
        let d = types.def_of(p.t, ty)
        put(inout g, "switch (x->tag) { ")
        for i in 0..d.len {
            let v = types.variant(p.t, d, i)
            put(inout g, "case ")
            putn(inout g, i as u64)
            put(inout g, ": ")
            for j in 0..v.flen {
                let mut x = txt("&x->u.v", i as u64, ".f")
                bytes.append(inout x, bytes.from_u64(j as u64))
                own_call(inout g, p, types.field(p.t, v.fstart, j).ty, x)
            }
            put(inout g, "break; ")
        }
        put(inout g, "default: break; }")
    } else if k == types.T_ARRAY {
        if t.b > 0 {
            put(inout g, "for (uint64_t i = 0; i < ")
            putn(inout g, t.b as u64)
            put(inout g, "; i++) { ")
            own_call(inout g, p, t.a, sys.lit("&x->a[i]"))
            put(inout g, "}")
        }
    } else if k == types.T_LIST {
        uniq_call(inout g, p, ty, sys.lit("x"))
        put(inout g, ";")
        if owns(inout g, p, t.a) {
            put(inout g, "\n  for (uint64_t i = 0; i < x->len; i++) { ")
            own_call(inout g, p, t.a, sys.lit("&x->d[i]"))
            put(inout g, "}")
        }
    } else if k == types.T_MAP {
        uniq_call(inout g, p, ty, sys.lit("x"))
        put(inout g, ";")
        if owns(inout g, p, t.a) || owns(inout g, p, t.b) {
            put(inout g, "\n  for (uint64_t i = 0; i < x->cap; i++) if (x->s[i] == 1) { ")
            own_call(inout g, p, t.a, sys.lit("&x->k[i]"))
            own_call(inout g, p, t.b, sys.lit("&x->v[i]"))
            put(inout g, "}")
        }
    } else if k == types.T_BOX {
        uniq_call(inout g, p, ty, sys.lit("x"))
        put(inout g, ";")
        if owns(inout g, p, t.a) {
            put(inout g, "\n  if (x->p) { ")
            own_call(inout g, p, t.a, sys.lit("x->p"))
            put(inout g, "}")
        }
    } else if k == types.T_FN {
        put(inout g, "if (x->own) { x->own(x->env); }")
    } else if k == types.T_REF {
        // the checker keeps every Ref it can see on its thread (E0411); this catches one
        // inside a closure's environment, which no type shows
        put(inout g, "if (x->p) ei_trap(\"a Ref can't be sent to another thread\", 0);")
    }
    put(inout g, "\n}\n")
}

/// Variant names, for `print` (the variant's mangled name is printed, as tests/oracle expects).
/// A type or variant name as printing (derived Show) spells it: as written in its own module,
/// without the module's prefix (`TimedOut`, not `stream__TimedOut`; docs/compiler.md, "C8.16").
fn shown_name(p: P, key: u64) -> List[u8] { intern.name(p.names, resolve.key_sym(key)) }

fn name_glue(inout g: G, p: P, ty: u32) {
    let mark = g.o.len()
    put(inout g, "static const char *")
    gname(inout g, p, "name_", ty)
    put(inout g, "(uint32_t tag)")
    proto(inout g, mark)
    put(inout g, " {\n  static const char *const n[] = {")
    let d = types.def_of(p.t, ty)
    for i in 0..d.len {
        if i > 0 { put(inout g, ",") }
        put(inout g, " ")
        str_lit(inout g.o, shown_name(p, types.variant(p.t, d, i).key))
    }
    put(inout g, " };\n  return n[tag];\n}\n")
}

// ---- operation traits (docs/compiler.md, "C8.4: operation traits")
//
// `==` (eq_), Map keys (hash_ and eq_), `<` and `compare` (cmp_), printing and text (show_),
// `.copy()` (copy_) and cleanup (drop_) are glue per type, derived from the type's parts,
// except for a type with its own impl of the trait (ir.Ir.impls), whose glue calls that
// function: so a derived operation of a List of such a type uses it too. Integers, bool, str
// and String are written inline (and so, unchanged, are everything `==`, Map keys and
// `print` did before). A record with its own Drop is a pointer to a shared buffer holding
// its fields (`td_<name>`): copies share it, a write to a shared one first makes a copy
// through the type's Copy (uniq_), and its drop runs when the last holder goes.

/// The function implementing trait tr's method for type ty, or NONE (derived).
pub fn custom_fn(p: P, tr: u32, ty: u32) -> u32 {
    match p.ir.impls.get((tr as u64) * 4294967296 + ty as u64) {
        Some(f) => f
        None => NONE
    }
}

/// Whether ty is a record with its own Drop.
pub fn shared_rec(p: P, ty: u32) -> bool { ty_kind(p, ty) == types.T_RECORD && custom_fn(p, TR_DROP, ty) != NONE }

/// The struct name of a shared record's buffer: `td_<name>`.
fn shared_name(inout g: G, p: P, ty: u32) {
    let n = g.tn[ty as usize].copy()
    put(inout g, "td_")
    putb(inout g, bytes.slice(n, 2, n.len()))
}

/// Field i of record value `base` (C text) of type ty: `base.f<i>`, or `base.p->f<i>`.
fn rf(p: P, ty: u32, base: str, i: u32) -> List[u8] {
    let mut out = sys.lit(base)
    if shared_rec(p, ty) { bytes.append(inout out, sys.lit(".p->f")) } else { bytes.append(inout out, sys.lit(".f")) }
    bytes.append(inout out, bytes.from_u64(i as u64))
    out
}

/// A pointer to field i of the shared record at pointer `x`: `&x->p->f<i>`.
fn rfp(p: P, ty: u32, i: u32) -> List[u8] {
    if shared_rec(p, ty) { return txt("&x->p->f", i as u64, "") }
    txt("&x->f", i as u64, "")
}

/// When ty has its own impl of tr, the glue body `  return <f><args>;` (true).
fn custom_call(inout g: G, p: P, tr: u32, ty: u32, args: str) -> bool {
    let f = custom_fn(p, tr, ty)
    if f == NONE { return false }
    put(inout g, "  return ")
    if tr == TR_ORD { put(inout g, "(int)") }
    fn_name(inout g, p, f)
    put(inout g, args)
    if tr == TR_ORD { put(inout g, ".tag - 1") }
    put(inout g, ";\n}\n")
    true
}

/// The order of C expressions a and b of type ty as an int whose sign is the order.
fn cmp_expr(inout g: G, p: P, ty: u32, a: List[u8], b: List[u8]) {
    let k = ty_kind(p, ty)
    if k == types.T_STR || k == types.T_STRING {
        put(inout g, "strcmp(")
        putb(inout g, a)
        if k == types.T_STRING { put(inout g, ".p") }
        put(inout g, ", ")
        putb(inout g, b)
        if k == types.T_STRING { put(inout g, ".p") }
        put(inout g, ")")
    } else if is_struct_kind(k) {
        need(inout g, GK_CMP, ty)
        gname(inout g, p, "cmp_", ty)
        put(inout g, "(")
        putb(inout g, a)
        put(inout g, ", ")
        putb(inout g, b)
        put(inout g, ")")
    } else {
        put(inout g, "((")
        putb(inout g, a)
        put(inout g, " > ")
        putb(inout g, b)
        put(inout g, ") - (")
        putb(inout g, a)
        put(inout g, " < ")
        putb(inout g, b)
        put(inout g, "))")
    }
}

/// `{ int r = <a vs b>; if (r) return r < 0 ? -1 : 1; }`: one part of a lexicographic order.
fn cmp_part(inout g: G, p: P, ty: u32, a: List[u8], b: List[u8]) {
    put(inout g, "  { int r = ")
    cmp_expr(inout g, p, ty, a, b)
    put(inout g, "; if (r) return r < 0 ? -1 : 1; }\n")
}

/// The hash of C expression v of type ty (integers, bool, str and String as Map keys always
/// hashed them).
fn hash_text(inout g: G, p: P, ty: u32, v: List[u8]) {
    let k = ty_kind(p, ty)
    if k == types.T_STRING {
        put(inout g, "ei_hash_str((")
        putb(inout g, v)
        put(inout g, ").p)")
    } else if k == types.T_STR {
        put(inout g, "ei_hash_str(")
        putb(inout g, v)
        put(inout g, ")")
    } else if is_struct_kind(k) {
        need(inout g, GK_HASH, ty)
        gname(inout g, p, "hash_", ty)
        put(inout g, "(")
        putb(inout g, v)
        put(inout g, ")")
    } else {
        put(inout g, "ei_hash_u64((uint64_t)(")
        putb(inout g, v)
        put(inout g, "))")
    }
}

/// `h = ei_hash_u64(h ^ <hash of v>); `
fn hash_part(inout g: G, p: P, ty: u32, v: List[u8]) {
    put(inout g, "h = ei_hash_u64(h ^ ")
    hash_text(inout g, p, ty, v)
    put(inout g, "); ")
}

/// Whether ty is shown by print's own code (an integer, bool, str, String, or an enum
/// without payloads that doesn't have its own Show): what `print` showed before C8.4.
pub fn plain_show(p: P, ty: u32) -> bool {
    let k = ty_kind(p, ty)
    if k == types.T_INT || k == types.T_BOOL || k == types.T_STR || k == types.T_STRING { return true }
    k == types.T_ENUM && !types.def_of(p.t, ty).payload && custom_fn(p, TR_SHOW, ty) == NONE
}

/// The statement (without `;`) appending the text of C expression v of type ty to the
/// String at pointer o. `quoted`: text inside another value is quoted.
fn show_into(inout g: G, p: P, ty: u32, o: List[u8], v: List[u8], quoted: bool) {
    let t = types.get(p.t, ty)
    let k = t.kind
    if k == types.T_UNIT {
        put(inout g, "ei_str_push(")
        putb(inout g, o)
        put(inout g, ", \"()\")")
    } else if k == types.T_INT {
        need(inout g, GK_SHOWN, 0)
        if types.signed(t.a) { put(inout g, "showi_(") } else { put(inout g, "showu_(") }
        putb(inout g, o)
        if types.signed(t.a) { put(inout g, ", (int64_t)(") } else { put(inout g, ", (uint64_t)(") }
        putb(inout g, v)
        put(inout g, "))")
    } else if k == types.T_BOOL {
        put(inout g, "ei_str_push(")
        putb(inout g, o)
        put(inout g, ", (")
        putb(inout g, v)
        put(inout g, ") ? \"true\" : \"false\")")
    } else if (k == types.T_STR || k == types.T_STRING) && quoted {
        need(inout g, GK_SHOWQ, 0)
        put(inout g, "showq_(")
        putb(inout g, o)
        put(inout g, ", ")
        putb(inout g, v)
        if k == types.T_STRING { put(inout g, ".p") }
        put(inout g, ")")
    } else if k == types.T_STR {
        put(inout g, "ei_str_push(")
        putb(inout g, o)
        put(inout g, ", ")
        putb(inout g, v)
        put(inout g, ")")
    } else if k == types.T_STRING {
        put(inout g, "ei_str_cat(")
        putb(inout g, o)
        put(inout g, ", (")
        putb(inout g, v)
        put(inout g, ").p, (")
        putb(inout g, v)
        put(inout g, ").len)")
    } else if plain_show(p, ty) {
        need(inout g, GK_NAME, ty)
        put(inout g, "ei_str_push(")
        putb(inout g, o)
        put(inout g, ", ")
        gname(inout g, p, "name_", ty)
        put(inout g, "((")
        putb(inout g, v)
        put(inout g, ").tag))")
    } else {
        need(inout g, GK_SHOW, ty)
        gname(inout g, p, "show_", ty)
        put(inout g, "(")
        putb(inout g, o)
        put(inout g, ", ")
        putb(inout g, v)
        put(inout g, ")")
    }
}

/// `ei_str_push(o, "<text>"); `
fn show_lit(inout g: G, text: List[u8]) {
    put(inout g, "ei_str_push(o, ")
    str_lit(inout g.o, text)
    put(inout g, "); ")
}

/// Whether `.copy()` of ty is more than a clone: something inside is a Mutex (a copy gets a
/// new one), has its own Copy, or is a record with its own Drop (a copy gets its own buffer).
pub fn deep(p: P, ty: u32, inout seen: Map[u32, bool]) -> bool {
    if seen.contains(ty) { return false }
    seen.insert(ty, true)
    let t = types.get(p.t, ty)
    let k = t.kind
    if k == types.T_MUTEX || k == types.T_REF || custom_fn(p, TR_COPY, ty) != NONE || shared_rec(p, ty) { return true }
    if k == types.T_ARRAY || k == types.T_LIST || k == types.T_BOX { return deep(p, t.a, inout seen) }
    if k == types.T_MAP { return deep(p, t.a, inout seen) || deep(p, t.b, inout seen) }
    if k == types.T_TUPLE {
        for x in types.elems(p.t, ty) {
            if deep(p, x, inout seen) { return true }
        }
        return false
    }
    if k == types.T_RECORD || k == types.T_ENUM {
        let d = types.def_of(p.t, ty)
        if d.is_enum {
            for i in 0..d.len {
                let v = types.variant(p.t, d, i)
                for j in 0..v.flen {
                    if deep(p, types.field(p.t, v.fstart, j).ty, inout seen) { return true }
                }
            }
            return false
        }
        for j in 0..d.len {
            if deep(p, types.field(p.t, d.start, j).ty, inout seen) { return true }
        }
    }
    false
}

/// `x.copy()` of the value of type ty at C pointer expression ptr: a clone, or copy_T.
fn copy_expr(inout g: G, p: P, ty: u32, ptr: List[u8]) {
    let mut seen: Map[u32, bool] = Map.new()
    if !deep(p, ty, inout seen) {
        clone_expr(inout g, p, ty, ptr)
        return
    }
    need(inout g, GK_COPY, ty)
    gname(inout g, p, "copy_", ty)
    put(inout g, "(")
    putb(inout g, ptr)
    put(inout g, ")")
}

/// `r.<lhs> = copy of x-><lhs>; ` for a part of type ty (nothing for a part that owns nothing:
/// `r = *x` copied it).
fn copy_part(inout g: G, p: P, ty: u32, lhs: List[u8], src: List[u8]) {
    if !owns(inout g, p, ty) { return }
    putb(inout g, lhs)
    put(inout g, " = ")
    copy_expr(inout g, p, ty, src)
    put(inout g, "; ")
}

fn trait_glue(inout g: G, p: P, kind: u32, ty: u32) {
    let mark = g.o.len()
    if kind == GK_SHOWQ {
        put(inout g, "static void showq_(ei_String *o, const char *s)")
        proto(inout g, mark)
        put(inout g, " {\n  char e[2];\n  e[0] = 34; ei_str_cat(o, e, 1);\n  for (; *s; s++) {\n    unsigned char ch = (unsigned char)*s;\n    e[0] = 92;\n    if (ch == 34 || ch == 92) { e[1] = (char)ch; ei_str_cat(o, e, 2); }\n    else if (ch == 10) { e[1] = 110; ei_str_cat(o, e, 2); }\n    else if (ch == 9) { e[1] = 116; ei_str_cat(o, e, 2); }\n    else if (ch == 13) { e[1] = 114; ei_str_cat(o, e, 2); }\n    else ei_str_cat(o, s, 1);\n  }\n  e[0] = 34; ei_str_cat(o, e, 1);\n}\n")
        return
    }
    if kind == GK_SHOWN {
        put(inout g, "static void showu_(ei_String *o, uint64_t v)")
        proto(inout g, mark)
        put(inout g, " {\n  char b[24];\n  int i = 23;\n  b[23] = 0;\n  do { b[--i] = (char)(48 + v % 10); v /= 10; } while (v);\n  ei_str_cat(o, b + i, (uint64_t)(23 - i));\n}\n")
        let m2 = g.o.len()
        put(inout g, "static void showi_(ei_String *o, int64_t v)")
        proto(inout g, m2)
        put(inout g, " {\n  if (v < 0) {\n    char m = 45;\n    ei_str_cat(o, &m, 1);\n    showu_(o, (uint64_t)0 - (uint64_t)v);\n  } else {\n    showu_(o, (uint64_t)v);\n  }\n}\n")
        return
    }
    let t = types.get(p.t, ty)
    let k = t.kind
    if kind == GK_RNEW {
        let d = types.def_of(p.t, ty)
        put(inout g, "static ")
        cty(inout g, p, ty)
        put(inout g, " ")
        gname(inout g, p, "rnew_", ty)
        put(inout g, "(")
        if d.len == 0 { put(inout g, "void") }
        for i in 0..d.len {
            if i > 0 { put(inout g, ", ") }
            cty(inout g, p, types.field(p.t, d.start, i).ty)
            put(inout g, " a")
            putn(inout g, i as u64)
        }
        put(inout g, ")")
        proto(inout g, mark)
        put(inout g, " {\n  ")
        cty(inout g, p, ty)
        put(inout g, " r;\n  r.p = ei_buf_alloc(1, sizeof *r.p);\n  ")
        if d.len == 0 { put(inout g, "r.p->unused = 0;\n  ") }
        for i in 0..d.len {
            put(inout g, "r.p->f")
            putn(inout g, i as u64)
            put(inout g, " = a")
            putn(inout g, i as u64)
            put(inout g, ";\n  ")
        }
        put(inout g, "return r;\n}\n")
        return
    }
    if kind == GK_CMP {
        put(inout g, "static int ")
        gname(inout g, p, "cmp_", ty)
        put(inout g, "(")
        cty(inout g, p, ty)
        put(inout g, " a, ")
        cty(inout g, p, ty)
        put(inout g, " b)")
        proto(inout g, mark)
        put(inout g, " {\n")
        if custom_call(inout g, p, TR_ORD, ty, "(a, b)") { return }
        if k == types.T_RECORD {
            let d = types.def_of(p.t, ty)
            for i in 0..d.len { cmp_part(inout g, p, types.field(p.t, d.start, i).ty, rf(p, ty, "a", i), rf(p, ty, "b", i)) }
        } else if k == types.T_TUPLE {
            let es = types.elems(p.t, ty)
            for i in 0..es.len() { cmp_part(inout g, p, es[i], txt("a.f", i as u64, ""), txt("b.f", i as u64, "")) }
        } else if k == types.T_ENUM {
            // by variant order, then by the payload
            let d = types.def_of(p.t, ty)
            put(inout g, "  if (a.tag != b.tag) return a.tag < b.tag ? -1 : 1;\n")
            for i in 0..d.len {
                let v = types.variant(p.t, d, i)
                if v.flen == 0 { continue }
                put(inout g, "  if (a.tag == ")
                putn(inout g, i as u64)
                put(inout g, ") {\n")
                for j in 0..v.flen {
                    let mut x = txt("a.u.v", i as u64, ".f")
                    bytes.append(inout x, bytes.from_u64(j as u64))
                    let mut y = txt("b.u.v", i as u64, ".f")
                    bytes.append(inout y, bytes.from_u64(j as u64))
                    cmp_part(inout g, p, types.field(p.t, v.fstart, j).ty, x, y)
                }
                put(inout g, "  }\n")
            }
        } else if k == types.T_ARRAY {
            if t.b > 0 {
                put(inout g, "  for (uint64_t i = 0; i < ")
                putn(inout g, t.b as u64)
                put(inout g, "; i++)")
                cmp_part(inout g, p, t.a, sys.lit("a.a[i]"), sys.lit("b.a[i]"))
            }
        } else if k == types.T_LIST {
            put(inout g, "  for (uint64_t i = 0; i < a.len && i < b.len; i++)")
            cmp_part(inout g, p, t.a, sys.lit("a.d[i]"), sys.lit("b.d[i]"))
            put(inout g, "  return (a.len > b.len) - (a.len < b.len);\n}\n")
            return
        } else if k == types.T_BOX {
            cmp_part(inout g, p, t.a, sys.lit("(*a.p)"), sys.lit("(*b.p)"))
        }
        put(inout g, "  return 0;\n}\n")
        return
    }
    if kind == GK_HASH {
        put(inout g, "static uint64_t ")
        gname(inout g, p, "hash_", ty)
        put(inout g, "(")
        cty(inout g, p, ty)
        put(inout g, " x)")
        proto(inout g, mark)
        put(inout g, " {\n")
        if custom_call(inout g, p, TR_HASH, ty, "(x)") { return }
        put(inout g, "  uint64_t h = UINT64_C(0x9e3779b97f4a7c15);\n  ")
        if k == types.T_RECORD {
            let d = types.def_of(p.t, ty)
            for i in 0..d.len { hash_part(inout g, p, types.field(p.t, d.start, i).ty, rf(p, ty, "x", i)) }
        } else if k == types.T_TUPLE {
            let es = types.elems(p.t, ty)
            for i in 0..es.len() { hash_part(inout g, p, es[i], txt("x.f", i as u64, "")) }
        } else if k == types.T_ENUM {
            let d = types.def_of(p.t, ty)
            put(inout g, "h = ei_hash_u64(h ^ x.tag);\n  ")
            for i in 0..d.len {
                let v = types.variant(p.t, d, i)
                if v.flen == 0 { continue }
                put(inout g, "if (x.tag == ")
                putn(inout g, i as u64)
                put(inout g, ") { ")
                for j in 0..v.flen {
                    let mut x = txt("x.u.v", i as u64, ".f")
                    bytes.append(inout x, bytes.from_u64(j as u64))
                    hash_part(inout g, p, types.field(p.t, v.fstart, j).ty, x)
                }
                put(inout g, "}\n  ")
            }
        } else if k == types.T_ARRAY {
            put(inout g, "for (uint64_t i = 0; i < ")
            putn(inout g, t.b as u64)
            put(inout g, "; i++) { ")
            hash_part(inout g, p, t.a, sys.lit("x.a[i]"))
            put(inout g, "}\n  ")
        } else if k == types.T_LIST {
            put(inout g, "h = ei_hash_u64(h ^ x.len);\n  for (uint64_t i = 0; i < x.len; i++) { ")
            hash_part(inout g, p, t.a, sys.lit("x.d[i]"))
            put(inout g, "}\n  ")
        } else if k == types.T_BOX {
            hash_part(inout g, p, t.a, sys.lit("(*x.p)"))
        }
        put(inout g, "return h;\n}\n")
        return
    }
    if kind == GK_SHOW {
        put(inout g, "static void ")
        gname(inout g, p, "show_", ty)
        put(inout g, "(ei_String *o, ")
        cty(inout g, p, ty)
        put(inout g, " x)")
        proto(inout g, mark)
        put(inout g, " {\n  ")
        let f = custom_fn(p, TR_SHOW, ty)
        if f != NONE {
            fn_name(inout g, p, f)
            put(inout g, "(x, o);\n}\n")
            return
        }
        if k == types.T_RECORD {
            // `Name { a: 1, b: "x" }`
            let d = types.def_of(p.t, ty)
            let mut head = shown_name(p, d.key)
            if d.len == 0 { bytes.append(inout head, sys.lit(" {}")) } else { bytes.append(inout head, sys.lit(" { ")) }
            show_lit(inout g, head)
            for i in 0..d.len {
                let fl = types.field(p.t, d.start, i)
                let mut lab: List[u8] = List.new()
                if i > 0 { bytes.append(inout lab, sys.lit(", ")) }
                bytes.append(inout lab, intern.name(p.names, fl.name))
                bytes.append(inout lab, sys.lit(": "))
                show_lit(inout g, lab)
                show_into(inout g, p, fl.ty, sys.lit("o"), rf(p, ty, "x", i), true)
                put(inout g, "; ")
            }
            if d.len > 0 { show_lit(inout g, sys.lit(" }")) }
        } else if k == types.T_TUPLE {
            // `(1, "x")`, `(1,)`
            let es = types.elems(p.t, ty)
            show_lit(inout g, sys.lit("("))
            for i in 0..es.len() {
                if i > 0 { show_lit(inout g, sys.lit(", ")) }
                show_into(inout g, p, es[i], sys.lit("o"), txt("x.f", i as u64, ""), true)
                put(inout g, "; ")
            }
            if es.len() == 1 { show_lit(inout g, sys.lit(",")) }
            show_lit(inout g, sys.lit(")"))
        } else if k == types.T_ENUM {
            // `Some(1)`, `None`: the variant's name as `print` writes it, then the payload
            let d = types.def_of(p.t, ty)
            put(inout g, "switch (x.tag) {\n  ")
            for i in 0..d.len {
                let v = types.variant(p.t, d, i)
                put(inout g, "case ")
                putn(inout g, i as u64)
                put(inout g, ": ")
                let mut nmv = shown_name(p, v.key)
                if v.flen > 0 { nmv.push(40) }
                show_lit(inout g, nmv)
                for j in 0..v.flen {
                    if j > 0 { show_lit(inout g, sys.lit(", ")) }
                    let mut x = txt("x.u.v", i as u64, ".f")
                    bytes.append(inout x, bytes.from_u64(j as u64))
                    show_into(inout g, p, types.field(p.t, v.fstart, j).ty, sys.lit("o"), x, true)
                    put(inout g, "; ")
                }
                if v.flen > 0 { show_lit(inout g, sys.lit(")")) }
                put(inout g, "break;\n  ")
            }
            put(inout g, "default: break;\n  }")
        } else if k == types.T_ARRAY || k == types.T_LIST {
            // `[1, 2]`
            show_lit(inout g, sys.lit("["))
            put(inout g, "for (uint64_t i = 0; i < ")
            if k == types.T_LIST { put(inout g, "x.len") } else { putn(inout g, t.b as u64) }
            put(inout g, "; i++) {\n    if (i) { ")
            show_lit(inout g, sys.lit(", "))
            put(inout g, "}\n    ")
            if k == types.T_LIST {
                show_into(inout g, p, t.a, sys.lit("o"), sys.lit("x.d[i]"), true)
            } else {
                show_into(inout g, p, t.a, sys.lit("o"), sys.lit("x.a[i]"), true)
            }
            put(inout g, "; }\n  ")
            show_lit(inout g, sys.lit("]"))
        } else if k == types.T_MAP {
            // `{1: "a", 2: "b"}`, in slot order
            show_lit(inout g, sys.lit("{"))
            put(inout g, "bool first = true;\n  for (uint64_t i = 0; i < x.cap; i++) if (x.s[i] == 1) {\n    if (!first) { ")
            show_lit(inout g, sys.lit(", "))
            put(inout g, "}\n    first = false;\n    ")
            show_into(inout g, p, t.a, sys.lit("o"), sys.lit("x.k[i]"), true)
            put(inout g, "; ")
            show_lit(inout g, sys.lit(": "))
            show_into(inout g, p, t.b, sys.lit("o"), sys.lit("x.v[i]"), true)
            put(inout g, ";\n  }\n  ")
            show_lit(inout g, sys.lit("}"))
        } else if k == types.T_BOX {
            show_lit(inout g, sys.lit("Box("))
            show_into(inout g, p, t.a, sys.lit("o"), sys.lit("(*x.p)"), true)
            put(inout g, "; ")
            show_lit(inout g, sys.lit(")"))
        }
        put(inout g, "\n}\n")
        return
    }
    // GK_COPY: `static T copy_T(const T *x)`
    put(inout g, "static ")
    cty(inout g, p, ty)
    put(inout g, " ")
    gname(inout g, p, "copy_", ty)
    put(inout g, "(const ")
    cty(inout g, p, ty)
    put(inout g, " *x)")
    proto(inout g, mark)
    put(inout g, " {\n  ")
    let f = custom_fn(p, TR_COPY, ty)
    if f != NONE {
        put(inout g, "return ")
        fn_name(inout g, p, f)
        put(inout g, "(*x);\n}\n")
        return
    }
    cty(inout g, p, ty)
    put(inout g, " r = *x;\n  ")
    if k == types.T_RECORD && shared_rec(p, ty) {
        let d = types.def_of(p.t, ty)
        put(inout g, "r.p = ei_buf_alloc(1, sizeof *r.p);\n  *r.p = *x->p;\n  ")
        for i in 0..d.len { copy_part(inout g, p, types.field(p.t, d.start, i).ty, txt("r.p->f", i as u64, ""), rfp(p, ty, i)) }
    } else if k == types.T_RECORD {
        let d = types.def_of(p.t, ty)
        for i in 0..d.len { copy_part(inout g, p, types.field(p.t, d.start, i).ty, txt("r.f", i as u64, ""), txt("&x->f", i as u64, "")) }
    } else if k == types.T_TUPLE {
        let es = types.elems(p.t, ty)
        for i in 0..es.len() { copy_part(inout g, p, es[i], txt("r.f", i as u64, ""), txt("&x->f", i as u64, "")) }
    } else if k == types.T_ENUM {
        let d = types.def_of(p.t, ty)
        put(inout g, "switch (x->tag) { ")
        for i in 0..d.len {
            let v = types.variant(p.t, d, i)
            put(inout g, "case ")
            putn(inout g, i as u64)
            put(inout g, ": ")
            for j in 0..v.flen {
                let mut lhs = txt("r.u.v", i as u64, ".f")
                bytes.append(inout lhs, bytes.from_u64(j as u64))
                let mut src = txt("&x->u.v", i as u64, ".f")
                bytes.append(inout src, bytes.from_u64(j as u64))
                copy_part(inout g, p, types.field(p.t, v.fstart, j).ty, lhs, src)
            }
            put(inout g, "break; ")
        }
        put(inout g, "default: break; }")
    } else if k == types.T_ARRAY {
        put(inout g, "for (uint64_t i = 0; i < ")
        putn(inout g, t.b as u64)
        put(inout g, "; i++) { ")
        copy_part(inout g, p, t.a, sys.lit("r.a[i]"), sys.lit("&x->a[i]"))
        put(inout g, "}")
    } else if k == types.T_LIST {
        put(inout g, "if (x->cap) {\n    r.d = ei_buf_alloc(x->cap, sizeof *r.d);\n    for (uint64_t i = 0; i < x->len; i++) r.d[i] = ")
        copy_expr(inout g, p, t.a, sys.lit("&x->d[i]"))
        put(inout g, ";\n  }")
    } else if k == types.T_MAP {
        put(inout g, "if (x->cap) {\n    r.k = ei_alloc_n(x->cap, sizeof *r.k);\n    r.v = ei_alloc_n(x->cap, sizeof *r.v);\n    r.s = ei_buf_alloc(x->cap, 1);\n    for (uint64_t i = 0; i < x->cap; i++) {\n      r.s[i] = x->s[i];\n      if (x->s[i] == 1) { r.k[i] = ")
        copy_expr(inout g, p, t.a, sys.lit("&x->k[i]"))
        put(inout g, "; r.v[i] = ")
        copy_expr(inout g, p, t.b, sys.lit("&x->v[i]"))
        put(inout g, "; }\n    }\n  }")
    } else if k == types.T_BOX {
        put(inout g, "r.p = ei_buf_alloc(1, sizeof *r.p);\n  *r.p = ")
        copy_expr(inout g, p, t.a, sys.lit("x->p"))
        put(inout g, ";")
    } else if k == types.T_MUTEX {
        // locks, copies the contents into a new Mutex, unlocks
        need(inout g, GK_MXGET, ty)
        need(inout g, GK_MXNEW, ty)
        cty(inout g, p, t.a)
        put(inout g, " v = ")
        gname(inout g, p, "get_", ty)
        put(inout g, "(*x);\n  ")
        let mut seen: Map[u32, bool] = Map.new()
        if deep(p, t.a, inout seen) {
            cty(inout g, p, t.a)
            put(inout g, " w = ")
            copy_expr(inout g, p, t.a, sys.lit("&v"))
            put(inout g, ";\n  ")
            drop_call(inout g, p, t.a, sys.lit("&v"))
            put(inout g, "\n  v = w;\n  ")
        }
        put(inout g, "r = ")
        gname(inout g, p, "new_", ty)
        put(inout g, "(v);")
    } else if k == types.T_REF {
        // a new Ref holding a copy of the value (a read of it)
        put(inout g, "ei_ref_read_begin(&x->p->st, 0);\n  r.p = ei_buf_alloc(1, sizeof *r.p);\n  r.p->st = 0;\n  r.p->v = ")
        copy_expr(inout g, p, t.a, sys.lit("&x->p->v"))
        put(inout g, ";\n  ei_ref_read_end(&x->p->st);")
    }
    put(inout g, "\n  return r;\n}\n")
}

/// `push_L` (B_LIST_PUSH: moves x in) and `has_L` (B_LIST_CONTAINS) for List type ty.
fn list_glue(inout g: G, p: P, kind: u32, ty: u32) {
    let el = types.get(p.t, ty).a
    let mark = g.o.len()
    if kind == GK_PUSH {
        put(inout g, "static void ")
        gname(inout g, p, "push_", ty)
        put(inout g, "(")
        cty(inout g, p, ty)
        put(inout g, " *l, ")
        cty(inout g, p, el)
        put(inout g, " x)")
        proto(inout g, mark)
        put(inout g, " {\n  ")
        uniq_call(inout g, p, ty, sys.lit("l"))
        put(inout g, ";\n  if (l->len == l->cap) {\n    uint64_t nc = ei_grow_cap(l->cap, l->len, 1, 4);\n    ")
        prof_ev(inout g, "EI_PEV_GROW", "nc * sizeof *l->d")
        put(inout g, "l->d = ei_buf_grow(l->d, nc, sizeof *l->d);\n    l->cap = nc;\n  }\n  l->d[l->len++] = x;\n}\n")
        return
    }
    put(inout g, "static bool ")
    gname(inout g, p, "has_", ty)
    put(inout g, "(const ")
    cty(inout g, p, ty)
    put(inout g, " *l, ")
    cty(inout g, p, el)
    put(inout g, " x)")
    proto(inout g, mark)
    put(inout g, " {\n  for (uint64_t i = 0; i < l->len; i++) if (")
    eq_expr(inout g, p, el, sys.lit("l->d[i]"), sys.lit("x"))
    put(inout g, ") return true;\n  return false;\n}\n")
}

/// `bytes_L(s, n)`: a List[u8] (type ty) holding bytes s[0..n); `utf8_R(d, n)`: Ok(the
/// String of bytes d[0..n)) when they are valid UTF-8 without NUL, else Err(offset of the
/// first bad byte), for R = Result[String, usize] (ty).
fn text_glue(inout g: G, p: P, kind: u32, ty: u32) {
    let mark = g.o.len()
    put(inout g, "static ")
    cty(inout g, p, ty)
    put(inout g, " ")
    if kind == GK_BYTES {
        gname(inout g, p, "bytes_", ty)
        put(inout g, "(const char *s, uint64_t n)")
        proto(inout g, mark)
        put(inout g, " {\n  ")
        cty(inout g, p, ty)
        put(inout g, " l = {0};\n  if (n) {\n    l.d = ei_buf_alloc(n, 1);\n    memcpy(l.d, s, (size_t)n);\n    l.len = l.cap = n;\n  }\n  return l;\n}\n")
        return
    }
    gname(inout g, p, "utf8_", ty)
    put(inout g, "(const uint8_t *d, uint64_t n)")
    proto(inout g, mark)
    put(inout g, " {\n  ")
    cty(inout g, p, ty)
    put(inout g, " r = {0};\n  uint64_t bad = ei_utf8_check(d, n);\n  if (bad == n) {\n    r.tag = 0;\n    r.u.v0.f0 = ei_str_from_n((const char *)d, n);\n  } else {\n    r.tag = 1;\n    r.u.v1.f0 = bad;\n  }\n  return r;\n}\n")
}

/// The pointer and length of text operand a (String or str), as runtime arguments.
fn text_arg(inout g: G, p: P, a: u32) {
    if ty_kind(p, arg_ty(p, a)) == types.T_STRING {
        arg_val(inout g, p, a)
        put(inout g, ".p, ")
        arg_val(inout g, p, a)
        put(inout g, ".len")
    } else {
        arg_val(inout g, p, a)
        put(inout g, ", (uint64_t)strlen(")
        arg_val(inout g, p, a)
        put(inout g, ")")
    }
}

/// The byte builtins of String and str (C8.2; ir.ei, "Bytes of text").
fn text_builtin(inout g: G, p: P, s: ir.Stmt) {
    let b = s.a
    if b == ir.B_STR_PUSH_BYTE {
        put(inout g, "ei_str_push_byte(")
        arg_ptr(inout g, p, barg(p, s, 0))
        put(inout g, ", ")
        arg_val(inout g, p, barg(p, s, 1))
        put(inout g, ", ")
        put_line(inout g, s.line)
        put(inout g, ")")
        return
    }
    bdst(inout g, p, s)
    if b == ir.B_STR_FROM_BYTES {
        need(inout g, GK_UTF8, s.ty)
        gname(inout g, p, "utf8_", s.ty)
        put(inout g, "(")
        arg_val(inout g, p, barg(p, s, 0))
        put(inout g, ".d, ")
        arg_val(inout g, p, barg(p, s, 0))
        put(inout g, ".len)")
        return
    }
    if b == ir.B_STR_BYTES {
        need(inout g, GK_BYTES, s.ty)
        gname(inout g, p, "bytes_", s.ty)
        put(inout g, "(")
        text_arg(inout g, p, barg(p, s, 0))
        put(inout g, ")")
        return
    }
    if b == ir.B_STR_BYTE { put(inout g, "ei_str_byte(") } else { put(inout g, "ei_str_slice(") }
    text_arg(inout g, p, barg(p, s, 0))
    put(inout g, ", ")
    arg_val(inout g, p, barg(p, s, 1))
    if b == ir.B_STR_SLICE {
        put(inout g, ", ")
        arg_val(inout g, p, barg(p, s, 2))
    }
    put(inout g, ", ")
    put_line(inout g, s.line)
    put(inout g, ")")
}

/// `new_B` (B_BOX_NEW: moves v in) for Box type ty.
fn box_glue(inout g: G, p: P, ty: u32) {
    let el = types.get(p.t, ty).a
    let mark = g.o.len()
    put(inout g, "static ")
    cty(inout g, p, ty)
    put(inout g, " ")
    gname(inout g, p, "new_", ty)
    put(inout g, "(")
    cty(inout g, p, el)
    put(inout g, " v)")
    proto(inout g, mark)
    put(inout g, " {\n  ")
    cty(inout g, p, ty)
    put(inout g, " b;\n  b.p = ei_buf_alloc(1, sizeof *b.p);\n  *b.p = v;\n  return b;\n}\n")
}

/// The Map operations: `find_M` (slot or -1), `get_M` (pointer to
/// the value or NULL), `ins_M` (moves key and value in; an existing key keeps its slot, its
/// old value and the new key are dropped), `rem_M` (drops the entry; true if it was there).
fn map_glue(inout g: G, p: P, kind: u32, ty: u32) {
    let t = types.get(p.t, ty)
    let kt = t.a
    let vt = t.b
    let mark = g.o.len()
    if kind == GK_FIND {
        put(inout g, "static int64_t ")
        gname(inout g, p, "find_", ty)
        put(inout g, "(const ")
        cty(inout g, p, ty)
        put(inout g, " *m, ")
        cty(inout g, p, kt)
        put(inout g, " key)")
        proto(inout g, mark)
        put(inout g, " {\n  if (m->cap == 0) return -1;\n  uint64_t i = ")
        hash_expr(inout g, p, kt, "key")
        put(inout g, " & (m->cap - 1);\n  for (uint64_t c = 0; c < m->cap; c++) {\n    if (m->s[i] == 0) return -1;\n    if (m->s[i] == 1 && ")
        eq_expr(inout g, p, kt, sys.lit("m->k[i]"), sys.lit("key"))
        put(inout g, ") return (int64_t)i;\n    i = (i + 1) & (m->cap - 1);\n  }\n  return -1;\n}\n")
        return
    }
    need(inout g, GK_FIND, ty)
    if kind == GK_GET {
        put(inout g, "static ")
        cty(inout g, p, vt)
        put(inout g, " *")
        gname(inout g, p, "get_", ty)
        put(inout g, "(const ")
        cty(inout g, p, ty)
        put(inout g, " *m, ")
        cty(inout g, p, kt)
        put(inout g, " key)")
        proto(inout g, mark)
        put(inout g, " {\n  int64_t f = ")
        gname(inout g, p, "find_", ty)
        put(inout g, "(m, key);\n  return f < 0 ? NULL : &m->v[f];\n}\n")
        return
    }
    if kind == GK_REM {
        put(inout g, "static bool ")
        gname(inout g, p, "rem_", ty)
        put(inout g, "(")
        cty(inout g, p, ty)
        put(inout g, " *m, ")
        cty(inout g, p, kt)
        put(inout g, " key)")
        proto(inout g, mark)
        put(inout g, " {\n  int64_t f = ")
        gname(inout g, p, "find_", ty)
        put(inout g, "(m, key);\n  if (f < 0) return false;\n  ")
        // a copy keeps the slots, so f stays valid
        uniq_call(inout g, p, ty, sys.lit("m"))
        put(inout g, ";\n  ")
        drop_call(inout g, p, kt, sys.lit("&m->k[f]"))
        drop_call(inout g, p, vt, sys.lit("&m->v[f]"))
        put(inout g, "m->s[f] = 2;\n  m->len--;\n  return true;\n}\n")
        return
    }
    put(inout g, "static void ")
    gname(inout g, p, "ins_", ty)
    put(inout g, "(")
    cty(inout g, p, ty)
    put(inout g, " *m, ")
    cty(inout g, p, kt)
    put(inout g, " key, ")
    cty(inout g, p, vt)
    put(inout g, " val)")
    proto(inout g, mark)
    put(inout g, " {\n  int64_t f = ")
    gname(inout g, p, "find_", ty)
    put(inout g, "(m, key);\n  ")
    uniq_call(inout g, p, ty, sys.lit("m"))
    put(inout g, ";\n  if (f >= 0) {\n    ")
    drop_call(inout g, p, vt, sys.lit("&m->v[f]"))
    drop_call(inout g, p, kt, sys.lit("&key"))
    put(inout g, "m->v[f] = val;\n    return;\n  }\n  if ((m->used + 1) * 4 > m->cap * 3) {\n    uint64_t nc = ei_grow_cap(m->cap, m->cap, 1, 8);\n    ")
    prof_ev(inout g, "EI_PEV_REHASH", "nc * (sizeof *m->k + sizeof *m->v + 1)")
    cty(inout g, p, kt)
    put(inout g, " *nk = ei_alloc_n(nc, sizeof *nk);\n    ")
    cty(inout g, p, vt)
    put(inout g, " *nv = ei_alloc_n(nc, sizeof *nv);\n    uint8_t *ns = ei_buf_alloc(nc, 1);\n    memset(ns, 0, (size_t)nc);\n    for (uint64_t j = 0; j < m->cap; j++) if (m->s[j] == 1) {\n      uint64_t i = ")
    hash_expr(inout g, p, kt, "m->k[j]")
    put(inout g, " & (nc - 1);\n      while (ns[i]) i = (i + 1) & (nc - 1);\n      nk[i] = m->k[j];\n      nv[i] = m->v[j];\n      ns[i] = 1;\n    }\n    ei_free(m->k);\n    ei_free(m->v);\n    ei_buf_free(m->s);\n    m->k = nk;\n    m->v = nv;\n    m->s = ns;\n    m->cap = nc;\n    m->used = m->len;\n  }\n  uint64_t i = ")
    hash_expr(inout g, p, kt, "key")
    put(inout g, " & (m->cap - 1);\n  while (m->s[i] == 1) i = (i + 1) & (m->cap - 1);\n  if (m->s[i] == 0) m->used++;\n  m->k[i] = key;\n  m->v[i] = val;\n  m->s[i] = 1;\n  m->len++;\n}\n")
}

/// The environment of closure body f: `struct env_F { ... c<i>; }` (in `envs`) and its
/// drop (`edrop_F`), clone (`eclone_F`) and own (`eown_F`), which the closure value points to.
fn env_glue(inout g: G, p: P, f: u32) {
    let fd = p.ir.fns[f as usize]
    let n = g.ncap[f as usize].copy()
    let fname = g.fnn[f as usize].copy()
    let saved = g.o.copy()
    g.o = List.new()
    put(inout g, "typedef struct env_")
    putb(inout g, fname)
    put(inout g, " {")
    for i in 0..n {
        put(inout g, " ")
        cty(inout g, p, p.ir.locals[(fd.lstart + i) as usize].ty)
        put(inout g, " c")
        putn(inout g, i as u64)
        put(inout g, ";")
    }
    put(inout g, " } env_")
    putb(inout g, fname)
    put(inout g, ";\n")
    let def = g.o.copy()
    g.o = saved
    bytes.append(inout g.envs, def)
    let mark = g.o.len()
    put(inout g, "static void edrop_")
    putb(inout g, fname)
    put(inout g, "(void *q)")
    proto(inout g, mark)
    put(inout g, " {\n  env_")
    putb(inout g, fname)
    put(inout g, " *e = q;\n  ")
    for i in 0..n { drop_call(inout g, p, p.ir.locals[(fd.lstart + i) as usize].ty, txt("&e->c", i as u64, "")) }
    put(inout g, "ei_free(e);\n}\n")
    let mark2 = g.o.len()
    put(inout g, "static void *eclone_")
    putb(inout g, fname)
    put(inout g, "(void *q)")
    proto(inout g, mark2)
    put(inout g, " {\n  env_")
    putb(inout g, fname)
    put(inout g, " *e = q;\n  env_")
    putb(inout g, fname)
    put(inout g, " *r = ei_alloc(sizeof *r);\n  *r = *e;\n  ")
    for i in 0..n {
        let ct = p.ir.locals[(fd.lstart + i) as usize].ty
        if !owns(inout g, p, ct) { continue }
        put(inout g, "r->c")
        putn(inout g, i as u64)
        put(inout g, " = ")
        clone_expr(inout g, p, ct, txt("&e->c", i as u64, ""))
        put(inout g, "; ")
    }
    put(inout g, "return r;\n}\n")
    // before the closure runs on (or is handed to) another thread
    let mark3 = g.o.len()
    put(inout g, "static void eown_")
    putb(inout g, fname)
    put(inout g, "(void *q)")
    proto(inout g, mark3)
    put(inout g, " {\n  env_")
    putb(inout g, fname)
    put(inout g, " *e = q;\n  (void)e;\n  ")
    for i in 0..n { own_call(inout g, p, p.ir.locals[(fd.lstart + i) as usize].ty, txt("&e->c", i as u64, "")) }
    put(inout g, "\n}\n")
}

/// `k_F`: function f called through a fn value (no environment).
fn thunk_glue(inout g: G, p: P, f: u32) {
    let fd = p.ir.fns[f as usize]
    let mark = g.o.len()
    put(inout g, "static ")
    ret_cty(inout g, p, fd.ret)
    put(inout g, " k_")
    let fname = g.fnn[f as usize].copy()
    putb(inout g, fname)
    put(inout g, "(void *env")
    for i in 0..fd.nparams {
        put(inout g, ", ")
        cty(inout g, p, p.ir.locals[(fd.lstart + i) as usize].ty)
        put(inout g, " a")
        putn(inout g, i as u64)
    }
    put(inout g, ")")
    proto(inout g, mark)
    put(inout g, " {\n  (void)env;\n  ")
    if !is_void(p, fd.ret) { put(inout g, "return ") }
    putb(inout g, fname)
    put(inout g, "(")
    for i in 0..fd.nparams {
        if i > 0 { put(inout g, ", ") }
        put(inout g, "a")
        putn(inout g, i as u64)
    }
    put(inout g, ");\n}\n")
}

// ---- operands and places

fn loc(p: P, g: G, l: u32) -> ir.Local { p.ir.locals[(g.lbase + l) as usize] }

fn local_name(inout g: G, p: P, l: u32) {
    let x = loc(p, g, l)
    put(inout g, "l")
    putn(inout g, l as u64)
    if x.kind != ir.L_TEMP && x.name != 0 {
        put(inout g, "_")
        ident(inout g, intern.name(p.names, x.name))
    }
}

/// A local as a C lvalue (`inout` parameters are pointers).
fn local_ref(inout g: G, p: P, l: u32) {
    if loc(p, g, l).kind == ir.L_INOUT {
        put(inout g, "(*")
        local_name(inout g, p, l)
        put(inout g, ")")
    } else {
        local_name(inout g, p, l)
    }
}

/// Integer literal `v` (64-bit two's complement) of kind k, typed exactly.
fn int_lit(inout g: G, k: u32, v: u64) {
    let neg = types.signed(k) && v >= 9223372036854775808
    if k == types.IK_I32 {
        if neg && v == 18446744071562067968 {
            put(inout g, "INT32_MIN")
        } else if neg {
            put(inout g, "((int32_t)-")
            putn(inout g, 0 -% v)
            put(inout g, ")")
        } else {
            put(inout g, "((int32_t)")
            putn(inout g, v)
            put(inout g, ")")
        }
    } else if k == types.IK_I64 {
        if neg && v == 9223372036854775808 {
            put(inout g, "INT64_MIN")
        } else if neg {
            put(inout g, "(-INT64_C(")
            putn(inout g, 0 -% v)
            put(inout g, "))")
        } else {
            put(inout g, "INT64_C(")
            putn(inout g, v)
            put(inout g, ")")
        }
    } else if k == types.IK_U8 {
        put(inout g, "((uint8_t)")
        putn(inout g, v)
        put(inout g, ")")
    } else if k == types.IK_U32 {
        put(inout g, "UINT32_C(")
        putn(inout g, v)
        put(inout g, ")")
    } else {
        put(inout g, "UINT64_C(")
        putn(inout g, v)
        put(inout g, ")")
    }
}

fn op(inout g: G, p: P, id: u32) {
    let x = p.ir.ops[id as usize]
    if x.kind == ir.O_INT {
        int_lit(inout g, types.ik(p.t, x.ty), x.v)
    } else if x.kind == ir.O_BOOL {
        if x.v == 1 { put(inout g, "true") } else { put(inout g, "false") }
    } else if x.kind == ir.O_STR {
        str_lit(inout g.o, p.ir.strs[x.a as usize])
    } else if x.kind == ir.O_UNIT {
        put(inout g, "0")
    } else if is_void(p, loc(p, g, x.a).ty) {
        // a `()` local has no C variable (it is never declared or assigned), e.g. a generic
        // T = () read out of a payload in a match arm (docs/compiler.md, "C8.16")
        put(inout g, "0")
    } else {
        local_ref(inout g, p, x.a)
    }
}

/// Text written by `op` or `place` (for glue calls that take C expressions).
fn cut(inout g: G, mark: usize) -> List[u8] {
    let s = bytes.slice(g.o, mark, g.o.len())
    while g.o.len() > mark { g.o.pop() }
    s
}

fn op_text(inout g: G, p: P, id: u32) -> List[u8] {
    let mark = g.o.len()
    op(inout g, p, id)
    cut(inout g, mark)
}

fn place_text(inout g: G, p: P, id: u32) -> List[u8] {
    let mark = g.o.len()
    place(inout g, p, id)
    cut(inout g, mark)
}

/// Bounds checks for every index in place `id`, outermost base first (so they run left to
/// right, before the statement that uses the place). Arrays check against their length,
/// Lists against `len`.
fn checks(inout g: G, p: P, id: u32, depth: u32) {
    let x = p.ir.places[id as usize]
    if x.kind == ir.P_LOCAL { return }
    checks(inout g, p, x.a, depth)
    if x.kind != ir.P_INDEX { return }
    ind(inout g, depth)
    put(inout g, "(void)ei_idx((uint64_t)")
    op(inout g, p, x.b)
    put(inout g, ", ")
    let bt = types.get(p.t, p.ir.places[x.a as usize].ty)
    if bt.kind == types.T_LIST {
        place(inout g, p, x.a)
        put(inout g, ".len")
    } else {
        putn(inout g, bt.b as u64)
    }
    put(inout g, ", ")
    put_line(inout g, x.line)
    put(inout g, ");\n")
}

/// Copy-on-write before a statement writes into place `id` (stores to it, drops or moves
/// it, passes it `inout` or to a mutating builtin): every List and Box on the path to it
/// gets a buffer of its own, outermost first, so the write is not seen through another copy
/// of a container. (The place itself, when it is a container, is made unique by whatever
/// changes it: the glue, ei_str_cat, a callee's own writes.)
fn uniqs(inout g: G, p: P, id: u32, depth: u32) {
    let x = p.ir.places[id as usize]
    if x.kind == ir.P_LOCAL { return }
    uniqs(inout g, p, x.a, depth)
    let bty = p.ir.places[x.a as usize].ty
    if x.kind == ir.P_DEREF || (x.kind == ir.P_INDEX && ty_kind(p, bty) == types.T_LIST) || (x.kind == ir.P_FIELD && shared_rec(p, bty)) {
        let mut ptr = sys.lit("&")
        bytes.append(inout ptr, place_text(inout g, p, x.a))
        ind(inout g, depth)
        uniq_call(inout g, p, bty, ptr)
        put(inout g, ";\n")
    }
}

fn arg_uniqs(inout g: G, p: P, start: u32, n: u32, depth: u32) {
    for i in 0..n {
        let a = p.ir.extra[(start + i) as usize]
        if a >= ir.ARG_PLACE { uniqs(inout g, p, a - ir.ARG_PLACE, depth) }
    }
}

/// Whether builtin b changes its first argument (a place).
fn mutates(b: u32) -> bool {
    b == ir.B_SHOW || b == ir.B_STR_PUSH || b == ir.B_STR_APPEND || b == ir.B_STR_PUSH_BYTE || b == ir.B_LIST_PUSH || b == ir.B_LIST_POP || b == ir.B_LIST_CLEAR || b == ir.B_MAP_INSERT || b == ir.B_MAP_REMOVE
}

/// A place as a C lvalue (its indices are checked already).
fn place(inout g: G, p: P, id: u32) {
    let x = p.ir.places[id as usize]
    if x.kind == ir.P_LOCAL {
        local_ref(inout g, p, x.a)
    } else if x.kind == ir.P_FIELD {
        place(inout g, p, x.a)
        if shared_rec(p, p.ir.places[x.a as usize].ty) { put(inout g, ".p->f") } else { put(inout g, ".f") }
        putn(inout g, x.b as u64)
    } else if x.kind == ir.P_INDEX {
        place(inout g, p, x.a)
        if types.kind(p.t, p.ir.places[x.a as usize].ty) == types.T_LIST { put(inout g, ".d[") } else { put(inout g, ".a[") }
        op(inout g, p, x.b)
        put(inout g, "]")
    } else if x.kind == ir.P_PAYLOAD {
        place(inout g, p, x.a)
        put(inout g, ".u.v")
        putn(inout g, x.b as u64)
        put(inout g, ".f")
        putn(inout g, x.c as u64)
    } else {
        put(inout g, "(*")
        place(inout g, p, x.a)
        put(inout g, ".p)")
    }
}

fn args(inout g: G, p: P, start: u32, n: u32) {
    for i in 0..n {
        if i > 0 { put(inout g, ", ") }
        let a = p.ir.extra[(start + i) as usize]
        if a >= ir.ARG_PLACE {
            put(inout g, "&")
            place(inout g, p, a - ir.ARG_PLACE)
        } else {
            op(inout g, p, a)
        }
    }
}

fn arg_checks(inout g: G, p: P, start: u32, n: u32, depth: u32) {
    for i in 0..n {
        let a = p.ir.extra[(start + i) as usize]
        if a >= ir.ARG_PLACE { checks(inout g, p, a - ir.ARG_PLACE, depth) }
    }
}

/// Builtin argument i of statement s: its id, its value, a pointer to it, its type.
fn barg(p: P, s: ir.Stmt, i: u32) -> u32 { p.ir.extra[(s.b + i) as usize] }

fn arg_val(inout g: G, p: P, a: u32) {
    if a >= ir.ARG_PLACE { place(inout g, p, a - ir.ARG_PLACE) } else { op(inout g, p, a) }
}

fn arg_ptr(inout g: G, p: P, a: u32) {
    put(inout g, "&")
    arg_val(inout g, p, a)
}

fn arg_ty(p: P, a: u32) -> u32 {
    if a >= ir.ARG_PLACE { return p.ir.places[(a - ir.ARG_PLACE) as usize].ty }
    ir.op_ty(p.ir, a)
}

// ---- statements

fn dst(inout g: G, p: P, l: u32) {
    local_ref(inout g, p, l)
    put(inout g, " = ")
}

fn fn_name(inout g: G, p: P, f: u32) {
    let n = g.fnn[f as usize].copy()
    putb(inout g, n)
}

fn block(inout g: G, p: P, b: u32, depth: u32) {
    let bl = p.ir.blocks[b as usize]
    g.pline = NONE
    for i in 0..bl.len { stmt(inout g, p, p.ir.extra[(bl.start + i) as usize], depth) }
    g.pline = NONE
}

/// Whether block b contains a `continue` of its own loop (not of a nested one).
fn has_continue(p: P, b: u32) -> bool {
    let bl = p.ir.blocks[b as usize]
    for i in 0..bl.len {
        let s = p.ir.stmts[p.ir.extra[(bl.start + i) as usize] as usize]
        if s.kind == ir.S_CONTINUE && s.a == 0 { return true }
        if s.kind == ir.S_IF && (has_continue(p, s.b) || has_continue(p, s.c)) { return true }
    }
    false
}

/// Whether block b, `d` loops inside a loop L, has a labeled exit of `kind` (S_BREAK or
/// S_CONTINUE) out of a nested loop to L (docs/compiler.md, "C8.22"): one with a == d > 0.
fn exits_to(p: P, b: u32, kind: u32, d: u32) -> bool {
    let bl = p.ir.blocks[b as usize]
    for i in 0..bl.len {
        let s = p.ir.stmts[p.ir.extra[(bl.start + i) as usize] as usize]
        if s.kind == kind && d > 0 && s.a == d { return true }
        if s.kind == ir.S_IF && (exits_to(p, s.b, kind, d) || exits_to(p, s.c, kind, d)) { return true }
        if s.kind == ir.S_LOOP && exits_to(p, s.a, kind, d + 1) { return true }
    }
    false
}

/// The integer range of kind k as (min, max) in 64-bit two's complement.
pub fn kmin(k: u32) -> u64 {
    match k {
        0 => 18446744071562067968
        1 => 9223372036854775808
        _ => 0
    }
}

pub fn kmax(k: u32) -> u64 {
    match k {
        0 => 2147483647
        1 => 9223372036854775807
        2 => 255
        3 => 4294967295
        _ => 18446744073709551615
    }
}

/// The value of comparison `a op b` when one side is a literal at the end of the type's
/// range, so it is the same for every value of the other side: 1 false, 2 true, 0 unknown.
/// Lowering writes these as constants (gcc's -Wtype-limits rejects `x >= 0u` and the like).
fn fixed_cmp(p: P, opk: u32, a: u32, b: u32, ty: u32) -> u32 {
    let k = types.ik(p.t, ty)
    let xa = p.ir.ops[a as usize]
    let xb = p.ir.ops[b as usize]
    let mut o = opk.copy()
    let mut lit: u64 = 0
    if xb.kind == ir.O_INT && xa.kind != ir.O_INT {
        lit = xb.v
    } else if xa.kind == ir.O_INT && xb.kind != ir.O_INT {
        lit = xa.v
        // mirror: lit < x  is  x > lit
        if o == ast.OP_LT { o = ast.OP_GT } else if o == ast.OP_GT { o = ast.OP_LT } else if o == ast.OP_LE { o = ast.OP_GE } else { o = ast.OP_LE }
    } else {
        return 0
    }
    if lit == kmin(k) && o == ast.OP_LT { return 1 }
    if lit == kmin(k) && o == ast.OP_GE { return 2 }
    if lit == kmax(k) && o == ast.OP_GT { return 1 }
    if lit == kmax(k) && o == ast.OP_LE { return 2 }
    0
}

fn binary(inout g: G, p: P, s: ir.Stmt) {
    let o = s.a
    if o <= ast.OP_WMUL {
        let k = types.ik(p.t, s.ty)
        if o == ast.OP_ADD { put(inout g, "ei_add_") }
        if o == ast.OP_SUB { put(inout g, "ei_sub_") }
        if o == ast.OP_MUL { put(inout g, "ei_mul_") }
        if o == ast.OP_DIV { put(inout g, "ei_div_") }
        if o == ast.OP_REM { put(inout g, "ei_rem_") }
        if o == ast.OP_WADD { put(inout g, "ei_wadd_") }
        if o == ast.OP_WSUB { put(inout g, "ei_wsub_") }
        if o == ast.OP_WMUL { put(inout g, "ei_wmul_") }
        put(inout g, suffix(k))
        put(inout g, "(")
        op(inout g, p, s.b)
        put(inout g, ", ")
        op(inout g, p, s.c)
        if o <= ast.OP_REM {
            put(inout g, ", ")
            put_line(inout g, s.line)
        }
        put(inout g, ")")
        return
    }
    if ast.is_bitwise(o) {
        let k = types.ik(p.t, s.ty)
        if o == ast.OP_BAND { put(inout g, "ei_band_") }
        if o == ast.OP_BOR { put(inout g, "ei_bor_") }
        if o == ast.OP_BXOR { put(inout g, "ei_bxor_") }
        if o == ast.OP_SHL { put(inout g, "ei_shl_") }
        if o == ast.OP_SHR { put(inout g, "ei_shr_") }
        put(inout g, suffix(k))
        put(inout g, "(")
        op(inout g, p, s.b)
        put(inout g, ", ")
        op(inout g, p, s.c)
        if o == ast.OP_SHL || o == ast.OP_SHR {
            put(inout g, ", ")
            put_line(inout g, s.line)
        }
        put(inout g, ")")
        return
    }
    if o == ast.OP_EQ || o == ast.OP_NE {
        if o == ast.OP_NE { put(inout g, "!") }
        let a = op_text(inout g, p, s.b)
        let b = op_text(inout g, p, s.c)
        eq_expr(inout g, p, s.ty, a, b)
        return
    }
    let tk = ty_kind(p, s.ty)
    if tk == types.T_STRING || tk == types.T_STR {
        // byte order, which is Unicode scalar order for UTF-8
        put(inout g, "(strcmp(")
        op(inout g, p, s.b)
        if tk == types.T_STRING { put(inout g, ".p") }
        put(inout g, ", ")
        op(inout g, p, s.c)
        if tk == types.T_STRING { put(inout g, ".p") }
        put(inout g, ") ")
        put(inout g, ast.op_text(o))
        put(inout g, " 0)")
        return
    }
    if is_struct_kind(tk) {
        // Ord: derived lexicographically, or the type's own
        put(inout g, "(")
        let a = op_text(inout g, p, s.b)
        let b = op_text(inout g, p, s.c)
        cmp_expr(inout g, p, s.ty, a, b)
        put(inout g, " ")
        put(inout g, ast.op_text(o))
        put(inout g, " 0)")
        return
    }
    let fixed = fixed_cmp(p, o, s.b, s.c, s.ty)
    if fixed == 1 {
        put(inout g, "false")
        return
    }
    if fixed == 2 {
        put(inout g, "true")
        return
    }
    put(inout g, "(")
    op(inout g, p, s.b)
    put(inout g, " ")
    put(inout g, ast.op_text(o))
    put(inout g, " ")
    op(inout g, p, s.c)
    put(inout g, ")")
}

/// `x as target`: the runtime's range checks, then a cast of the in-range value.
fn cast(inout g: G, p: P, s: ir.Stmt) {
    let from = types.ik(p.t, ir.op_ty(p.ir, s.a))
    let to = types.ik(p.t, s.ty)
    put(inout g, "(")
    put(inout g, int_cty(to))
    put(inout g, ")")
    if types.signed(from) && types.signed(to) {
        put(inout g, "ei_s2s((int64_t)")
        op(inout g, p, s.a)
        if to == types.IK_I32 { put(inout g, ", INT32_MIN, INT32_MAX, ") } else { put(inout g, ", INT64_MIN, INT64_MAX, ") }
    } else if types.signed(from) {
        put(inout g, "ei_s2u((int64_t)")
        op(inout g, p, s.a)
        put(inout g, ", ")
        int_lit(inout g, types.IK_U64, kmax(to))
        put(inout g, ", ")
    } else if types.signed(to) {
        put(inout g, "ei_u2s((uint64_t)")
        op(inout g, p, s.a)
        if to == types.IK_I32 { put(inout g, ", INT32_MAX, ") } else { put(inout g, ", INT64_MAX, ") }
    } else {
        put(inout g, "ei_u2u((uint64_t)")
        op(inout g, p, s.a)
        put(inout g, ", ")
        int_lit(inout g, types.IK_U64, kmax(to))
        put(inout g, ", ")
    }
    put_line(inout g, s.line)
    put(inout g, ")")
}

fn print(inout g: G, p: P, s: ir.Stmt) {
    let t = types.get(p.t, s.ty)
    if !plain_show(p, s.ty) {
        // through Show: the text, then the line
        put(inout g, "{ ei_String s_ = ei_str_from(\"\"); ")
        let v = op_text(inout g, p, s.a)
        show_into(inout g, p, s.ty, sys.lit("&s_"), v, false)
        put(inout g, "; ei_print_s(s_.p); ei_drop_String(&s_); }")
        return
    }
    if t.kind == types.T_INT && types.signed(t.a) {
        put(inout g, "ei_print_i((int64_t)")
    } else if t.kind == types.T_INT {
        put(inout g, "ei_print_u((uint64_t)")
    } else if t.kind == types.T_BOOL {
        put(inout g, "ei_print_b(")
    } else if t.kind == types.T_STR {
        put(inout g, "ei_print_s(")
    } else if t.kind == types.T_STRING {
        put(inout g, "ei_print_s(")
        op(inout g, p, s.a)
        put(inout g, ".p)")
        return
    } else {
        need(inout g, GK_NAME, s.ty)
        put(inout g, "ei_print_s(")
        gname(inout g, p, "name_", s.ty)
        put(inout g, "(")
        op(inout g, p, s.a)
        put(inout g, ".tag))")
        return
    }
    op(inout g, p, s.a)
    put(inout g, ")")
}

/// `dst = ` for a builtin with a result (`(void)` when the result is discarded).
fn bdst(inout g: G, p: P, s: ir.Stmt) {
    if s.dst != NONE {
        dst(inout g, p, s.dst)
    } else if !is_void(p, s.ty) {
        put(inout g, "(void)")
    }
}

/// An Option value: `(O){ .tag = <Some>, .u.v<Some>.f0 = <val> }`, or None when val is empty.
fn option_lit(inout g: G, p: P, oty: u32, val: List[u8]) {
    put(inout g, "(")
    cty(inout g, p, oty)
    put(inout g, "){ .tag = ")
    if val.len() == 0 {
        putn(inout g, none_idx(p, oty) as u64)
    } else {
        let si = some_idx(p, oty)
        putn(inout g, si as u64)
        put(inout g, ", .u.v")
        putn(inout g, si as u64)
        put(inout g, ".f0 = ")
        putb(inout g, val)
    }
    put(inout g, " }")
}

/// B_MAP_KEYS, B_MAP_VALUES and B_MAP_ENTRIES: a new List of copies of the keys, values or
/// (key, value) pairs, in slot order (docs/compiler.md, "C8.20"):
/// `{ const M *m_ = &m; L l_ = {0}; for (i < cap) if (slot i used) push_L(&l_, copy); dst = l_; }`
fn map_lists(inout g: G, p: P, s: ir.Stmt) {
    let b = s.a
    let x = barg(p, s, 0)
    let mt = arg_ty(p, x)
    let t = types.get(p.t, mt)
    let el = types.get(p.t, s.ty).a
    need(inout g, GK_PUSH, s.ty)
    put(inout g, "{ const ")
    cty(inout g, p, mt)
    put(inout g, " *m_ = ")
    arg_ptr(inout g, p, x)
    put(inout g, "; ")
    cty(inout g, p, s.ty)
    put(inout g, " l_ = {0}; for (uint64_t i_ = 0; i_ < m_->cap; i_++) if (m_->s[i_] == 1) ")
    gname(inout g, p, "push_", s.ty)
    put(inout g, "(&l_, ")
    if b == ir.B_MAP_KEYS {
        clone_expr(inout g, p, t.a, sys.lit("&m_->k[i_]"))
    } else if b == ir.B_MAP_VALUES {
        clone_expr(inout g, p, t.b, sys.lit("&m_->v[i_]"))
    } else {
        put(inout g, "(")
        cty(inout g, p, el)
        put(inout g, "){ .f0 = ")
        clone_expr(inout g, p, t.a, sys.lit("&m_->k[i_]"))
        put(inout g, ", .f1 = ")
        clone_expr(inout g, p, t.b, sys.lit("&m_->v[i_]"))
        put(inout g, " }")
    }
    put(inout g, "); ")
    if s.dst != NONE {
        bdst(inout g, p, s)
        put(inout g, "l_; }")
    } else {
        drop_call(inout g, p, s.ty, sys.lit("&l_"))
        put(inout g, "}")
    }
}

/// B_COPY, B_COMPARE, B_HASH, B_SHOW and B_TO_STRING ("operation traits").
fn trait_builtin(inout g: G, p: P, s: ir.Stmt) {
    let b = s.a
    if b == ir.B_SHOW {
        let x = barg(p, s, 1)
        let mut o = sys.lit("&")
        let mark = g.o.len()
        arg_val(inout g, p, barg(p, s, 0))
        bytes.append(inout o, cut(inout g, mark))
        let m2 = g.o.len()
        arg_val(inout g, p, x)
        let v = cut(inout g, m2)
        show_into(inout g, p, arg_ty(p, x), o, v, false)
        return
    }
    let x = barg(p, s, 0)
    let ty = arg_ty(p, x)
    let mark = g.o.len()
    arg_val(inout g, p, x)
    let v = cut(inout g, mark)
    if b == ir.B_TO_STRING {
        if s.dst == NONE {
            put(inout g, "{ ei_String s_ = ei_str_from(\"\"); ")
            show_into(inout g, p, ty, sys.lit("&s_"), v, false)
            put(inout g, "; ei_drop_String(&s_); }")
            return
        }
        let m2 = g.o.len()
        local_ref(inout g, p, s.dst)
        let d = cut(inout g, m2)
        putb(inout g, d)
        put(inout g, " = ei_str_from(\"\"); ")
        let mut o = sys.lit("&")
        bytes.append(inout o, d)
        show_into(inout g, p, ty, o, v, false)
        return
    }
    bdst(inout g, p, s)
    if b == ir.B_COPY {
        let mut ptr = sys.lit("&")
        bytes.append(inout ptr, v)
        if g.prof > 0 {
            // a comma expression: the copy is still the value assigned
            put(inout g, "(ei_prof_ev(EI_PEV_COPY, sizeof(")
            cty(inout g, p, ty)
            put(inout g, ")), ")
        }
        copy_expr(inout g, p, ty, ptr)
        if g.prof > 0 { put(inout g, ")") }
    } else if b == ir.B_HASH {
        hash_text(inout g, p, ty, v)
    } else {
        // compare: Ordering's Less, Equal, Greater are tags 0, 1, 2
        let m3 = g.o.len()
        arg_val(inout g, p, barg(p, s, 1))
        let w = cut(inout g, m3)
        put(inout g, "(")
        cty(inout g, p, s.ty)
        put(inout g, "){ .tag = (uint32_t)(")
        let k = ty_kind(p, ty)
        if k == types.T_STR || k == types.T_STRING {
            put(inout g, "(")
            cmp_expr(inout g, p, ty, v, w)
            put(inout g, " > 0) - (")
            cmp_expr(inout g, p, ty, v, w)
            put(inout g, " < 0)")
        } else {
            cmp_expr(inout g, p, ty, v, w)
        }
        put(inout g, " + 1) }")
    }
}

fn builtin(inout g: G, p: P, s: ir.Stmt, depth: u32) {
    let b = s.a
    if b == ir.B_STR_FROM || b == ir.B_STR_FROM_INT {
        bdst(inout g, p, s)
        if b == ir.B_STR_FROM { put(inout g, "ei_str_from(") } else { put(inout g, "ei_str_from_i64(") }
        arg_val(inout g, p, barg(p, s, 0))
        put(inout g, ")")
    } else if (b == ir.B_LEN || b == ir.B_IS_EMPTY) && ty_kind(p, arg_ty(p, barg(p, s, 0))) == types.T_STR {
        bdst(inout g, p, s)
        if b == ir.B_LEN { put(inout g, "(uint64_t)strlen(") } else { put(inout g, "(*(") }
        arg_val(inout g, p, barg(p, s, 0))
        if b == ir.B_LEN { put(inout g, ")") } else { put(inout g, ") == 0)") }
    } else if b == ir.B_DEFAULT {
        bdst(inout g, p, s)
        default_expr(inout g, p, s.ty)
    } else if b >= ir.B_REF_NEW {
        ref_builtin(inout g, p, s)
    } else if b >= ir.B_MAP_KEYS {
        map_lists(inout g, p, s)
    } else if b >= ir.B_COPY {
        trait_builtin(inout g, p, s)
    } else if b >= ir.B_STR_BYTE {
        text_builtin(inout g, p, s)
    } else if b == ir.B_LEN || b == ir.B_IS_EMPTY {
        bdst(inout g, p, s)
        put(inout g, "(")
        arg_val(inout g, p, barg(p, s, 0))
        if b == ir.B_LEN { put(inout g, ").len") } else { put(inout g, ").len == 0") }
    } else if b == ir.B_STR_PUSH {
        put(inout g, "ei_str_push(")
        arg_ptr(inout g, p, barg(p, s, 0))
        put(inout g, ", ")
        arg_val(inout g, p, barg(p, s, 1))
        put(inout g, ")")
    } else if b == ir.B_STR_APPEND {
        put(inout g, "ei_str_append(")
        arg_ptr(inout g, p, barg(p, s, 0))
        put(inout g, ", ")
        arg_ptr(inout g, p, barg(p, s, 1))
        put(inout g, ")")
    } else if b == ir.B_LIST_NEW || b == ir.B_MAP_NEW {
        bdst(inout g, p, s)
        put(inout g, "(")
        cty(inout g, p, s.ty)
        put(inout g, "){0}")
    } else if b == ir.B_BOX_NEW {
        need(inout g, GK_NEW, s.ty)
        bdst(inout g, p, s)
        gname(inout g, p, "new_", s.ty)
        put(inout g, "(")
        arg_val(inout g, p, barg(p, s, 0))
        put(inout g, ")")
    } else if b >= ir.B_SPAWN {
        thread_builtin(inout g, p, s)
    } else if b == ir.B_LIST_PUSH || b == ir.B_LIST_CONTAINS {
        let lt = arg_ty(p, barg(p, s, 0))
        if b == ir.B_LIST_PUSH {
            need(inout g, GK_PUSH, lt)
            gname(inout g, p, "push_", lt)
        } else {
            need(inout g, GK_HAS, lt)
            bdst(inout g, p, s)
            gname(inout g, p, "has_", lt)
        }
        put(inout g, "(")
        arg_ptr(inout g, p, barg(p, s, 0))
        put(inout g, ", ")
        arg_val(inout g, p, barg(p, s, 1))
        put(inout g, ")")
    } else if b == ir.B_LIST_POP {
        // uniq(&l); if (l.len == 0) dst = None; else dst = Some(l.d[--l.len])
        let mark = g.o.len()
        arg_val(inout g, p, barg(p, s, 0))
        let l = cut(inout g, mark)
        let mut lp = sys.lit("&")
        bytes.append(inout lp, l)
        uniq_call(inout g, p, arg_ty(p, barg(p, s, 0)), lp)
        put(inout g, ";\n")
        ind(inout g, depth)
        put(inout g, "if (")
        putb(inout g, l)
        put(inout g, ".len == 0) ")
        bdst(inout g, p, s)
        option_lit(inout g, p, s.ty, List.new())
        put(inout g, "; else ")
        bdst(inout g, p, s)
        let mut v = l.copy()
        bytes.append(inout v, sys.lit(".d[--"))
        bytes.append(inout v, l)
        bytes.append(inout v, sys.lit(".len]"))
        option_lit(inout g, p, s.ty, v)
    } else if b == ir.B_LIST_CLEAR {
        let lt = arg_ty(p, barg(p, s, 0))
        need(inout g, GK_DROP, lt)
        gname(inout g, p, "drop_", lt)
        put(inout g, "(")
        arg_ptr(inout g, p, barg(p, s, 0))
        put(inout g, ")")
    } else if b == ir.B_LIST_SUM {
        let mark = g.o.len()
        arg_val(inout g, p, barg(p, s, 0))
        let l = cut(inout g, mark)
        let k = types.ik(p.t, s.ty)
        dst(inout g, p, s.dst)
        put(inout g, "0;\n")
        ind(inout g, depth)
        put(inout g, "for (uint64_t i = 0; i < ")
        putb(inout g, l)
        put(inout g, ".len; i++) ")
        dst(inout g, p, s.dst)
        put(inout g, "ei_add_")
        put(inout g, suffix(k))
        put(inout g, "(")
        local_ref(inout g, p, s.dst)
        put(inout g, ", ")
        putb(inout g, l)
        put(inout g, ".d[i], ")
        put_line(inout g, s.line)
        put(inout g, ")")
    } else if b == ir.B_MAP_GET {
        // { V *q = get_M(&m, k); if (q) dst = Some(*q); else dst = None; }
        let mt = arg_ty(p, barg(p, s, 0))
        need(inout g, GK_GET, mt)
        put(inout g, "{ ")
        cty(inout g, p, types.get(p.t, mt).b)
        put(inout g, " *q = ")
        gname(inout g, p, "get_", mt)
        put(inout g, "(")
        arg_ptr(inout g, p, barg(p, s, 0))
        put(inout g, ", ")
        arg_val(inout g, p, barg(p, s, 1))
        put(inout g, "); if (q) ")
        bdst(inout g, p, s)
        option_lit(inout g, p, s.ty, sys.lit("*q"))
        put(inout g, "; else ")
        bdst(inout g, p, s)
        option_lit(inout g, p, s.ty, List.new())
        put(inout g, "; }")
    } else {
        // insert, contains, remove
        let mt = arg_ty(p, barg(p, s, 0))
        if b == ir.B_MAP_INSERT {
            need(inout g, GK_INS, mt)
            gname(inout g, p, "ins_", mt)
        } else if b == ir.B_MAP_REMOVE {
            need(inout g, GK_REM, mt)
            bdst(inout g, p, s)
            gname(inout g, p, "rem_", mt)
        } else {
            need(inout g, GK_FIND, mt)
            bdst(inout g, p, s)
            put(inout g, "(")
            gname(inout g, p, "find_", mt)
        }
        put(inout g, "(")
        arg_ptr(inout g, p, barg(p, s, 0))
        put(inout g, ", ")
        arg_val(inout g, p, barg(p, s, 1))
        if b == ir.B_MAP_INSERT {
            put(inout g, ", ")
            arg_val(inout g, p, barg(p, s, 2))
        }
        put(inout g, ")")
        if b == ir.B_MAP_CONTAINS { put(inout g, " >= 0)") }
    }
}

/// S_CLOSURE: `{ env_F *e = ei_alloc(sizeof *e); e->c0 = ...; dst = (T){ e, F, edrop_F,
/// eclone_F, eown_F }; }` (no environment when nothing is captured).
fn closure(inout g: G, p: P, s: ir.Stmt) {
    let fname = g.fnn[s.a as usize].copy()
    if s.c == 0 {
        dst(inout g, p, s.dst)
        put(inout g, "(")
        cty(inout g, p, s.ty)
        put(inout g, "){ NULL, ")
        putb(inout g, fname)
        put(inout g, ", NULL, NULL, NULL }")
        return
    }
    need(inout g, GK_ENV, s.a)
    put(inout g, "{ env_")
    putb(inout g, fname)
    put(inout g, " *e = ei_alloc(sizeof *e);")
    for i in 0..s.c {
        put(inout g, " e->c")
        putn(inout g, i as u64)
        put(inout g, " = ")
        op(inout g, p, p.ir.extra[(s.b + i) as usize])
        put(inout g, ";")
    }
    put(inout g, " ")
    dst(inout g, p, s.dst)
    put(inout g, "(")
    cty(inout g, p, s.ty)
    put(inout g, "){ e, ")
    putb(inout g, fname)
    put(inout g, ", edrop_")
    putb(inout g, fname)
    put(inout g, ", eclone_")
    putb(inout g, fname)
    put(inout g, ", eown_")
    putb(inout g, fname)
    put(inout g, " }; }")
}

fn stmt(inout g: G, p: P, id: u32, depth: u32) {
    let s = p.ir.stmts[id as usize]
    let k = s.kind
    if k == ir.S_IF {
        ind(inout g, depth)
        put(inout g, "if (")
        op(inout g, p, s.a)
        put(inout g, ") {\n")
        block(inout g, p, s.b, depth + 1)
        ind(inout g, depth)
        if p.ir.blocks[s.c as usize].len > 0 {
            put(inout g, "} else {\n")
            block(inout g, p, s.c, depth + 1)
            ind(inout g, depth)
        }
        put(inout g, "}\n")
        return
    }
    if k == ir.S_LOOP {
        // for (;;) { body; s<n>: ; step } with `continue` as `goto s<n>`; a labeled
        // `continue` from a nested loop also goes to s<n>, a labeled `break` from one to
        // `b<m>:` after the loop
        let mut label = NONE
        let has_step = p.ir.blocks[s.b as usize].len > 0
        if (has_step && has_continue(p, s.a)) || exits_to(p, s.a, ir.S_CONTINUE, 0) {
            label = g.nlabels
            g.nlabels += 1
        }
        let mut blabel = NONE
        if exits_to(p, s.a, ir.S_BREAK, 0) {
            blabel = g.nlabels
            g.nlabels += 1
        }
        let target = if has_step || label != NONE { label } else { NONE }
        g.loops.push(target)
        g.brks.push(blabel)
        ind(inout g, depth)
        put(inout g, "for (;;) {\n")
        block(inout g, p, s.a, depth + 1)
        if label != NONE {
            ind(inout g, depth)
            put(inout g, "s")
            putn(inout g, label as u64)
            put(inout g, ":;\n")
        }
        block(inout g, p, s.b, depth + 1)
        ind(inout g, depth)
        put(inout g, "}\n")
        if blabel != NONE {
            ind(inout g, depth)
            put(inout g, "b")
            putn(inout g, blabel as u64)
            put(inout g, ":;\n")
        }
        g.loops.pop()
        g.brks.pop()
        return
    }
    let copies = k == ir.S_COPY || k == ir.S_READ || k == ir.S_MOVE || k == ir.S_CLONE
    if copies && is_void(p, loc(p, g, s.dst).ty) { return }
    if k == ir.S_DROP && !owns(inout g, p, s.ty) { return }
    if g.prof > 0 && prof_marks(p, s) { prof_line(inout g, s.line, depth) }
    // bounds checks of the places this statement uses
    if k == ir.S_READ || k == ir.S_STORE || k == ir.S_TAG || k == ir.S_MOVE || k == ir.S_DROP { checks(inout g, p, s.a, depth) }
    // a reference's place is checked when it is bound (docs/compiler.md, "C8.6")
    if k == ir.S_CHECK {
        checks(inout g, p, s.a, depth)
        return
    }
    if k == ir.S_CALL || k == ir.S_BUILTIN { arg_checks(inout g, p, s.b, s.c, depth) }
    // copy-on-write: the containers on the path to a place written into
    if k == ir.S_STORE || k == ir.S_MOVE || k == ir.S_DROP { uniqs(inout g, p, s.a, depth) }
    if k == ir.S_CALL || k == ir.S_CALLV { arg_uniqs(inout g, p, s.b, s.c, depth) }
    if k == ir.S_BUILTIN && mutates(s.a) && s.c > 0 { arg_uniqs(inout g, p, s.b, 1, depth) }
    ind(inout g, depth)
    if k == ir.S_COPY {
        dst(inout g, p, s.dst)
        op(inout g, p, s.a)
    } else if k == ir.S_READ || k == ir.S_MOVE {
        dst(inout g, p, s.dst)
        place(inout g, p, s.a)
    } else if k == ir.S_STORE {
        place(inout g, p, s.a)
        put(inout g, " = ")
        op(inout g, p, s.b)
    } else if k == ir.S_CLONE {
        dst(inout g, p, s.dst)
        let cty0 = ir.op_ty(p.ir, s.a)
        if owns(inout g, p, cty0) {
            let mut ptr = sys.lit("&")
            bytes.append(inout ptr, op_text(inout g, p, s.a))
            clone_expr(inout g, p, cty0, ptr)
        } else {
            op(inout g, p, s.a)
        }
    } else if k == ir.S_DROP {
        let mut ptr = sys.lit("&")
        bytes.append(inout ptr, place_text(inout g, p, s.a))
        drop_call(inout g, p, s.ty, ptr)
        // drop_call ends in "; "
        g.o.pop()
        g.o.pop()
    } else if k == ir.S_UNARY {
        dst(inout g, p, s.dst)
        if s.a == ir.U_NOT {
            put(inout g, "!")
            op(inout g, p, s.b)
        } else if s.a == ir.U_BNOT {
            put(inout g, "ei_bnot_")
            put(inout g, suffix(types.ik(p.t, s.ty)))
            put(inout g, "(")
            op(inout g, p, s.b)
            put(inout g, ")")
        } else {
            put(inout g, "ei_neg_")
            put(inout g, suffix(types.ik(p.t, s.ty)))
            put(inout g, "(")
            op(inout g, p, s.b)
            put(inout g, ", ")
            put_line(inout g, s.line)
            put(inout g, ")")
        }
    } else if k == ir.S_BINARY {
        dst(inout g, p, s.dst)
        binary(inout g, p, s)
    } else if k == ir.S_CAST {
        dst(inout g, p, s.dst)
        cast(inout g, p, s)
    } else if k == ir.S_CALL {
        if s.dst != ir.NONE { dst(inout g, p, s.dst) }
        fn_name(inout g, p, s.a)
        put(inout g, "(")
        args(inout g, p, s.b, s.c)
        put(inout g, ")")
    } else if k == ir.S_RECORD && shared_rec(p, s.ty) {
        need(inout g, GK_RNEW, s.ty)
        dst(inout g, p, s.dst)
        gname(inout g, p, "rnew_", s.ty)
        put(inout g, "(")
        args(inout g, p, s.b, s.c)
        put(inout g, ")")
    } else if k == ir.S_RECORD || k == ir.S_TUPLE {
        dst(inout g, p, s.dst)
        put(inout g, "(")
        cty(inout g, p, s.ty)
        put(inout g, "){")
        if s.c == 0 { put(inout g, "0") }
        for i in 0..s.c {
            if i > 0 { put(inout g, ",") }
            put(inout g, " .f")
            putn(inout g, i as u64)
            put(inout g, " = ")
            op(inout g, p, p.ir.extra[(s.b + i) as usize])
        }
        put(inout g, " }")
    } else if k == ir.S_VARIANT {
        dst(inout g, p, s.dst)
        put(inout g, "(")
        cty(inout g, p, s.ty)
        put(inout g, "){ .tag = ")
        putn(inout g, s.a as u64)
        for i in 0..s.c {
            put(inout g, ", .u.v")
            putn(inout g, s.a as u64)
            put(inout g, ".f")
            putn(inout g, i as u64)
            put(inout g, " = ")
            op(inout g, p, p.ir.extra[(s.b + i) as usize])
        }
        put(inout g, " }")
    } else if k == ir.S_ARRAY {
        dst(inout g, p, s.dst)
        put(inout g, "(")
        cty(inout g, p, s.ty)
        put(inout g, "){ {")
        for i in 0..s.c {
            if i > 0 { put(inout g, ",") }
            put(inout g, " ")
            op(inout g, p, p.ir.extra[(s.b + i) as usize])
        }
        put(inout g, " } }")
    } else if k == ir.S_REPEAT && s.b == 0 {
        put(inout g, "(void)0")
    } else if k == ir.S_REPEAT {
        put(inout g, "for (uint64_t i = 0; i < ")
        putn(inout g, s.b as u64)
        put(inout g, "; i++) ")
        local_ref(inout g, p, s.dst)
        put(inout g, ".a[i] = ")
        op(inout g, p, s.a)
    } else if k == ir.S_TAG {
        dst(inout g, p, s.dst)
        put(inout g, "(")
        place(inout g, p, s.a)
        put(inout g, ".tag == ")
        putn(inout g, s.b as u64)
        put(inout g, ")")
    } else if k == ir.S_PRINT {
        print(inout g, p, s)
    } else if k == ir.S_NOWMS {
        dst(inout g, p, s.dst)
        put(inout g, "ei_now_ms()")
    } else if k == ir.S_PANIC {
        put(inout g, "ei_trap(")
        op(inout g, p, s.a)
        put(inout g, ", ")
        put_line(inout g, s.line)
        put(inout g, ")")
    } else if k == ir.S_ASSERT {
        put(inout g, "if (!")
        op(inout g, p, s.a)
        put(inout g, ") ei_trap(")
        if s.b > 0 {
            str_lit(inout g.o, p.ir.strs[(s.b - 1) as usize])
        } else {
            put(inout g, "\"assertion failed\"")
        }
        put(inout g, ", ")
        put_line(inout g, s.line)
        put(inout g, ")")
    } else if k == ir.S_BUILTIN {
        builtin(inout g, p, s, depth)
    } else if k == ir.S_CLOSURE {
        closure(inout g, p, s)
    } else if k == ir.S_FNREF {
        need(inout g, GK_THUNK, s.a)
        dst(inout g, p, s.dst)
        put(inout g, "(")
        cty(inout g, p, s.ty)
        put(inout g, "){ NULL, k_")
        fn_name(inout g, p, s.a)
        put(inout g, ", NULL, NULL, NULL }")
    } else if k == ir.S_CALLV {
        if s.dst != ir.NONE { dst(inout g, p, s.dst) }
        let f = op_text(inout g, p, s.a)
        putb(inout g, f)
        put(inout g, ".call(")
        putb(inout g, f)
        put(inout g, ".env")
        if s.c > 0 { put(inout g, ", ") }
        args(inout g, p, s.b, s.c)
        put(inout g, ")")
    } else if k == ir.S_BREAK && s.a > 0 {
        put(inout g, "goto b")
        let bl = g.brks[g.brks.len() - 1 - s.a as usize].copy()
        putn(inout g, bl as u64)
    } else if k == ir.S_BREAK {
        put(inout g, "break")
    } else if k == ir.S_CONTINUE {
        let label = g.loops[g.loops.len() - 1 - s.a as usize].copy()
        if label == NONE {
            put(inout g, "continue")
        } else {
            put(inout g, "goto s")
            putn(inout g, label as u64)
        }
    } else {
        if g.pframe { put(inout g, "ei_prof_leave(); ") }
        put(inout g, "return")
        if s.a > 0 {
            put(inout g, " ")
            op(inout g, p, s.a - 1)
        }
    }
    put(inout g, ";\n")
}

// ---- functions and the program

fn signature(inout g: G, p: P, f: u32) {
    let fd = p.ir.fns[f as usize]
    let nc = g.ncap[f as usize].copy()
    let clo = g.clo[f as usize].copy()
    put(inout g, "static ")
    ret_cty(inout g, p, fd.ret)
    put(inout g, " ")
    fn_name(inout g, p, f)
    put(inout g, "(")
    // a closure body takes its environment first
    if clo { put(inout g, "void *env_") }
    if !clo && fd.nparams == 0 { put(inout g, "void") }
    g.lbase = fd.lstart
    for i in 0..fd.nparams {
        if i > 0 || clo { put(inout g, ", ") }
        let l = loc(p, g, nc + i)
        cty(inout g, p, l.ty)
        if l.kind == ir.L_INOUT { put(inout g, " *") } else { put(inout g, " ") }
        local_name(inout g, p, nc + i)
    }
    put(inout g, ")")
}

fn zero(p: P, ty: u32) -> str {
    let k = ty_kind(p, ty)
    if is_struct_kind(k) || k == types.T_STRING { return "{0}" }
    if k == types.T_BOOL { return "false" }
    if k == types.T_STR { return "\"\"" }
    "0"
}

fn function(inout g: G, p: P, f: u32) {
    let fd = p.ir.fns[f as usize]
    let nc = g.ncap[f as usize].copy()
    signature(inout g, p, f)
    put(inout g, " {\n")
    g.file = fd.file
    g.lbase = fd.lstart
    g.loops = List.new()
    g.brks = List.new()
    g.nlabels = 0
    if nc > 0 { need(inout g, GK_ENV, f) }
    for i in 0..fd.lcount {
        if i >= nc && i < nc + fd.nparams { continue }
        let l = loc(p, g, i)
        if is_void(p, l.ty) { continue }
        put(inout g, "  ")
        cty(inout g, p, l.ty)
        put(inout g, " ")
        local_name(inout g, p, i)
        put(inout g, " = ")
        if i < nc {
            // a capture: a borrow of the environment's copy
            put(inout g, "((env_")
            fn_name(inout g, p, f)
            put(inout g, " *)env_)->c")
            putn(inout g, i as u64)
        } else {
            put(inout g, zero(p, l.ty))
        }
        put(inout g, ";\n")
    }
    g.pframe = g.prof > 0 && framed(p, fd.body - 1)
    if g.pframe {
        put(inout g, "  ei_prof_frame *ei_pf = ei_prof_enter(")
        putn(inout g, (f + 1) as u64)
        put(inout g, ");\n  (void)ei_pf;\n")
    }
    block(inout g, p, fd.body - 1, 1)
    if g.pframe && is_void(p, fd.ret) { put(inout g, "  ei_prof_leave();\n") }
    g.pframe = false
    // every path of a function with a result returns; tell the C compiler so
    if !is_void(p, fd.ret) { put(inout g, "  ei_unreachable();\n") }
    put(inout g, "}\n\n")
}

/// EXTERN PROTOTYPES (FFI, docs/compiler.md "C7: FFI"): each `extern "c"` function, after
/// the includes and before any Eider type or function, under its own C name (`xc_<name>`,
/// see name_all) and bound to the C symbol with an asm label (core/ABI.md rule 5), so it
/// never clashes with, or depends on, C headers. Its types are C-safe (no struct types).
fn extern_protos(inout g: G, p: P) {
    if p.ir.externs.len() == 0 { return }
    put(inout g, "/* ---- extern \"c\" functions */\n")
    for x in p.ir.externs {
        let fd = p.ir.fns[x.f as usize]
        put(inout g, "extern ")
        ret_cty(inout g, p, fd.ret)
        put(inout g, " ")
        fn_name(inout g, p, x.f)
        put(inout g, "(")
        if x.params.len() == 0 { put(inout g, "void") }
        for i in 0..x.params.len() {
            if i > 0 { put(inout g, ", ") }
            cty(inout g, p, x.params[i])
        }
        put(inout g, ") __asm__(")
        str_lit(inout g.o, x.symbol)
        put(inout g, ");\n")
    }
    put(inout g, "\n")
}

/// `<ret> eider_<name>(<params>)` of export x.
fn export_sig(inout g: G, p: P, f: u32, name: List[u8]) {
    let fd = p.ir.fns[f as usize]
    g.lbase = fd.lstart
    ret_cty(inout g, p, fd.ret)
    put(inout g, " eider_")
    ident(inout g, name)
    put(inout g, "(")
    if fd.nparams == 0 { put(inout g, "void") }
    for i in 0..fd.nparams {
        if i > 0 { put(inout g, ", ") }
        let lt = loc(p, g, i).ty
        cty(inout g, p, lt)
        put(inout g, " ")
        local_name(inout g, p, i)
    }
    put(inout g, ")")
}

/// A library's entry points: `eider_<name>` for each `export fn`, calling it (a trap inside
/// exits the process with 101; trap messages name "lib", as tests/oracle expects). Records cross by
/// value; the header (`header`) declares the same layouts under the header's names. For
/// WebAssembly (`wasm`) each definition also exports itself under that name (export_name).
fn export_wrappers(inout g: G, p: P, wasm: bool) {
    put(inout g, "/* ---- exported entry points */\n")
    for x in p.ir.exports {
        export_sig(inout g, p, x.f, x.name)
        put(inout g, ";\n")
    }
    for x in p.ir.exports {
        let fd = p.ir.fns[x.f as usize]
        if wasm {
            put(inout g, "__attribute__((export_name(\"eider_")
            ident(inout g, x.name)
            put(inout g, "\"))) ")
        }
        export_sig(inout g, p, x.f, x.name)
        put(inout g, " {\n  ei_set_file(\"lib\");\n  ")
        files_table(inout g, p, true)
        if !is_void(p, fd.ret) { put(inout g, "return ") }
        fn_name(inout g, p, x.f)
        put(inout g, "(")
        for i in 0..fd.nparams {
            if i > 0 { put(inout g, ", ") }
            local_name(inout g, p, i)
        }
        put(inout g, ");\n}\n")
    }
}

/// The functions in output order: per module (entry first), generic instances by C name,
/// then tests. Each section starts with the comment to print before it (`hdr` index).
type Order = { fns: List[u32], hdrs: List[u32], titles: List[List[u8]] }

fn order(g: G, p: P) -> Order {
    let mut mods: List[List[u8]] = List.new()
    mods.push(List.new())
    let mut insts: List[u32] = List.new()
    for f in 0..p.ir.fns.len() {
        let fd = p.ir.fns[f]
        if fd.body == 0 || fd.is_test { continue }
        if is_instance(fd.name) {
            // insertion by C name
            insts.push(f as u32)
            let mut j = insts.len() - 1
            while j > 0 && bytes.compare(g.fnn[insts[j - 1] as usize], g.fnn[f]) > 0 {
                insts[j] = insts[j - 1]
                j -= 1
            }
            insts[j] = f as u32
            continue
        }
        let m = module_of(fd.name)
        let mut known = false
        for x in mods {
            if bytes.eq(x, m) { known = true }
        }
        if !known { mods.push(m) }
    }
    let mut o = Order(List.new(), List.new(), List.new())
    for m in mods {
        o.hdrs.push(o.fns.len() as u32)
        let mut t = sys.lit("module ")
        if m.len() == 0 { bytes.append(inout t, sys.lit("(entry)")) } else { bytes.append(inout t, m) }
        o.titles.push(t)
        for f in 0..p.ir.fns.len() {
            let fd = p.ir.fns[f]
            if fd.body == 0 || fd.is_test || is_instance(fd.name) { continue }
            if bytes.eq(module_of(fd.name), m) { o.fns.push(f as u32) }
        }
    }
    o.hdrs.push(o.fns.len() as u32)
    o.titles.push(sys.lit("generic instances"))
    for f in insts { o.fns.push(f) }
    o.hdrs.push(o.fns.len() as u32)
    o.titles.push(sys.lit("tests"))
    for f in 0..p.ir.fns.len() {
        let fd = p.ir.fns[f]
        if fd.body > 0 && fd.is_test { o.fns.push(f as u32) }
    }
    o
}

fn section(inout g: G, o: Order, i: usize) {
    for h in 0..o.hdrs.len() {
        if o.hdrs[h] as usize == i {
            put(inout g, "/* ---- ")
            putb(inout g, o.titles[h])
            put(inout g, " */\n")
        }
    }
}

/// The C program for `p`: `main` calls the Eider `main`, or (tests = true) runs every test
/// block, with the recorded test-driver output. `file` is the source path named in trap messages.
/// Fails (with the message) only on a C name clash.
pub fn program(p: P, file: List[u8], tests: bool) -> Result[List[u8], List[u8]] { program_for(p, file, tests, false) }

/// The C for `p` as a program, or (lib = true) as a library: no `main`, a C entry point per
/// `export fn` (export_wrappers).
pub fn program_for(p: P, file: List[u8], tests: bool, lib: bool) -> Result[List[u8], List[u8]] { emit(p, file, tests, lib, false, 0, List.new(), List.new()) }

/// `program_for` built for the profiler (`--profile`; `what` is PROF_CPU | PROF_MEM | PROF_CONC,
/// never 0): the same program with the shadow stack, the event hooks and the name table;
/// `version` is the toolchain's, which the profile records.
pub fn program_prof(p: P, file: List[u8], tests: bool, what: u32, version: List[u8]) -> Result[List[u8], List[u8]] { emit(p, file, tests, false, false, what, version, List.new()) }

/// The C for `p` as a WebAssembly module: a library whose entry points are the module's
/// exports (compiled against core/wasm by wasm.ei).
pub fn program_wasm(p: P, file: List[u8]) -> Result[List[u8], List[u8]] { emit(p, file, false, true, true, 0, List.new(), List.new()) }

/// The C half of a program whose functions with `native[f]` are emitted by another backend
/// (llvm.ei; docs/compiler.md, "Backends"): those have only a prototype, and every function
/// and glue item has external linkage (no `static` at the start of a line), so the other
/// half calls them and they call it through the C ABI. The other backend names the glue
/// its functions call (`needs`: glue keys, GK_* * 2^32 + id) and the modules whose trap
/// lines they encode (`files`), so their bodies aren't lowered here at all.
pub fn program_split(p: P, file: List[u8], tests: bool, lib: bool, native: List[bool], needs: List[u64], files: List[u32]) -> Result[List[u8], List[u8]] {
    let c = emit_split(p, file, tests, lib, native, needs, files)?
    let mut out: List[u8] = List.new()
    let st = sys.lit("static ")
    let mut i: usize = 0
    while i < c.len() {
        let line_start = i == 0 || c[i - 1] == 10
        if line_start && i + 7 <= c.len() && bytes.eq(bytes.slice(c, i, i + 7), st) {
            i += 7
        } else {
            out.push(c[i])
            i += 1
        }
    }
    Ok(out)
}

/// The C names lowering gives every type (`tys`; empty for types that are not C structs) and
/// function (`fns`; `xc_<name>` for `extern "c"` ones), for another backend that links
/// against program_split's C.
pub type Names = { tys: List[List[u8]], fns: List[List[u8]] }

pub fn c_names(p: P) -> Result[Names, List[u8]] {
    let mut g = G(List.new(), 0, List.new(), 0, List.new(), List.new(), List.new(), List.new(), List.new(), List.new(), Map.new(), List.new(), List.new(), Map.new(), List.new(), List.new(), List.new(), 0, List.new(), List.new(), 0, NONE, false, List.new(), List.new())
    name_all(inout g, p)
    if g.err.len() > 0 { return Err(g.err) }
    Ok(Names(g.tn, g.fnn))
}


/// C `main` for the Eider `main` (function f) by its result (docs/compiler.md, "C8.2: small
/// language gaps"): () exits 0; an i32 is the exit code (outside 0..255 it traps at main's
/// line); a Result[(), E]'s Err prints `error: <the error>` (or `error: main returned Err`
/// when E can't be printed) to stderr, is dropped, and exits 1. It is `ei_main_body`, which
/// C `main` hands to the runtime's `ei_main` to run on a guarded thread (core/RUNTIME.md
/// "Stack overflow").
fn main_body(inout g: G, p: P, file: List[u8], f: u32) {
    files_table(inout g, p, false)
    if g.prof > 0 { prof_table(inout g, p, file) }
    put(inout g, "static int ei_main_body(void) {\n  ei_set_file(")
    str_lit(inout g.o, file)
    put(inout g, ");\n  ")
    files_table(inout g, p, true)
    if g.prof > 0 { put(inout g, "ei_prof_init(&ei_prof_tab);\n  ") }
    let rt = p.ir.fns[f as usize].ret
    let rk = ty_kind(p, rt)
    if rk == types.T_INT {
        put(inout g, "int32_t code = ")
        fn_name(inout g, p, f)
        put(inout g, "();\n  if (code < 0 || code > 255) ei_trap(\"exit code out of range\", ")
        putn(inout g, p.ir.main_line as u64)
        put(inout g, ");\n  ei_check_leaks();\n  return (int)code;\n}\n")
        return
    }
    if rk != types.T_ENUM {
        fn_name(inout g, p, f)
        put(inout g, "();\n  ei_check_leaks();\n  return 0;\n}\n")
        return
    }
    cty(inout g, p, rt)
    put(inout g, " r = ")
    fn_name(inout g, p, f)
    put(inout g, "();\n  if (r.tag == 1) {\n    fflush(stdout);\n    ")
    let d = types.def_of(p.t, rt)
    let et = types.field(p.t, types.variant(p.t, d, 1).fstart, 0).ty
    let e = types.get(p.t, et)
    if e.kind == types.T_INT && types.signed(e.a) {
        put(inout g, "fprintf(stderr, \"error: %\" PRId64 \"\\n\", (int64_t)r.u.v1.f0);")
    } else if e.kind == types.T_INT {
        put(inout g, "fprintf(stderr, \"error: %\" PRIu64 \"\\n\", (uint64_t)r.u.v1.f0);")
    } else if e.kind == types.T_BOOL {
        put(inout g, "fprintf(stderr, \"error: %s\\n\", r.u.v1.f0 ? \"true\" : \"false\");")
    } else if e.kind == types.T_STR {
        put(inout g, "fprintf(stderr, \"error: %s\\n\", r.u.v1.f0);")
    } else if e.kind == types.T_STRING {
        put(inout g, "fprintf(stderr, \"error: %s\\n\", r.u.v1.f0.p);")
    } else if e.kind == types.T_ENUM && !types.def_of(p.t, et).payload {
        need(inout g, GK_NAME, et)
        put(inout g, "fprintf(stderr, \"error: %s\\n\", ")
        gname(inout g, p, "name_", et)
        put(inout g, "(r.u.v1.f0.tag));")
    } else {
        put(inout g, "fprintf(stderr, \"error: main returned Err\\n\");")
    }
    put(inout g, "\n    ")
    drop_call(inout g, p, rt, sys.lit("&r"))
    put(inout g, "\n    ei_check_leaks();\n    return 1;\n  }\n  ei_check_leaks();\n  return 0;\n}\n")
}

fn emit(p: P, file: List[u8], tests: bool, lib: bool, wasm: bool, what: u32, version: List[u8], native: List[bool]) -> Result[List[u8], List[u8]] {
    emit_with(p, file, tests, lib, wasm, what, version, native, List.new(), List.new())
}

fn emit_split(p: P, file: List[u8], tests: bool, lib: bool, native: List[bool], needs: List[u64], files: List[u32]) -> Result[List[u8], List[u8]] {
    emit_with(p, file, tests, lib, false, 0, List.new(), native, needs, files)
}

fn emit_with(p: P, file: List[u8], tests: bool, lib: bool, wasm: bool, what: u32, version: List[u8], native: List[bool], needs: List[u64], files: List[u32]) -> Result[List[u8], List[u8]] {
    let mut g = G(List.new(), 0, List.new(), 0, List.new(), List.new(), List.new(), List.new(), List.new(), List.new(), Map.new(), List.new(), List.new(), Map.new(), List.new(), List.new(), List.new(), 0, List.new(), List.new(), what, NONE, false, version, native)
    name_all(inout g, p)
    if g.err.len() > 0 { return Err(g.err) }
    let ord = order(g, p)
    // functions first, so the glue they need is known
    let mut main_fn = NONE
    for i in 0..ord.fns.len() {
        section(inout g, ord, i)
        let f = ord.fns[i]
        let fd = p.ir.fns[f as usize]
        if !fd.is_test && bytes.eq(fd.name, sys.lit("main")) { main_fn = f }
        // another backend's function: only its prototype (below); the glue it calls and the
        // trap files it uses come from that backend (`needs`, `files`)
        if (f as usize) < g.native.len() && g.native[f as usize] { continue }
        function(inout g, p, f)
    }
    for k in needs {
        if g.seen.contains(k) { continue }
        g.seen.insert(k, true)
        g.need.push(k)
    }
    for fi in files {
        if !g.files.contains(fi) { g.files.push(fi) }
    }
    g.file = 0
    if lib {
        files_table(inout g, p, false)
        export_wrappers(inout g, p, wasm)
    } else if tests {
        files_table(inout g, p, false)
        if g.prof > 0 { prof_table(inout g, p, file) }
        put(inout g, "static int ei_main_body(void) {\n  volatile int total = 0, failed = 0;\n  jmp_buf jb;\n  ei_set_trap_jmp(&jb);\n  ei_set_file(")
        str_lit(inout g.o, file)
        put(inout g, ");\n")
        if g.prof > 0 { put(inout g, "  ei_prof_init(&ei_prof_tab);\n") }
        if g.files.len() > 0 {
            put(inout g, "  ")
            files_table(inout g, p, true)
            put(inout g, "\n")
        }
        for f in ord.fns {
            let fd = p.ir.fns[f as usize]
            if !fd.is_test { continue }
            put(inout g, "  total++;\n  printf(\"test %s ... \", ")
            str_lit(inout g.o, fd.name)
            put(inout g, ");\n  fflush(stdout);\n  if (setjmp(jb) == 0) {\n    ")
            fn_name(inout g, p, f)
            put(inout g, "();\n    printf(\"ok\\n\");\n  } else {\n    failed++;\n")
            // a failed test longjmps past its frames' pops
            if g.prof > 0 { put(inout g, "    ei_prof_unwind(0);\n") }
            put(inout g, "  }\n")
        }
        put(inout g, "  printf(\"\\n%d tests, %d failed\\n\", total, failed);\n  if (!failed) ei_check_leaks();\n  return failed ? 1 : 0;\n}\n")
        // the body runs on a guarded runtime thread (core/RUNTIME.md "Stack overflow")
        put(inout g, "int main(void) { return ei_main(ei_main_body); }\n")
    } else {
        main_body(inout g, p, file, main_fn)
        put(inout g, "int main(void) { return ei_main(ei_main_body); }\n")
    }
    let fns_text = g.o.copy()
    // shared glue, until nothing new is needed
    g.o = List.new()
    let mut gi: usize = 0
    while gi < g.need.len() {
        let key = g.need[gi].copy()
        glue(inout g, p, key)
        gi += 1
    }
    let glue_text = g.o.copy()
    // prototypes of the functions, in output order
    g.o = List.new()
    for f in ord.fns {
        signature(inout g, p, f)
        put(inout g, ";\n")
    }
    let protos = g.o.copy()
    // the header, extern prototypes and types
    g.o = List.new()
    put(inout g, "/* generated by eiderc from ")
    for b in file {
        // keep the comment closed whatever the path contains
        if b != 42 && b >= 32 && b < 127 { g.o.push(b) }
    }
    put(inout g, " */\n#include <stdio.h>\n#include \"eider_rt.h\"\n\n")
    if g.prof > 0 {
        // first, so the runtime's header sees it (and the driver links the profiling runtime)
        let mut text = sys.lit("#define EI_RT_PROFILE 1\n")
        bytes.append(inout text, g.o)
        g.o = text
    }
    extern_protos(inout g, p)
    put(inout g, "/* ---- types */\n")
    for ty in 0..p.t.tys.len() {
        let n = g.tn[ty].copy()
        if n.len() == 0 { continue }
        put(inout g, "typedef struct ")
        putb(inout g, n)
        put(inout g, " ")
        putb(inout g, n)
        put(inout g, ";\n")
    }
    let mut done: Map[u32, bool] = Map.new()
    for ty in 0..p.t.tys.len() { def_ty(inout g, p, ty as u32, inout done) }
    handle_bodies(inout g, p)
    let envs = g.envs.copy()
    putb(inout g, envs)
    put(inout g, "\n/* ---- prototypes */\n")
    let pr = g.pr.copy()
    putb(inout g, pr)
    putb(inout g, protos)
    put(inout g, "\n/* ---- shared glue */\n")
    putb(inout g, glue_text)
    put(inout g, "\n")
    putb(inout g, fns_text)
    Ok(g.o)
}

// ---- the library header (docs/compiler.md, "C7: FFI"). It spells types as the recorded
// header does (`R_<mangled>` records with `f_<field>` members), so it is byte-identical
// to the header tests/oracle records; the layouts equal the C's `t_` structs, which is all the ABI needs.

/// The C name of a type's spelling (the mangling the recorded headers use).
fn mangle(inout out: List[u8], s: List[u8]) {
    for b in s {
        if bytes.is_ident(b) {
            out.push(b)
        } else if b == 91 {
            bytes.append(inout out, sys.lit("_L"))
        } else if b == 93 {
            bytes.append(inout out, sys.lit("_R"))
        } else if b == 44 {
            bytes.append(inout out, sys.lit("_C"))
        } else if b == 59 {
            bytes.append(inout out, sys.lit("_S"))
        } else if b == 40 {
            bytes.append(inout out, sys.lit("_P"))
        } else if b == 41 {
            bytes.append(inout out, sys.lit("_Q"))
        } else if b == 45 {
            bytes.append(inout out, sys.lit("_m"))
        } else if b == 62 {
            bytes.append(inout out, sys.lit("_g"))
        } else if b != 32 {
            out.push(95)
        }
    }
}

/// A type as the header spells it (records are `R_<mangled name>`).
fn h_ty(inout out: List[u8], p: P, ty: u32) {
    let k = ty_kind(p, ty)
    if k == types.T_INT {
        bytes.append(inout out, sys.lit(int_cty(types.ik(p.t, ty))))
    } else if k == types.T_BOOL {
        bytes.append(inout out, sys.lit("bool"))
    } else if k == types.T_STR {
        bytes.append(inout out, sys.lit("const char*"))
    } else if k == types.T_RECORD {
        bytes.append(inout out, sys.lit("R_"))
        mangle(inout out, resolve.shown(types.show(p.t, p.names, ty)))
    } else {
        bytes.append(inout out, sys.lit("void"))
    }
}

/// A record and the records in it, each once, in dependency order. Each gets its typedef
/// (deliberately: the recorded header gave one only to parameter and return records, so it
/// did not compile when a record is a field of another).
fn h_def(inout out: List[u8], p: P, ty: u32, inout done: Map[u32, bool]) {
    if ty_kind(p, ty) != types.T_RECORD || done.contains(ty) { return }
    done.insert(ty, true)
    let mut name: List[u8] = List.new()
    h_ty(inout name, p, ty)
    bytes.append(inout out, sys.lit("typedef struct "))
    bytes.append(inout out, name)
    out.push(32)
    bytes.append(inout out, name)
    bytes.append(inout out, sys.lit(";\n"))
    let d = types.def_of(p.t, ty)
    for i in 0..d.len { h_def(inout out, p, types.field(p.t, d.start, i).ty, inout done) }
    bytes.append(inout out, sys.lit("struct "))
    bytes.append(inout out, name)
    bytes.append(inout out, sys.lit(" {"))
    for i in 0..d.len {
        let fl = types.field(p.t, d.start, i)
        out.push(32)
        h_ty(inout out, p, fl.ty)
        bytes.append(inout out, sys.lit(" f_"))
        bytes.append(inout out, intern.name(p.names, fl.name))
        out.push(59)
    }
    bytes.append(inout out, sys.lit(" };\n"))
}

/// The include guard of library `name`'s header: `EIDER_<NAME>_H`, the name upper-cased
/// with every byte that isn't a letter or digit as `_` (`geo-utils` -> `EIDER_GEO_UTILS_H`),
/// so the headers of two libraries can be included in one C file.
pub fn header_guard(name: List[u8]) -> List[u8] {
    let mut g = sys.lit("EIDER_")
    for b in name {
        if b >= 97 && b <= 122 {
            g.push(b - 32)
        } else if (b >= 65 && b <= 90) || (b >= 48 && b <= 57) {
            g.push(b)
        } else {
            g.push(95)
        }
    }
    bytes.append(inout g, sys.lit("_H"))
    g
}

/// The C (and C++) header of library `name` (driver.lib_name): its records and an
/// `eider_<name>` prototype per `export fn` (`emit-header`, `build --lib`), guarded by
/// header_guard(name).
pub fn header(p: P, name: List[u8]) -> List[u8] {
    let guard = header_guard(name)
    let mut out = sys.lit("/* generated by eider: C interface */\n#ifndef ")
    bytes.append(inout out, guard)
    bytes.append(inout out, sys.lit("\n#define "))
    bytes.append(inout out, guard)
    bytes.append(inout out, sys.lit("\n#include <stdint.h>\n#include <stdbool.h>\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n"))
    let mut done: Map[u32, bool] = Map.new()
    let mut protos: List[u8] = List.new()
    for x in p.ir.exports {
        let fd = p.ir.fns[x.f as usize]
        let ls = fd.lstart as usize
        for i in 0..fd.nparams { h_def(inout out, p, p.ir.locals[ls + i as usize].ty, inout done) }
        h_def(inout out, p, fd.ret, inout done)
        h_ty(inout protos, p, fd.ret)
        bytes.append(inout protos, sys.lit(" eider_"))
        bytes.append(inout protos, x.name)
        protos.push(40)
        if fd.nparams == 0 { bytes.append(inout protos, sys.lit("void")) }
        for i in 0..fd.nparams {
            if i > 0 { bytes.append(inout protos, sys.lit(", ")) }
            let l = p.ir.locals[ls + i as usize]
            h_ty(inout protos, p, l.ty)
            protos.push(32)
            bytes.append(inout protos, intern.name(p.names, l.name))
        }
        bytes.append(inout protos, sys.lit(");\n"))
    }
    bytes.append(inout out, protos)
    bytes.append(inout out, sys.lit("#ifdef __cplusplus\n}\n#endif\n#endif\n"))
    out
}

// ---- threads (docs/compiler.md, "C7: threads")
//
// A Task[T], Mutex[T] or Chan[T] value is a handle `{ struct <name>_c *p; }` to a shared
// object holding the runtime's reference count (core/eider_rt.h `ei_rc`) and its thread,
// mutex or channel. Everything that needs a lock, a thread or a condition variable is a
// runtime call; the glue here only adds the typed payload:
//   struct tk_<h>_c { ei_rc rc; ei_thread th; F f; T r; }   F = fn() -> T; no r for ()
//   struct tx_<h>_c { ei_rc rc; ei_mutex mu; T v; }
//   struct tc_<h>_c { ei_rc rc; ei_chan ch; }                elements are T by value
// Copying a handle increments the count; the last drop frees the object: a Task joins its
// thread first (so no thread outlives its last handle, and the program never ends with one
// running), then drops its closure and result; a Mutex drops its value; a Chan drops the
// values still queued. Values cross threads only by move (spawn's closure, send) or by
// copy under the lock (Mutex.get); old values a Mutex replaces are dropped after the lock
// is released, so a drop that joins a thread (a Task in a Mutex) never runs under it.
// Every value that crosses (the closure's captures, values put into a Mutex or a channel,
// the result of an update closure, the copies get and join hand out) is owned first
// (own_call), so no copy-on-write buffer is reachable from two threads; join makes its copy
// under the Task's own lock (`mu`, only when T owns heap data).

/// The shared objects' structs, after every type is complete.
fn handle_bodies(inout g: G, p: P) {
    for ty in 0..p.t.tys.len() {
        let t = types.get(p.t, ty as u32)
        if t.kind == types.T_REF && g.tn[ty].len() > 0 {
            // a Ref's cell: a shared buffer (its count is the buffer's) with the access state
            put(inout g, "struct ")
            cty(inout g, p, ty as u32)
            put(inout g, "_c { int64_t st; ")
            cty(inout g, p, t.a)
            put(inout g, " v; };\n")
            continue
        }
        if !types.is_handle(t.kind) || g.tn[ty].len() == 0 { continue }
        put(inout g, "struct ")
        cty(inout g, p, ty as u32)
        put(inout g, "_c { ei_rc rc; ")
        if t.kind == types.T_TASK {
            put(inout g, "ei_thread th; ")
            cty(inout g, p, task_fn(p, t.a))
            put(inout g, " f; ")
            if !is_void(p, t.a) {
                cty(inout g, p, t.a)
                put(inout g, " r; ")
            }
            if task_locked(inout g, p, t.a) { put(inout g, "ei_mutex mu; ") }
        } else if t.kind == types.T_MUTEX {
            put(inout g, "ei_mutex mu; ")
            cty(inout g, p, t.a)
            put(inout g, " v; ")
        } else {
            put(inout g, "ei_chan ch; ")
        }
        put(inout g, "};\n")
    }
}

/// Whether a Task[T]'s object has a lock for copying its result out: when T owns heap data,
/// a join counts holders of the result's buffers, and joins may run on several threads.
fn task_locked(inout g: G, p: P, el: u32) -> bool { !is_void(p, el) && owns(inout g, p, el) }

/// `fn() -> T`, the closure type a Task[T] runs (types.task_of interns it).
fn task_fn(p: P, el: u32) -> u32 { types.find_comp(p.t, types.T_FN, types.EMPTY, el) }

/// `fn(T) -> T`, Mutex[T].update's closure type (the checker interns it).
fn update_fn(p: P, el: u32) -> u32 {
    let mut ps: List[u32] = List.new()
    ps.push(el)
    let l = types.find_list(p.t, ps)
    if l == types.NOTY { return types.NOTY }
    types.find_comp(p.t, types.T_FN, l, el)
}

/// The body of drop_T for handle type ty (x is the handle's address).
fn handle_drop(inout g: G, p: P, ty: u32) {
    let t = types.get(p.t, ty)
    put(inout g, "if (x->p && ei_rc_dec(&x->p->rc)) {\n    ")
    if t.kind == types.T_TASK {
        put(inout g, "ei_thread_destroy(&x->p->th);\n    ")
        drop_call(inout g, p, task_fn(p, t.a), sys.lit("&x->p->f"))
        if !is_void(p, t.a) { drop_call(inout g, p, t.a, sys.lit("&x->p->r")) }
        if task_locked(inout g, p, t.a) { put(inout g, "ei_mutex_destroy(&x->p->mu);") }
    } else if t.kind == types.T_MUTEX {
        drop_call(inout g, p, t.a, sys.lit("&x->p->v"))
        put(inout g, "ei_mutex_destroy(&x->p->mu);")
    } else {
        if owns(inout g, p, t.a) {
            put(inout g, "for (uint64_t i = 0; i < ei_chan_len(&x->p->ch); i++) { ")
            drop_call(inout g, p, t.a, sys.lit("ei_chan_at(&x->p->ch, i)"))
            put(inout g, "}\n    ")
        }
        put(inout g, "ei_chan_destroy(&x->p->ch);")
    }
    put(inout g, "\n    ei_free(x->p);\n  }\n  x->p = NULL;")
}

/// `static <ret> <op><handle>(<handle> h` ... the start of a glue function for handle ty.
fn handle_sig(inout g: G, p: P, ret: u32, op: str, ty: u32, h: str) {
    put(inout g, "static ")
    ret_cty(inout g, p, ret)
    put(inout g, " ")
    gname(inout g, p, op, ty)
    put(inout g, "(")
    cty(inout g, p, ty)
    put(inout g, " ")
    put(inout g, h)
}

/// `T old = <place>; ` when T owns heap data (dropped by old_drop after the unlock).
fn old_save(inout g: G, p: P, el: u32) {
    if !owns(inout g, p, el) { return }
    cty(inout g, p, el)
    put(inout g, " old = m.p->v;\n  ")
}

fn old_drop(inout g: G, p: P, el: u32) {
    if !owns(inout g, p, el) { return }
    put(inout g, "\n  ")
    drop_call(inout g, p, el, sys.lit("&old"))
}

fn thread_glue(inout g: G, p: P, kind: u32, ty: u32) {
    let el = types.get(p.t, ty).a
    let unit_r = is_void(p, el)
    let mark = g.o.len()
    if kind == GK_SPAWN {
        // the thread's entry point: runs the closure, keeps its result in the object
        put(inout g, "static void *")
        gname(inout g, p, "run_", ty)
        put(inout g, "(void *q)")
        proto(inout g, mark)
        put(inout g, " {\n  struct ")
        cty(inout g, p, ty)
        put(inout g, "_c *c = q;\n  ")
        if !unit_r { put(inout g, "c->r = ") }
        put(inout g, "c->f.call(c->f.env);\n  return NULL;\n}\n")
        let m2 = g.o.len()
        put(inout g, "static ")
        cty(inout g, p, ty)
        put(inout g, " ")
        gname(inout g, p, "spawn_", ty)
        put(inout g, "(")
        cty(inout g, p, task_fn(p, el))
        put(inout g, " f)")
        proto(inout g, m2)
        put(inout g, " {\n  ")
        cty(inout g, p, ty)
        put(inout g, " t;\n  ")
        // the closure runs on the new thread: nothing it captured may share a buffer here
        own_call(inout g, p, task_fn(p, el), sys.lit("&f"))
        put(inout g, "t.p = ei_alloc(sizeof *t.p);\n  ei_rc_init(&t.p->rc);\n  ")
        if task_locked(inout g, p, el) { put(inout g, "ei_mutex_init(&t.p->mu);\n  ") }
        put(inout g, "t.p->f = f;\n  ei_thread_start(&t.p->th, ")
        gname(inout g, p, "run_", ty)
        put(inout g, ", t.p);\n  return t;\n}\n")
    } else if kind == GK_JOIN {
        // waits for the thread (once, whoever asks first); the result stays in the Task
        handle_sig(inout g, p, el, "join_", ty, "t)")
        proto(inout g, mark)
        put(inout g, " {\n  ei_thread_join(&t.p->th);\n")
        if task_locked(inout g, p, el) {
            // a copy of its own, made under the Task's lock (other threads may be joining)
            put(inout g, "  ei_mutex_lock(&t.p->mu);\n  ")
            cty(inout g, p, el)
            put(inout g, " r = ")
            clone_expr(inout g, p, el, sys.lit("&t.p->r"))
            put(inout g, ";\n  ")
            own_call(inout g, p, el, sys.lit("&r"))
            put(inout g, "\n  ei_mutex_unlock(&t.p->mu);\n  return r;\n")
        } else if !unit_r {
            put(inout g, "  return t.p->r;\n")
        }
        put(inout g, "}\n")
    } else if kind == GK_MXNEW {
        put(inout g, "static ")
        cty(inout g, p, ty)
        put(inout g, " ")
        gname(inout g, p, "new_", ty)
        put(inout g, "(")
        cty(inout g, p, el)
        put(inout g, " v)")
        proto(inout g, mark)
        put(inout g, " {\n  ")
        cty(inout g, p, ty)
        put(inout g, " m;\n  ")
        own_call(inout g, p, el, sys.lit("&v"))
        put(inout g, "m.p = ei_alloc(sizeof *m.p);\n  ei_rc_init(&m.p->rc);\n  ei_mutex_init(&m.p->mu);\n  m.p->v = v;\n  return m;\n}\n")
    } else if kind == GK_MXGET {
        handle_sig(inout g, p, el, "get_", ty, "m)")
        proto(inout g, mark)
        put(inout g, " {\n  ei_mutex_lock(&m.p->mu);\n  ")
        cty(inout g, p, el)
        put(inout g, " r = ")
        clone_expr(inout g, p, el, sys.lit("&m.p->v"))
        put(inout g, ";\n  ")
        own_call(inout g, p, el, sys.lit("&r"))
        put(inout g, "ei_mutex_unlock(&m.p->mu);\n  return r;\n}\n")
    } else if kind == GK_MXSET {
        handle_sig(inout g, p, types.UNIT, "set_", ty, "m, ")
        cty(inout g, p, el)
        put(inout g, " v)")
        proto(inout g, mark)
        put(inout g, " {\n  ")
        own_call(inout g, p, el, sys.lit("&v"))
        put(inout g, "ei_mutex_lock(&m.p->mu);\n  ")
        old_save(inout g, p, el)
        put(inout g, "m.p->v = v;\n  ei_mutex_unlock(&m.p->mu);")
        old_drop(inout g, p, el)
        put(inout g, "\n}\n")
    } else if kind == GK_MXUPD {
        // the closure runs with the lock held, on a borrow of the value
        handle_sig(inout g, p, types.UNIT, "upd_", ty, "m, ")
        cty(inout g, p, update_fn(p, el))
        put(inout g, " f)")
        proto(inout g, mark)
        put(inout g, " {\n  ei_mutex_lock(&m.p->mu);\n  ")
        cty(inout g, p, el)
        put(inout g, " nv = f.call(f.env, m.p->v);\n  ")
        // the result may share buffers with the old value or the closure's captures
        own_call(inout g, p, el, sys.lit("&nv"))
        old_save(inout g, p, el)
        put(inout g, "m.p->v = nv;\n  ei_mutex_unlock(&m.p->mu);")
        old_drop(inout g, p, el)
        put(inout g, "\n}\n")
    } else if kind == GK_CHNEW {
        put(inout g, "static ")
        cty(inout g, p, ty)
        put(inout g, " ")
        gname(inout g, p, "new_", ty)
        put(inout g, "(void)")
        proto(inout g, mark)
        put(inout g, " {\n  ")
        cty(inout g, p, ty)
        put(inout g, " c;\n  c.p = ei_alloc(sizeof *c.p);\n  ei_rc_init(&c.p->rc);\n  ei_chan_init(&c.p->ch, sizeof(")
        cty(inout g, p, el)
        put(inout g, "));\n  return c;\n}\n")
    } else if kind == GK_CHSEND {
        // the value's bytes move into the queue: the channel owns it now
        handle_sig(inout g, p, types.UNIT, "send_", ty, "c, ")
        cty(inout g, p, el)
        put(inout g, " v)")
        proto(inout g, mark)
        put(inout g, " {\n  ")
        own_call(inout g, p, el, sys.lit("&v"))
        put(inout g, "ei_chan_send(&c.p->ch, &v);\n}\n")
    } else {
        handle_sig(inout g, p, types.BOOL, "recv_", ty, "c, ")
        cty(inout g, p, el)
        put(inout g, " *out)")
        proto(inout g, mark)
        put(inout g, " {\n  return ei_chan_recv(&c.p->ch, out);\n}\n")
    }
}

// ---- Ref[T] (docs/compiler.md, "C8.7")
//
// A Ref[T] is `{ struct <name>_c *p; }`, p a shared buffer (core/RUNTIME.md, "Shared
// buffers": the count of holders before the data, not atomic) holding `{ int64_t st; T v; }`.
// A copy is ei_buf_inc, the last drop drops v and frees. Each access is inline C around the
// value: ei_ref_read_begin/end around a read or get (st counts reads), ei_ref_update_begin/
// end around an update or set (st = -1), which trap when they overlap an update (or, for an
// update, any access).

/// `p` of the Ref operand of statement s (its argument 0).
fn ref_p(inout g: G, p: P, s: ir.Stmt) {
    put(inout g, "(")
    arg_val(inout g, p, barg(p, s, 0))
    put(inout g, ").p")
}

fn ref_builtin(inout g: G, p: P, s: ir.Stmt) {
    let b = s.a
    if b == ir.B_REF_NEW {
        need(inout g, GK_REFNEW, s.ty)
        bdst(inout g, p, s)
        gname(inout g, p, "new_", s.ty)
        put(inout g, "(")
        arg_val(inout g, p, barg(p, s, 0))
        put(inout g, ")")
        return
    }
    let rt = arg_ty(p, barg(p, s, 0))
    let el = types.get(p.t, rt).a
    let upd = b == ir.B_REF_UPDATE || b == ir.B_REF_SET
    put(inout g, "{ ")
    if upd { put(inout g, "ei_ref_update_begin(&") } else { put(inout g, "ei_ref_read_begin(&") }
    ref_p(inout g, p, s)
    put(inout g, "->st, ")
    put_line(inout g, s.line)
    put(inout g, "); ")
    if b == ir.B_REF_GET {
        bdst(inout g, p, s)
        let mut ptr = sys.lit("&")
        bytes.append(inout ptr, op_text(inout g, p, barg(p, s, 0)))
        bytes.append(inout ptr, sys.lit(".p->v"))
        clone_expr(inout g, p, el, ptr)
        put(inout g, "; ")
    } else if b == ir.B_REF_SET {
        // the old value is dropped after the access ends (its drop may use the Ref)
        if owns(inout g, p, el) {
            cty(inout g, p, el)
            put(inout g, " old = ")
            ref_p(inout g, p, s)
            put(inout g, "->v; ")
        }
        ref_p(inout g, p, s)
        put(inout g, "->v = ")
        arg_val(inout g, p, barg(p, s, 1))
        put(inout g, "; ")
    } else {
        // read: f(v) on a borrow of the value; update: f(&v)
        let f = op_text(inout g, p, barg(p, s, 1))
        bdst(inout g, p, s)
        putb(inout g, f)
        put(inout g, ".call(")
        putb(inout g, f)
        put(inout g, ".env, ")
        if upd { put(inout g, "&") }
        ref_p(inout g, p, s)
        put(inout g, "->v); ")
    }
    if upd { put(inout g, "ei_ref_update_end(&") } else { put(inout g, "ei_ref_read_end(&") }
    ref_p(inout g, p, s)
    put(inout g, "->st);")
    if b == ir.B_REF_SET && owns(inout g, p, el) {
        put(inout g, " ")
        drop_call(inout g, p, el, sys.lit("&old"))
    }
    put(inout g, " }")
}

// ---- Default (docs/compiler.md, "C8.23")

/// The Default value of ty as a C expression: inline for the built-in types, the type's own
/// `default` when it has one, else `default_T()` glue (derived).
fn default_expr(inout g: G, p: P, ty: u32) {
    let k = ty_kind(p, ty)
    let f = custom_fn(p, TR_DEFAULT, ty)
    if f != NONE {
        fn_name(inout g, p, f)
        put(inout g, "()")
    } else if k == types.T_INT || k == types.T_UNIT {
        put(inout g, "0")
    } else if k == types.T_BOOL {
        put(inout g, "false")
    } else if k == types.T_STR {
        put(inout g, "\"\"")
    } else if k == types.T_STRING {
        put(inout g, "ei_str_from(\"\")")
    } else if k == types.T_LIST || k == types.T_MAP {
        put(inout g, "(")
        cty(inout g, p, ty)
        put(inout g, "){0}")
    } else if k == types.T_ENUM {
        // Option: None (the only enum with a derived Default)
        option_lit(inout g, p, ty, List.new())
    } else {
        need(inout g, GK_DEFAULT, ty)
        gname(inout g, p, "default_", ty)
        put(inout g, "()")
    }
}

/// `static T default_T(void)`: each part's Default (a record, tuple, array or Box).
fn default_glue(inout g: G, p: P, ty: u32) {
    let mark = g.o.len()
    put(inout g, "static ")
    cty(inout g, p, ty)
    put(inout g, " ")
    gname(inout g, p, "default_", ty)
    put(inout g, "(void)")
    proto(inout g, mark)
    put(inout g, " {\n  ")
    cty(inout g, p, ty)
    put(inout g, " r = {0};\n")
    let t = types.get(p.t, ty)
    let k = t.kind
    if k == types.T_RECORD {
        let d = types.def_of(p.t, ty)
        for i in 0..d.len {
            put(inout g, "  r.f")
            putn(inout g, i as u64)
            put(inout g, " = ")
            default_expr(inout g, p, types.field(p.t, d.start, i).ty)
            put(inout g, ";\n")
        }
    } else if k == types.T_TUPLE {
        let es = types.elems(p.t, ty)
        for i in 0..es.len() {
            put(inout g, "  r.f")
            putn(inout g, i as u64)
            put(inout g, " = ")
            default_expr(inout g, p, es[i])
            put(inout g, ";\n")
        }
    } else if k == types.T_ARRAY {
        if t.b > 0 {
            put(inout g, "  for (uint64_t i = 0; i < ")
            putn(inout g, t.b as u64)
            put(inout g, "; i++) r.a[i] = ")
            default_expr(inout g, p, t.a)
            put(inout g, ";\n")
        }
    } else if k == types.T_BOX {
        put(inout g, "  r.p = ei_buf_alloc(1, sizeof *r.p);\n  *r.p = ")
        default_expr(inout g, p, t.a)
        put(inout g, ";\n")
    }
    put(inout g, "  return r;\n}\n")
}

/// `static R new_R(T v)`: a new Ref holding v (moved in).
fn ref_new_glue(inout g: G, p: P, ty: u32) {
    let mark = g.o.len()
    put(inout g, "static ")
    cty(inout g, p, ty)
    put(inout g, " ")
    gname(inout g, p, "new_", ty)
    put(inout g, "(")
    cty(inout g, p, types.get(p.t, ty).a)
    put(inout g, " v)")
    proto(inout g, mark)
    put(inout g, " {\n  ")
    cty(inout g, p, ty)
    put(inout g, " r;\n  r.p = ei_buf_alloc(1, sizeof *r.p);\n  r.p->st = 0;\n  r.p->v = v;\n  return r;\n}\n")
}

/// `<op><handle>(args)` with glue kind gk for handle type ty.
fn thread_call(inout g: G, p: P, s: ir.Stmt, gk: u32, op: str, ty: u32) {
    need(inout g, gk, ty)
    bdst(inout g, p, s)
    gname(inout g, p, op, ty)
    put(inout g, "(")
    for i in 0..s.c {
        if i > 0 { put(inout g, ", ") }
        arg_val(inout g, p, barg(p, s, i))
    }
    put(inout g, ")")
}

fn thread_builtin(inout g: G, p: P, s: ir.Stmt) {
    let b = s.a
    if b == ir.B_SPAWN {
        thread_call(inout g, p, s, GK_SPAWN, "spawn_", s.ty)
        return
    }
    if b == ir.B_MUTEX_NEW {
        thread_call(inout g, p, s, GK_MXNEW, "new_", s.ty)
        return
    }
    if b == ir.B_CHAN_NEW {
        thread_call(inout g, p, s, GK_CHNEW, "new_", s.ty)
        return
    }
    let ht = arg_ty(p, barg(p, s, 0))
    if b == ir.B_TASK_JOIN {
        thread_call(inout g, p, s, GK_JOIN, "join_", ht)
    } else if b == ir.B_MUTEX_GET {
        thread_call(inout g, p, s, GK_MXGET, "get_", ht)
    } else if b == ir.B_MUTEX_SET {
        thread_call(inout g, p, s, GK_MXSET, "set_", ht)
    } else if b == ir.B_MUTEX_UPDATE {
        thread_call(inout g, p, s, GK_MXUPD, "upd_", ht)
    } else if b == ir.B_CHAN_SEND {
        thread_call(inout g, p, s, GK_CHSEND, "send_", ht)
    } else if b == ir.B_CHAN_CLOSE {
        put(inout g, "ei_chan_close(&")
        arg_val(inout g, p, barg(p, s, 0))
        put(inout g, ".p->ch)")
    } else {
        // { T v; if (recv_C(c, &v)) dst = Some(v); else dst = None; }
        need(inout g, GK_CHRECV, ht)
        put(inout g, "{ ")
        cty(inout g, p, types.get(p.t, ht).a)
        put(inout g, " v; if (")
        gname(inout g, p, "recv_", ht)
        put(inout g, "(")
        arg_val(inout g, p, barg(p, s, 0))
        put(inout g, ", &v)) ")
        bdst(inout g, p, s)
        option_lit(inout g, p, s.ty, sys.lit("v"))
        put(inout g, "; else ")
        bdst(inout g, p, s)
        option_lit(inout g, p, s.ty, List.new())
        put(inout g, "; }")
    }
}

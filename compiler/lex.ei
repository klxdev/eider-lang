// lex: source bytes -> tokens. Token for token as tests/oracle records, including the
// E0001 messages and positions. Columns count Unicode scalar values (UTF-8 lead bytes).
//
// Tokens hold no text: identifiers carry an interned symbol id, strings an index into
// `strs`, integers their value (with `big` set when it doesn't fit in u64; the checker
// reports those as out of range, and anything past i128 is rejected here).
//
// `lex` stops at the first error; `lex_all` (Lexed2) records every error and goes on, for
// reporting all the syntax errors of a file. Both run the same scanner (`run`).

import core.sys
import std.bytes
import eiderc.intern
import eiderc.diag

pub type Kind =
    | Ident | Int | Str | Newline | Eof
    | Arrow | FatArrow | EqEq | NotEq | LtEq | GtEq | AndAnd | OrOr
    | WAdd | WSub | WMul | PlusEq | MinusEq | StarEq | SlashEq | PercentEq | DotDot
    | Question | LParen | RParen | LBrace | RBrace | LBracket | RBracket
    | Comma | Colon | Semi | Dot | Plus | Minus | Star | Slash | Percent
    | Lt | Gt | Eq | Bang | Pipe
    | Amp | Caret | Tilde | Shl | Shr | AmpEq | PipeEq | CaretEq | ShlEq | ShrEq
    | At
    | FStart | FText | FHole | FClose | FEnd

/// `start`/`end` are byte offsets; `line`/`col` the start position; `end_col` is the column
/// just past the token (tokens never span lines).
pub type Tok = { kind: Kind, start: u32, end: u32, line: u32, col: u32, end_col: u32, val: u64, big: bool }

/// `src` is the source text, for fixes that quote it (parse.ei, E0002).
pub type Lexed = { toks: List[Tok], strs: List[List[u8]], src: List[u8] }

pub type LexError = { line: u32, col: u32, msg: str }

type L = { i: usize, line: u32, col: u32 }

fn at(src: List[u8], i: usize) -> u8 {
    if i < src.len() { return src[i] }
    0
}

/// Advance one byte; the column moves once per scalar (not on UTF-8 continuation bytes).
fn step(src: List[u8], inout l: L) {
    let b = src[l.i]
    if b == 10 {
        l.line += 1
        l.col = 1
    } else if b < 128 || b >= 192 {
        l.col += 1
    }
    l.i += 1
}

fn err(line: u32, col: u32, m: str) -> LexError { LexError(line, col, m) }

fn tok(k: Kind, start: L, l: L, val: u64) -> Tok {
    Tok(k, start.i as u32, l.i as u32, start.line, start.col, l.col, val, false)
}

/// Three-byte symbols: `<<=` and `>>=`.
fn sym3(a: u8, b: u8, c: u8) -> Option[Kind] {
    if a == 60 && b == 60 && c == 61 { return Some(ShlEq) }     // <<=
    if a == 62 && b == 62 && c == 61 { return Some(ShrEq) }     // >>=
    None
}

/// Two-byte symbols, longest first.
fn sym2(a: u8, b: u8) -> Option[Kind] {
    if a == 45 && b == 62 { return Some(Arrow) }        // ->
    if a == 61 && b == 62 { return Some(FatArrow) }     // =>
    if a == 61 && b == 61 { return Some(EqEq) }         // ==
    if a == 33 && b == 61 { return Some(NotEq) }        // !=
    if a == 60 && b == 61 { return Some(LtEq) }         // <=
    if a == 62 && b == 61 { return Some(GtEq) }         // >=
    if a == 38 && b == 38 { return Some(AndAnd) }       // &&
    if a == 124 && b == 124 { return Some(OrOr) }       // ||
    if a == 43 && b == 37 { return Some(WAdd) }         // +%
    if a == 45 && b == 37 { return Some(WSub) }         // -%
    if a == 42 && b == 37 { return Some(WMul) }         // *%
    if a == 43 && b == 61 { return Some(PlusEq) }       // +=
    if a == 45 && b == 61 { return Some(MinusEq) }      // -=
    if a == 42 && b == 61 { return Some(StarEq) }       // *=
    if a == 47 && b == 61 { return Some(SlashEq) }      // /=
    if a == 37 && b == 61 { return Some(PercentEq) }    // %=
    if a == 46 && b == 46 { return Some(DotDot) }       // ..
    if a == 60 && b == 60 { return Some(Shl) }          // <<
    if a == 62 && b == 62 { return Some(Shr) }          // >>
    if a == 38 && b == 61 { return Some(AmpEq) }        // &=
    if a == 124 && b == 61 { return Some(PipeEq) }      // |=
    if a == 94 && b == 61 { return Some(CaretEq) }      // ^=
    None
}

fn sym1(a: u8) -> Option[Kind] {
    match a {
        63 => Some(Question)
        40 => Some(LParen)
        41 => Some(RParen)
        123 => Some(LBrace)
        125 => Some(RBrace)
        91 => Some(LBracket)
        93 => Some(RBracket)
        44 => Some(Comma)
        58 => Some(Colon)
        59 => Some(Semi)
        46 => Some(Dot)
        43 => Some(Plus)
        45 => Some(Minus)
        42 => Some(Star)
        47 => Some(Slash)
        37 => Some(Percent)
        60 => Some(Lt)
        62 => Some(Gt)
        61 => Some(Eq)
        33 => Some(Bang)
        124 => Some(Pipe)
        38 => Some(Amp)
        94 => Some(Caret)
        126 => Some(Tilde)
        64 => Some(At)
        _ => None
    }
}

fn hex_val(c: u8) -> Option[u64] {
    if bytes.is_digit(c) { return Some((c - 48) as u64) }
    if c >= 97 && c <= 102 { return Some((c - 87) as u64) }
    if c >= 65 && c <= 70 { return Some((c - 55) as u64) }
    None
}

/// value * base + digit in four 32-bit limbs; false once the value exceeds i128's maximum.
fn acc(inout limbs: [u64; 4], base: u64, digit: u64) -> bool {
    let mut carry = digit.copy()
    for k in 0..4 {
        let j = k as usize
        let t = limbs[j] * base + carry
        limbs[j] = t % 4294967296
        carry = t / 4294967296
    }
    carry == 0 && limbs[3] < 2147483648
}

/// An integer literal at the cursor (a digit). Underscores are allowed after the first digit.
/// A malformed or too-large literal is reported in `bad` and lexes as 0 (too large: with `big`).
fn number(src: List[u8], inout l: L, inout bad: List[Bad]) -> Tok {
    let start = l.copy()
    let mut limbs: [u64; 4] = [0; 4]
    let mut ok = true
    if at(src, l.i) == 48 && (at(src, l.i + 1) == 120 || at(src, l.i + 1) == 88) {
        step(src, inout l)
        step(src, inout l)
        let first = l.i.copy()
        while l.i < src.len() && (hex_val(src[l.i]).is_some() || src[l.i] == 95) {
            match hex_val(src[l.i]) {
                Some(d) => { if !acc(inout limbs, 16, d) { ok = false } }
                None => {}
            }
            step(src, inout l)
        }
        if l.i == first {
            bad.push(fail(start, "expected hex digits after 0x"))
            return tok(Int, start, l, 0)
        }
    } else {
        while l.i < src.len() && (bytes.is_digit(src[l.i]) || src[l.i] == 95) {
            if src[l.i] != 95 {
                if !acc(inout limbs, 10, (src[l.i] - 48) as u64) { ok = false }
            }
            step(src, inout l)
        }
    }
    if !ok {
        bad.push(fail(start, "integer literal too large"))
        let mut big = tok(Int, start, l, 0)
        big.big = true
        return big
    }
    let mut t = tok(Int, start, l, limbs[0] + limbs[1] * 4294967296)
    t.big = limbs[2] != 0 || limbs[3] != 0
    t
}

/// A decoded `\x` or `\u` escape: the scalar value and the offset just past it, or `msg`
/// saying what is wrong with it.
type Esc = { v: u32, end: usize, msg: str }

fn hex_digit(b: u8) -> u32 {
    if b >= 48 && b <= 57 { return (b - 48) as u32 }
    if b >= 97 && b <= 102 { return (b - 87) as u32 }
    if b >= 65 && b <= 70 { return (b - 55) as u32 }
    16
}

/// `\xNN` after the `x` at i: exactly two hex digits, an ASCII character other than NUL
/// (a String is valid UTF-8, so a byte above 7F alone can't be in one).
fn hex_escape(src: List[u8], i: usize) -> Esc {
    let a = hex_digit(at(src, i))
    let b = hex_digit(at(src, i + 1))
    if a > 15 || b > 15 { return Esc(0, i, "`\\x` needs two hex digits, like `\\x1b`") }
    let v = a * 16 + b
    if v == 0 { return Esc(0, i, "a string can't contain NUL (`\\x00`): str and String are UTF-8 text without NUL; put the byte 0 in a List[u8]") }
    if v > 127 { return Esc(0, i, "`\\xNN` is an ASCII character (01 to 7f); write a non-ASCII character as `\\u\x7b...\x7d`") }
    Esc(v, i + 2, "")
}

/// `\u{H...}` after the `u` at i: one to six hex digits in braces, a Unicode scalar value
/// other than NUL (not a surrogate, at most 10FFFF).
fn unicode_escape(src: List[u8], i: usize) -> Esc {
    let shape = "`\\u` needs one to six hex digits in braces, like `\\u\x7be9\x7d`"
    if at(src, i) != 123 { return Esc(0, i, shape) }
    let mut j = i + 1
    let mut v: u32 = 0
    let mut n: u32 = 0
    while j < src.len() && hex_digit(src[j]) < 16 {
        if n < 6 { v = v * 16 + hex_digit(src[j]) }
        n += 1
        j += 1
    }
    if n == 0 || n > 6 || at(src, j) != 125 { return Esc(0, i, shape) }
    if v == 0 { return Esc(0, i, "a string can't contain NUL (`\\u\x7b0\x7d`): str and String are UTF-8 text without NUL; put the byte 0 in a List[u8]") }
    if v >= 55296 && v <= 57343 { return Esc(0, i, "`\\u\x7b...\x7d` can't be a surrogate (d800 to dfff): it must be a Unicode scalar value") }
    if v > 1114111 { return Esc(0, i, "`\\u\x7b...\x7d` is at most 10ffff, the largest Unicode scalar value") }
    Esc(v, j + 1, "")
}

/// Append scalar value v as UTF-8.
fn utf8_push(inout s: List[u8], v: u32) {
    if v < 128 {
        s.push(v as u8)
    } else if v < 2048 {
        s.push((192 + v / 64) as u8)
        s.push((128 + v % 64) as u8)
    } else if v < 65536 {
        s.push((224 + v / 4096) as u8)
        s.push((128 + (v / 64) % 64) as u8)
        s.push((128 + v % 64) as u8)
    } else {
        s.push((240 + v / 262144) as u8)
        s.push((128 + (v / 4096) % 64) as u8)
        s.push((128 + (v / 64) % 64) as u8)
        s.push((128 + v % 64) as u8)
    }
}

/// The UTF-8 sequence starting at `i`, for "unexpected character" messages.
fn scalar_at(src: List[u8], i: usize) -> List[u8] {
    let mut out: List[u8] = List.new()
    out.push(src[i])
    let mut j = i + 1
    while j < src.len() && src[j] >= 128 && src[j] < 192 {
        out.push(src[j])
        j += 1
    }
    out
}

/// The result of lexing. `BadChar` carries the offending character for the message.
pub type Lex = | Done(lexed: Lexed) | Failed(error: LexError) | BadChar(line: u32, col: u32, ch: List[u8])

/// Lexing that never stops (`lex_all`): the tokens of everything that lexed (a bad character
/// skipped, an unterminated string ended at the end of its line, an unterminated block
/// comment run to the end of the file, a too-large literal lexed as 0 with `big` set) and
/// every error in source order, the first being the one `lex` reports.
pub type Lexed2 = { lexed: Lexed, diags: List[diag.Diag] }

/// A lexing error: `msg`, or with `ch` set an unexpected character.
type Bad = { line: u32, col: u32, msg: str, ch: List[u8] }

fn fail(at: L, m: str) -> Bad { Bad(at.line, at.col, m, List.new()) }

type Run = { lexed: Lexed, bad: List[Bad] }

/// The tokens, or the first error.
pub fn lex(src: List[u8], inout names: intern.Interner) -> Lex {
    let r = run(src, inout names, false)
    if r.bad.len() == 0 { return Done(r.lexed) }
    let b = r.bad[0]
    if b.ch.len() > 0 { return BadChar(b.line, b.col, b.ch) }
    Failed(err(b.line, b.col, b.msg))
}

/// Every lexing error, and the tokens of the rest (Lexed2). The messages are the ones
/// `resolve.lex_diag` makes of `lex`'s result.
pub fn lex_all(src: List[u8], inout names: intern.Interner) -> Lexed2 {
    let r = run(src, inout names, true)
    let mut ds: List[diag.Diag] = List.new()
    for b in r.bad {
        if b.ch.len() > 0 {
            let mut m = sys.lit("unexpected character `")
            bytes.append(inout m, b.ch)
            m.push(96)
            ds.push(diag.new("E0001", b.line, b.col, m))
        } else {
            ds.push(diag.new("E0001", b.line, b.col, sys.lit(b.msg)))
        }
    }
    Lexed2(r.lexed, ds)
}

/// The lexer: stops at the first error (`lex`), or with `all` records each one and goes on.
/// A run of adjacent bad characters is reported once, at its first.
fn run(src: List[u8], inout names: intern.Interner, all: bool) -> Run {
    let mut toks: List[Tok] = List.new()
    let mut strs: List[List[u8]] = List.new()
    let mut bad: List[Bad] = List.new()
    let mut l = L(0, 1, 1)
    // the offset just past the last bad character (0: none yet)
    let mut bad_end: usize = 0
    scan(src, inout l, src.len(), all, inout toks, inout strs, inout bad, inout bad_end, inout names)
    if !all && bad.len() > 0 { return Run(Lexed(toks, strs, src), bad) }
    toks.push(Tok(Eof, l.i as u32, l.i as u32, l.line, l.col, l.col, 0, false))
    Run(Lexed(toks, strs, src), bad)
}

/// The tokens from `l` up to offset `stop` (the end of the file, or of a string literal's
/// `{...}`), appended to `toks`.
fn scan(src: List[u8], inout l: L, stop: usize, all: bool, inout toks: List[Tok], inout strs: List[List[u8]], inout bad: List[Bad], inout bad_end: usize, inout names: intern.Interner) {
    while l.i < stop {
        if !all && bad.len() > 0 { return }
        let c = src[l.i]
        let start = l.copy()
        if c == 10 {
            let n = toks.len()
            let mut dup = false
            if n > 0 {
                dup = match toks[n - 1].kind {
                    Newline => true
                    _ => false
                }
            }
            step(src, inout l)
            if !dup { toks.push(Tok(Newline, start.i as u32, l.i as u32, start.line, start.col, start.col + 1, 0, false)) }
        } else if c == 32 || c == 9 || c == 13 {
            step(src, inout l)
        } else if c == 47 && at(src, l.i + 1) == 47 {
            while l.i < src.len() && src[l.i] != 10 { step(src, inout l) }
        } else if c == 47 && at(src, l.i + 1) == 42 {
            step(src, inout l)
            step(src, inout l)
            while true {
                if l.i + 1 >= src.len() {
                    bad.push(fail(start, "unterminated block comment"))
                    while l.i < src.len() { step(src, inout l) }
                    break
                }
                if src[l.i] == 42 && src[l.i + 1] == 47 {
                    step(src, inout l)
                    step(src, inout l)
                    break
                }
                step(src, inout l)
            }
        } else if bytes.is_digit(c) {
            toks.push(number(src, inout l, inout bad))
        } else if c == 114 && raw_at(src, l.i) {
            // r"...", r#"..."#, r"""...""" (docs/compiler.md, "C8.28: string literals")
            if multi_open(src, l.i + 1) {
                multiline(src, inout l, true, all, inout toks, inout strs, inout bad, inout bad_end, inout names)
            } else {
                raw(src, inout l, inout toks, inout strs, inout bad)
            }
        } else if c == 34 && multi_open(src, l.i) {
            multiline(src, inout l, false, all, inout toks, inout strs, inout bad, inout bad_end, inout names)
        } else if bytes.is_alpha(c) || c == 95 {
            while l.i < src.len() && bytes.is_ident(src[l.i]) { step(src, inout l) }
            let id = intern.intern(inout names, src, start.i, l.i)
            toks.push(tok(Ident, start, l, id as u64))
        } else if c == 34 {
            literal(src, inout l, all, inout toks, inout strs, inout bad, inout bad_end, inout names)
        } else if sym3(c, at(src, l.i + 1), at(src, l.i + 2)).is_some() {
            let k3 = sym3(c, at(src, l.i + 1), at(src, l.i + 2)).unwrap()
            step(src, inout l)
            step(src, inout l)
            step(src, inout l)
            toks.push(tok(k3, start, l, 0))
        } else {
            match sym2(c, at(src, l.i + 1)) {
                Some(k) => {
                    step(src, inout l)
                    step(src, inout l)
                    toks.push(tok(k, start, l, 0))
                }
                None => {
                    match sym1(c) {
                        Some(k) => {
                            step(src, inout l)
                            toks.push(tok(k, start, l, 0))
                        }
                        None => {
                            let ch = scalar_at(src, l.i)
                            if bad_end == 0 || bad_end != l.i { bad.push(Bad(start.line, start.col, "", ch)) }
                            let stop = l.i + ch.len()
                            while l.i < stop { step(src, inout l) }
                            bad_end = l.i
                        }
                    }
                }
            }
        }
    }
}

/// Push string token t, joined to a string token just before it on its line (adjacent
/// literals on one line are one literal: docs/compiler.md, "C8.17").
fn push_str(inout toks: List[Tok], inout strs: List[List[u8]], t: Tok) {
    let n = toks.len()
    if n > 0 && toks[n - 1].kind == Str && toks[n - 1].line == t.line {
        let mut prev = toks[n - 1]
        let more = strs[t.val as usize].copy()
        strs.pop()
        bytes.append(inout strs[prev.val as usize], more)
        prev.end = t.end
        prev.end_col = t.end_col
        toks[n - 1] = prev
    } else {
        toks.push(t)
    }
}

// ---- string literals (docs/compiler.md, "C8.28: string literals"; decision U29). Every plain
// literal interpolates: with no `{expr}` it is one Str token (`{{` and `}}` meaning braces);
// with one it is the tokens FStart, then for each text run an FText (val: its decoded text
// in `strs`), for each `{expr[:spec]}` an FHole at the `{`, the expression's own tokens and
// an FClose at the `:` or `}` (val: the spec text in `strs`, empty without one), and FEnd at
// the closing quote; the parser makes an EFmt of them. Raw literals (`r"..."`, `r#"..."#`,
// `r"""`) never interpolate.

/// `r"` or `r#...#"` at i (a lone `r` before the literal).
fn raw_at(src: List[u8], i: usize) -> bool {
    let mut j = i + 1
    while at(src, j) == 35 { j += 1 }
    at(src, j) == 34
}

/// `"""` at i followed by nothing but spaces before the end of its line: a multi-line string.
fn multi_open(src: List[u8], i: usize) -> bool {
    if at(src, i) != 34 || at(src, i + 1) != 34 || at(src, i + 2) != 34 { return false }
    let mut j = i + 3
    while at(src, j) == 32 || at(src, j) == 9 || at(src, j) == 13 { j += 1 }
    at(src, j) == 10
}

/// One escape sequence at the backslash at l.i, appended to s (the rules of `string`).
fn escape(src: List[u8], inout l: L, inout s: List[u8], inout reported: bool, inout bad: List[Bad]) {
    let e = at(src, l.i + 1)
    if e == 120 || e == 117 {
        let r = if e == 120 { hex_escape(src, l.i + 2) } else { unicode_escape(src, l.i + 2) }
        if r.msg.len() > 0 {
            if !reported { bad.push(fail(l, r.msg)) }
            reported = true
            step(src, inout l)
            step(src, inout l)
            return
        }
        utf8_push(inout s, r.v)
        while l.i < r.end { step(src, inout l) }
        return
    }
    if e == 110 {
        s.push(10)
    } else if e == 116 {
        s.push(9)
    } else if e == 114 {
        s.push(13)
    } else if e == 34 || e == 92 {
        s.push(e)
    } else if e == 48 {
        if !reported { bad.push(fail(l, "a string can't contain NUL (`\\0`): str and String are UTF-8 text without NUL; put the byte 0 in a List[u8]")) }
        reported = true
    } else {
        if !reported { bad.push(fail(l, "unknown escape sequence")) }
        reported = true
        if e == 10 || l.i + 1 >= src.len() {
            step(src, inout l)
            return
        }
    }
    step(src, inout l)
    step(src, inout l)
}

/// `r"..."` or `r#"..."#` (any number of `#`): the text as written, no escapes, on one line.
fn raw(src: List[u8], inout l: L, inout toks: List[Tok], inout strs: List[List[u8]], inout bad: List[Bad]) {
    let start = l.copy()
    step(src, inout l)
    let mut hashes: usize = 0
    while src[l.i] == 35 {
        hashes += 1
        step(src, inout l)
    }
    step(src, inout l)
    let mut s: List[u8] = List.new()
    while true {
        if l.i >= src.len() || src[l.i] == 10 {
            bad.push(fail(start, "unterminated raw string literal"))
            break
        }
        if src[l.i] == 34 {
            let mut k: usize = 0
            while k < hashes && at(src, l.i + 1 + k) == 35 { k += 1 }
            if k == hashes {
                for x in 0..(hashes + 1) { step(src, inout l) }
                break
            }
        }
        s.push(src[l.i])
        step(src, inout l)
    }
    strs.push(s)
    let t = tok(Str, start, l, (strs.len() - 1) as u64)
    push_str(inout toks, inout strs, t)
}

/// The text of the literal being read so far (`cur`, starting at `from`) and whether an error
/// was reported for it.
type Piece = { cur: List[u8], from: L, reported: bool }

/// Push the text run so far as an FText token and start a new one at l.
fn flush(inout p: Piece, l: L, inout toks: List[Tok], inout strs: List[List[u8]]) {
    strs.push(p.cur)
    toks.push(tok(FText, p.from, l, (strs.len() - 1) as u64))
    p.cur = List.new()
    p.from = l.copy()
}

/// The end of a one-line literal's text from i: the offset of its closing quote, or of the
/// end of the line (or file) when it has none.
fn text_end(src: List[u8], i: usize) -> usize {
    let mut j = i.copy()
    while j < src.len() && src[j] != 10 && src[j] != 34 {
        if src[j] == 92 && j + 1 < src.len() && src[j + 1] != 10 { j += 1 }
        j += 1
    }
    j
}

/// A one-line literal at the cursor (`"`). An unknown escape is reported and skipped; an
/// unterminated literal ends at the end of its line. At most one error is reported per literal.
fn literal(src: List[u8], inout l: L, all: bool, inout toks: List[Tok], inout strs: List[List[u8]], inout bad: List[Bad], inout bad_end: usize, inout names: intern.Interner) {
    let start = l.copy()
    step(src, inout l)
    let mark = toks.len()
    toks.push(tok(FStart, start, l, 0))
    let end = text_end(src, l.i)
    let mut p = Piece(List.new(), l.copy(), false)
    pieces(src, inout l, end, true, inout p, all, inout toks, inout strs, inout bad, inout bad_end, inout names)
    let close = l.copy()
    let closed = l.i < src.len() && src[l.i] == 34
    if closed {
        step(src, inout l)
    } else if !p.reported {
        bad.push(fail(start, "unterminated string literal"))
    }
    finish(inout p, start, close, l, mark, inout toks, inout strs)
}

/// The end of a literal: with no `{expr}` one Str token (FStart at `mark` goes), else the
/// last text run and FEnd.
fn finish(inout p: Piece, start: L, close: L, l: L, mark: usize, inout toks: List[Tok], inout strs: List[List[u8]]) {
    if toks.len() == mark + 1 {
        toks.pop()
        strs.push(p.cur)
        let t = tok(Str, start, l, (strs.len() - 1) as u64)
        push_str(inout toks, inout strs, t)
        return
    }
    flush(inout p, close, inout toks, inout strs)
    toks.push(tok(FEnd, close, l, 0))
}

/// The text of a literal from l to `end`: escapes decoded, `{{` and `}}` as braces and each
/// `{...}` as its tokens (without `fmt`, braces are text).
fn pieces(src: List[u8], inout l: L, end: usize, fmt: bool, inout p: Piece, all: bool, inout toks: List[Tok], inout strs: List[List[u8]], inout bad: List[Bad], inout bad_end: usize, inout names: intern.Interner) {
    while l.i < end {
        let c = src[l.i]
        if fmt && (c == 123 || c == 125) && at(src, l.i + 1) == c && l.i + 1 < end {
            p.cur.push(c)
            step(src, inout l)
            step(src, inout l)
        } else if fmt && c == 123 {
            flush(inout p, l, inout toks, inout strs)
            if !hole(src, inout l, end, all, inout toks, inout strs, inout bad, inout bad_end, inout names) {
                p.reported = true
                while l.i < end { step(src, inout l) }
            }
            p.from = l.copy()
        } else if fmt && c == 125 {
            if !p.reported { bad.push(fail(l, r"a `}` in a string literal is written `}}`, or use a raw string")) }
            p.reported = true
            step(src, inout l)
        } else if c == 92 {
            let mut rep = p.reported.copy()
            escape(src, inout l, inout p.cur, inout rep, inout bad)
            p.reported = rep
        } else {
            p.cur.push(c)
            step(src, inout l)
        }
    }
}

/// `{expr}` or `{expr:spec}` at l (the `{`), within a literal ending at `end`: FHole, the
/// expression's tokens, FClose. false (after reporting it) when it is malformed.
fn hole(src: List[u8], inout l: L, end: usize, all: bool, inout toks: List[Tok], inout strs: List[List[u8]], inout bad: List[Bad], inout bad_end: usize, inout names: intern.Interner) -> bool {
    let open = l.copy()
    let mut j = l.i + 1
    let mut depth: u32 = 0
    while true {
        if j >= end && at(src, j) == 34 && at(src, j + 1) != 10 && j + 1 < src.len() && text_end(src, j + 1) < src.len() && src[text_end(src, j + 1)] == 34 {
            // `{f("x")}`: the literal seems to end inside the braces
            bad.push(fail(open, "a string literal's `\x7b...\x7d` can't contain `\x7b`, `\"` or a comment: bind the value to a name first"))
            return false
        }
        if j >= end {
            bad.push(fail(open, r"unclosed `{` in a string literal: close it with `}`, write `{{` for a brace, or use a raw string"))
            return false
        }
        let b = src[j]
        if b == 123 || b == 34 || (b == 47 && (at(src, j + 1) == 47 || at(src, j + 1) == 42)) {
            bad.push(fail(open, "a string literal's `\x7b...\x7d` can't contain `\x7b`, `\"` or a comment: bind the value to a name first"))
            return false
        }
        if b == 40 || b == 91 { depth += 1 }
        if (b == 41 || b == 93) && depth > 0 { depth -= 1 }
        if depth == 0 && (b == 125 || b == 58) { break }
        j += 1
    }
    step(src, inout l)
    toks.push(tok(FHole, open, l, 0))
    scan(src, inout l, j, all, inout toks, inout strs, inout bad, inout bad_end, inout names)
    while l.i < j { step(src, inout l) }
    let close = l.copy()
    let mut spec: List[u8] = List.new()
    if src[j] == 58 {
        step(src, inout l)
        while l.i < end && src[l.i] != 125 {
            spec.push(src[l.i])
            step(src, inout l)
        }
        if l.i >= end {
            bad.push(fail(open, r"unclosed `{` in a string literal: close it with `}`, write `{{` for a brace, or use a raw string"))
            return false
        }
    }
    step(src, inout l)
    strs.push(spec)
    toks.push(tok(FClose, close, l, (strs.len() - 1) as u64))
    true
}

/// `"""` (or `r"""`) and the end of its line, the lines of text, and a line holding only the
/// closing `"""` after the indentation that is removed from every line of text (Swift's rule).
/// The text starts after the first line break and ends before the last; `\` at the end of a
/// line joins it to the next (in a raw one it is text, and so are braces).
fn multiline(src: List[u8], inout l: L, israw: bool, all: bool, inout toks: List[Tok], inout strs: List[List[u8]], inout bad: List[Bad], inout bad_end: usize, inout names: intern.Interner) {
    let start = l.copy()
    if israw { step(src, inout l) }
    while src[l.i] != 10 { step(src, inout l) }
    step(src, inout l)
    let mark = toks.len()
    toks.push(tok(FStart, start, l, 0))
    // the closing line: the first whose text starts with `"""`
    let mut ls = l.i.copy()
    let mut close: usize = src.len()
    let mut ind: usize = 0
    while ls < src.len() {
        let mut j = ls.copy()
        while j < src.len() && (src[j] == 32 || src[j] == 9) { j += 1 }
        if at(src, j) == 34 && at(src, j + 1) == 34 && at(src, j + 2) == 34 {
            close = ls
            ind = j - ls
            break
        }
        while j < src.len() && src[j] != 10 { j += 1 }
        ls = j + 1
    }
    let mut p = Piece(List.new(), l.copy(), false)
    if close == src.len() {
        bad.push(fail(start, "unterminated multi-line string: end it with `\"\"\"` on a line of its own"))
        while l.i < src.len() { step(src, inout l) }
        p.reported = true
    }
    let mut joined = true
    while l.i < close {
        let mut le = l.i.copy()
        while le < src.len() && src[le] != 10 { le += 1 }
        let mut te = le.copy()
        if te > l.i && src[te - 1] == 13 { te -= 1 }
        if !joined { p.cur.push(10) }
        joined = false
        let mut k: usize = 0
        while k < ind && l.i + k < te && src[l.i + k] == src[close + k] { k += 1 }
        let mut blank = true
        for x in l.i..te {
            if src[x] != 32 && src[x] != 9 { blank = false }
        }
        if blank {
            while l.i < te { step(src, inout l) }
        } else if k < ind {
            if !p.reported { bad.push(fail(l, "this line is indented less than the closing `\"\"\"`: indent it at least as far")) }
            p.reported = true
            while l.i < te { step(src, inout l) }
        } else {
            while k > 0 {
                step(src, inout l)
                k -= 1
            }
            // a backslash ending the line (an odd run of them) joins the next line
            if israw {
                while l.i < te {
                    p.cur.push(src[l.i])
                    step(src, inout l)
                }
            } else {
                let mut n: usize = 0
                while te - n > l.i && src[te - n - 1] == 92 { n += 1 }
                if n % 2 == 1 {
                    te -= 1
                    joined = true
                }
                pieces(src, inout l, te, true, inout p, all, inout toks, inout strs, inout bad, inout bad_end, inout names)
                if joined { step(src, inout l) }
            }
        }
        while l.i <= le && l.i < src.len() { step(src, inout l) }
    }
    if close < src.len() {
        for x in 0..(ind + 3) { step(src, inout l) }
    }
    finish(inout p, start, l, l, mark, inout toks, inout strs)
}

/// Display name of a token kind, as used in dumps and messages.
pub fn kind_text(k: Kind) -> str {
    match k {
        Ident => "ident"
        Int => "int"
        Str => "str"
        Newline => "newline"
        Eof => "eof"
        Arrow => "->"
        FatArrow => "=>"
        EqEq => "=="
        NotEq => "!="
        LtEq => "<="
        GtEq => ">="
        AndAnd => "&&"
        OrOr => "||"
        WAdd => "+%"
        WSub => "-%"
        WMul => "*%"
        PlusEq => "+="
        MinusEq => "-="
        StarEq => "*="
        SlashEq => "/="
        PercentEq => "%="
        DotDot => ".."
        Question => "?"
        LParen => "("
        RParen => ")"
        LBrace => r"{"
        RBrace => r"}"
        LBracket => "["
        RBracket => "]"
        Comma => ","
        Colon => ":"
        Semi => ";"
        Dot => "."
        Plus => "+"
        Minus => "-"
        Star => "*"
        Slash => "/"
        Percent => "%"
        Lt => "<"
        Gt => ">"
        Eq => "="
        Bang => "!"
        Pipe => "|"
        Amp => "&"
        Caret => "^"
        Tilde => "~"
        Shl => "<<"
        Shr => ">>"
        AmpEq => "&="
        PipeEq => "|="
        CaretEq => "^="
        ShlEq => "<<="
        ShrEq => ">>="
        At => "@"
        FStart => "\""
        FText => "ftext"
        FHole => r"{"
        FClose => r"}"
        FEnd => "\""
    }
}

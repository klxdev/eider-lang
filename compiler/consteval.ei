// comptime: `const X: T = comptime expr` (docs/compiler.md, "C7: comptime").
//
// Each comptime constant is evaluated (the behaviour tests/oracle records), in
// item order and after the module graph is loaded but before checking, by compiling the
// program without `main`, test blocks and the comptime constants still to evaluate, plus a
// synthetic evaluator
//
//   fn __ct() -> T { return expr }
//   fn main() uses io { print(__ct()) }
//
// placed in the constant's module, running it, and splicing the printed value back in as a
// literal; later comptime constants then see it as an ordinary constant. Errors are its:
// E0807 for a type other than an integer or bool, a failed evaluation (the first line the
// evaluator wrote to stderr, e.g. a trap; traps name the file `program`) or output beyond
// one line; any error from checking the evaluator program, with an E0201 fix (the missing
// capability is the evaluator's, not the user's) replaced by "`comptime` evaluation can't
// use capabilities".
//
// eiderc does the same with its own pipeline in-process: the evaluator program is a copy of
// the resolved program with rewritten item lists (`evaluator`), checked by check.ei
// (`checked`). Only `run_evaluator` depends on how the value is computed: today it lowers the
// IR to C, builds it with the driver's C compiler invocation and runs it. A later IR
// interpreter (no C compiler at compile time, no capabilities by construction) replaces
// that one function; the rest of this module stays.
//
// `comptime` is a keyword, so no module path can name a comptime.ei: the module is
// consteval.ei (`import eiderc.consteval`; docs/compiler.md, "C8.26").

import core.sys
import std.bytes
import std.fs
import std.proc
import eiderc.intern
import eiderc.lex
import eiderc.ast
import eiderc.diag
import eiderc.resolve
import eiderc.check
import eiderc.lower
import eiderc.driver

fn s(x: str) -> List[u8] { sys.lit(x) }

fn sym(inout p: resolve.Program, w: str) -> u32 {
    let b = sys.lit(w)
    intern.intern(inout p.names, b, 0, b.len())
}

/// What evaluating one constant gave: its printed value (stdout), or why there is none.
pub type Outcome = | Printed(out: List[u8]) | Failed(why: List[u8]) | NoBuild

/// Evaluate every comptime constant of `p`, in item order; the result has each replaced by
/// its value as a literal. The first diagnostic, if there is one (see eval_all).
pub fn eval(p: resolve.Program) -> Result[resolve.Program, diag.Diag] uses io, fs, net, clock {
    let ev = eval_all(p)
    if ev.diags.len() > 0 { return Err(ev.diags[0]) }
    Ok(ev.p)
}

/// The program with its comptime constants evaluated, and the diagnostics of evaluating
/// them (one per constant that failed), in item order.
pub type Evaluated = { p: resolve.Program, diags: List[diag.Diag] }

/// Evaluate every comptime constant of `p`, in item order. A constant whose evaluation
/// fails is reported (the evaluator's first diagnostic) and becomes a constant of the error
/// type (its `comptime` flag 2), which check.ei accepts silently, and the rest go on.
pub fn eval_all(p: resolve.Program) -> Evaluated uses io, fs, net, clock {
    let mut prog = p.copy()
    let mut diags: List[diag.Diag] = List.new()
    let mut r = Runner(List.new(), List.new(), false)
    for m in p.order {
        let a = p.mods[m as usize].ast
        for k in 0..a.items_len {
            let id = ast.at(a, a.items_start, k)
            let n = a.nodes[id as usize]
            if n.kind == ast.IConst && n.e == 1 {
                match eval_one(inout prog, inout r, m, id) {
                    Ok(_) => {}
                    Err(d) => {
                        diags.push(d)
                        let mut md = prog.mods[m as usize].copy()
                        let mut cn = md.ast.nodes[id as usize].copy()
                        cn.e = 2
                        md.ast.nodes[id as usize] = cn
                        prog.mods[m as usize] = md
                    }
                }
            }
        }
    }
    finish(r)
    Evaluated(prog, diags)
}

fn e0807(p: resolve.Program, m: u32, n: ast.Node, msg: List[u8]) -> diag.Diag {
    let mut d = diag.new("E0807", n.line, n.col, msg)
    d.file = p.mods[m as usize].path
    d
}

/// Whether type node `t` of module m names an integer type or bool (judged from the
/// type's spelling, before resolving it).
fn int_or_bool(inout p: resolve.Program, m: u32, t: u32) -> u32 {
    let tn = p.mods[m as usize].ast.nodes[t as usize].copy()
    if tn.kind != ast.TName || tn.b != 0 { return 0 }
    for w in ["i32", "i64", "u8", "u32", "u64", "usize"] {
        if tn.a == sym(inout p, w) { return 1 }
    }
    if tn.a == sym(inout p, "bool") { return 2 }
    0
}

/// Evaluate the comptime constant `id` of module m and splice its value into `p`.
fn eval_one(inout p: resolve.Program, inout r: Runner, m: u32, id: u32) -> Result[bool, diag.Diag] uses io, fs, net, clock {
    let n = p.mods[m as usize].ast.nodes[id as usize].copy()
    let kind = int_or_bool(inout p, m, n.c)
    if kind == 0 { return Err(e0807(p, m, n, s("`comptime` constants must be integers or bool"))) }
    let ev = evaluator(inout p, m, id)
    let c = checked(ev)?
    let name = resolve.key_text(p.names, resolve.item_key(p, m, n.a))
    let outcome = run_evaluator(inout r, c)
    let out = match outcome {
        Printed(o) => o
        Failed(why) => {
            let mut msg = s("comptime evaluation of `")
            bytes.append(inout msg, name)
            bytes.append(inout msg, s("` failed: "))
            bytes.append(inout msg, why)
            return Err(e0807(p, m, n, msg))
        }
        NoBuild => { return Err(e0807(p, m, n, s("could not build the comptime evaluator"))) }
    }
    let ls = bytes.lines(out)
    if ls.len() > 1 { return Err(e0807(p, m, n, s("comptime evaluation can't perform I/O"))) }
    let mut first: List[u8] = List.new()
    if ls.len() > 0 { first = bytes.trim(ls[0]) }
    let vn = p.mods[m as usize].ast.nodes[n.d as usize]
    let mut md = p.mods[m as usize].copy()
    let mut lit = ast.node(ast.EBool, vn.line, vn.col)
    if kind == 2 {
        if bytes.eq(first, s("true")) { lit.a = 1 }
    } else {
        let mut neg = false
        let mut digits = first.copy()
        if first.len() > 0 && (first[0] == 45 || first[0] == 43) {
            neg = first[0] == 45
            digits = bytes.slice(first, 1, first.len())
        }
        let v: u64 = match bytes.parse_u64(digits) {
            Some(x) => x
            None => {
                let mut msg = s("unexpected comptime result `")
                bytes.append(inout msg, first)
                bytes.append(inout msg, s("`"))
                return Err(e0807(p, m, n, msg))
            }
        }
        // as tests/oracle expects: a negative value is `-(magnitude)`, both at the expression's position
        md.toks.push(lex.Tok(lex.Int, 0, 0, vn.line, vn.col, vn.col, v, false))
        lit = ast.node(ast.EInt, vn.line, vn.col)
        lit.a = (md.toks.len() - 1) as u32
        if neg && v > 0 {
            let inner = ast.add(inout md.ast, lit)
            lit = ast.node(ast.EUnary, vn.line, vn.col)
            lit.a = 0
            lit.b = inner
        }
    }
    let mut cn = n.copy()
    cn.d = ast.add(inout md.ast, lit)
    cn.e = 0
    md.ast.nodes[id as usize] = cn
    p.mods[m as usize] = md
    Ok(true)
}

/// The evaluator program for comptime constant `id` of module m: `p` without `main`, test
/// blocks and comptime constants, plus `__ct` and a `main` printing it at the end of m's
/// items (see the top of this file). The recorded oracle has the two after every item of the
/// program, which is the same place when m is the entry file; for a constant of an imported
/// module only the order in which two independent errors are found can differ. The nodes
/// take the positions they have in the stub text above (`__ct` at 1:4 for E0107), the
/// return statement the expression's.
fn evaluator(inout p: resolve.Program, m: u32, id: u32) -> resolve.Program {
    let s_ct = sym(inout p, "__ct")
    let s_main = sym(inout p, "main")
    let s_print = sym(inout p, "print")
    let s_io = sym(inout p, "io")
    let mut ev = p.copy()
    for i in 0..ev.mods.len() {
        let mut md = ev.mods[i].copy()
        let mut keep: List[u32] = List.new()
        for k in 0..md.ast.items_len {
            let it = ast.at(md.ast, md.ast.items_start, k)
            let n = md.ast.nodes[it as usize]
            let is_main = n.kind == ast.IFn && n.a == s_main && !ast.has(n.b, ast.FN_EXTERN)
            let drop = n.kind == ast.ITest || (n.kind == ast.IConst && n.e == 1) || is_main
            // (a constant whose evaluation failed, `e` 2, stays: it is of the error type)
            if !drop { keep.push(it) }
        }
        if i as u32 == m {
            let c = md.ast.nodes[id as usize].copy()
            let v = md.ast.nodes[c.d as usize].copy()
            // fn __ct() -> T { return expr }
            let mut ret = ast.node(ast.SReturn, v.line, v.col)
            ret.a = c.d + 1
            let mut rs: List[u32] = List.new()
            rs.push(ast.add(inout md.ast, ret))
            let mut body = ast.node(ast.Block, v.line, v.col)
            body.c = ast.list(inout md.ast, rs)
            body.d = 1
            let empty: List[u32] = List.new()
            let mut f = ast.node(ast.IFn, 1, 4)
            f.a = s_ct
            f.c = ast.list(inout md.ast, empty)
            f.e = f.c
            f.g = c.c + 1
            f.h = ast.add(inout md.ast, body) + 1
            f.i = f.c
            f.end_col = 17
            keep.push(ast.add(inout md.ast, f))
            // fn main() uses io { print(__ct()) }
            let mut call = ast.node(ast.ECall, 2, 27)
            call.a = s_ct
            call.c = f.c
            let mut arg = ast.node(ast.EArg, 2, 27)
            arg.a = ast.add(inout md.ast, call)
            let mut args: List[u32] = List.new()
            args.push(ast.add(inout md.ast, arg))
            let mut pr = ast.node(ast.ECall, 2, 21)
            pr.a = s_print
            pr.c = ast.list(inout md.ast, args)
            pr.d = 1
            let mut st = ast.node(ast.SExpr, 2, 21)
            st.a = ast.add(inout md.ast, pr)
            let mut ss: List[u32] = List.new()
            ss.push(ast.add(inout md.ast, st))
            let mut mb = ast.node(ast.Block, 2, 19)
            mb.c = ast.list(inout md.ast, ss)
            mb.d = 1
            mb.end_line = 2
            mb.end_col = 35
            let mut cap = ast.node(ast.Cap, 2, 16)
            cap.a = s_io
            let mut caps: List[u32] = List.new()
            caps.push(ast.add(inout md.ast, cap))
            let mut mf = ast.node(ast.IFn, 2, 4)
            mf.a = s_main
            mf.c = f.c
            mf.e = f.c
            mf.h = ast.add(inout md.ast, mb) + 1
            mf.i = ast.list(inout md.ast, caps)
            mf.j = 1
            mf.end_col = 18
            keep.push(ast.add(inout md.ast, mf))
            // `__ct` is one of the module's own names (prefixed in an imported module)
            md.own.insert(s_ct, true)
        }
        md.ast.items_start = ast.list(inout md.ast, keep)
        md.ast.items_len = keep.len() as u32
        ev.mods[i] = md
    }
    ev
}

/// Check the evaluator program as tests/oracle records: its errors are reported as they are, except
/// that a missing capability can't be fixed by adding it (the evaluator has none).
fn checked(ev: resolve.Program) -> Result[check.C, diag.Diag] {
    // the first diagnostic: the rest of the program's are found again when it is checked
    match check.check_mode(ev, false) {
        Ok(c) => Ok(c)
        Err(d) => {
            let mut d2 = d.copy()
            let has_fix = match d.fix {
                Some(_) => true
                None => false
            }
            if bytes.eq(s(d.code), s("E0201")) && has_fix {
                d2.fix = None
                d2.help = s("`comptime` evaluation can't use capabilities")
            }
            Err(d2)
        }
    }
}

/// The evaluators' build state: a temporary directory holding the C core compiled once
/// (`objs`: eider_rt.o, eider_core.o) for every constant of the program; `broken` when that
/// failed.
type Runner = { dir: List[u8], objs: List[List[u8]], broken: bool }

fn finish(r: Runner) uses fs {
    if r.dir.len() > 0 { fs.remove_all(r.dir) }
}

/// Run a C compiler command quietly; whether it succeeded.
fn cc_ok(argv: List[List[u8]]) -> bool uses io, fs, net {
    match proc.run_with(argv, proc.captured()) {
        Ok(o) => o.code == 0
        Err(_) => false
    }
}

/// Compile the C core into `r.dir` (once).
fn prepare(inout r: Runner) uses io, fs, net, clock {
    if r.dir.len() > 0 || r.broken { return }
    r.dir = driver.temp_dir()
    let core = fs.join(driver.root(), s("core"))
    for name in ["eider_rt", "eider_core"] {
        let mut src = fs.join(core, s(name))
        bytes.append(inout src, s(".c"))
        let mut obj = fs.join(r.dir, s(name))
        bytes.append(inout obj, s(".o"))
        let mut argv = driver.cc_argv(core, false)
        argv.push(s("-c"))
        argv.push(s("-o"))
        argv.push(obj)
        argv.push(src)
        if !cc_ok(argv) { r.broken = true }
        r.objs.push(obj)
    }
}

/// Run the checked evaluator: lower it to C (traps name the file `program`, as the oracle's
/// do), build it with the driver's C compiler invocation at -O0 against the core compiled
/// once (`prepare`), and run it, capturing its output. This is the one function an IR
/// interpreter would replace.
fn run_evaluator(inout r: Runner, c: check.C) -> Outcome uses io, fs, net, clock {
    let lp = lower.P(c.ir, c.t, c.p.names)
    let text = match lower.program_for(lp, s("program"), false, false) {
        Ok(t) => t
        Err(_) => { return NoBuild }
    }
    if driver.cache_dir().len() > 0 {
        // with the cache on, the driver links the cached core objects, and an evaluator
        // whose C was built before (an unchanged constant) isn't compiled again
        let e: driver.Exe = match driver.try_executable(text, s("ct"), false, List.new()) {
            Some(x) => x
            None => { return NoBuild }
        }
        let mut argv: List[List[u8]] = List.new()
        argv.push(e.path)
        let got = proc.run_with(argv, proc.captured())
        driver.discard(e)
        return match got {
            Ok(o) => outcome(o)
            Err(_) => NoBuild
        }
    }
    prepare(inout r)
    if r.broken { return NoBuild }
    let cfile = fs.join(r.dir, s("ct.c"))
    let exe = fs.join(r.dir, s("ct"))
    let core = fs.join(driver.root(), s("core"))
    let mut argv = driver.cc_argv(core, false)
    argv.push(s("-o"))
    argv.push(exe)
    argv.push(cfile)
    for o in r.objs { argv.push(o) }
    let mut built = false
    match fs.write(cfile, text) {
        Ok(_) => { built = cc_ok(argv) }
        Err(_) => {}
    }
    if !built { return NoBuild }
    let mut run: List[List[u8]] = List.new()
    run.push(exe)
    match proc.run_with(run, proc.captured()) {
        Ok(o) => outcome(o)
        Err(_) => NoBuild
    }
}

/// What an evaluator's run means: its output, or the first line of its trap.
fn outcome(o: proc.Output) -> Outcome {
    if o.code == 0 { return Printed(o.out) }
    let errs = bytes.lines(o.err)
    if errs.len() > 0 { return Failed(errs[0]) }
    Failed(List.new())
}

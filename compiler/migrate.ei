// migrate: `eiderc migrate-strings` (docs/compiler.md, "C8.28: string literals", decision U29)
// and `eiderc migrate-attrs` ("C8.60: grouped attributes").
//
// Every plain string literal interpolates (`"n = {n}"`). Code written before that has
// literals with braces that meant themselves; this rewrites each of them so that it means
// what it meant: a literal without a backslash becomes a raw string (`r"..."`, `r"""` for a
// multi-line one), any other gets its braces doubled (`{{`, `}}`), or with `portable` the
// escapes `\x7b` and `\x7d` (which mean a brace to a compiler from before the change too: the
// bootstrap step for compiler/ and what the seed compiles, seed/README.md). The `f` of an
// `f"..."` (the prefix before the change) is dropped. Literals are found by the rules from
// before: comments and raw strings are skipped, `"""` at the end of a line starts a multi-line
// literal. In a Markdown file only the ```eider code blocks are rewritten.
//
// This file must mean the same to a compiler from before the change: its literals have no
// braces (they are spelled 123 and 125).

import core.sys
import std.bytes
import eiderc.diag

type Cur = { i: usize, line: u32, col: u32 }

fn at(src: List[u8], i: usize) -> u8 {
    if i < src.len() { return src[i] }
    0
}

fn step(src: List[u8], inout c: Cur) {
    let b = src[c.i]
    if b == 10 {
        c.line += 1
        c.col = 1
    } else if b < 128 || b >= 192 {
        c.col += 1
    }
    c.i += 1
}

fn ident_char(b: u8) -> bool { (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 }

/// `"""` at i followed only by spaces before the line break.
fn multi_open(src: List[u8], i: usize) -> bool {
    if at(src, i) != 34 || at(src, i + 1) != 34 || at(src, i + 2) != 34 { return false }
    let mut j = i + 3
    while at(src, j) == 32 || at(src, j) == 9 || at(src, j) == 13 { j += 1 }
    at(src, j) == 10
}

fn has(b: List[u8], x: u8) -> bool {
    for y in b {
        if y == x { return true }
    }
    false
}

/// The length of the escape at t[i] (a backslash): `\\u{...}` through its closing brace, any
/// other two bytes.
fn escape_len(t: List[u8], i: usize) -> usize {
    if at(t, i + 1) == 117 && at(t, i + 2) == 123 {
        let mut j = i + 3
        while j < t.len() && t[j] != 125 { j += 1 }
        return if j < t.len() { j + 1 - i } else { t.len() - i }
    }
    if i + 1 < t.len() { return 2 }
    1
}

/// Whether t has a brace outside its escapes.
fn has_brace(t: List[u8]) -> bool {
    let mut i: usize = 0
    while i < t.len() {
        if t[i] == 92 {
            i += escape_len(t, i)
        } else {
            if t[i] == 123 || t[i] == 125 { return true }
            i += 1
        }
    }
    false
}

/// Text with its braces (not those of a `\\u{...}` escape) doubled, or (portable) written as
/// escapes.
fn braces(t: List[u8], portable: bool) -> List[u8] {
    let mut out: List[u8] = List.new()
    let mut i: usize = 0
    while i < t.len() {
        let b = t[i]
        if b == 92 {
            let n = escape_len(t, i)
            bytes.append(inout out, bytes.slice(t, i, i + n))
            i += n
            continue
        }
        if b == 123 || b == 125 {
            if portable {
                bytes.append(inout out, sys.lit("\\x7"))
                let h: u8 = if b == 123 { 98 } else { 100 }
                out.push(h)
            } else {
                out.push(b)
                out.push(b)
            }
        } else {
            out.push(b)
        }
        i += 1
    }
    out
}

/// The fixes for src[start..end) (a whole file, or a code block of a Markdown file that
/// starts at line `line`).
fn scan(src: List[u8], start: usize, end: usize, line: u32, portable: bool, inout fixes: List[diag.Fix]) {
    let mut c = Cur(start, line, 1)
    while c.i < end {
        let b = src[c.i]
        if b == 47 && at(src, c.i + 1) == 47 {
            while c.i < end && src[c.i] != 10 { step(src, inout c) }
        } else if b == 47 && at(src, c.i + 1) == 42 {
            step(src, inout c)
            step(src, inout c)
            while c.i < end && !(src[c.i] == 42 && at(src, c.i + 1) == 47) { step(src, inout c) }
            if c.i < end {
                step(src, inout c)
                step(src, inout c)
            }
        } else if ident_char(b) {
            let w0 = c.copy()
            while c.i < end && ident_char(src[c.i]) { step(src, inout c) }
            let one = c.i == w0.i + 1
            if one && b == 114 && (at(src, c.i) == 34 || at(src, c.i) == 35) {
                skip_raw(src, end, inout c)
            } else if one && b == 102 && at(src, c.i) == 34 {
                // `f"`: the prefix goes; the literal already has the new form
                fixes.push(diag.Fix(w0.line, w0.col, 1, List.new()))
                if multi_open(src, c.i) { skip_multi(src, end, inout c) } else { skip_plain(src, end, inout c) }
            }
        } else if b == 34 {
            literal(src, end, portable, inout c, inout fixes)
        } else {
            step(src, inout c)
        }
    }
}

/// Past a raw literal at c (after its `r`).
fn skip_raw(src: List[u8], end: usize, inout c: Cur) {
    let mut n: usize = 0
    while c.i < end && src[c.i] == 35 {
        n += 1
        step(src, inout c)
    }
    if c.i >= end || src[c.i] != 34 { return }
    step(src, inout c)
    while c.i < end && src[c.i] != 10 {
        if src[c.i] == 34 {
            let mut k: usize = 0
            while k < n && at(src, c.i + 1 + k) == 35 { k += 1 }
            if k == n {
                for x in 0..(n + 1) { step(src, inout c) }
                return
            }
        }
        step(src, inout c)
    }
}

/// The end (offset of the closing quote, or of the line's end) of a one-line literal whose
/// text starts at i.
fn plain_end(src: List[u8], end: usize, i: usize) -> usize {
    let mut j = i.copy()
    while j < end && src[j] != 10 && src[j] != 34 {
        if src[j] == 92 && j + 1 < end && src[j + 1] != 10 { j += 1 }
        j += 1
    }
    j
}

fn skip_plain(src: List[u8], end: usize, inout c: Cur) {
    step(src, inout c)
    let e = plain_end(src, end, c.i)
    while c.i < e { step(src, inout c) }
    if c.i < end && src[c.i] == 34 { step(src, inout c) }
}

/// The offset just past the closing `"""` of the multi-line literal at i, or `end`.
fn multi_end(src: List[u8], end: usize, i: usize) -> usize {
    let mut j = i.copy()
    while j < end && src[j] != 10 { j += 1 }
    j += 1
    while j < end {
        let mut k = j.copy()
        while k < end && (src[k] == 32 || src[k] == 9) { k += 1 }
        if at(src, k) == 34 && at(src, k + 1) == 34 && at(src, k + 2) == 34 { return k + 3 }
        while j < end && src[j] != 10 { j += 1 }
        j += 1
    }
    end
}

fn skip_multi(src: List[u8], end: usize, inout c: Cur) {
    let e = multi_end(src, end, c.i)
    while c.i < e && c.i < end { step(src, inout c) }
}

/// A plain literal at c (its `"`): a fix when its text has a brace.
fn literal(src: List[u8], end: usize, portable: bool, inout c: Cur, inout fixes: List[diag.Fix]) {
    let s0 = c.copy()
    let mut e: usize = 0
    let mut text_from: usize = 0
    let mut text_to: usize = 0
    let multi = multi_open(src, c.i)
    if multi {
        e = multi_end(src, end, c.i)
        text_from = c.i + 3
        text_to = e - 3
    } else {
        let te = plain_end(src, end, c.i + 1)
        text_from = c.i + 1
        text_to = te
        e = if te < end && src[te] == 34 { te + 1 } else { te }
    }
    let text = bytes.slice(src, text_from, text_to)
    let old = bytes.slice(src, c.i, e)
    while c.i < e && c.i < end { step(src, inout c) }
    if !has_brace(text) { return }
    let mut new: List[u8] = List.new()
    if !has(text, 92) && !(multi && portable) {
        // a raw string: the same bytes, no escapes to keep
        new.push(114)
        bytes.append(inout new, old)
    } else if multi {
        bytes.append(inout new, sys.lit("\"\"\""))
        bytes.append(inout new, braces(text, portable))
        bytes.append(inout new, sys.lit("\"\"\""))
    } else {
        new.push(34)
        bytes.append(inout new, braces(text, portable))
        if src[e - 1] == 34 && e - 1 >= text_to { new.push(34) }
    }
    fixes.push(diag.Fix(s0.line, s0.col, old.len() as u64, new))
}

fn starts(src: List[u8], i: usize, w: str) -> bool {
    let b = sys.lit(w)
    for k in 0..b.len() {
        if at(src, i + k) != b[k] { return false }
    }
    true
}

/// The fixes for a whole file (`md`: only its ```eider code blocks).
pub fn fixes(src: List[u8], md: bool, portable: bool) -> List[diag.Fix] {
    let mut out: List[diag.Fix] = List.new()
    if !md {
        scan(src, 0, src.len(), 1, portable, inout out)
        return out
    }
    let mut i: usize = 0
    let mut line: u32 = 1
    let mut in_block = false
    let mut bstart: usize = 0
    let mut bline: u32 = 0
    while i < src.len() {
        let mut j = i.copy()
        while j < src.len() && src[j] != 10 { j += 1 }
        let mut k = i.copy()
        while k < j && src[k] == 32 { k += 1 }
        let fence = starts(src, k, "```")
        if in_block && fence {
            scan(src, bstart, i, bline, portable, inout out)
            in_block = false
        } else if !in_block && fence && starts(src, k + 3, "eider") {
            in_block = true
            bstart = j + 1
            bline = line + 1
        }
        i = j + 1
        line += 1
    }
    out
}

/// `eiderc migrate-strings`: the file rewritten, or with `json` one line per fix.
pub fn run(file: List[u8], src: List[u8], json: bool, portable: bool) -> List[u8] {
    let md = bytes.ends_with(file, sys.lit(".md"))
    let fs = fixes(src, md, portable)
    if !json {
        // applied last first, so the positions of the earlier ones stay right
        let mut out = src.copy()
        let mut k = fs.len()
        while k > 0 {
            k -= 1
            out = diag.apply_fix(out, fs[k])
        }
        return out
    }
    let mut out: List[u8] = List.new()
    for f in fs {
        let mut d = diag.new("E0000", f.line, f.col, sys.lit("a string literal now interpolates its braces: rewritten to mean what it meant"))
        d.fix = Some(f)
        let j = diag.json(d, file)
        // the JSON object starts with "error":"E0000" (16 bytes with its brace)
        out.push(123)
        bytes.append(inout out, sys.lit("\"migrate\":\"string-literal\""))
        bytes.append(inout out, bytes.slice(j, 16, j.len()))
        out.push(10)
    }
    out
}

// ---- migrate-attrs: the bare `@name(...)` becomes `@[name(...)]`

/// The offset just past the attribute at i (after its `@`): a dotted name and, when `(`
/// follows, its balanced parentheses (strings skipped).
fn attr_end(src: List[u8], end: usize, i: usize) -> usize {
    let mut c = Cur(i, 1, 1)
    while c.i < end && (ident_char(src[c.i]) || src[c.i] == 46) { step(src, inout c) }
    if at(src, c.i) != 40 { return c.i }
    let mut depth: u32 = 0
    while c.i < end {
        let b = src[c.i]
        if b == 34 {
            if multi_open(src, c.i) { skip_multi(src, end, inout c) } else { skip_plain(src, end, inout c) }
            continue
        }
        if b == 40 { depth += 1 }
        if b == 41 {
            depth -= 1
            if depth == 0 {
                step(src, inout c)
                return c.i
            }
        }
        step(src, inout c)
    }
    c.i
}

/// The fixes for the bare attributes of src[start..end): the ones in a row on a line become
/// one group.
fn scan_attrs(src: List[u8], start: usize, end: usize, line: u32, inout fixes: List[diag.Fix]) {
    let mut c = Cur(start, line, 1)
    while c.i < end {
        let b = src[c.i]
        if b == 47 && at(src, c.i + 1) == 47 {
            while c.i < end && src[c.i] != 10 { step(src, inout c) }
        } else if b == 47 && at(src, c.i + 1) == 42 {
            step(src, inout c)
            step(src, inout c)
            while c.i < end && !(src[c.i] == 42 && at(src, c.i + 1) == 47) { step(src, inout c) }
            if c.i < end {
                step(src, inout c)
                step(src, inout c)
            }
        } else if ident_char(b) {
            let w0 = c.copy()
            while c.i < end && ident_char(src[c.i]) { step(src, inout c) }
            if c.i == w0.i + 1 && b == 114 && (at(src, c.i) == 34 || at(src, c.i) == 35) { skip_raw(src, end, inout c) }
        } else if b == 34 {
            if multi_open(src, c.i) { skip_multi(src, end, inout c) } else { skip_plain(src, end, inout c) }
        } else if b == 64 && ident_char(at(src, c.i + 1)) {
            let s0 = c.copy()
            let mut texts: List[List[u8]] = List.new()
            while true {
                let from = c.i + 1
                let e = attr_end(src, end, from)
                texts.push(bytes.slice(src, from, e))
                while c.i < e { step(src, inout c) }
                let mut j = c.i.copy()
                while at(src, j) == 32 || at(src, j) == 9 { j += 1 }
                if j < end && at(src, j) == 64 && ident_char(at(src, j + 1)) {
                    while c.i < j { step(src, inout c) }
                } else {
                    break
                }
            }
            let mut new: List[u8] = List.new()
            bytes.append(inout new, sys.lit("@["))
            for k in 0..texts.len() {
                if k > 0 { bytes.append(inout new, sys.lit(", ")) }
                bytes.append(inout new, texts[k])
            }
            new.push(93)
            fixes.push(diag.Fix(s0.line, s0.col, (c.i - s0.i) as u64, new))
        } else {
            step(src, inout c)
        }
    }
}

/// `eiderc migrate-attrs`: the file with its bare attributes in groups (a `.md`: its ```eider
/// blocks only), or with `json` one line per fix.
pub fn run_attrs(file: List[u8], src: List[u8], json: bool) -> List[u8] {
    let md = bytes.ends_with(file, sys.lit(".md"))
    let mut fs: List[diag.Fix] = List.new()
    if !md {
        scan_attrs(src, 0, src.len(), 1, inout fs)
    } else {
        let mut i: usize = 0
        let mut line: u32 = 1
        let mut in_block = false
        let mut bstart: usize = 0
        let mut bline: u32 = 0
        while i < src.len() {
            let mut j = i.copy()
            while j < src.len() && src[j] != 10 { j += 1 }
            let mut k = i.copy()
            while k < j && src[k] == 32 { k += 1 }
            let fence = starts(src, k, "```")
            if in_block && fence {
                scan_attrs(src, bstart, i, bline, inout fs)
                in_block = false
            } else if !in_block && fence && starts(src, k + 3, "eider") {
                in_block = true
                bstart = j + 1
                bline = line + 1
            }
            i = j + 1
            line += 1
        }
    }
    if !json {
        let mut out = src.copy()
        let mut k = fs.len()
        while k > 0 {
            k -= 1
            out = diag.apply_fix(out, fs[k])
        }
        return out
    }
    let mut out: List[u8] = List.new()
    for f in fs {
        let mut d = diag.new("E0000", f.line, f.col, sys.lit("an attribute is written `@[name(...)]`: rewritten"))
        d.fix = Some(f)
        let j = diag.json(d, file)
        out.push(123)
        bytes.append(inout out, sys.lit("\"migrate\":\"attribute\""))
        bytes.append(inout out, bytes.slice(j, 16, j.len()))
        out.push(10)
    }
    out
}

// eiderc: the Eider compiler, written in Eider. See docs/compiler.md.
//
//   eiderc lex <file.ei>            dump tokens (one per line: line:col kind [value])
//   eiderc check <file.ei> [--json] report the first error, or print `ok` (lex + parse so far)

import "deps/core/sys.ei"
import "deps/std/bytes.ei"
import "deps/std/fs.ei"
import "deps/std/io.ei"
import "deps/std/env.ei"
import "intern.ei"
import "lex.ei"
import "diag.ei"
import "parse.ei"

type Args = { cmd: List[u8], file: List[u8], json: bool }

/// Comparisons go through a function so no owned temporary sits in an `else if` condition
/// (the bootstrap drops such temporaries outside the block that declares them).
fn is(a: List[u8], s: str) -> bool uses ffi { bytes.eq(a, sys.lit(s)) }

fn usage() uses io, ffi {
    io.err(sys.lit("usage: eiderc (lex | check) <file.ei> [--json]\n"))
    env.exit(2)
}

fn parse_args() -> Args uses io, ffi {
    let argv = env.args()
    var cmd: List[u8] = List.new()
    var file: List[u8] = List.new()
    var json = false
    for i in 1..argv.len() {
        let a = argv[i]
        if is(a, "--json") {
            json = true
        } else if cmd.len() == 0 {
            cmd = a
        } else if file.len() == 0 {
            file = a
        }
    }
    if cmd.len() == 0 || file.len() == 0 { usage() }
    Args(cmd, file, json)
}

/// Print `d` like the bootstrap: JSON on stdout, or the rendered form on stderr.
fn report(d: diag.Diag, a: Args, src: List[u8]) uses io, ffi {
    if a.json {
        io.outln(diag.json(d, a.file))
    } else {
        io.err(diag.render(d, a.file, src))
    }
}

fn lex_diag(r: lex.Lex) -> Option[diag.Diag] uses ffi {
    match r {
        lex.Done(_) => None
        lex.Failed(e) => Some(diag.new("E0001", e.line, e.col, sys.lit(e.msg)))
        lex.BadChar(line, col, ch) => {
            var m = sys.lit("unexpected character `")
            bytes.append(inout m, ch)
            m.push(96)
            Some(diag.new("E0001", line, col, m))
        }
    }
}

fn dump(lx: lex.Lexed, names: intern.Interner) uses io, ffi {
    var out: List[u8] = List.new()
    for t in lx.toks {
        bytes.append(inout out, bytes.from_u64(t.line as u64))
        out.push(58)
        bytes.append(inout out, bytes.from_u64(t.col as u64))
        out.push(45)
        bytes.append(inout out, bytes.from_u64(t.end_col as u64))
        out.push(32)
        bytes.append(inout out, sys.lit(lex.kind_text(t.kind)))
        match t.kind {
            lex.Ident => {
                out.push(32)
                bytes.append(inout out, intern.name(names, t.val as u32))
            }
            lex.Int => {
                out.push(32)
                bytes.append(inout out, bytes.from_u64(t.val))
                if t.big { bytes.append(inout out, sys.lit(" (big)")) }
            }
            lex.Str => {
                out.push(32)
                diag.debug_str(inout out, lx.strs[t.val as usize])
            }
            _ => {}
        }
        out.push(10)
    }
    io.out(out)
}

fn main() uses io, fs, ffi {
    let a = parse_args()
    let src = match fs.read(a.file) {
        Ok(s) => s
        Err(e) => {
            var m = String.from("eiderc: ")
            m.append(e)
            print(m)
            env.exit(2)
            return
        }
    }
    var names = intern.new()
    let r = lex.lex(src, inout names)
    match lex_diag(r) {
        Some(d) => {
            report(d, a, src)
            env.exit(1)
        }
        None => {}
    }
    let lx = match r {
        lex.Done(l) => l
        _ => { return }
    }
    if is(a.cmd, "lex") {
        dump(lx, names)
        return
    }
    let p = match parse.parse(lx, names) {
        Ok(p) => p
        Err(d) => {
            report(d, a, src)
            env.exit(1)
            return
        }
    }
    if is(a.cmd, "check") {
        if !a.json { io.outln(sys.lit("ok")) }
    } else {
        usage()
    }
}

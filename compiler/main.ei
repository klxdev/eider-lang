// eiderc: the Eider compiler, written in Eider. See docs/compiler.md.
//
//   eiderc lex <file.ei>            dump tokens (one per line: line:col kind [value])
//   eiderc parse <file.ei>          dump the AST (indented S-expressions, see dump.ei)
//   eiderc check <file.ei> [--json] report the first error, or print `ok`
//   eiderc ir <file.ei>             dump the typed IR (ir.ei)
//   eiderc emit-c <file.ei> [--test] print the generated C (--test: with the test driver)
//   eiderc emit-header <file.ei>    print the C header for the `export fn`s
//   eiderc build <file.ei> [-o out]  compile to a native binary (-O2; driver.ei)
//   eiderc build --lib <file.ei> [-o name]  build lib<name>.a, lib<name>.so and <name>.h
//   eiderc run <file.ei> [--release] build and run (-O0 unless --release)
//   eiderc test <file.ei>           run the `test` blocks
// `--lib` checks (and emits) the file as a library: no `main`, at least one `export fn`.
// `-l <lib>` (repeatable) links a C library into build, run, test and build --lib.
// `--wasm` (stage 0: WebAssembly) answers `unsupported`.

import "deps/core/sys.ei"
import "deps/std/bytes.ei"
import "deps/std/fs.ei"
import "deps/std/io.ei"
import "deps/std/env.ei"
import "intern.ei"
import "lex.ei"
import "diag.ei"
import "parse.ei"
import "dump.ei"
import "resolve.ei"
import "check.ei"
import "ir.ei"
import "lower.ei"
import "driver.ei"
import "comptime.ei" as consteval

type Args = {
    cmd: List[u8], file: List[u8], json: bool, out: List[u8], release: bool, tests: bool,
    lib: bool, libs: List[List[u8]], wasm: bool,
}

/// Comparisons go through a function so no owned temporary sits in an `else if` condition
/// (the bootstrap drops such temporaries outside the block that declares them).
fn is(a: List[u8], s: str) -> bool uses ffi { bytes.eq(a, sys.lit(s)) }

fn usage() uses io, ffi {
    io.err(sys.lit("usage: eiderc (lex | parse | check | ir | emit-c | emit-header | build | run | test) <file.ei> [--json] [--test] [--release] [--lib] [-o out] [-l lib]\n"))
    env.exit(2)
}

fn parse_args() -> Args uses io, ffi {
    let argv = env.args()
    var cmd: List[u8] = List.new()
    var file: List[u8] = List.new()
    var json = false
    var out: List[u8] = List.new()
    var release = false
    var tests = false
    var lib = false
    var wasm = false
    var libs: List[List[u8]] = List.new()
    var i: usize = 1
    while i < argv.len() {
        let a = argv[i]
        i += 1
        if is(a, "--json") {
            json = true
        } else if is(a, "--release") {
            release = true
        } else if is(a, "--test") {
            tests = true
        } else if is(a, "--lib") {
            lib = true
        } else if is(a, "--wasm") {
            wasm = true
        } else if is(a, "-o") {
            if i >= argv.len() { usage() }
            out = argv[i]
            i += 1
        } else if is(a, "-l") {
            if i >= argv.len() { usage() }
            libs.push(argv[i])
            i += 1
        } else if cmd.len() == 0 {
            cmd = a
        } else if file.len() == 0 {
            file = a
        }
    }
    if cmd.len() == 0 || file.len() == 0 { usage() }
    if is(cmd, "emit-header") { lib = true }
    // `test` checks the test driver, never a library (stage 0's mode order)
    if is(cmd, "test") { lib = false }
    Args(cmd, file, json, out, release, tests, lib, libs, wasm)
}

/// Print `d` like the bootstrap: JSON on stdout, or the rendered form (against the source of
/// the file it is in) on stderr. Module prefixes in the text are shown as `module.Name`.
fn report(d: diag.Diag, a: Args, src: List[u8]) uses io, fs, ffi {
    var d2 = d
    d2.msg = diag.demangle(d.msg)
    d2.help = diag.demangle(d.help)
    let elsewhere = d2.file.len() > 0 && !bytes.eq(d2.file, a.file)
    if a.json {
        io.outln(diag.json(d2, a.file))
    } else if elsewhere {
        let other: List[u8] = match fs.read(d2.file) {
            Ok(t) => t
            Err(_) => List.new()
        }
        io.err(diag.render(d2, d2.file, other))
    } else {
        io.err(diag.render(d2, a.file, src))
    }
}

fn dump(lx: lex.Lexed, names: intern.Interner) uses io, ffi {
    var out: List[u8] = List.new()
    for t in lx.toks {
        bytes.append(inout out, bytes.from_u64(t.line as u64))
        out.push(58)
        bytes.append(inout out, bytes.from_u64(t.col as u64))
        out.push(45)
        bytes.append(inout out, bytes.from_u64(t.end_col as u64))
        out.push(32)
        bytes.append(inout out, sys.lit(lex.kind_text(t.kind)))
        match t.kind {
            lex.Ident => {
                out.push(32)
                bytes.append(inout out, intern.name(names, t.val as u32))
            }
            lex.Int => {
                out.push(32)
                bytes.append(inout out, bytes.from_u64(t.val))
                if t.big { bytes.append(inout out, sys.lit(" (big)")) }
            }
            lex.Str => {
                out.push(32)
                diag.debug_str(inout out, lx.strs[t.val as usize])
            }
            _ => {}
        }
        out.push(10)
    }
    io.out(out)
}

fn main() uses io, fs, net, clock, ffi {
    let a = parse_args()
    let src = match fs.read(a.file) {
        Ok(s) => s
        Err(e) => {
            var m = String.from("eiderc: ")
            m.append(e)
            print(m)
            env.exit(2)
            return
        }
    }
    var names = intern.new()
    let r = lex.lex(src, inout names)
    match resolve.lex_diag(r) {
        Some(d) => {
            report(d, a, src)
            env.exit(1)
        }
        None => {}
    }
    let lx = match r {
        lex.Done(l) => l
        _ => { return }
    }
    if is(a.cmd, "lex") {
        dump(lx, names)
        return
    }
    let p = match parse.parse(lx, names) {
        // not `Ok(p) => p`: the bootstrap shadows `p` and never assigns it (LEARNINGS.md)
        Ok(parsed) => parsed
        Err(d) => {
            report(d, a, src)
            env.exit(1)
            return
        }
    }
    if is(a.cmd, "parse") {
        io.out(dump.program(p))
        return
    }
    let backend = is(a.cmd, "emit-c") || is(a.cmd, "emit-header") || is(a.cmd, "build") || is(a.cmd, "run") || is(a.cmd, "test")
    if !is(a.cmd, "check") && !is(a.cmd, "ir") && !backend { usage() }
    if a.wasm {
        // WebAssembly (stage 0's --wasm, E0806) is C7 work still to do
        report(diag.new("unsupported", 1, 1, sys.lit("not yet supported by eiderc: WebAssembly (--wasm)")), a, src)
        env.exit(1)
    }
    let loaded = match resolve.load(a.file, src, p) {
        Ok(x) => x
        Err(d) => {
            report(d, a, src)
            env.exit(1)
            return
        }
    }
    // `comptime` constants are evaluated between loading and checking, as in stage 0
    let prog = match consteval.eval(loaded) {
        Ok(x) => x
        Err(d) => {
            report(d, a, src)
            env.exit(1)
            return
        }
    }
    let c = match check.check_mode(prog, a.lib) {
        Ok(x) => x
        Err(d) => {
            report(d, a, src)
            env.exit(1)
            return
        }
    }
    if backend {
        let tests = a.tests || is(a.cmd, "test")
        let lp = lower.P(c.ir, c.t, c.p.names)
        if is(a.cmd, "emit-header") {
            io.out(lower.header(lp))
            return
        }
        let cprog = match lower.program_for(lp, a.file, tests, a.lib) {
            Ok(text) => text
            Err(m) => {
                var msg = sys.lit("eiderc: internal error: ")
                bytes.append(inout msg, m)
                io.errln(msg)
                env.exit(3)
                return
            }
        }
        if is(a.cmd, "emit-c") {
            io.out(cprog)
        } else if a.lib {
            // stage 0: `build --lib` and `run --lib` both build the library
            driver.build_lib(cprog, lower.header(lp), a.file, a.out, a.libs)
        } else if is(a.cmd, "build") {
            driver.build(cprog, a.file, a.out, a.libs)
        } else {
            driver.run(cprog, a.file, a.release, a.libs)
        }
    } else if is(a.cmd, "ir") {
        io.out(ir.dump(c.ir, c.t, c.p.names))
    } else if !a.json {
        io.outln(sys.lit("ok"))
    }
}

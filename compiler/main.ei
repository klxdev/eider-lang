// eiderc: the Eider compiler, written in Eider. See docs/compiler.md.
//
// `eiderc --version` prints `eiderc <core/version.ei VERSION>` (docs/site/tooling/releases.md).
// `eiderc --help` (usage_text below) lists every command, option and environment
// variable; an unknown option or command, a missing source file or a stray argument is a
// usage error (exit 2). `lex` dumps tokens (one per line: line:col kind [value]), `parse`
// the AST (dump.ei), `ir` the typed IR (ir.ei); `build`, `run` and `test` go through
// driver.ei, `test --compile-fail` through suite.ei, `caps` through resolve.caps_json ("C8.5"),
// `migrate-imports` through resolve.import_fixes ("C8.26"), `migrate-var` through check.var_fixes ("C8.6": the file with every `var` it can rewrite as
// `let mut`, on stdout; the file must check, apart from having no `main`), `audit-refs`
// through check.check_audit (every write that changes what a `let` or pattern reference
// sees, which code written when `let` copied didn't mean; then the errors, if any).
// `--lib` checks (and emits) the file as a library: no `main`, at least one `export fn`.
// `-l <lib>` (repeatable) links a C library into build, run, test and build --lib.
// `--wasm` checks (and emits) the file as a WebAssembly module (a library whose exports take
// and return integers and bool, no threads: E0806): `check --wasm`, `emit-llvm --wasm`,
// `emit-header --wasm` (the .d.ts and the loader, \x01-separated, as tests/oracle records them) and
// `build --wasm` / `run --wasm` (<name>.wasm, <name>.d.ts, <name>.js; wasm.ei). `test`
// ignores it, as it ignores `--lib`. `build --wasm-core` builds a program (with `main`) as a
// WebAssembly module whose imports are the C core's ABI (env.ec_*; wasm.ei): the seed.

import core.sys
import core.version
import std.bytes
import std.fs
import std.io
import std.env
import eiderc.intern
import eiderc.lex
import eiderc.diag
import eiderc.parse
import eiderc.dump
import eiderc.resolve
import eiderc.check
import eiderc.ir
import eiderc.lower
import eiderc.driver
import eiderc.build
import eiderc.llvm_units
import eiderc.consteval
import eiderc.llvm
import eiderc.llvm_abi as abi
import eiderc.wasm
import eiderc.pkgtest
import eiderc.fmtcmd
import eiderc.expsrc
import eiderc.cover
import eiderc.watch
import eiderc.sanitize
import eiderc.suite
import eiderc.ide
import eiderc.front
import eiderc.doc
import eiderc.migrate
import eiderc.lint
import eiderc.lock

type Args = {
    cmd: List[u8], file: List[u8], json: bool, out: List[u8], release: bool, tests: bool,
    lib: bool, libs: List[List[u8]], wasm: bool, wasm_core: bool, compile_fail: bool, overlay: List[List[u8]],
    max_errors: u64, all_errors: bool, private: bool, profile: u32, pargs: List[List[u8]], jobs: u64,
    /// `-g`: debug info for the .ei sources (llvm.ei; docs/compiler.md, "Backends")
    debug: bool,
    /// `--crypto <backend>`: the crypto backend a program that imports core/crypto links (driver.crypto_libs)
    crypto: List[u8],
    /// `migrate-strings --portable` (migrate.ei)
    portable: bool,
    /// the word after the file: `expand`'s filter, `test`'s `--filter`
    filter: List[u8],
    /// `test --bench`, `test --fuzz N` (std/testing)
    bench: bool,
    fuzz: u64,
    /// `lint --deny|--warn|--allow <name>` (lint.ei), in order
    lints: List[lint.Setting],
    /// `lint --list`
    list: bool,
    /// `fmt --write`, `fmt --check` (fmtcmd.ei)
    write: bool,
    check: bool,
    /// `expand --ir`: the typed IR instead of source (expsrc.ei)
    ir_text: bool,
    /// `test --coverage`, `--lcov FILE` (cover.ei), and `--coverage-data FILE`, which a package run
    /// gives each file's run so that it writes its lines there instead of printing a report
    coverage: bool,
    lcov: List[u8],
    cov_data: List[u8],
    /// `run --watch`, `test --watch` (watch.ei); `build --no-opt`: compile at -O0 as `run` does
    watch: bool,
    no_opt: bool,
}

/// Comparisons go through a function so no owned temporary sits in an `else if` condition
/// (compiler/ avoids that pattern: such temporaries were once dropped too late, LEARNINGS.md).
fn is(a: List[u8], s: str) -> bool { bytes.eq(a, sys.lit(s)) }

/// `eiderc --version`: `eiderc <VERSION>` (core/version.ei; docs/site/tooling/releases.md).
fn version_line() -> List[u8] {
    let mut t = sys.lit("eiderc ")
    bytes.append(inout t, sys.lit(version.VERSION))
    t
}

/// `eiderc --help`: every command, option and environment variable.
fn usage_text() -> List[u8] {
    let mut t = version_line()
    bytes.append(inout t, sys.lit(" (the Eider compiler, written in Eider: Eider -> LLVM IR)"))
    t.push(10)
    for l in [
        "",
        "usage:",
        "  eiderc check <file.ei> [--json] [--lib] [--wasm]  type-check only: `ok` or the errors",
        "  eiderc emit-header <file.ei>               print the C header for the `export fn`s",
        "  eiderc build <file.ei> [-o out] [-l lib] [-g]  compile to a native binary (-O2) via clang ($EIDER_LLVM_CC) and $CC",
        "  eiderc build --lib <file.ei> [-o name]     build lib<name>.a, lib<name>.so and <name>.h from `export fn`s",
        "  eiderc build --wasm <file.ei> [-o name]    build <name>.wasm, <name>.d.ts and <name>.js (needs clang for wasm32 and wasm-ld)",
        "  eiderc build --wasm-core <file.ei> [-o out.wasm]  build the program as a WebAssembly module that imports",
        "                                             only the C core's ABI (env.ec_*; the seed: seed/README.md)",
        "  eiderc run|test <file.ei> --watch          run again (stopping the program first) whenever a file it loads changes",
        "  eiderc build --no-opt <file.ei>            compile at -O0 (what run and test do)",
        "  eiderc run <file.ei> [--release] [-l lib] [--] [args...]  build and run (-O0 unless --release);",
        "                                             the arguments after the file (every one after `--`) go to the program",
        "  eiderc build|run|test <file.ei> --crypto <backend>  the crypto backend a program importing core/crypto links",
        "                                             (else $EIDER_CRYPTO, [crypto] provider in eider.toml, awslc; built when missing)",
        "  eiderc build|run|test <file.ei> --profile[=cpu,mem,conc]  with the profiler (docs/runtime.md \"Profiler\")",
        "  eiderc test <file.ei> [-l lib]             run the `test` blocks (a module with no `main` too)",
        "  eiderc test [<file.ei>] --coverage [--lcov FILE]  also report which lines of the package's modules the tests ran",
        "  eiderc test                                run the tests of every module of the package in this directory",
        "  eiderc build|run|test ... -j N             compile at most N units at once (default $EIDER_JOBS, else one per CPU)",
        "  eiderc cache size|clean|trim               the cache's use; remove every entry; apply EIDER_CACHE_MAX now",
        "  eiderc test --compile-fail [<dir>]         run the compile-fail suite (<dir>/fail, <dir>/pass; default tests/checks)",
        "  eiderc lex <file.ei>                       dump the tokens",
        "  eiderc parse <file.ei> [--all-errors]      dump the AST (--all-errors: every syntax error as JSON lines,",
        "                                             then the AST with its error nodes)",
        "  eiderc ir <file.ei>                        dump the typed IR",
        "  eiderc emit-llvm <file.ei> [--test] [--lib] [--wasm]  print the LLVM IR (--test: with the test driver)",
        "  eiderc lint [<file.ei>] [--json] [--deny|--warn|--allow <lint|group|all>]...  the lints (lint.ei) of a package's",
        "                                             modules; no file: the package here; `--list` lists them; levels also come from",
        "                                             [lints] in eider.toml; exit 1 if a denied lint is hit",
        "  eiderc expand <file.ei> [<name>] [--ir]    the specialized bodies that use comptime reflection (for example `@[derive]`d",
        "                                             methods) as Eider source, with the call that asked for each (--ir: as typed IR);",
        "                                             <name>: every function whose name contains it",
        "  eiderc caps <file.ei>                      each package's capability use, one JSON line per capability",
        "  eiderc migrate-var <file.ei>               print the file with its `var`s rewritten as `let mut` (deprecated `var`)",
        "  eiderc migrate-imports <file.ei> [--json]  print the file with its quoted imports in the dotted form",
        "                                             (--json: the fixes, one JSON line each)",
        "  eiderc migrate-strings <file> [--json] [--portable]  print the file (.ei, or a .md's eider blocks) with",
        "                                             each literal with braces meaning what it meant before",
        "                                             literals interpolated: a raw string, or braces doubled",
        "                                             (--portable: written as escapes)",
        "  eiderc migrate-attrs <file> [--json]       print the file (.ei, or a .md's eider blocks) with each bare `@name(...)`",
        "                                             attribute written `@[name(...)]` (the only form)",
        "  eiderc audit-refs <file.ei> [--json]       every write that changes what a `let` reference sees (it was a copy",
        "                                             before C8.6), with the `.copy()` that keeps the old meaning",
        "  eiderc ide <file.ei> [--overlay <path> <text>]  print the IDE analysis (ide.ei): symbols, refs, types;",
        "                                             --overlay (repeatable) reads <path> from the file <text>",
        "  eiderc doc <file.ei | dir> [--json] [--private]  the API of a package directory or a program's package:",
        "                                             items, signatures, doc comments (doc.ei); --private: also non-pub items",
        "  eiderc fmt <file.ei>                       print the file in the canonical layout (fmt.ei)",
        "  eiderc fmt --write|--check <file|dir>      rewrite the files in place / list the files whose layout would change",
        "  eiderc help | --help | -h                  print this text",
        "  eiderc version | --version                 print `eiderc <version>` (VERSION; docs/site/tooling/releases.md)",
        "",
        "build, run and test emit LLVM IR (llvm.ei) and build it with",
        "clang 17 or newer ($EIDER_LLVM_CC), one unit per module and generic instances in 16 shards, each",
        "cached (EIDER_LLVM_UNITS=0: one unit); a release build uses ThinLTO when clang links with lld",
        "(EIDER_LLVM_LTO=0: plain objects); -g adds DWARF line info for the .ei sources (one unit).",
        "--sanitize[=address,undefined|thread] and --race (thread) build with that sanitizer (sanitize.ei);",
        "debug/eider_gdb.py and debug/eider_lldb.py print String, List, Map and enums in gdb and lldb.",
        "",
        "errors: every independent error is reported, in the order found, then `error: N errors`",
        "(stderr); with --json one JSON object per line (stdout). --max-errors N shows at most N",
        "(default 100, 0: all; a final note says when some were left out).",
        "",
        "environment:",
        "  CC            the C compiler (default cc)",
        "  EIDER_LLVM_CC the clang that builds the LLVM IR (default clang; LLVM 17 or newer)",
        "  WASM_CC       the C compiler of `build --wasm` (default clang; it needs the wasm32 target, and wasm-ld)",
        "  EIDER_CFLAGS  extra C compiler flags, split at spaces",
        "  EIDER_CACHE   `off`, or the cache directory (default $XDG_CACHE_HOME/eider, else ~/.cache/eider)",
        "  EIDER_CACHE_MAX  the cache's size limit (bytes, or with K, M or G; default 5G; 0: none)",
        "  EIDER_JOBS    parallel compile jobs when there is no -j (default: one per CPU)",
        "  EIDER_ROOT    the toolchain, the directory holding core/ (default: found above the eiderc binary)",
        "  EIDER_PROF    a --profile program's profile file (default eider.prof; `off`: none)",
    ] {
        bytes.append(inout t, sys.lit(l))
        t.push(10)
    }
    t
}

/// A usage error: the message and a pointer to --help on stderr, exit 2.
fn usage_error(msg: List[u8]) uses io {
    let mut m = sys.lit("eiderc: ")
    bytes.append(inout m, msg)
    io.errln(m)
    io.errln(sys.lit("run `eiderc --help` for the commands and options"))
    env.exit(2)
}

/// No command at all: the usage text on stderr, exit 2 (as tests/oracle records).
fn usage() uses io {
    io.err(usage_text())
    env.exit(2)
}

fn quoted(pre: str, a: List[u8]) -> List[u8] {
    let mut m = sys.lit(pre)
    m.push(96)
    bytes.append(inout m, a)
    m.push(96)
    m
}

fn known_cmd(c: List[u8]) -> bool {
    is(c, "lex") || is(c, "parse") || is(c, "check") || is(c, "ir") || is(c, "emit-header") || is(c, "build") || is(c, "run") || is(c, "test") || is(c, "ide") || is(c, "caps") || is(c, "migrate-var") || is(c, "migrate-imports") || is(c, "migrate-strings") || is(c, "migrate-attrs") || is(c, "audit-refs") || is(c, "doc") || is(c, "fmt") || is(c, "emit-llvm") || is(c, "cache") || is(c, "lint") || is(c, "expand")
}

/// The entry module of the package in the current directory (`eiderc lint` with no file).
fn package_entry() -> List[u8] uses io, fs {
    let none: List[u8] = List.new()
    let text = match fs.read(sys.lit("eider.toml")) {
        Ok(t) => t
        Err(_) => {
            usage_error(sys.lit("`lint` with no file lints the package in this directory: there is no eider.toml here"))
            return none
        }
    }
    match lock.manifest(text) {
        Ok(m) => m.entry
        Err(e) => {
            usage_error(bytes.concat(sys.lit("eider.toml: "), e))
            none
        }
    }
}

fn parse_args() -> Args uses io, fs {
    let argv = env.args()
    let mut cmd: List[u8] = List.new()
    let mut file: List[u8] = List.new()
    let mut json = false
    let mut out: List[u8] = List.new()
    let mut release = false
    let mut tests = false
    let mut lib = false
    let mut wasm = false
    let mut wasm_core = false
    let mut compile_fail = false
    let mut libs: List[List[u8]] = List.new()
    let mut overlay: List[List[u8]] = List.new()
    let mut max_errors = diag.MAX_ERRORS
    let mut all_errors = false
    let mut portable = false
    let mut private = false
    let mut profile: u32 = 0
    let mut debug = false
    let mut pargs: List[List[u8]] = List.new()
    let mut jobs: u64 = 0
    let mut crypto: List[u8] = List.new()
    let mut lints: List[lint.Setting] = List.new()
    let mut list = false
    let mut write = false
    let mut check = false
    let mut ir_text = false
    let mut coverage = false
    let mut watch = false
    let mut no_opt = false
    let mut lcov: List[u8] = List.new()
    let mut cov_data: List[u8] = List.new()
    let mut bench = false
    let mut fuzz: u64 = 0
    let mut filter: List[u8] = List.new()
    let mut dashes = false
    let mut i: usize = 1
    while i < argv.len() {
        let a = argv[i]
        i += 1
        if dashes {
            // after `--`: the program's arguments, whatever they look like
            pargs.push(a)
        } else if is(a, "--") {
            dashes = true
        } else if is(a, "--help") || is(a, "-h") {
            io.out(usage_text())
            env.exit(0)
        } else if is(a, "--version") {
            io.outln(version_line())
            env.exit(0)
        } else if is(a, "--json") {
            json = true
        } else if is(a, "--release") {
            release = true
        } else if is(a, "--test") {
            tests = true
        } else if is(a, "--lib") {
            lib = true
        } else if is(a, "--wasm") {
            wasm = true
        } else if is(a, "--wasm-core") {
            wasm_core = true
        } else if is(a, "--compile-fail") {
            compile_fail = true
        } else if is(a, "-o") {
            if i >= argv.len() { usage_error(sys.lit("`-o` needs a file name")) }
            out = argv[i]
            i += 1
        } else if is(a, "--overlay") {
            if i + 1 >= argv.len() { usage_error(sys.lit("`--overlay` needs a path and a file with its text")) }
            overlay.push(argv[i])
            overlay.push(argv[i + 1])
            i += 2
        } else if is(a, "-l") {
            if i >= argv.len() { usage_error(sys.lit("`-l` needs a library name")) }
            libs.push(argv[i])
            i += 1
        } else if is(a, "-j") {
            if i >= argv.len() { usage_error(sys.lit("`-j` needs a number of jobs")) }
            match bytes.parse_u64(argv[i]) {
                Some(nj) => {
                    if nj == 0 { usage_error(sys.lit("`-j` needs a number of jobs above 0")) }
                    jobs = nj
                }
                None => usage_error(quoted("`-j` needs a number of jobs, not ", argv[i]))
            }
            i += 1
        } else if is(a, "--crypto") {
            if i >= argv.len() { usage_error(sys.lit("`--crypto` needs a backend name")) }
            crypto = argv[i]
            i += 1
        } else if is(a, "-g") {
            debug = true
        } else if is(a, "--deny") || is(a, "--warn") || is(a, "--allow") {
            if i >= argv.len() { usage_error(quoted("needs a lint, a lint group or `all`: ", a)) }
            if !lint.known(argv[i]) { usage_error(quoted("no lint or group named ", argv[i])) }
            let lv = if is(a, "--deny") { lint.DENY } else if is(a, "--warn") { lint.WARN } else { lint.ALLOW }
            lints.push(lint.Setting(argv[i], lv))
            i += 1
        } else if is(a, "--list") {
            list = true
        } else if is(a, "--write") {
            write = true
        } else if is(a, "--check") {
            check = true
        } else if is(a, "--ir") {
            ir_text = true
        } else if is(a, "--watch") {
            watch = true
        } else if is(a, "--no-opt") {
            no_opt = true
        } else if is(a, "--coverage") {
            coverage = true
        } else if is(a, "--lcov") {
            if i >= argv.len() { usage_error(sys.lit("`--lcov` needs a file name")) }
            lcov = argv[i]
            coverage = true
            i += 1
        } else if is(a, "--coverage-data") {
            if i >= argv.len() { usage_error(sys.lit("`--coverage-data` needs a file name")) }
            cov_data = argv[i]
            coverage = true
            i += 1
        } else if is(a, "--bench") {
            bench = true
        } else if is(a, "--fuzz") {
            if i >= argv.len() { usage_error(sys.lit("`--fuzz` needs a number of cases")) }
            match bytes.parse_u64(argv[i]) {
                Some(nf) => { fuzz = nf }
                None => usage_error(quoted("`--fuzz` needs a number of cases, not ", argv[i]))
            }
            i += 1
        } else if is(a, "--filter") {
            if i >= argv.len() { usage_error(sys.lit("`--filter` needs a name")) }
            filter = argv[i]
            i += 1
        } else if is(a, "--private") {
            private = true
        } else if is(a, "--all-errors") {
            all_errors = true
        } else if is(a, "--portable") {
            portable = true
        } else if is(a, "--max-errors") {
            if i >= argv.len() { usage_error(sys.lit("`--max-errors` needs a number")) }
            match bytes.parse_u64(argv[i]) {
                Some(nmax) => { max_errors = nmax }
                None => usage_error(quoted("`--max-errors` needs a number, not ", argv[i]))
            }
            i += 1
        } else if bytes.starts_with(a, sys.lit("--profile")) {
            profile = lower.prof_what(a)
            if profile == 0 { usage_error(quoted("`--profile=` takes cpu, mem and conc, not ", a)) }
        } else if a.len() > 1 && a[0] == 45 {
            usage_error(quoted("unknown option ", a))
        } else if cmd.len() == 0 {
            cmd = a
        } else if file.len() == 0 {
            file = a
        } else if is(cmd, "run") {
            pargs.push(a)
        } else if is(cmd, "expand") && filter.len() == 0 {
            filter = a
        } else {
            usage_error(quoted("unexpected argument ", a))
        }
    }
    if cmd.len() == 0 { usage() }
    if is(cmd, "help") {
        io.out(usage_text())
        env.exit(0)
    }
    if is(cmd, "version") {
        io.outln(version_line())
        env.exit(0)
    }
    if !known_cmd(cmd) { usage_error(quoted("unknown command ", cmd)) }
    if compile_fail {
        if !is(cmd, "test") { usage_error(sys.lit("`--compile-fail` goes with `test`")) }
        // the default suite
        if file.len() == 0 { file = sys.lit("tests/checks") }
    }
    if is(cmd, "cache") && file.len() == 0 { usage_error(sys.lit("`cache` needs clean, size or trim")) }
    // (`test` with no file runs the tests of the package in the current directory: pkgtest.ei)
    if file.len() == 0 && is(cmd, "lint") && !list {
        // the package in this directory: its entry module
        file = package_entry()
    }
    if file.len() == 0 && !is(cmd, "test") && !(is(cmd, "lint") && list) { usage_error(quoted("missing the source file for ", cmd)) }
    if (dashes || pargs.len() > 0) && !is(cmd, "run") { usage_error(sys.lit("program arguments (and `--`) go with `run`")) }
    if is(cmd, "emit-header") { lib = true }
    // `test` checks the test driver, never a library (the recorded mode order)
    if is(cmd, "test") {
        lib = false
        wasm = false
    }
    if wasm_core && !(is(cmd, "build") || is(cmd, "emit-llvm") || is(cmd, "check")) { usage_error(sys.lit("`--wasm-core` goes with build, check or emit-llvm")) }
    if wasm_core && (wasm || lib) { usage_error(sys.lit("`--wasm-core` builds a program: not with --wasm or --lib")) }
    if wasm { lib = true }
    if profile > 0 && (lib || wasm_core || !(is(cmd, "build") || is(cmd, "run") || is(cmd, "test") || is(cmd, "emit-llvm"))) { usage_error(sys.lit("`--profile` goes with build, run, test or emit-llvm, without --lib or --wasm")) }
    if (bench || fuzz > 0) && !is(cmd, "test") { usage_error(sys.lit("`--bench` and `--fuzz` go with `test`")) }
    if filter.len() > 0 && !(is(cmd, "test") || is(cmd, "expand")) { usage_error(sys.lit("`--filter` goes with `test`")) }
    if (lints.len() > 0 || list) && !is(cmd, "lint") { usage_error(sys.lit("`--deny`, `--warn`, `--allow` and `--list` go with `lint`")) }
    if (write || check) && !is(cmd, "fmt") { usage_error(sys.lit("`--write` and `--check` go with `fmt`")) }
    if ir_text && !is(cmd, "expand") { usage_error(sys.lit("`--ir` goes with `expand`")) }
    if watch && !(is(cmd, "run") || is(cmd, "test")) { usage_error(sys.lit("`--watch` goes with `run` and `test`")) }
    if watch && (compile_fail || lib || wasm || wasm_core) { usage_error(sys.lit("`--watch` runs programs and tests: not with --compile-fail, --lib or --wasm")) }
    if no_opt && !is(cmd, "build") { usage_error(sys.lit("`--no-opt` goes with `build`")) }
    if coverage && !is(cmd, "test") { usage_error(sys.lit("`--coverage`, `--lcov` and `--coverage-data` go with `test`")) }
    if coverage && compile_fail { usage_error(sys.lit("`--coverage` measures `test` blocks, not a compile-fail suite")) }
    if coverage && (profile > 0) { usage_error(sys.lit("`--coverage` and `--profile` don't go together")) }
    Args(cmd, file, json, out, release, tests, lib, libs, wasm, wasm_core, compile_fail, overlay, max_errors, all_errors, private, profile, pargs, jobs, debug, crypto, portable, filter, bench, fuzz, lints, list, write, check, ir_text, coverage, lcov, cov_data, watch, no_opt)
}

/// Print `d` as tests/oracle records: JSON on stdout, or the rendered form (against the source of
/// the file it is in) on stderr. Module prefixes in the text are shown as `module.Name`.
fn report(d: diag.Diag, a: Args, src: List[u8]) uses io, fs {
    let mut d2 = d.copy()
    d2.msg = diag.demangle(d.msg)
    d2.help = diag.demangle(d.help)
    let elsewhere = d2.file.len() > 0 && !bytes.eq(d2.file, a.file)
    if a.json {
        io.outln(diag.json(d2, a.file))
    } else if elsewhere {
        let other: List[u8] = match fs.read(d2.file) {
            Ok(t) => t
            Err(_) => List.new()
        }
        io.err(diag.render(d2, d2.file, other))
    } else {
        io.err(diag.render(d2, a.file, src))
    }
}

fn one(d: diag.Diag) -> List[diag.Diag] {
    let mut out: List[diag.Diag] = List.new()
    out.push(d)
    out
}

/// Report every diagnostic of the run (each once, at most `--max-errors`), then the summary
/// (human output) and, if some were left out, the note saying so; exit 1.
fn fail(ds: List[diag.Diag], a: Args, src: List[u8]) uses io, fs {
    let all = diag.dedup(ds)
    let total = all.len() as u64
    let mut shown = total.copy()
    if a.max_errors > 0 && total > a.max_errors { shown = a.max_errors }
    for i in 0..shown { report(all[i as usize], a, src) }
    if !a.json { io.errln(diag.summary(total)) }
    if shown < total {
        if a.json {
            io.outln(diag.capped_json(shown, total))
        } else {
            let mut m = sys.lit("note: ")
            bytes.append(inout m, diag.capped_note(shown, total))
            io.errln(m)
        }
    }
    env.exit(1)
}

fn dump(lx: lex.Lexed, names: intern.Interner) uses io {
    let mut out: List[u8] = List.new()
    for t in lx.toks {
        bytes.append(inout out, bytes.from_u64(t.line as u64))
        out.push(58)
        bytes.append(inout out, bytes.from_u64(t.col as u64))
        out.push(45)
        bytes.append(inout out, bytes.from_u64(t.end_col as u64))
        out.push(32)
        bytes.append(inout out, sys.lit(lex.kind_text(t.kind)))
        match t.kind {
            lex.Ident => {
                out.push(32)
                bytes.append(inout out, intern.name(names, t.val as u32))
            }
            lex.Int => {
                out.push(32)
                bytes.append(inout out, bytes.from_u64(t.val))
                if t.big { bytes.append(inout out, sys.lit(" (big)")) }
            }
            lex.Float => {
                out.push(32)
                for i in t.start..t.end { out.push(lx.src[i as usize]) }
            }
            lex.Str => {
                out.push(32)
                diag.debug_str(inout out, lx.strs[t.val as usize])
            }
            lex.FText => {
                out.push(32)
                diag.debug_str(inout out, lx.strs[t.val as usize])
            }
            lex.FClose => {
                out.push(32)
                diag.debug_str(inout out, lx.strs[t.val as usize])
            }
            _ => {}
        }
        out.push(10)
    }
    io.out(out)
}

/// `eiderc ide`: the analysis of the file (with the overlays read from their text files).
fn run_ide(a: Args) uses io, fs {
    let mut paths: List[List[u8]] = List.new()
    let mut texts: List[List[u8]] = List.new()
    let mut k: usize = 0
    while k + 1 < a.overlay.len() {
        paths.push(a.overlay[k])
        let t: List[u8] = match fs.read(a.overlay[k + 1]) {
            Ok(x) => x
            Err(_) => {
                usage_error(quoted("cannot read the overlay text ", a.overlay[k + 1]))
                List.new()
            }
        }
        texts.push(t)
        k += 2
    }
    io.out(ide.dump(ide.analyze(a.file, paths, texts)))
}

/// `eiderc doc` (doc.ei): the API as JSON or text on stdout; problems in the documented
/// modules (a syntax error, an import that can't be found) as warnings on stderr. Exit 2
/// when the target can't be read or loaded.
fn run_doc(a: Args) uses io, fs {
    match doc.api(a.file, a.private) {
        Ok(api) => {
            for d in api.warnings {
                let mut m = sys.lit("eiderc doc: warning: ")
                bytes.append(inout m, d.file)
                m.push(58)
                bytes.append(inout m, bytes.from_u64(d.line as u64))
                m.push(58)
                bytes.append(inout m, bytes.from_u64(d.col as u64))
                bytes.append(inout m, sys.lit(": "))
                bytes.append(inout m, sys.lit(d.code))
                m.push(32)
                bytes.append(inout m, diag.demangle(d.msg))
                io.errln(m)
            }
            if a.json { io.out(doc.json(api)) } else { io.out(doc.text(api)) }
        }
        Err(m) => {
            let mut msg = sys.lit("eiderc doc: ")
            bytes.append(inout msg, m)
            io.errln(msg)
            env.exit(2)
        }
    }
}

/// `eiderc migrate-var` (docs/compiler.md, "C8.6"): the file with every `var` the checker
/// can rewrite as `let mut`. The file is checked as the entry (a module without `main` is
/// fine), else, when that fails (a module whose own names clash with the entry's builtins,
/// like a `fn print`), as the module a one-line entry next to it imports.
fn migrate_var(a: Args, src: List[u8]) uses io, fs {
    let first = migration(a.file, src, a.file)
    if first.ok {
        emit_migrated(src, first.fixes)
        return
    }
    let mut dir = sys.lit(".")
    let mut base = a.file.copy()
    match bytes.rfind_byte(a.file, 47) {
        Some(i) => {
            dir = bytes.slice(a.file, 0, i + 1)
            base = bytes.slice(a.file, i + 1, a.file.len())
        }
        None => {}
    }
    // (in the file's directory made absolute, so the entry is in the file's package)
    let mut entry = canon(dir)
    entry.push(47)
    bytes.append(inout entry, sys.lit("__migrate_var__.ei"))
    let mut esrc = sys.lit("import \"")
    bytes.append(inout esrc, base)
    bytes.append(inout esrc, sys.lit("\"\nfn main() \x7b\x7d\n"))
    let second = migration(entry, esrc, a.file)
    if second.ok {
        emit_migrated(src, second.fixes)
        return
    }
    fail(first.diags, a, src)
}

/// `eiderc audit-refs`: one finding per line (`--json`: a JSON object per line, with "audit"
/// in place of "error"; else rendered as notes), then (human output) how many there are.
fn audit_report(hits: List[diag.Diag], a: Args, src: List[u8]) uses io, fs {
    for d in hits {
        if a.json {
            let j = diag.json(d, a.file)
            // {"error":"audit", ... -> {"audit":"reference", ...
            let mut out = sys.lit("\x7b\"audit\":\"reference\"")
            bytes.append(inout out, bytes.slice(j, 16, j.len()))
            io.outln(out)
        } else {
            // rendered like a diagnostic, as a note: `note[audit]: ...`
            let mut d2 = d.copy()
            d2.msg = diag.demangle(d.msg)
            let elsewhere = d2.file.len() > 0 && !bytes.eq(d2.file, a.file)
            let mut text: List[u8] = List.new()
            if elsewhere {
                let other: List[u8] = match fs.read(d2.file) {
                    Ok(t) => t
                    Err(_) => List.new()
                }
                text = diag.render(d2, d2.file, other)
            } else {
                text = diag.render(d2, a.file, src)
            }
            let mut out = sys.lit("note")
            bytes.append(inout out, bytes.slice(text, 5, text.len()))
            io.err(out)
        }
    }
    if !a.json {
        let mut m = sys.lit("audit-refs: ")
        bytes.append(inout m, bytes.from_u64(hits.len() as u64))
        bytes.append(inout m, sys.lit(" write(s) change what a reference sees"))
        io.errln(m)
    }
}

fn emit_migrated(src: List[u8], fixes: List[diag.Fix]) uses io {
    let mut out = src.copy()
    for f in fixes { out = diag.apply_fix(out, f) }
    io.out(out)
}

/// What checking the program of `entry` (source `esrc`) gives for the module of file
/// `target`: its `var` rewrites, or the diagnostics (a missing `main` aside).
type Migration = { ok: bool, fixes: List[diag.Fix], diags: List[diag.Diag] }

fn migration(entry: List[u8], esrc: List[u8], target: List[u8]) -> Migration uses io, fs {
    let mut names = intern.new()
    let lx = lex.lex_all(esrc, inout names)
    let pr = parse.parse_all(lx.lexed, names)
    let mut diags = front.merge(lx.diags, pr.diags)
    let mut ld = resolve.load_from(entry, esrc, pr.p, resolve.disk())
    resolve.note_syntax(inout ld.p, 0, diags)
    for d in ld.diags { diags.push(d) }
    let none: List[diag.Fix] = List.new()
    if ld.fatal { return Migration(false, none, diags) }
    let ev = consteval.eval_all(ld.p)
    for d in ev.diags { diags.push(d) }
    let k = check.check_all(ev.p, false, false)
    for d in k.diags { diags.push(d) }
    let mut real: List[diag.Diag] = List.new()
    for d in diags {
        if !(bytes.eq(sys.lit(d.code), sys.lit("E0112")) && d.line == 1 && d.col == 1) { real.push(d) }
    }
    if real.len() > 0 { return Migration(false, none, real) }
    let want = canon(target)
    for m in 0..k.c.p.mods.len() {
        if bytes.eq(canon(k.c.p.mods[m].path), want) { return Migration(true, check.var_fixes(k.c, m as u32), real) }
    }
    Migration(false, none, real)
}

fn canon(path: List[u8]) -> List[u8] uses fs {
    match fs.canonical(path) {
        Ok(x) => x
        Err(_) => path
    }
}

/// The settings `eiderc test` starts the test program with: `--filter NAME` (only the tests whose
/// name contains it run; the runtime's ei_test), `--bench` (std/testing's `bench` measures) and
/// `--fuzz N` (std/testing's `fuzz` runs N cases).
fn test_env(a: Args) -> List[List[u8]] {
    let mut out: List[List[u8]] = List.new()
    if !is(a.cmd, "test") { return out }
    if a.filter.len() > 0 { out.push(bytes.concat(sys.lit("EIDER_TEST_FILTER="), a.filter)) }
    if a.bench { out.push(sys.lit("EIDER_TEST_BENCH=1")) }
    if a.fuzz > 0 { out.push(bytes.concat(sys.lit("EIDER_TEST_FUZZ="), bytes.from_u64(a.fuzz))) }
    out
}

/// The test options `eiderc test` with no file passes on to each file's run.
fn test_flags(a: Args) -> List[List[u8]] {
    let mut out: List[List[u8]] = List.new()
    if a.filter.len() > 0 {
        out.push(sys.lit("--filter"))
        out.push(a.filter)
    }
    if a.bench { out.push(sys.lit("--bench")) }
    if a.fuzz > 0 {
        out.push(sys.lit("--fuzz"))
        out.push(bytes.from_u64(a.fuzz))
    }
    out
}

/// After a `test --coverage` run: its lines go to `--coverage-data` (a package run merges
/// them), else the report is printed and `--lcov` written (cover.ei, docs/compiler.md "C8.77").
fn finish_coverage(a: Args, plan: cover.Plan, counts: List[u8]) uses io, fs {
    let d = cover.data(plan, counts)
    if a.cov_data.len() > 0 {
        match fs.write(a.cov_data, d) {
            Ok(_) => {}
            Err(e) => io.errln(bytes.concat(sys.lit("eiderc: coverage: "), e.bytes()))
        }
        return
    }
    let mut texts: List[List[u8]] = List.new()
    texts.push(d)
    cover.output(texts, a.lcov)
}

/// `eiderc expand <file> [<name>]` (docs/compiler.md, "C8.57"): the specialized IR of the
/// instances whose body used comptime reflection (what a `@[derive]`d method or a generic
/// reflective function became for each type), or of every function whose name contains
/// `<name>`.
fn run_expand(c: check.C, a: Args) uses io {
    let mut want: List[u32] = List.new()
    let mut notes: List[List[u8]] = List.new()
    if a.filter.len() == 0 {
        for r in c.lint.reflective {
            want.push(r.f)
            notes.push(r.req.copy())
        }
    } else {
        for i in 0..c.ir.fns.len() {
            if bytes.find(c.ir.fns[i].name, a.filter, 0).is_some() {
                want.push(i as u32)
                let mut req: List[u8] = List.new()
                for r in c.lint.reflective {
                    if r.f == i as u32 { req = r.req.copy() }
                }
                notes.push(req)
            }
        }
    }
    if want.len() == 0 {
        io.errln(sys.lit("eiderc: nothing to expand: no function uses comptime reflection, or none is named like that"))
        env.exit(1)
        return
    }
    if a.ir_text {
        io.out(ir.dump_fns(c.ir, c.t, c.p.names, want))
    } else {
        io.out(expsrc.dump(c.ir, c.t, c.p.names, want, notes))
    }
}

/// `eiderc lint` (lint.ei): the findings for the modules of the entry file's package, in
/// module order, human form on stderr or JSON lines on stdout; exit 1 if a denied lint hit.
fn run_lint(c: check.C, a: Args) uses io {
    let mut errs: List[List[u8]] = List.new()
    let pkg = c.p.mods[0].pkg
    let fs2 = lint.findings(c.p, c.lint, pkg, a.lints, inout errs)
    if errs.len() > 0 {
        for e in errs {
            io.errln(bytes.concat(sys.lit("eiderc: "), e))
        }
        env.exit(2)
        return
    }
    let mut denied: u64 = 0
    let mut warned: u64 = 0
    for f in fs2 {
        if f.level == lint.DENY { denied += 1 } else { warned += 1 }
        let mut g = f.copy()
        g.d.msg = diag.demangle(f.d.msg)
        g.d.help = diag.demangle(f.d.help)
        if a.json {
            io.outln(lint.json(g))
        } else {
            io.err(lint.render(g))
        }
    }
    if !a.json {
        let mut m = bytes.from_u64(denied)
        bytes.append(inout m, sys.lit(" denied, "))
        bytes.append(inout m, bytes.from_u64(warned))
        bytes.append(inout m, sys.lit(" warnings"))
        io.errln(m)
    }
    if denied > 0 { env.exit(1) }
}

/// `eiderc cache size|clean|trim` (build.ei): the cache's use per kind of entry; remove
/// every entry; apply the size limit ($EIDER_CACHE_MAX) now.
fn run_cache(a: Args) uses io, fs, clock {
    let c = driver.cache_dir()
    if c.len() == 0 {
        io.errln(sys.lit("eiderc: the cache is off (EIDER_CACHE=off)"))
        env.exit(2)
    }
    if is(a.file, "size") {
        io.out(build.size_report(c))
        return
    }
    let mut t = build.Trimmed(0, 0, 0)
    if is(a.file, "clean") {
        t = build.clean(c)
    } else if is(a.file, "trim") {
        match build.max_size() {
            Some(m) => { t = build.trim(c, m) }
            None => usage_error(sys.lit("EIDER_CACHE_MAX is not a size (bytes, or with K, M or G)"))
        }
    } else {
        usage_error(quoted("`cache` takes clean, size or trim, not ", a.file))
    }
    let mut m = sys.lit("removed ")
    bytes.append(inout m, bytes.from_u64(t.files))
    bytes.append(inout m, sys.lit(" files ("))
    bytes.append(inout m, build.human(t.bytes))
    bytes.append(inout m, sys.lit("); "))
    bytes.append(inout m, build.human(t.left))
    bytes.append(inout m, sys.lit(" left in "))
    bytes.append(inout m, c)
    io.outln(m)
}

/// `run --watch` and `test --watch` (watch.ei): the options that matter to the build or the tests are
/// passed on to the commands the watch starts.
fn run_watch(a: Args) -> i32 uses io, fs, net, clock {
    let me = env.args()[0]
    let mut fl: List[List[u8]] = List.new()
    for l in a.libs {
        fl.push(sys.lit("-l"))
        fl.push(l.copy())
    }
    if a.crypto.len() > 0 {
        fl.push(sys.lit("--crypto"))
        fl.push(a.crypto.copy())
    }
    if a.jobs > 0 {
        fl.push(sys.lit("-j"))
        fl.push(bytes.from_u64(a.jobs))
    }
    if is(a.cmd, "run") {
        if a.debug { fl.push(sys.lit("-g")) }
        return watch.run_program(me, a.file, a.release, fl, a.pargs)
    }
    let mut args: List[List[u8]] = List.new()
    for x in fl { args.push(x) }
    if a.release { args.push(sys.lit("--release")) }
    for x in test_flags(a) { args.push(x) }
    if a.coverage { args.push(sys.lit("--coverage")) }
    if a.lcov.len() > 0 {
        args.push(sys.lit("--lcov"))
        args.push(a.lcov.copy())
    }
    if a.file.len() > 0 { args.push(a.file.copy()) }
    watch.run_tests(me, a.file, args)
}

fn main() uses io, fs, net, clock {
    sanitize.run_if_asked()
    let a = parse_args()
    if a.watch { env.exit(run_watch(a)) }
    if a.compile_fail { env.exit(suite.run(a.file)) }
    if is(a.cmd, "test") && a.file.len() == 0 {
        env.exit(pkgtest.run(env.args()[0], test_flags(a), a.coverage, a.lcov))
        return
    }
    if is(a.cmd, "cache") {
        run_cache(a)
        return
    }
    if is(a.cmd, "ide") {
        run_ide(a)
        return
    }
    if is(a.cmd, "doc") {
        run_doc(a)
        return
    }
    if is(a.cmd, "lint") && a.list {
        io.out(lint.list())
        return
    }
    if is(a.cmd, "fmt") {
        // docs/site/tooling/compiler.md, "Formatting"
        env.exit(fmtcmd.run(a.file, a.write, a.check))
        return
    }
    let src = match fs.read(a.file) {
        Ok(s) => s
        Err(e) => {
            let mut m = String.from("eiderc: ")
            m.append(e)
            print(m)
            env.exit(2)
            return
        }
    }
    if is(a.cmd, "migrate-var") {
        migrate_var(a, src)
        return
    }
    if is(a.cmd, "migrate-strings") {
        // docs/compiler.md, "C8.28: string literals"
        io.out(migrate.run(a.file, src, a.json, a.portable))
        return
    }
    if is(a.cmd, "migrate-attrs") {
        // docs/compiler.md, "C8.60: grouped attributes"
        io.out(migrate.run_attrs(a.file, src, a.json))
        return
    }
    if is(a.cmd, "migrate-imports") {
        // docs/compiler.md, "C8.26: dotted imports"
        io.out(resolve.migrate_imports(a.file, src, a.json))
        return
    }
    if is(a.cmd, "parse") && a.all_errors {
        // every syntax error as JSON lines, then the tree with its error nodes
        io.out(front.report(a.file, src))
        if front.analyze(src).diags.len() > 0 { env.exit(1) }
        return
    }
    let mut names = intern.new()
    if is(a.cmd, "lex") {
        let r = lex.lex(src, inout names)
        match resolve.lex_diag(r) {
            Some(d) => { fail(one(d), a, src) }
            None => {}
        }
        match r {
            lex.Done(lx) => dump(lx, names)
            _ => {}
        }
        return
    }
    // the front end recovers: every lex and parse error, and the tree with error nodes
    let lx2 = lex.lex_all(src, inout names)
    let pr = parse.parse_all(lx2.lexed, names)
    let fdiags = front.merge(lx2.diags, pr.diags)
    if is(a.cmd, "parse") {
        if fdiags.len() > 0 { fail(one(fdiags[0]), a, src) }
        io.out(dump.program(pr.p))
        return
    }
    let p = pr.p
    let backend = is(a.cmd, "emit-llvm") || is(a.cmd, "emit-header") || is(a.cmd, "build") || is(a.cmd, "run") || is(a.cmd, "test")
    // every pass goes on after an error, with what it has (docs/compiler.md, "Several errors")
    let mut ld = resolve.load_from(a.file, src, p, resolve.disk())
    resolve.note_syntax(inout ld.p, 0, fdiags)
    let mut diags = fdiags.copy()
    for d in ld.diags { diags.push(d) }
    if ld.fatal { fail(diags, a, src) }
    // what each package of the loaded program uses (docs/compiler.md, "C8.5"): what failed
    // to load is left out, and no error is reported
    if is(a.cmd, "caps") {
        io.out(resolve.caps_json(ld.p))
        return
    }
    // `comptime` constants are evaluated between loading and checking, as tests/oracle expects
    let ev = consteval.eval_all(ld.p)
    for d in ev.diags { diags.push(d) }
    let audit = is(a.cmd, "audit-refs")
    let k = if audit { check.check_audit(ev.p) } else { check.check_all(ev.p, a.lib, a.wasm) }
    for d in k.diags {
        // a module with no `main` can be checked, tested and linted (`check`, `test`, `lint`): it is only a
        // program that needs one (docs/compiler.md, "Library modules")
        let module_ok = (is(a.cmd, "check") || is(a.cmd, "test") || is(a.cmd, "lint")) && !a.lib && !a.wasm && !a.wasm_core
        if module_ok && bytes.eq(sys.lit(d.code), sys.lit("E0112")) && d.line == 1 && d.col == 1 && bytes.eq(d.msg, sys.lit("no `main` function")) { continue }
        diags.push(d)
    }
    if audit {
        audit_report(check.audit_hits(k.c), a, src)
        if diags.len() > 0 { fail(diags, a, src) }
        return
    }
    // nothing is lowered after an error
    if diags.len() > 0 { fail(diags, a, src) }
    if is(a.cmd, "lint") {
        run_lint(k.c, a)
        return
    }
    if is(a.cmd, "expand") {
        run_expand(k.c, a)
        return
    }
    let c = k.c
    if backend {
        let tests = a.tests || is(a.cmd, "test")
        let mut lp = lower.P(c.ir, c.t, c.p.names)
        // `test --coverage`: probes in the modules of the test file's package (cover.ei)
        let mut plan = cover.Plan(List.new(), List.new())
        if a.coverage {
            let mut covered: List[bool] = List.new()
            let mut cpaths: List[List[u8]] = List.new()
            for mi in 0..c.p.mods.len() {
                covered.push((mi as u32) != c.p.prelude && c.p.mods[mi].pkg == c.p.mods[0].pkg)
                cpaths.push(c.p.mods[mi].path.copy())
            }
            plan = cover.instrument(inout lp.ir, covered, cpaths)
        }
        if is(a.cmd, "emit-header") {
            if a.wasm { io.out(wasm.header(lp)) } else { io.out(lower.header(lp, driver.lib_name(a.file, a.out))) }
            return
        }
        let mut paths: List[List[u8]] = List.new()
        for m in c.p.mods { paths.push(m.path) }
        let here: List[u8] = match fs.cwd() {
            Ok(x) => x
            Err(_) => sys.lit(".")
        }
        let wt = a.wasm || a.wasm_core
        // a program that imports core/crypto links the crypto backend (driver.crypto_libs)
        let mut libs = a.libs.copy()
        if !wt {
            for x in driver.crypto_libs(paths, a.file, a.crypto) { libs.push(x) }
        }
        // the target: wasm32, else the one clang builds for (x86-64 or AArch64)
        let arch = if wt { abi.WASM32 } else { driver.target_arch() }
        let out = match llvm.program_prof(lp, a.file, tests, a.lib, paths, here, a.debug && !wt, arch, a.profile, driver.version(), !wt && driver.llvm_f0x()) {
            Ok(o) => o
            Err(m) => {
                let mut msg = sys.lit("eiderc: internal error: ")
                bytes.append(inout msg, m)
                io.errln(msg)
                env.exit(3)
                return
            }
        }
        if is(a.cmd, "emit-llvm") {
            io.out(out.head)
            for x in out.ll { io.out(x) }
        } else if a.wasm {
            // as recorded: `build --wasm` and `run --wasm` both build the module
            wasm.build(llvm.whole(out), lp, a.file, a.out)
        } else if a.wasm_core {
            wasm.build_core(llvm.whole(out), a.file, a.out)
        } else if a.lib {
            // as recorded: `build --lib` and `run --lib` both build the library
            driver.build_lib_llvm(llvm.whole(out), lower.header(lp, driver.lib_name(a.file, a.out)), a.file, a.out, libs, a.debug)
        } else {
            // the module as units (llvm_units.ei), or with -g (one debug-info compile unit)
            // or EIDER_LLVM_UNITS=0 as one
            let mut lnames: List[List[u8]] = List.new()
            let mut lls: List[List[u8]] = List.new()
            if a.debug || !driver.llvm_units_on() {
                lnames.push(sys.lit("prog"))
                lls.push(llvm.whole(out))
            } else {
                for u in llvm_units.split(out, lp) {
                    lnames.push(u.name)
                    lls.push(u.text)
                }
            }
            if is(a.cmd, "build") {
                driver.build_llvm(lnames, lls, a.file, a.out, libs, a.debug, a.profile > 0, a.jobs, !a.no_opt)
            } else if a.coverage {
                let r = driver.run_llvm_ran(lnames, lls, a.file, a.release, libs, a.debug, a.profile > 0, a.pargs, test_env(a), a.jobs, true)
                finish_coverage(a, plan, r.cov)
                env.exit(r.code)
            } else {
                driver.run_llvm(lnames, lls, a.file, a.release, libs, a.debug, a.profile > 0, a.pargs, test_env(a), a.jobs)
            }
        }
    } else if is(a.cmd, "ir") {
        io.out(ir.dump(c.ir, c.t, c.p.names))
    } else if !a.json {
        io.outln(sys.lit("ok"))
    }
}

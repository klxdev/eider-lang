// eiderc: the Eider compiler, written in Eider. See docs/compiler.md.
//
// `eiderc --help` (usage_text below) lists every command, option and environment
// variable; an unknown option or command, a missing source file or a stray argument is a
// usage error (exit 2). `lex` dumps tokens (one per line: line:col kind [value]), `parse`
// the AST (dump.ei), `ir` the typed IR (ir.ei); `build`, `run` and `test` go through
// driver.ei, `test --compile-fail` through suite.ei.
// `--lib` checks (and emits) the file as a library: no `main`, at least one `export fn`.
// `-l <lib>` (repeatable) links a C library into build, run, test and build --lib.
// `--wasm` checks (and emits) the file as a WebAssembly module (a library whose exports take
// and return integers and bool, no threads: E0806): `check --wasm`, `emit-c --wasm`,
// `emit-header --wasm` (the .d.ts and the loader, \x01-separated, as the bootstrap prints them) and
// `build --wasm` / `run --wasm` (<name>.wasm, <name>.d.ts, <name>.js; wasm.ei). `test`
// ignores it, as it ignores `--lib`.

import "deps/core/sys.ei"
import "deps/std/bytes.ei"
import "deps/std/fs.ei"
import "deps/std/io.ei"
import "deps/std/env.ei"
import "intern.ei"
import "lex.ei"
import "diag.ei"
import "parse.ei"
import "dump.ei"
import "resolve.ei"
import "check.ei"
import "ir.ei"
import "lower.ei"
import "driver.ei"
import "comptime.ei" as consteval
import "wasm.ei"
import "suite.ei"

type Args = {
    cmd: List[u8], file: List[u8], json: bool, out: List[u8], release: bool, tests: bool,
    lib: bool, libs: List[List[u8]], wasm: bool, compile_fail: bool,
}

/// Comparisons go through a function so no owned temporary sits in an `else if` condition
/// (the bootstrap drops such temporaries outside the block that declares them).
fn is(a: List[u8], s: str) -> bool uses ffi { bytes.eq(a, sys.lit(s)) }

/// `eiderc --help`: every command, option and environment variable.
fn usage_text() -> List[u8] uses ffi {
    var t: List[u8] = List.new()
    for l in [
        "eiderc 0.1.0 (the Eider compiler, written in Eider: Eider -> C11)",
        "",
        "usage:",
        "  eiderc check <file.ei> [--json] [--lib] [--wasm]  type-check only: `ok` or the first error",
        "  eiderc emit-c <file.ei> [--test] [--lib]   print the generated C (--test: with the test driver)",
        "  eiderc emit-header <file.ei>               print the C header for the `export fn`s",
        "  eiderc build <file.ei> [-o out] [-l lib]   compile to a native binary (-O2) via $CC (default: cc)",
        "  eiderc build --lib <file.ei> [-o name]     build lib<name>.a, lib<name>.so and <name>.h from `export fn`s",
        "  eiderc build --wasm <file.ei> [-o name]    build <name>.wasm, <name>.d.ts and <name>.js (needs clang for wasm32 and wasm-ld)",
        "  eiderc run <file.ei> [--release] [-l lib]  build and run (-O0 unless --release)",
        "  eiderc test <file.ei> [-l lib]             run the `test` blocks",
        "  eiderc test --compile-fail [<dir>]         run the compile-fail suite (<dir>/fail, <dir>/pass; default tests/checks)",
        "  eiderc lex <file.ei>                       dump the tokens",
        "  eiderc parse <file.ei>                     dump the AST",
        "  eiderc ir <file.ei>                        dump the typed IR",
        "  eiderc help | --help | -h                  print this text",
        "",
        "environment:",
        "  CC            the C compiler (default cc)",
        "  EIDER_CFLAGS  extra C compiler flags, split at spaces",
        "  EIDER_CACHE   `off`, or the cache directory (default $XDG_CACHE_HOME/eider, else ~/.cache/eider)",
        "  EIDER_ROOT    the toolchain, the directory holding core/ (default: found above the eiderc binary)",
    ] {
        bytes.append(inout t, sys.lit(l))
        t.push(10)
    }
    t
}

/// A usage error: the message and a pointer to --help on stderr, exit 2.
fn usage_error(msg: List[u8]) uses io, ffi {
    var m = sys.lit("eiderc: ")
    bytes.append(inout m, msg)
    io.errln(m)
    io.errln(sys.lit("run `eiderc --help` for the commands and options"))
    env.exit(2)
}

/// No command at all: the usage text on stderr, exit 2 (the bootstrap prints it too).
fn usage() uses io, ffi {
    io.err(usage_text())
    env.exit(2)
}

fn quoted(pre: str, a: List[u8]) -> List[u8] uses ffi {
    var m = sys.lit(pre)
    m.push(96)
    bytes.append(inout m, a)
    m.push(96)
    m
}

fn known_cmd(c: List[u8]) -> bool uses ffi {
    is(c, "lex") || is(c, "parse") || is(c, "check") || is(c, "ir") || is(c, "emit-c") || is(c, "emit-header") || is(c, "build") || is(c, "run") || is(c, "test")
}

fn parse_args() -> Args uses io, ffi {
    let argv = env.args()
    var cmd: List[u8] = List.new()
    var file: List[u8] = List.new()
    var json = false
    var out: List[u8] = List.new()
    var release = false
    var tests = false
    var lib = false
    var wasm = false
    var compile_fail = false
    var libs: List[List[u8]] = List.new()
    var i: usize = 1
    while i < argv.len() {
        let a = argv[i]
        i += 1
        if is(a, "--help") || is(a, "-h") {
            io.out(usage_text())
            env.exit(0)
        } else if is(a, "--json") {
            json = true
        } else if is(a, "--release") {
            release = true
        } else if is(a, "--test") {
            tests = true
        } else if is(a, "--lib") {
            lib = true
        } else if is(a, "--wasm") {
            wasm = true
        } else if is(a, "--compile-fail") {
            compile_fail = true
        } else if is(a, "-o") {
            if i >= argv.len() { usage_error(sys.lit("`-o` needs a file name")) }
            out = argv[i]
            i += 1
        } else if is(a, "-l") {
            if i >= argv.len() { usage_error(sys.lit("`-l` needs a library name")) }
            libs.push(argv[i])
            i += 1
        } else if a.len() > 1 && a[0] == 45 {
            usage_error(quoted("unknown option ", a))
        } else if cmd.len() == 0 {
            cmd = a
        } else if file.len() == 0 {
            file = a
        } else {
            usage_error(quoted("unexpected argument ", a))
        }
    }
    if cmd.len() == 0 { usage() }
    if is(cmd, "help") {
        io.out(usage_text())
        env.exit(0)
    }
    if !known_cmd(cmd) { usage_error(quoted("unknown command ", cmd)) }
    if compile_fail {
        if !is(cmd, "test") { usage_error(sys.lit("`--compile-fail` goes with `test`")) }
        // the bootstrap's default suite
        if file.len() == 0 { file = sys.lit("tests/checks") }
    }
    if file.len() == 0 { usage_error(quoted("missing the source file for ", cmd)) }
    if is(cmd, "emit-header") { lib = true }
    // `test` checks the test driver, never a library (the bootstrap's mode order)
    if is(cmd, "test") {
        lib = false
        wasm = false
    }
    if wasm { lib = true }
    Args(cmd, file, json, out, release, tests, lib, libs, wasm, compile_fail)
}

/// Print `d` like the bootstrap: JSON on stdout, or the rendered form (against the source of
/// the file it is in) on stderr. Module prefixes in the text are shown as `module.Name`.
fn report(d: diag.Diag, a: Args, src: List[u8]) uses io, fs, ffi {
    var d2 = d
    d2.msg = diag.demangle(d.msg)
    d2.help = diag.demangle(d.help)
    let elsewhere = d2.file.len() > 0 && !bytes.eq(d2.file, a.file)
    if a.json {
        io.outln(diag.json(d2, a.file))
    } else if elsewhere {
        let other: List[u8] = match fs.read(d2.file) {
            Ok(t) => t
            Err(_) => List.new()
        }
        io.err(diag.render(d2, d2.file, other))
    } else {
        io.err(diag.render(d2, a.file, src))
    }
}

fn dump(lx: lex.Lexed, names: intern.Interner) uses io, ffi {
    var out: List[u8] = List.new()
    for t in lx.toks {
        bytes.append(inout out, bytes.from_u64(t.line as u64))
        out.push(58)
        bytes.append(inout out, bytes.from_u64(t.col as u64))
        out.push(45)
        bytes.append(inout out, bytes.from_u64(t.end_col as u64))
        out.push(32)
        bytes.append(inout out, sys.lit(lex.kind_text(t.kind)))
        match t.kind {
            lex.Ident => {
                out.push(32)
                bytes.append(inout out, intern.name(names, t.val as u32))
            }
            lex.Int => {
                out.push(32)
                bytes.append(inout out, bytes.from_u64(t.val))
                if t.big { bytes.append(inout out, sys.lit(" (big)")) }
            }
            lex.Str => {
                out.push(32)
                diag.debug_str(inout out, lx.strs[t.val as usize])
            }
            _ => {}
        }
        out.push(10)
    }
    io.out(out)
}

fn main() uses io, fs, net, clock, ffi {
    let a = parse_args()
    if a.compile_fail { env.exit(suite.run(a.file)) }
    let src = match fs.read(a.file) {
        Ok(s) => s
        Err(e) => {
            var m = String.from("eiderc: ")
            m.append(e)
            print(m)
            env.exit(2)
            return
        }
    }
    var names = intern.new()
    let r = lex.lex(src, inout names)
    match resolve.lex_diag(r) {
        Some(d) => {
            report(d, a, src)
            env.exit(1)
        }
        None => {}
    }
    let lx = match r {
        lex.Done(l) => l
        _ => { return }
    }
    if is(a.cmd, "lex") {
        dump(lx, names)
        return
    }
    let p = match parse.parse(lx, names) {
        // not `Ok(p) => p`: the bootstrap shadows `p` and never assigns it (LEARNINGS.md)
        Ok(parsed) => parsed
        Err(d) => {
            report(d, a, src)
            env.exit(1)
            return
        }
    }
    if is(a.cmd, "parse") {
        io.out(dump.program(p))
        return
    }
    let backend = is(a.cmd, "emit-c") || is(a.cmd, "emit-header") || is(a.cmd, "build") || is(a.cmd, "run") || is(a.cmd, "test")
    let loaded = match resolve.load(a.file, src, p) {
        Ok(x) => x
        Err(d) => {
            report(d, a, src)
            env.exit(1)
            return
        }
    }
    // `comptime` constants are evaluated between loading and checking, as in the bootstrap
    let prog = match consteval.eval(loaded) {
        Ok(x) => x
        Err(d) => {
            report(d, a, src)
            env.exit(1)
            return
        }
    }
    let checked = if a.wasm { check.check_wasm(prog) } else { check.check_mode(prog, a.lib) }
    let c = match checked {
        Ok(x) => x
        Err(d) => {
            report(d, a, src)
            env.exit(1)
            return
        }
    }
    if backend {
        let tests = a.tests || is(a.cmd, "test")
        let lp = lower.P(c.ir, c.t, c.p.names)
        if is(a.cmd, "emit-header") {
            if a.wasm { io.out(wasm.header(lp)) } else { io.out(lower.header(lp)) }
            return
        }
        let lowered = if a.wasm { lower.program_wasm(lp, a.file) } else { lower.program_for(lp, a.file, tests, a.lib) }
        let cprog = match lowered {
            Ok(text) => text
            Err(m) => {
                var msg = sys.lit("eiderc: internal error: ")
                bytes.append(inout msg, m)
                io.errln(msg)
                env.exit(3)
                return
            }
        }
        if is(a.cmd, "emit-c") {
            io.out(cprog)
        } else if a.wasm {
            // the bootstrap: `build --wasm` and `run --wasm` both build the module
            wasm.build(cprog, lp, a.file, a.out)
        } else if a.lib {
            // the bootstrap: `build --lib` and `run --lib` both build the library
            driver.build_lib(cprog, lower.header(lp), a.file, a.out, a.libs)
        } else if is(a.cmd, "build") {
            driver.build(cprog, a.file, a.out, a.libs)
        } else {
            driver.run(cprog, a.file, a.release, a.libs)
        }
    } else if is(a.cmd, "ir") {
        io.out(ir.dump(c.ir, c.t, c.p.names))
    } else if !a.json {
        io.outln(sys.lit("ok"))
    }
}

// diag: diagnostics, rendered exactly as tests/oracle records them (human and --json).
// Messages are bytes so they can go to stderr.

import core.sys
import std.bytes

pub type Fix = { line: u32, col: u32, delete: u64, insert: List[u8] }

/// `file` is set when the error is in an imported file rather than the entry file.
pub type Diag = { code: str, line: u32, col: u32, msg: List[u8], help: List[u8], fix: Option[Fix], file: List[u8] }

pub fn new(code: str, line: u32, col: u32, msg: List[u8]) -> Diag {
    Diag(code, line, col, msg, List.new(), None, List.new())
}

// ---- several diagnostics
//
// A run reports every diagnostic its passes found, in the order found (the first is the
// one a compiler stopping at the first error reports), each once (`dedup`), at most
// `--max-errors` of them (default 100, 0: all): `capped_note` says so after them.

/// The default `--max-errors`.
pub const MAX_ERRORS: u64 = 100

/// Whether two diagnostics report the same error: code, place and message (the help and
/// the fix can differ: a comptime evaluator reports a missing capability without its fix).
pub fn same(a: Diag, b: Diag) -> bool {
    a.line == b.line && a.col == b.col && bytes.eq(sys.lit(a.code), sys.lit(b.code)) && bytes.eq(a.file, b.file) &&
        bytes.eq(a.msg, b.msg)
}

/// `ds` without repetitions (a later report of an earlier error is dropped; passes can find
/// one error twice, e.g. a comptime evaluator and the checker).
pub fn dedup(ds: List[Diag]) -> List[Diag] {
    let mut out: List[Diag] = List.new()
    for d in ds {
        let mut dup = false
        for x in out {
            if same(x, d) {
                dup = true
                break
            }
        }
        if !dup { out.push(d) }
    }
    out
}

/// The summary after the diagnostics (human output): `error: 1 error`, `error: 3 errors`.
pub fn summary(n: u64) -> List[u8] {
    let mut s = sys.lit("error: ")
    num(inout s, n)
    if n == 1 { bytes.append(inout s, sys.lit(" error")) } else { bytes.append(inout s, sys.lit(" errors")) }
    s
}

/// The note when only `shown` of `total` diagnostics are shown (`--max-errors`).
pub fn capped_note(shown: u64, total: u64) -> List[u8] {
    let mut s = sys.lit("only the first ")
    num(inout s, shown)
    bytes.append(inout s, sys.lit(" of "))
    num(inout s, total)
    bytes.append(inout s, sys.lit(" errors are shown; `--max-errors N` shows N (0: all)"))
    s
}

/// capped_note as a JSON line (`--json`).
pub fn capped_json(shown: u64, total: u64) -> List[u8] {
    let mut s = sys.lit("{\"note\":")
    jstr(inout s, capped_note(shown, total))
    s.push(125)
    s
}

/// Every error code of the language, in the fixed order the recorded expectations use. This is the
/// one list: `eiderc test --compile-fail` measures its coverage line against it, so a new
/// code is added here together with its compile-fail test. (`unsupported` is eiderc's
/// marker for a feature it doesn't implement yet, not a code of the language.)
pub fn all_codes() -> List[List[u8]] {
    let mut out: List[List[u8]] = List.new()
    for c in [
        "E0001", "E0002", "E0101", "E0102", "E0103", "E0107", "E0108", "E0110", "E0111", "E0112", "E0113",
        "E0114", "E0115", "E0116", "E0201", "E0203", "E0204", "E0301", "E0302", "E0303", "E0304", "E0305", "E0306", "E0307", "E0308", "E0401",
        "E0402", "E0405", "E0406", "E0409", "E0410", "E0411", "E0501", "E0502", "E0503", "E0504", "E0505", "E0506", "E0601", "E0602", "E0603",
        "E0604", "E0605", "E0606",
        "E0701", "E0801", "E0802", "E0803", "E0804", "E0805", "E0806", "E0807", "E0808",
        "E0809", "E0810", "E0811", "E0812", "E0813", "E0820", "E0821", "E0822",
    ] { out.push(sys.lit(c)) }
    out
}

/// `src` with fix `f` applied: at line:col (columns count
/// Unicode scalar values; past the end means the end), delete `f.delete` bytes and insert
/// `f.insert`.
pub fn apply_fix(src: List[u8], f: Fix) -> List[u8] {
    let mut line: u32 = 1
    let mut col: u32 = 1
    let mut idx = src.len()
    let mut i: usize = 0
    while i < src.len() {
        let b = src[i]
        // UTF-8 continuation bytes are part of the character before them
        if b < 128 || b >= 192 {
            if line == f.line && col == f.col {
                idx = i
                break
            }
            if b == 10 {
                line += 1
                col = 1
            } else {
                col += 1
            }
        }
        i += 1
    }
    let mut end = src.len()
    if (f.delete as usize) < src.len() - idx { end = idx + (f.delete as usize) }
    let mut out = bytes.slice(src, 0, idx)
    bytes.append(inout out, f.insert)
    bytes.append(inout out, bytes.slice(src, end, src.len()))
    out
}

fn alnum(c: u8) -> bool { (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }
fn alpha(c: u8) -> bool { (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }

/// `a__B` -> `a.B` (module-prefixed names in messages, shown as `module.Name`): a
/// double underscore between an alphanumeric and a letter. A package module's name
/// `util__0json` shows as its stem `util` (resolve.ei module_name): from `__0` to the
/// next `__` is dropped.
pub fn demangle(s: List[u8]) -> List[u8] {
    let mut out: List[u8] = List.new()
    let mut i: usize = 0
    while i < s.len() {
        if s[i] == 95 && i + 2 < s.len() && s[i + 1] == 95 && i > 0 && s[i + 2] == 48 {
            i += 3
            while i < s.len() && !(s[i] == 95 && i + 1 < s.len() && s[i + 1] == 95) { i += 1 }
        } else if s[i] == 95 && i + 2 < s.len() && s[i + 1] == 95 && i > 0 && alnum(s[i - 1]) && alpha(s[i + 2]) {
            out.push(46)
            i += 2
        } else {
            out.push(s[i])
            i += 1
        }
    }
    out
}

fn num(inout out: List[u8], n: u64) { bytes.append(inout out, bytes.from_u64(n)) }

/// Debug-style quoting of a string (used for fixes, and by dumps): quotes plus \" \\ \n \t \r and \u{..} for other controls.
pub fn debug_str(inout out: List[u8], s: List[u8]) {
    out.push(34)
    for c in s {
        if c == 34 || c == 92 {
            out.push(92)
            out.push(c)
        } else if c == 10 {
            bytes.append(inout out, sys.lit("\\n"))
        } else if c == 9 {
            bytes.append(inout out, sys.lit("\\t"))
        } else if c == 13 {
            bytes.append(inout out, sys.lit("\\r"))
        } else if c < 32 {
            bytes.append(inout out, sys.lit("\\u{"))
            bytes.append(inout out, hex_min(c))
            out.push(125)
        } else {
            out.push(c)
        }
    }
    out.push(34)
}

fn hex_min(c: u8) -> List[u8] {
    let mut out: List[u8] = List.new()
    let hi = c / 16
    let lo = c % 16
    if hi > 0 { out.push(hex_digit(hi)) }
    out.push(hex_digit(lo))
    out
}

fn hex_digit(n: u8) -> u8 {
    if n < 10 { return 48 + n }
    87 + n
}

fn line_of(src: List[u8], n: u32) -> Option[List[u8]] {
    let mut line: u32 = 1
    let mut start: usize = 0
    let mut i: usize = 0
    while i <= src.len() {
        if i == src.len() || src[i] == 10 {
            if line == n {
                if i == src.len() && start == i { return None }
                // lines end at \n, and a trailing \r is part of the line ending (\r\n)
                let mut end = i.copy()
                if end > start && src[end - 1] == 13 { end -= 1 }
                return Some(bytes.slice(src, start, end))
            }
            line += 1
            start = i + 1
        }
        i += 1
    }
    None
}

/// error[CODE]: msg / --> file:L:C / source line with a caret / help / fix
pub fn render(d: Diag, file: List[u8], src: List[u8]) -> List[u8] {
    let mut s = sys.lit("error[")
    bytes.append(inout s, sys.lit(d.code))
    bytes.append(inout s, sys.lit("]: "))
    bytes.append(inout s, d.msg)
    bytes.append(inout s, sys.lit("\n  --> "))
    bytes.append(inout s, file)
    s.push(58)
    num(inout s, d.line as u64)
    s.push(58)
    num(inout s, d.col as u64)
    s.push(10)
    let ln: u32 = if d.line > 0 { d.line - 1 } else { 0 }
    match line_of(src, ln + 1) {
        Some(text) => {
            let n = bytes.from_u64((ln + 1) as u64)
            let mut pad: List[u8] = List.new()
            for i in 0..n.len() { pad.push(32) }
            bytes.append(inout s, pad)
            bytes.append(inout s, sys.lit(" |\n"))
            bytes.append(inout s, n)
            bytes.append(inout s, sys.lit(" | "))
            bytes.append(inout s, text)
            s.push(10)
            bytes.append(inout s, pad)
            bytes.append(inout s, sys.lit(" | "))
            let mut k: u32 = 1
            while k < d.col {
                s.push(32)
                k += 1
            }
            bytes.append(inout s, sys.lit("^\n"))
        }
        None => {}
    }
    if d.help.len() > 0 {
        bytes.append(inout s, sys.lit("  help: "))
        bytes.append(inout s, d.help)
        s.push(10)
    }
    match d.fix {
        Some(f) => {
            bytes.append(inout s, sys.lit("  fix: at "))
            num(inout s, f.line as u64)
            s.push(58)
            num(inout s, f.col as u64)
            bytes.append(inout s, sys.lit(" delete "))
            num(inout s, f.delete)
            bytes.append(inout s, sys.lit(" insert "))
            debug_str(inout s, f.insert)
            s.push(10)
        }
        None => {}
    }
    s
}

/// A JSON string literal.
pub fn jstr(inout out: List[u8], s: List[u8]) {
    out.push(34)
    for c in s {
        if c == 34 {
            bytes.append(inout out, sys.lit("\\\""))
        } else if c == 92 {
            bytes.append(inout out, sys.lit("\\\\"))
        } else if c == 10 {
            bytes.append(inout out, sys.lit("\\n"))
        } else if c == 9 {
            bytes.append(inout out, sys.lit("\\t"))
        } else if c < 32 {
            bytes.append(inout out, sys.lit("\\u00"))
            out.push(hex_digit(c / 16))
            out.push(hex_digit(c % 16))
        } else {
            out.push(c)
        }
    }
    out.push(34)
}

pub fn json(d: Diag, file: List[u8]) -> List[u8] {
    let f = if d.file.len() > 0 { d.file } else { file }
    let mut s = sys.lit("{\"error\":\"")
    bytes.append(inout s, sys.lit(d.code))
    bytes.append(inout s, sys.lit("\",\"span\":{\"file\":"))
    jstr(inout s, f)
    bytes.append(inout s, sys.lit(",\"line\":"))
    num(inout s, d.line as u64)
    bytes.append(inout s, sys.lit(",\"col\":"))
    num(inout s, d.col as u64)
    bytes.append(inout s, sys.lit("},\"message\":"))
    jstr(inout s, d.msg)
    if d.help.len() > 0 {
        bytes.append(inout s, sys.lit(",\"help\":"))
        jstr(inout s, d.help)
    }
    match d.fix {
        Some(x) => {
            bytes.append(inout s, sys.lit(",\"fix\":{\"at\":{\"line\":"))
            num(inout s, x.line as u64)
            bytes.append(inout s, sys.lit(",\"col\":"))
            num(inout s, x.col as u64)
            bytes.append(inout s, sys.lit("},\"delete\":"))
            num(inout s, x.delete)
            bytes.append(inout s, sys.lit(",\"insert\":"))
            jstr(inout s, x.insert)
            s.push(125)
        }
        None => {}
    }
    s.push(125)
    s
}

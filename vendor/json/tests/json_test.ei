import "core/sys"
import "std/bytes"
import "std/io"
import "../json.ei"

/// `ok <compact text>` or `err <message and position>`.
fn rt_bytes(src: List[u8]) uses io {
    match json.parse(src) {
        Ok(d) => {
            let mut l = sys.lit("ok   ")
            bytes.append(inout l, json.write(d, d.root))
            io.outln(l)
        }
        Err(e) => {
            let mut l = sys.lit("err  ")
            bytes.append(inout l, json.error_text(e))
            io.outln(l)
        }
    }
}

fn rt(src: str) uses io { rt_bytes(sys.lit(src)) }

fn hexs(b: List[u8]) uses io { io.outln(bytes.hex(b)) }

fn show_opt(o: Option[List[u8]]) uses io {
    match o {
        Some(s) => io.outln(s)
        None => print("none")
    }
}

fn valid() uses io {
    print("-- valid")
    rt("null")
    rt("  true ")
    let mut crlf = sys.lit("\t")
    crlf.push(13)
    bytes.append(inout crlf, sys.lit("\nfalse"))
    crlf.push(13)
    crlf.push(10)
    rt_bytes(crlf)
    rt("0")
    rt("-0")
    rt("123")
    rt("-9223372036854775808")
    rt("9223372036854775807")
    rt("9223372036854775808")
    rt("1.5e-3")
    rt("1E+10")
    rt("0.000")
    rt("[]")
    rt("{}")
    rt("[ 1 , [2, [3, []]], {\"a\" : {\"b\": null}} ]")
    rt("{\"k\":1,\"k\":2}")
    rt("\"\"")
    rt("\"plain \\\" \\\\ \\/ \\b \\f \\n \\r \\t\"")
    rt("\"\\u0041\\u00e9\\u20ac\\ud83d\\ude00\\u0000\\u001f\\u007f\"")
    rt("\"raw UTF-8: é € 😀\"")
}

fn invalid() uses io {
    print("-- invalid")
    rt("")
    rt("   ")
    rt("nul")
    rt("True")
    rt("[1,]")
    rt("{\"a\":1,}")
    rt("[1 2]")
    rt("{\"a\" 1}")
    rt("{a:1}")
    rt("{\"a\":}")
    rt("[")
    rt("{\"a\":1")
    rt("01")
    rt("-")
    rt("1.")
    rt(".5")
    rt("+1")
    rt("1e")
    rt("1e+")
    rt("NaN")
    rt("[1]x")
    rt("1 2")
    rt("\"abc")
    rt("\"a\\x\"")
    rt("\"\\u12\"")
    rt("\"\\u12G4\"")
    rt("\"\\ud800\"")
    rt("\"\\ud800\\u0041\"")
    rt("\"\\udc00\"")
    rt("\"tab\there\"")
    rt("[\n  1,\n  2,\n  oops\n]")
    rt("{\"é€\": x}")
    // invalid UTF-8: a lone continuation byte, an overlong `/`, an encoded surrogate, a
    // truncated sequence, a byte order mark
    let mut a = sys.lit("\"")
    a.push(128)
    a.push(34)
    rt_bytes(a)
    let mut b = sys.lit("\"")
    b.push(192)
    b.push(175)
    b.push(34)
    rt_bytes(b)
    let mut c = sys.lit("\"")
    c.push(237)
    c.push(160)
    c.push(128)
    c.push(34)
    rt_bytes(c)
    let mut d = sys.lit("\"")
    d.push(226)
    d.push(130)
    rt_bytes(d)
    let mut e: List[u8] = List.new()
    e.push(239)
    e.push(187)
    e.push(191)
    bytes.append(inout e, sys.lit("{}"))
    rt_bytes(e)
    // nesting: MAX_DEPTH is fine, one more is an error
    let mut deep: List[u8] = List.new()
    for i in 0..512 { deep.push(91) }
    for i in 0..512 { deep.push(93) }
    match json.parse(deep) {
        Ok(_) => print("512 deep: ok")
        Err(x) => io.outln(json.error_text(x))
    }
    let mut deeper: List[u8] = List.new()
    for i in 0..513 { deeper.push(91) }
    for i in 0..513 { deeper.push(93) }
    match json.parse(deeper) {
        Ok(_) => print("513 deep: unexpected")
        Err(x) => io.outln(json.error_text(x))
    }
}

fn reading() uses io {
    print("-- reading")
    let src = sys.lit("{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/hover\",\"params\":{\"position\":{\"line\":3,\"character\":12},\"list\":[true,false,null,\"s\",1.25,-4]}}")
    let d = match json.parse(src) {
        Ok(x) => x
        Err(_) => {
            print("parse failed")
            return
        }
    }
    let r = d.root
    print(json.kind(d, r) == json.OBJECT)
    print(json.len(d, r))
    show_opt(json.as_str(d, json.field(d, r, "method").unwrap_or(0)))
    print(json.as_int(d, json.field(d, r, "id").unwrap_or(0)).unwrap_or(-1))
    let mut keys: List[List[u8]] = List.new()
    keys.push(sys.lit("params"))
    keys.push(sys.lit("position"))
    keys.push(sys.lit("character"))
    match json.path(d, r, keys) {
        Some(id) => print(json.as_int(d, id).unwrap_or(-1))
        None => print("no path")
    }
    keys.push(sys.lit("deeper"))
    print(json.path(d, r, keys).is_none())
    print(json.field(d, r, "missing").is_none())
    // a member's key and value by index
    show_opt(json.as_str(d, json.key_at(d, r, 1).unwrap_or(0)))
    print(json.as_int(d, json.val_at(d, r, 1).unwrap_or(0)).unwrap_or(-1))
    print(json.key_at(d, r, 9).is_none())
    let params = json.field(d, r, "params").unwrap_or(0)
    let list = json.field(d, params, "list").unwrap_or(0)
    print(json.len(d, list))
    print(json.as_bool(d, json.at(d, list, 0).unwrap_or(0)).unwrap_or(false))
    print(json.as_bool(d, json.at(d, list, 1).unwrap_or(0)).unwrap_or(true))
    print(json.is_null(d, json.at(d, list, 2).unwrap_or(0)))
    show_opt(json.as_str(d, json.at(d, list, 3).unwrap_or(0)))
    let f = json.at(d, list, 4).unwrap_or(0)
    print(json.as_int(d, f).is_none())
    show_opt(json.num_text(d, f))
    print(json.as_int(d, json.at(d, list, 5).unwrap_or(0)).unwrap_or(0))
    print(json.at(d, list, 6).is_none())
    // wrong kinds give None / 0, never a trap
    print(json.as_str(d, list).is_none())
    print(json.as_int(d, list).is_none())
    print(json.len(d, f))
    print(json.at(d, r, 0).is_none())
    print(json.kind(d, 999999))
    // big numbers keep their exact text
    match json.parse(sys.lit("[123456789012345678901234567890, -1e400]")) {
        Ok(x) => {
            let n0 = json.at(x, x.root, 0).unwrap_or(0)
            print(json.as_int(x, n0).is_none())
            show_opt(json.num_text(x, n0))
            show_opt(json.num_text(x, json.at(x, x.root, 1).unwrap_or(0)))
        }
        Err(_) => print("unexpected")
    }
    // escapes decode to UTF-8
    match json.parse(sys.lit("\"\\u00e9\\ud83d\\ude00\\uffff\"")) {
        Ok(x) => hexs(json.as_str(x, x.root).unwrap_or(List.new()))
        Err(_) => print("unexpected")
    }
}

fn building() uses io {
    print("-- building")
    let mut d = json.new_doc()
    let mut items: List[u32] = List.new()
    items.push(json.new_null(inout d))
    items.push(json.new_bool(inout d, true))
    items.push(json.new_int(inout d, -9223372036854775807 - 1))
    items.push(json.new_number(inout d, sys.lit("6.02e23")).unwrap_or(0))
    print(json.new_number(inout d, sys.lit("1.")).is_none())
    print(json.new_number(inout d, sys.lit("")).is_none())
    let mut weird = sys.lit("ctl:")
    weird.push(1)
    weird.push(8)
    weird.push(12)
    weird.push(31)
    weird.push(127)
    bytes.append(inout weird, sys.lit(" é \"q\" \\ /"))
    items.push(json.new_string(inout d, weird))
    // invalid UTF-8 is replaced, so the output still parses
    let mut bad = sys.lit("x")
    bad.push(255)
    bad.push(226)
    bad.push(130)
    bad.push(121)
    items.push(json.new_string(inout d, bad))
    let arr = json.new_array(inout d, items)
    let mut keys: List[List[u8]] = List.new()
    keys.push(sys.lit("a"))
    keys.push(sys.lit("empty"))
    keys.push(sys.lit("obj"))
    let mut vals: List[u32] = List.new()
    vals.push(arr)
    let mut none: List[u32] = List.new()
    vals.push(json.new_array(inout d, none))
    let mut nk: List[List[u8]] = List.new()
    vals.push(json.new_object(inout d, nk, none))
    let root = json.new_object(inout d, keys, vals)
    let text = json.write(d, root)
    io.outln(text)
    // it parses back to the same text
    match json.parse(text) {
        Ok(x) => print(bytes.eq(json.write(x, x.root), text))
        Err(e) => io.outln(json.error_text(e))
    }
    io.outln(json.quote(sys.lit("line\nbreak")))
}

fn main() uses io {
    valid()
    invalid()
    reading()
    building()
}
